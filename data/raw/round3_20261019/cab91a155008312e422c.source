//==== 縣市長 ====
var items_per_page = 6;
var total_pages = 19; // 產生 19 頁（共 114 筆卡片，次數絕對平均）
var total_items = total_pages * items_per_page; // 114 筆

// 1. 產生一個大桶子，裡面裝滿 6 輪「各自獨立打亂」的 19 筆資料
var master_pool = [];
var required_rounds = Math.ceil(total_items / mayor_data.length); // 114 / 19 = 6 輪

for (let r = 0; r < required_rounds; r++) {
    var one_round = Array.from({length: mayor_data.length}, (_, i) => i)
                         .sort(() => Math.random() - 0.5);
    master_pool = master_pool.concat(one_round);
}

// 2. 【核心防重機制】修正大桶子中跨輪次交接處可能產生的鄰近重複
// 確保任何連續 6 筆資料內都不會有重複的人
for (let i = 0; i < master_pool.length; i++) {
    // 檢查目前位置往前的 5 筆資料（因為每頁最多 6 筆，往前查 5 筆就能確保同一頁與跨頁交接不重複）
    var lookback = [];
    for (let k = 1; k <= 5; k++) {
        if (i - k >= 0) lookback.push(master_pool[i - k]);
    }
    
    // 如果目前這個人跟前面鄰近的人重複了，就往後找一個不重複的人跟他交換
    if (lookback.includes(master_pool[i])) {
        var swap_index = i + 1;
        // 往後尋找，直到找到一個不在 lookback 裡，且也不會跟它自己原本鄰近重複的人
        while (swap_index < master_pool.length && lookback.includes(master_pool[swap_index])) {
            swap_index++;
        }
        // 如果後面還有牌可以換，就進行交換
        if (swap_index < master_pool.length) {
            var temp = master_pool[i];
            master_pool[i] = master_pool[swap_index];
            master_pool[swap_index] = temp;
        }
    }
}

/**
 * 根據調整好順序的 master_pool 渲染指定頁面
 */
function generatePageHtml(page) {
    var html_items = '';
    var start_index = page * items_per_page;
    
    for (let i = 0; i < items_per_page; i++) {
        var data_index = master_pool[start_index + i];
        var now_data = mayor_data[data_index];
        
        html_items += `
            <div class="mayor_item">
                <div class="mayor_box" index="${now_data.index}">
                    <div class="mayor_people">
                        <img src="/asset/types/election/${now_data.img}" loading="lazy">
                    </div>
                    <div class="mayor_area">${now_data.city}</div>
                    <div class="mayor_name">${now_data.name}</div>
                    <div class="mayor_slogan">${now_data.text}</div>
                </div>
            </div>
        `;
    }
    
    return `
        <div class="mayor_sitem" data-page="${page}">
            <div class="mayor_srow flex">
                ${html_items}
            </div>
        </div>
    `;
}

// ==========================================
// 🚀 【執行渲染】
// ==========================================
$("#mayor_data").empty();

for (let page = 0; page < total_pages; page++) {
    var page_html = generatePageHtml(page);
    $("#mayor_data").append(page_html);
}

//縣市長按鈕
$(document).on("click", ".mayor_box", function(){
	var now_data = mayor_data[parseInt($(this).attr("index"))];
	$("#photo").attr("src", "/asset/types/election/" + now_data.img);
	$("#city").text(now_data.city);
	$("#name").text(now_data.name);
	//學歷
	var education_text = "";
	now_data.education.forEach(function(item, index){
		education_text += item + "<br>";
	});
	$("#education").html(education_text);
	//經歷
	var experience_text = "";
	now_data.experience.forEach(function(item, index){
		experience_text += item + "<br>";
	});
	$("#experience").html(experience_text);
	
	$("#introduce").html(now_data.introduce);
	if(now_data.fb.length > 0){
		$("#fb").attr("href", now_data.fb);
		$("#fb").show();
	}else{
		$("#fb").hide();
	}
	if(now_data.ig.length > 0){
		$("#ig").attr("href", now_data.ig);
		$("#ig").addClass("active");
		$("#ig").show();
	}else{
		$("#ig").hide();
	}
	if(now_data.threads.length > 0){
		$("#threads").attr("href", now_data.threads);
		$("#threads").addClass("active");
		$("#threads").show();
	}else{
		$("#threads").hide();
	}
	if(now_data.yt.length > 0){
		$("#yt").attr("href", now_data.yt);
		$("#yt").addClass("active");
		$("#yt").show();
	}else{
		$("#yt").hide();
	}
	if(now_data.siteurl.length > 0){
		$("#siteurl").attr("href", now_data.siteurl);
		$("#siteurl").find("img").attr("src", "/asset/types/election/" + now_data.siteimg);
		$("#siteurl").show();
	}else{
		$("#siteurl").hide();
	}
	
	$("#popup_mayor").stop().fadeIn();
	$(".popup_mayor_box").scrollTop(0);
});