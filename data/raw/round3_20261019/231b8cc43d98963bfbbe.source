    bar.setAttribute('aria-hidden', show ? 'false' : 'true');
  }
  if('IntersectionObserver' in window){
    new IntersectionObserver(updateBar, {threshold:0}).observe(poster);
  }else{
    window.addEventListener('scroll', updateBar, {passive:true});
  }
  mobile.addEventListener('change', updateBar);
  updateBar();
})();
function doShare(){
  if(navigator.share){navigator.share({title:document.title,url:location.href});}
  else if(navigator.clipboard){navigator.clipboard.writeText(location.href);alert('連結已複製');}
  return false;
}
for(var id of ['share-btn','share-btn-m']){
  var el=document.getElementById(id);
  if(el)el.addEventListener('click',function(e){e.preventDefault();doShare();});
}
</script>
