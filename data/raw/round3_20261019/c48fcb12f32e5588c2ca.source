<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>候選人總覽｜台灣前進</title>
<meta name="description" content="台灣前進 2026 地方選舉 35 位候選人總覽：16 縣市、四黨＋無黨籍，找你選區的在地出戰者。">
<link rel="canonical" href="https://taiwangogo.tw/candidates/">
<meta property="og:title" content="候選人總覽｜台灣前進">
<meta property="og:description" content="35 席外卡，替你上場。找你選區的候選人。">
<meta property="og:url" content="https://taiwangogo.tw/candidates/">
<meta property="og:locale" content="zh_TW">
<meta property="og:site_name" content="台灣前進">
<meta property="og:image" content="https://taiwangogo.tw/assets/share/_home.jpg">
<meta name="twitter:card" content="summary_large_image">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@500;700;900&family=Noto+Serif+TC:wght@700;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/_shared.css?v=70be2da3">
<link rel="stylesheet" href="/_page.css?v=d1a3df0c">
<style>
/* ===== 候選人總覽（B・地圖領航）｜沿用個人頁海報語彙；配色/字級走全站 token ===== */
html{scroll-behavior:smooth}
/* 地圖密度分層色（alias 回 token） */
body[data-page="candidates"]{--map-hi:var(--pd);--map-mid:var(--p);--map-none:var(--bd)}
.cl-wrap{max-width:1140px;margin:0 auto;padding:0 22px}

/* Hero（poster 家族・歸隊候選人頁）：底色/斜地板/水印/網點與 .cv-poster--v1 完全對齊，
   只保留斜體 3D 大標當通往首頁的橋。radial 配方＝候選人頁同一組 poster token（70% 28% 中心）。 */
.cl-hero{position:relative;overflow:hidden;color:#fff;
  background:radial-gradient(120% 150% at 70% 28%,var(--p-poster-hi) 0%,var(--p-poster-mid) 46%,var(--p-hero-deep) 100%)}
/* 網點紋理與候選人頁 .cv-poster::before 同步：mix-blend-mode:overlay 讓點紋柔化融入底色（否則白點平貼在 10% 會太明顯） */
.cl-hero::before{content:"";position:absolute;inset:0;opacity:.10;pointer-events:none;
  background-image:radial-gradient(rgba(255,255,255,.9) 1.4px,transparent 1.6px);background-size:14px 14px;mix-blend-mode:overlay}
/* 下緣淺色斜切：同 .tf-hero::after（縣市頁同款），取代原深紫斜地板 */
.cl-hero::after{content:"";position:absolute;left:0;right:0;bottom:-1px;z-index:1;height:56px;background:var(--bg);
  clip-path:polygon(0 100%,100% 100%,100% 0)}
/* 水印：對齊候選人頁 .cv-word 級別（150px／.06／12px letter-spacing），縮小＋降透明度避免直書大字被誤讀為「進前」 */
.cl-hero .word{position:absolute;right:5%;top:7%;z-index:0;font-family:"Noto Serif TC",serif;font-weight:900;
  font-size:150px;line-height:.86;letter-spacing:12px;writing-mode:vertical-rl;color:rgba(255,255,255,.06);
  pointer-events:none;user-select:none}
.cl-hero .in{position:relative;z-index:2;max-width:1140px;margin:0 auto;padding:52px 22px 74px}
.cl-eyebrow{font-size:var(--fs-xs);font-weight:900;letter-spacing:3px;color:var(--p);background:#fff;
  display:inline-block;padding:5px 15px;border-radius:999px}
.cl-hero h1{font-size:clamp(46px,8vw,104px);font-weight:900;letter-spacing:2px;margin:26px 0 4px;line-height:1;
  display:flex;flex-wrap:wrap;column-gap:.2em;row-gap:.1em}
.cl-hero h1 .sl{display:inline-block;transform:skewX(-10deg) rotate(-3deg);
  text-shadow:0 6px 0 var(--pdd),0 22px 40px rgba(0,0,0,.4)}

/* 地圖領航說明句 */
.cl-intro{font-size:var(--fs-base);color:var(--tm);font-weight:700;margin:22px 0 2px;line-height:1.85;max-width:960px}

/* 迷你海報卡（剪影＋黨色拱底＋黨色點） */
.cl-cd{position:relative;display:flex;flex-direction:column;background:#fff;border:1.5px solid var(--bd);
  border-radius:16px;overflow:hidden;text-decoration:none;color:inherit;transition:.16s;--pc:var(--p);--soft:var(--p20)}
.cl-cd:hover{transform:translateY(-3px);border-color:var(--pc);box-shadow:0 12px 26px rgba(101,73,148,.18)}
.cl-cd .ph{position:relative;aspect-ratio:1/1.02;overflow:hidden;
  background:linear-gradient(180deg,#fff,var(--soft));border-bottom:3px solid var(--pc);border-radius:22px 22px 0 0}
.cl-cd .ph img{width:100%;height:100%;object-fit:cover;object-position:top;display:block}
.cl-cd .nm{font-size:var(--fs-m);font-weight:900;color:var(--ink);padding:11px 13px 0;display:flex;align-items:center;gap:8px}
.cl-cd .nm .dot{width:11px;height:11px;border-radius:50%;flex:none;background:var(--pc)}
.cl-cd .ar{font-size:var(--fs-base);font-weight:700;color:var(--tm);padding:2px 13px 0}
.cl-cd .lv{font-size:var(--fs-xs);font-weight:700;color:#8a857d;padding:2px 13px 12px}

/* 地圖領航版面：左地圖（sticky）＋右名單 */
.b-split{display:grid;grid-template-columns:360px 1fr;gap:34px;margin-top:18px;align-items:start}
.b-mapcol{position:sticky;top:88px}
.b-mapcard{background:#fff;border:1.5px solid var(--bd);border-radius:20px;padding:20px;box-shadow:0 14px 34px -18px rgba(43,31,69,.35)}
.b-mapcard h3{font-size:var(--fs-base);font-weight:900;margin:0 0 2px}
.b-mapcard h3 span{color:var(--p)}
.b-mapcard .h-sub{font-size:var(--fs-xs);color:var(--tm);font-weight:700;margin-bottom:12px}
.b-mapcard .mp svg{width:100%;height:auto;display:block}
.b-mapcard .mp svg path{stroke:var(--on-dark);stroke-width:1.2;transition:.18s}
.b-mapcard .mp svg path.active{stroke:var(--gold);stroke-width:3.4}
.b-maplg{display:flex;align-items:center;gap:12px;margin-top:12px;font-size:var(--fs-xs);font-weight:700;color:var(--tm);flex-wrap:wrap}
.b-maplg i{display:inline-flex;align-items:center;gap:5px}
.b-maplg i b{width:13px;height:13px;border-radius:4px;display:inline-block}

/* 縣市列：多人＝大標＋卡牆；單人＝2–3 個小單元併一列 */
.b-crow{padding:16px 0;border-top:1px solid var(--bd);scroll-margin-top:96px}
.b-crow:first-child{border-top:0;padding-top:4px}
.b-chead{display:flex;align-items:baseline;gap:9px;margin-bottom:12px;padding-bottom:8px;border-bottom:2px solid var(--p20)}
.b-chead .cy{font-size:var(--fs-m);font-weight:900;line-height:1.12}
.b-chead .cn{font-size:var(--fs-xs);font-weight:700;color:var(--tm)}
.b-chead .cn b{color:var(--p);font-size:var(--fs-base);margin-right:2px}
.b-chead .cdots{display:flex;gap:4px;flex-wrap:wrap;align-self:center;margin-left:2px}
.b-chead .cdots i{width:9px;height:9px;border-radius:50%;display:block}
.b-chead.sm{margin-bottom:10px;padding-bottom:6px;gap:7px}
.b-chead.sm .cy{font-size:var(--fs-base)}
.b-cwall{display:grid;grid-template-columns:repeat(auto-fill,minmax(146px,1fr));gap:13px}
.b-cwall .b-cwbreak{grid-column:1/-1;height:0;margin:-13px 0 0}
.b-solo-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(158px,1fr));gap:18px}
.b-solo-unit{display:flex;flex-direction:column;min-width:0}
.b-solo-unit .cl-cd{width:100%;max-width:214px;flex:1}
.b-mobzones{display:none}

@media(max-width:860px){
  .b-split{grid-template-columns:1fr}
  .b-mapcol{display:none}
  .b-mobzones{display:flex;gap:8px;overflow-x:auto;position:sticky;top:66px;z-index:50;
    background:rgba(250,250,250,.94);backdrop-filter:blur(6px);padding:10px 22px;margin:0 -22px 2px}
  .b-mobzones .mz{flex:none;border:2px solid var(--bd);border-radius:999px;padding:6px 14px;
    font-weight:900;font-size:var(--fs-xs);cursor:pointer;white-space:nowrap;background:#fff;color:var(--t)}
  .b-mobzones .mz.active{border-color:var(--p);background:var(--p10);color:var(--p)}
  .b-mobzones .mz .sw{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:6px;vertical-align:middle}
}
@media(max-width:640px){
  .b-crow{padding:15px 0}
  .b-cwall{grid-template-columns:repeat(2,1fr)}
  .b-solo-grid{grid-template-columns:repeat(2,1fr);gap:12px}
  .b-solo-unit .cl-cd{max-width:none}
  .cl-cd .nm{font-size:var(--fs-base);padding:8px 10px 0}
  .cl-cd .ar{font-size:var(--fs-xs);padding:1px 10px 0}
  .cl-cd .lv{padding:1px 10px 9px}
  .cl-hero .word{font-size:120px}
}
</style>
</head>
<body data-page="candidates">

<div data-slot="nav"><header class="topnav">
  <a href="/" class="brand">
    <img src="/assets/taiwan-forward-flyingfish.png" alt="台灣前進">
    <span>台灣前進</span>
    <span class="brand-tag">進步・本土・清廉</span>
  </a>
  <a class="nav-typhoon-mobile" data-typhoon-entry="mobile_navigation" href="https://typhoon.taiwangogo.tw/" aria-label="前往颱風即時資訊站">颱風資訊</a>
  <button class="nav-toggle" aria-label="開關選單" aria-expanded="false">
    <span></span><span></span><span></span>
  </button>
  <nav class="topnav-links">
