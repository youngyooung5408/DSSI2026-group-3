<div data-slot="footer"><footer>
  <div class="ftin">
    <div class="ftbrand">
      <div class="logo-row">
        <img src="/assets/taiwan-forward-flyingfish.png" alt="台灣前進">
        <span class="name">台灣前進</span>
      </div>
      <p class="tagline">你忙著生活，<br>我們幫你看緊議會。</p>
      <div class="ftnl">
        <div class="ftnl-t">訂閱台灣前進</div>
        <form class="nl-form" data-nl method="post">
          <input class="nl-hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true">
          <input type="email" name="email" required maxlength="80" placeholder="你的 Email" aria-label="Email">
          <button class="btn btn--md btn--gold" type="submit">訂閱</button>
        </form>
        <p class="nl-msg" role="status" tabindex="-1"></p>
      </div>
    </div>
