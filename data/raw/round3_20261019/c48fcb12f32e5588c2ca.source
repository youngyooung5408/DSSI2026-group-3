<script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script src="/_common.js?v=748b1368"></script>
<script>(function(){
var CC={"台北市": 6, "新北市": 4, "基隆市": 1, "桃園市": 1, "新竹市": 3, "新竹縣": 7, "苗栗縣": 1, "台中市": 2, "彰化縣": 1, "雲林縣": 1, "嘉義市": 2, "台南市": 1, "高雄市": 2, "屏東縣": 1, "宜蘭縣": 1, "花蓮縣": 1};

var mapBox=document.getElementById('bMap');
var svgEl=null;
function tier(n){return n>=5?'var(--map-hi)':n>=2?'var(--map-mid)':n>=1?'var(--map-lo)':'var(--map-none)';}
var rows=Array.prototype.slice.call(document.querySelectorAll('.b-crow'));
var lockTarget=null, active='';
function applyActive(){
  var set=new Set(active.split(',').filter(Boolean));
  if(svgEl) svgEl.querySelectorAll('path').forEach(function(p){p.classList.toggle('active',set.has(p.getAttribute('data-city')));});
  document.querySelectorAll('#bMobZones .mz').forEach(function(z){z.classList.toggle('active',set.has(z.dataset.city));});
}
function setActiveRow(row){
  if(!row) return;
  var cities=(row.dataset.cities||'').split(',').filter(Boolean);
  active=cities.join(',');
  var now=document.getElementById('bNow'); if(now) now.textContent=cities.join('・');
  applyActive();
}
/* 以參考線（sticky nav 下方）為準，取最後一個「上緣已越過參考線」的列＝正在看 */
function computeActiveRow(){
  if(lockTarget){setActiveRow(lockTarget);return;}
  var ref=130, cur=null;
  rows.forEach(function(r){ if(r.getBoundingClientRect().top<=ref) cur=r; });
  if(!cur) cur=rows[0];
  if(cur) setActiveRow(cur);
}
/* 點縣市／地圖／手機 chip：跳到該列並鎖定高亮，直到使用者自己再捲動才解鎖 */
function jumpCounty(cy){
  var el=document.getElementById('cty-'+cy);
  if(!el) return;
  var row=el.closest('.b-crow'); if(!row) return;
  lockTarget=row;
  setActiveRow(row);
  window.scrollTo({top:el.getBoundingClientRect().top+window.pageYOffset-120,behavior:'smooth'});
}
/* 地圖：runtime 抓真實 SVG，依各縣市候選人數密度上色（0 人灰、不可點） */
fetch('/assets/taiwan_static.svg').then(function(r){return r.text();}).then(function(t){
  mapBox.innerHTML=t;
  var svg=mapBox.querySelector('svg'); if(!svg) return; svgEl=svg;
  svg.removeAttribute('id'); svg.setAttribute('width','100%'); svg.removeAttribute('height');
  svg.querySelectorAll('path').forEach(function(pa){
    var city=pa.getAttribute('data-city'); var n=CC[city]||0;
    pa.style.fill=tier(n);
    if(n>0){ pa.style.cursor='pointer'; pa.addEventListener('click',function(){ jumpCounty(city); }); }
    else{ pa.style.pointerEvents='none'; }
  });
  applyActive();
}).catch(function(){});
document.querySelectorAll('#bMobZones .mz').forEach(function(z){ z.addEventListener('click',function(){ jumpCounty(z.dataset.city); }); });
window.addEventListener('scroll',computeActiveRow,{passive:true});
['wheel','touchstart','keydown'].forEach(function(ev){ window.addEventListener(ev,function(){ lockTarget=null; },{passive:true}); });
computeActiveRow();
})();</script>
