    {
      "url": "https://www.kcc.gov.tw/News_Content.aspx?n=47&sms=8971&s=17292",
      "text": "        邱于軒、李雅芬、宋立彬、林智鴻、張漢忠、范織欽議員總質詢摘要                "
    },
    {
      "url": "https://www.kcc.gov.tw/News_Content.aspx?n=47&sms=8971&s=17264",
      "text": "        工務部門委員會議員質詢摘要                "
    },
    {
      "url": "https://www.kcc.gov.tw/News_Content.aspx?n=47&sms=8971&s=17101",
      "text": "        邱于軒、宋立彬、李雅芬、朱信強、邱俊憲、張漢忠議員總質詢摘要                "
    },
    {
      "url": "https://www.kcc.gov.tw/News_Content.aspx?n=47&sms=8971&s=17054",
      "text": "        工務部門委員會議員質詢摘要                "
    },
    {
      "url": "https://www.kcc.gov.tw/News_Content.aspx?n=47&sms=8971&s=16782",
      "text": "        寒風中守護城市門面　康議長連兩日慰勞海線清潔隊致敬無名英雄                "
    },
    {
      "url": "https://www.kcc.gov.tw/News_Content.aspx?n=47&sms=8971&s=16765",
      "text": "        「當我們同在議起」 康議長歡迎議員前輩回娘家                "
    },
    {
      "url": "https://www.kcc.gov.tw/News_Content.aspx?n=47&sms=8971&s=16715",
      "text": "        白喬茵、簡煥宗、陳麗珍議員、李雅芬、邱于軒、宋立彬議員總質詢摘要                "
    },
    {
      "url": "https://www.kcc.gov.tw/News_Content.aspx?n=47&sms=8971&s=16665",
      "text": "        工務部門委員會議員質詢摘要                "
    },
    {
      "url": "https://www.kcc.gov.tw/News_Content.aspx?n=47&sms=8971&s=16461",
      "text": "        李雅芬、邱于軒、宋立彬、李順進、蔡武宏、李亞築議員總質詢摘要                "
    },
    {
      "url": "https://www.kcc.gov.tw/News_Content.aspx?n=47&sms=8971&s=16415",
      "text": "        工務部門委員會議員質詢摘要                "
    },
    {
      "url": "https://www.kcc.gov.tw/News_Content.aspx?n=47&sms=8971&s=16194",
      "text": "        李雅芬、邱于軒、宋立彬、許采蓁、林富寶、黃文志議員總質詢摘要                "
    },
    {
      "url": "https://www.kcc.gov.tw/News_Content.aspx?n=47&sms=8971&s=16176",
      "text": "        社政部門委員會議員質詢摘要                "
    },
    {
      "url": "https://www.kcc.gov.tw/News_Content.aspx?n=47&sms=8971&s=15897",
      "text": "        社政部門委員會議員質詢摘要                "
    },
    {
      "url": "https://www.kcc.gov.tw/News_Content.aspx?n=47&sms=8971&s=15705",
      "text": "        劉德林、李雅芬、宋立彬、吳利成、許采蓁、陳美雅議員總質詢摘要                "
    },
    {
      "url": "https://www.kcc.gov.tw/News_Content.aspx?n=47&sms=8971&s=15638",
      "text": "        教育部門委員會議員質詢摘要                "
    },
    {
      "url": "https://www.kcc.gov.tw/News_Content.aspx?n=47&sms=8971&s=15612",
      "text": "        教育委員會考察巴楠花部落國民中小學                "
    },
    {
      "url": "https://www.kcc.gov.tw/News_Content.aspx?n=47&sms=8971&s=14467",
      "text": "        鍾易仲.蔡金晏.黃香菽.李雅芬.宋立彬議員總質詢摘要                "
    },
    {
      "url": "https://www.kcc.gov.tw/News_Content.aspx?n=47&sms=8971&s=14434",
      "text": "        教育部門委員會議員質詢摘要                "
    },
    {
      "url": "https://www.kcc.gov.tw/News_Content.aspx?n=47&sms=8971&s=14265",
      "text": "        本屆議會成立112年各種委員會                "
    },
    {
      "url": "https://www.kcc.gov.tw/News_Content.aspx?n=47&sms=8971&s=14200",
      "text": "        願景相承，本會定12月25日舉行第4屆成立大會                "
    },
    {
      "url": "https://www.kcc.gov.tw/News_Content.aspx?n=47&sms=8971&s=14182",
      "text": "        中央選委會今(2)日公告高雄市第4屆議員當選人名單                "
