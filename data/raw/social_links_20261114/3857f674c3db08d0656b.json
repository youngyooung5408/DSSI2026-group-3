    {
      "url": "https://www.kcc.gov.tw/javascript :return false;",
      "text": "網頁功能"
    },
    {
      "url": "javascript:CCMS_Print(1);",
      "text": "列印內容"
    },
    {
      "url": "https://www.kcc.gov.tw/News_Content.aspx?n=47&sms=8971&s=17309",
      "text": "        捷運小港林園線全線發包！ 康議長：鐵道生活夢想正式啟動                "
    },
    {
      "url": "https://www.kcc.gov.tw/News_Content.aspx?n=47&sms=8971&s=17282",
      "text": "        黃飛鳳、吳銘賜、李雅靜、陳善慧、朱信強、陳幸富議員總質詢摘要                "
    },
    {
      "url": "https://www.kcc.gov.tw/News_Content.aspx?n=47&sms=8971&s=17109",
      "text": "        高雄市議會跨黨派訪團再訪布里斯本　曾副議長：歡迎大家投資高雄                "
    },
    {
      "url": "https://www.kcc.gov.tw/News_Content.aspx?n=47&sms=8971&s=17094",
      "text": "        劉德林、陳麗娜、陳慧文、吳銘賜、張勝富、林富寶議員總質詢摘要                "
    },
    {
      "url": "https://www.kcc.gov.tw/News_Content.aspx?n=47&sms=8971&s=17050",
      "text": "        警消衛環部門委員會議員質詢摘要                "
    },
    {
      "url": "https://www.kcc.gov.tw/News_Content.aspx?n=47&sms=8971&s=16785",
      "text": "        「躍動高雄、智慧共榮」議會與市府陪伴市民迎接115年                "
    },
    {
      "url": "https://www.kcc.gov.tw/News_Content.aspx?n=47&sms=8971&s=16711",
      "text": "        林智鴻、吳銘賜、曾俊傑副議長、林志誠、曾麗燕、許采蓁議員總質詢摘要                "
    },
    {
      "url": "https://www.kcc.gov.tw/News_Content.aspx?n=47&sms=8971&s=16465",
      "text": "        黃秋媖、白喬茵、吳銘賜、王義雄、鄭安秝、陸淑美議員總質詢摘要                "
    },
    {
      "url": "https://www.kcc.gov.tw/News_Content.aspx?n=47&sms=8971&s=16190",
      "text": "        高忠德、曾俊傑副議長、吳銘賜、林志誠、陳美雅、陳幸富議員總質詢摘要                "
    },
    {
      "url": "https://www.kcc.gov.tw/News_Content.aspx?n=47&sms=8971&s=16173",
      "text": "        工務部門委員會議員質詢摘要                "
    },
    {
      "url": "https://www.kcc.gov.tw/News_Content.aspx?n=47&sms=8971&s=15916",
      "text": "        吳銘賜、王耀裕、王義雄、陳慧文、李雅慧、何權峰、邱俊憲議員總質詢摘要                "
    },
    {
      "url": "https://www.kcc.gov.tw/News_Content.aspx?n=47&sms=8971&s=15891",
      "text": "        工務部門委員會議員質詢摘要                "
    },
    {
      "url": "https://www.kcc.gov.tw/News_Content.aspx?n=47&sms=8971&s=15746",
      "text": "        議會年底慰勞行程 一連兩日走訪鳳山、前鎮及小港清潔隊                "
    },
    {
      "url": "https://www.kcc.gov.tw/News_Content.aspx?n=47&sms=8971&s=15690",
      "text": "        陳麗娜、黃彥毓、陳玫娟、王義雄、吳銘賜議員總質詢摘要                "
    },
    {
      "url": "https://www.kcc.gov.tw/News_Content.aspx?n=47&sms=8971&s=15680",
      "text": "        捷運小港林園線工程動土，康議長說「等好久了，美夢成真」                "
    },
    {
      "url": "https://www.kcc.gov.tw/News_Content.aspx?n=47&sms=8971&s=15659",
      "text": "        工務部門委員會議員質詢摘要                "
    },
    {
      "url": "https://www.kcc.gov.tw/News_Content.aspx?n=47&sms=8971&s=15641",
      "text": "        康議長肯定陳市長推動和發消防分隊新建工程「太有遠見了」                "
    },
    {
      "url": "https://www.kcc.gov.tw/News_Content.aspx?n=47&sms=8971&s=14472",
      "text": "        吳銘賜.陳麗娜.許采蓁.張勝富.邱俊憲.李雅靜議員總質詢摘要                "
