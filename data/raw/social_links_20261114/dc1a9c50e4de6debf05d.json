    },
    {
      "url": "javascript:CCMS_Print(1);",
      "text": "列印內容"
    },
    {
      "url": "https://www.kcc.gov.tw/News_Content.aspx?n=47&sms=8971&s=17282",
      "text": "        黃飛鳳、吳銘賜、李雅靜、陳善慧、朱信強、陳幸富議員總質詢摘要                "
    },
    {
      "url": "https://www.kcc.gov.tw/News_Content.aspx?n=47&sms=8971&s=17279",
      "text": "        警消衛環部門委員會議員質詢摘要                "
    },
    {
      "url": "https://www.kcc.gov.tw/News_Content.aspx?n=47&sms=8971&s=17174",
      "text": "        議會中元普渡 康議長祈願高雄平安順利、好運接棒                "
    },
    {
      "url": "https://www.kcc.gov.tw/News_Content.aspx?n=47&sms=8971&s=17169",
      "text": "        做公益跑在前頭！議會連3年加碼採購身障秋節禮盒                "
    },
    {
      "url": "https://www.kcc.gov.tw/News_Content.aspx?n=47&sms=8971&s=17134",
      "text": "        挺國防最強後盾！高雄市議會赴台中清泉崗勞軍  慰問空軍第三聯隊官兵辛勞                "
    },
    {
      "url": "https://www.kcc.gov.tw/News_Content.aspx?n=47&sms=8971&s=17096",
      "text": "        林智鴻議員、曾俊傑副議長、簡煥宗、李雅靜、曾麗燕議員總質詢摘要                "
    },
    {
      "url": "https://www.kcc.gov.tw/News_Content.aspx?n=47&sms=8971&s=17050",
      "text": "        警消衛環部門委員會議員質詢摘要                "
    },
    {
      "url": "https://www.kcc.gov.tw/News_Content.aspx?n=47&sms=8971&s=16765",
      "text": "        「當我們同在議起」 康議長歡迎議員前輩回娘家                "
    },
    {
      "url": "https://www.kcc.gov.tw/News_Content.aspx?n=47&sms=8971&s=16721",
      "text": "        牧師祝禱及陽明國中管樂聲飄揚 議會聖誕樹溫暖點燈                "
    },
    {
      "url": "https://www.kcc.gov.tw/News_Content.aspx?n=47&sms=8971&s=16701",
      "text": "        議會寒冬送暖15年 攜手阿隆師辦桌暖心開席                "
    },
    {
      "url": "https://www.kcc.gov.tw/News_Content.aspx?n=47&sms=8971&s=16700",
      "text": "        李雅靜、黃天煌、王義雄、方信淵、陳明澤、高忠德議員總質詢摘要                "
    },
    {
      "url": "https://www.kcc.gov.tw/News_Content.aspx?n=47&sms=8971&s=16667",
      "text": "        民政部門委員會議員質詢摘要                "
    },
    {
      "url": "https://www.kcc.gov.tw/News_Content.aspx?n=47&sms=8971&s=16467",
      "text": "        「永續愛+1」公益電影院溫暖登場 康議長感謝中嘉寬頻成弱勢孩童堅實後盾                "
    },
    {
      "url": "https://www.kcc.gov.tw/News_Content.aspx?n=47&sms=8971&s=16466",
      "text": "        議會召開環境保護局「ICLEI業務功能」專案報告                "
    },
    {
      "url": "https://www.kcc.gov.tw/News_Content.aspx?n=47&sms=8971&s=16452",
      "text": "        黃文志、黃彥毓、李雨庭、李雅靜、林富寶議員總質詢摘要                "
    },
    {
      "url": "https://www.kcc.gov.tw/News_Content.aspx?n=47&sms=8971&s=16445",
      "text": "        揪看戲讓阿母笑開懷 康議長率議員陪媽媽歡度母親節                "
    },
    {
      "url": "https://www.kcc.gov.tw/News_Content.aspx?n=47&sms=8971&s=16444",
      "text": "        議長康裕成出席母親節「美力媽媽」表揚典禮　溫柔感謝40位母親無私奉獻                "
    },
    {
      "url": "https://www.kcc.gov.tw/News_Content.aspx?n=47&sms=8971&s=16441",
      "text": "        議長康裕成暖心號召「大聲說愛媽媽」　高雄市議會提前歡慶母親節                "
    },
    {
      "url": "https://www.kcc.gov.tw/News_Content.aspx?n=47&sms=8971&s=16426",
      "text": "        感謝國軍守護台灣最前線　康議長率議員致敬                "
    },
    {
      "url": "https://www.kcc.gov.tw/News_Content.aspx?n=47&sms=8971&s=16425",
      "text": "        民政部門委員會議員質詢摘要                "
    },
    {
      "url": "https://www.kcc.gov.tw/News_Content.aspx?n=47&sms=8971&s=16202",
      "text": "        李雅靜、鄭孟洳、陳麗娜、黃明太議員總質詢摘要                "
