    <!-- Custom JavaScript -->
    <script>
        $(document).ready(function () {
            // 判斷目前裝置平台（iOS / Android / Other）
            function getDevicePlatform() {
                var userAgent = navigator.userAgent || navigator.vendor || window.opera || '';
                var isIOS = /iPad|iPhone|iPod/.test(userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
                var isAndroid = /Android/i.test(userAgent);

                if (isIOS) {
                    return 'ios';
                }

                if (isAndroid) {
                    return 'android';
                }

                return 'other';
            }

            // 開啟 APP 下載 Modal（同時相容 Bootstrap 4/5）
            function openAppDownloadModal() {
                if (window.bootstrap && bootstrap.Modal) {
                    var appDownloadModalV5 = bootstrap.Modal.getOrCreateInstance(document.getElementById('appDownloadModal'));
                    appDownloadModalV5.show();
                    return;
                }

                if ($.fn.modal) {
                    $('#appDownloadModal').modal('show');
                }
            }

            // 處理 APP 下載點擊事件（iOS/Android 直接導流，其他平台開啟 Modal）
            $('.app-download-link').on('click', function (e) {
                e.preventDefault();
                var appLink = $(this);
                var devicePlatform = getDevicePlatform();

                if (devicePlatform === 'ios') {
                    appLink.addClass('is-loading');
                    window.location.href = appLink.data('ios-url');
                    return;
                }

                if (devicePlatform === 'android') {
                    appLink.addClass('is-loading');
                    window.location.href = appLink.data('android-url');
                    return;
                }

                openAppDownloadModal();
            });

            // 處理回到頂端按鈕點擊事件（平滑捲動）
            $('.scroll-top-link').on('click', function (e) {
                e.preventDefault();
                $('html, body').animate({ scrollTop: 0 }, 260);
            });

            // 控制回到頂端按鈕顯示狀態（捲動超過指定高度才顯示）
            function updateScrollTopButtonVisibility() {
                var shouldShow = $(window).scrollTop() > 600;
                $('.scroll-top-link').toggleClass('is-visible', shouldShow);
            }

            // 監聽捲動事件並初始化按鈕狀態
            $(window).on('scroll', updateScrollTopButtonVisibility);
            updateScrollTopButtonVisibility();

            // 停止語音朗讀
            if (typeof synthesis !== 'undefined' && typeof utterance !== 'undefined') {
                console.log('停止朗讀！');
                synthesis.cancel();
            }
        });
    </script>
    
