<script>
    /// <summary>
    /// 標籤搜尋送出時顯示載入狀態。
    /// </summary>
    function bindTagSearchFeedback() {
        $('.tag-search-form').off('submit.articleTag').on('submit.articleTag', function() {
            var $btn = $(this).find('.tag-search-btn');
            if ($btn.length === 0) {
                return;
            }

            var label = $btn.data('label') || $btn.text();
            $btn.data('label', label);
            $btn.text('搜尋中...').prop('disabled', true).addClass('disabled');
        });
    }

    /// <summary>
    /// 更新單篇文章的社群分享操作提示。
    /// </summary>
    function setArticleShareStatus(button, message) {
        var share = button.closest('[data-article-share]');
        var status = share ? share.querySelector('[data-share-status]') : null;
        if (status) {
            status.textContent = message;
        }
    }

    /// <summary>
    /// 在不支援 Clipboard API 時以隱藏欄位複製連結。
    /// </summary>
    function copyTextWithFallback(value) {
        var textarea = document.createElement('textarea');
        textarea.value = value;
        textarea.setAttribute('readonly', '');
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        document.body.appendChild(textarea);
        textarea.select();
        var copied = document.execCommand('copy');
        textarea.remove();
        return copied;
    }

    /// <summary>
    /// 複製文章網址並提供完成或失敗提示。
    /// </summary>
    async function copyArticleShareUrl(button) {
        try {
            var share = button.closest('[data-article-share]');
            var shareUrl = share ? share.getAttribute('data-share-url') : window.location.href;
            button.disabled = true;
            button.setAttribute('aria-busy', 'true');

            if (navigator.clipboard && navigator.clipboard.writeText) {
                await navigator.clipboard.writeText(shareUrl);
            } else if (!copyTextWithFallback(shareUrl)) {
                throw new Error('瀏覽器未允許複製連結');
            }

            setArticleShareStatus(button, '連結已複製');
        } catch (error) {
            console.error('複製文章連結失敗：', error);
            setArticleShareStatus(button, '暫時無法複製，請稍後再試');
        } finally {
            button.disabled = false;
            button.removeAttribute('aria-busy');
        }
    }

    /// <summary>
    /// 呼叫手機或瀏覽器原生分享選單。
    /// </summary>
    async function openNativeArticleShare(button) {
        try {
            var share = button.closest('[data-article-share]');
            await navigator.share({
                title: share ? share.getAttribute('data-share-title') : document.title,
                url: share ? share.getAttribute('data-share-url') : window.location.href
            });
            setArticleShareStatus(button, '分享選單已開啟');
        } catch (error) {
            if (error && error.name === 'AbortError') {
                setArticleShareStatus(button, '');
                return;
            }

            console.error('開啟原生分享選單失敗：', error);
            setArticleShareStatus(button, '暫時無法分享，請稍後再試');
        }
    }

    /// <summary>
    /// 判斷目前是否為 iPhone、iPad 或 iPod 瀏覽器。
    /// </summary>
    function isAppleMobileDevice() {
        return /iPad|iPhone|iPod/i.test(navigator.userAgent)
            || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
    }

    /// <summary>
    /// 初始化目前文章區塊的原生分享按鈕。
    /// </summary>
    function initializeArticleShare(scope) {
        if (!scope) {
            return;
        }

        scope.querySelectorAll('[data-share-native]').forEach(function(button) {
            button.hidden = typeof navigator.share !== 'function';
        });
    }

    /// <summary>
    /// 集中註冊靜態及連續閱讀文章的社群分享操作。
    /// </summary>
    function bindArticleShareActions() {
        if (document.documentElement.getAttribute('data-article-share-bound') === 'true') {
            return;
        }

        document.documentElement.setAttribute('data-article-share-bound', 'true');
        document.addEventListener('click', async function(event) {
            try {
                var facebookLink = event.target.closest('[data-share-facebook]');
                if (facebookLink
                    && isAppleMobileDevice()
                    && typeof navigator.share === 'function') {
                    event.preventDefault();
                    await openNativeArticleShare(facebookLink);
                    return;
                }

                var popupLink = event.target.closest('[data-share-popup]');
                if (popupLink) {
                    event.preventDefault();
                    var popup = window.open(
                        popupLink.href,
                        'bigmedia-article-share',
                        'width=720,height=620,noopener,noreferrer'
                    );
                    if (!popup) {
                        setArticleShareStatus(popupLink, '瀏覽器已封鎖分享視窗');
                    }
                    return;
                }

                var copyButton = event.target.closest('[data-share-copy]');
                if (copyButton) {
                    await copyArticleShareUrl(copyButton);
                    return;
                }

                var nativeButton = event.target.closest('[data-share-native]');
                if (nativeButton && typeof navigator.share === 'function') {
                    await openNativeArticleShare(nativeButton);
                }
            } catch (error) {
                console.error('處理文章分享操作失敗：', error);
            }
        });
    }

    // AJAX 載入功能
    $(document).ready(function() {
        const articleId = '1772088123627';

        bindTagSearchFeedback();
        bindArticleShareActions();
        initializeArticleReader(articleId);

        // 載入廣告
        loadAdvertisement(articleId);

        // 載入滾動選單
        loadScrollMenu();

        // 文章瀏覽次數由連續閱讀的目前文章判斷統一記錄。
    });

    /// <summary>
    /// 初始化文章連續閱讀觀察器與首篇文章狀態。
    /// </summary>
    /// <param name="initialArticleId">初始文章 ID。</param>
    function initializeArticleReader(initialArticleId) {
        var reader = document.getElementById('articleReader');
        var sentinel = document.getElementById('articleReaderSentinel');
        var state = document.getElementById('articleReaderState');

        if (!reader || !sentinel || !state) {
            return;
        }

        var maxArticles = parseInt(reader.getAttribute('data-max-articles') || '5', 10);
        var articleCount = reader.querySelectorAll('.article-read-block').length;
        var currentArticleId = initialArticleId;
        var nextSourceArticleId = initialArticleId;
        var activeArticleId = '';
        var isLoading = false;
        var hasMore = true;
        var scrollTicking = false;

        initializeArticleBlock(reader.querySelector('.article-read-block'));
        updateActiveArticleByScroll();

        function setReaderState(type) {
            state.querySelectorAll('span').forEach(function(item) {
                item.hidden = true;
            });

            var target = state.querySelector('.article-reader-' + type);
            if (target) {
                target.hidden = false;
            }
        }

        function finishReader() {
            hasMore = false;
            setReaderState('complete');
            if (loadObserver) {
                loadObserver.disconnect();
            }
        }

        function loadNextArticle() {
            if (isLoading || !hasMore) {
                return;
            }

            if (articleCount >= maxArticles) {
                finishReader();
                return;
            }

            isLoading = true;
            setReaderState('loader');

            $.get('/article/' + encodeURIComponent(nextSourceArticleId) + '/next')
                .done(function(html, textStatus, xhr) {
                    if (xhr.status === 204 || !html || !html.trim()) {
                        finishReader();
                        return;
                    }

                    var wrapper = document.createElement('div');
                    wrapper.innerHTML = html.trim();
                    var nextBlock = wrapper.querySelector('.article-read-block');

                    if (!nextBlock) {
                        finishReader();
                        return;
                    }

                    reader.appendChild(nextBlock);
                    articleCount += 1;
                    nextSourceArticleId = nextBlock.getAttribute('data-article-id') || nextSourceArticleId;
                    initializeArticleBlock(nextBlock);
                    updateActiveArticleByScroll();

                    if (articleCount >= maxArticles) {
                        finishReader();
                    } else {
                        state.querySelectorAll('span').forEach(function(item) {
                            item.hidden = true;
                        });
                    }
                })
                .fail(function() {
                    setReaderState('error');
                })
                .always(function() {
                    isLoading = false;
                });
        }

        var loadObserver = new IntersectionObserver(function(entries) {
            entries.forEach(function(entry) {
                if (entry.isIntersecting) {
                    loadNextArticle();
                }
            });
        }, {
            root: null,
            rootMargin: '650px 0px',
            threshold: 0
        });

        loadObserver.observe(sentinel);

        window.addEventListener('scroll', requestActiveArticleUpdate, { passive: true });
        window.addEventListener('resize', requestActiveArticleUpdate);

        function requestActiveArticleUpdate() {
            if (scrollTicking) {
                return;
            }

            scrollTicking = true;
            window.requestAnimationFrame(function() {
                updateActiveArticleByScroll();
                scrollTicking = false;
            });
        }

        function updateActiveArticleByScroll() {
            var blocks = Array.from(reader.querySelectorAll('.article-read-block'));
            if (blocks.length === 0) {
                return;
            }

            var marker = Math.min(window.innerHeight * 0.35, 280);
            var activeBlock = blocks[0];
            var closestDistance = Number.POSITIVE_INFINITY;

            blocks.forEach(function(block) {
                var rect = block.getBoundingClientRect();

                if (rect.top <= marker && rect.bottom > marker) {
                    activeBlock = block;
                    closestDistance = 0;
                    return;
                }

                var distance = Math.abs(rect.top - marker);
                if (distance < closestDistance) {
                    closestDistance = distance;
                    activeBlock = block;
                }
            });

            var nextActiveArticleId = activeBlock.getAttribute('data-article-id') || currentArticleId;
            if (nextActiveArticleId === activeArticleId) {
                return;
            }

            activeArticleId = nextActiveArticleId;
            currentArticleId = nextActiveArticleId;
            updateArticleHead(activeBlock);
            recordArticleView(nextActiveArticleId, nextActiveArticleId !== initialArticleId);
        }
    }

    /// <summary>
    /// 初始化單篇文章區塊的表單回饋、廣告與外掛內容。
    /// </summary>
    /// <param name="block">文章區塊 DOM。</param>
    function initializeArticleBlock(block) {
        if (!block) {
            return;
        }

        bindTagSearchFeedback();
        initializeArticleShare(block);
        initializeArticleAds(block);
        initializeArticleAiIframes(block);
        initializeArticleLiveStream(block);
        loadTagRelatedNews(block.getAttribute('data-article-id'), block);

        if (!isMobileArticleLayout()) {
            loadLatestNews(block);
        }
    }

    /// <summary>
    /// 判斷目前是否為手機文章版面，手機版會減少推薦區塊避免閱讀動線過長。
    /// </summary>
    /// <returns>是否為手機寬度。</returns>
    function isMobileArticleLayout() {
        return window.matchMedia('(max-width: 767.98px)').matches;
    }

    /// <summary>
    /// 初始化文章內的 AI 衍伸知識 iframe，支援連續閱讀的多篇文章各自取自己的內容。
    /// </summary>
    /// <param name="scope">文章區塊 DOM。</param>
    function initializeArticleAiIframes(scope) {
        $(scope).find('iframe.bigmedia-ai-iframe').each(function() {
            var iframe = this;

            if (iframe.getAttribute('data-ai-initialized') === 'true') {
                return;
            }

            iframe.setAttribute('data-ai-initialized', 'true');
            configureArticleAiIframe(iframe);
            iframe.addEventListener('load', function() {
                configureArticleAiIframe(iframe);
                postArticleUrlToAiIframe(iframe);
            });

            setTimeout(function() {
                postArticleUrlToAiIframe(iframe);
            }, 300);
        });
    }

    /// <summary>
    /// 套用 AI iframe 的無捲軸設定。
    /// </summary>
    /// <param name="iframe">AI iframe DOM。</param>
    function configureArticleAiIframe(iframe) {
        iframe.style.overflow = 'hidden';
        iframe.style.setProperty('overflow', 'hidden', 'important');
        iframe.style.setProperty('overflow-x', 'hidden', 'important');
        iframe.style.setProperty('overflow-y', 'hidden', 'important');
        iframe.setAttribute('scrolling', 'no');
    }

    /// <summary>
    /// 將該文章自己的網址傳給 AI iframe。
    /// </summary>
    /// <param name="iframe">AI iframe DOM。</param>
    function postArticleUrlToAiIframe(iframe) {
        if (!iframe.contentWindow) {
            return;
        }

        var articleBlock = iframe.closest('.article-read-block');
        var articleUrl = articleBlock ? articleBlock.getAttribute('data-article-url') : window.location.pathname;
        var absoluteUrl = new URL(articleUrl || window.location.pathname, window.location.origin).toString();

        iframe.contentWindow.postMessage({
            type: 'url',
            url: absoluteUrl
        }, 'https://www.bigmedia.com.tw');
    }

    /// <summary>
    /// 初始化單篇文章底部 AdSense，避免同一廣告重複 push。
    /// </summary>
    /// <param name="scope">文章區塊 DOM。</param>
    function initializeArticleAds(scope) {
        $(scope).find('ins.adsbygoogle.article-inline-ad, ins.adsbygoogle.article-sidebar-ad').each(function() {
            if (this.getAttribute('data-ad-initialized') === 'true') {
                return;
            }

            try {
                (window.adsbygoogle = window.adsbygoogle || []).push({});
                this.setAttribute('data-ad-initialized', 'true');
            } catch (ex) {
                console.log('文章內廣告初始化失敗:', ex);
            }
        });
    }

    /// <summary>
    /// 初始化每篇文章內的直播區塊，使用唯一容器避免重複 DOM id。
    /// </summary>
    /// <param name="scope">文章區塊 DOM。</param>
    function initializeArticleLiveStream(scope) {
        $(scope).find('.article-live-stream').each(function() {
            if (this.getAttribute('data-live-initialized') === 'true') {
                return;
            }

            var ppnId = this.getAttribute('data-ppn-id');
            if (!ppnId) {
                return;
            }

            this.id = ppnId + '-' + Date.now() + '-' + Math.floor(Math.random() * 1000);
            this.setAttribute('data-live-initialized', 'true');

            try {
                if (window.ppnio && typeof window.ppnio.push === 'function') {
                    window.ppnio.push(this.id);
                }
            } catch (ex) {
                console.log('直播區塊初始化失敗:', ex);
            }
        });
    }

    /// <summary>
    /// 依目前閱讀文章同步網址、標題與 SEO meta。
    /// </summary>
    /// <param name="articleBlock">目前閱讀中的文章區塊。</param>
    function updateArticleHead(articleBlock) {
        if (!articleBlock) {
            return;
        }

        var url = articleBlock.getAttribute('data-article-url') || window.location.pathname;
        var absoluteUrl = new URL(url, window.location.origin).toString();
        var title = articleBlock.getAttribute('data-article-title') || document.title;
        var description = articleBlock.getAttribute('data-article-description') || '';
        var image = articleBlock.getAttribute('data-article-image') || '';
        var category = articleBlock.getAttribute('data-article-category') || '';
        var published = articleBlock.getAttribute('data-article-published') || '';
        var modified = articleBlock.getAttribute('data-article-modified') || published;
        var author = articleBlock.getAttribute('data-article-author') || '鉅聞天下';
        var tags = (articleBlock.getAttribute('data-article-tags') || '').split(',').map(function(tag) {
            return tag.trim();
        }).filter(Boolean);

        if (window.location.pathname !== new URL(absoluteUrl).pathname) {
            history.replaceState({ articleId: articleBlock.getAttribute('data-article-id') }, title, url);
        }

        document.title = title + ' - 鉅聞天下';
        setMetaContent('metaTitle', title);
        setMetaContent('metaDescription', description);
        setMetaContent('metaKeywords', tags.join(','));
        setMetaContent('metaImage', image);
        setMetaContent('ogTitle', title);
        setMetaContent('ogDescription', description);
        setMetaContent('ogImage', image);
        setMetaContent('ogUrl', absoluteUrl);
        setMetaContent('ogKeywords', tags.join(','));
        setMetaContent('ogImageAlt', title);
        setMetaContent('articleSection', category);
        setMetaContent('articlePublishedTime', published);
        setMetaContent('articleModifiedTime', modified);
        setMetaContent('articleAuthor', author);
        setMetaContent('metaSection', category);
        setMetaContent('metaPubdate', formatMetaDate(published));
        setMetaContent('metaLastmod', formatMetaDate(modified));
        setMetaContent('twitterTitle', title);
        setMetaContent('twitterDescription', description);
        setMetaContent('twitterImage', image);
        setLinkHref('canonicalLink', absoluteUrl);
        setLinkHref('imageSrcLink', image);

        var lastModifiedHttp = document.getElementById('metaLastModifiedHttp');
        if (lastModifiedHttp && modified) {
            lastModifiedHttp.setAttribute('content', new Date(modified).toUTCString());
        }

        document.querySelectorAll('meta[property="article:tag"][data-dynamic-article-tag="true"]').forEach(function(item) {
            item.remove();
        });

        tags.forEach(function(tag) {
            var meta = document.createElement('meta');
            meta.setAttribute('property', 'article:tag');
            meta.setAttribute('content', tag);
            meta.setAttribute('data-dynamic-article-tag', 'true');
            document.head.appendChild(meta);
        });
    }

    /// <summary>
    /// 更新指定 meta 元素的 content 屬性。
    /// </summary>
    function setMetaContent(id, value) {
        var meta = document.getElementById(id);
        if (meta && value !== undefined && value !== null) {
            meta.setAttribute('content', value);
        }
    }

    /// <summary>
    /// 更新指定 link 元素的 href 屬性。
    /// </summary>
    function setLinkHref(id, value) {
        var link = document.getElementById(id);
        if (link && value) {
            link.setAttribute('href', value);
        }
    }

    /// <summary>
    /// 將 ISO 日期轉成既有 meta 使用的 yyyy-MM-dd HH:mm 格式。
    /// </summary>
    function formatMetaDate(value) {
        if (!value) {
            return '';
        }

        var date = new Date(value);
        if (Number.isNaN(date.getTime())) {
            return value;
        }

        var pad = function(number) {
            return String(number).padStart(2, '0');
        };

        return date.getFullYear() + '-' + pad(date.getMonth() + 1) + '-' + pad(date.getDate()) + ' ' + pad(date.getHours()) + ':' + pad(date.getMinutes());
    }

    /// <summary>
    /// 記錄文章瀏覽次數
    /// </summary>
    /// <param name="articleId">文章ID</param>
    function recordArticleView(articleId, allowReloadRecord) {
        try {
            // 使用 Performance Navigation API 檢測是否為重新整理
            var navigationType = 'navigate';
            
            // 優先使用新的 Performance Navigation API
            if (performance.getEntriesByType && performance.getEntriesByType('navigation').length > 0) {
                var navEntry = performance.getEntriesByType('navigation')[0];
                navigationType = navEntry.type;
            }
            // 備用方案：使用舊的 performance.navigation API
            else if (performance.navigation) {
                var navType = performance.navigation.type;
                // 0 = TYPE_NAVIGATE, 1 = TYPE_RELOAD, 2 = TYPE_BACK_FORWARD
                if (navType === 1) {
                    navigationType = 'reload';
                } else if (navType === 2) {
                    navigationType = 'back_forward';
                }
            }

            // 如果是重新整理，不記錄瀏覽次數
            if (navigationType === 'reload' && !allowReloadRecord) {
                console.log('頁面為重新整理，不記錄瀏覽次數');
                return;
            }

            // 使用 SessionStorage 作為備用檢查機制，避免同一頁面多次計數
            var storageKey = 'viewed_article_' + articleId + '_' + new Date().toDateString();
            if (sessionStorage.getItem(storageKey)) {
                console.log('已在本次會話中記錄過，不重複計數');
                return;
            }

            // 發送 AJAX 請求記錄瀏覽次數
            $.ajax({
                type: 'POST',
                url: '/Article/RecordArticleView',
                data: { articleId: articleId },
                success: function(response) {
                    if (response.success) {
                        // 在 SessionStorage 中記錄已瀏覽
                        sessionStorage.setItem(storageKey, '1');
                        console.log('瀏覽次數記錄成功');
                    } else {
                        console.log('瀏覽次數記錄失敗:', response.error || '未知錯誤');
                    }
                },
                error: function(xhr, status, error) {
                    // 靜默處理錯誤，不影響頁面顯示
                    console.log('瀏覽次數記錄請求失敗:', error);
                }
            });
        } catch (ex) {
            // 靜默處理異常，不影響頁面顯示
            console.log('記錄瀏覽次數時發生錯誤:', ex);
        }
    }

    function loadAdvertisement(articleId) {
        console.log('開始載入廣告...');
        $.get('/Article/GetAdvertisement', { articleId: articleId })
            .done(function(response) {
                console.log('廣告 API 回應:', response);
                if (response.success && response.data && response.data.trim() !== '') {
                    console.log('有廣告內容，顯示廣告區域');
                    var $adContainer = $('#top-banner-ad');
                    var $rowContainer = $('#top-banner-row');
                    
                    // 插入廣告內容到 DOM
                    $adContainer.html(response.data);
                    
                    // 確保容器可見（移除可能被設定的隱藏樣式）
                    $adContainer.show();
                    $rowContainer.show();
                    var adElement = $adContainer[0];
                    if (adElement) {
                        // 移除可能被設定的隱藏樣式
                        adElement.style.removeProperty('display');
                        adElement.style.removeProperty('height');
                        adElement.style.removeProperty('min-height');
                    }
                    if ($rowContainer.length > 0) {
                        var rowElement = $rowContainer[0];
                        if (rowElement) {
                            // 移除可能被設定的隱藏樣式
                            rowElement.style.removeProperty('display');
                            rowElement.style.removeProperty('height');
                            rowElement.style.removeProperty('min-height');
                        }
                    }
                    
                    // 檢查是否有 AdSense 廣告需要初始化
                    // 當透過 AJAX 動態載入 AdSense 廣告時，需要手動觸發初始化
                    var $adsbygoogle = $adContainer.find('ins.adsbygoogle');
                    if ($adsbygoogle.length > 0) {
                        console.log('發現 AdSense 廣告，開始初始化...', $adsbygoogle.length, '個廣告元素');
                        
                        // 執行內嵌的 script 標籤（動態載入的 script 需要手動執行）
                        $adContainer.find('script').each(function() {
                            try {
                                var scriptContent = $(this).html();
                                if (scriptContent && scriptContent.trim()) {
                                    // 創建新的 script 元素並執行
                                    var scriptElement = document.createElement('script');
                                    scriptElement.textContent = scriptContent;
                                    document.head.appendChild(scriptElement);
                                    document.head.removeChild(scriptElement);
                                }
                            } catch (e) {
                                console.error('執行 AdSense script 失敗:', e);
                            }
                        });
                        
                        // 如果沒有 script 標籤，手動觸發初始化
                        if ($adContainer.find('script').length === 0) {
                            // 確保 adsbygoogle 存在
                            if (typeof window.adsbygoogle === 'undefined') {
                                window.adsbygoogle = [];
                            }
                            // 為每個 AdSense 廣告元素 push 一個對象
                            $adsbygoogle.each(function() {
                                (window.adsbygoogle = window.adsbygoogle || []).push({});
                            });
                            console.log('AdSense 廣告手動初始化完成');
                        }
                    }
                } else {
                    // 參考首頁橫幅廣告的處理方式：清空容器讓 CSS :empty 選擇器自動隱藏
                    hideTopBannerAd();
                }
            })
            .fail(function() {
                // 參考首頁橫幅廣告的處理方式：清空容器讓 CSS :empty 選擇器自動隱藏
                hideTopBannerAd();
            });
    
}

/**
 * 隱藏橫幅廣告容器（參考首頁橫幅廣告的處理方式）
 */
function hideTopBannerAd() {
    var $adContainer = $('#top-banner-ad');
    var $rowContainer = $('#top-banner-row');
    
    if ($adContainer.length === 0) {
        return;
    }
    
    // 清空容器內容，讓 CSS :empty 選擇器自動隱藏
    $adContainer.empty();
    
    // 強制設定樣式確保隱藏
    var adElement = $adContainer[0];
    if (adElement) {
        adElement.style.setProperty('display', 'none', 'important');
        adElement.style.setProperty('height', '0', 'important');
        adElement.style.setProperty('min-height', '0', 'important');
        adElement.style.setProperty('margin', '0', 'important');
        adElement.style.setProperty('padding', '0', 'important');
    }
    
    // 隱藏整個 row
    if ($rowContainer.length > 0) {
        var rowElement = $rowContainer[0];
        if (rowElement) {
            rowElement.style.setProperty('display', 'none', 'important');
            rowElement.style.setProperty('height', '0', 'important');
            rowElement.style.setProperty('min-height', '0', 'important');
            rowElement.style.setProperty('margin', '0', 'important');
            rowElement.style.setProperty('padding', '0', 'important');
        }
        
        // 移除 col-lg-12 的 margin-bottom
        $rowContainer.find('.col-lg-12').css('margin-bottom', '0');
        var colElement = $rowContainer.find('.col-lg-12')[0];
        if (colElement) {
            colElement.style.setProperty('margin-bottom', '0', 'important');
        }
    }
}


    function loadRelatedArticles(articleId, scope) {
        var $target = scope ? $(scope).find('.related-articles-container') : $('#related-articles');

        $.get('/Article/GetRelatedArticles', { articleId: articleId })
            .done(function(response) {
                if (response.success) {
                    $target.html(response.data);
                } else {
                    $target.html('<p>暫無相關文章</p>');
                }
            })
            .fail(function() {
                $target.html('<p>載入失敗</p>');
            });
    }

    /// <summary>
    /// 載入相關新聞（依標籤比對）
    /// </summary>
    /// <param name="articleId">文章ID</param>
    function loadTagRelatedNews(articleId, scope) {
        var $target = scope ? $(scope).find('.tag-related-news-container') : $('#tag-related-news');

        $.get('/Article/GetTagRelatedNews', { articleId: articleId })
            .done(function(response) {
                if (response.success && response.data && response.data.trim() !== '') {
                    $target.html(response.data);
                } else {
                    $target.html('<p>暫無相關新聞</p>');
                }
            })
            .fail(function() {
                $target.html('<p>載入失敗</p>');
            });
    }

    function loadLatestNews(scope) {
        var $target = scope ? $(scope).find('.latest-news-container') : $('#latest-news');

        $.get('/Article/GetLatestNews')
            .done(function(response) {
                if (response.success) {
                    $target.html(response.data);
                } else {
                    $target.html('<p>暫無最新消息</p>');
                }
            })
            .fail(function() {
                $target.html('<p>載入失敗</p>');
            });
    }

    function loadScrollMenu() {
        $.get('/Article/GetScrollMenu')
            .done(function(response) {
                if (response.success) {
                    $('#scroll-menu').html(response.data);
                }
            })
            .fail(function() {
                // ScrollMenu 載入失敗時保持空白，不顯示錯誤訊息
            });
    }
</script>

