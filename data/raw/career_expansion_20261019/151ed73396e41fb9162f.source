                  <li>
                    <div class="img"><a class="example-image-link" data-lightbox="example-set" href="https://www.vac.gov.tw/Public/Images/202007/4852007211330b2666.jpg" data-title="大合照"><img src="https://www.vac.gov.tw/Public/Images/202007/4852007211330b2666.jpg" alt="大合照"></a></div>
