<script type="text/javascript">
document.addEventListener("DOMContentLoaded", function() {
    const originalSize = 22; // 原始字體大小

    // 取得文章段落
    const articleParagraphs = document.querySelectorAll('.theme-article-content article p');

    // 設置按鈕的事件監聽器
    document.getElementById('a_small').addEventListener('click', function() {
        changeFontSize(-2);
    });

    document.getElementById('a_midd').addEventListener('click', function() {
        setFontSize(originalSize);
    });

    document.getElementById('a_big').addEventListener('click', function() {
        changeFontSize(2);
    });

    function changeFontSize(change) {
        articleParagraphs.forEach(p => {
            const currentSize = parseFloat(window.getComputedStyle(p).fontSize);
            p.style.fontSize = `${currentSize + change}px`;
        });
    }

    function setFontSize(size) {
        articleParagraphs.forEach(p => {
            p.style.fontSize = `${size}px`;
        });
    }
});
</script><script type="text/javascript" src="https://cnews.com.tw/wp-includes/js/dist/hooks.min.js?ver=dd5603f07f9220ed27f1" id="wp-hooks-js"></script>
