<style id='wpcb-styles-header'>
@media screen and (min-width: 1722px){
    #nav.fixed>ul ._logo>a {
        background-image: url(https://cnews.com.tw/wp-content/themes/cnews-theme/assets/images/logo_04.svg)!important;
        width: 75px!important;
        height: 25px!important;
        background-size: 75px 25px!important;
    }
}
.read-more-btn_video{
    display: block;
    width: 40%;
    margin: 0 auto 30px auto;
    text-align: center;
    height: 55px;
    line-height: 50px;
    border: 1.5px solid #9068ff;
    text-decoration: none;
    color: #9068ff;
    font-size: 16px;
    background-color: #9068ff33;
}
.read-more-btn_today{
    display: block;
    width: 40%;
    margin: 0 auto 30px auto;
    text-align: center;
    height: 55px;
    line-height: 50px;
    border: 1.5px solid #1fcbd6;
    text-decoration: none;
    color: #1fcbd6;
    font-size: 16px;
    background-color: #1fcbd624;
}
.read-more-btn_forums{
    display: block;
    width: 40%;
    margin: 60px auto 30px auto;
    text-align: center;
    height: 55px;
    line-height: 50px;
    border: 1.5px solid #1fcbd6;
    text-decoration: none;
    color: #1fcbd6;
    font-size: 16px;
    background-color: #1fcbd624;
}
.read-more-btn_health{
  	display: none;
    width: 40%;
    margin: 30px auto 30px auto;
    text-align: center;
    height: 55px;
    line-height: 50px;
    border: 1.5px solid #28c163;
    text-decoration: none;
    color: #28c163;
    font-size: 16px;
    background-color: #28c16326;
}
.read-more-btn_life{
  display: none;
    width: 40%;
    margin: 30px auto 30px auto;
    text-align: center;
    height: 55px;
    line-height: 50px;
    border: 1.5px solid #ff76ac;
    text-decoration: none;
    color: #ff76ac;
    font-size: 16px;
    background-color: #ff76ac24;
}
.read-more-btn_financial{
  display: none;
    width: 40%;
    margin: 30px auto 30px auto;
    text-align: center;
    height: 55px;
    line-height: 50px;
    border: 1.5px solid #ffe41c;
    text-decoration: none;
    color: #ffe41c;
    font-size: 16px;
    background-color: #ffe41c17;
}
@media (max-width: 767px) {
 	.read-more-btn_video{
   	 width: 90%;
	}
    .read-more-btn_today{
      width: 90%;
  	}
    .read-more-btn_forums{
      width: 90%;
  	}
  	.read-more-btn_health{
  		display: block;
      	width: 90%;
      	margin: 10px auto 30px auto;
	}
	.read-more-btn_life{
  		display: block;
     	width: 90%;
      	margin: 10px auto 30px auto;
	}
	.read-more-btn_financial{
  		display: block;
      	width: 90%;
      	margin: 10px auto 30px auto;
	}
}









#mobile-search{
		display:none;
}
@media (max-width: 767px) {
	#mobile-search{
		display:block;
      	width: 100%;
      	position: absolute;
        top: 0;
        height: 40px;
        z-index: 2;
      	background-color: #bcfeff;
	}
    #mobile-search .content {
      margin: 0 15px;
      height: 100%;
      display: -webkit-box;
      display: -ms-flexbox;
      display: flex;
      display: -webkit-flex;
      -webkit-box-align: center;
      -ms-flex-align: center;
      align-items: center;
      -webkit-align-items: center;
  }
  #mobile-search input {
      position: relative;
      border: 0;
      padding: 0;
      height: 20px;
      width: calc(100% - 10px);
      color: #202020;
      background-color: transparent;
  }
  #mobile-search input::placeholder {
    color:#138f90;
  }
  #nav>ul {
    padding-top: 40px;
  }
  .cnews-head-format .article-dot+.container {
    z-index: 2;
  }
}

ul.info>li .icon.post-views{
    float: left;
    height: 22px;
    margin: 0 4px 0 0;
}
ul.info .post-views{
    display: inline-block;
    padding-right: 10px;
}
.icon.eye {
  	float: left;
  	width: 16px;
    height: 22px;
    margin: 0 4px 0 0;
    background-image: url(https://cnews.com.tw/wp-content/themes/cnews-theme/assets/images/eye.svg);
}


#nav.fixed{
  z-index: 10;
}
#header{
  z-index: 9;
}
.grecaptcha-badge {
    opacity: 0;
}

#authorSlider .avatar {
	border-radius: 50%;
	aspect-ratio: 1/1;
}

#authorSlider .slider-image .circle {
	position: absolute;
	top: 0;
	left: 0;
}

article.post_video-video img.news-cover {
    display: none;
}

.video-rwd {
    position: relative;
    padding-bottom: 56.25%;
}
 
.video-rwd iframe {
	position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
}

.theme-article-content article iframe[src*="youtube.com"] {
    aspect-ratio: 16/9;
    width: 100%;
    height: 100%;
}
@media print{
    body{
      width: 100%;
      margin: 0;
      float: none;
      line-height: 1.5;
      font-size: 12pt;
    }
    img {
        max-width: 100%;
    }
    a:link, a:visited, a {
          background: transparent;
          color: #222;
          font-weight: bold;
          text-decoration: underline;
          text-align: left;
          word-wrap: break-word; /*避免網址過長超出頁面*/
    }
    a[href^="http://"]:after, a[href^="https://"]:after {
        content: " (" attr(href) ") ";
    }
    thead{
        display: table-header-group; /* 表格即使分頁也會顯示表頭 */
    }
    #nav, #socialMediaTab, aside, .keywords, .page-tab, .extend-wrapper, #sponsor, footer, header{
        display: none!important;
    }
    .special-format .info-wrapper, .breadcrumb, .indicator, .flicker, li, #adGeek-slot-compass-fit-4285866, .fb-comments, #_popIn_recommend{
        display: none!important;
    }
    h1, h2, h3, h4, h5, h6 {
        page-break-after:avoid;
        page-break-inside:avoid
    }
    h1+p, h2+p, h3+p {
        page-break-before: avoid;
    }
    a {
