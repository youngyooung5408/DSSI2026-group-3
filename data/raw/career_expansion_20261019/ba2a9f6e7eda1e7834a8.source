<script>
	var pvUrl = document.getElementById('ppv').getAttribute('rel');
	fetch(pvUrl).then(function() {});
	var tags = Array.from(document.getElementsByClassName('trigger_tag'));
	var channel_id = document.querySelector('meta[name="channel_id"]').getAttribute('content');
	tags.forEach(function(tag) {
		tag.addEventListener('click', function handleClick(event) {
			event.preventDefault();
			var tagUrl = '//misc.udn.com/api/EventCollect/' + channel_id + '/' + this.getAttribute('rel');
			var href = this.getAttribute('href');
			fetch(tagUrl, {cache: 'no-cache'}).then(function() {
				location.href = href;
			}).catch(function() {
				location.href = href;
			});
		});
	});

	(function() {
		function getCookie(name) {
			var match = document.cookie.match(new RegExp('(?:^|; )' + name.replace(/([.$?*|{}()[\]\\/+^])/g, '\\$1') + '=([^;]*)'));
			return match ? decodeURIComponent(match[1]) : '';
		}
		var box = document.getElementById('subscribe_newsletter');
		var btn = document.getElementById('subscribe_newsletter_btn');
		if (!box || !btn) return;

		function hideBox() {
			box.style.display = 'none';
		}

		// 已登入：查 2026_vote_epaper，有資料就不顯示
		var udnmember = getCookie('udnmember');
		if (udnmember) {
			var checkApi = box.getAttribute('data-check-api') || '/vote2026/ajax/vote_epaper_check';
			fetch(checkApi, {credentials: 'same-origin', cache: 'no-cache'})
				.then(function(res) { return res.json(); })
				.then(function(data) {
					if (data && data.subscribed) hideBox();
				})
				.catch(function() {});
		}

		var submitting = false;
		btn.addEventListener('click', function() {
			if (submitting) return;
			udnmember = getCookie('udnmember');
			if (!udnmember) {
				var loginUrl = 'https://member.udn.com/member/login.jsp'
					+ '?site=news&again=y'
					+ '&redirect=' + window.location.href;
				window.location.href = loginUrl;
				return;
			}
			submitting = true;
			btn.disabled = true;
			var api = box.getAttribute('data-api') || '/vote2026/ajax/vote_epaper';
			fetch(api, {
				method: 'POST',
				credentials: 'same-origin',
				headers: {'Content-Type': 'application/json'},
				body: JSON.stringify({udnmember: udnmember})
			}).then(function(res) {
				return res.json();
			}).then(function(data) {
				if (data && data.status === 'success') {
					alert(data.message || '訂閱成功');
					hideBox();
				} else {
					btn.disabled = false;
					submitting = false;
					alert((data && data.message) ? data.message : '訂閱失敗，請稍後再試');
				}
			}).catch(function() {
				btn.disabled = false;
				submitting = false;
				alert('訂閱失敗，請稍後再試');
			});
		});
	})();
</script>
