<style id="wp-custom-css">
.navigation .menu > li.new-channel > a {
  position: relative;  
}

.nav-hov-b .menu > li.new-channel > a:after {
  content: "NEW";
	display: block;
  position: absolute;
  top: 8px;          
  right: -8px;
  background-color: #ff0000; 
  color: #ffffff;            
  font-size: 9px;  
	font-weight: bold;
  line-height: 1;
  padding: 2px 4px;
  border-radius: 4px;        

  animation: badge-pulse 1.2s infinite ease-in-out;
  transform-origin: center center;
}

@keyframes badge-pulse {
  0%, 100% {
    transform: translateY(0);
    
  }
  50% {
   transform: translateY(-2px); 
  }
}
</style>


