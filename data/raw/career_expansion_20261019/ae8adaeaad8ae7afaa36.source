cate=18",{"id":261,"name":262,"type_id":7,"category_id":7,"sub":263,"url":264,"target":8,"pageUrltag":7,"image_path":147,"thumb_path":147},21,"影片欣賞",[],"/data/2?cate=19",{"id":266,"name":267,"type_id":7,"category_id":7,"sub":268,"url":269,"target":8,"pageUrltag":7,"image_path":147,"thumb_path":147},22,"特色景點",[],"/attraction",{"id":271,"name":272,"type_id":7,"category_id":7,"sub":273,"url":274,"target":8,"pageUrltag":7,"image_path":147,"thumb_path":147},23,"魅力行程",[],"/data/2?cate=20",{"id":276,"name":277,"type_id":211,"category_id":7,"sub":278,"url":7,"target":8,"pageUrltag":7,"image_path":147,"thumb_path":147},24,"出版品",[],{"id":280,"name":6,"type_id":7,"category_id":7,"sub":281,"url":7,"target":8,"pageUrltag":7,"image_path":147,"thumb_path":147},25,[282,286,291,295,299,304,308],{"id":283,"name":12,"type_id":7,"category_id":7,"sub":284,"url":285,"target":8,"pageUrltag":7,"image_path":147,"thumb_path":147},26,[],"/data/3?cate=3",{"id":287,"name":288,"type_id":7,"category_id":7,"sub":289,"url":290,"target":8,"pageUrltag":7,"image_path":147,"thumb_path":147},27,"課室人員",[],"/data/11",{"id":292,"name":35,"type_id":7,"category_id":7,"sub":293,"url":294,"target":8,"pageUrltag":7,"image_path":147,"thumb_path":147},28,[],"/data/12",{"id":296,"name":18,"type_id":7,"category_id":7,"sub":297,"url":298,"target":8,"pageUrltag":7,"image_path":147,"thumb_path":147},29,[],"/data/13",{"id":300,"name":301,"type_id":7,"category_id":7,"sub":302,"url":303,"target":8,"pageUrltag":7,"image_path":147,"thumb_path":147},30,"村長簡介",[],"/village",{"id":305,"name":16,"type_id":7,"category_id":7,"sub":306,"url":307,"target":8,"pageUrltag":7,"image_path":147,"thumb_path":147},31,[],"/data/3?cate=5",{"id":309,"name":310,"type_id":7,"category_id":7,"sub":311,"url":312,"target":163,"pageUrltag":7,"image_path":147,"thumb_path":147},32,"線上報修",[],"https://em.ji-an.gov.tw/",{"id":314,"name":315,"type_id":7,"category_id":7,"sub":316,"url":7,"target":8,"pageUrltag":7,"image_path":147,"thumb_path":147},33,"與民互