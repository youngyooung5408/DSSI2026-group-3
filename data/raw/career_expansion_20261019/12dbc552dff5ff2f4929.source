}
.yinks1_narrow .featuredTitle{
font:normal 16px ;
color:#333
}
.yinks1_narrow .featuredTitle a:hover{
color:#f7c197;
}
.yinks1_wide .featuredPostMeta{
float:left;
}
.yinks1 h5 a,.yinks1 h5 a:visited{
color:#333;
}
.yinks1_narrow .featuredTitle a{
color:#000000;
}
