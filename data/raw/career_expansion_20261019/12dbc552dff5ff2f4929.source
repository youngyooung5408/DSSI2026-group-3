<script>
	$(".owl-carousel").owlCarousel({
		items: 3, // 一次輪播幾個項目
		loop: true, // 循環輪播,關=false,開true
		margin: 20, // 與右邊圖片的距離
		nav: false, // 導航文字
		autoplay: true, // 自動輪播,關=false,開true 
		autoplayTimeout: 5000, // 切換時間
		autoplayHoverPause: true // 滑鼠經過時暫停
	})
</script>
