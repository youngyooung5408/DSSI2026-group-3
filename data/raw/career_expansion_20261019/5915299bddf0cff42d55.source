<!-- 讀者留言：程式與樣式由留言服務提供，載不到或逾時只影響這個區塊；文章區塊靠左浮動，容器自己清除浮動，樣式沒載到時也排在文章下方 -->
<!-- min-height 由新聞站自己的樣式撐出來，不依賴留言服務的樣式表；那個服務連不上時這裡仍要成立 -->
<div id="ltn-comments" style="clear: both; min-height: 320px;" data-article="breakingnews/5563521" data-sig="cd82cce89be365d1d77807bc18c23d3f18075bbfa9a63db69c4e15f4c5a649a6" data-nosnippet><p class="ltn-comments-reserve-label">讀者留言</p></div>
<script>
    (function() {
        var box = document.getElementById('ltn-comments');
        var baseUrl = "https:\/\/comments.ltn.com.tw\/embed\/";
        // 8 秒內留言區沒畫出第一批結果（程式檔沒到或資料沒回）就放棄；晚到的程式檔看到放棄標記不會再接手
        var timeoutMs = 8000;
        if (!box) {
            return;
        }

        function fail() {
            if (box.hasAttribute('data-ltnc-ready') || box.hasAttribute('data-ltnc-failed')) {
                return;
            }
            box.setAttribute('data-ltnc-failed', '1');
            box.textContent = '';
            var notice = document.createElement('p');
            notice.className = 'ltnc-unavailable';
            notice.textContent = '留言暫時無法載入';
            box.appendChild(notice);
        }

        var failCountdownStarted = false;

        // 放棄的 8 秒從「真正開始向留言服務要程式檔」那一刻起算，不從頁面載入完成起算：它量
        // 的是服務回應得夠不夠快，而下面那道「靠近才掛上」的門最多會先等 4 秒。從頁面載入完成
        // 起算等於把等門的時間算進服務的額度裡——不支援 preload 的瀏覽器要等門開了才開始抓，
        // 額度會被吃掉一半（實測容忍上限從 7.94 秒掉到 3.96 秒），服務正常也會被判成連不上。
        // 代價：在「要等門開才開始抓」的那條路上（不支援 preload），完全不捲動的讀者碰上留言服務
        // 接得上連線卻永遠不回應時，「留言暫時無法載入」會從第 8 秒延到最晚第 12 秒才出現（等門
        // 的 4 秒加上 8 秒）。那時那一塊還在螢幕外，讀者看不到，所以接受。
        function startFailCountdown() {
            if (failCountdownStarted) {
                return;
            }
            failCountdownStarted = true;
            setTimeout(fail, timeoutMs);
        }

        // 瀏覽器支不支援 preload；不支援的沒有「不押住 load」的抓法（見下方開始時機）
        var canPreload = (function() {
            var probe = document.createElement('link');
            return !!(probe.relList && probe.relList.supports && probe.relList.supports('preload'));
        })();

        function attachStylesheet(href) {
            var link = document.createElement('link');
            link.rel = 'stylesheet';
            link.href = href;
            document.head.appendChild(link);
        }

        function attachScript(src) {
            // 插上元素的這一刻請求才送出去，所以在這裡開始數
            startFailCountdown();
            var script = document.createElement('script');
            script.async = true;
            script.src = src;
            script.onerror = fail;
            document.head.appendChild(script);
        }

        // 先用 preload 把檔案抓進瀏覽器快取，抓到了才掛上真正的元素。
        // 直接掛 <script> 或 <link rel="stylesheet">，這兩個檔案在等回應的期間會連整頁的
        // load 事件一起押住：留言服務沒回應時 load 就永遠不觸發，連文章頁自己掛在 load 上的
        // 嵌入影音高度調整也一起不會執行——留言壞掉不可以拖累文章頁。把元素移出 DOM 也救不回來，
        // 押住 load 的是還沒結束的那次抓取，不是元素本身。preload 不算在 load 的等待名單裡，
        // 而且抓回來的檔案會被接著掛上的元素重用，不會多抓一次。
        // onerror 只接程式檔：樣式檔沒到就讓留言區以無樣式顯示，比整區換成錯誤訊息好。
        function warmThenAttach(asType, fileName, attach, onFail) {
            var preload = document.createElement('link');
            preload.rel = 'preload';
            preload.as = asType;
            preload.href = baseUrl + fileName;
            preload.onload = function() {
                attach(preload.href);
            };
            if (onFail) {
                preload.onerror = onFail;
            }
            document.head.appendChild(preload);
        }

        // 容器離視窗還有這麼多像素就把抓好的檔案真正掛上頁面；比留言服務自己判斷
        // 「要不要抓資料」用的門檻更寬，確保畫面換成「留言載入中」的那一刻，
        // 留言服務多半已經在抓了，不會讓使用者看到一句還沒成真的話
        var ATTACH_MARGIN_PX = 600;
        // 讀者完全不捲動也不能讓容器永遠停在保留字樣，給一個上限時間，到了就當作夠靠近
        var ATTACH_FALLBACK_MS = 4000;

        function start() {
            if (!baseUrl) {
                fail();
                return;
            }

            var styleHref = null;
            var scriptHref = null;
            var gateOpen = false;
            var scriptAttached = false;

            function attachIfReady() {
                if (!gateOpen) {
                    return;
                }
                if (styleHref) {
                    attachStylesheet(styleHref);
                    styleHref = null;
                }
                if (scriptHref && !scriptAttached) {
                    attachScript(scriptHref);
                    scriptAttached = true;
                }
            }

            function openGate() {
                if (gateOpen) {
                    return;
                }
                gateOpen = true;
                attachIfReady();
            }

            if (typeof window.IntersectionObserver === 'function') {
                var observer = new window.IntersectionObserver(function(entries) {
                    var near = entries.some(function(entry) {
                        return entry.isIntersecting;
                    });
                    if (!near) {
                        return;
                    }
                    observer.disconnect();
                    openGate();
                }, { rootMargin: ATTACH_MARGIN_PX + 'px 0px' });
                observer.observe(box);
                setTimeout(function() {
                    observer.disconnect();
                    openGate();
                }, ATTACH_FALLBACK_MS);
            } else {
                // 沒有進入畫面偵測介面的瀏覽器，沿用「抓好就掛上」
                openGate();
            }

            if (!canPreload) {
                // 不能先抓進快取的瀏覽器，檔案只能在掛上元素的當下才開始抓；但「什麼時候掛上」
                // 要跟得上面一致，一樣交給那道門。繞過門直接掛，容器會在讀者還離得很遠時
                // 就被留言程式寫上「留言載入中」，正是這裡要避免的那句還沒成真的話
                styleHref = baseUrl + 'comments.css';
                scriptHref = baseUrl + 'comments.js';
                attachIfReady();
                return;
            }

            // 抓檔案的時間點不受「靠近才掛上」影響，一樣在文字結構出來就先抓，
            // 真正掛上頁面（執行留言程式、畫出「留言載入中」）才延後；preload 一插上請求就
            // 送出去了，所以放棄的時間從這裡開始數
            startFailCountdown();
            warmThenAttach('style', 'comments.css', function(href) {
                styleHref = href;
                attachIfReady();
            }, null);
            warmThenAttach('script', 'comments.js', function(href) {
                scriptHref = href;
                attachIfReady();
            }, fail);
        }

        // 文章的文字結構出來就開始抓，不等整頁（圖片、廣告、影音）載完：留言這一段本身只花
        // 零點幾秒，排在整頁後面等卻讓讀者多等好幾秒才看到留言區。
        // 不支援 preload 的瀏覽器沒有「不押住 load」的抓法，仍舊等整頁載入完成才開始。
        if (!canPreload) {
            if (document.readyState === 'complete') {
                start();
            } else {
                window.addEventListener('load', start);
            }
        } else if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', start);
        } else {
            start();
        }
    })();
</script>
