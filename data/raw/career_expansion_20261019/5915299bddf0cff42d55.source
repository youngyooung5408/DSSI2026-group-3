            '3c': {'slot': '/21202031/04-3C-mobile-sub-P-IR2', 'size': ['fluid',[1, 1], [300, 250], [320, 480],  [336, 280]]},
            'talk': {'slot': '/21202031/05-talk-mobile-sub-P-IR2', 'size': ['fluid', [336, 280], [1, 1], [300, 250], [320, 480]]},
            'estate': {'slot': '21202031/11-estate-mobile-sub-P-IR2', 'size': ['fluid', [1, 1], [300, 250], [320, 480], [336, 280]]},
            'features': {'slot': '/21202031/99-feature-mobile-sub-P-IR2', 'size': ['fluid', [1, 1], [300, 250], [320, 480], [336, 280]]},
        };

        if (host.indexOf('estate') === 0 || host.indexOf('features') === 0) {
            disable_onead_mobile_inread = true;
        }

        
        if (!cookies_m.isPC() && disable_onead_mobile_inread) {
            $('#oneadIRDFPTag').css('display', 'none');
            //IR2
            $('#ad-IR2').css('display', 'block');
            googletag.cmd.push(function() {
                googletag.defineSlot(IR2units[host]['slot'], IR2units[host]['size'], 'ad-IR2').addService(googletag.pubads());
                googletag.enableServices();
            });
            $(function(){
                googletag.cmd.push(function() {
                    googletag.display('ad-IR2');
                });
            });
        } else { //onead
            setOnead = true;
        }
    })();

    function get_now_category(host) {
        var _category = '-1';
        try {
            switch (host.toLowerCase()) {
                case 'talk':
                case 'istyle':
                case 'ent':
                case '3c':
                case 'auto':
                case 'food':
                case 'sports':
                case 'estate':
                    _category = host;
                    break;
                case 'ec':
                    _category = 'business';
                    break;
                default:
                    var secA = uri.split('/')[1];
                    var secB = uri.split('/')[2];
                    if (secA.toLowerCase()=='news') _category = secB;
                    break;
            }
        } catch (e) {

        }
        return _category;
    }

    var custom_call_MIR = function (params) {
        if ( params === null || params.hasAd === false ) {
            // 客製化 passback
        }
    }

    var custom_call_IR = function (params) {
        if ( params === null || params.hasAd === false ) {
            // 客製化 passback
        }
    }

    if (setOnead) {
        var _ONEAD = {};
        _ONEAD.pub = {};
        _ONEAD.pub.slotobj = document.getElementById("oneadIRDFPTag");
        _ONEAD.pub.slots = ["div-onead-ad"];
        _ONEAD.pub.uid = "1000054";
        _ONEAD.pub.external_url = "https://onead.onevision.com.tw/";
        _ONEAD.pub.scopes = ["spotbuy", "speed"];
        _ONEAD.pub.player_mode_div = "div-onead-ad";
        _ONEAD.pub.player_mode = cookies_m.isPC() ? "inread" : "mobile-inread";
        _ONEAD.pub.category = get_now_category(host);
        _ONEAD.pub.queryAdCallback = cookies_m.isPC() ? custom_call_IR : custom_call_MIR;
        _ONEAD.pub.is_same_adUnit = true;
        var ONEAD_pubs = ONEAD_pubs || [];
        ONEAD_pubs.push(_ONEAD);
    }
</script>
<script type="text/javascript" src = "https://ad-specs.guoshipartners.com/static/js/onead-lib.min.js"></script>
            <!-- 投票箱 -->
            <link rel="stylesheet" href="assets/css/vote.css?2026">
<script>
    async function initSurvey() {
        const ltnpoll = document.querySelector('.ltnpoll');
        if (!ltnpoll) {
            return;
        }
        const LTS_No = ltnpoll.getAttribute('data-id');
        
        let htmlData = await getTopicAndOptions(LTS_No);
        if (!htmlData) {
            console.log("問卷未找到");
            return;
        }

        if (htmlData.days == '-1') {
            console.log("投票時間未到");
            ltnpoll.outerHTML = `
                <div class="voting-container">
                    <div class="ltn-votetitle">LTN投票箱<\/div>
					<h2>${htmlData.survey.LTS_Title}<\/h2>
                    <div style="text-align:center; padding: 30px; color: #666;">
                        <h3>投票活動尚未開始！<\/h3>
                        <p>開始時間：${htmlData.survey.LTS_StartDate}<\/p>
                    <\/div>
                <\/div>
            `;
            return;
        }

        if (htmlData.days == '-2') {
            console.log("投票結束");
            const calc = calculatePercentages(htmlData);
            const htmlContent = getResultsHTML(htmlData, calc);
            ltnpoll.outerHTML = htmlContent;
            resViewCheck(1);
        } else {
            console.log("投票中");
            let rederHtml = getStartVote(htmlData);
            ltnpoll.outerHTML = rederHtml;

            // 原生事件委派，不依賴 jQuery (防止 ReferenceError: $ is not defined)
            document.addEventListener('click', function(e) {
                if (e.target && (e.target.className === 'vote-bt' || e.target.classList.contains('vote-bt'))) {
                    if (checkValue(htmlData)) {
                        submitVote(LTS_No, htmlData);
                    } else {
                        alert("請在每一題中至少勾選一個選項！");
                    }
                }
            });
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initSurvey);
    } else {
        initSurvey();
    }

    function getStartVote(htmlData) {
        let customHTML = '';
        customHTML += '<div class="voting-container">';
        
        if (htmlData.survey.LTS_TitleShow != 0) {
            customHTML += '<div class="ltn-votetitle">LTN投票箱<\/div>' + '<h2>' + htmlData.survey.LTS_Title + '<\/h2>';
        } else {
            customHTML += '<div class="ltn-votetitle">LTN投票箱<\/div>';
        }

        if (htmlData.survey.LTS_Content) {
            customHTML += '<div class="vote-desc">' + htmlData.survey.LTS_Content + '<\/div>';
        }

        htmlData.topic.forEach((q, qIndex) => {
            const opts = htmlData.optionsGroup[q.LTV_No] || [];
            const questionPrefix = htmlData.topic.length > 1 ? `${qIndex + 1}. ` : '';
            customHTML += `<div class="question-item">`;
            customHTML += `<h3 class="vote-title">${questionPrefix}${q.LTV_Subject}<\/h3>`;
            
            if (q.LTV_Multi == 1) {
                customHTML += '<span class="vote-type">*複選<\/span>';
                opts.forEach(option => {
                    customHTML += '<div class="option optionafter">';
                    customHTML += '<input type="checkbox" name="vote_' + q.LTV_No + '" value="' + option.LTVD_No + '" id="' + option.LTVD_No + '">';
                    customHTML += '<label for="' + option.LTVD_No + '">' + option.LTVD_Content + '<\/label><\/div>';
                });
            } else {
                customHTML += '<span class="vote-type">*單選<\/span>';
                opts.forEach(option => {
                    customHTML += '<div class="option optionafter">';
                    customHTML += '<input type="radio" name="vote_' + q.LTV_No + '" value="' + option.LTVD_No + '" id="' + option.LTVD_No + '">';
                    customHTML += '<label for="' + option.LTVD_No + '">' + option.LTVD_Content + '<\/label><\/div>';
                });
            }
            customHTML += '<\/div>';
        });

        let displayDays = htmlData.days;
        if (displayDays >= 0) {
            displayDays = Math.floor(displayDays) + ' 天';
        } else if (displayDays == -1) {
            displayDays = '未開始';
        } else if (displayDays == -2) {
            displayDays = '已截止';
        }

        customHTML += `<!-- 時間與投票按鈕 -->
            <div class="vote-rules" style="padding: 0 10px;">
                <span class="vote-time">剩餘時間：${displayDays}<\/span>
                <span class="vote-total">  <\/span>
            <\/div>
            <button class="vote-bt">投票看結果<\/button>
            <\/div>`;
        return customHTML;
    }

    function checkValue(htmlData) {
        let isValid = true;
        htmlData.topic.forEach(q => {
            const checked = document.querySelectorAll('input[name="vote_' + q.LTV_No + '"]:checked').length;
            if (checked === 0) {
                isValid = false;
            }
        });
        return isValid;
    }

    function submitVote(LTS_No, htmlData) {
        let selectedValues = [];
        htmlData.topic.forEach(q => {
            const selected = document.querySelectorAll('input[name="vote_' + q.LTV_No + '"]:checked');
            selected.forEach(option => {
                selectedValues.push(option.value);
            });
        });

        if (selectedValues.length > 0) {
            let voteData = {
                LTVD_No: selectedValues,
                LTS_No: LTS_No
            };

            fetch("https://vote3.ltn.com.tw/votelog", {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(voteData)
                })
                .then(response => {
                    if (!response.ok) {
                        throw new Error('AJAX Error：' + response.statusText);
                    }
                    return response.json();
                })
                .then(async data => {
                    if (data.status === 'success') {
                        // 重新加載並刷新渲染結果
                        let freshData = await getTopicAndOptions(LTS_No);
                        const calc = calculatePercentages(freshData);
                        const htmlContent = getResultsHTML(freshData, calc);
                        const container = document.querySelector('.voting-container');
                        if (container) {
                            container.outerHTML = htmlContent;
                        }
                        resViewCheck(0);
                    } else {
                        alert(data.message || '投票失敗，您可能已經投過票了！');
                    }
                })
                .catch(err => {
                    console.error(err);
                    alert('投票發生錯誤，請稍後再試！');
                });
        }
    }

    function calculatePercentages(htmlData) {
        const questionTotals = {};
        htmlData.topic.forEach(q => {
            questionTotals[q.LTV_No] = 0;
        });

        htmlData.options.forEach(opt => {
            if (questionTotals[opt.LTV_No] !== undefined) {
                questionTotals[opt.LTV_No] += parseInt(opt.LTVD_Count) || 0;
            }
        });

        const percentages = {};
        htmlData.options.forEach(opt => {
            const qTotal = questionTotals[opt.LTV_No] || 0;
            if (qTotal > 0) {
                percentages[opt.LTVD_No] = ((parseInt(opt.LTVD_Count) / qTotal) * 100).toFixed(1);
            } else {
                percentages[opt.LTVD_No] = '0.0';
            }
        });

        return {
            questionTotals: questionTotals,
            percentages: percentages
        };
    }

    function getResultsHTML(htmlData, calc) {
        let resHtml = '';
        resHtml += '<div class="voting-container vote-s2">';
        
        if (htmlData.survey.LTS_TitleShow != 0) {
            resHtml += '<div class="ltn-votetitle">LTN投票箱<\/div>' + '<h2>' + htmlData.survey.LTS_Title + '<\/h2>';
        } else {
            resHtml += '<div class="ltn-votetitle">LTN投票箱<\/div>';
        }

        if (htmlData.survey.LTS_Content) {
            resHtml += '<div class="vote-desc">' + htmlData.survey.LTS_Content + '<\/div>';
        }

        htmlData.topic.forEach((q, qIndex) => {
            const opts = htmlData.optionsGroup[q.LTV_No] || [];
            const qTotal = calc.questionTotals[q.LTV_No] || 0;
            const questionPrefix = htmlData.topic.length > 1 ? `${qIndex + 1}. ` : '';

            resHtml += '<div class="question-result">';
            resHtml += `<h3 class="vote-title">${questionPrefix}${q.LTV_Subject}<\/h3>`;
            resHtml += '<span class="vote-type">' + (q.LTV_Multi == 1 ? '*複選' : '*單選') + '<\/span>';

            opts.forEach(option => {
                const percent = calc.percentages[option.LTVD_No] || '0.0';
                resHtml += '<div class="op-selectgary option">';
                resHtml += '<label>' + option.LTVD_Content + '<\/label>';
                resHtml += '<span class="vote-count">';
                resHtml += '<span class="vote-percent select-color">' + percent + '%<\/span>';
                resHtml += '<span class="vote-quantity">' + option.LTVD_Count + '票<\/span>';
                resHtml += '<\/span>';
                resHtml += '<span class="vote-bar" style="width: ' + percent + '%;"><\/span>';
                resHtml += '<\/div>';
            });
            //resHtml += '<div style="text-align: right; font-size: 12px; color: #888;">本題共 ' + qTotal + ' 票<\/div>';
            resHtml += '<\/div>';
        });

        let displayDays = htmlData.days;
        if (displayDays >= 0) {
            displayDays = Math.floor(displayDays) + ' 天';
        } else if (displayDays == -1) {
            displayDays = '未開始';
        } else if (displayDays == -2) {
            displayDays = '已截止';
        }

        resHtml += '<!-- 時間與總票數 -->';
        resHtml += '<div class="vote-rules">';
        resHtml += '<span class="vote-time">剩餘時間：' + (displayDays == '已截止' ? "已截止" : displayDays) + '<\/span>';
        resHtml += '<span class="vote-total">總票數：' + htmlData.totalCount + '票 </span>';
        resHtml += '<\/div>';
        
        return resHtml;
    }

    function resViewCheck(isEnd = 0) {
        var inputs = document.querySelectorAll('.voting-container input');
        inputs.forEach(function(input) {
            input.disabled = true;
            input.style.cursor = 'not-allowed';
        });

        var labels = document.querySelectorAll('label');
        labels.forEach(function(label) {
            label.style.cursor = 'not-allowed';
        });

        var voteButtons = document.querySelectorAll('.vote-bt');
        voteButtons.forEach(function(button) {
            button.style.visibility = 'hidden';
        });

        var voteTypes = document.querySelectorAll('.vote-type');
        voteTypes.forEach(function(voteType) {
            if (isEnd == 1) {
                voteType.innerHTML = '投票結束';
            } else {
                voteType.innerHTML = '已投票';
            }
        });

        var style = document.createElement('style');
        style.textContent = `
            label::before {
                display: none !important;
                cursor: not-allowed;
            }
        `;
        document.head.appendChild(style);
    }

    async function getTopicAndOptions(LTS_No) {
        const apiUrl = "https://vote3.ltn.com.tw/surveyDetails/" + LTS_No + "?t=" + Date.now();
        const response = await fetch(apiUrl);
        if (!response.ok) {
            throw new Error(`失敗，狀態碼: ${response.status}`);
        }
        const data = await response.json();
        
        if (data.status === 'error') {
            return null;
        }

        const optionsGroup = {};
        data.options.forEach(opt => {
            if (!optionsGroup[opt.LTV_No]) {
                optionsGroup[opt.LTV_No] = [];
            }
            optionsGroup[opt.LTV_No].push(opt);
        });

        return {
            survey: data.survey,
            topic: data.topic,
            optionsGroup: optionsGroup,
            options: data.options,
            days: data.survey.remain_day,
            totalCount: data.total.total_count
        };
    }
</script>

