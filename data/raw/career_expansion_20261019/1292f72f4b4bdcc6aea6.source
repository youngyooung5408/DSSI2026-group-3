                                                                                                                                                                                                                        <figure>
                                                    <a style="position: relative;" data-fancybox="gallery" data-caption="蔡秉璁市場拜票。翻攝畫面" href="https://static-cdn.nextapple.tw/prod/2026-09/919952C6B271CE6388592EA28B9C5EA0/16226e542651114b76793d189723301c_1280.webp">
