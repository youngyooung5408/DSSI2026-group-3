                                                        data-srcset="https://static-cdn.nextapple.tw/prod/2026-09/919952C6B271CE6388592EA28B9C5EA0/16226e542651114b76793d189723301c_512.webp 512w,https://static-cdn.nextapple.tw/prod/2026-09/919952C6B271CE6388592EA28B9C5EA0/16226e542651114b76793d189723301c_750.webp 750w,https://static-cdn.nextapple.tw/prod/2026-09/919952C6B271CE6388592EA28B9C5EA0/16226e542651114b76793d189723301c_1280.webp 1280w" 
                                                        loading="lazy" 
         
