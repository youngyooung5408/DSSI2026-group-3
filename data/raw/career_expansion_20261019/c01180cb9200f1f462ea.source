                        <div class="iframe fit-iframe">
                            <iframe itemprop="video" itemscope itemtype="http://schema.org/VideoObject" src="https://video.udn.com/play/news/1319861?autoplay=1&muted=1&playsinline=1" frameborder="0" allowfullscreen allow="autoplay; encrypted-media"></iframe>
