                          <script language="javascript">					
					function edm()
					{					
						if(document.EDM.mail.value.length == 0){
							alert("電子郵件欄位不得為空白!")
							return false;
							}
							
						
						date=document.EDM.mail.value.match(/^\S+@\S+\.\S+$/);
						
						  if (!date||!document.EDM.mail.value)
							{
									alert("請填寫正確的電子郵件!")								  
									return false
							}       
							
						
						document.EDM.submit();					
					}
			      </script>
