        var el = document.getElementById('namelist' + i);
        if (el) {
            el.style.display = (i == id) ? '' : 'none';
        }
    }
}

function hide() {
    for (var i = 1; i <= 7; i++) {
        var el = document.getElementById('namelist' + i);
        if (el) el.style.display = 'none';
    }
}

