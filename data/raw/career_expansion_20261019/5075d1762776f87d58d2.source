250">  </amp-ad>  -->    <amp-ad width="336" height="280"    type="doubleclick"    layout="fixed"    data-slot="/129853887/udn.com/2_News/3_News-AMP/4_News-AMP-a06"    data-multi-size="336x280,320x100,320x50,300x250" json='{"targeting":{"cat":["2","\u806f\u5408\u65b0\u805e\u7db2","6638","\u8981\u805e","124652","\u7e23\u5e02\u9577\u8b70\u54e1\u9078\u6230"],"amp":["2","\u806f\u5408\u65b0\u805e\u7db2","6638","\u8981\u805e","124652","\u7e23\u5e02\u9577\u8b70\u54e1\u9078\u6230"],"aid":"9420003","page":"ARTICLE","tag":["\u6c11\u773e\u9ee8","\u65b0\u7af9","\u8b70\u54e1","\u9ad8\u8679\u5b89","\u67ef\u6587\u54f2","\u9ec3\u701e\u7469"]}}'>  </amp-ad>  			</div>  		<main class="main"> 			<h1 class="story-title">白營拚擴基層版圖 新竹市長高虹安幕僚多人參戰議員</h1>  			<section class="story-social"> 				<div class="custom-amp-logo"></div> 				<amp-social-share type="line" class="line-custom" width="80" height="22" data-param-url="https://udn.com/news/story/124652/9420003?from=udnamp_storysns_line"></amp-social-share> 			</section> 			<amp-iframe width="1" title="ddd-tracking" 					height="1" 					sandbox="allow-scripts allow-same-origin" 					frameborder="0" 					src="https://p.udn.com.tw/upf/static/common/etu-er.html?json=%7B%22group%22%3A%22ddd%22%2C%22cid%22%3A%22amp%22%2C%22act%22%3A%22view%22%2C%22cat%22%3A%5B%222%22%2C%22%5Cu806f%5Cu5408%5Cu65b0%5Cu805e%5Cu7db2%22%2C%226638%22%2C%22%5Cu8981%5Cu805e%22%2C%22124652%22%2C%22%5Cu7e23%5Cu5e02%5Cu9577%5Cu8b70%5Cu54e1%5Cu9078%5Cu6230%22%5D%2C%22uid%22%3Anull%2C%22bid%22%3A%22%22%2C%22pid%22%3A9420003%2C%22page%22%3A%22ARTICLE%22%2C%22title%22%3A%22%5Cu767d%5Cu71df%5Cu62da%5Cu64f4%5Cu57fa%5Cu5c64%5Cu7248%5Cu5716+%5Cu65b0%5Cu7af9%5Cu5e02%5Cu9577%5Cu9ad8%5Cu8679%5Cu5b89%5Cu5e55%5Cu50da%5Cu591a%5Cu4eba%5Cu53c3%5Cu6230%5Cu8b70%5Cu54e1%22%2C%22tag%22%3A%5B%22%5Cu6c11%5Cu773e%5Cu9ee8%22%2C%22%5Cu65b0%5Cu7af9%22%2C%22%5Cu8b70%5Cu54e1%22%2C%22%5Cu9ad8%5Cu8679%5Cu5b89%22%2C%22%5Cu67ef%5Cu6587%5Cu54f2%22%2C%22%5Cu9ec3%5Cu701e%5Cu7469%22%5D%2C%22referral%22%3A%22Array%5C%2F%5C%2Famp%5C%2Fstory%5C%2F124652%5C%2F9420003%22%7D" 					class="m1"> 			<div style="width: 1px; height: 1px; background: transparent;" placeholder></div> 			</amp-iframe> 			<section class="story-author"> 				<time>2026-04-03 00:00</time> 				聯合報 記者王駿杰、黃羿馨／新竹報導 			</section>  			<!--marker for gotop observer--> 			<div id="marker"> 				<amp-position-observer 					on="enter:topHide.start; exit:topShow.start" 					layout="nodisplay"> 				</amp-position-observer> 			</div> 			<!--0-->	<figure class="story-image">  		<amp-img 	on="tap:lightbox"  					amp-fx="fade-in"  					role="button"  					tabindex="0"  					src="https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/04/02/34823598.jpg&M=1&s=Y&x=0&y=36&sw=1280&sh=854&exp=3600"  					title="新竹市長高虹安（左一）、民眾黨創黨主席柯文哲（右二）及新竹黨部主委邱臣遠（右一）..."  					layout="responsive"  					width="1280"  					height="854"></amp-img>  		<figcaption>新竹市長高虹安（左一）、民眾黨創黨主席柯文哲（右二）及新竹黨部主委邱臣遠（右一）...</figcaption>  	</figure><p></p><p> </p><p> 新竹市長高虹安隨行秘書李玫日前獲民眾黨提名將參選南區議員，創黨主席柯文哲昨合體助選拉青年票，市府團隊還有民政處長施淑婷、秘書許登淇與農產運銷公司副總經理蔡文盛也預計分別參選西區、東區與北區議員。地方分析白營擴張版圖的企圖心強，但內外皆有挑戰。</p><!--1--><p> </p><p> 李玫二○一八年為時任新竹縣長候選人徐欣瑩幕僚，因外型酷似當時話題人物「學姐」黃瀞瑩，被網友暱稱為「學妹」成為「嬌點」之一。選戰結束後，曾開設計企畫公司，還斜槓從事腹語師，近年加入市府團隊擔任高虹安市長室秘書，近日獲民眾黨提名，將首度投入竹市南區議員選舉。</p>			<div class="ad-center inline-ad"><!--ARTICLE_SECTION 18166-->  				<!-- 2020_AMP_Mobile_文中大佈告 -->  <amp-ad width="336" height="280"    type="doubleclick"    layout="fixed"    data-slot="/129853887/udn.com/2_News/3_News-AMP/4_News-AMP-a01"    data-multi-size="336x280,300x250,1x1"    rtc-config='{ "vendors": { "criteo": {"NETWORK_ID": "4424", "LINE_ITEM_RANGES": "0..30:0.01" },  "prebidappnexuspsp": { "PLACEMENT_ID": "14696101"}}, "timeoutMillis": 700 }' json='{"targeting":{"cat":["2","\u806f\u5408\u65b0\u805e\u7db2","6638","\u8981\u805e","124652","\u7e23\u5e02\u9577\u8b70\u54e1\u9078\u6230"],"amp":["2","\u806f\u5408\u65b0\u805e\u7db2","6638","\u8981\u805e","124652","\u7e23\u5e02\u9577\u8b70\u54e1\u9078\u6230"],"aid":"9420003","page":"ARTICLE","tag":["\u6c11\u773e\u9ee8","\u65b0\u7af9","\u8b70\u54e1","\u9ad8\u8679\u5b89","\u67ef\u6587\u54f2","\u9ec3\u701e\u7469"]}}'  >  </amp-ad>  			</div><p> </p><p> 柯文哲、高虹安與新竹黨部主委邱臣遠昨合體，替李玫拉抬聲勢。高虹安說，李玫具極高的執行力與溝通能量，是她最信任的左右手，南區選民絕對可以信任。李玫也盼將行政效率帶進南區服務。</p><!--3--><p> </p><p> 除了李玫外，高虹安幕僚團隊的民政處長施淑婷傳出將再戰西區議員，市長室秘書許登淇原本布局南區，後續在藍白合作架構下，將轉戰競爭更激烈的東區，企圖擴大民眾黨整體席次。蔡文盛與新竹市家長會長協會理事長葉國文分別是本屆北區、香山區「落選頭」，年底都將再度投入戰局。</p><!--4--><p> </p><p> 地方人士觀察，高虹安此次議員布局，呈現三大策略，包括「府內轉戰」，由熟悉市政的幕僚與官員直接參選，強調執行力與治理經驗；二是「延續經營」，讓曾參選或深耕地方者再戰，鞏固基本盤；三是「區域調整」，透過藍白合作與選區配置，避免票源內耗。</p><!--5--><p> </p><p> 但地方人士也直言，布局雖有利建立戰力，但各選區面臨藍綠與無黨籍議員經營深厚、甚或白營內部競爭等狀況，新人若無法快速建立在地服務網絡，挑戰不小。</p><!--6--><!--99--> 			  			<!--author --> 			 			<!--popin ads--> 			 			<!--tags--> 				<section class="story-tags">				  		  		<a href="/search/tagging/2/民眾黨" target="_blank"> 民眾黨 </a>				  		  		<a href="/search/tagging/2/新竹" target="_blank"> 新竹 </a>				  		  		<a href="/search/tagging/2/議員" target="_blank"> 議員 </a>				  		  		<a href="/search/tagging/2/高虹安" target="_blank"> 高虹安 </a>				  		  		<a href="/search/tagging/2/柯文哲" target="_blank"> 柯文哲 </a>				  		  		<a href="/search/tagging/2/黃瀞瑩" target="_blank"> 黃瀞瑩 </a>				  		  	</section>  	<!-- #location /template/amp/component/tags --> 						<div class="ad-center ad-text"><!--ARTICLE_BOTTOM_TXT 11813-->  				<amp-ad layout="fluid" height="fluid"      type="doubleclick"      data-slot="/129853887/ca-pub-8667544662396227-tag/AMP_Display/AdExchange-Mobile_txtdown"      data-multi-size="350x90" json='{"targeting":{"cat":["2","\u806f\u5408\u65b0\u805e\u7db2","6638","\u8981\u805e","124652","\u7e23\u5e02\u9577\u8b70\u54e1\u9078\u6230"],"amp":["2","\u806f\u5408\u65b0\u805e\u7db2","6638","\u8981\u805e","124652","\u7e23\u5e02\u9577\u8b70\u54e1\u9078\u6230"],"aid":"9420003","page":"ARTICLE","tag":["\u6c11\u773e\u9ee8","\u65b0\u7af9","\u8b70\u54e1","\u9ad8\u8679\u5b89","\u67ef\u6587\u54f2","\u9ec3\u701e\u7469"]}}'>  </amp-ad>  <!--20200212改為AdExchange的AMP代碼-->  			<