/* Start custom CSS for icon-list, class: .elementor-element-e01b66b */.elementor-129082 .elementor-element.elementor-element-e01b66b li{
    display: flex;
    flex-direction: column;
}/* End custom CSS */

/* Start custom CSS for button, class: .elementor-element-945b9fb */.elementor-129082 .elementor-element.elementor-element-945b9fb a:hover{
    border-color: #B900001A;
}/* End custom CSS */




/* Start custom CSS for dce-rawphp, class: .elementor-element-9d202de */.elementor-129082 .elementor-element.elementor-element-9d202de ul.first-level-menu{
    display: flex;
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    margin: 6px 0 0 -10px;
    padding: 0;
    overflow-x: scroll;
    overflow-y: hidden;
    -ms-overflow-style: none;
    scrollbar-width: none;
}
@media (max-width: 767px){
    .elementor-129082 .elementor-element.elementor-element-9d202de ul.first-level-menu{
        margin: 0px;
    }
    .elementor-129082 .elementor-element.elementor-element-9d202de li.last-li{
        display:none;
    }
}
.elementor-129082 .elementor-element.elementor-element-9d202de ul.first-level-menu::-webkit-scrollbar{
    display: none;
}
.elementor-129082 .elementor-element.elementor-element-9d202de ul.first-level-menu li{
    list-style-type:none;
}
.elementor-129082 .elementor-element.elementor-element-9d202de ul.first-level-menu li a{
    width: max-content;
    display: inline-block;
    color: white;
    font-size: 14px;
    letter-spacing: 1.2px;
    font-weight: bold;
    padding: 8px 12px 12px 12px;
}
.elementor-129082 .elementor-element.elementor-element-9d202de ul.first-level-menu li a:hover{
    background-color: white;
    color: var(--e-global-color-6f7ae9c );
    border-radius: 4px 4px 0px 0px;
}
.elementor-129082 .elementor-element.elementor-element-9d202de ul.first-level-menu li.last-li #menu-icon-3-dot{
    width: 24px;
}
.elementor-129082 .elementor-element.elementor-element-9d202de ul.first-level-menu li.last-li #menu-icon-3-dot path{
    fill:white;
}

.elementor-129082 .elementor-element.elementor-element-9d202de ul.first-level-menu li.last-li a:hover{
    padding: 8px 10px 10px 10px;
    border-bottom: 2px solid white;
}
.elementor-129082 .elementor-element.elementor-element-9d202de ul.first-level-menu li.last-li.hovered a{
    background-color: white;
    color: var(--e-global-color-6f7ae9c );
    border-radius: 4px 4px 0px 0px;
    padding: 8px 10px 10px 10px;
    border-bottom: 2px solid white;
}

.elementor-129082 .elementor-element.elementor-element-9d202de ul.first-level-menu li.last-li a:hover  #menu-icon-3-dot path{
    fill: var( --e-global-color-6f7ae9c );
}
.elementor-129082 .elementor-element.elementor-element-9d202de ul.first-level-menu li.last-li.hovered a #menu-icon-3-dot path{
    fill: var( --e-global-color-6f7ae9c );
}

.elementor-129082 .elementor-element.elementor-element-9d202de .trigger-area{
    display: inline-block;
    padding: 10px;
}


.elementor-129082 .elementor-element.elementor-element-9d202de ul.second-level-menu{
    position: absolute;
    display: none;
    z-index: 2;
    /*top: 50px;*/
    background-color: white;
    margin: 0px;
    padding: 1px;
    flex-wrap: wrap;
    width: 165px;
    border-radius: 0px 0px 4px 4px;
    box-shadow:0px 2px 5px 2px #00000042;
}

.elementor-129082 .elementor-element.elementor-element-9d202de ul.second-level-menu li a{
    color: #1e2428;
}
.elementor-129082 .elementor-element.elementor-element-9d202de ul.second-level-menu li a:hover{
    padding: 10px;
    margin: 0px;
    border: none;
    text-decoration: underline;
}

.elementor-129082 .elementor-element.elementor-element-9d202de ul.second-level-menu-SHOW{
    display: flex;
}/* End custom CSS */





