</style><script type="text/javascript">
document.addEventListener('DOMContentLoaded', function() {
    // 包裹所有程式碼以避免全域作用域污染
    (function() {
        // 時間轉換為相對時間的函數
        function timeAgo(time, originalTimeString) {
            const now = new Date();
            const postDate = new Date(time);
            const diffInSeconds = Math.floor((now - postDate) / 1000);
            const seconds = diffInSeconds;
            const minutes = Math.floor(seconds / 60);
            const hours = Math.floor(minutes / 60);
            const days = Math.floor(hours / 24);
            if (days > 0) {
                // 如果超過 24 小時，返回原始字符串
                return originalTimeString;
            } else if (hours > 0) {
                return hours + ' 小時前';
            } else if (minutes > 0) {
                return minutes + ' 分鐘前';
            } else {
                return seconds + ' 秒前';
            }
        }
        // 更新所有 <time> 元素
        function updateTimes() {
            try {
                document.querySelectorAll('time.post-time').forEach(function (element) {
                    const time = element.getAttribute('datetime');
                    const originalTimeString = element.textContent;
                    const humanReadableTime = timeAgo(time, originalTimeString);
                    element.textContent = humanReadableTime;
                    element.setAttribute('title', originalTimeString);
                });
            } catch (error) {
                console.error("更新時間時發生錯誤:", error);
            }
        }
        // 初始更新時間
        updateTimes();
        // 每 60 秒更新一次時間
        setInterval(updateTimes, 60000);
    })();
});</script><link rel="icon" href="https://taipeipost.org/wp-content/uploads/2021/02/favicon-s-75x75.jpg" sizes="32x32" />
