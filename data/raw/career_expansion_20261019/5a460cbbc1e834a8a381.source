        id="seenewsIdlePreferredOverlay"
        class="seenews-idle-overlay"
        aria-hidden="true"
    >

        <div
            class="seenews-idle-modal"
            role="dialog"
            aria-modal="true"
            aria-labelledby="seenewsIdlePreferredTitle"
        >

            <!-- 關閉 -->
            <button
                type="button"
                id="seenewsIdlePreferredClose"
                class="seenews-idle-close"
                aria-label="關閉"
            >
                ×
            </button>


            <!-- Google Logo -->
            <div data-rocket-location-hash="aef1e97caf775ba211fd9fb8ee700d5b" class="seenews-idle-google-logo">

                <img
                    src="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2040%2040'%3E%3C/svg%3E"
                    alt="Google"
                    width="40"
                    height="40"
                data-lazy-src="https://www.gstatic.com/images/branding/product/1x/googleg_48dp.png" ><noscript><img
                    src="https://www.gstatic.com/images/branding/product/1x/googleg_48dp.png"
                    alt="Google"
                    width="40"
                    height="40"
                ></noscript>

            </div>


            <!-- 標題 -->
            <h2
                id="seenewsIdlePreferredTitle"
                class="seenews-idle-title"
            >
                在 Google 優先看到台新傳媒
            </h2>


            <!-- 說明 -->
            <p class="seenews-idle-description">
                將「台新傳媒」設為 Google 偏好來源，
                搜尋新聞時更容易看到我們的最新新聞與重要報導。
            </p>


            <!-- CTA -->
            <button
                type="button"
                id="seenewsIdlePreferredButton"
                class="seenews-idle-primary"
            >
                設為 Google 偏好來源

                <span class="seenews-idle-arrow">
                    →
                </span>
            </button>


            <!-- 稍後再說 -->
            <button
                type="button"
                id="seenewsIdlePreferredLater"
                class="seenews-idle-later"
            >
                稍後再說
            </button>

        </div>

    </div>

    
    <script type="text/rocketlazyloadscript">

    document.addEventListener(
        "DOMContentLoaded",
        function() {

            /* =========================================
             * 基本設定
             * ========================================= */

            const MIN_PAGE_TIME = 30000;
            // 進入文章至少 30 秒

            const IDLE_TIME = 15000;
            // 之後連續 15 秒沒有操作

            const DAILY_MAX = 3;
            // 每天最多顯示 3 次

            const STORAGE_KEY =
                "seenews_preferred_modal_daily";


            /* =========================================
             * DOM
             * ========================================= */

            const overlay =
                document.getElementById(
                    "seenewsIdlePreferredOverlay"
                );

            const closeButton =
                document.getElementById(
                    "seenewsIdlePreferredClose"
                );

            const laterButton =
                document.getElementById(
                    "seenewsIdlePreferredLater"
                );

            const preferredButton =
                document.getElementById(
                    "seenewsIdlePreferredButton"
                );


            if (
                !overlay ||
                !closeButton ||
                !laterButton ||
                !preferredButton
            ) {
                return;
            }


            /* =========================================
             * 今天日期
             * ========================================= */

            function getToday() {

                const now = new Date();

                return [
                    now.getFullYear(),
                    String(
                        now.getMonth() + 1
                    ).padStart(2, "0"),
                    String(
                        now.getDate()
                    ).padStart(2, "0")
                ].join("-");

            }


            /* =========================================
             * 取得今天已顯示次數
             * ========================================= */

            function getDailyData() {

                const defaultData = {
                    date: getToday(),
                    count: 0
                };

                try {

                    const saved =
                        localStorage.getItem(
                            STORAGE_KEY
                        );

                    if (!saved) {

                        return defaultData;

                    }


                    const data =
                        JSON.parse(saved);


                    /*
                     * 日期不同
                     * 代表已經隔天
                     * 自動歸零
                     */

                    if (
                        data.date !== getToday()
                    ) {

                        return defaultData;

                    }


                    return {

                        date: getToday(),

                        count:
                            Number(data.count) || 0

                    };

                } catch (e) {

                    return defaultData;

                }

            }


            /* =========================================
             * 儲存次數
             * ========================================= */

            function saveDailyData(data) {

                try {

                    localStorage.setItem(

                        STORAGE_KEY,

                        JSON.stringify(data)

                    );

                } catch (e) {}

            }


            /* =========================================
             * 檢查今天是否已達 3 次
             * ========================================= */

            let dailyData =
                getDailyData();


            if (
                dailyData.count >= DAILY_MAX
            ) {

                return;

            }


            /* =========================================
             * Page View 狀態
             * ========================================= */

            let pageEligible = false;

            let modalShownThisPage = false;

            let idleTimer = null;


            /* =========================================
             * 顯示 Modal
             * ========================================= */

            function showModal() {

                /*
                 * 還沒滿 30 秒
                 */

                if (!pageEligible) {
                    return;
                }


                /*
                 * 同一 Page View 已經顯示過
                 */

                if (modalShownThisPage) {
                    return;
                }


                /*
                 * 再讀一次 localStorage
                 * 避免多分頁造成次數錯誤
                 */

                dailyData =
                    getDailyData();


                /*
                 * 今天已達 3 次
                 */

                if (
                    dailyData.count >= DAILY_MAX
                ) {
                    return;
                }


                /*
                 * 標記：
                 * 這個 Page View 已顯示
                 */

                modalShownThisPage = true;


                /*
                 * 顯示次數 +1
                 */

                dailyData.count += 1;

                saveDailyData(
                    dailyData
                );


                /*
                 * 顯示 Modal
                 */

                overlay.classList.add(
                    "is-visible"
                );

                overlay.setAttribute(
                    "aria-hidden",
                    "false"
                );

                document.body.style.overflow =
                    "hidden";

            }


            /* =========================================
             * 關閉 Modal
             * ========================================= */

            function closeModal() {

                overlay.classList.remove(
                    "is-visible"
                );

                overlay.setAttribute(
                    "aria-hidden",
                    "true"
                );

                document.body.style.overflow =
                    "";

            }


            /* =========================================
             * Idle Timer
             * ========================================= */

            function resetIdleTimer() {

                /*
                 * 前 30 秒不偵測
                 */

                if (!pageEligible) {
                    return;
                }


                /*
                 * 本頁已經顯示過
                 * 就不再啟動 Timer
                 */

                if (modalShownThisPage) {
                    return;
                }


                clearTimeout(
                    idleTimer
                );


                idleTimer =
                    setTimeout(

                        showModal,

                        IDLE_TIME

                    );

            }


            /* =========================================
             * 使用者活動事件
             * ========================================= */

            const activityEvents = [

                "mousemove",

                "mousedown",

                "keydown",

                "scroll",

                "touchstart",

                "touchmove",

                "pointerdown"

            ];


            activityEvents.forEach(

                function(eventName) {

                    window.addEventListener(

                        eventName,

                        resetIdleTimer,

                        {
                            passive: true
                        }

                    );

                }

            );


            /* =========================================
             * 30 秒後開始偵測 Idle
             * ========================================= */

            setTimeout(

                function() {

                    /*
                     * 再確認一次今天是否已達上限
                     */

                    dailyData =
                        getDailyData();


                    if (
                        dailyData.count >=
                        DAILY_MAX
                    ) {

                        return;

                    }


                    pageEligible = true;


                    /*
                     * 從這一刻開始計算
                     * 15 秒無操作
                     */

                    resetIdleTimer();

                },

                MIN_PAGE_TIME

            );


            /* =========================================
             * X 關閉
             * ========================================= */

            closeButton.addEventListener(

                "click",

                closeModal

            );


            /* =========================================
             * 稍後再說
             * ========================================= */

            laterButton.addEventListener(

                "click",

                closeModal

            );


            /* =========================================
             * 點背景關閉
             * ========================================= */

            overlay.addEventListener(

                "click",

                function(event) {

                    if (
                        event.target === overlay
                    ) {

                        closeModal();

                    }

                }

            );


            /* =========================================
             * ESC 關閉
             * ========================================= */

            document.addEventListener(

                "keydown",

                function(event) {

                    if (
                        event.key === "Escape" &&
                        overlay.classList.contains(
                            "is-visible"
                        )
                    ) {

                        closeModal();

                    }

                }

            );


            /* =========================================
             * Google Preferred Sources
             * ========================================= */

            (
                self.PREFERRED_SOURCE =
                self.PREFERRED_SOURCE || []
            ).push(

                function(preferredSource) {

                    preferredSource.init({

                        theme: "light",

                        lang: "zh-TW"

                    });


                    preferredButton
                        .addEventListener(

                            "click",

                            function() {

                                /*
                                 * 先關閉自己的 Modal
                                 */

                                closeModal();


                                /*
                                 * 開啟 Google 官方
                                 * Preferred Source UI
                                 */

                                preferredSource
                                    .addPreferredSource();

                            }

                        );

                }

            );

        }

    );

    </script>

    
    <script type="text/rocketlazyloadscript">

    (
        self.PREFERRED_SOURCE =
        self.PREFERRED_SOURCE || []
    ).push(

        function(preferredSource) {

            preferredSource.init({

                theme: "light",

                lang: "zh-TW"

            });


            const button =
                document.getElementById(
                    "seenewsPreferredSourceButton"
                );


            if (!button) {
                return;
            }


            button.addEventListener(

                "click",

                function() {

                    preferredSource
                        .addPreferredSource();

                }

            );

        }

    );

    </script>

    
    <script type="text/rocketlazyloadscript" id="seenews-preferred-ga4-v3">
    (function () {

        "use strict";

        /* 避免同一頁重複安裝 */
        if (window.seenewsPreferredGA4V3Installed) {
            return;
        }

        window.seenewsPreferredGA4V3Installed = true;


        /* ========================================
           基本設定
           ======================================== */

        var placements = [

            {
                location: "homepage",
                container: "#seenews-preferred-home",
                button: "#seenewsHomePreferredButton"
            },

            {
                location: "article",
                container: ".seenews-preferred-card",
                button: "#seenewsPreferredSourceButton"
            },

            {
                location: "idle_popup",
                container: "#seenewsIdlePreferredOverlay",
                button: "#seenewsIdlePreferredButton"
            }

        ];

        var trackedViews = new WeakSet();

        var trackedPopups = new WeakSet();

        var popupStates = new WeakMap();

        var pendingEvents = [];

        var analyticsRetryTimer = null;

        var analyticsRetryCount = 0;

        var analyticsMaxRetries = 20;

        var analyticsRetryInterval = 500;

        var scanTimer = null;


        /* ========================================
           判斷 GA4 / GTM 是否可用
           ======================================== */

        function getAnalyticsMethod() {

            if (typeof window.gtag === "function") {
                return "gtag";
            }

            if (Array.isArray(window.dataLayer)) {
                return "dataLayer";
            }

            return null;

        }


        /* ========================================
           實際傳送事件
           ======================================== */

        function dispatchEvent(item) {

            var method = getAnalyticsMethod();

            if (!method) {
                return false;
            }

            var parameters = {

                source_location: item.location,

                publisher: "seenews",

                page_path: window.location.pathname

            };

            try {

                if (method === "gtag") {

                    window.gtag(
                        "event",
                        item.name,
                        parameters
                    );

                } else {

                    window.dataLayer.push(

                        Object.assign(

                            {
                                event: item.name
                            },

                            parameters

                        )

                    );

                }

                return true;

            } catch (error) {

                console.error(
                    "[seenews GA4] Event dispatch failed:",
                    item.name,
                    error
                );

                return false;

            }

        }


        /* ========================================
           傳送等待佇列
           ======================================== */

        function flushPendingEvents() {

            if (!pendingEvents.length) {

                stopAnalyticsRetry();

                return;

            }

            if (!getAnalyticsMethod()) {
                return;
            }

            var remaining = [];

            pendingEvents.forEach(function (item) {

                if (!dispatchEvent(item)) {
                    remaining.push(item);
                }

            });

            pendingEvents = remaining;

            if (!pendingEvents.length) {
                stopAnalyticsRetry();
            }

        }


        function stopAnalyticsRetry() {

            if (analyticsRetryTimer !== null) {

                clearInterval(analyticsRetryTimer);

                analyticsRetryTimer = null;

            }

            analyticsRetryCount = 0;

        }


        function startAnalyticsRetry() {

            if (analyticsRetryTimer !== null) {
                return;
            }

            analyticsRetryCount = 0;

            analyticsRetryTimer = setInterval(function () {

                analyticsRetryCount++;

                flushPendingEvents();

                if (!pendingEvents.length) {
                    return;
                }

                if (
                    analyticsRetryCount >=
                    analyticsMaxRetries
                ) {

                    stopAnalyticsRetry();

                    console.warn(
                        "[seenews GA4] Analytics unavailable; " +
                        "events could not be dispatched:",
                        pendingEvents
                    );

                    pendingEvents = [];

                }

            }, analyticsRetryInterval);

        }


        /* ========================================
           統一事件入口
           ======================================== */

        function sendEvent(eventName, location) {

            var item = {

                name: eventName,

                location: location

            };

            /*
             * 已有 gtag / dataLayer：
             * 直接送出。
             */

            if (dispatchEvent(item)) {

                /*
                 * 若之前有等待中的事件，
                 * 一併補送。
                 */

                flushPendingEvents();

                return;

            }

            /*
             * GA4 / GTM 尚未建立：
             * 最多等待約 10 秒。
             */

            pendingEvents.push(item);

            startAnalyticsRetry();

        }


        /* ========================================
           點擊追蹤：事件委派
           ======================================== */

        function handlePreferredClick(event) {

            var target = event.target;

            if (!target || !target.closest) {
                return;
            }

            placements.forEach(function (placement) {

                var button = target.closest(
                    placement.button
                );

                if (!button) {
                    return;
                }

                /*
                 * 不記錄 disabled 按鈕。
                 * 不阻止原本 click。
                 * 不呼叫 Google SDK。
                 */

                if (button.disabled) {
                    return;
                }

                sendEvent(
                    "preferred_source_click",
                    placement.location
                );

            });

        }


        /* ========================================
           首頁 / 文章 CTA 曝光
           ======================================== */

        function observeView(container, location) {

            if (!container) {
                return;
            }

            if (trackedViews.has(container)) {
                return;
            }

            trackedViews.add(container);

            if (!("IntersectionObserver" in window)) {

                /*
                 * 不支援 IntersectionObserver 時，
                 * 不假裝已經發生曝光。
                 */

                return;

            }

            var observer = new IntersectionObserver(

                function (entries) {

                    entries.forEach(function (entry) {

                        if (

                            entry.isIntersecting &&

                            entry.intersectionRatio >= 0.5

                        ) {

                            sendEvent(
                                "preferred_source_view",
                                location
                            );

                            observer.unobserve(
                                entry.target
                            );

                            observer.disconnect();

                        }

                    });

                },

                {
                    threshold: [0.5]
                }

            );

            observer.observe(container);

        }


        /* ========================================
           閒置彈窗開啟 / 關閉
           ======================================== */

        function watchPopup(overlay) {

            if (!overlay) {
                return;
            }

            if (trackedPopups.has(overlay)) {
                return;
            }

            trackedPopups.add(overlay);

            var initialVisible =
                overlay.classList.contains(
                    "is-visible"
                );

            popupStates.set(
                overlay,
                initialVisible
            );

            /*
             * 若追蹤程式啟動時彈窗已開啟，
             * 記錄當下可見狀態。
             */

            if (initialVisible) {

                sendEvent(
                    "preferred_source_popup_open",
                    "idle_popup"
                );

                sendEvent(
                    "preferred_source_view",
                    "idle_popup"
                );

            }

            var observer = new MutationObserver(function () {

                var isVisible =
                    overlay.classList.contains(
                        "is-visible"
                    );

                var wasVisible =
                    popupStates.get(overlay);

                if (isVisible === wasVisible) {
                    return;
                }

                popupStates.set(
                    overlay,
                    isVisible
                );

                if (isVisible) {

                    sendEvent(
                        "preferred_source_popup_open",
                        "idle_popup"
                    );

                    sendEvent(
                        "preferred_source_view",
                        "idle_popup"
                    );

                } else {

                    sendEvent(
                        "preferred_source_popup_close",
                        "idle_popup"
                    );

                }

            });

            observer.observe(

                overlay,

                {
                    attributes: true,
                    attributeFilter: ["class"]
                }

            );

        }


        /* ========================================
           掃描 CTA
           ======================================== */

        function scan() {

            placements.forEach(function (placement) {

                var containers =
                    document.querySelectorAll(
                        placement.container
                    );

                containers.forEach(function (container) {

                    if (
                        placement.location ===
                        "idle_popup"
                    ) {

                        watchPopup(container);

                    } else {

                        observeView(
                            container,
                            placement.location
                        );

                    }

                });

            });

        }


        /* ========================================
           初始化
           ======================================== */

        function initialize() {

            /*
             * 使用事件委派：
             * 動態新增的按鈕也能記錄點擊。
             *
             * 只安裝一次，不會因為掃描而重複綁定。
             */

            document.addEventListener(

                "click",

                handlePreferredClick,

                true

            );

            scan();

            /*
             * 支援 WPBakery 或其他程式
             * 動態插入 CTA / 彈窗。
             */

            var pageObserver = new MutationObserver(
                function () {

                    if (scanTimer !== null) {
                        return;
                    }

                    scanTimer = setTimeout(function () {

                        scanTimer = null;

                        scan();

                    }, 100);

                }
            );

            pageObserver.observe(

                document.body,

                {
                    childList: true,
                    subtree: true
                }

            );

        }


        if (document.readyState === "loading") {

            document.addEventListener(

                "DOMContentLoaded",

                initialize,

                {
                    once: true
                }

            );

        } else {

            initialize();

        }

    })();
    </script>

