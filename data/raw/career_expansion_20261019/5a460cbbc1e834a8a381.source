    <script type="text/rocketlazyloadscript" data-minify="1"
        async
        preferred-sources-control="manual"
        data-rocket-src="https://seenews.tw/wp-content/cache/min/1/swg/js/v1/publisher.js?ver=1791865498">
    </script>
    
    <style>

    /* Overlay */

    .seenews-idle-overlay {

        position: fixed;

        inset: 0;

        z-index: 999999;

        display: flex;

        align-items: center;

        justify-content: center;

        padding: 20px;

        box-sizing: border-box;

        background: rgba(20, 24, 31, 0.58);

        backdrop-filter: blur(2px);

        -webkit-backdrop-filter: blur(2px);

        opacity: 0;

        visibility: hidden;

        pointer-events: none;

        transition:
            opacity .22s ease,
            visibility .22s ease;
    }


    .seenews-idle-overlay.is-visible {

        opacity: 1;

        visibility: visible;

        pointer-events: auto;
    }


    /* Modal */

    .seenews-idle-modal {

        position: relative;

        width: 100%;

        max-width: 430px;

        box-sizing: border-box;

        padding: 42px 38px 30px;

        background:
            linear-gradient(
                180deg,
                #ffffff 0%,
                #f9fbff 100%
            );

        border:
            1px solid
            rgba(218, 220, 224, .9);

        border-radius: 20px;

        box-shadow:
            0 24px 70px
            rgba(0, 0, 0, .22);

        text-align: center;

        transform:
            translateY(15px)
            scale(.98);

        transition:
            transform .22s ease;
    }


    .seenews-idle-overlay.is-visible
    .seenews-idle-modal {

        transform:
            translateY(0)
            scale(1);
    }


    /* Google 四色線 */

    .seenews-idle-modal::before {

        content: "";

        position: absolute;

        top: 0;

        left: 20px;

        right: 20px;

        height: 3px;

        border-radius:
            0 0 3px 3px;

        background:
            linear-gradient(
                90deg,
                #4285f4 0%,
                #4285f4 25%,
                #ea4335 25%,
                #ea4335 50%,
                #fbbc05 50%,
                #fbbc05 75%,
                #34a853 75%,
                #34a853 100%
            );
    }


    /* Close */

    .seenews-idle-close {

        position: absolute;

        top: 13px;

        right: 14px;

        width: 34px;

        height: 34px;

        display: flex;

        align-items: center;

        justify-content: center;

        padding: 0;

        background: transparent;

        color: #5f6368;

        border: 0;

        border-radius: 50%;

        font-size: 25px;

        font-weight: 300;

        line-height: 1;

        cursor: pointer;

        transition:
            background .15s ease,
            color .15s ease;
    }


    .seenews-idle-close:hover {

        background: #f1f3f4;

        color: #202124;
    }


    /* Google Logo */

    .seenews-idle-google-logo {

        width: 66px;

        height: 66px;

        margin: 0 auto 20px;

        display: flex;

        align-items: center;

        justify-content: center;

        background: #ffffff;

        border: 1px solid #e3e7ed;

        border-radius: 50%;

        box-shadow:
            0 4px 14px
            rgba(60, 64, 67, .10);
    }


    .seenews-idle-google-logo img {

        display: block;

        width: 38px;

        height: 38px;

        object-fit: contain;
    }


    /* Title */

    .seenews-idle-title {

        margin: 0 0 12px;

        padding: 0;

        color: #202124;

        font-size: 24px;

        font-weight: 700;

        line-height: 1.4;
    }


    /* Description */

    .seenews-idle-description {

        max-width: 340px;

        margin: 0 auto 25px;

        padding: 0;

        color: #5f6368;

        font-size: 15px;

        font-weight: 400;

        line-height: 1.75;
    }


    /* Primary Button */

    .seenews-idle-primary {

        width: 100%;

        min-height: 50px;

        display: flex;

        align-items: center;

        justify-content: center;

        gap: 8px;

        padding: 13px 20px;

        background: #1a73e8;

        color: #ffffff;

        border: 1px solid #1a73e8;

        border-radius: 26px;

        font-family: inherit;

        font-size: 15px;

        font-weight: 600;

        cursor: pointer;

        box-shadow:
            0 4px 12px
            rgba(26, 115, 232, .20);

        transition:
            background .18s ease,
            box-shadow .18s ease,
            transform .08s ease;
    }


    .seenews-idle-primary:hover {

        background: #1765cc;

        border-color: #1765cc;

        box-shadow:
            0 6px 16px
            rgba(26, 115, 232, .27);

        transform: translateY(-1px);
    }


    .seenews-idle-primary:active {

        transform: translateY(0);
    }


    .seenews-idle-arrow {

        font-size: 18px;

        font-weight: 400;

        line-height: 1;
    }


    /* Later */

    .seenews-idle-later {

        margin-top: 15px;

        padding: 7px 14px;

        background: transparent;

        color: #777;

        border: 0;

        font-family: inherit;

        font-size: 13px;

        cursor: pointer;
    }


    .seenews-idle-later:hover {

        color: #202124;

        text-decoration: underline;
    }


    /* Mobile */

    @media (max-width: 640px) {

        .seenews-idle-overlay {

            padding: 18px;
        }


        .seenews-idle-modal {

            max-width: 380px;

            padding: 38px 24px 25px;

            border-radius: 18px;
        }


        .seenews-idle-google-logo {

            width: 58px;

            height: 58px;

            margin-bottom: 17px;
        }


        .seenews-idle-google-logo img {

            width: 34px;

            height: 34px;
        }


        .seenews-idle-title {

            font-size: 21px;
        }


        .seenews-idle-description {

            margin-bottom: 22px;

            font-size: 14px;

            line-height: 1.7;
        }


        .seenews-idle-primary {

            min-height: 50px;

            font-size: 15px;
        }

    }

    </style>

    
    <script type="text/rocketlazyloadscript" data-minify="1"
        async
        preferred-sources-control="manual"
        data-rocket-src="https://seenews.tw/wp-content/cache/min/1/swg/js/v1/publisher.js?ver=1791865498">
    </script>
    
    <style>

    /* =========================
       Main Card
       ========================= */

    .seenews-preferred-card {

        position: relative;

        display: flex;

        align-items: center;

        gap: 22px;

        width: 100%;

        box-sizing: border-box;

        margin: 36px 0 28px;

        padding: 26px 28px;

        background:
            linear-gradient(
                135deg,
                #ffffff 0%,
                #f8fbff 100%
            );

        border: 1px solid #dfe7f3;

        border-radius: 16px;

        box-shadow:
            0 4px 18px
            rgba(32, 33, 36, 0.05);

        overflow: hidden;
    }


    /* 上方細線 */

    .seenews-preferred-card::before {

        content: "";

        position: absolute;

        top: 0;

        left: 0;

        width: 100%;

        height: 3px;

        background:
            linear-gradient(
                90deg,
                #4285f4,
                #1a73e8,
                #34a853
            );
    }


    /* =========================
       Google Logo
       ========================= */

    .seenews-preferred-icon {

        flex-shrink: 0;

        width: 52px;

        height: 52px;

        display: flex;

        align-items: center;

        justify-content: center;

        background: #ffffff;

        border: 1px solid #e1e6ef;

        border-radius: 50%;

        box-shadow:
            0 2px 8px
            rgba(60, 64, 67, 0.08);
    }


    .seenews-preferred-icon img {

        display: block;

        width: 30px;

        height: 30px;

        object-fit: contain;
    }


    /* =========================
       Content
       ========================= */

    .seenews-preferred-body {

        flex: 1;

        min-width: 0;
    }


    .seenews-preferred-title {

        margin-bottom: 7px;

        color: #202124;

        font-size: 19px;

        font-weight: 700;

        line-height: 1.45;
    }


    .seenews-preferred-description {

        max-width: 520px;

        color: #5f6368;

        font-size: 14px;

        font-weight: 400;

        line-height: 1.65;
    }


    /* =========================
       Button
       ========================= */

    .seenews-preferred-action {

        flex-shrink: 0;
    }


    .seenews-preferred-button {

        display: inline-flex;

        align-items: center;

        justify-content: center;

        gap: 8px;

        min-height: 44px;

        padding: 11px 20px;

        background: #1a73e8;

        color: #ffffff;

        border: 1px solid #1a73e8;

        border-radius: 24px;

        font-family: inherit;

        font-size: 14px;

        font-weight: 600;

        line-height: 1.4;

        cursor: pointer;

        box-shadow:
            0 2px 6px
            rgba(26, 115, 232, 0.18);

        transition:
            background-color .18s ease,
            box-shadow .18s ease,
            transform .08s ease;
    }


    .seenews-preferred-button:hover {

        background: #1765cc;

        border-color: #1765cc;

        box-shadow:
            0 4px 12px
            rgba(26, 115, 232, 0.24);

        transform:
            translateY(-1px);
    }


    .seenews-preferred-button:active {

        transform: translateY(0);

        box-shadow:
            0 1px 4px
            rgba(26, 115, 232, 0.18);
    }


    .seenews-preferred-arrow {

        margin-left: 2px;

        font-size: 17px;

        font-weight: 400;

        line-height: 1;
    }


    /* =========================
       Tablet
       ========================= */

    @media (max-width: 900px) {

        .seenews-preferred-card {

            align-items: flex-start;

            flex-wrap: wrap;

            gap: 16px;

            padding: 24px;
        }


        .seenews-preferred-body {

            flex:
                1 1 calc(100% - 75px);
        }


        .seenews-preferred-action {

            width: 100%;

            padding-left: 74px;
        }
    }


    /* =========================
       Mobile
       ========================= */

    @media (max-width: 640px) {

        .seenews-preferred-card {

            display: block;

            margin: 30px 0 24px;

            padding: 24px 20px 20px;

            border-radius: 14px;
        }


        .seenews-preferred-icon {

            width: 44px;

            height: 44px;

            margin-bottom: 15px;
        }


        .seenews-preferred-icon img {

            width: 27px;

            height: 27px;
        }


        .seenews-preferred-title {

            margin-bottom: 8px;

            font-size: 18px;

            line-height: 1.45;
        }


        .seenews-preferred-description {

            margin-bottom: 18px;

            font-size: 14px;

            line-height: 1.65;
        }


        .seenews-preferred-action {

            width: 100%;

            padding-left: 0;
        }


        .seenews-preferred-button {

            width: 100%;

            min-height: 48px;

            padding: 12px 16px;

            border-radius: 25px;

            font-size: 14px;
        }
    }

    </style>

