        <script>
            var shareText = "網紅鄭方形參選！重提舊案再控蓋牌　教育局硬起來：7罪起訴絕不寬貸%0Ahttps://www.knews.com.tw/news/543CFFD5914E014110B1A8C36038C748%0A%0A下載【知新聞APP】看獨家影音熱搜話題%0Ahttps://event.knews.com.tw/app";
            var userAgent = navigator.userAgent || navigator.vendor || window.opera;
            var shareHref = '';

            if (/iPhone|iPad|iPod/.test(userAgent)) {
                shareHref = "line://msg/text/" + shareText;
            } else if (/android/i.test(userAgent)) {
                shareHref = "intent://msg/text/" + shareText + "#Intent;scheme=line;package=jp.naver.line.android;end;";
            } else {
                shareHref = "https://social-plugins.line.me/lineit/share?text=" + shareText;
            }
            $('.line').attr('href', shareHref);
        </script>
        <script>
            $(function () {
                var $float = $('#related-float');
                if (!$float.length) {
                    return;
                }
                var blnShown = false;
                var blnClosed = false;

                $float.on('click', '.related-float-close', function () {
                    blnClosed = true;
                    $float.removeClass('is-visible');
                });

                // AdSense anchor 廣告由 Auto ads 自行注入，改以「貼齊視窗底部的固定元素」判斷，
                // 不依賴 Google 內部的 class 名稱；量到高度後把卡片墊高，避免遮蔽廣告
                function fnAnchorHeight() {
                    var els = document.querySelectorAll('ins.adsbygoogle');
                    var intHeight = 0;
                    for (var i = 0; i < els.length; i++) {
                        var objRect = els[i].getBoundingClientRect();
                        if (objRect.height > 0 && Math.abs(objRect.bottom - window.innerHeight) <= 2) {
                            intHeight = Math.max(intHeight, objRect.height);
                        }
                    }
                    return intHeight;
                }

                var blnSyncing = false;
                function fnSyncBottom() {
                    if (blnSyncing) {
                        return;
                    }
                    blnSyncing = true;
                    window.requestAnimationFrame(function () {
                        blnSyncing = false;
                        var intHeight = fnAnchorHeight();
                        $float.css('bottom', intHeight > 0 ? (intHeight + 8) + 'px' : '');
                    });
                }

                $(window).on('resize', fnSyncBottom);

                $(window).on('scroll', function () {
                    if (blnClosed || window.innerWidth >= 1240) {
                        return;
                    }
                    if (blnShown) {
                        // 廣告可能較晚載入或被使用者關閉，持續校正高度
                        fnSyncBottom();
                        return;
                    }
                    var intScrollable = document.documentElement.scrollHeight - window.innerHeight;
                    if (intScrollable > 0 && window.scrollY / intScrollable >= 0.25) {
                        blnShown = true;
                        fnSyncBottom();
                        $float.addClass('is-visible');
                    }
                });
            });
        </script>
                <script>
            document.addEventListener("DOMContentLoaded", function () {
                const tocLinks = document.querySelectorAll(".toc-link");
                const headings = document.querySelectorAll("#post-detail h3");
                const getHeaderOffset = () => window.innerWidth < 1240 ? 190 : 100;
                let isClickScrolling = false;
                let clickScrollTimeout = null;

                tocLinks.forEach(link => {
                    link.addEventListener("click", function (e) {
                        e.preventDefault();
                        const targetId = this.getAttribute("href").substring(1);
                        const targetElement = document.getElementById(targetId);

                        if (targetElement) {
                            isClickScrolling = true;
                            if (clickScrollTimeout) {
                                clearTimeout(clickScrollTimeout);
                            }
                            
                            tocLinks.forEach(l => l.classList.remove("active"));
                            this.classList.add("active");

                            if (window.innerWidth < 1240) {
                                const container = document.querySelector(".toc-scroll-container");
                                if (container) {
                                    const targetLi = this.parentNode;
                                    const liRect = targetLi.getBoundingClientRect();
                                    const containerRect = container.getBoundingClientRect();
                                    const relativeLeft = liRect.left - containerRect.left + container.scrollLeft;
                                    const scrollLeftPos = relativeLeft - (container.clientWidth / 2) + (liRect.width / 2);

                                    container.scrollTo({
                                        left: scrollLeftPos,
                                        behavior: "smooth"
                                    });
                                }
                            }

                            const elementPosition = targetElement.getBoundingClientRect().top;
                            const offsetPosition = elementPosition + window.pageYOffset - getHeaderOffset();

                            window.scrollTo({
                                top: offsetPosition,
                                behavior: "smooth"
                            });
                            
                            clickScrollTimeout = setTimeout(() => {
                                isClickScrolling = false;
                            }, 1200); 
                        }
                    });
                });

                let scrollTimeout;
                window.addEventListener("scroll", function () {
                    if (isClickScrolling || headings.length === 0) return;

                    if (scrollTimeout) {
                        window.cancelAnimationFrame(scrollTimeout);
                    }

                    scrollTimeout = window.requestAnimationFrame(function () {
                        const offset = getHeaderOffset() + 150; 
                        let currentId = headings[0].getAttribute("id");

                        headings.forEach(heading => {
                            const rect = heading.getBoundingClientRect();
                            if (rect.top <= offset) {
                                currentId = heading.getAttribute("id");
                            }
                        });

                        const isAtBottom = (window.innerHeight + window.scrollY) >= document.body.offsetHeight - 20;
                        if (isAtBottom && headings.length > 0) {
                            currentId = headings[headings.length - 1].getAttribute("id");
                        }

                        if (currentId) {
                            const activeLink = document.querySelector(`.toc-link[href="#${currentId}"]`);
                            
                            if (activeLink && !activeLink.classList.contains("active")) {
                                tocLinks.forEach(link => link.classList.remove("active"));
                                activeLink.classList.add("active");

                                if (window.innerWidth < 1240) {
                                    const container = document.querySelector(".toc-scroll-container");
                                    if(container) {
                                        const targetLi = activeLink.parentNode;
                                        const liRect = targetLi.getBoundingClientRect();
                                        const containerRect = container.getBoundingClientRect();
                                        const relativeLeft = liRect.left - containerRect.left + container.scrollLeft;
                                        const scrollLeftPos = relativeLeft - (container.clientWidth / 2) + (liRect.width / 2);

                                        container.scrollTo({
                                            left: scrollLeftPos,
                                            behavior: "smooth"
                                        });
                                    }
                                }
                            }
                        }
                    });
                });
            });
        </script>
