                                    <style>
    /* --- 1. 作用域保護 --- */
    .knews-ticker-root {
        box-sizing: border-box;
        *, *::before, *::after { box-sizing: border-box; }

        display: flex;
        align-items: center;
        width: 100%;
        max-width: 100%;

        /* 電腦版外觀：膠囊風格 */
        border-radius: 50px;
        background: #ffffff;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08), 0 1px 3px rgba(0,0,0,0.05);
        border: 1px solid rgba(0,0,0,0.05);
        margin-bottom: 20px;
        height: 46px; 
        padding: 0 6px;
        position: relative;
        overflow: hidden;

        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        line-height: normal;
        text-align: left;
    }

    /* 左側圖示區塊 */
    .knews-ticker-icon {
        display: flex;
        align-items: center;
        padding: 0 12px 0 16px;
        height: 100%;
        border-right: 1px solid #f0f0f0;
        flex-shrink: 0;
        white-space: nowrap;
    }

    /* 標籤文字：NEWS */
    .knews-label-text {
        color: #d32f2f; /* 新聞紅 */
        font-weight: 800;
        font-size: 0.95rem;
        letter-spacing: 0.5px;
    }

    /* --- 雷達波紋 (聲波) --- */
    .knews-ticker-radar {
        width: 8px;
        height: 8px;
        background-color: #d32f2f;
        border-radius: 50%;
        position: relative;
        margin-right: 12px; 
        flex-shrink: 0;
        box-shadow: 0 0 5px rgba(211, 47, 47, 0.4);
    }

    .knews-ticker-radar::before,
    .knews-ticker-radar::after {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 100%;
        height: 100%;
        border-radius: 50%;
        border: 1px solid #d32f2f;
        opacity: 0;
        animation: knewsRipple 1.5s linear infinite;
    }

    .knews-ticker-radar::after {
        animation-delay: 0.75s; 
    }

    @keyframes knewsRipple {
        0% { width: 100%; height: 100%; opacity: 0.8; border-width: 1px; }
        100% { width: 300%; height: 300%; opacity: 0; border-width: 0px; }
    }

    /* 中間新聞區 */
    .knews-ticker-wrapper {
        flex: 1;
        min-width: 0;
        overflow: hidden;
        height: 100%;
        position: relative;
        display: flex;
        align-items: center;
        margin: 0;
        padding: 0;
    }

    .knews-ticker-list {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        padding-left: 15px;
        margin: 0;
        list-style: none;
    }

    .knews-ticker-item {
        height: 46px; 
        display: flex;
        align-items: center;
        width: 100%;
        margin: 0;
        padding: 0;
    }

    .knews-ticker-item a {
        color: #333 !important;
        text-decoration: none !important;
        transition: color 0.2s;
        display: block;
        width: 100%;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        font-size: 1rem;
        font-weight: 500;
        display: flex; 
        align-items: center;
    }

    .knews-ticker-item a:hover {
        color: #d32f2f !important;
    }

    /* --- 強調樣式 (僅保留分類變色) --- */
    .knews-highlight {
        color: #d32f2f;       /* 紅色 */
        font-weight: 900;
        margin-right: 4px;
        display: inline-block;
        
        &.category-tag {
            font-size: 1rem;
        }
    }

    /* 右側控制區 */
    .knews-ticker-controls {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        height: 100%;
        padding: 0 8px;
        gap: 4px;
        z-index: 2;
        flex-shrink: 0;
        background: transparent;
        width: 32px;
    }

    .knews-ticker-btn {
        background: #fcfcfc;
        border: 1px solid #f0f0f0;
        border-radius: 50%;
        width: 20px;
        height: 20px;
        cursor: pointer;
        font-size: 0.6rem;
        color: #aaa;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
        padding: 0;
        margin: 0;
        line-height: 1;
        appearance: none;
        -webkit-appearance: none;
    }
    
    .knews-ticker-btn:hover {
        border-color: #d32f2f;
        color: #d32f2f;
        background: #fff;
    }

    /* --- 手機版 RWD --- */
    @media (max-width: 768px) {
        .knews-ticker-root {
            border-radius: 12px;
            height: 64px !important; 
            padding: 0;
            align-items: stretch;
            border: none;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        }

        .knews-ticker-icon {
            padding: 0;
            width: 50px; 
            flex-direction: column;
            justify-content: center;
            align-items: center;
            gap: 4px;
            background: #fafafa;
            border-right: 1px solid #eee;
        }
        
        .knews-ticker-radar {
            margin-right: 0; 
            margin-bottom: 2px;
        }

        .knews-label-text {
            font-size: 0.7rem;
            display: block;
            line-height: 1;
            text-align: center;
            color: #d32f2f;
        }

        .knews-ticker-wrapper {
            padding: 0 10px;
        }

        .knews-ticker-item {
            height: 64px !important;
        }

        .knews-ticker-item a {
            white-space: normal !important;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            font-size: 15px !important;
            line-height: 1.4 !important;
            height: auto;
            max-height: 44px;
            vertical-align: middle;
        }
        
        .knews-ticker-controls {
            background: #fff;
            border-left: 1px solid #f0f0f0;
            width: 36px;
            padding: 0;
        }

        .knews-ticker-btn {
            background: transparent;
            border: none;
            font-size: 0.8rem;
            color: #ccc;
        }
    }
</style>

