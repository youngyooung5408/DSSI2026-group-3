        <style>
            .article-left-toc {
                display: none;
                position: fixed;
                top: 80px;
                left: 0;
                width: 100%;
                background: #fff;
                z-index: 997;
                box-shadow: 0 4px 6px -4px rgba(0,0,0,0.1);
                border-bottom: 1px solid #f0f0f0;
            }

            .article-left-toc.show-on-mobile {
                display: block;
            }

            .article-left-toc .toc-title {
                display: none;
            }

            .article-left-toc .toc-scroll-container {
                width: 100%;
                overflow-x: auto;
                overflow-y: hidden;
                white-space: nowrap !important;
                -webkit-overflow-scrolling: touch;
                padding: 0;
                scroll-behavior: smooth;
                position: relative;
                scrollbar-width: none;
                -ms-overflow-style: none;
                touch-action: pan-x;
            }

            .article-left-toc .toc-scroll-container::-webkit-scrollbar {
                display: none;
            }

            .article-left-toc .toc-list {
                list-style: none;
                padding: 0;
                margin: 0;
                display: inline-block;
                font-size: 0;
                white-space: nowrap !important;
            }

            .article-left-toc .toc-list li {
                display: inline-block;
                vertical-align: top;
                white-space: nowrap !important;
            }

            .article-left-toc .toc-list li:first-child {
                padding-left: 15px;
            }
            .article-left-toc .toc-list li:last-child {
                padding-right: 15px;
            }

            .article-left-toc .toc-list li a {
                display: inline-block;
                padding: 12px 15px;
                margin: 0;
                color: #999;
                font-weight: 500;
                font-size: 16px;
                text-decoration: none;
                background-color: transparent;
                border-radius: 0;
                transition: all 0.3s ease;
                position: relative;
                max-width: 66vw;
                overflow: hidden;
            }

            .article-left-toc .toc-list li a.is-truncated {
                -webkit-mask-image: linear-gradient(90deg, #000 calc(100% - 36px), transparent 100%);
                mask-image: linear-gradient(90deg, #000 calc(100% - 36px), transparent 100%);
            }

            .article-left-toc .toc-list li a::before {
                content: "";
                display: inline-block;
                width: 4px;
                height: 13px;
                background-color: #ddd;
                margin-right: 6px;
                vertical-align: middle;
                position: relative;
                top: -2px;
                border-radius: 2px;
            }

            .article-left-toc .toc-list li a.active {
                color: #C07A25 !important;
                background-color: transparent;
                font-weight: 700;
                box-shadow: none;
            }

            .article-left-toc .toc-list li a.active::before {
                background-color: #C07A25;
            }

            .article-left-toc .toc-list li a.active::after {
                content: "";
                position: absolute;
                bottom: 0;
                left: 0;
                width: 100%;
                height: 3px;
                background: #C07A25;
                border-radius: 3px 3px 0 0;
                display: block;
            }

            @media (min-width: 1240px) {
                .article-body-wrapper {
                    display: flex;
                    align-items: flex-start;
                    gap: 40px;
                }

                .article-left-toc {
                    display: block !important; 
                    position: sticky;
                    top: 120px;
                    width: 180px;
                    flex-shrink: 0;
                    background: transparent;
                    box-shadow: none;
                    border-bottom: none;
                }

                .article-left-toc .toc-scroll-container {
                    overflow-x: visible;
                    white-space: normal !important; 
                    padding: 0;
                    touch-action: auto;
                }

                .article-left-toc .toc-title {
                    display: block;
                    font-size: 18px;
                    font-weight: 700;
                    margin-bottom: 15px;
                    color: #000;
                }

                .article-left-toc .toc-list {
                    display: block;
                    border-left: 3px solid #eeeeee; 
                }

                .article-left-toc .toc-list li {
                    display: block; 
                    padding: 0 !important; 
                    white-space: normal !important;
                }

                .article-left-toc .toc-list li a {
                    display: block;
                    padding: 10px 10px 10px 15px;
                    margin: 0;
                    color: #888;
                    font-weight: 400;
                    border-radius: 0;
                    box-shadow: none;
                    background-color: transparent;
                    max-width: none;
                    overflow: visible;
                    -webkit-mask-image: none;
                    mask-image: none;
                }

                .article-left-toc .toc-list li a::before {
                    display: none;
                }

                .article-left-toc .toc-list li a.active::after {
                    display: none;
                }

                .article-left-toc .toc-list li a:hover {
                    color: #D99B4C;
                    background: linear-gradient(90deg, rgba(217, 155, 76, 0.05) 0%, rgba(255,255,255,0) 100%);
                }

                .article-left-toc .toc-list li a.active {
                    color: #B46500 !important; 
                    font-weight: 700;
                    background: linear-gradient(90deg, rgba(217, 155, 76, 0.12) 0%, rgba(255,255,255,0) 100%); 
                }

                .article-left-toc .toc-list li a.active::before {
                    content: "";
                    display: block;
                    position: absolute;
                    left: -3px;
                    top: 0;
                    height: 100%;
                    width: 3px;
                    background-color: #D99B4C;
                    margin: 0;
                }
            }

            .related-float {
                display: none;
            }

            @media (max-width: 1239px) {
                .related-float {
                    display: block;
                    position: fixed;
                    /* 螢幕寬 70%、左右置中；bottom 由 JS 依 anchor 廣告實際高度調整 */
                    left: 50%;
                    width: 70%;
                    box-sizing: border-box;
                    bottom: 0;
                    z-index: 996;
                    background: #fff;
                    border-radius: 10px;
                    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.18);
                    padding: 8px 34px calc(8px + env(safe-area-inset-bottom)) 12px;
                    transform: translate(-50%, 110%);
                    transition: transform 0.35s ease, bottom 0.2s ease;
                }

                .related-float.is-visible {
                    transform: translate(-50%, 0);
                }

                .related-float .related-float-close {
                    position: absolute;
                    top: 2px;
                    right: 2px;
                    border: 0;
                    background: none;
                    font-size: 22px;
                    line-height: 1;
                    color: #bbb;
                    padding: 6px 8px;
                }

                .related-float a {
                    display: flex;
                    align-items: center;
                    gap: 10px;
                    text-decoration: none;
                }

                .related-float figure {
                    width: 72px;
                    flex-shrink: 0;
                    margin: 0;
                }

                .related-float img {
                    display: block;
                    width: 100%;
                    aspect-ratio: 16 / 9;
                    object-fit: cover;
                    border-radius: 5px;
                }

                .related-float .related-float-text {
                    flex: 1;
                    min-width: 0;
                }

                .related-float .related-float-label {
                    display: block;
                    font-size: 11px;
                    font-weight: 700;
                    color: #C07A25;
                    margin-bottom: 2px;
                }

                .related-float .related-float-title {
                    font-size: 14px;
                    font-weight: 500;
                    line-height: 1.35;
                    color: #333;
                    display: -webkit-box;
                    -webkit-line-clamp: 2;
                    -webkit-box-orient: vertical;
                    overflow: hidden;
                }
            }

            #video-float {
                position: fixed;
                right: 20px;
                bottom: 170px;
                width: 50px;
                height: 50px;
                padding: 0;
                border: 0;
                border-radius: 50%;
                background-color: #000;
                background-size: cover;
                background-position: center;
                background-repeat: no-repeat;
                box-shadow: 0 2px 4px #c7c7c7;
                z-index: 999;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
                opacity: 0;
                visibility: hidden;
                transform: scale(0.8);
                transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s;
            }

            #video-float.is-visible {
                opacity: 1;
                visibility: visible;
                animation: videoFloatBounce 1.6s ease-in-out infinite; /* 整顆輕微上下浮動吸睛 */
            }

            @keyframes videoFloatBounce {
                0%, 100% { transform: translateY(0) scale(1); }
                50% { transform: translateY(-5px) scale(1); }
            }

            #video-float::before {
                content: "";
                position: absolute;
                top: 0;
                right: 0;
                bottom: 0;
                left: 0;
                border-radius: 50%;
                background: rgba(0, 0, 0, 0.35);
            }

            /* play 三角 + soundbar 等化器：直向堆疊，播放中的感覺 */
            #video-float .video-icon {
                position: relative;
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: 2px;
            }
            #video-float .video-play {
                width: 20px;
                height: 20px;
                filter: drop-shadow(0 1px 1px rgba(0, 0, 0, 0.5));
            }
            /* soundbar 等化器：四根白條上下跳動 */
            #video-float .video-eq {
                display: flex;
                align-items: flex-end;
                gap: 2px;
                height: 8px;
            }
            #video-float .video-eq i {
                width: 3px;
                height: 100%;
                background: #fff;
                border-radius: 1px;
                transform-origin: bottom;
                transform: scaleY(0.35);
                animation: videoEqBar 0.9s ease-in-out infinite;
                animation-play-state: paused; /* 按鈕隱藏時不動，省效能 */
            }
            #video-float.is-visible .video-eq i {
                animation-play-state: running;
            }
            #video-float .video-eq i:nth-child(1) { animation-delay: 0s; }
            #video-float .video-eq i:nth-child(2) { animation-delay: 0.2s; }
            #video-float .video-eq i:nth-child(3) { animation-delay: 0.4s; }
            #video-float .video-eq i:nth-child(4) { animation-delay: 0.15s; }

            @keyframes videoEqBar {
                0%, 100% { transform: scaleY(0.35); }
                50% { transform: scaleY(1); }
            }

            @media (prefers-reduced-motion: reduce) {
                #video-float.is-visible { animation: none; transform: scale(1); }
                #video-float .video-eq i { animation: none; transform: scaleY(0.7); }
            }

            @media (min-width: 992px) {
                #video-float {
                    right: 40px;
                    bottom: 210px;
                }
            }

            .video-lightbox {
                position: fixed;
                top: 0;
                right: 0;
                bottom: 0;
                left: 0;
                z-index: 9999;
                background: rgba(0, 0, 0, 0.92);
                display: none;
                align-items: center;
                justify-content: center;
                padding: 20px;
            }

            .video-lightbox.is-open {
                display: flex;
            }

            .video-lightbox .video-lightbox-inner {
                width: 100%;
                max-width: 1000px;
            }

            .video-lightbox .video-lightbox-close {
                position: absolute;
                top: 10px;
