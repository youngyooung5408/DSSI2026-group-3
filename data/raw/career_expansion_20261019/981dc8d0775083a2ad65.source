        <script>
            //            Initiate glightbox
            const glightbox = GLightbox({
                selector: '.glightbox',
                touchNavigation: true,
                loop: true
            });
            function markTocTruncated() {
                document.querySelectorAll('.article-left-toc .toc-list li a').forEach(function (el) {
                    el.classList.toggle('is-truncated', el.scrollWidth > el.clientWidth);
                });
            }
            // pin share btns
            var controller = new ScrollMagic.Controller();

            var scene = new ScrollMagic.Scene({
                triggerElement: "#post-detail .post-share",
                offset: -20,
                triggerHook: 0
            })
                    .on("enter leave", function (e) {
                        if (e.type === 'enter') {
                            document.querySelector('#fixed-share').style.display = 'block';

                            if (document.querySelector('#article-left-toc')) {
                                document.querySelector('#article-left-toc').classList.add('show-on-mobile');
                                if (window.innerWidth < 1240) {
                                    markTocTruncated();
                                }
                            }
                            scene.offset(document.querySelector('#fixed-share-btn-end-trigger').clientHeight - document.querySelector('#fixed-share').clientHeight / 2);
                        } else {
                            document.querySelector('#fixed-share').style.display = 'none';
                            if (document.querySelector('#article-left-toc')) {
                                document.querySelector('#article-left-toc').classList.remove('show-on-mobile');
                            }
                        }
                    })
                    .addTo(controller);

            window.onresize = function () {
                scene.offset(document.querySelector('#fixed-share-btn-end-trigger').clientHeight - document.querySelector('#fixed-share').clientHeight / 2);
            };
