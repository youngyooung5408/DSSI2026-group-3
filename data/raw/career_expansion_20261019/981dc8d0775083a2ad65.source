<script>
    $(document).ready(function () {
        let $newsList = $('#knewsTickerList');
        let $newsItems = $('.knews-ticker-item');
        let $wrapper = $('#knewsTickerWrapper');

        if ($newsItems.length === 0) return;

        let autoScroll = true;
        let interval;

        $newsList.append($newsList.html());
        let totalOriginalItems = $newsItems.length;

        function getUnitHeight() {
            let h = $('.knews-ticker-item').first().outerHeight();
            return h > 0 ? h : ($('body').width() < 768 ? 64 : 46);
        }

        function startAutoScroll() {
            clearInterval(interval);
            interval = setInterval(() => {
                if (autoScroll) moveUp();
            }, 4000);
        }

        function stopAutoScroll() {
            clearInterval(interval);
        }

        function moveUp() {
            let h = getUnitHeight();
            $newsList.stop(true, false).animate({top: `-=${h}px`}, 500, function () {
                let currentTop = Math.abs(parseInt($newsList.css('top')));
                if (currentTop >= Math.round(h * totalOriginalItems)) {
                    $newsList.css('top', '0');
                }
            });
        }

        function moveDown() {
            let h = getUnitHeight();
            let currentTop = parseInt($newsList.css('top'));
            if (currentTop >= 0) {
                $newsList.css('top', `-${h * totalOriginalItems}px`);
            }
            $newsList.stop(true, false).animate({top: `+=${h}px`}, 500);
        }

        document.addEventListener('visibilitychange', function () {
            if (document.hidden) {
                stopAutoScroll();
            } else {
                $newsList.stop(true, false);
                startAutoScroll();
            }
        });

        $('#knewsUp').click((e) => {
            e.preventDefault();
            autoScroll = false;
            stopAutoScroll();
            moveUp();
        });

        $('#knewsDown').click((e) => {
            e.preventDefault();
            autoScroll = false;
            stopAutoScroll();
            moveDown();
        });

        $wrapper.hover(stopAutoScroll, startAutoScroll);

        let touchStartY = 0;
        $wrapper.on('touchstart', (e) => {
            autoScroll = false;
            stopAutoScroll();
            touchStartY = e.originalEvent.touches[0].clientY;
        });

        $wrapper.on('touchmove', (e) => {
            let touchEndY = e.originalEvent.touches[0].clientY;
            if (touchStartY - touchEndY > 5) {
                moveUp();
                touchStartY = touchEndY;
            } else if (touchEndY - touchStartY > 5) {
                moveDown();
                touchStartY = touchEndY;
            }
        });

        let resizeTimer;
        $(window).resize(function () {
            clearTimeout(resizeTimer);
            resizeTimer = setTimeout(function () {
                stopAutoScroll();
                $newsList.stop(true, false).css('top', 0);
                startAutoScroll();
            }, 250);
        });

        startAutoScroll();
    });
</script>                                                                                                            <h1>網紅鄭方形參選！重提舊案再控蓋牌　教育局硬起來：7罪起訴絕不寬貸</h1>
                                    <h2></h2>
                                    <div class="article-meta-panel abc-style">
                                        <div class="abc-meta-info">
                                            <a class="topic-link primary" href="https://www.knews.com.tw/realtime/politics" target="_blank">
                                                政治                                            </a>
