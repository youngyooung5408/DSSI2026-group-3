                                                <span class="label">記者</span>
                                                                                                                                                                                                            <a href="https://www.knews.com.tw/reporter/kenny" target="_blank">王志弘</a>
                                                                                            </div>
                                            <span class="abc-separator">|</span>
                                            <div class="abc-timestamp">
                                                <span class="label">發布</span>
                                                <time>2026/09/11 15:32</time>
                                                                                            </div>
