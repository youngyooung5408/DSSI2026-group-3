  <script type="text/javascript">
	function checkwindow(muid, type, url) {
		var viewport_width = $(window).width();
		//console.log("in checkwindow");
		//console.log("viewport_width= " + viewport_width);
		if (type == "U"){
			read(muid);
		} else if (viewport_width >= 1000) {
			read(muid);
			window.location.href = url;
		} else if (viewport_width < 1000 && type == "D") {
			read(muid);
		}  else {
			read(muid);
			window.location.href = url;
		}
	}
	//點閱率(Menu)
	function read(menuid) {
		$.ajax({
			url: "ap/updatenumber_menu.jsp",
			type: "POST",
			data: "menuid=" + menuid
		});
	}
  </script>
  <script type="text/javascript">
  	//tab鍵走menu
	function msend2(id,mrcount) {
	     for ( i=0; i<mrcount; i++ ) {
	        if ( i == id ) {
	           	if ( document.getElementById("mtype2"+id) ) {
	              	document.getElementById("mtype2"+id).style.display = 'block';
	           	}
	        }else{
	           	if ( document.getElementById("mtype2"+i) ) {
	              	document.getElementById("mtype2"+i).style.display = 'none';
	        	}
	    	}
		}
	}
  </script>
