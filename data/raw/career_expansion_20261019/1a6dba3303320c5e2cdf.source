 web-share" allowfullscreen></iframe></div><div class="l-ad ml-5px"><a href="https://www.youtube.com/@FTforesee" target="_blank" rel="noopener" onclick="add_data_layer_event('click_banner', 'banner_right');"><img src="https://i01.ftnn.com.tw/a/26/288/262881024321410266ce2d.png" alt="每周一周四_政治讀新術"></a></div></div><div class="search-mb-show"><div class="close-search-mb"><i class="bi bi-x-lg"></i></div><div class="search-top-show"><form action="/search" method="get"><input type="text" name="keyword" placeholder="搜尋關鍵字" required><div class="search-btn-mb"><i class="fas fa-search"></i></div><input type="hidden" name="all" value="true"><button type="submit" id="btn_search_m" style="display: none;">搜尋</button></form></div></div><script src="https://static.ftnn.com.tw/www/js/swiper_index.js?20251002001"></script> <link rel="stylesheet" type="text/css" href="https://static.ftnn.com.tw/www/css/jquery.fancybox.min.css"> <script type="text/javascript" src="https://static.ftnn.com.tw/www/js/jquery.fancybox.min.js"></script> <div class="container"> <div class="news-page-all"> <div class="news-show"> <div class="news-breadcrumb"> <nav class="breadcrumb" style="margin-top: 0px"> <a href="/">FTNN新聞網</a> <a href="/category/21">地方</a> </nav> </div> <div class="news-page-top"> <div class="news-main-title"> <h1>柯文哲雲林掃街拜票一整天　王竣毅：以前替長官排行程今天換他陪我走家鄉</h1> </div> <div class="news-detail-text"> <div class="ndt-left"> <p>發布時間：2026/9/28 18:55</p> </div> <div class="ndt-right"> <div class="share-group"> <a href="https://www.facebook.com/sharer/sharer.php?u=https%3A%2F%2Fwww.ftnn.com.tw%2Fnews%2F582812"> <div class="fb-s share-cir-btn"> <i class="fab fa-facebook"></i> </div> </a> <a href="https://twitter.com/share?url=https%3A%2F%2Fwww.ftnn.com.tw%2Fnews%2F582812"> <div class="twitter-s share-cir-btn"> <i class="fab fa-twitter"></i> </div> </a> <a href="https://social-plugins.line.me/lineit/share?url=https%3A%2F%2Fwww.ftnn.com.tw%2Fnews%2F582812"> <div class="line-s share-cir-btn"> <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" class="bi bi-line" viewBox="0 0 16 16"> <path d="M8 0c4.411 0 8 2.912 8 6.492 0 1.433-.555 2.723-1.715 3.994-1.678 1.932-5.431 4.285-6.285 4.645-.83.35-.734-.197-.696-.413l.003-.018.114-.685c.027-.204.055-.521-.026-.723-.09-.223-.444-.339-.704-.395C2.846 12.39 0 9.701 0 6.492 0 2.912 3.59 0 8 0M5.022 7.686H3.497V4.918a.156.156 0 0 0-.155-.156H2.78a.156.156 0 0 0-.156.156v3.486c0 .041.017.08.044.107v.001l.002.002.002.002a.15.15 0 0 0 .108.043h2.242c.086 0 .155-.07.155-.156v-.56a.156.156 0 0 0-.155-.157m.791-2.924a.156.156 0 0 0-.156.156v3.486c0 .086.07.155.156.155h.562c.086 0 .155-.07.155-.155V4.918a.156.156 0 0 0-.155-.156zm3.863 0a.156.156 0 0 0-.156.156v2.07L7.923 4.832l-.013-.015v-.001l-.01-.01-.003-.003-.011-.009h-.001L7.88 4.79l-.003-.002-.005-.003-.008-.005h-.002l-.003-.002-.01-.004-.004-.002-.01-.003h-.002l-.003-.001-.009-.002h-.006l-.003-.001h-.004l-.002-.001h-.574a.156.156 0 0 0-.156.155v3.486c0 .086.07.155.156.155h.56c.087 0 .157-.07.157-.155v-2.07l1.6 2.16a.2.2 0 0 0 .039.038l.001.001.01.006.004.002.008.004.007.003.005.002.01.003h.003a.2.2 0 0 0 .04.006h.56c.087 0 .157-.07.157-.155V4.918a.156.156 0 0 0-.156-.156zm3.815.717v-.56a.156.156 0 0 0-.155-.157h-2.242a.16.16 0 0 0-.108.044h-.001l-.001.002-.002.003a.16.16 0 0 0-.044.107v3.486c0 .041.017.08.044.107l.002.003.002.002a.16.16 0 0 0 .108.043h2.242c.086 0 .155-.07.155-.156v-.56a.156.156 0 0 0-.155-.157H11.81v-.589h1.525c.086 0 .155-.07.155-.156v-.56a.156.156 0 0 0-.155-.157H11.81v-.589h1.525c.086 0 .155-.07.155-.156Z"/> </svg> </div> </a> </div> </div> </div> </div> <div class="news-box"> <div class="news-yt-set"> </div> <div class="news-body"> <p>地方中心／綜合報導</p> <p>民眾黨創黨主席柯文哲27日南下雲林斗六輔選，陪同前幕僚、雲林縣議員候選人王竣毅走訪斗六、林內多處行程，從早到晚走進傳統市場、農業活動、宮廟及夜市。王竣毅表示，過去自己曾在中央、立法院及總統競選團隊擔任幕僚，熟悉政治人物一天行程的珍貴，因此當得知柯文哲願意把一整天留給斗六、林內，格外感動。</p> <figure class="image"><picture style="font-size: 0;"> <source srcset="https://i01.ftnn.com.tw/a/26/270/2627019014582797299b21.webp" type="image/webp"> <img alt="王竣毅競選辦公室 提供" height="683" src="https://i01.ftnn.com.tw/a/26/270/2627019014582797299b21.jpeg" width="1024" /> </picture> <figcaption>柯文哲雲林掃街拜票一整天　王竣毅：以前替長官排行程今天換他陪我走家鄉。（圖／王竣毅競選辦公室 提供）</figcaption> </figure> <p>王竣毅在臉書分享這一天的行程與心情。他表示，選舉期間，政治人物的一天往往會被拆成不同時段，安排不同地點與候選人，因此自己特別認真規劃每一站，不只是考量哪裡人多、哪裡適合拍照，而是思考「如果只有這一天，我希望我的老長官，看見什麼樣的斗六、林內？」</p><p style="margin-bottom: 0px; text-align: center;">廣告 更多內容請繼續往下閱讀</p><div id="div-gpt-ad-1685251854961-0" class="d-pc-show" style="min-width: 728px; min-height: 90px;"></div><div id="div-gpt-ad-1685251099234-0" class="d-mb-show" style="min-width: 300px; min-height: 250px;"></div> <p>首站走訪斗六西市場，王竣毅形容這裡是許多斗六人的「老廚房」，承載幾代人的生活記憶。他認為，市場環境改善固然重要，但更值得思考的是，改造之後人潮能不能留下、攤商能不能持續做生意，以及長輩與年輕人是否願意再次走進傳統市場。</p> <p>隨後一行人前往林內烏麻玉米節，王竣毅表示，雲林是農業大縣，支持農業不能只停留在口號，農民把產品種好後，還需要品牌、行銷與通路，才能讓地方農業被更多人看見，因此希望透過行程讓柯文哲以及更多人了解林內農產品與地方產業的價值。</p><p style="margin-bottom: 0px; text-align: center;">廣告 更多內容請繼續往下閱讀</p><div id="div-gpt-ad-1685251826568-0" class="d-pc-show"></div><div id="div-gpt-ad-1685251032111-0" class="d-mb-show"></div> <p>行程中，柯文哲與王竣毅也走訪順安宮、福龍宮參拜，並前往石榴班，在白沙屯媽祖過去曾駐駕的土地公廟用膳；下午再走進民生黃昏市場、莊敬黃昏市場，最後抵達斗六觀光夜市，從白天一路走到晚上。</p> <p>王竣毅表示，當天適逢中秋連假，在夜市看到一家人一起逛街，也遇到許多熟悉的斗六朋友，「從天亮，走到天黑」，讓他對這一天有很深的感受。他回憶，過去跟著柯文哲工作時，自己的角色是在幕後掌握時間、確認行程與處理現場，「長官往前走，我就在後面跟著走」。</p> <p>「今天，他依然是我的老長官，但我的身分不同了。」王竣毅說，如今自己是回到家鄉投入雲林縣議員選舉的參選人，過去是自己陪著長官走行程，如今則換成老長官陪著自己走家鄉。</p> <p>對於柯文哲願意把一整天留在雲林，王竣毅表達感謝，也向一路參與行程的工作人員與志工致意。他表示，許多人站在鏡頭之外，負責掌握時間、確認動線與維持行程順利進行，這些看不見的工作同樣重要。</p> <p>王竣毅也感謝沿途停下腳步與他握手、聊天、分享地方大小事的鄉親。他說，過去當幕僚時，知道一天的時間有多珍貴；如今成為參選人，更明白鄉親願意交給自己的每一分鐘都不能浪費。</p> <p>王竣毅最後寫下，「以前，我替長官排行程。今天，老長官陪我走了一整天。接下來的路，我會自己一步一步走。」他表示，這一天雖然很累，但很值得，也向鄉親送上中秋平安祝福。</p> </div> </div> <div class="further-reading-show"> <div class="frs-tit">延伸閱讀</div> <ul> <a href="/news/587484"> <li>黃光芹爆竹北藍白合破局內幕：柯文哲堅持邱臣遠參選　黃國昌嫁禍徐欣瑩</li> </a> <a href="/news/582979"> <li>收假首日柯文哲合體邱臣遠走訪竹北雙市場　林啟賢熱情接待「總教練」親督軍力拚竹北新局</li> </a> <div id="_popIn_recommend_word"></div> <a href="/news/576619"> <li>新竹藍白合破局爭議  知名小草護理師：看不懂黃國昌是在罵幾點的</li> </a> <li> <scr