<script>
// 記錄瀏覽量
window.contentId = 3146544;
window.childCategoryId = 88;
window.authorId = 126743;
window.forwardUserId = 0;
if(navigator.sendBeacon){navigator.sendBeacon('/?app=view&act=hit&no='+window.contentId);}
else{fetch('/?app=view&act=hit&no='+window.contentId,{keepalive:true}).catch(function(){});}

// 舊版外掛計數系統（analysis.life.com.tw）
(function(domain, articleId, categoryId, authorId, forwardUserId) {
    window._laq = window._laq || [];
    window._laq.push(['_setAuthorId', authorId]);
    window._laq.push(['_setAuthorWebSite', '13']);
    window._laq.push(['_setId', articleId]);
    window._laq.push(['_setWebSite', '4']);
    window._laq.push(['_setDomain', domain]);
    window._laq.push(['_setForwardUser', forwardUserId > 0 ? forwardUserId : authorId]);
    window._laq.push(['_setLabel', categoryId]);
    window._laq.push(['_setCallback_Count', {app:'count', act:'content', id:articleId, websiteId:'4', callback:function(data){}}]);
    (function(id) {
        if(document.getElementById(id)) return;
        var script = document.createElement('script');
        script.id = id;
        script.async = true;
        script.src = '//analysis.life.com.tw/media/js/la.js';
        document.querySelector('head').appendChild(script);
    })('lifeAnalysis');
})("life.tw", window.contentId, window.childCategoryId, window.authorId, window.forwardUserId);

// Article body images: 加 alt、loading="lazy"、onerror
document.querySelectorAll('.article-body img').forEach(function(img) {
  if (!img.alt || img.alt === '') {
    // 從 figcaption 或前後文取 alt
    var fig = img.closest('figure');
    var caption = fig ? fig.querySelector('figcaption') : null;
    img.alt = caption ? caption.textContent.trim() : "319\u4f4d\u9577\u8f29\u9f4a\u805a \u81ea\u7531\u667a\u5728 \u5609\u5e74\u83ef \u57d4\u57fa\u6df1\u8015\u5931\u667a\u53cb\u5584\u793e\u5340";
  }
  if (!img.getAttribute('loading')) img.setAttribute('loading', 'lazy');
  if (!img.getAttribute('decoding')) img.setAttribute('decoding', 'async');
  img.onerror = function() { this.onerror = null; this.src = '/static/images/cover/default.png'; };
});
// External links: 加 rel="noopener noreferrer"
document.querySelectorAll('.article-body a[href^="http"]').forEach(function(a) {
  if (!a.hostname || a.hostname === location.hostname) return;
  a.setAttribute('rel', 'noopener noreferrer');
  a.setAttribute('target', '_blank');
});

// Reading progress bar — 跨「主文章 + 推薦文章」運作
// 視窗中央落在哪一篇 .article-body，就顯示那篇的進度（每篇各自 0~100%）
(function() {
  var bar = document.getElementById('readingProgress');
  if(!bar) return;
  var ticking = false;

  function update() {
    ticking = false;
    var bodies = document.querySelectorAll('.article-body');
    if(!bodies.length) return;
    var mid = window.innerHeight / 2;
    var current = null;
    for(var i = 0; i < bodies.length; i++) {
      var r = bodies[i].getBoundingClientRect();
      // 嚴格命中：視窗中央在文章內
      if(r.top < mid && r.bottom > mid) { current = bodies[i]; break; }
    }
    // 沒命中（在文章間隙）→ 保留上次值，視覺平滑
    if(!current) return;

    var rect = current.getBoundingClientRect();
    var total = current.scrollHeight;
    var scrolled = Math.max(0, -rect.top);
    var denom = Math.max(1, total - window.innerHeight * 0.5);
    var pct = Math.min(100, Math.max(0, (scrolled / denom) * 100));
    bar.style.width = pct + '%';
  }

  window.addEventListener('scroll', function() {
    if(ticking) return;
    ticking = true;
    requestAnimationFrame(update);
  }, {passive: true});

  // 初始一次（避免進站時條停在 0）
  update();
})();

// Article reaction：多 emoji（雙位置同步，6 種 reaction）
(function() {
  var widgets = document.querySelectorAll('.article-reaction[data-position]');
  if(!widgets.length) return;
  var articleId = widgets[0].getAttribute('data-article-id');
  if(!articleId) return;
  var voted = widgets[0].getAttribute('data-voted') === '1';

  // emoji map（與後端 ReactionPicker::REACTIONS 對應）
  var EMOJI = {
    'like':  {emoji:'👍', label:'讚',   color:'#1e88e5'},
    'love':  {emoji:'❤️', label:'愛',   color:'#e53935'},
    'haha':  {emoji:'🤣', label:'哈',   color:'#fbc02d'},
    'wow':   {emoji:'😮', label:'哇',   color:'#7e57c2'},
    'sad':   {emoji:'😢', label:'心碎', color:'#5e7c8a'},
    'angry': {emoji:'😡', label:'怒',   color:'#d32f2f'}
  };

  // 把 mid widget 移到 .article-body ~30% 字數位置（短文 < 600 字直接 remove）
  function placeMidWidget() {
    var mid = document.querySelector('.article-reaction[data-position="mid"]');
    if(!mid) return;
    var body = document.querySelector('.article-body');
    if(!body) { mid.remove(); return; }

    var total = (body.textContent || '').replace(/\s+/g, '').length;
    if(total < 600) { mid.remove(); return; }

    var threshold = Math.floor(total * 0.3);
    var paragraphs = [];
    for(var i = 0; i < body.children.length; i++) {
      if(body.children[i].tagName === 'P') paragraphs.push(body.children[i]);
    }
    if(!paragraphs.length) { mid.remove(); return; }

    var cum = 0, anchor = null;
    for(var j = 0; j < paragraphs.length; j++) {
      cum += (paragraphs[j].textContent || '').replace(/\s+/g, '').length;
      if(cum >= threshold) { anchor = paragraphs[j]; break; }
    }
    if(!anchor) anchor = paragraphs[paragraphs.length - 1];

    var nextEl = anchor.nextElementSibling;
    while(nextEl && /^(FIGURE|IMG|PICTURE)$/.test(nextEl.tagName)) {
      nextEl = nextEl.nextElementSibling;
    }

    mid.removeAttribute('hidden');
    if(nextEl) anchor.parentNode.insertBefore(mid, nextEl);
    else anchor.parentNode.appendChild(mid);
  }

  // 從 widget 抓出當前的 reaction set（依按鈕順序）
  function getReactionSetFromWidget(wrap) {
    var btns = wrap.querySelectorAll('.article-reaction-btn');
    var set = [];
    btns.forEach(function(b) {
      var t = b.getAttribute('data-type');
      if(EMOJI[t]) set.push(t);
    });
    return set;
  }

  // 同步更新所有 widget
  function renderAllResults(counts, votedType) {
    var total = 0;
    Object.keys(EMOJI).forEach(function(k) { total += (counts[k] || 0); });

    widgets.forEach(function(wrap) {
      var set = getReactionSetFromWidget(wrap);
      if(!set.length) return;

      // 確保 preview 存在
      var preview = wrap.querySelector('.article-reaction-preview');
      if(!preview && total > 0) {
        preview = document.createElement('div');
        preview.className = 'article-reaction-preview';
        var html = '';
        set.forEach(function(k) {
          var d = EMOJI[k];
          html += '<div class="article-reaction-bar-row" data-reaction="' + k + '">' +
            '<span class="article-reaction-bar-label">' + d.emoji + ' ' + d.label + '</span>' +
            '<div class="article-reaction-bar">' +
              '<div class="article-reaction-bar-fill" style="width:0%; background:' + d.color + ';"></div>' +
            '</div>' +
            '<span class="article-reaction-bar-pct">0%</span>' +
          '</div>';
        });
        preview.innerHTML = html;
        var title = wrap.querySelector('.article-reaction-title');
        title.parentNode.insertBefore(preview, title.nextSibling);
        preview.offsetHeight; // force reflow → 動畫
      }

      if(preview) {
        set.forEach(function(k) {
          var row = preview.querySelector('.article-reaction-bar-row[data-reaction="' + k + '"]');
          if(!row) return;
          var cnt = counts[k] || 0;
          var pct = total > 0 ? Math.round(cnt / total * 100) : 0;
          var fill = row.querySelector('.article-reaction-bar-fill');
          var pctEl = row.querySelector('.article-reaction-bar-pct');
          if(fill)  fill.style.width = pct + '%';
          if(pctEl) pctEl.textContent = pct + '%';
        });
      }

      var meta = wrap.querySelector('.article-reaction-meta');
      if(meta) meta.innerHTML = '<span class="reactionTotal">' + total + '</span> 人反應';

      if(votedType && EMOJI[votedType]) {
        wrap.classList.add('is-voted');
        wrap.setAttribute('data-voted', '1');
        wrap.setAttribute('data-voted-type', votedType);
        var btn = wrap.querySelector('.article-reaction-btn[data-type="' + votedType + '"]');
        if(btn) btn.classList.add('is-mine');

        var msg = wrap.querySelector('.article-reaction-voted-msg');
        if(!msg) {
          msg = document.createElement('div');
          msg.className = 'article-reaction-voted-msg';
          wrap.appendChild(msg);
        }
        var d = EMOJI[votedType];
        msg.innerHTML = '✨ 你選了 <strong>' + d.emoji + ' ' + d.label + '</strong>';
      }
    });
  }

  function onVote(type) {
    if(voted || !EMOJI[type]) return;
    voted = true;

    // 樂觀更新：撈出當前 widget 的 counts，type 那個 +1
    var first = widgets[0];
    var totalEl = first.querySelector('.reactionTotal');
    var currentTotal = totalEl ? (parseInt(totalEl.textContent, 10) || 0) : 0;
    var counts = {like:0, love:0, haha:0, wow:0, sad:0, angry:0};
    var preview = first.querySelector('.article-reaction-preview');
    if(preview && currentTotal > 0) {
      var rows = preview.querySelectorAll('.article-reaction-bar-row');
      rows.forEach(function(row) {
        var k = row.getAttribute('data-reaction');
        var pctEl = row.querySelector('.article-reaction-bar-pct');
        var pct = pctEl ? (parseInt(pctEl.textContent, 10) || 0) : 0;
        counts[k] = Math.round(currentTotal * pct / 100);
      });
    }
    counts[type] = (counts[type] || 0) + 1;
    renderAllResults(counts, type);

    var xhr = new XMLHttpRequest();
    xhr.open('POST', '/?app=api&act=reaction');
    xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
    xhr.onload = function() {
      try {
        var resp = JSON.parse(xhr.responseText);
        if(resp.status && resp.data && resp.data.counts) {
          renderAllResults(resp.data.counts, type);
        }
      } catch(e) {}
    };
    xhr.send('id=' + encodeURIComponent(articleId) + '&type=' + type);
  }

  widgets.forEach(function(wrap) {
    wrap.addEventListener('click', function(e) {
      var btn = e.target.closest('.article-reaction-btn');
      if(!btn) return;
      var type = btn.getAttribute('data-type');
      if(EMOJI[type]) onVote(type);
    });
  });

  if(document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', placeMidWidget);
  } else {
    placeMidWidget();
  }
})();

// PopIn (lazy)
(function() {
  var target = document.getElementById('_popIn_recommend_banner');
  if(!target) return;
  var observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if(entry.isIntersecting) {
        var pa = document.createElement('script');
        pa.async = true;
        pa.src = location.protocol + '//api.popin.cc/searchbox/life_tw.js';
        document.head.appendChild(pa);
        observer.unobserve(entry.target);
      }
    });
  }, {rootMargin: '300px 0px'});
  observer.observe(target);
})();

// QoolQuiz vote/comment: 暫時移除（sdk.js SyntaxError）

// Dable (lazy)
(function() {
  var target = document.getElementById('dablewidget_zlvm1eL7_3703rJgo');
  if(!target) return;
  var observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if(entry.isIntersecting) {
        var s = document.createElement('script');
        s.async = true;
        s.src = '//static.dable.io/dist/plugin.min.js';
        s.setAttribute('data-widget_id', 'zlvm1eL7');
        document.head.appendChild(s);
        observer.unobserve(entry.target);
      }
    });
  }, {rootMargin: '300px 0px'});
  observer.observe(target);
})();

// AdSense slot inject（adFrame0~5 + 內文動態廣告由 ad_v6.js 處理）
// 立即載入：ad_v6.js 只負責建 <ins> 並排入 adsbygoogle 佇列，實際請求仍等 adsbygoogle.js
// （html5.php 延後載入），不會跟首屏圖片搶頻寬。之前等互動/8 秒導致看完首屏就走的讀者 0 曝光。
window.noad = 0;
window.parentID = 2;
(function() {
  if(window.noad == 1) return;
  var s = document.createElement('script');
  s.async = true;
  s.crossOrigin = 'anonymous';
  s.src = '/static/js/ad_v6.js?v=1792134020';
  document.head.appendChild(s);
})();

// ===== 語意相關文章：無限往下捲讀下一篇 =====
// 觸發時機：使用者捲到主文 50% 位置，預先載入第一篇推薦
// 之後每篇載入完，IntersectionObserver 監聽底部，距 600px 觸發下一篇
// URL/title 隨捲動位置即時 history.replaceState
(function(articleId) {
  var container = document.getElementById('semanticRelatedContainer');
  var observerEl = document.getElementById('semanticRelatedObserver');
  if(!container || !articleId) return;

  var totalArticles = 0;
  var currentIndex = 0;
  var loading = false;
  var originalUrl = location.pathname + location.search;
  var originalTitle = document.title;
  var colorPool = ['#E53935','#8E24AA','#1E88E5','#00897B','#F4511E','#6D4C41','#3949AB','#00ACC1'];

  var pickColor = function(name) {
    name = String(name || '');
    var hash = 0;
    for(var i = 0; i < name.length; i++) { hash = ((hash << 5) - hash) + name.charCodeAt(i); hash |= 0; }
    return colorPool[Math.abs(hash) % colorPool.length];
  };

  var pickInitial = function(name) {
    var raw = String(name || '');
    var stripped = raw;
    try { stripped = raw.replace(/^[\p{P}\p{S}\p{Z}\s]+/u, ''); } catch(e) {}
    return (stripped || raw).charAt(0);
  };

  // 建立一篇文章 DOM（V6 版面）
  var buildArticlePage = function(article) {
    var wrap = document.createElement('article');
    wrap.className = 'semantic-related-article';
    wrap.setAttribute('data-article-id', article.id);

    // 翻頁色塊
    var brk = document.createElement('div');
    brk.className = 'semantic-page-break';
    brk.innerHTML =
      '<div class="semantic-page-break-label">NEXT</div>' +
      '<div class="semantic-page-break-title"></div>' +
      '<div class="semantic-page-break-hint"><span>向下繼續閱讀</span></div>';
    brk.querySelector('.semantic-page-break-title').textContent = article.title;
    wrap.appendChild(brk);

    // 標題
    var h1 = document.createElement('h1');
    h1.className = 'article-title';
    h1.style.marginTop = '20px';
    h1.textContent = article.title;
    wrap.appendChild(h1);

    // meta bar（作者頭像 + 名稱 + 時間）
    var bar = document.createElement('div');
    bar.className = 'article-meta-bar';
    var initial = pickInitial(article.author);
    var bg = pickColor(article.author);
    bar.innerHTML =
      '<a href="' + (article.url || '#') + '" class="article-author-link" rel="author">' +
        '<span class="article-author-avatar" style="background:' + bg + '">' + initial + '</span>' +
        '<span class="article-author-name">' + (article.author || '') + '</span>' +
      '</a>' +
      '<time class="article-meta-time">' + (article.postDate || '') + '</time>';
    wrap.appendChild(bar);

    // 文章本體（封面圖通常嵌在內文最開頭，不另外顯示獨立封面避免重複）
    var body = document.createElement('div');
    body.className = 'article-body';
    body.innerHTML = article.content || '';
    wrap.appendChild(body);

    return wrap;
  };

  // URL 同步：捲動畫面中線在哪篇文章區塊內，網址跟著切
  var urlArticles = []; // [{el, url, title, id}]
  var currentUrl = originalUrl;
  var scrollTimer = null;
  var updateUrl = function() {
    var mid = window.innerHeight / 2;
    var found = null;
    for(var i = 0; i < urlArticles.length; i++) {
      var r = urlArticles[i].el.getBoundingClientRect();
      if(r.top < mid && r.bottom > mid) { found = urlArticles[i]; break; }
    }
    var newUrl = found ? found.url : originalUrl;
    var newTitle = found ? found.title : originalTitle;
    if(newUrl !== currentUrl) {
      currentUrl = newUrl;
      try { history.replaceState(null, '', newUrl); } catch(e) {}
      document.title = newTitle;
      if(found && typeof gtag === 'function') {
        gtag('event', 'semantic_article_viewed', { article_id: found.id, source_article_id: articleId });
      }
    }
  };
  window.addEventListener('scroll', function() {
    if(scrollTimer) return;
    scrollTimer = setTimeout(function() { scrollTimer = null; updateUrl(); }, 100);
  }, { passive: true });

  // 監看一篇文章底部，進畫面就載下一篇
  var observeBottom = function(el) {
    if(!('IntersectionObserver' in window)) return;
    var obs = new IntersectionObserver(function(entries) {
      if(entries[0].isIntersecting) { obs.unobserve(el); loadNext(); }
    }, { rootMargin: '600px 0px' });
    obs.observe(el);
  };

  // 純 fetch（不依賴 library.js 的 window.ajax — deferred 載入時可能還沒備好）
  var apiGet = function(params, cb) {
    var qs = Object.keys(params).map(function(k) {
      return encodeURIComponent(k) + '=' + encodeURIComponent(params[k]);
    }).join('&');
    fetch('/?' + qs, { credentials: 'same-origin' })
      .then(function(r) { return r.json(); })
      .then(function(data) { cb(data); })
      .catch(function() { cb({ status: false }); });
  };

  // 載下一篇
  var loadNext = function() {
    if(loading || currentIndex >= totalArticles) return;
    loading = true;
    observerEl.style.height = 'auto';

    apiGet({ app: 'view', act: 'getSemanticRelated', no: articleId, index: currentIndex }, function(response) {
      loading = false;
      observerEl.style.height = '0';

      if(!response.status || !response.data) {
        currentIndex++;
        if(currentIndex < totalArticles) loadNext();
        else observerEl.style.display = 'none';
        return;
      }

      var el = buildArticlePage(response.data);
      container.appendChild(el);
      urlArticles.push({ el: el, url: response.data.url, title: response.data.title, id: response.data.id });
      currentIndex++;

      if(typeof gtag === 'function') {
        gtag('event', 'semantic_article_loaded', {
          article_id: response.data.id,
          article_index: currentIndex,
          source_article_id: articleId
        });
      }
      if(typeof window.lazyLoadInstance !== 'undefined') window.lazyLoadInstance.update();

      if(currentIndex < totalArticles) observeBottom(el);
      else observerEl.style.display = 'none';
    });
  };

  // 第一步：拿總數
  var init = function() {
    observerEl.style.height = 'auto';
    apiGet({ app: 'view', act: 'getSemanticRelated', no: articleId }, function(response) {
      observerEl.style.height = '0';
      if(!response.status || !response.data || !response.data.total || response.data.total < 1) {
        observerEl.style.display = 'none';
        return;
      }
      totalArticles = response.data.total;
      loadNext();
    });
  };

  // 觸發點：在主文 .article-body 中段插入隱形 trigger
  var articleBody = document.querySelector('.article-body[itemprop="articleBody"]');
  if(articleBody && 'IntersectionObserver' in window) {
    var trigger = document.createElement('div');
    trigger.style.cssText = 'height:0;overflow:hidden;';
    var children = articleBody.childNodes;
    var midIndex = Math.floor(children.length / 2);
    if(children[midIndex]) articleBody.insertBefore(trigger, children[midIndex]);
    else articleBody.appendChild(trigger);
    var io = new IntersectionObserver(function(entries) {
      if(entries[0].isIntersecting) { init(); io.unobserve(trigger); }
    }, { rootMargin: '300px 0px' });
    io.observe(trigger);
  } else {
    window.addEventListener('load', function() { setTimeout(init, 2000); });
  }
})(window.contentId);

// ===== 字級調整器（D-1）=====
(function() {
  var STORAGE_KEY = 'life-fs';
  var body = document.querySelector('.article-body[itemprop="articleBody"]');
  var btns = document.querySelectorAll('.font-size-toggle .share-btn[data-fs]');
  if(!body || !btns.length) return;

  var apply = function(level) {
    body.setAttribute('data-fs', level);
    btns.forEach(function(b) {
      b.setAttribute('aria-pressed', b.dataset.fs === level ? 'true' : 'false');
    });
    try { localStorage.setItem(STORAGE_KEY, level); } catch(e) {}
  };

  // 初始：localStorage > 預設 0
  var saved = '0';
  try { saved = localStorage.getItem(STORAGE_KEY) || '0'; } catch(e) {}
  if(['-1','0','1'].indexOf(saved) === -1) saved = '0';
  apply(saved);

  btns.forEach(function(b) {
    b.addEventListener('click', function() { apply(b.dataset.fs); });
  });
})();

// ===== 圖片 lightbox（D-3）=====
(function() {
  var body = document.querySelector('.article-body[itemprop="articleBody"]');
  if(!body) return;

  var overlay = null;
  var imgEl = null;
  var openLightbox = function(src, alt) {
    if(!overlay) {
      overlay = document.createElement('div');
      overlay.className = 'image-lightbox';
      overlay.setAttribute('role', 'dialog');
      overlay.setAttribute('aria-modal', 'true');
      overlay.innerHTML = '<button type="button" class="image-lightbox-close" aria-label="關閉">×</button><img alt="">';
      document.body.appendChild(overlay);
      imgEl = overlay.querySelector('img');
      var close = function() {
        overlay.classList.remove('active');
        document.body.style.overflow = '';
      };
      overlay.addEventListener('click', function(e) {
        if(e.target === overlay || e.target.classList.contains('image-lightbox-close')) close();
      });
      document.addEventListener('keydown', function(e) {
        if(e.key === 'Escape' && overlay.classList.contains('active')) close();
      });
    }
    imgEl.src = src;
    imgEl.alt = alt || '';
    overlay.classList.add('active');
    document.body.style.overflow = 'hidden';
  };

  body.addEventListener('click', function(e) {
    var t = e.target;
    if(t && t.tagName === 'IMG' && t.closest('.article-body')) {
      // 過濾 lazyload placeholder（src 是 data: 開頭，data-src 才是真的）
      var src = t.getAttribute('data-src') || t.src;
      if(src && !src.startsWith('data:')) {
        e.preventDefault();
        openLightbox(src, t.alt);
      }
    }
  });
})();

// ===== H2/H3 錨點點擊複製連結（D-2 補強）=====
(function() {
  var body = document.querySelector('.article-body[itemprop="articleBody"]');
  if(!body) return;
  body.addEventListener('click', function(e) {
    var a = e.target.closest('a.anchor-link');
    if(!a) return;
    e.preventDefault();
    var url = location.origin + location.pathname + location.search + a.getAttribute('href');
    history.replaceState(null, '', a.getAttribute('href'));
    if(navigator.clipboard) navigator.clipboard.writeText(url).catch(function(){});
    a.style.opacity = '1';
    setTimeout(function(){ a.style.opacity = ''; }, 800);
  });
})();
</script>
</main>

