ight="225" loading="lazy" fetchPriority="auto" class="absolute inset-0 w-full h-full object-cover object-center w-full rounded-lg object-cover object-center" data-state="default"/></div></div></a><a class="flex w-full flex-col gap-1" href="https://news.tvbs.com.tw/politics/3133505"><p class="h4-medium line-clamp-2 overflow-hidden text-ellipsis text-(--color-grey-950) lg:line-clamp-1">最美議員顏翎熹「激深V戰袍」火辣拜年！網全暴動跪求無碼版</p><p class="caption-14-medium hidden text-(--color-secondary) lg:line-clamp-1 lg:overflow-hidden lg:text-ellipsis">被譽為「全台最美議員」的嘉義市議員顏翎熹，今年春節期間誠意十足，從除夕到初五天天換上不同戰袍向選民拜年。然而，這系列賀歲影片卻意外引發「網路暴動」，原因是影片字幕位置正好擋在關鍵視覺區，讓大批網友看得心癢癢，崩潰直呼：「這字幕根本是多餘的！」</p><div class="flex flex-row gap-0.5"><span class="caption-12-medium text-(--color-secondary)">政治</span></div></a></div><!--astro:end--></astro-island><astro-island uid="2bvJRI" prefix="r87" component-url="https://news.tvbs.com.tw/assets/ArticleCard.D-9B7uW0.js" component-export="default" renderer-url="https://news.tvbs.com.tw/assets/client.CRYmKgjR.js" props="{&quot;title&quot;:[0,&quot;2026台灣燈會「三媽巡禮」今登場　限量平安符、小神衣這樣拿&quot;],&quot;image&quot;:[0,&quot;https://news-images.tvbs.com.tw/legacy/img/upload/2026/03/12/20260312103321-e8271f70.jpg&quot;],&quot;href&quot;:[0,&quot;https://news.tvbs.com.tw/life/3149045&quot;],&quot;shortTitle&quot;:[0,&quot;2026台灣燈會在嘉義驚喜不斷！今（12）日下午，嘉義縣政府特別邀請朴子配天宮、溪北六興宮、新港奉天宮的三位媽祖親自坐轎蒞臨燈會現場，感受璀璨時刻與熱鬧氛圍。現場也將發放限量加持結緣品，遊行路線怎麼走？限量結緣品如何領？《TVBS新聞網》帶您一次看。&quot;],&quot;category&quot;:[0,&quot;生活&quot;],&quot;youtubeVideoId&quot;:[0]}" ssr client="visible" opts="{&quot;name&quot;:&quot;ArticleCard&quot;,&quot;value&quot;:true}" await-children><div class="flex w-full flex-row gap-3 hover:opacity-60 active:opacity-60"><a class="w-full max-w-[132px] lg:max-w-[178px]" href="https://news.tvbs.com.tw/life/3149045"><div class="flex flex-col gap-2" data-component="image"><div class="relative w-full" style="aspect-ratio:400/225"><div class="bg-grey-500 absolute inset-0 opacity-30 w-full rounded-lg object-cover object-center" data-state="loading"></div><img src="https://news-images.tvbs.com.tw/legacy/img/upload/2026/03/12/20260312103321-e8271f70.jpg?w=400&amp;h=225" alt="2026台灣燈會「三媽巡禮」今登場　限量平安符、小神衣這樣拿" width="400" height="225" loading="lazy" fetchPriority="auto" class="absolute inset-0 w-full h-full object-cover object-center w-full rounded-lg object-cover object-center" data-state="default"/></div></div></a><a class="flex w-full flex-col gap-1" href="https://news.tvbs.com.tw/life/3149045"><p class="h4-medium line-clamp-2 overflow-hidden text-ellipsis text-(--color-grey-950) lg:line-clamp-1">2026台灣燈會「三媽巡禮」今登場　限量平安符、小神衣這樣拿</p><p class="caption-14-medium hidden text-(--color-secondary) lg:line-clamp-1 lg:overflow-hidden lg:text-ellipsis">2026台灣燈會在嘉義驚喜不斷！今（12）日下午，嘉義縣政府特別邀請朴子配天宮、溪北六興宮、新港奉天宮的三位媽祖親自坐轎蒞臨燈會現場，感受璀璨時刻與熱鬧氛圍。現場也將發放限量加持結緣品，遊行路線怎麼走？限量結緣品如何領？《TVBS新聞網》帶您一次看。</p><div class="flex flex-row gap-0.5"><span class="caption-12-medium text-(--color-secondary)">生活</span></div></a></div><!--astro:end--></astro-island><astro-island uid="Z2hOKC8" prefix="r88" component-url="https://news.tvbs.com.tw/assets/ArticleCard.D-9B7uW0.js" component-export="default" renderer-url="https://news.tvbs.com.tw/assets/client.CRYmKgjR.js" props="{&quot;title&quot;:[0,&quot;縣長都搶不到！嘉義燈會「瑪利歐？小提燈」遭喊價至1500元&quot;],&quot;image&quot;:[0,&quot;https://news-images.tvbs.com.tw/legacy/img/upload/2026/03/12/20260312094246-a214566e.jpg&quot;],&quot;href&quot;:[0,&quot;https://news.tvbs.com.tw/local/3148974&quot;],&quot;shortTitle&quot;:[0,&quot;2026年台灣燈會於嘉義縣盛大舉辦，此次與任天堂公司合作設置「超級瑪利歐區」燈區，限量「？磚塊小提燈」免費發送，吸引大量民眾搶領。但因數量有限，網路上出現高價轉售及疑似詐騙情形，最高黃牛價喊到1500元，嘉義縣政府呼籲民眾勿受騙，活動至3月15日止，僅於現場依規定發送，建議民眾循正規管道領取。&quot;],&quot;category&quot;:[0,&quot;社會&quot;],&quot;youtubeVideoId&quot;:[0]}" ssr client="visible" opts="{&quot;name&quot;:&quot;ArticleCard&quot;,&quot;value&quot;:true}" await-children><div class="flex w-full flex-row gap-3 hover:opacity-60 active:opacity-60"><a class="w-full max-w-[132px] lg:max-w-[178px]" href="https://news.tvbs.com.tw/local/3148974"><div class="flex flex-col gap-2" data-component="image"><div class="relative w-full" style="aspect-ratio:400/225"><div class="bg-grey-500 absolute inset-0 opacity-30 w-full rounded-lg object-cover object-center" data-state="loading"></div><img src="https://news-images.tvbs.com.tw/legacy/img/upload/2026/03/12/20260312094246-a214566e.jpg?w=400&amp;h=225" alt="縣長都搶不到！嘉義燈會「瑪利歐？小提燈」遭喊價至1500元" width="400" height="225" loading="lazy" fetchPriority="auto" class="absolute inset-0 w-full h-full object-cover object-center w-full rounded-lg object-cover object-center" data-state="default"/></div></div></a><a class="flex w-full flex-col gap-1" href="https://news.tvbs.com.tw/local/3148974"><p class="h4-medium line-clamp-2 overflow-hidden text-ellipsis text-(--color-grey-950) lg:line-clamp-1">縣長都搶不到！嘉義燈會「瑪利歐？小提燈」遭喊價至1500元</p><p class="caption-14-medium hidden text-(--color-secondary) lg:line-clamp-1 lg:overflow-hidden lg:text-ellipsis">2026年台灣燈會於嘉義縣盛大舉辦，此次與任天堂公司合作設置「超級瑪利歐區」燈區，限量「？磚塊小提燈」免費發送，吸引大量民眾搶領。但因數量有限，網路上出現高價轉售及疑似詐騙情形，最高黃牛價喊到1500元，嘉義縣政府呼籲民眾勿受騙，活動至3月15日止，僅於現場依規定發送，建議民眾循正規管道領取。</p><div class="flex flex-row gap-0.5"><span class="caption-12-medium text-(--color-secondary)">社會</span></div></a></div><!--astro:end--></astro-island><astro-island uid="Z1gd3yT" prefix="r89" component-url="https://news.tvbs.com.tw/assets/ArticleCard.D-9B7uW0.js" component-export="default" renderer-url="https://news.tvbs.com.tw/assets/client.CRYmKgjR.js" props="{&quot;title&quot;:[0,&quot;影音／台版「天外奇蹟」！整束氣球空中飄盪　嘉義燈會引騷動&quot;],&quot;image&quot;:[0,&quot;https://img.youtube.com/vi/E9YvPKsEMwM/maxresdefault.jpg&quot;],&quot;href&quot;:[0,&quot;https://news.tvbs.com.tw/life/3148840&quot;],&quot;shortTitle&quot;:[0,&quot;嘉義台灣燈會現場日前出現離奇一幕，一大束空飄氣球在空中飄盪，宛如電影《天外奇蹟》場景，引發民眾關注。經了解，原來是美食區攤商阿伯沒有將氣球綁牢，導致整串氣球全部飄走，光成本就損失約2萬元。這束氣球一路往南飛至台南學甲，最後降落在佳里區，消息傳開後，不僅有台南遊客特地隔天前來捧場，周圍攤商也紛紛伸出援手。&quot;],&quot;category&quot;:[0,&quot;生活&quot;],&quot;youtubeVideoId&quot;:[0,&quot;E9YvPKsEMwM&quot;]}" ssr client="visible" opts="{&quot;name&quot;:&quot;ArticleCard&quot;,&quot;value&quot;:true}" await-children><div class="flex w-full flex-row gap-3 hover:opacity-60 active:opacity-60"><a class="w-full max-w-[132px] lg:max-w-[178px]" href="https://news.tvbs.com.tw/life/3148840"><div class="relative aspect-video w-full"><div class="flex flex-col gap-2" data-component="image"><div class="relative w-full" style="aspect-ratio:400/225"><div class="bg-grey-500 absolute inset-0 opacity-30 w-full rounded-lg object-cover object-center" data-state="loading"></div><img src="https://img.youtube.com/vi/E9YvPKsEMwM/maxresdefault.jpg?w=400&amp;h=225" alt="影音／台版「天外奇蹟」！整束氣球空中飄盪　嘉義燈會引騷動" width="400" height="225" loading="lazy" fetchPriority="auto" class="absolute inset-0 w-full h-full object-cover object-center w-full rounded-lg object-cover object-center" data-state="default"/></div></div><div class="absolute inset-0 flex items-center justify-center"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 28 28" width="28" height="28"><path fill="#fff" d="M11 9.56a.56.56 0 0 1 .854-.476l6.83 4.202a.56.56 0 0 1 .033.932l-6.831 4.903a.56.56 0 0 1-.886-.455V9.56Z"></path><path fill="#fff" fill-rule="evenodd" d="M14 0c7.732 0 14 6.268 14 14s-6.268 14-14 14S0 21.732 0 14 6.268 0 14 0Zm0 2C7.373 2 2 7.373 2 14s5.373 12 12 12 12-5.373 12-12S20.627 2 14 2Z" clip-rule="evenodd"></path></svg></div></div></a><a class="flex w-full flex-col gap-1" href="https://news.tvbs.com.tw/life/3148840"><p class="h4-medium line-clamp-2 overflow-hidden text-ellipsis text-(--color-grey-950) lg:line-clamp-1">影音／台版「天外奇蹟」！整束氣球空中飄盪　嘉義燈會引騷動</p><p class="caption-14-medium hidden text-(--color-secondary) lg:line-clamp-1 lg:overflow-hidden lg:text-ellipsis">嘉義台灣燈會現場日前出現離奇一幕，一大束空飄氣球在空中飄盪，宛如電影《天外奇蹟》場景，引發民眾關注。經了解，原來是美食區攤商阿伯沒有將氣球綁牢，導致整串氣球全部飄走，光成本就損失約2萬元。這束氣球一路往南飛至台南學甲，最後降落在佳里區，消息傳開後，不僅有台南遊客特地隔天前來捧場，周圍攤商也紛紛伸出援手。</p><div class="flex flex-row gap-0.5"><span class="caption-12-medium text-(--color-secondary)">生活</span></div></a></div><!--astro:end--></astro-island><astro-island uid="ZtR4h7" prefix="r90" component-url="https://news.tvbs.com.tw/assets/ArticleCard.D-9B7uW0.js" component-export="default" renderer-url="https://news.tvbs.com.tw/assets/client.CRYmKgjR.js" props="{&quot;title&quot;:[0,&quot;徵召李四川戰新北市長！鄭麗文示警1事：國民黨不能靠勢&quot;],&quot;image&quot;:[0,&quot;https://news-images.tvbs.com.tw/legacy/img/upload/2026/03/11/20260311153435-2518ed2f.jpg&quot;],&quot;href&quot;:[0,&quot;https://news.tvbs.com.tw/politics/3148143&quot;],&quot;shortTitle&quot;:[0,&quot;佈局2026年底九合一大選，新北市長選戰部分，民進黨確定派出立委蘇巧慧，民眾黨推派黨主席黃國昌出戰。國民黨今（11）日下午將在中常會正式徵召台北市前副市長李四川征戰新北、立委吳宗憲參選宜蘭縣長，此外，嘉義市長部分，國民黨也可望徵召醫師翁壽良參戰。&quot;],&quot;category&quot;:[0,&quot;政治&quot;],&quot;youtubeVideoId&quot;:[0]}" ssr client="visible" opts="{&quot;name&quot;:&quot;ArticleCard&quot;,&quot;value&quot;:true}" await-children><div class="flex w-full flex-row gap-3 hover:opacity-60 active:opacity-60"><a class="w-full max-w-[132px] lg:max-w-[178px]" href="https://news.tvbs.com.tw/politics/3148143"><div class="flex flex-col gap-2" data-component="image"><div class="relative w-full" style="aspect-ratio:400/225"><div class="bg-grey-500 absolute inset-0 opacity-30 w-full rounded-lg object-cover object-center" data-state="loading"></div><img src="https://news-images.tvbs.com.tw/legacy/img/upload/2026/03/11/20260311153435-2518ed2f.jpg?w=400&amp;h=225" alt="徵召李四川戰新北市長！鄭麗文示警1事：國民黨不能靠勢" width="400" height="225" loading="lazy" fetchPriority="auto" class="absolute inset-0 w-full h-full object-cover object-center w-full rounded-lg object-cover object-center" data-state="default"/></div></div></a><a class="flex w-full flex-col gap-1" href="https://news.tvbs.com.tw/politics/3148143"><p class="h4-medium line-clamp-2 overflow-hidden text-ellipsis text-(--color-grey-950) lg:line-clamp-1">徵召李四川戰新北市長！鄭麗文示警1事：國民黨不能靠勢</p><p class="caption-14-medium hidden text-(--color-secondary) lg:line-clamp-1 lg:overflow-hidden lg:text-ellipsis">佈局2026年底九合一大選，新北市長選戰部分，民進黨確定派出立委蘇巧慧，民眾黨推派黨主席黃國昌出戰。國民黨今（11）日下午將在中常會正式徵召台北市前副市長李四川征戰新北、立委吳宗憲參選宜蘭縣長，此外，嘉義市長部分，國民黨也可望徵召醫師翁壽良參戰。</p><div class="flex flex-row gap-0.5"><span class="caption-12-medium text-(--color-secondary)">政治</span></div></a></div><!--astro:end--></astro-island><astro-island uid="z7ibk" prefix="r91" component-url="https://news.tvbs.com.tw/assets/ArticleCard.D-9B7uW0.js" component-export="default" renderer-url="https://news.tvbs.com.tw/assets/client.CRYmKgjR.js" props="{&quot;title&quot;:[0,&quot;白天賞花、晚上看燈　嘉義瑞里紫藤花季登場&quot;],&quot;image&quot;:[0,&quot;https://img.youtube.com/vi/9zTL1tKZ4yc/maxresdefault.jpg&quot;],&quot;href&quot;:[0,&quot;https://news.tvbs.com.tw/life/3147296&quot;],&quot;shortTitle&quot;:[0,&quot;春天氣息漸濃，又到了嘉義縣瑞里紫藤花季。今年縣府特別將山區花季與台灣燈會連結，打造白天賞花，晚上看燈的觀光動線。代言人大久保麻梨子出席記者會，回憶起曾在紫藤花下許願「找到好姻緣」，願望成真，也邀請民眾一起到嘉義看看浪漫花海。&quot;],&quot;category&quot;:[0,&quot;生活&quot;],&quot;youtubeVideoId&quot;:[0,&quot;9zTL1tKZ4yc&quot;]}" ssr client="visible" opts="{&quot;name&quot;:&quot;ArticleCard&quot;,&quot;value&quot;:true}" await-children><div class="flex w-full flex-row gap-3 hover:opacity-60 active:opacity-60"><a class="w-full max-w-[132px] lg:max-w-[178px]" href="https://news.tvbs.com.tw/life/3147296"><div class="relative aspect-video w-full"><div class="flex flex-col gap-2" data-component="image"><div class="relative w-full" style="aspect-ratio:400/225"><div class="bg-grey-500 absolute inset-0 opacity-30 w-full rounded-lg object-cover object-center" data-state="loading"></div><img src="https://img.youtube.com/vi/9zTL1tKZ4yc/maxresdefault.jpg?w=400&amp;h=225" alt="白天賞花、晚上看燈　嘉義瑞里紫藤花季登場" width="400" height="225" loading="lazy" fetchPriority="auto" class="absolute inset-0 w-full h-full object-cover object-center w-full rounded-lg object-cover object-center" data-state="default"/></div></div><div class="absolute inset-0 flex items-center justify-center"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 28 28" width="28" height="28"><path fill="#fff" d="M11 9.56a.56.56 0 0 1 .854-.476l6.83 4.202a.56.56 0 0 1 .033.932l-6.831 4.903a.56.56 0 0 1-.886-.455V9.56Z"></path><path fill="#fff" fill-rule="evenodd" d="M14 0c7.732 0 14 6.268 14 14s-6.268 14-14 14S0 21.732 0 14 6.268 0 14 0Zm0 2C7.373 2 2 7.373 2 14s5.373 12 12 12 12-5.373 12-12S20.627 2 14 2Z" clip-rule="evenodd"></path></svg></div></div></a><a class="flex w-full flex-col gap-1" href="https://news.tvbs.com.tw/life/3147296"><p class="h4-medium line-clamp-2 overflow-hidden text-ellipsis text-(--color-grey-950) lg:line-clamp-1">白天賞花、晚上看燈　嘉義瑞里紫藤花季登場</p><p class="caption-14-medium hidden text-(--color-secondary) lg:line-clamp-1 lg:overflow-hidden lg:text-ellipsis">春天氣息漸濃，又到了嘉義縣瑞里紫藤花季。今年縣府特別將山區花季與台灣燈會連結，打造白天賞花，晚上看燈的觀光動線。代言人大久保麻梨子出席記者會，回憶起曾在紫藤花下許願「找到好姻緣」，願望成真，也邀請民眾一起到嘉義看看浪漫花海。</p><div class="flex flex-row gap-0.5"><span class="caption-12-medium text-(--color-secondary)">生活</span></div></a></div><!--astro:end--></astro-island><astro-island uid="Z1xRXv9" prefix="r92" component-url="https://news.tvbs.com.tw/assets/ArticleCard.D-9B7uW0.js" component-export="default" renderer-url="https://news.tvbs.com.tw/assets/client.CRYmKgjR.js" props="{&quot;title&quot;:[0,&quot;影音／白天賞花夜晚看燈！2026嘉義瑞里紫藤花季開跑　串聯燈會推慢旅&quot;],&quot;image&quot;:[0,&quot;https://img.youtube.com/vi/9zTL1tKZ4yc/maxresdefault.jpg&quot;],&quot;href&quot;:[0,&quot;https://news.tvbs.com.tw/life/3147421&quot;],&quot;shortTitle&quot;:[0,&quot;春意漸濃，嘉義縣梅山鄉瑞里村迎來一年一度的紫藤花季。嘉義縣政府宣布，2026年瑞里紫藤花季自3月10日至3月31日登場，目前花況約開三至四成，隨著氣溫回升，預計花況將逐漸綻放，進入最佳賞花期。縣府也特別結合今年在嘉義舉辦的台灣燈會活動，規劃「白天賞花、晚上賞燈」的觀光動線，邀請民眾走進山林，感受春季限定的浪漫景致。&quot;],&quot;category&quot;:[0,&quot;生活&quot;],&quot;youtubeVideoId&quot;:[0,&quot;9zTL1tKZ4yc&quot;]}" ssr client="visible" opts="{&quot;name&quot;:&quot;ArticleCard&quot;,&quot;value&quot;:true}" await-children><div class="flex w-full flex-row gap-3 hover:opacity-60 active:opacity-60"><a class="w-full max-w-[132px] lg:max-w-[178px]" href="https://news.tvbs.com.tw/life/3147421"><div class="relative aspect-video w-full"><div class="flex flex-col gap-2" data-component="image"><div class="relative w-full" style="aspect-ratio:400/225"><div class="bg-grey-500 absolute inset-0 opacity-30 w-full rounded-lg object-cover object-center" data-state="loading"></div><img src="https://img.youtube.com/vi/9zTL1tKZ4yc/maxresdefault.jpg?w=400&amp;h=225" alt="影音／白天賞花夜晚看燈！2026嘉義瑞里紫藤花季開跑　串聯燈會推慢旅" width="400" height="225" loading="lazy" fetchPriority="auto" class="absolute inset-0 w-full h-full object-cover object-center w-full rounded-lg object-cover object-center" data-state="default"/></div></div><div class="absolute inset-0 flex items-center justify-center"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 28 28" width="28" height="28"><path fill="#fff" d="M11 9.56a.56.56 0 0 1 .854-.476l6.83 4.202a.56.56 0 0 1 .033.932l-6.831 4.903a.56.56 0 0 1-.886-.455V9.56Z"></path><path fill="#fff" fill-rule="evenodd" d="M14 0c7.732 0 14 6.268 14 14s-6.268 14-14 14S0 21.732 0 14 6.268 0 14 0Zm0 2C7.373 2 2 7.373 2 14s5.373 12 12 12 12-5.373 12-12S20.627 2 14 2Z" clip-rule="evenodd"></path></svg></div></div></a><a class="flex w-full flex-col gap-1" href="https://news.tvbs.com.tw/life/3147421"><p class="h4-medium line-clamp-2 overflow-hidden text-ellipsis text-(--color-grey-950) lg:line-clamp-1">影音／白天賞花夜晚看燈！2026嘉義瑞里紫藤花季開跑　串聯燈會推慢旅</p><p class="caption-14-medium hidden text-(--color-secondary) lg:line-clamp-1 lg:overflow-hidden lg:text-ellipsis">春意漸濃，嘉義縣梅山鄉瑞里村迎來一年一度的紫藤花季。嘉義縣政府宣布，2026年瑞里紫藤花季自3月10日至3月31日登場，目前花況約開三至四成，隨著氣溫回升，預計花況將逐漸綻放，進入最佳賞花期。縣府也特別結合今年在嘉義舉辦的台灣燈會活動，規劃「白天賞花、晚上賞燈」的觀光動線，邀請民眾走進山林，感受春季限定的浪漫景致。</p><div class="flex flex-row gap-0.5"><span class="caption-12-medium text-(--color-secondary)">生活</span></div></a></div><!--astro:end--></astro-island><astro-island uid="ZCGzPc" prefix="r93" component-url="https://news.tvbs.com.tw/assets/ArticleCard.D-9B7uW0.js" component-export="default" renderer-url="https://news.tvbs.com.tw/assets/client.CRYmKgjR.js" props="{&quot;title&quot;:[0,&quot;嘉義退學生闖校園揮刀　校安制伏遭「割肉濺血」師生嚇逃&quot;],&quot;image&quot;:[0,&quot;https://news-images.tvbs.com.tw/legacy/img/upload/2026/03/09/20260309151419-1eec851b.jpg&quot;],&quot;href&quot;:[0,&quot;https://news.tvbs.com.tw/local/3146249&quot;],&quot;shortTitle&quot;:[0,&quot;嘉義縣大林鎮一所學校今（9日）上午，一名17歲的退學少年穿著舊校服潛入校園，在教學大樓地下室持刀叫囂並揮舞，過程中一名校安人員在制伏少年時大拇指遭割傷，所幸並未造成其他師生受傷。警方接獲通報後已將少年帶回偵訊，全案將依傷害、恐嚇危害安全罪方向偵辦。&quot;],&quot;category&quot;:[0,&quot;社會&quot;],&quot;youtubeVideoId&quot;:[0]}" ssr client="visible" opts="{&quot;name&quot;:&quot;ArticleCard&quot;,&quot;value&quot;:true}" await-children><div class="flex w-full flex-row gap-3 hover:opacity-60 active:opacity-60"><a class="w-full max-w-[132px] lg:max-w-[178px]" href="https://news.tvbs.com.tw/local/3146249"><div class="flex flex-col gap-2" data-component="image"><div class="relative w-full" style="aspect-ratio:400/225"><div class="bg-grey-500 absolute inset-0 opacity-30 w-full rounded-lg object-cover object-center" data-state="loading"></div><img src="https://news-images.tvbs.com.tw/legacy/img/upload/2026/03/09/20260309151419-1eec851b.jpg?w=400&amp;h=225" alt="嘉義退學生闖校園揮刀　校安制伏遭「割肉濺血」師生嚇逃" width="400" height="225" loading="lazy" fetchPriority="auto" class="absolute inset-0 w-full h-full object-cover object-center w-full rounded-lg object-cover object-center" data-state="default"/></div></div></a><a class="flex w-full flex-col gap-1" href="https://news.tvbs.com.tw/local/3146249"><p class="h4-medium line-clamp-2 overflow-hidden text-ellipsis text-(--color-grey-950) lg:line-clamp-1">嘉義退學生闖校園揮刀　校安制伏遭「割肉濺血」師生嚇逃</p><p class="caption-14-medium hidden text-(--color-secondary) lg:line-clamp-1 lg:overflow-hidden lg:text-ellipsis">嘉義縣大林鎮一所學校今（9日）上午，一名17歲的退學少年穿著舊校服潛入校園，在教學大樓地下室持刀叫囂並揮舞，過程中一名校安人員在制伏少年時大拇指遭割傷，所幸並未造成其他師生受傷。警方接獲通報後已將少年帶回偵訊，全案將依傷害、恐嚇危害安全罪方向偵辦。</p><div class="flex flex-row gap-0.5"><span class="caption-12-medium text-(--color-secondary)">社會</span></div></a></div><!--astro:end--></astro-island><astro-island uid="Zd7Whb" prefix="r94" component-url="https://news.tvbs.com.tw/assets/ArticleCard.D-9B7uW0.js" component-export="default" renderer-url="https://news.tvbs.com.tw/assets/client.CRYmKgjR.js" props="{&quot;title&quot;:[0,&quot;影音／嘉義燈會爆意外！5歲女童摔溝乾媽肉身護　眾人遞被救援&quot;],&quot;image&quot;:[0,&quot;https://img.youtube.com/vi/tKKvipONxp0/maxresdefault.jpg&quot;],&quot;href&quot;:[0,&quot;https://news.tvbs.com.tw/local/3145553&quot;],&quot;shortTitle&quot;:[0,&quot;嘉義燈會首個周末假日，人潮單日就破了200萬人次，人車大爆量，結果7號晚間就發生意外了，有家長帶著五歲女童跟孩子乾媽一起逛燈會，不小心摔落沒有防護的水溝裡，就連身上的手機也摔溝，眾人紛紛上前伸援手，讓女童媽媽好感動，事後PO文致謝，也提醒大家逛燈會要注意腳邊。&quot;],&quot;category&quot;:[0,&quot;社會&quot;],&quot;youtubeVideoId&quot;:[0,&quot;tKKvipONxp0&quot;]}" ssr client="visible" opts="{&quot;name&quot;:&quot;ArticleCard&quot;,&quot;value&quot;:true}" await-children><div class="flex w-full flex-row gap-3 hover:opacity-60 active:opacity-60"><a class="w-full max-w-[132px] lg:max-w-[178px]" href="https://news.tvbs.com.tw/local/3145553"><div class="relative aspect-video w-full"><div class="flex flex-col gap-2" data-component="image"><div class="relative w-full" style="aspect-ratio:400/225"><div class="bg-grey-500 absolute inset-0 opacity-30 w-full rounded-lg object-cover object-center" data-state="loading"></div><img src="https://img.youtube.com/vi/tKKvipONxp0/maxresdefault.jpg?w=400&amp;h=225" alt="影音／嘉義燈會爆意外！5歲女童摔溝乾媽肉身護　眾人遞被救援" width="400" height="225" loading="lazy" fetchPriority="auto" class="absolute inset-0 w-full h-full object-cover object-center w-full rounded-lg object-cover object-center" data-state="default"/></div></div><div class="absolute inset-0 flex items-center justify-center"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 28 28" width="28" height="28"><path fill="#fff" d="M11 9.56a.56.56 0 0 1 .854-.476l6.83 4.202a.56.56 0 0 1 .033.932l-6.831 4.903a.56.56 0 0 1-.886-.455V9.56Z"></path><path fill="#fff" fill-rule="evenodd" d="M14 0c7.732 0 14 6.268 14 14s-6.268 14-14 14S0 21.732 0 14 6.268 0 14 0Zm0 2C7.373 2 2 7.373 2 14s5.373 12 12 12 12-5.373 12-12S20.627 2 14 2Z" clip-rule="evenodd"></path></svg></div></div></a><a class="flex w-full flex-col gap-1" href="https://news.tvbs.com.tw/local/3145553"><p class="h4-medium line-clamp-2 overflow-hidden text-ellipsis text-(--color-grey-950) lg:line-clamp-1">影音／嘉義燈會爆意外！5歲女童摔溝乾媽肉身護　眾人遞被救援</p><p class="caption-14-medium hidden text-(--color-secondary) lg:line-clamp-1 lg:overflow-hidden lg:text-ellipsis">嘉義燈會首個周末假日，人潮單日就破了200萬人次，人車大爆量，結果7號晚間就發生意外了，有家長帶著五歲女童跟孩子乾媽一起逛燈會，不小心摔落沒有防護的水溝裡，就連身上的手機也摔溝，眾人紛紛上前伸援手，讓女童媽媽好感動，事後PO文致謝，也提醒大家逛燈會要注意腳邊。</p><div class="flex flex-row gap-0.5"><span class="caption-12-medium text-(--color-secondary)">社會</span></div></a></div><!--astro:end--></astro-island><astro-island uid="Z2e06he" prefix="r95" component-url="https://news.tvbs.com.tw/assets/ArticleCard.D-9B7uW0.js" component-export="default" renderer-url="https://news.tvbs.com.tw/assets/client.CRYmKgjR.js" props="{&quot;title&quot;:[0,&quot;台積電嘉義廠工安釀2死多傷！包商請神鎮煞「這原因」仍不停工&quot;],&quot;image&quot;:[0,&quot;https://news-images.tvbs.com.tw/legacy/img/upload/2025/09/30/20250930225232-333ad354.jpg&quot;],&quot;href&quot;:[0,&quot;https://news.tvbs.com.tw/local/3145336&quot;],&quot;shortTitle&quot;:[0,&quot;嘉義科學園區內的「台積電先進封裝廠AP7廠區」自開工以來，接連發生多起工安意外，備受外界關注。去年5月起，因施工期間挖到人骨遺骸，陸續發生2死5重傷等事故，外包商雖請來關公及地藏王祈福鎮煞，卻未見明顯改善。近日又接連3起工安事件，但因未達職安法通報標準，南科管理局遂未要求停工，現場仍照常施工，頻繁意外引發傳聞，更進一步導致現場施工氛圍緊張。 &quot;],&quot;category&quot;:[0,&quot;社會&quot;],&quot;youtubeVideoId&quot;:[0]}" ssr client="visible" opts="{&quot;name&quot;:&quot;ArticleCard&quot;,&quot;value&quot;:true}" await-children><div class="flex w-full flex-row gap-3 hover:opacity-60 active:opacity-60"><a class="w-full max-w-[132px] lg:max-w-[178px]" href="https://news.tvbs.com.tw/local/3145336"><div class="flex flex-col gap-2" data-component="image"><div class="relative w-full" style="aspect-ratio:400/225"><div class="bg-grey-500 absolute inset-0 opacity-30 w-full rounded-lg object-cover object-center" data-state="loading"></div><img src="https://news-images.tvbs.com.tw/legacy/img/upload/2025/09/30/20250930225232-333ad354.jpg?w=400&amp;h=225" alt="台積電嘉義廠工安釀2死多傷！包商請神鎮煞「這原因」仍不停工" width="400" height="225" loading="lazy" fetchPriority="auto" class="absolute inset-0 w-full h-full object-cover object-center w-full rounded-lg object-cover object-center" data-state="default"/></div></div></a><a class="flex w-full flex-col gap-1" href="https://news.tvbs.com.tw/local/3145336"><p class="h4-medium line-clamp-2 overflow-hidden text-ellipsis text-(--color-grey-950) lg:line-clamp-1">台積電嘉義廠工安釀2死多傷！包商請神鎮煞「這原因」仍不停工</p><p class="caption-14-medium hidden text-(--color-secondary) lg:line-clamp-1 lg:overflow-hidden lg:text-ellipsis">嘉義科學園區內的「台積電先進封裝廠AP7廠區」自開工以來，接連發生多起工安意外，備受外界關注。去年5月起，因施工期間挖到人骨遺骸，陸續發生2死5重傷等事故，外包商雖請來關公及地藏王祈福鎮煞，卻未見明顯改善。近日又接連3起工安事件，但因未達職安法通報標準，南科管理局遂未要求停工，現場仍照常施工，頻繁意外引發傳聞，更進一步導致現場施工氛圍緊張。 </p><div class="flex flex-row gap-0.5"><span class="caption-12-medium text-(--color-secondary)">社會</span></div></a></div><!--astro:end--></astro-island></div></div></div><div class="w-full px-4 pb-4 lg:hidden"><div class="flex h-[280px] w-full items-center justify-center"><div id="news_m_read_d4"></div></div></div><div class="w-full px-4 lg:px-0 lg:pt-4"><!-- Taboola Neo Others Reading Below Article Stream --><div class="h-[1164px] w-full lg:h-[748px]"><div><div id="taboola-neo-others-reading-below-article-stream"></div></div><script>(function(){const mode = "alternating-stream-neo-other";
