<script>var CCMS_WWWURL='https://www.suao.gov.tw';var CCMS_LanguageSN=1;var CCMS_SitesSN_Encryption='457';</script><script src='https://www.suao.gov.tw/Scripts/core.min.js'></script><script src='https://www.suao.gov.tw/Scripts/jquery.lazy.min.js'></script><script src='https://www.suao.gov.tw/Scripts/jquery.lazy.plugins.min.js'></script><script src='https://www.suao.gov.tw/Scripts/jquery.cookie.js'></script><script src='https://www.suao.gov.tw/Scripts/jUtil.js'></script><script src='https://www.suao.gov.tw/Scripts/fancybox/jquery.fancybox.js'></script><script src='https://www.suao.gov.tw/Scripts/hamalightGallery/hamalightGallery.js'></script><script src='https://www.suao.gov.tw/Scripts/J_Pager.js'></script><script  src='https://www.suao.gov.tw/Scripts/Chart/chart.js'></script><script  src='https://www.suao.gov.tw/Scripts/Chart/chartjs-plugin-datalabels.js'></script><script  src='https://www.suao.gov.tw/Scripts/chart.js'></script><script  src='https://www.suao.gov.tw/Scripts/jquery.mousewheel.min.js'></script><script  src='https://www.suao.gov.tw/Scripts/jquery.touchwipe.min.js'></script><script  src='https://www.suao.gov.tw/js/airdatepicker/datepicker.min.js'></script><script  src='https://www.suao.gov.tw/js/airdatepicker/datepicker.zh-tw.js'></script><script  src='https://www.suao.gov.tw/js/airdatepicker/datepicker.en.js'></script><script src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit1"></script><script type="application/ld+json">{   "@context": "http://schema.org",   "@type": "NewsArticle",   "headline": "歐主席進義",   "dateCreated": "2025-02-11T01:45:41+08:00",   "datePublished": "2025-02-11T01:45:41+08:00",   "description": "蘇澳鎮民代表會代表基本資料姓名：歐進義&amp;nbsp;職稱：主席&amp;nbsp;服務電話：0932090778服務地址：蘇澳鎮聖湖里聖賢路13巷8號經歷：蘇澳鎮民代表會第19、21屆主席。蘇澳港國際青年商會2002年會長。蘇澳港國際青年商會OB會主席。觀光小鎮發展協會理事長。蘇澳港同濟會會長。蘇澳體育會登山會副會長。蘇澳國中、永樂國小家長會長。蘇澳南順宮、福安宮、武荖坑五路財神爺廟、聖湖箕山宮主委。政見：進義知道每個選舉，都是鄉親們情義相挺，囑咐一步一腳印為民服務，長久以來進義從未改變初衷，服務奉獻，用心愛鄉土，至始至終未曾改變。顧好鎮政、看好蘇澳，打造觀光亮點，帶動商機。我以甘願用心、打拼新蘇澳，一起為我們代代子孫努力。"}</script><script type="text/javascript" src="Scripts/Accessibility.js"></script><script type="text/javascript" src="Scripts/jHandicapFree.js"></script><script type="text/javascript" src="Scripts/JAutoGenerateTableTH.js"></script><script>
        var $a = $('.for_accessibility a');
        $a.on('click', function (evt) {
            var $href = $($(this).attr('href')),
                $target = $href.find('a').eq(0).get(0);
            setTimeout(function () { try { $target.focus(); } catch (e) { } }, 0);
        });
    </script><script >
