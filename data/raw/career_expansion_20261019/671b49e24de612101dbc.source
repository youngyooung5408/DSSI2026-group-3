aria-checked="false" data-state="unchecked" value="6000" class="inline-flex min-w-ds-16 cursor-pointer items-center justify-center rounded-ds-1-5 border border-solid px-ds-3-5 py-ds-2-5 text-center text-ds-label-md transition-colors border-ds-border-primary bg-ds-bg-primary text-ds-content-primary hover:bg-ds-bg-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ds-border-brand data-[state=checked]:rounded-ds-2 data-[state=checked]:border-ds-border-brand data-[state=checked]:bg-ds-bg-brand-primary/10 data-[state=checked]:text-ds-content-brand data-disabled:cursor-not-allowed data-disabled:bg-ds-bg-disabled data-disabled:text-ds-content-disabled data-[state=checked]:border-[var(--themeColorBright)] data-[state=checked]:bg-[var(--themeColorBright)]/10 data-[state=checked]:text-[var(--themeColorBright)]" data-cy="donate-amount-6000" tabindex="-1" data-radix-collection-item=""><span translate="no" class="notranslate">NT$ 6,000</span></button><input type="radio" aria-hidden="true" style="transform:translateX(-100%);position:absolute;pointer-events:none;opacity:0;margin:0" tabindex="-1" value="6000"/><button type="button" role="radio" aria-checked="false" data-state="unchecked" value="12000" class="inline-flex min-w-ds-16 cursor-pointer items-center justify-center rounded-ds-1-5 border border-solid px-ds-3-5 py-ds-2-5 text-center text-ds-label-md transition-colors border-ds-border-primary bg-ds-bg-primary text-ds-content-primary hover:bg-ds-bg-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ds-border-brand data-[state=checked]:rounded-ds-2 data-[state=checked]:border-ds-border-brand data-[state=checked]:bg-ds-bg-brand-primary/10 data-[state=checked]:text-ds-content-brand data-disabled:cursor-not-allowed data-disabled:bg-ds-bg-disabled data-disabled:text-ds-content-disabled data-[state=checked]:border-[var(--themeColorBright)] data-[state=checked]:bg-[var(--themeColorBright)]/10 data-[state=checked]:text-[var(--themeColorBright)]" data-cy="donate-amount-12000" tabindex="-1" data-radix-collection-item=""><span translate="no" class="notranslate">NT$ 12,000</span></button><input type="radio" aria-hidden="true" style="transform:translateX(-100%);position:absolute;pointer-events:none;opacity:0;margin:0" tabindex="-1" value="12000"/></div><input type="text" inputMode="numeric" class="w-full rounded-md border border-ds-border-primary bg-ds-bg-primary px-4 py-2 text-ds-body-md text-ds-content-primary placeholder:text-ds-content-tertiary focus:border-[var(--themeColorBright)] focus:outline-none disabled:opacity-50" placeholder="或自行輸入金額" data-cy="donate-custom-amount-input" value=""/><button type="button" class="cursor-pointer inline-flex items-center justify-center whitespace-nowrap rounded-md font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ds-border-brand focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 data-[loading=true]:pointer-events-none data-[loading=true]:opacity-100 data-[loading=true]:overflow-hidden data-[loading=true]:relative bg-ds-bg-brand-primary text-ds-content-on-color hover:bg-ds-bg-brand-primary-hover active:bg-ds-bg-brand-primary-active text-ds-label-md gap-ds-2 w-full min-w-ds-16 px-ds-3-5 py-ds-2-5" style="--ds-theme-primary:var(--themeColorBright)" data-cy="donate-submit"><span class="inline-flex min-w-0 items-center justify-center gap-[inherit]"><span class="truncate">立即捐款</span></span></button></div></section><section class="infoBox oenPage__section"><div class="data"><div class="info " data-cy="profile-info-item" lang="zh-TW"><h2 data-cy="profile-info-item-title">請讓無黨青年，為您守護大新店的未來!</h2><div class="content ql-editor" data-cy="profile-info-content" style="padding-left:0;padding-right:0"><div><h2><span style="background-color: rgb(247, 247, 247); color: rgb(0, 0, 0);">過去在調查局工作的8年，讓我深刻體會到一件事：打擊犯罪雖然很重要，但真正能改善民眾生活的，是基礎建設是否到位、政策是否貼近人民的生活，因此今年我決定參選市議員，我要更全面地為民眾服務。</span></h2></div></div><div class="youtubeBox " data-cy="youtube-box"><iframe class="youtubeBox-frame" title="oeF_3qOIEUs" frameBorder="0" scrolling="no" marginHeight="0" marginWidth="0" type="text/html" src="https://www.youtube.com/embed/oeF_3qOIEUs?#autoplay=0&amp;fs=1&amp;iv_load_policy=3&amp;showinfo=0&amp;rel=0&amp;cc_load_policy=0&amp;start=0&amp;end=0" allowfullscreen=""></iframe></div></div><div class="info " data-cy="profile-info-item" lang="zh-TW"><h2 data-cy="profile-info-item-title">現代化市場</h2><div class="content ql-editor" data-cy="profile-info-content" style="padding-left:0;padding-right:0"><div><h2><span style="color: rgb(0, 0, 0); background-color: rgb(247, 247, 247);">●</span><span style="color: rgba(0,0,0,var(--O42jJQ,1));">推動建國游泳池改建成室內市場，從根本解決建國仁愛市場人車爭道、環境老舊、攤商占用人行道嚴重問題</span></h2><h2><span style="color: rgb(0, 0, 0); background-color: rgb(247, 247, 247);">●</span><span style="color: rgba(0,0,0,var(--O42jJQ,1));">打造安坑傳統市場，讓安康公有市場不再只有連鎖超市。</span></h2></div></div><div class="youtubeBox " data-cy="youtube-box"><iframe class="youtubeBox-frame" title="toTQmxeDiOM" frameBorder="0" scrolling="no" marginHeight="0" marginWidth="0" type="text/html" src="https://www.youtube.com/embed/toTQmxeDiOM?#autoplay=0&amp;fs=1&amp;iv_load_policy=3&amp;showinfo=0&amp;rel=0&amp;cc_load_policy=0&amp;start=0&amp;end=0" allowfullscreen=""></iframe></div></div><div class="info " data-cy="profile-info-item" lang="zh-TW"><h2 data-cy="profile-info-item-title">有趣新碧潭(水上遊樂園)</h2><div class="content ql-editor" data-cy="profile-info-content" style="padding-left:0;padding-right:0"><div><h2 class="ql-align-justify"><strong style="background-color: rgb(247, 247, 247); color: rgb(0, 0, 0);">●</strong><span style="color: rgba(0,0,0,var(--O42jJQ,1));">推動碧潭河岸引入SUP、獨木舟、充氣式水上遊樂設施等業者，讓碧潭不再只有一成不變的天鵝船。</span></h2></div></div><div class="youtubeBox " data-cy="youtube-box"><iframe class="youtubeBox-frame" title="QJJ3o_2xToI" frameBorder="0" scrolling="no" marginHeight="0" marginWidth="0" type="text/html" src="https://www.youtube.com/embed/QJJ3o_2xToI?#autoplay=0&amp;fs=1&amp;iv_load_policy=3&amp;showinfo=0&amp;rel=0&amp;cc_load_policy=0&amp;start=0&amp;end=0" allowfullscreen=""></iframe></div></div><div class="info " data-cy="profile-info-item" lang="zh-TW"><h2 data-cy="profile-info-item-title">有趣新碧潭(文創假日市集)</h2><div class="content ql-editor" data-cy="profile-info-content" style="padding-left:0;padding-right:0"><div><h2 class="ql-align-justify"><strong style="color: rgb(0, 0, 0); background-color: rgb(247, 247, 247);">●</strong><span style="color: rgba(0,0,0,var(--O42jJQ,1));">打造碧潭常態性假日文創市集，提供在地青年租金優惠，讓碧潭成為民眾可以逛市集，在地青年可以創業的逐夢基地。</span></h2></div></div><div class="youtubeBox " data-cy="youtube-box"><iframe class="youtubeBox-frame" title="VR_4iz0yaI8" frameBorder="0" scrolling="no" marginHeight="0" marginWidth="0" type="text/html" src="https://www.youtube.com/embed/VR_4iz0yaI8?#autoplay=0&amp;fs=1&amp;iv_load_policy=3&amp;showinfo=0&amp;rel=0&amp;cc_load_policy=0&amp;start=0&amp;end=0" allowfullscreen=""></iframe></div></div><div class="info " data-cy="profile-info-item" lang="zh-TW"><h2 data-cy="profile-info-item-title">國中學區升級</h2><div class="content ql-editor" data-cy="profile-info-content" style="padding-left:0;padding-right:0"><div><h2 class="ql-align-justify"><strong style="color: rgb(0, 0, 0); background-color: rgb(247, 247, 247);">●</strong><span style="color: rgba(0,0,0,var(--O42jJQ,1));">推動國中雙語教育融入更多課程、爭取專業師資成立數理資優班、改善老舊校舍，提␀升孩童國際觀與競爭力。</span></h2><h2 class="ql-align-justify"><strong style="color: rgb(0, 0, 0); background-color: rgb(247, 247, 247);">●</strong><span style="color: rgba(0,0,0,var(--O42jJQ,1));">解決新店區國中在地就學率偏低，需要跨區或跨市讀書的問題，讓新店的孩子國中都能留在新店念書。</span></h2></div></div><div class="youtubeBox " data-cy="youtube-box"><iframe class="youtubeBox-frame" title="cKvdclBag44" frameBorder="0" scrolling="no" marginHeight="0" marginWidth="0" type="text/html" src="https://www.youtube.com/embed/cKvdclBag44?#autoplay=0&amp;fs=1&amp;iv_load_policy=3&amp;showinfo=0&amp;rel=0&amp;cc_load_policy=0&amp;start=0&amp;end=0" allowfullscreen=""></iframe></div></div><div class="info " data-cy="profile-info-item" lang="zh-TW"><h2 data-cy="profile-info-item-title">打擊詐騙 ATM</h2><div class="content ql-editor" data-cy="profile-info-content" style="padding-left:0;padding-right:0"><div><h2><span style="color: rgb(0, 0, 0); background-color: rgb(247, 247, 247);">●</span><span style="color: rgba(0,0,0,var(--O42jJQ,1));">推動地方政府與銀行合作，打造結合AI技術的提款機，透過人臉辨識、行為分析判斷提款的是民眾還是詐騙車手。</span></h2><h2><span style="color: rgb(0, 0, 0); background-color: rgb(247, 247, 247);">●</span><span style="color: rgba(0,0,0,var(--O42jJQ,1));">若民眾受騙，讓詐騙集團也領不出錢來，增加民眾受騙後取回款項的機會。</span></h2></div></div><div class="youtubeBox " data-cy="youtube-box"><iframe class="youtubeBox-frame" title="gJ4G2Y3T1No" frameBorder="0" scrolling="no" marginHeight="0" marginWidth="0" type="text/html" src="https://www.youtube.com/embed/gJ4G2Y3T1No?#autoplay=0&amp;fs=1&amp;iv_load_policy=3&amp;showinfo=0&amp;rel=0&amp;cc_load_policy=0&amp;start=0&amp;end=0" allowfullscreen=""></iframe></div></div><div class="info " data-cy="profile-info-item" lang="zh-TW"><h2 data-cy="profile-info-item-title">每個月底我都會公開財務，␀來看看選舉錢都花在哪吧</h2><div class="content ql-editor" data-cy="profile-info-content" style="padding-left:0;padding-right:0"><div><h2><span style="color: rgb(50, 50, 50); background-color: rgb(255, 255, 255);">選舉看板、文宣品、服務團隊...等</span>🤣</h2><h2><br></h2></div></div><div class="youtubeBox " data-cy="youtube-box"><iframe class="youtubeBox-frame" title="AaBl2EMrXcU" frameBorder="0" scrolling="no" marginHeight="0" marginWidth="0" type="text/html" src="https://www.youtube.com/embed/AaBl2EMrXcU?#autoplay=0&amp;fs=1&amp;iv_load_policy=3&amp;showinfo=0&amp;rel=0&amp;cc_load_policy=0&amp;start=0&amp;end=0" allowfullscreen=""></iframe></div></div><div class="info " data-cy="profile-info-item" lang="zh-TW"><h2 data-cy="profile-info-item-title">柏詠的一天在幹嘛呀？</h2><div class="content ql-editor" data-cy="profile-info-content" style="padding-left:0;padding-right:0"><div><h2><strong style="background-color: rgb(255, 255, 255); color: rgb(50, 50, 50);">一天從06:00開始，到22:00結束送車、路口揮手、發傳單、幫長輩打菜、聚餐致詞等等</strong></h2></div></div><div class="youtubeBox " data-cy="youtube-box"><iframe class="youtubeBox-frame" title="7BY64_Oi7TU" frameBorder="0" scrolling="no" marginHeight="0" marginWidth="0" type="text/html" src="https://www.youtube.com/embed/7BY64_Oi7TU?#autoplay=0&amp;fs=1&amp;iv_load_policy=3&amp;showinfo=0&amp;rel=0&amp;cc_load_policy=0&amp;start=0&amp;end=0" allowfullscreen=""></iframe></div></div></div></section><section class="flex flex-col gap-6" data-cy="oenPage-v2-products-skeleton"><header class="flex items-center gap-4 w-full "><h6 class="text-ds-heading-xs text-ds-content-primary whitespace-nowrap">支持好物</h6><div class="grow border-t border-ds-border-primary"></div></header><div class="grid grid-cols-2 gap-4 md:grid-cols-3 md:gap-5 lg:grid-cols-4 lg:gap-6"><div class="flex w-full flex-col items-start gap-2 "><div class="oen-skeleton-pulse rounded bg-ds-bg-tertiary aspect-square w-full rounded-xl" aria-hidden="true"></div><div class="flex w-full flex-col gap-1"><div class="oen-skeleton-pulse rounded bg-ds-bg-tertiary h-4 w-3/4 " aria-hidden="true"></div><div class="oen-skeleton-pulse rounded bg-ds-bg-tertiary h-4 w-1/2 " aria-hidden="true"></div></div></div><div class="flex w-full flex-col items-start gap-2 "><div class="oen-skeleton-pulse rounded bg-ds-bg-tertiary aspect-square w-full rounded-xl" aria-hidden="true"></div><div class="flex w-full flex-col gap-1"><div class="oen-skeleton-pulse rounded bg-ds-bg-tertiary h-4 w-3/4 " aria-hidden="true"></div><div class="oen-skeleton-pulse rounded bg-ds-bg-tertiary h-4 w-1/2 " aria-hidden="true"></div></div></div><div class="flex w-full flex-col items-start gap-2 hidden md:flex"><div class="oen-skeleton-pulse rounded bg-ds-bg-tertiary aspect-square w-full rounded-xl" aria-hidden="true"></div><div class="flex w-full flex-col gap-1"><div class="oen-ske