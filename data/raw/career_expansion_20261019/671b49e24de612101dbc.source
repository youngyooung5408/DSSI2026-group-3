7,308,309],\"desktopCovers\",[298,299,300],\"theme\",{\"_13\":14,\"_286\":287,\"_288\":289,\"_290\":291},\"socialMedia\",{\"_13\":14,\"_272\":273},\"profile\",{\"_169\":170,\"_68\":171,\"_172\":173,\"_174\":175,\"_176\":177,\"_178\":179,\"_180\":181,\"_182\":183,\"_80\":184,\"_185\":186,\"_187\":188,\"_189\":190},\"creditPage\",{\"_168\":29},\"openGraphSettings\",{\"_36\":164,\"_40\":165,\"_166\":167},\"edmSubscription\",{\"_142\":29},\"donationAmounts\",{\"_148\":149,\"_150\":151,\"_152\":153,\"_154\":155,\"_156\":157},\"donationSubscriptionPeriods\",{\"_144\":29,\"_145\":34,\"_146\":147},\"pointsConfig\",{\"_142\":34,\"_143\":61},\"paymentConfig\",{\"_119\":34,\"_120\":34,\"_121\":34,\"_55\":29,\"_122\":34,\"_123\":124,\"_125\":126,\"_127\":128},\"publicFeatureAvailability\",{\"_100\":34,\"_101\":34,\"_102\":34,\"_103\":34,\"_104\":34,\"_105\":34,\"_106\":34,\"_107\":34,\"_108\":34,\"_109\":34,\"_110\":34,\"_111\":34,\"_112\":34,\"_113\":34,\"_114\":34,\"_115\":34,\"_116\":34,\"_117\":34,\"_118\":29},\"CHARGE_DASHBOARD\",\"DONATION_PROJECT\",\"DONATION_ANNUAL_DONATION\",\"DONATION_SETTING\",\"GOODS_PROMOS\",\"GOODS_SETTING\",\"DONATION_DASHBOARD\",\"DONATION_PROJECT_ADD\",\"EVENT_PROMO_CODE\",\"MEMBERSHIP_FEE_SETTING\",\"MEMBER_MEMBERSHIP_FEE_CREATE\",\"SITE_CROWDFUNDING\",\"POLITICAL_DASHBOARD\",\"POLITICAL_DECLARATION\",\"POLITICAL_RECORDS\",\"POLITICAL_ANONYMOUS\",\"POLITICAL_RECEIPTS\",\"DONATION\",\"ONLY_FREE\",\"non3DCardAvailable\",\"paymentUrlCardAvailable\",\"savedCardAvailable\",\"enabledUnifiedCheckout\",\"cvsPaymentProvider\",\"FAMILY_MART\",\"methods\",{\"_135\":34,\"_136\":34,\"_137\":29,\"_138\":29,\"_139\":34,\"_140\":34,\"_141\":29},\"cardTypes\",{\"_129\":34,\"_130\":34,\"_131\":34,\"_54\":29,\"_132\":29,\"_133\":29,\"_134\":29},\"visa\",\"masterCard\",\"JCB\",\"americanExpress\",\"discover\",\"dinersClub\",\"card\",\"cvs\",\"atm\",\"linePay\",\"applePay\",\"clickToPay\",\"googlePayByUnifiedCheckout\",\"enabled\",\"exchangeRate\",\"unlimit\",\"allowCustomPeriods\",\"periods\",[],\"donationPanelMode\",\"default\",\"donationOption\",\"both\",\"minAmount\",100,\"fastPanelOption\",\"onetime\",\"amounts\",[158,159,160,161,162,163],600,1200,2000,3600,6000,12000,\"無黨青年 張柏詠\",\"請讓在地、專業、有拚勁、有想法的年輕世代，為您守護大新店的未來!\",\"image\",\"https://static-assets.oen.tw/images/img-3DcTUWdiUCAu2aVT2mLntmx6SSn.jpg\",\"showPage\",\"goal\",{\"_191\":271,\"_193\":34},{\"_191\":61,\"_193\":34},\"info\",{\"_191\":216,\"_193\":34,\"_13\":14,\"_198\":217},\"goods\",{\"_191\":215,\"_193\":34},\"events\",{\"_191\":214,\"_193\":29},\"articles\",{\"_191\":213,\"_193\":34},\"memberships\",{\"_191\":212,\"_193\":34},\"contacts\",{\"_191\":197,\"_193\":34,\"_13\":14,\"_198\":199},{\"_191\":196,\"_193\":34},\"questionnaire\",{\"_191\":195,\"_193\":29},\"project\",{\"_191\":194,\"_193\":34},\"edm\",{\"_191\":192,\"_193\":29},\"order\",11,\"display\",10,9,8,7,\"data\",[200],{\"_201\":202,\"_203\":204,\"_36\":205,\"_206\":207,\"_208\":209,\"_210\":211},\"id\",\"MGJqSCXc9qkxmGbcWGSdB\",\"map\",\"https://maps.googleapis.com/maps/api/staticmap?zoom=19\u0026size=668x238\u0026markers=color:green|label:M|新北市新店區北新路一段345號3樓\u0026maptype=roadmap\u0026key=AIzaSyAbOdJ-_h7IMfr5IZaU_SNDRodSWBSgKsQ\",\"服務處\",\"address\",\"新北市#新店區# \",\"openTime\",\"請來電預約\",\"phone\",\"0938-663-553\",6,5,4,3,2,[218,219,220,221,222,223,224,225],{\"_201\":266,\"_36\":267,\"_228\":268,\"_230\":269},{\"_201\":261,\"_36\":262,\"_228\":263,\"_230\":264},{\"_201\":256,\"_36\":257,\"_228\":258,\"_230\":259},{\"_201\":251,\"_36\":252,\"_228\":253,\"_230\":254},{\"_201\":246,\"_36\":247,\"_228\":248,\"_230\":249},{\"_201\":241,\"_36\":242,\"_228\":243,\"_230\":244},{\"_201\":236,\"_36\":237,\"_228\":238,\"_230\":239},{\"_201\":226,\"_36\":227,\"_228\":229,\"_230\":231},\"LYkzXuF-eb4BkPkCZso3D\",\"柏詠的一天在幹嘛呀？\",\"content\",\"\u003ch2\u003e\u003cstrong style=\\\"background-color: rgb(255, 255, 255); color: rgb(50, 50, 50);\\\"\u003e一天從06:00開始，到22:00結束送車、路口揮手、發傳單、幫長輩打菜、聚餐致詞等等\u003c/strong\u003e\u003c/h2\u003e\",\"media\",{\"_232\":233,\"_234\":235},\"type\",\"youtubeVideo\",\"link\",\"https://www.youtube.com/embed/7BY64_Oi7TU\",\"G8z6p_67pHmYwsRHNOiiJ\",\"每個月底我都會公開財務，來看看選舉錢都花在哪吧\",\"\u003ch2\u003e\u003cspan style=\\\"color: rgb(50, 50, 50); background-color: rgb(255, 255, 255);\\\"\u003e選舉看板、文宣品、服務團隊...等\u003c/span\u003e🤣\u003c/h2\u003e\u003ch2\u003e\u003cbr\u003e\u003c/h2\u003e\",{\"_232\":233,\"_234\":240},\"https://www.youtube.com/embed/AaBl2EMrXcU\",\"bvthG68FGJ472H2JpcyH5\",\"打擊詐騙 ATM\",\"\u003ch2\u003e\u003cspan style=\\\"color: rgb(0, 0, 0); background-color: rgb(247, 247, 247);\\\"\u003e●\u003c/span\u003e\u003cspan style=\\\"color: rgba(0,0,0,var(--O42jJQ,1));\\\"\u003e推動地方政府與銀行合作，打造結合AI技術的提款機，透過人臉辨識、行為分析判斷提款的是民眾還是詐騙車手。\u003c/span\u003e\u003c/h2\u003e\u003ch2\u003e\u003cspan style=\\\"color: rgb(0, 0, 0); background-color: rgb(247, 247, 247);\\\"\u003e●\u003c/span\u003e\u003cspan style=\\\"color: rgba(0,0,0,var(--O42jJQ,1));\\\"\u003e若民眾受騙，讓詐騙集團也領不出錢來，增加民眾受騙後取回款項的機會。\u003c/span\u003e\u003c/h2\u003e\",{\"_232\":233,\"_234\":245},\"https://www.youtube.com/embed/gJ4G2Y3T1No\",\"xRPxmLmC55I1JLZlwzhBN\",\"國中學區升級\",\"\u003ch2 class=\\\"ql-align-justify\\\"\u003e\u003cstrong style=\\\"color: rgb(0, 0, 0); background-color: rgb(247, 247, 247);\\\"\u003e●\u003c/strong\u003e\u003cspan style=\\\"color: rgba(0,0,0,var(--O42jJQ,1));\\\"\u003e推動國中雙語教育融入更多課程、爭取專業師資成立數理資優班、改善老舊校舍，提升孩童國際觀與競爭力。\u003c/span\u003e\u003c/h2\u003e\u003ch2 class=\\\"ql-align-justify\\\"\u003e\u003cstrong style=\\\"color: rgb(0, 0, 0); background-color: rgb(247, 247, 247);\\\"\u003e●\u003c/strong\u003e\u003cspan style=\\\"color: rgba(0,0,0,var(--O42jJQ,1));\\\"\u003e解決新店區國中在地就學率偏低，需要跨區或跨市讀書的問題，讓新店的孩子國中都能留在新店念書。\u003c/span\u003e\u003c/h2\u003e\",{\"_232\":233,\"_234\":250},\"https://www.youtube.com/embed/cKvdclBag44\",\"U7wIFugY6YIsgtkts2daR\",\"有趣新碧潭(文創假日市集)\",\"\u003ch2 class=\\\"ql-align-justify\\\"\u003e\u003cstrong style=\\\"color: rgb(0, 0, 0); background-color: rgb(247, 247, 247);\\\"\u003e●\u003c/strong\u003e\u003cspan style=\\\"color: rgba(0,0,0,var(--O42jJQ,1));\\\"\u003e打造碧潭常態性假日文創市集，提供在地青年租金優惠，讓碧潭成為民眾可以逛市集，在地青年可以創業的逐夢基地。\u003c/span\u003e\u003c/h2\u003e\",{\"_232\":233,\"_234\":255},\"https://www.youtube.com/embed/VR_4iz0yaI8\",\"bwp_ZVGWKIt87qRkLQNUk\",\"有趣新碧潭(水上遊樂園)\",\"\u003ch2 class=\\\"ql-align-justify\\\"\u003e\u003cstrong style=\\\"background-color: rgb(247, 247, 247); color: rgb(0, 0, 0);\\\"\u003e●\u003c/strong\u003e\u003cspan style=\\\"color: rgba(0,0,0,var(--O42jJQ,1));\\\"\u003e推動碧潭河岸引入SUP、獨木舟、充氣式水上遊樂設施等業者，讓碧潭不再只有一成不變的天鵝船。\u003c/span\u003e\u003c/h2\u003e\",{\"_232\":233,\"_234\":260},\"https://www.youtube.com/embed/QJJ3o_2xToI\",\"muRS5A-dF0j4CEmy1h-Uy\",\"現代化市場\",\"\u003ch2\u003e\u003cspan style=\\\"color: rgb(0, 0, 0); background-color: rgb(247, 247, 247);\\\"\u003e●\u003c/span\u003e\u003cspan style=\\\"color: rgba(0,0,0,var(--O42jJQ,1));\\\"\u003e推動建國游泳池改建成室內市場，從根本解決建國仁愛市場人車爭道、環境老舊、攤商占用人行道嚴重問題\u003c/span\u003e\u003c/h2\u003e\u003ch2\u003e\u003cspan style=\\\"color: rgb(0, 0, 0); background-color: rgb(247, 247, 247);\\\"\u003e●\u003c/span\u003e\u003cspan style=\\\"color: rgba(0,0,0,var(--O42jJQ,1));\\\"\u003e打造安坑傳統市場，讓安康公有市場不再只有連鎖超市。\u003c/span\u003e\u003c/h2\u003e\",{\"_232\":233,\"_234\":265},\"https://www.youtube.com/embed/toTQmxeDiOM\",\"8RehyED0FpA-1PjnE0v94\",\"請讓無黨青年，為您守護大新店的未來!\",\"\u003ch2\u003e\u003cspan style=\\\"background-color: rgb(247, 247, 247); color: rgb(0, 0, 0);\\\"\u003e過去在調查局工作的8年，讓我深刻體會到一件事：打擊犯罪雖然很重要，但真正能改善民眾生活的，是基礎建設是否到位、政策是否貼近人民的生活，因此今年我決定參選市議員，我要更全面地為民眾服務。\u003c/span\u003e\u003c/h2\u003e\",{\"_232\":233,\"_234\":270},\"https://www.youtube.com/embed/oeF_3qOIEUs\",0,\"platforms\",[274,275,276],{\"_277\":284,\"_279\":285,\"_281\":-5},{\"_277\":282,\"_279\":283,\"_281\":-5},{\"_277\":278,\"_279\":280,\"_281\":-5},\"platform\",\"threads\",\"url\",\"https://www.threads.com/@ryung1995\",\"img\",\"ig\",\"https://www.instagram.com/ryung1995/\",\"fb\",\"https://www.facebook.com/mjibchang/\",\"layout\",\"a\",\"currentTheme\",\"orange\",\"customTheme\",{\"_292\":293,\"_294\":295,\"_296\":297},\"dark\",\"#000000\",\"bright\",\"#c7c7c7\",\"color\",\"#FFFFFF\",{\"_201\":305,\"_279\":306},{\"_201\":303,\"_279\":304},{\"_201\":301,\"_279\":302},\"PWaPbKw6ikrkkYtP-bidH\",\"https://static-assets.oen.tw/images/img-3ED496UofJ8YsG6QrYtQjVPXtJE.jpg\",\"DBo_Z_SGgCHNQf0tNqt3r\",\"https://static-assets.oen.tw/images/img-3DROz9sXzXYWZOSDVN0r2Yxm8Hw.jpg\",\"1M1nk8s90fhWdBZITJupa\",\"https://static-assets.oen.tw/images/img-3DZfxCqJKbxxUZ4AhGMutExVPaS.jpg\",{\"_201\":314,\"_279\":315},{\"_201\":312,\"_279\":313},{\"_201\":310,\"_279\":311},\"KbrRWpR1dK-QPLC0uXrQy\",\"https://static-assets.oen.tw/images/img-3ITh7GQhInmPV8CQ4i2aHyeKGxU.jpg\",\"a6evlsI54e2kTmW7Na6gm\",\"https://static-assets.oen.tw/images/img-3ITh5M6XgRe3sanw6scczZgplWA.jpg\",\"Rx0pU8-jSTwOvF2KrvKyQ\",\"https://static-assets.oen.tw/images/img-3DeXpAAb4LyfVn2pfP4nKz6LkSD.png\",\"active\",\"pageNumber\",\"tax\",\"taxable\",\"isMembershipActive\",\"status\",\"尚未開放\",[158,159,160,161,162,163],\"area\",\"name\",\"date\",\"pollNumber\",\"ga\",\"G-WGHTHD6KQY\",\"fbd\"]\n");</script><!--$--><script>window.__reactRouterContext.streamController.close();</script><!--/$--><!--/$-->