er-dark-mobile.uaZpPPgs.svg"><link rel="prefetch" as="image" type="image/svg+xml" href="/_nuxt/logo-header-light-desktop.C2XykxM_.svg"><link rel="prefetch" as="image" type="image/svg+xml" href="/_nuxt/logo-header-light-mobile.DdikG_4q.svg"><link rel="prefetch" as="script" crossorigin href="/_nuxt/BV2dysBM.js"><link rel="prefetch" as="script" crossorigin href="/_nuxt/CBC-pFBh.js"><link rel="prefetch" as="style" crossorigin href="/_nuxt/useHotVoteData.DsvchMSz.css"><link rel="prefetch" as="script" crossorigin href="/_nuxt/_TdZR3Za.js"><link rel="prefetch" as="script" crossorigin href="/_nuxt/-sx9ZwmA.js"><link rel="prefetch" as="script" crossorigin href="/_nuxt/bAvqUxha.js"><link rel="prefetch" as="script" crossorigin href="/_nuxt/C__341TU.js"><link rel="prefetch" as="script" crossorigin href="/_nuxt/BhZH2EvD.js"><link rel="prefetch" as="script" crossorigin href="/_nuxt/BCXn6exn.js"><link rel="prefetch" as="script" crossorigin href="/_nuxt/6AO__cAa.js"><link rel="prefetch" as="script" crossorigin href="/_nuxt/ngGef948.js"><link rel="icon" href="/favicon.ico"><meta property="og:site_name" content="Newtalk新聞"><meta property="og:locale" content="zh_TW"><meta property="og:image:width" content="1200"><meta property="og:image:height" content="630"><meta name="twitter:site" content="@newtalk_tw"><meta name="twitter:card" content="summary_large_image"><meta property="article:author" content="唐復年"><meta property="article:tag" content="台中市"><meta property="article:tag" content="蔡其昌"><meta property="article:tag" content="立法院"><meta name="twitter:title" content="新潮流強力推薦 台中山城議員初選詹智翔過關 | 政治 | Newtalk新聞"><meta name="twitter:description" content="民主進步黨 2026 年直轄市議員提名初選民調作業，今（25）日公布台中市第十四選區（東勢等四區）民調結果，由新人詹智翔勝出。詹智翔是立委蔡其昌在山城地區第一位專職的服務處主任，學經歷相當豐富，台中二中、中正大學、台大研究所，博士班期間曾赴日本大阪大學交換，畢業後首份工作是中研院研究助理，而後轉職立"><meta name="twitter:image" content="https://s.newtalk.tw/album/news/1027/69c366075de51.jpg"><meta name="description" content="民主進步黨 2026 年直轄市議員提名初選民調作業，今（25）日公布台中市第十四選區（東勢等四區）民調結果，由新人詹智翔勝出。詹智翔是立委蔡其昌在山城地區第一位專職的服務處主任，學經歷相當豐富，台中二中、中正大學、台大研究所，博士班期間曾赴日本大阪大學交換，畢業後首份工作是中研院研究助理，而後轉職立"><meta property="og:type" content="article"><meta property="og:title" content="新潮流強力推薦 台中山城議員初選詹智翔過關 | 政治 | Newtalk新聞"><meta property="og:description" content="民主進步黨 2026 年直轄市議員提名初選民調作業，今（25）日公布台中市第十四選區（東勢等四區）民調結果，由新人詹智翔勝出。詹智翔是立委蔡其昌在山城地區第一位專職的服務處主任，學經歷相當豐富，台中二中、中正大學、台大研究所，博士班期間曾赴日本大阪大學交換，畢業後首份工作是中研院研究助理，而後轉職立"><meta property="og:image" content="https://s.newtalk.tw/album/news/1027/69c366075de51.jpg"><meta property="og:url" content="https://newtalk.tw/news/view/2026-03-25/1026188"><meta property="article:section" content="政治"><meta property="article:published_time" content="2026-03-25T04:51:36.000Z"><meta property="article:modified_time" content="2026-03-25T04:51:36.000Z"><meta name="robots" content="index, follow, noarchive, max-image-preview:large"><link rel="canonical" href="https://newtalk.tw/news/view/2026-03-25/1026188"><meta name="keywords" content="台中市,蔡其昌,立法院"><script type="application/ld+json" data-hid="article-jsonld">{"@context":"https://schema.org","@type":"NewsArticle","headline":"新潮流強力推薦 台中山城議員初選詹智翔過關","description":"民主進步黨 2026 年直轄市議員提名初選民調作業，今（25）日公布台中市第十四選區（東勢等四區）民調結果，由新人詹智翔勝出。詹智翔是立委蔡其昌在山城地區第一位專職的服務處主任，學經歷相當豐富，台中二中、中正大學、台大研究所，博士班期間曾赴日本大阪大學交換，畢業後首份工作是中研院研究助理，而後轉職立","thumbnailUrl":"https://images.newtalk.tw/resize_action2/1200/album/news/1027/69c366075de51.jpg","image":{"@type":"ImageObject","url":"https://s.newtalk.tw/album/news/1027/69c366075de51.jpg"},"dateCreated":"2026-03-25T04:37:06.000Z","datePublished":"2026-03-25T04:51:36.000Z","dateModified":"2026-03-25T04:51:36.000Z","url":"https://newtalk.tw/news/view/2026-03-25/1026188","mainEntityOfPage":"https://newtalk.tw/news/view/2026-03-25/1026188","articleSection":"政治","keywords":"台中市,蔡其昌,立法院","inLanguage":"zh-Hant-TW","isAccessibleForFree":true,"publisher":{"@type":"Organization","name":"Newtalk新聞","url":"https://newtalk.tw","logo":{"@type":"ImageObject","url":"https://newtalk.tw/img/logo.png"}},"provider":{"@type