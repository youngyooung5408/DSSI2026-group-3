                TweenMax.to(bird2[2], 12, { repeat: -1, bezier: { type: "cubic", values: [{ x: 0, y: 0, scaleX: 1 }, { x: -50, y: -40, scaleX: 0.8 }, { x: 50, y: -40, scaleX: 0.3 }, { x: 0, y: 0, scaleX: 1 }] }, ease: Power1.easeInOut });

