				    {
				        breakpoint: 1200,
				        settings: {
				            slidesToShow: 3,
				        },
				    },
				    {
				        breakpoint: 768,
				        settings: {
				            slidesToShow: 4,
				        },
				    },
				    {
				        breakpoint: 475,
				        settings: {
				            slidesToShow: 3,
				        },
				    },
				    {
				        breakpoint: 375,
				        settings: {
				            slidesToShow: 2,
				        },
				    },
                ]
            });
        });
    </script>
    <script type="text/javascript">


        $(".page-set-size-block .small-word").click(function () {
            $(".page-set-size-block .set-word").removeClass("active");
            $(this).addClass("active");


            $(".inside-page-detail-block .ipdb-title-block").addClass("small-word");
            $(".inside-page-detail-block .active-detail-list-block").addClass("small-word");
            $(".inside-page-detail-block article.content").addClass("small-word");

            $(".inside-page-detail-block .ipdb-title-block").removeClass("medium-word");
            $(".inside-page-detail-block .active-detail-list-block").removeClass("medium-word");
            $(".inside-page-detail-block article.content").removeClass("medium-word");

            $(".inside-page-detail-block .ipdb-title-block").removeClass("large-word");
            $(".inside-page-detail-block .active-detail-list-block").removeClass("large-word");
            $(".inside-page-detail-block article.content").removeClass("large-word");
        });

        $(".page-set-size-block .medium-word").click(function () {
            $(".page-set-size-block .set-word").removeClass("active");
            $(this).addClass("active");



            $(".inside-page-detail-block .ipdb-title-block").addClass("medium-word");
            $(".inside-page-detail-block .active-detail-list-block").addClass("medium-word");
            $(".inside-page-detail-block article.content").addClass("medium-word");

            $(".inside-page-detail-block .ipdb-title-block").removeClass("small-word");
            $(".inside-page-detail-block .active-detail-list-block").removeClass("small-word");
            $(".inside-page-detail-block article.content").removeClass("small-word");

            $(".inside-page-detail-block .ipdb-title-block").removeClass("large-word");
            $(".inside-page-detail-block .active-detail-list-block").removeClass("large-word");
            $(".inside-page-detail-block article.content").removeClass("large-word");
        });

        $(".page-set-size-block .large-word").click(function () {
            $(".page-set-size-block .set-word").removeClass("active");
            $(this).addClass("active");



            $(".inside-page-detail-block .ipdb-title-block").addClass("large-word");
            $(".inside-page-detail-block .active-detail-list-block").addClass("large-word");
            $(".inside-page-detail-block article.content").addClass("large-word");

            $(".inside-page-detail-block .ipdb-title-block").removeClass("small-word");
            $(".inside-page-detail-block .active-detail-list-block").removeClass("small-word");
            $(".inside-page-detail-block article.content").removeClass("small-word");

            $(".inside-page-detail-block .ipdb-title-block").removeClass("medium-word");
            $(".inside-page-detail-block .active-detail-list-block").removeClass("medium-word");
            $(".inside-page-detail-block article.content").removeClass("medium-word");
        });
    </script>

    <script>
        $("header .menu-block .search-b .search-open-block button").focusout(function () {
            $("header .menu-block .search-b .search-open-block").removeClass("active");
        });
    </script>

    <script type="text/javascript">
        $("header .menu-block .header-menu-ul-category>li>a").focus(function () {
            $(this).parent().parent().find(".header-menu-ul-subcategory-block").removeClass("active");
            $(this).next().addClass("active");
        });

        $("header .menu-block .header-menu-ul-subcategory-block a").focus(function () {
            $(this).parent().parent().parent().addClass("active");
        }).focusout(function () {
            if ($(this).parent().is(':last-child')) {
                $(this).parent().parent().parent().removeClass("active");
            }
        });
    </script>


    <script type="text/javascript">
        $("header .menu-block .search-b>a").click(function () {
            $(this).next().toggleClass("active");
        });


        $("header .mobile-menu-link-b>a").click(function () {
            $(this).next().toggleClass("active");

            if ($(this).next().hasClass("active")) {
                $("body").css("overflow", "hidden");
            } else {
                $("body").css("overflow", "");
            }
        });

        $("header .mobile-header-wrapper .mobile-menu-link-b .mobile-menu-open-block .menu-link-b .title-link-b > a").click(function () {
            $(this).parent().parent().parent().parent().removeClass("active");
            $("body").css("overflow", "");
        });


        $("header .mobile-search-b>a").click(function () {
            $(this).next().toggleClass("active");
        });
    </script>

    <script type="text/javascript">
        $("footer .footer-site-map .web-info .sites-open-link a").click(function () {
            var sub_block = $(this).parent().parent().parent().next();
            if (sub_block.hasClass("active")) {
                sub_block.removeClass("active");
                sub_block.slideUp(500);
            } else {
                sub_block.addClass("active");
                sub_block.slideDown(500);
            }
        });
    </script>


    <script type="text/javascript">
        $(".mobile-menu-open-block .menu-link-b .sub-link-b ul li>.has-sub:nth-child(2)").click(function () {
            $(this).addClass("active", 300);
            $(this).next().addClass("active", 300);
        });

        $(".mobile-menu-open-block .menu-link-b .sub-link-b ul li .sub-menu .sub-menu-title .back").click(function () {
            $(this).parent().parent().parent().removeClass("active", 300);
            $(this).parent().parent().parent().prev().removeClass("active", 300);
        });
    </script>
    <script type="text/javascript">
        $.datepicker.regional['zh-TW'] = {
            dayNames: ["星期日", "星期一", "星期二", "星期三", "星期四", "星期五", "星期六"],
            dayNamesMin: ["日", "一", "二", "三", "四", "五", "六"],
            monthNames: ["一月", "二月", "三月", "四月", "五月", "六月", "七月", "八月", "九月", "十月", "十一月", "十二月"],
            monthNamesShort: ["一月", "二月", "三月", "四月", "五月", "六月", "七月", "八月", "九月", "十月", "十一月", "十二月"],
            prevText: "上月",
            nextText: "次月",
            weekHeader: "週"
        };
        $.datepicker.setDefaults($.datepicker.regional["zh-TW"]);
    </script>


    <script type="text/javascript">
        $(".ipdb-title-search-block .due-date input").datepicker({ dateFormat: 'yy/mm/dd' });
    </script>

    <script>



        function wrapKeyword() {
            var input = document.getElementById("q");
            var keyword = input.value.trim();

            if (keyword !== "") {
              
                if (!(keyword.startsWith('"') && keyword.endsWith('"'))) {
                    input.value = '"' + keyword + '"';
                }
            }

            return true; 
        }

    </script>
</body>
</html>
