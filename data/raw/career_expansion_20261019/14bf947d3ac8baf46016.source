    var userChangedTranslate = false;


    function googleTranslateElementInit() {

        var targetId = window.innerWidth < 768
            ? 'google_translate_element2'
            : 'google_translate_element';

        new google.translate.TranslateElement({
            pageLanguage: 'zh-TW',
            includedLanguages: 'zh-TW,en,ja,ko,fil,id,vi,th,ms,tl',
            layout: google.translate.TranslateElement.InlineLayout.SIMPLE
        }, targetId);
    }

    document.addEventListener('click', function (event) {

        var translateButton = event.target.closest(
            '#google_translate_element .goog-te-gadget-simple a, ' +
            '#google_translate_element2 .goog-te-gadget-simple a'
        );

        if (!translateButton) {
            return;
        }

        userChangedTranslate = true;


    }, true);


    var translateObserver = new MutationObserver(function () {

        var currentLanguage = document.documentElement.lang;

        if (!currentLanguage) {
            return;
        }


        if (currentLanguage === lastTranslateLanguage) {
            return;
        }



        lastTranslateLanguage = currentLanguage;


        if (!userChangedTranslate) {

          

            return;
        }


        if (currentLanguage === 'zh-TW') {

            userChangedTranslate = false;

            return;
        }



        alert(
            '提醒：本網站翻譯功能由 Google 翻譯提供。\n\n' +
            '翻譯內容可能與原文有所差異，僅供參考。'
        );


        // 重設
        userChangedTranslate = false;

    });


    translateObserver.observe(
        document.documentElement,
        {
            attributes: true,
            attributeFilter: ['lang']
        }
    );

    var lastWidth = window.innerWidth;

    window.addEventListener('resize', function () {

        var currentWidth = window.innerWidth;

        if (
            (lastWidth >= 768 && currentWidth < 768) ||
            (lastWidth < 768 && currentWidth >= 768)
        ) {

            window.location.reload();
        }

        lastWidth = currentWidth;

    });

</script>


