		<label for="6ad5faf53e1c5_pwd" class="col-sm-3 control-label">Password</label>
		<div class="col-sm-9">
			<input type="password" id="6ad5faf53e1c5_pwd" class="pwd form-control" required value="" name="pwd" placeholder="Password">
		</div>
	</div>

	
	<div class="form-group row">
	    <div class="col-sm-9 col-sm-offset-3">
	    	<div class="checkbox">
	    		<div class="form-control-flat"><label class="checkbox"><input type="checkbox" id="6ad5faf53e1c5_rememberme" class="rememberme" name="rememberme"  value="forever"><i></i> Remember Me</label></div>
		    </div>
		</div>
	</div>
	<div class="form-actions form-group text-center">
	 		 		<input type="hidden" class="redirect_to" name="redirect_to" value="https://news.wkm.tw/jobs-home?logged_in=1" />
	 		 	<button type="submit" class="btn btn-primary">Sign In</button>
	 	<div class="login-form-links">
	 		<span><a href="https://news.wkm.tw/member/forgot-password/"><i class="fa fa-question-circle"></i> Forgot Password?</a></span>
	 			 		<span>還沒有帳戶嗎？<a href="https://news.wkm.tw/member?action=login&mode=register" class="member-register-link" >立即註冊 <i class="fas fa-long-arrow-alt-right"></i></a></span>
	 			 	</div>
	 </div>
	 </form>				      </div>
				</div>
			</div>
		</div>
				<div class="memberModalRegister modal fade" tabindex="-1" role="dialog" aria-labelledby="6ad5faf53e3e7_memberModalRegisterLabel" aria-hidden="true">
			<div class="modal-dialog modal-member">
		    	<div class="modal-content">
					<div class="modal-header">
				        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
				        <h4 class="modal-title" id="6ad5faf53e3e7_memberModalRegisterLabel">Sign Up</h4>
				     </div>
				      <div class="modal-body">
				        	<form class="noo-ajax-register-form form-horizontal" action="https://news.wkm.tw/member" method="post" id="registerform">
		<div style="display: none">
			<input type="hidden" class="redirect_to" name="redirect_to" value="" /> 
			<input type="hidden" name="action" value="noo_ajax_register">
			<!-- <input type="hidden" class="security" name="security" value="" /> -->
		</div>
		<div class="form-group text-center noo-ajax-result" style="display: none"></div>
						<div class="form-group row">
			<label for="6ad5faf53e4aa-display-name" class="col-sm-3 control-label">Display name</label>
			<div class="col-sm-9">
				<input type="text" class="display-name form-control" id="6ad5faf53e4aa-display-name"  name="name" required placeholder="Display name">
			</div>
		</div>
		
		<div class="form-group row">
			<label for="6ad5faf53e4aa-first-name" class="col-sm-3 control-label">First name</label>
			<div class="col-sm-9">
				<input type="text" class="first-name form-control" id="6ad5faf53e4aa-first-name"  name="first_name" required placeholder="First name">
			</div>
		</div>

		<div class="form-group row">
			<label for="6ad5faf53e4aa-last-name" class="col-sm-3 control-label">Last name</label>
			<div class="col-sm-9">
				<input type="text" class="last-name form-control" id="6ad5faf53e4aa-last-name"  name="last_name" required placeholder="Last name">
			</div>
		</div>

					<input type="hidden" id="6ad5faf53e4aa_user_login" name="user_login">
				<div class="form-group row required-field">
			<label for="6ad5faf53e4aa_user_email" class="col-sm-3 control-label">Email</label>
			<div class="col-sm-9">
				<input type="email" class="user_email form-control" id="6ad5faf53e4aa_user_email"  name="user_email" required placeholder="Email">
				<input class="hide" type="text" name="email_rehot" autocomplete="off"/>
			</div>
		</div>
		<div class="form-group row required-field">
			<label for="6ad5faf53e4aa_user_password" class="col-sm-3 control-label">Password</label>
			<div class="col-sm-9">
				<input type="password" id="6ad5faf53e4aa_user_password" class="user_password form-control" required value="" name="user_password" placeholder="Password">
			</div>
		</div>
		<div class="form-group row required-field">
			<label for="6ad5faf53e4aa_cuser_password" class="col-sm-3 control-label">Retype your password</label>
			<div class="col-sm-9">
				<input type="password" id="6ad5faf53e4aa_cuser_password" class="cuser_password form-control" required value="" name="cuser_password" placeholder="Repeat password">
			</div>
		</div>
					
			<div class="form-group row required-field user-type">
				<label class="col-sm-3 control-label">You are</label>
				<div class="col-sm-9">
					<div class="form-control-flat">
						<select class="user_role" name="user_role" required>
							<option value="">-Select-</option>
														<option value="employer" >我是雇主，我想招募人才</option>
														<option value="candidate" >我是求職者，我想找工作</option>
													</select>
						<i class="fa fa-caret-down"></i>
					</div>
				</div>
			</div>
						<div class="form-group text-center">
							<div class="checkbox account-reg-term">
					<div class="form-control-flat">
						<label class="checkbox">
							<input class="account_reg_term" type="checkbox"  title="Please agree with the term"><i></i> 
							I agree with the <a href="https://news.wkm.tw/%e7%b6%b2%e7%ab%99%e4%bd%bf%e7%94%a8%e6%a2%9d%e6%ac%be" target="_blank">Terms of use</a>
						</label>
					</div>
				</div>
						<button type="submit" class="btn btn-primary">Sign Up</button>
		</div>
	 	<div class="login-form-links">
	 		<span>Already have an account? <a href="https://news.wkm.tw/member?action=login" class="member-login-link" >Login Now <i class="fas fa-long-arrow-alt-right"></i></a></span>
	 	</div>
