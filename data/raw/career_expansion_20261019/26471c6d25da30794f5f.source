    };

    // 3. 巡訪所有文字節點，進行替換
    const walker = document.createTreeWalker(
      document.body,
      NodeFilter.SHOW_TEXT,
      {
        acceptNode(node) {
          const p = node.parentNode?.tagName?.toLowerCase();
          return ["script", "style", "noscript"].includes(p)
            ? NodeFilter.FILTER_REJECT
            : NodeFilter.FILTER_ACCEPT;
        }
      },
      false
    );
    let node;
    while (node = walker.nextNode()) {
      let txt = node.nodeValue;
      for (const key in textMap) {
        if (txt.includes(key)) {
          txt = txt.replaceAll(key, textMap[key]);
        }
      }
      node.nodeValue = txt;
    }

    // 4. 處理 input/textarea placeholder
    document.querySelectorAll("input[placeholder], textarea[placeholder]").forEach(el => {
      let ph = el.getAttribute("placeholder");
      if (!ph) return;
      for (const key in textMap) {
        if (ph.includes(key)) ph = ph.replaceAll(key, textMap[key]);
      }
      el.setAttribute("placeholder", ph);
    });
  }

  // 一開始就先執行一次
  applyTranslations();

  // DOMContentLoaded 時再執行一次，並在 500ms 後再跑一次
  document.addEventListener("DOMContentLoaded", () => {
    applyTranslations();
    setTimeout(applyTranslations, 300);
	setInterval(applyTranslations, 1500);
  });
</script>


<script>
document.querySelectorAll('a[href="https://www.wkm.tw/about"]').forEach(link => {
    link.target = '_blank';
});
(function() {
  // 把要重複跑的邏輯寫進這個函式
  function updateNavbar() {
    var url = window.location.href.toLowerCase(); 
    if (url.includes('recruitment') || url.includes('jobs')|| url.includes('browse-categories')|| url.includes('job-type')|| url.includes('resumes')|| url.includes('companies')|| url.includes('job-category')) {
      // 隱藏 About 連結
      var aboutLink = document.querySelector('a[href="https://www.wkm.tw/about"]');
      if (aboutLink) {
        aboutLink.style.display = 'none';
      }
      // 修改 navbar-brand
      var navLink = document.querySelector('a.navbar-brand');
      if (navLink) {
        navLink.href = 'https://jobs.wkm.tw';
        navLink.querySelectorAll('img').forEach(function(img) {
		 if((url.includes('recruitment-home')!=true)&&(url!='https://jobs.wkm.tw/')){
          img.src = '/wp-content/uploads/2025/07/wkmjobs-logo.png';
		}
        });
      }
    }
  }

  // 1. 一開始立即執行一次
  updateNavbar();

  // 2. DOMContentLoaded 時執行一次
  document.addEventListener('DOMContentLoaded', function() {
    updateNavbar();

    // 3. 再等 500 毫秒執行一次
    setTimeout(updateNavbar, 500);
  });
})();
</script>

			<script>
				( () => {
					const lazyloadRunObserver = () => {
						const lazyloadBackgrounds = document.querySelectorAll( `.e-con.e-parent:not(.e-lazyloaded)` );
						const lazyloadBackgroundObserver = new IntersectionObserver( ( entries ) => {
							entries.forEach( ( entry ) => {
								if ( entry.isIntersecting ) {
									let lazyloadBackground = entry.target;
									if( lazyloadBackground ) {
										lazyloadBackground.classList.add( 'e-lazyloaded' );
									}
									lazyloadBackgroundObserver.unobserve( entry.target );
								}
							});
						}, { rootMargin: '200px 0px 200px 0px' } );
						lazyloadBackgrounds.forEach( ( lazyloadBackground ) => {
							lazyloadBackgroundObserver.observe( lazyloadBackground );
						} );
					};
					const events = [
						'DOMContentLoaded',
						'elementor/lazyload/observe',
					];
					events.forEach( ( event ) => {
						document.addEventListener( event, lazyloadRunObserver );
					} );
				} )();
			</script>
