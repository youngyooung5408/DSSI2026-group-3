    <script>
        (function waitForjQuery() {
            if (!window.jQuery) {
                return setTimeout(waitForjQuery, 50);
            }
            (function ($) {
                var NS = ".advSearch";

                function toggleBox($box) {
                    $box.toggleClass("active");
                    $box.find(".formlist").toggleClass("active");
                    var expanded = $box.hasClass("active");
                    $box.find(".advanced-search").attr("aria-expanded", expanded);
                }

                // ensure ARIA and ids
                $(".leftmenu-box").each(function (i) {
                    var $b = $(this);
                    var $list = $b.find(".formlist");
                    if (!$list.attr("id")) $list.attr("id", "formlist-" + i);
                    $b.find(".advanced-search").attr({
                        "aria-controls": $list.attr("id"),
                        "aria-expanded": false,
                        type: "button",
                    });
                });

                // (re)bind handlers namespaced so we can safely init multiple times
                $(".advanced-search")
                    .off("click" + NS)
                    .on("click" + NS, function (e) {
                        e.preventDefault();
                        toggleBox($(this).closest(".leftmenu-box"));
                    });

                // also allow clicking the titlebox (except clicks on the button itself)
                $(".leftmenu-box .titlebox")
                    .off("click" + NS)
                    .on("click" + NS, function (e) {
                        if ($(e.target).closest(".advanced-search").length) return;
                        toggleBox($(this).closest(".leftmenu-box"));
                    });
            })(jQuery);
        })();
    </script>
