<style id="wpfbf-video-output-fix">

.wpfbf-video-wrap {
    position: relative !important;
    display: block !important;
    width: 100% !important;
    max-width: min(100%, var(--wpfbf-max-width)) !important;
    margin: 1.25em auto !important;
    padding: 0 !important;
    overflow: hidden !important;
    background: #000 !important;
    aspect-ratio: auto !important;
}

.wpfbf-video-wrap::before {
    content: "" !important;
    display: block !important;
    width: 100% !important;
    padding-top: var(--wpfbf-padding) !important;
}

.wpfbf-video-frame {
    position: absolute !important;
    top: 0 !important;
    right: 0 !important;
    bottom: 0 !important;
    left: 0 !important;
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
    border: 0 !important;
    transform: none !important;
    aspect-ratio: auto !important;
}

iframe[src*="facebook.com/plugins/video.php"] {
    max-width: 100% !important;
    aspect-ratio: auto !important;
    transform: none !important;
}

.wpfbf-video-wrap iframe {
