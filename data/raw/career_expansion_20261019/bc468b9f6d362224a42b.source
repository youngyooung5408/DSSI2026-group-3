<style type="text/css">/* 列表與容器基礎設定 */
  .group-list.message > .in > .ct > .in > ul > li {
    height: 400px;
  }
.group-list.major-slider .in {
    position: relative;
    z-index: 1;
}


  .list-text.slider.Marquee {
    width: 95%;
  }

  .list-text.slider.Marquee .in {
    margin: 0;
  }

  /* 控制按鈕設定 */
  .list-text.slider.Marquee .in .ctrl_btn {
    top: 3px !important;
    right: 0 !important;
    z-index: 1 !important;
  }

  .list-text.slider.Marquee .in .ctrl_btn a {
    width: 42px !important;
    font-size: 0.8em !important;
    padding: 8px 15px 8px 30px !important;
    background-position: 3% 50% !important;
  }

  /* 跑馬燈內容與圖示設定 */
  .list-text.slider.Marquee .in .ct {
    background-color: #e4e4e4;
  }

  .list-text.slider.Marquee .in .ct .in:before {
    content: url(/Images/icon-pic/loudspeaker.png);
    display: block;
    background-color: #C04B1C;
    padding: 7px;
    background-position: center;
    position: absolute;
    bottom: 3px;
    left: 4px;
    border-radius: 20px;
  }

  .list-text.slider .ct ul li {
    padding-left: 40px;
  }

  .list-text.slider .ct span:before {
    display: none;
  }

  .list-text.slider .ct a {
    padding-right: 95px;
  }

  /* 平板尺寸樣式 (769px - 1280px) */
  @media (min-width: 769px) and (max-width: 1280px) {
    .list-text.slider.Marquee {
      margin-top: 85px;
    }
  }

  /* 手機尺寸樣式 (0px - 768px) */
  @media (max-width: 768px) {

.list-text.slider.Marquee .in .ctrl_btn{
    top: 45px !important;
}
    .list-text.slider .ct a {
      padding-right: 8px;
    }

    .list-text.slider.Marquee .in {
      overflow: inherit !important;
    }

    /* 手機版僅顯示第一則跑馬燈項目 */
    .list-text.slider .ct ul li:nth-child(n+2) {
  display: none !important;
}

    .list-text.slider .ct ul li:first-child {
      display: block !important;
    }
.group-list.message > .in > .ct > .in > ul > li {
    height: auto;
}
  }
</style>
<style type="text/css">/* .ct 裡面有 ul */
.list-text.slider.Marquee:has(.ct ul) {
    display: block !important;
}

/* .ct 裡面沒有 ul */
.list-text.slider.Marquee:not(:has(.ct ul)) {
        opacity: 0;
    margin-top: 30px;
}
</style>
