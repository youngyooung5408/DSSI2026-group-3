xt":"http://schema.org","@type":"NewsArticle","thumbnailUrl":"https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/27/35367213.png&M=1&s=Y&x=0&y=0&sw=1280&sh=865&sl=W&fw=800&exp=3600","url":"https://udn.com/news/story/124652/9779789","mainEntityOfPage":"https://udn.com/news/story/124652/9779789","headline":"國民黨最年輕議員參選人 樊一嶢用AI當選舉教練 首戰竹市東區議員","articleSection":"要聞","datePublished":"2026-09-27T11:02:41+08:00","dateModified":"2026-09-27T11:27:26+08:00","keywords":"2026九合一選舉,議員,國民黨,新竹市選舉,樊一嶢","image":{"@type":"ImageObject","contentUrl":"https://uc.udn.com.tw/photo/t3/2026/09/27/35367213.png&M=1","url":"https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/27/35367213.png&M=1&s=Y&x=0&y=0&sw=1280&sh=865&sl=W&fw=800&exp=3600","name":"除了訓練自己，樊一嶢也透過AI研究全台參選人，觀察不同的拜票方式，包括站路口、戴白手套等，再找出適合自己的方式。圖／樊一嶢提供","height":"1000","width":"800"},"author":{"@type":"Organization","name":"聯合新聞網"},"publisher":{"@type":"Organization","name":"聯合新聞網","url":"https://udn.com","sameAs":"https://www.facebook.com/myudn/","logo":{"@type":"ImageObject","url":"http://p.udn.com.tw/upf/static/common/amp_logo_news.png","height":60,"width":600}}},{"@context":"http://schema.org","@type":"Article","thumbnailUrl":"https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/27/35367213.png&M=1&s=Y&x=0&y=0&sw=1280&sh=865&sl=W&fw=800&exp=3600","url":"https://udn.com/news/story/124652/9779789","mainEntityOfPage":"https://udn.com/news/story/124652/9779789","headline":"國民黨最年輕議員參選人 樊一嶢用AI當選舉教練 首戰竹市東區議員","articleSection":"要聞","datePublished":"2026-09-27T11:02:41+08:00","dateModified":"2026-09-27T11:27:26+08:00","keywords":"2026九合一選舉,議員,國民黨,新竹市選舉,樊一嶢","image":{"@type":"ImageObject","contentUrl":"https://uc.udn.com.tw/photo/t3/2026/09/27/35367213.png&M=1","url":"https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/27/35367213.png&M=1&s=Y&x=0&y=0&sw=1280&sh=865&sl=W&fw=800&exp=3600","name":"除了訓練自己，樊一嶢也透過AI研究全台參選人，觀察不同的拜票方式，包括站路口、戴白手套等，再找出