\u002Fgovernance\u002Fombudsman",{"id":203,"name":204,"link":205},"11b5991c-4692-47fe-8aed-bf294df1d8f3","關於華視","https:\u002F\u002Fwww.cts.com.tw\u002Fabout",{"status":5,"code":6,"message":207,"data":208},"天氣列表取得成功",{"weathers":209},[210,218,222,226,230,234,238,241,245,248,251,255,258,262,266,269,272,275,278,281,284,288],{"locationId":211,"locationName":212,"state":213,"rain":214,"tempLow":215,"tempHigh":216,"iconUrl":217},"changhua","彰化縣","晴時多雲","0%",28,32,"04",{"locationId":219,"locationName":220,"state":213,"rain":214,"tempLow":215,"tempHigh":221,"iconUrl":217},"chiayi","嘉義縣",33,{"locationId":223,"locationName":224,"state":213,"rain":214,"tempLow":215,"tempHigh":225,"iconUrl":217},"chiayi_c","嘉義市",34,{"locationId":227,"locationName":228,"state":213,"rain":214,"tempLow":229,"tempHigh":216,"iconUrl":217},"hsinchu","新竹縣",27,{"locationId":231,"locationName":232,"state":213,"rain":214,"tempLow":229,"tempHigh":233,"iconUrl":217},"hsinchu_c","新竹市",31,{"locationId":235,"locationName":236,"state":213,"rain":237,"tempLow":215,"tempHigh":216,"iconUrl":217},"hualien","花蓮縣","10%",{"locationId":239,"locationName":240,"state":213,"rain":237,"tempLow":229,"tempHigh":233,"iconUrl":217},"ilan","宜蘭縣",{"locationId":242,"locationName":243,"state":213,"rain":214,"tempLow":244,"tempHigh":216,"iconUrl":217},"kaohsiung_c","高雄市",30,{"locationId":246,"locationName":247,"state":213,"rain":237,"tempLow":215,"tempHigh":244,"iconUrl":217},"keelung","基隆市",{"locationId":249,"locationName":250,"state":213,"rain":214,"tempLow":229,"tempHigh":233,"iconUrl":217},"kinmen","金門縣",{"locationId":252,"locationName":253,"state":213,"rain":214,"tempLow":254,"tempHigh":215,"iconUrl":217},"matsu","連江縣",25,{"locationId":256,"locationName":257,"state":213,"rain":214,"tempLow":229,"tempHigh":216,"iconUrl":217},"miaoli","苗栗縣",{"locationId":259,"locationName":260,"state":213,"rain":214,"tempLow":261,"tempHigh":225,"iconUrl":217},"nantou","南投縣",29,{"locationId":263,"locationName":264,"state":213,"rain":214,"tempLow":265,"tempHigh":244,"iconUrl":217},"penghu","澎湖縣",26,{"locationId":267,"locationName":268,"state":213,"rain":214,"tempLow":244,"tempHigh":225,"iconUrl":217},"pingtung","屏東縣",{"locationId":270,"locationName":271,"state":213,"rain":214,"tempLow":261,"tempHigh":221,"iconUrl":217},"taichung","臺中市",{"locationId":273,"locationName":274,"state":213,"rain":214,"tempLow":215,"tempHigh":233,"iconUrl":217},"tainan","臺南市",{"locationId":276,"locationName":277,"state":213,"rain":214,"tempLow":261,"tempHigh":225,"iconUrl":217},"taipei","新北市",{"locationId":279,"locationName":280,"state":213,"rain":214,"tempLow":261,"tempHigh":225,"iconUrl":217},"taipei_c","臺北市",{"locationId":282,"locationName":283,"state":213,"rain":237,"tempLow":215,"tempHigh":216,"iconUrl":217},"taitung","臺東縣",{"locationId":285,"locationName":286,"state":213,"rain":214,"tempLow":261,"tempHigh":287,"iconUrl":217},"taoyuen","桃園縣",35,{"locationId":289,"locationName":290,"state":213,"rain":214,"tempLow":215,"tempHigh":225,"iconUrl":217},"yunlin","雲林縣",{"status":5,"code":6,"message":292,"data":293},"新聞詳情取得成功",{"article":294,"seo":312,"extendedReading":316,"relatedNews":372},{"id":295,"title":296,"category":42,"link":297,"author":298,"location":247,"youtubeId":299,"content":300,"coverImage":301,"tags":303,"publishTime":307,"shortUrl":308,"prevLink":309,"nextLink":310,"images":311},"202601192554290","【台語新聞】基隆綠營美女刺客拚議員　推朱書昕.吳巧瀅成嬌點","\u002Fcts\u002Flocal\u002F202601\u002F202601192554290.html","綜合報導","OICSXhJCZGA","\u003Cp>\u003Cp>基隆市議員選舉中山區被地方戲稱史上超難選，因為雖然有四席，但不只老將想連任，就連新秀也積極表態參選，目前初步就呈現九搶四的局面。另外，暖暖區也競爭激烈，三位現任議員都有意願拚連任，民進黨在七堵和中正區，這次再推出兩位美女新人，分別在中山區、暖暖區，希望能再開出紅盤。\u003C\u002Fp>\u003Cp>\u003C\u002Fp>\u003Cp>車水馬龍的十字路口，粉粉的看板高高掛起，繽紛色彩成功吸引目光，年底的九合一大選，新人搶曝光更要早一步準備。外型亮眼親切有禮的吳巧瀅，從小和爸爸相依為命，小時候曾經是家扶中心的扶助兒，半工半讀完成學業，開早餐店每年都辦義賣捐贈回饋家扶中心，參選爆發力讓外界不敢小覷。\u003C\u002Fp>基隆市中山區議員參選人(民)吳巧瀅說：「一路走來，看過太多弱勢家庭，婦女與孩子需要幫助，卻常常找不到資源和管道。」基隆市中山區，去年底設籍人口，大約4萬5千5百多人，四席議員席次，現任的民進黨施偉政，國民黨宋瑋莉郭美秀，三人拚連任，謝國樑的前中山區秘書林祐德，還有同黨的前議員莊敬聖，也都爭取黨內提名，民進黨則派出美女刺客吳巧瀅，另外暖暖區有三席議員，現任的連恩典林旻勳陳冠羽，都有意願拚連任，民進黨同步派朱書昕擔任美女刺客。\u003Cp>\u003C\u002Fp>\u003Cp>基隆市暖暖區議員參選人(民)朱書昕說：「透過參選，成為暖暖區第一位女性市議員，用更細膩更全面更貼近家庭與日常的觀點，提出讓暖暖鄉親真正有感也值得期待的政策方向。」\u003C\u002Fp>\u003Cp>先生是民進黨基隆市黨部主委林明智，朱書昕在社群媒體暱稱費歐娜擁有許多鐵粉，現在是暖暖當地志工協會理事長，希望透過藝文經歷為地方創生努力，基隆市議員競爭激烈，綠營的嬌點牌就看能不能再開出紅盤。\u003C\u002Fp>\u003C\u002Fp>",{"imageUrl":302},"https:\u002F\u002Fwww.cts.com.tw\u002Fdata\u002Fnews\u002Fphoto\u002Fcts\u002F202601\u002F20260119-1258369.jpg",[304,305,247,306],"選舉","議員","中山區","2026-01-19 16:26:00","https:\u002F\u002Fctsnews.page.link\u002Fijsx1","\u002Fcts\u002Flocal\u002F202601\u002F202601192554291.html","\u002Fcts\u002Flocal\u002F202601\u002F202601192554289.html",[],{"title":313,"description":314,"keywords":315,"image":302},"【台語新聞】基隆綠營美女刺客拚議員　推朱書昕.吳巧瀅成嬌點 - 地方 - 華視新聞網","",[304,305,247,306],[317,322,327,332,337,341,346,350,354,358,363,368],{"id":318,"title":319,"link":320,"publishTime":321},"202512252547277","許甫參選稀釋泛藍選票？　李明璇：是「隊友」不是「對手」","\u002Fcts\u002Fgeneral\u002F202512\u002F202512252547277.html","2025\u002F12\u002F25",{"id":323,"title":324,"link":325,"publishTime":326},"202601292557516","台東便當業者寒冬送暖　連12年送禮金給弱勢團體","\u002Fcna\u002Flocal\u002F202601\u002F202601292557516.html","2026\u002F01\u002F29",{"id":328,"title":329,"link":330,"publishTime":331},"202512092542052","子弟兵何元楷遭爆國小霸凌同學！　羅智強：面對錯誤、承擔責任並真誠反省","\u002Fcts\u002Fpolitics\u002F202512\u002F202512092542052.html","2025\u002F12\u002F09",{"id":333,"title":334,"link":335,"publishTime":336},"202601192554197","藍營優勢區「大安文山」競爭激烈！　綠營新人7搶4","\u002Fcts\u002Fpolitics\u002F202601\u002F202601192554197.html","2026\u002F01\u002F19",{"id":338,"title":339,"link":340,"publishTime":326},"202601292557467","屏東高樹奇幻大津2\u002F5開幕　劉冠廷返鄉開箱","\u002Fcna\u002Flocal\u002F202601\u002F202601292557467.html",{"id":342,"title":343,"link":344,"publishTime":345},"202512062541283","中正萬華議員選區　藍綠白推出「三金釵」激戰","\u002Fcts\u002Fpolitics\u002F202512\u002F202512062541283.html","2025\u002F12\u002F06",{"id":347,"title":348,"link":349,"publishTime":326},"202601292557470","運動部經費挹注　花蓮縣立棒球場