            display: block;
            padding: 15px 20px;
            -webkit-box-orient: vertical;
            -webkit-line-clamp: 2;
            overflow: hidden;
            color: #fff;
            text-decoration: none;
            background-color: rgba(0, 0, 0, 1);
        }

        .immediate [role="listitem"]:nth-child(even) a {
            background-color: rgba(34, 34, 34, 1);
        }

        footer {
            width: 100%;
        }

        footer .section-social {
            height: 100px;
            background: #393939;
            text-align: center;
        }

        .section-social ul {
            padding: 0 1.5rem;
            height: 100%;
            text-align: center;
            display: -webkit-box;
            display: -ms-flexbox;
            display: flex;
            -webkit-box-pack: center;
            -ms-flex-pack: center;
            justify-content: center;
            -webkit-box-align: center;
            -ms-flex-align: center;
            align-items: center;
        }

        footer .section-social ul li {
            list-style-type: none;
            width: 42px;
            height: 42px;
            margin: 0 4%;
        }

        footer .section-footer {
            font-size: .75rem;
            background: black;
            line-height: 1.5rem;
            display: -webkit-box;
            display: -ms-flexbox;
            display: flex;
            color: white;
            padding: 1rem 0;
        }

        footer .section-footer>div {
            display: -webkit-box;
            display: -ms-flexbox;
            display: flex;
            flex-wrap: wrap;
            -webkit-box-pack: justify;
            -ms-flex-pack: justify;
            justify-content: center;
        }

        footer .section-footer .container {
            width: auto;
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 .5rem;
            display: block;
        }

        footer .section-footer .container span {
            text-align: center;
            display: block;
        }

        footer .section-footer>div .addressUri ul {
            display: -webkit-box;
            display: -ms-flexbox;
            display: flex;
            flex-wrap: nowrap;
            justify-content: space-between;
        }

        footer .section-footer>div .addressUri ul li {
            list-style-type: none;
            font-size: .75rem;
            color: white;
            margin-right: 3%;
        }

        footer .section-footer>div .addressUri ul .activeAddress {
            color: #FCC92C;
        }

        footer .section-footer>div .addressUri ul li a {
            white-space: nowrap;
            text-decoration: none;
        }

        .scrollToTop {
            font-size: 1.4em;
            width: 65px;
            height: 65px;
            border: none;
            outline: none;
            z-index: 9999;
            bottom: 1px;
            right: 1px;
            position: fixed;
            opacity: 0;
            visibility: hidden;
            background: transparent url(https://www.nownews.com/amp/images/fadetop.png) no-repeat 0 0;
            background-size: 65px 65px;
            text-indent: -9999px;
        }

        .target {
            position: relative;
        }

        .target-anchor {
            position: absolute;
            top: -72px;
            left: 0;
        }

        @media (max-width: 768px) {
            .readList {
                display: block;
            }
        }

        .amp-sticky-ad-close-button {
            min-width: 0;
        }

        .hr-separator {
            display: flex;
            align-items: center;
            text-align: center;
            color: #c0c0c0;
        }

        .hr-separator::before,
        .hr-separator::after {
            content: '';
            flex: 1;
            border-bottom: 1px solid #c0c0c0;
        }

        .hr-separator::before {
            margin-right: 0.3em;
        }

        .hr-separator::after {
            margin-left: 0.3em;
        }

        .hr-separator-noword {
            border-bottom: 1px solid #c0c0c0;
        }
        /* PK擂台 M版 文末 */
        .nnBlk.voteBlk.bg-f{background-color:#fff}
        .vote-pk-container{
          display: flex;
          flex-direction: column;
          text-align: center;
          padding: 5px;
        }
        .vote-pk-container a {
          font-size:11px;
          color: #555;
        }
        .nnBlk .box p {
          padding: 0 0;
          margin: 0 0;
          line-height: 1.25rem;
        }
        .pk-title {
          font-size: 18px;
          padding: 0.4rem 1rem;
          margin-bottom: 17px;
          border: 2px solid #888;
          box-shadow: 2px 4px 0px #888;
          border-radius: 50px;
          -webkit-border-radius: 50px;
          -moz-border-radius: 50px;
          -ms-border-radius: 50px;
        }
        .pk-title p {
          font-weight: 600;
          line-height: 0;
        }
        .pk-title p, .option-name {
          color: #222;
        }
        .pk-options {
          display: flex;
          flex-wrap: wrap;
          /* margin-right: -15px;
          margin-left: -15px; */
          padding: 0 30px;
        }
        .pk-col{
          -ms-flex-preferred-size: 0;
          flex-basis: 0;
          -ms-flex-positive: 1;
          flex-grow: 1;
          width: 38.5%;
        }
        .pk-col .option-name {
          font-size: 18px;
          font-weight: 600;
          line-height:1.1;
          width: 130px;
          word-break: break-all;
        }
        .option-img {
          display: block;
          width: 100%;
          height: 0;
          border-radius: 50%;
          background: #ccc no-repeat center / cover;
          overflow: hidden;
          margin: 0 auto 8px;
          padding-bottom: calc(100% - 10px);
          border: 5px solid #fec72c;
          box-shadow: 1px 1px 5px rgba(0, 0, 0, 0.3);
          transition: .2s;
          -webkit-transition: .2s;
          -moz-transition: .2s;
          -ms-transition: .2s;
        }
        .pk-col:hover .option-img, .pk-col:hover .option-name {
          transform: scale(1.07);
        }
        .pk-vs {
          width: 23%;
          background: url("https://www.nownews.com/NOWnews/images/vs.svg") scroll no-repeat -2px / 100% 100%;
        }
        .progress {
          display: -webkit-box;
          display: -ms-flexbox;
          display: flex;
          height: 20px;
          font-size: .75rem;
          background: #eee;
          border-radius: 3px;
          overflow: hidden;
        }
        .progress-bar {
          display: -webkit-box;
          display: -ms-flexbox;
          display: flex;
          -webkit-box-orient: vertical;
          -webkit-box-direction: normal;
          -ms-flex-direction: column;
          flex-direction: column;
          -webkit-box-pack: center;
          -ms-flex-pack: center;
          justify-content: center;
          color: #fff;
          text-align: center;
          background: #4188d9;
          transition: width .6s ease;
        }
        .opponent-bg {
          background: #e04646;
        }
        .stat {
          display: inline-flex;
          justify-content: space-between;
          width: 100%;
        }
        .stat b {
          font-size: 22px;
          color:#4188d9
        }
        .stat b.b-red{color:#e04646}
        .vote-pk-container, .vote-pk-container span, .pk-options, .progress, .stat {margin-bottom: 10px}
        .s-p, .s-n { color: #999; top:50%; filter:none; transform: translateX(0px); -webkit-transform: translateX(0px); -moz-transform: translateX(0px); -ms-transform: translateX(0px); opacity:1}
        .s-p, .s-n, .s-p:hover, .s-n:hover {background: transparent}
        .act-bullet .swiper-pagination-bullet-active {background: #fec72c}
        .act-bullet .swiper-pagination-bullet {width: 12px; height: 12px;}
        .vote-pk-container > span:last-child::before {content:"調查期間："}
        .vote-pk-container > span {font-size: 12px;color:#555;letter-spacing:0.1em}

        /**
