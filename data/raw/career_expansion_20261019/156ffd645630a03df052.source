        }
        :root {
          --swiper-navigation-size: 44px;
          --swiper-navigation-color: var(--swiper-theme-color-w);
        }
        .swiper-button-prev,
        .swiper-button-next {
          display: flex;
          align-items: center;
          justify-content: center;
          position: absolute;
          top: 55%;
          width: calc(var(--swiper-navigation-size) / 44 * 27);
          height: var(--swiper-navigation-size);
          margin-top: calc(-3.5 * var(--swiper-navigation-size) / 2);
          font-size: 1.8rem;
          padding: 3.1rem 1.1rem;
          /*background: rgba(0,0,0,.1);*/
          color: var(--swiper-navigation-color, var(--swiper-theme-color));
          filter: drop-shadow(0 0 3px rgba(0, 0, 0, 1));
          -webkit-filter: drop-shadow(0 0 3px rgba(0, 0, 0, 1));
          transition: .5s;
          -webkit-transition: .5s;
          -moz-transition: .5s;
          -ms-transition: .5s;
          opacity:0.7;
          cursor: pointer;
          z-index: 10;
        }
        .swiper-button-prev:hover, .swiper-button-next:hover {color:var(--swiper-theme-color-y);background: rgba(0,0,0,0.4);}
        .swiper-container:hover .swiper-button-prev, .swiper-container:hover .swiper-button-next {/*background: rgba(0,0,0,0.5);*/outline:none}
        .swiper-button-prev {
          transform: translateX(10px);
        }
        .swiper-button-next {
          transform: translateX(-10px);
        }
        .swiper-container:hover .swiper-button-prev, .swiper-container:hover .swiper-button-next {
          transform: translateX(0);
          opacity: 1;
          visibility: visible;
          background: rgba(0,0,0,0.5);
          filter:none;
