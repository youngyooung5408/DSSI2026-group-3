            list-style-type: none;
            padding: 15px 20px;
        }

        .immediate ul li a {
            height: 40px;
            color: #222;
            text-decoration: none;
            font-size: .875rem;
        }

        .immediate ul li:nth-child(odd) {
            background-color: rgba(0, 0, 0, .0325);
        }

