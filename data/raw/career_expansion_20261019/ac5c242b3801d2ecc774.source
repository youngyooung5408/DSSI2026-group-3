<script>
(function() {
  var web_name = "PFP-Youth";
  var now = location.href;
  var nowstr = encodeURIComponent(now);	
  var ref = document.referrer;
  var refstr = encodeURIComponent(ref);
  var pageTitle = encodeURIComponent(document.title);
  var web_page = encodeURIComponent(window.location.pathname);

  var img = new Image();
  img.src = "https://track.jumpad.com.tw/track-system2.php?wp_web=" + web_name + "&wp_page=" + web_page + "&now=" + nowstr + "&ref=" + refstr + "&wp_subject=" + pageTitle;
  img.style.display = "none";
  document.body.appendChild(img);

})();
</script>

<script>
jQuery(document).ready(function($) {
  function isLineApp() {
    return /line/i.test(navigator.userAgent);
  }

  if (isLineApp()) {
    var currentUrl = window.location.href;
    var newUrl;

    if (currentUrl.indexOf('?') > -1) {
      newUrl = currentUrl + '&openExternalBrowser=1';
    } else {
      newUrl = currentUrl + '?openExternalBrowser=1';
    }

    if (currentUrl.indexOf('openExternalBrowser=1') === -1) {
      window.location.replace(newUrl);
    }
  }
});
</script>

