    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    box-shadow: 0 4px 15px rgba(6, 199, 85, 0.08);
}

.line-bind-content {
    display: flex;
    align-items: center;
    gap: 16px;
    text-align: left;
}

.line-bind-icon {
    font-size: 2rem;
    flex-shrink: 0;
}

.line-bind-text h4 {
    font-size: 1.1rem;
    font-weight: 800;
    color: #1e293b;
    margin: 0 0 4px;
}

.line-bind-text p {
    font-size: 0.9rem;
    color: #64748b;
    line-height: 1.5;
    margin: 0;
}

.btn-join-line-oa {
    background-color: #06C755;
    color: #ffffff !important;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 700;
    padding: 12px 24px;
    border-radius: 50px;
    box-shadow: 0 4px 12px rgba(6, 199, 85, 0.25);
    transition: all 0.2s ease;
    white-space: nowrap;
    flex-shrink: 0;
}

.btn-join-line-oa:hover {
    background-color: #05b04a;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(6, 199, 85, 0.35);
}

/* ==================== 加入選務志工橫幅樣式（與 LINE 統一寬度與間距） ==================== */
.volunteer-bind-banner {
    background: linear-gradient(135deg, #fffaf5 0%, #ffffff 100%);
    border: 1.5px solid #fed7aa;
    border-radius: 16px;
    padding: 20px 24px;
    margin: 16px auto 0px;
    max-width: 900px;
    width: 80%;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    box-shadow: 0 4px 15px rgba(245, 130, 32, 0.08);
}

.volunteer-bind-content {
    display: flex;
    align-items: center;
    gap: 16px;
    text-align: left;
}

.volunteer-bind-icon {
    font-size: 2rem;
    flex-shrink: 0;
}

.volunteer-bind-text h4 {
    font-size: 1.1rem;
    font-weight: 800;
    color: #1e293b;
    margin: 0 0 4px;
}

.volunteer-bind-text p {
    font-size: 0.9rem;
    color: #64748b;
    line-height: 1.5;
    margin: 0;
}

.btn-join-volunteer-hub {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    background: linear-gradient(135deg, #f58220 0%, #e67215 100%);
    color: #ffffff !important;
    text-decoration: none !important;
    font-size: 0.95rem;
    font-weight: 700;
    padding: 12px 24px;
    border-radius: 50px;
    box-shadow: 0 4px 12px rgba(245, 130, 32, 0.25);
    transition: all 0.2s ease;
    white-space: nowrap;
    flex-shrink: 0;
}

.btn-join-volunteer-hub:hover {
    background: linear-gradient(135deg, #ff9633 0%, #f58220 100%);
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(245, 130, 32, 0.35);
}

/* 📱 手機窄螢幕 RWD 自適應 */
@media (max-width: 640px) {
    .line-bind-banner,
    .volunteer-bind-banner {
        width: 90%;
        flex-direction: column;
        align-items: stretch;
        text-align: center;
        padding: 20px 16px;
        gap: 14px;
    }
    .line-bind-content,
    .volunteer-bind-content {
        flex-direction: column;
        text-align: center;
        gap: 10px;
    }
    .btn-join-line-oa,
    .btn-join-volunteer-hub {
        width: 100%;
        text-align: center;
        box-sizing: border-box;
    }
}

/* ==================== 時間軸整體容器樣式 ==================== */
.timeline-section {
    width: 100%;
    background-color: #fff;
    padding: 40px 0;
    margin: 20px 0 40px;
    border-top: 0px dashed #e0e0e0;
    border-bottom: 0px dashed #e0e0e0;
    text-align: center;
    position: relative;
    box-sizing: border-box;
}

.timeline-main-title {
    font-size: 1.5rem;
    font-weight: 900;
    color: var(--text-dark, #231815);
    margin: 0 0 30px 0;
    letter-spacing: 1px;
}

.timeline-scroll-container {
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 20px 0 30px;
    cursor: grab;
    scrollbar-width: thin;
    scrollbar-color: rgba(245, 130, 32, 0.3) transparent;
}

.timeline-scroll-container:active {
    cursor: grabbing;
}

.timeline-track {
    display: inline-flex;
    position: relative;
    padding: 0 50px;
    min-width: 100%;
    justify-content: flex-start;
    align-items: flex-start;
}

.timeline-line {
    position: absolute;
    top: 47px;
    left: 0;
    right: 0;
    height: 2px;
    background: #ffd3b6;
    z-index: 1;
}

.timeline-item {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 160px;
    max-width: 180px;
    padding: 0 10px;
    flex-shrink: 0;
}

.timeline-date {
    font-size: 0.85rem;
    color: #888;
    font-weight: 600;
    height: 35px;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    font-family: 'Courier New', monospace, sans-serif;
}

.timeline-dot-wrap {
    width: 24px;
    height: 24px;
    background: #fafafa;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
}

.timeline-dot {
    width: 12px;
    height: 12px;
    background-color: var(--main-orange, #F58220);
    border-radius: 50%;
    box-shadow: 0 0 0 4px rgba(245, 130, 32, 0.2);
    transition: transform 0.2s ease, background-color 0.2s ease;
}

.timeline-item:hover .timeline-dot {
    transform: scale(1.3);
    background-color: var(--dark-orange, #E67215);
    box-shadow: 0 0 0 6px rgba(245, 130, 32, 0.3);
}

.timeline-content {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-dark, #231815);
    line-height: 1.4;
    text-align: left;
    word-break: break-word;
}

.timeline-content a {
    color: var(--text-dark, #231815);
    text-decoration: none;
    transition: color 0.2s ease;
}

.timeline-content a:hover {
    color: var(--main-orange, #F58220);
    text-decoration: underline;
}

@media (max-width: 768px) {
    .timeline-item {
        min-width: 140px;
        max-width: 160px;
    }
    .timeline-date {
        font-size: 0.78rem;
        height: 30px;
    }
    .timeline-line {
        top: 42px;
    }
    .timeline-content {
        font-size: 0.88rem;
    }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const slider = document.getElementById('timelineScroll');
    if (!slider) return;
    
    let isDown = false;
    let startX;
    let scrollLeft;

    slider.addEventListener('mousedown', (e) => {
        isDown = true;
        slider.classList.add('active');
        startX = e.pageX - slider.offsetLeft;
        scrollLeft = slider.scrollLeft;
    });

    slider.addEventListener('mouseleave', () => {
        isDown = false;
    });

    slider.addEventListener('mouseup', () => {
        isDown = false;
    });

    slider.addEventListener('mousemove', (e) => {
        if (!isDown) return;
        e.preventDefault();
        const x = e.pageX - slider.offsetLeft;
        const walk = (x - startX) * 1.5;
        slider.scrollLeft = scrollLeft - walk;
    });
});
</script>
