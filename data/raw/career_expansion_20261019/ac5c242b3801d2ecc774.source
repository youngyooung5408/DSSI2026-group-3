<style>
/* 🌟 徹底消除 Visual Portfolio 相簿與圖片容器的灰色背景 */
.vp-portfolio,
.vp-portfolio__items-wrap,
.vp-portfolio__items,
.vp-portfolio__item,
.vp-portfolio__item-img-wrap,
.vp-portfolio__item-img {
    background: transparent !important;
    background-color: transparent !important;
}

.vp-portfolio__item-img-wrap {
    padding: 0px !important;
}

.vp-portfolio,
.vp-portfolio * {
    --vp-item-bg: transparent !important;
    --vp-item-img-bg: transparent !important;
}

.vp-portfolio__item-img a > img[data-skip-lazy] {
    display: none !important;
}

/* 🌟 1. 輪播主容器：乾淨邊界排版 */
.vp-portfolio[data-vp-layout="slider"] {
    position: relative !important;
    padding: 10px 0 15px 0 !important; 
    overflow: hidden !important;
}

.vp-portfolio[data-vp-layout="slider"] .vp-portfolio__items-wrap,
.vp-portfolio[data-vp-layout="slider"] .swiper-container,
.vp-portfolio[data-vp-layout="slider"] .swiper {
    overflow: hidden !important;
}

/* ❌ 2. 徹底隱藏左右箭頭 */
.vp-portfolio__items-arrow,
.vp-portfolio__items-arrow-prev,
.vp-portfolio__items-arrow-next {
    display: none !important;
}

/* 🌟 3. 強制直角 (border-radius: 0) + 統一 4:3 裁切填滿質感 */
.vp-portfolio__items .swiper-slide,
.vp-portfolio__items .vp-portfolio__item-wrap,
.vp-portfolio__items .vp-portfolio__item,
.vp-portfolio__items .vp-portfolio__item-img-wrap,
.vp-portfolio__items .vp-portfolio__item-img,
.vp-portfolio__items .vp-portfolio__item-overlay {
    border-radius: 0px !important;
    height: 100% !important;
    display: flex;
}

.vp-portfolio__items .vp-portfolio__item-img a,
.vp-portfolio__items .vp-portfolio__item-img img {
    width: 100% !important;
    height: 100% !important;
    aspect-ratio: 4 / 3 !important; /* 強制所有圖片統一 4:3 比例 */
    object-fit: cover !important;  /* 精準裁切並填滿，絕不拉伸變形 */
    display: block !important;
    border-radius: 0px !important;
}

.vp-portfolio__items .vp-portfolio__item {
    width: 100%;
}
</style>

<!-- 🌟 強效 Swiper 初始化（純自動播放，無箭頭） -->
<script>
(function($) {
    $(document).ready(function() {
        $('.vp-portfolio[data-vp-layout="slider"]').each(function() {
            var $vp = $(this);
            var $swiperContainer = $vp.find('.vp-portfolio__items-wrap');
            var $items = $vp.find('.vp-portfolio__items');

            // 1. 補齊 Swiper 結構 Class
            $swiperContainer.addClass('swiper-container swiper');
            $items.addClass('swiper-wrapper');
            $items.children('.vp-portfolio__item-wrap').addClass('swiper-slide');

            // 2. 初始化 Swiper 實例
            if (typeof Swiper !== 'undefined') {
                new Swiper($swiperContainer[0], {
                    slidesPerView: 3,           // 電腦版一次 3 張
                    spaceBetween: 15,           // 卡片間距
                    loop: true,                 // 無限循環
                    speed: 600,                 // 切換速度
                    autoplay: {
                        delay: 3000,            // 3 秒自動輪播
                        disableOnInteraction: false, // 滑動後繼續 Autoplay
                        pauseOnMouseEnter: true     // 滑鼠移入暫停
                    },
                    breakpoints: {
                        320: { slidesPerView: 1, spaceBetween: 10 },
                        768: { slidesPerView: 2, spaceBetween: 15 },
                        1024: { slidesPerView: 3, spaceBetween: 15 }
                    },
                    observer: true,
                    observeParents: true
                });
            }
        });
    });
})(jQuery);
</script>

