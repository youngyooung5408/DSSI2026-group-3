<!-- Broadcast -->
<!-- 🌟 前台全站廣播 Popup 燈箱 UI & 腳本 -->
<div id="broadcast-popup" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.7); z-index: 99999; justify-content: center; align-items: center; padding: 20px; box-sizing: border-box;">
    <div style="position: relative; max-width: 500px; width: 100%; background: #fff; border-radius: 16px; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.5); text-align: left; animation: broadcast-zoomIn 0.3s ease;">
        
        <!-- 右上角關閉按鈕 -->
        <button onclick="closeBroadcastPopup()" style="position: absolute; top: 12px; right: 12px; background: rgba(0,0,0,0.5); color: #fff; border: none; width: 32px; height: 32px; border-radius: 50%; cursor: pointer; font-size: 18px; font-weight: bold; z-index: 10; display: flex; align-items: center; justify-content: center;">✕</button>

        <!-- 1. 圖片區塊 -->
        <div id="broadcast-img-wrap" style="display: none;">
            <a id="broadcast-img-link" href="#" target="_blank" style="display: block; text-decoration: none;">
                <img id="broadcast-img" src="" alt="廣播圖片" style="width: 100%; height: auto; display: block; max-height: 50vh; object-fit: contain; background: #111;">
            </a>
        </div>

        <!-- 2. HTML 文字區塊 -->
        <div id="broadcast-text-wrap" style="display: none; padding: 25px 20px 15px 20px; max-height: 40vh; overflow-y: auto; color: #333; line-height: 1.6;">
            <div id="broadcast-text-content"></div>
            
            <!-- 如果只有文字且有連結，額外顯示跳轉按鈕 -->
            <div id="broadcast-btn-wrap" style="display: none; margin-top: 15px; text-align: center;">
                <a id="broadcast-text-link" href="#" target="_blank" style="display: inline-block; background: #F58220; color: #fff; text-decoration: none; padding: 10px 25px; border-radius: 25px; font-weight: bold; box-shadow: 0 4px 10px rgba(245,130,32,0.3);">前往了解 ➔</a>
            </div>
        </div>

        <!-- 3. 底部狀態欄 -->
        <div style="padding: 12px 20px; background: #231815; color: #fff; display: flex; justify-content: space-between; align-items: center; font-size: 0.85rem;">
            <label style="cursor: pointer; display: flex; align-items: center; gap: 6px;">
                <input type="checkbox" id="broadcast-today-disable" onchange="dismissBroadcastToday()"> 今日不再顯示
            </label>
            <span style="color: #F58220; font-weight: bold; cursor: pointer;" onclick="closeBroadcastPopup()">關閉公告</span>
        </div>
    </div>
</div>

<style>
@keyframes broadcast-zoomIn {
    from { opacity: 0; transform: scale(0.85); }
    to { opacity: 1; transform: scale(1); }
}
/* 廣播文字內的標籤預設樣式 */
#broadcast-text-content h1, 
#broadcast-text-content h2, 
#broadcast-text-content h3 { margin-top: 0; color: #231815; }
#broadcast-text-content p { margin-bottom: 10px; }
#broadcast-text-content a { color: #F58220; text-decoration: underline; }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // 檢查今天是否已點選「今日不再顯示」
    const dismissDate = localStorage.getItem('broadcast_dismiss_date');
    const today = new Date().toDateString();
    if (dismissDate === today) return;

    fetch('/2026/broadcast_setting.json?t=' + new Date().getTime())
        .then(response => {
            if (!response.ok) throw new Error('Network error');
            return response.json();
        })
        .then(data => {
            // 1. 檢查啟用狀態
            if (data.enabled !== '1') return;

            // 2. 檢查自動下架時間
            if (data.auto_close_datetime) {
                const now = new Date();
                const expireTime = new Date(data.auto_close_datetime);
                if (now >= expireTime) return;
            }

            const hasImg = data.image_url && data.image_url.trim() !== '';
            const hasText = data.content_html && data.content_html.trim() !== '';
            const hasLink = data.link_url && data.link_url.trim() !== '';

            // 如果既沒有圖也沒有文，就不顯示
            if (!hasImg && !hasText) return;

            // A. 處理圖片
            if (hasImg) {
                document.getElementById('broadcast-img').src = data.image_url;
                const imgWrap = document.getElementById('broadcast-img-wrap');
                imgWrap.style.display = 'block';
                
                if (hasLink) {
                    document.getElementById('broadcast-img-link').href = data.link_url;
                } else {
                    document.getElementById('broadcast-img-link').removeAttribute('href');
                }
            }

            // B. 處理 HTML 文字
            if (hasText) {
                document.getElementById('broadcast-text-content').innerHTML = data.content_html;
                document.getElementById('broadcast-text-wrap').style.display = 'block';

                // 如果只有文字沒有圖片，且有填連結，顯示按鈕
                if (!hasImg && hasLink) {
                    document.getElementById('broadcast-text-link').href = data.link_url;
                    document.getElementById('broadcast-btn-wrap').style.display = 'block';
                }
            }

            // 顯示彈窗
            document.getElementById('broadcast-popup').style.display = 'flex';
        })
        .catch(err => console.log('BroadCast status:', err));
});

function closeBroadcastPopup() {
    document.getElementById('broadcast-popup').style.display = 'none';
}

function dismissBroadcastToday() {
    const chk = document.getElementById('broadcast-today-disable');
    if (chk && chk.checked) {
        localStorage.setItem('broadcast_dismiss_date', new Date().toDateString());
        setTimeout(closeBroadcastPopup, 200);
    }
}
</script>
<!-- Broadcast end -->
