<!-- ==================== 腳本區 (JavaScript) ==================== -->
<script>
// 🌟 核心：分享懸浮選單開關與平台跳轉邏輯
function toggleShareMenu() {
    const menu = document.getElementById('share-menu-box');
    const icon = document.getElementById('fab-share-icon');
    if (!menu) return;
    
    menu.classList.toggle('active');
    if (menu.classList.contains('active')) {
        if (icon) icon.innerText = '✖️';
    } else {
        if (icon) icon.innerText = '📢';
    }
}

// 點擊頁面其他空白區域時，自動收合分享選單
document.addEventListener('click', function(e) {
    const shareWrapper = document.querySelector('.floating-share-wrapper');
    const menu = document.getElementById('share-menu-box');
    const icon = document.getElementById('fab-share-icon');
    if (shareWrapper && !shareWrapper.contains(e.target) && menu && menu.classList.contains('active')) {
        menu.classList.remove('active');
        if (icon) icon.innerText = '📢';
    }
});

// 分享到不同平台的觸發函數
function shareToPlatform(platform) {
    const currentUrl = encodeURIComponent(window.location.href);
    const pageTitle = encodeURIComponent(document.title);
    let targetUrl = '';

    switch(platform) {
        case 'line':
            targetUrl = `https://line.me/R/share?text=${pageTitle}%20${currentUrl}`;
            break;
        case 'threads':
            targetUrl = `https://www.threads.net/intent/post?text=${pageTitle}%20${currentUrl}`;
            break;
        case 'fb':
            targetUrl = `https://www.facebook.com/sharer/sharer.php?u=${currentUrl}`;
            break;
    }

    if (targetUrl) {
        window.open(targetUrl, '_blank', 'width=600,height=500,scrollbars=yes,resizable=yes');
    }
}

(function() {
    let currentScale = 1; 
    let currentX = 0; 
    let currentY = 0;
    let isDragging = false; 
    let startX = 0, startY = 0; 
    let initialPinchDistance = null;

    // 2. 政治獻金抽屜控制
    window.toggleDonationBox = function() {
        const box = document.getElementById('donation-info-box');
        if (!box) return;

        if (box.style.display === 'none' || box.style.maxHeight === '0px') {
            box.style.display = 'block';
            setTimeout(() => {
                box.style.maxHeight = '300px'; 
                box.style.opacity = '1';
                box.style.marginTop = '15px';
            }, 10);
        } else {
            box.style.maxHeight = '0px'; 
            box.style.opacity = '0';
            box.style.marginTop = '0px';
            setTimeout(() => { box.style.display = 'none'; }, 350);
        }
    };

    // 3. 一鍵複製系統
    window.copyToClipboard = function(text, buttonElement) {
        navigator.clipboard.writeText(text).then(function() {
            const textSpan = buttonElement.querySelector('.btn-text');
            const iconSpan = buttonElement.querySelector('.btn-icon');
            
            buttonElement.classList.add('copied');
            if(textSpan) textSpan.innerText = '已複製成功！';
            if(iconSpan) iconSpan.innerText = '✔️';
            
            setTimeout(function() {
                buttonElement.classList.remove('copied');
                if(textSpan) textSpan.innerText = '複製';
                if(iconSpan) iconSpan.innerText = '📋';
            }, 1500);
        }, function(err) {
            alert('複製失敗，請手動選取複製：\n' + text);
        });
    };

    // 3. 電話抽屜控制
    window.togglePhoneBox = function() {
        const box = document.getElementById('phone-info-box');
        if (!box) return;

        if (box.style.display === 'none' || box.style.maxHeight === '0px') {
            box.style.display = 'block';
            setTimeout(() => {
                box.style.maxHeight = '200px'; 
                box.style.opacity = '1';
                box.style.marginTop = '15px';
            }, 10);
        } else {
            box.style.maxHeight = '0px'; 
            box.style.opacity = '0';
            box.style.marginTop = '0px';
            setTimeout(() => { box.style.display = 'none'; }, 350);
        }
    };

    // 4. 地址與地圖抽屜控制
    window.toggleAddressBox = function() {
        const box = document.getElementById('address-info-box');
        if (!box) return;

        if (box.style.display === 'none' || box.style.maxHeight === '0px') {
            box.style.display = 'block';
            setTimeout(() => {
                box.style.maxHeight = '450px';
                box.style.opacity = '1';
                box.style.marginTop = '15px';
            }, 10);
        } else {
            box.style.maxHeight = '0px'; 
            box.style.opacity = '0';
            box.style.marginTop = '0px';
            setTimeout(() => { box.style.display = 'none'; }, 350);
        }
    };

    // 4. Lightbox 燈箱開關與更新
    window.openCashModal = function() { 
        const cashModal = document.getElementById('cashModal');
        if(cashModal) {
            currentScale = 1; currentX = 0; currentY = 0; 
            updateTransform(); 
            cashModal.style.display = 'flex'; 
            document.body.style.overflow = 'hidden'; 
            bindCashEvents(); 
        }
    };

    window.closeCashModal = function(e) { 
        const cashModal = document.getElementById('cashModal');
        const cashImgContainer = document.querySelector('.cash-img-container');
        if (cashModal && (e.target === cashModal || e.target === cashImgContainer)) { 
            forceCloseCashModal(); 
        } 
    };

    window.forceCloseCashModal = function() { 
        const cashModal = document.getElementById('cashModal');
        if(cashModal) {
            cashModal.style.display = 'none'; 
            document.body.style.overflow = 'auto'; 
            unbindCashEvents(); 
        }
    };

    window.zoomCash = function(amount) { 
        currentScale += amount; 
        updateTransform(); 
    };

    function updateTransform() { 
        const cashImg = document.getElementById('cashImg');
        if (cashImg) {
            if (currentScale < 0.8) currentScale = 0.8; 
            if (currentScale > 4) currentScale = 4; 
            cashImg.style.transform = `translate(${currentX}px, ${currentY}px) scale(${currentScale})`; 
        }
    }

    // 5. 手勢拖曳與縮放核心邏輯
    function handleStart(e) {
        const touchCount = e.touches ? e.touches.length : 1;
        if (touchCount === 2) { 
            initialPinchDistance = Math.hypot(
                e.touches[0].pageX - e.touches[1].pageX, 
                e.touches[0].pageY - e.touches[1].pageY
            ); 
        } else { 
            isDragging = true; 
            const pageX = e.touches ? e.touches[0].pageX : e.pageX; 
            const pageY = e.touches ? e.touches[0].pageY : e.pageY; 
            startX = pageX - currentX; 
            startY = pageY - currentY; 
        }
    }

    function handleMove(e) {
        if (e.touches && e.touches.length === 2) { 
            if (!initialPinchDistance) return; 
            const currentDistance = Math.hypot(
                e.touches[0].pageX - e.touches[1].pageX, 
                e.touches[0].pageY - e.touches[1].pageY
            ); 
            currentScale = currentScale * (currentDistance / initialPinchDistance); 
            initialPinchDistance = currentDistance; 
            updateTransform(); 
        } else if (isDragging) { 
            e.preventDefault(); 
            const pageX = e.touches ? e.touches[0].pageX : e.pageX; 
            const pageY = e.touches ? e.touches[0].pageY : e.pageY; 
            currentX = pageX - startX; 
            currentY = pageY - startY; 
            updateTransform(); 
        }
    }

    function handleEnd() { 
        isDragging = false; 
        initialPinchDistance = null; 
    }

    // 6. 安全監聽器綁定與移除機制
    function bindCashEvents() { 
        const cashImgContainer = document.querySelector('.cash-img-container');
        if(cashImgContainer){ 
            unbindCashEvents();
            
            cashImgContainer.addEventListener('mousedown', handleStart); 
            window.addEventListener('mousemove', handleMove); 
            window.addEventListener('mouseup', handleEnd); 
            cashImgContainer.addEventListener('touchstart', handleStart, { passive: false }); 
            cashImgContainer.addEventListener('touchmove', handleMove, { passive: false }); 
            cashImgContainer.addEventListener('touchend', handleEnd); 
        } 
    }

    function unbindCashEvents() { 
        const cashImgContainer = document.querySelector('.cash-img-container');
        if(cashImgContainer){ 
            cashImgContainer.removeEventListener('mousedown', handleStart); 
            window.removeEventListener('mousemove', handleMove); 
            window.removeEventListener('mouseup', handleEnd); 
            cashImgContainer.removeEventListener('touchstart', handleStart); 
            cashImgContainer.removeEventListener('touchmove', handleMove); 
            cashImgContainer.removeEventListener('touchend', handleEnd); 
        } 
    }
})();

// D. 網址參數自動繼承防線 (Demo Mode)
window.addEventListener('DOMContentLoaded', () => {
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('demo') === 'true') {
        document.querySelectorAll('a').forEach(a => {
            let href = a.getAttribute('href');
            if (href && !href.startsWith('javascript:') && !href.startsWith('#')) {
                try {
                    const url = new URL(href, window.location.href);
                    url.searchParams.set('demo', 'true');
                    if (url.origin === window.location.origin) { a.href = url.pathname + url.search; }
                } catch(e) {}
            }
        });
    }
});

// E. jumpAD 軌跡追蹤系統
(function() {
  var web_name = "PFP-Youth"; 
  var now = location.href; 
  var nowstr = encodeURIComponent(now);
  var ref = document.referrer;
  var refstr = encodeURIComponent(ref);
  var pageTitle = encodeURIComponent(document.title);
  var web_page = encodeURIComponent(window.location.pathname);
  var img = new Image();
  img.src = "https://track.jumpad.com.tw/track-system2.php?wp_web=" + web_name + "&wp_page=" + web_page + "&now=" + nowstr + "&ref=" + refstr + "&wp_subject=" + pageTitle; img.style.display = "none"; document.body.appendChild(img);
})();
</script>


<!-- 🌟 前台全站廣播 Popup 燈箱 UI & 腳本 -->
<div id="broadcast-popup" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.7); z-index: 99999; justify-content: center; align-items: center; padding: 20px; box-sizing: border-box;">
    <div style="position: relative; max-width: 500px; width: 100%; background: #fff; border-radius: 16px; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.5); text-align: left; animation: broadcast-zoomIn 0.3s ease;">
        
        <!-- 右上角關閉按鈕 -->
        <button onclick="closeBroadcastPopup()" style="position: absolute; top: 12px; right: 12px; background: rgba(0,0,0,0.5); color: #fff; border: none; width: 32px; height: 32px; border-radius: 50%; cursor: pointer; font-size: 18px; font-weight: bold; z-index: 10; display: flex; align-items: center; justify-content: center;">✕</button>

        <!-- 1. 圖片區塊 -->
        <div id="broadcast-img-wrap" style="display: none;">
            <a id="broadcast-img-link" href="#" target="_blank" style="display: block; text-decoration: none;">
                <img id="broadcast-img" src="" alt="廣播圖片" style="width: 100%; height: auto; display: block; max-height: 50vh; object-fit: contain; background: #111;">
            </a>
        </div>

        <!-- 2. HTML 文字區塊 -->
        <div id="broadcast-text-wrap" style="display: none; padding: 25px 20px 15px 20px; max-height: 40vh; overflow-y: auto; color: #333; line-height: 1.6;">
            <div id="broadcast-text-content"></div>
            
            <!-- 如果只有文字且有連結，額外顯示跳轉按鈕 -->
            <div id="broadcast-btn-wrap" style="display: none; margin-top: 15px; text-align: center;">
                <a id="broadcast-text-link" href="#" target="_blank" style="display: inline-block; background: #F58220; color: #fff; text-decoration: none; padding: 10px 25px; border-radius: 25px; font-weight: bold; box-shadow: 0 4px 10px rgba(245,130,32,0.3);">前往了解 ➔</a>
            </div>
        </div>

        <!-- 3. 底部狀態欄 -->
        <div style="padding: 12px 20px; background: #231815; color: #fff; display: flex; justify-content: space-between; align-items: center; font-size: 0.85rem;">
            <label style="cursor: pointer; display: flex; align-items: center; gap: 6px;">
                <input type="checkbox" id="broadcast-today-disable" onchange="dismissBroadcastToday()"> 今日不再顯示
            </label>
            <span style="color: #F58220; font-weight: bold; cursor: pointer;" onclick="closeBroadcastPopup()">關閉公告</span>
        </div>
    </div>
</div>

<style>
@keyframes broadcast-zoomIn {
    from { opacity: 0; transform: scale(0.85); }
    to { opacity: 1; transform: scale(1); }
}
/* 廣播文字內的標籤預設樣式 */
#broadcast-text-content h1, 
#broadcast-text-content h2, 
#broadcast-text-content h3 { margin-top: 0; color: #231815; }
#broadcast-text-content p { margin-bottom: 10px; }
#broadcast-text-content a { color: #F58220; text-decoration: underline; }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // 檢查今天是否已點選「今日不再顯示」
    const dismissDate = localStorage.getItem('broadcast_dismiss_date');
    const today = new Date().toDateString();
    if (dismissDate === today) return;

    fetch('/2026/broadcast_setting.json?t=' + new Date().getTime())
        .then(response => {
            if (!response.ok) throw new Error('Network error');
            return response.json();
        })
        .then(data => {
            // 1. 檢查啟用狀態
            if (data.enabled !== '1') return;

            // 2. 檢查自動下架時間
            if (data.auto_close_datetime) {
                const now = new Date();
                const expireTime = new Date(data.auto_close_datetime);
                if (now >= expireTime) return;
            }

            const hasImg = data.image_url && data.image_url.trim() !== '';
            const hasText = data.content_html && data.content_html.trim() !== '';
            const hasLink = data.link_url && data.link_url.trim() !== '';

            // 如果既沒有圖也沒有文，就不顯示
            if (!hasImg && !hasText) return;

            // A. 處理圖片
            if (hasImg) {
                document.getElementById('broadcast-img').src = data.image_url;
                const imgWrap = document.getElementById('broadcast-img-wrap');
                imgWrap.style.display = 'block';
                
                if (hasLink) {
                    document.getElementById('broadcast-img-link').href = data.link_url;
                } else {
                    document.getElementById('broadcast-img-link').removeAttribute('href');
                }
            }

            // B. 處理 HTML 文字
            if (hasText) {
                document.getElementById('broadcast-text-content').innerHTML = data.content_html;
                document.getElementById('broadcast-text-wrap').style.display = 'block';

                // 如果只有文字沒有圖片，且有填連結，顯示按鈕
                if (!hasImg && hasLink) {
                    document.getElementById('broadcast-text-link').href = data.link_url;
                    document.getElementById('broadcast-btn-wrap').style.display = 'block';
                }
            }

            // 顯示彈窗
            document.getElementById('broadcast-popup').style.display = 'flex';
        })
        .catch(err => console.log('BroadCast status:', err));
});

function closeBroadcastPopup() {
    document.getElementById('broadcast-popup').style.display = 'none';
}

function dismissBroadcastToday() {
    const chk = document.getElementById('broadcast-today-disable');
    if (chk && chk.checked) {
        localStorage.setItem('broadcast_dismiss_date', new Date().toDateString());
        setTimeout(closeBroadcastPopup, 200);
    }
}
</script>
