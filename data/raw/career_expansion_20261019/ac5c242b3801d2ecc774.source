	.history-item-right{margin-top:120px;margin-bottom:30px;display:inline-block;width:90%;max-width:500px;padding-left:15px;padding-top:5px;/*border-top:1px dashed #aaa;text-align:left;*/}
	.history-header-left{text-align:right;}
