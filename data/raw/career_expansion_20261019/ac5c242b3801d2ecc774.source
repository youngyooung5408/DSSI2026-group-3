<script>
var guideChatHistory = [];

// 取得或建立本次階段的唯一識別碼
function getGuideSessionUuid() {
    var uuid = sessionStorage.getItem('pfp_ai_guide_uuid');
    if (!uuid) {
        uuid = 'G_' + Date.now() + '_' + Math.random().toString(36).substring(2, 9);
        sessionStorage.setItem('pfp_ai_guide_uuid', uuid);
    }
    return uuid;
}

function toggleGuideChat() {
    var drawer = document.getElementById('aiGuideDrawer');
    if (!drawer) return;
    if (drawer.style.display === 'flex') {
        drawer.style.display = 'none';
    } else {
        drawer.style.display = 'flex';
        setTimeout(function() {
            var input = document.getElementById('guideUserInput');
            if (input) input.focus();
        }, 150);
    }
}

function handleGuideInput(e) {
    if (e.key === 'Enter') {
        sendGuideMessage();
    }
}

function sendQuickQuery(text) {
    var input = document.getElementById('guideUserInput');
    if (input) {
        input.value = text;
        sendGuideMessage();
    }
}

function sendGuideMessage() {
    var input = document.getElementById('guideUserInput');
    var msg = input ? input.value.trim() : '';
    if (!msg) return;

    input.value = '';
    appendGuideMessage('user', msg);

    var quickTags = document.getElementById('guideQuickTags');
    if (quickTags) quickTags.style.display = 'none';

    var loadingId = appendGuideMessage('bot', '🍊 小桔正在翻閱親民黨智庫與站點，請稍候...');

    fetch('/hub/ai/api-guide.php', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
            message: msg,
            history: guideChatHistory.slice(-6),
            session_uuid: getGuideSessionUuid(),
            page_source: window.location.href
        })
    })
    .then(function(res) { return res.json(); })
    .then(function(data) {
        removeGuideLoading(loadingId);
        if (data.status === 'success') {
            appendGuideMessage('bot', data.reply, data.model, data.duration_ms);
            guideChatHistory.push({ role: 'user', text: msg });
            guideChatHistory.push({ role: 'model', text: data.reply });
        } else {
            appendGuideMessage('bot', '⚠️ ' + (data.message || '連線稍微塞車，請再問一次喔！'));
        }
    })
    .catch(function(err) {
        removeGuideLoading(loadingId);
        appendGuideMessage('bot', '⚠️ 網路連線稍微延遲，請重新發送提問！');
    });
}

function appendGuideMessage(sender, rawText, modelName, durationMs) {
    var box = document.getElementById('guideMessages');
    if (!box) return null;
    var msgDiv = document.createElement('div');
    var id = 'gmsg_' + Date.now() + Math.floor(Math.random() * 100);
    msgDiv.id = id;
    msgDiv.className = 'guide-msg guide-msg-' + sender;

    var bubble = document.createElement('div');
    bubble.className = 'msg-bubble';

    if (sender === 'user') {
        bubble.innerText = rawText;
    } else {
        var html = rawText;

        // 🌟 步驟 1：使用 Token 陣列保護已建立的 HTML 標籤，徹底防止二次取代
        var linksPool = [];

        // 處理 [標題文字](網址)
        html = html.replace(/\[([^\]]+)\]\((https?:\/\/[^\s\)]+)\)/g, function(match, label, url) {
            var token = '___AI_LINK_' + linksPool.length + '___';
            linksPool.push(buildLinkButton(url, label));
            return token;
        });

        // 處理獨立純網址（嚴格排除結尾括號、星號、反引號與標點）
        html = html.replace(/(https?:\/\/[^\s\)\*\]\<\>`。，！？；：]+)/g, function(url) {
            var token = '___AI_LINK_' + linksPool.length + '___';
            linksPool.push(buildLinkButton(url));
            return token;
        });

        // 🌟 步驟 2：處理 Markdown 粗體語法 **文字** -> <b>文字</b>
        html = html.replace(/\*\*([^*]+)\*\*/g, '<b>$1</b>');

        // 🌟 步驟 3：清理被括號包裹的 Token，如 (___AI_LINK_0___)
        html = html.replace(/\(\s*(___AI_LINK_\d+___)\s*\)/g, '$1');

        // 🌟 步驟 4：將 Token 安全還原為 HTML 標籤
        html = html.replace(/___AI_LINK_(\d+)___/g, function(match, idx) {
            return linksPool[idx] || '';
        });

        // 🌟 步驟 5：將換行字元轉為 <br>
        html = html.replace(/\n/g, '<br>');

        // 🌟 步驟 6：若有回傳模型資訊，在訊息底部顯示綠燈連線標籤
        if (modelName) {
            var costText = durationMs ? (' (' + (durationMs / 1000).toFixed(1) + 's)') : '';
            html += '<div class="ai-live-tag">'
                 +  '<span class="ai-live-dot"></span>'
                 +  modelName + ' 即時運算' + costText
                 +  '</div>';
        }

        bubble.innerHTML = html;
    }

    msgDiv.appendChild(bubble);
    box.appendChild(msgDiv);
    box.scrollTop = box.scrollHeight;
    return id;
}

// 統一生產按鈕輔助函式
function buildLinkButton(url, customLabel) {
    var cleanUrl = url.trim().replace(/[\)\]\*_~`。，！？；：]+$/, '');

    // 判斷是否為政策專屬帶參連結
    if (cleanUrl.indexOf('/hub/ai/index.php?q=') !== -1 || cleanUrl.indexOf('/hub/ai/?q=') !== -1) {
        var keyword = '';
        try {
            var u = new URL(cleanUrl);
            keyword = u.searchParams.get('q') || '';
        } catch(e) {
            var parts = cleanUrl.split('q=');
            if (parts.length > 1) keyword = decodeURIComponent(parts[1].split('&')[0]);
        }
        var btnLabel = customLabel || (keyword ? '🔍 查閱【' + keyword + '】深度政見 ↗' : '🔍 前往查看深度政見 ↗');
        return '<a href="' + cleanUrl + '" target="_blank" class="msg-link-btn msg-link-policy">' + btnLabel + '</a>';
    }

    // 一般頁面導覽按鈕
    var label = customLabel ? ('🔗 ' + customLabel + ' ↗') : '🔗 前往此頁面 ↗';
    return '<a href="' + cleanUrl + '" target="_blank" class="msg-link-btn">' + label + '</a>';
}

function removeGuideLoading(id) {
    var el = document.getElementById(id);
    if (el) el.remove();
}
</script>
