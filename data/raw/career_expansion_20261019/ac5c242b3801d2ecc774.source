<!DOCTYPE html>
<html lang="zh-TW" class="vp-lazyload-enabled">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>[自由時報]基隆市議員選舉 親民黨推3女將</title>
    <meta property="og:image" content="https://youth.pfpnext.com/wp-content/uploads/2026/08/5531833_1_1.jpg"/>
    
    <style>
        /* --- 全域現代化設定 --- */
        :root {
            --pfp-orange: #F58220;
            --pfp-dark: #231815;
            --text-color: #2c3e50;
            --bg-color: #ffffff;
        }

        * { box-sizing: border-box; -webkit-font-smoothing: antialiased; }

        body {
            font-family: "PingFang TC", "Microsoft JhengHei", sans-serif;
            line-height: 1.8;
            color: var(--text-color);
            background-color: var(--bg-color);
            margin: 0; padding: 0;
            overflow-x: hidden;
        }

        .article-container {
            max-width: 800px;
            margin: 0 auto;
            padding: 80px 25px;
        }

        .article-header { text-align: center; margin-bottom: 60px; }
        .article-date { 
            font-size: 0.9rem; color: #95a5a6; 
            letter-spacing: 2px; display: block; margin-bottom: 15px; 
        }
        .article-title { 
            font-size: 2.3rem !important; /* 桌機版標題加大 (約 36px ~ 38px) */ font-weight: 800; line-height: 1.4; color: var(--pfp-dark); margin: 0; text-align:left;
        }

        .article-body { font-size: 1.15rem; color: #333; }
        
        .article-body img, 
        .article-body .rwd-video {
            width: 100% !important;
            max-width: 100% !important;
            height: auto !important;
            display: block;
            margin: 30px auto;
            border-radius: 12px;
        }
        .article-body iframe { width:100%; height:450px; }
        .more { display:inline-block; padding:5px 20px; border-radius:20px; border:1px solid #EA7500; background:#EA7500; }

        /* 🌟 文章標籤 (Article Tags) 樣式 */
        .article-tags-wrap {
            text-align: center;
            margin-top: 50px;
            margin-bottom: 20px;
        }
        .article-tags-list {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 10px;
            list-style: none;
            padding: 0;
            margin: 0;
        }
        .article-tag-item a {
            display: inline-block;
            padding: 6px 16px;
            font-size: 0.9rem;
            color: var(--pfp-dark);
            background-color: #f5f5f7;
            border-radius: 50px;
            text-decoration: none;
            transition: all 0.2s ease;
        }
        .article-tag-item a:hover {
            background-color: var(--pfp-orange);
            color: #ffffff;
            transform: translateY(-2px);
        }

        @media (max-width: 600px) {
            .article-container { padding: 40px 20px; }
            .article-title { font-size: 1.7rem !important; }
            .article-body { font-size: 1.1rem; }
        }
    </style>

