<!--移除Google廣告-->
<script>
document.addEventListener('DOMContentLoaded', function() {	
	var adsScripts = document.querySelectorAll('script[src*="adsbygoogle.js"]');
	adsScripts.forEach(function(script) {
		script.parentNode.removeChild(script);
	});
	
	
	//使用MutationObserver監控DOM變化，刪除Google廣告
	const observer = new MutationObserver(function(mutations) {
		mutations.forEach(function(mutation) {
			var floatAd = document.getElementById('google-anno-sa');
			if (floatAd) {
				floatAd.parentNode.removeChild(floatAd);
			}
		});
	});

	//開始觀察文檔主體
	observer.observe(document.body, { childList: true, subtree: true });
});
</script>
