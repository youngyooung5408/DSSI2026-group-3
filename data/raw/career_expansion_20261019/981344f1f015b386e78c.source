48E586959143D660794D658C816B9B0E3BC2EA2B12A1BA/subgraphmysterio/smartcrop_w184_h184_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fko%2Fftnn_com_tw_939%2F33d1f95f70e12fa62cc0567f3f5ba2e6.jpg\",\"width\":184}]},\"title\":\"洋流有望現「變天盤」？台北市長最新民調明公布　戴立安預言「仍有落差」\"},\"contentType\":\"Story\",\"id\":\"3133ced5-69b3-3881-9c0d-4a7404cd13eb\"},{\"ad\":true},{\"content\":{\"author\":\"$undefined\",\"canonicalUrl\":{\"url\":\"https://tw.news.yahoo.com/%E5%BE%90%E5%B7%A7%E8%8A%AF-%E7%8C%9B%E9%96%8B%E6%88%B0%E6%B2%88%E4%BC%AF%E6%B4%8B-%E9%81%AD%E5%8F%8D%E6%AE%BA-%E6%9C%AC%E5%9C%9F%E5%A5%B3%E6%AD%8C%E6%89%8B%E7%9C%8B%E4%B8%8D%E4%B8%8B%E5%8E%BB%E7%94%A91%E5%8F%A5%E5%A4%A7%E7%97%9B%E6%93%8A-020328563.html\"},\"canvass\":{\"count\":187},\"categoryLabel\":\"$undefined\",\"clickThroughUrl\":{\"url\":\"https://tw.news.yahoo.com/%E5%BE%90%E5%B7%A7%E8%8A%AF-%E7%8C%9B%E9%96%8B%E6%88%B0%E6%B2%88%E4%BC%AF%E6%B4%8B-%E9%81%AD%E5%8F%8D%E6%AE%BA-%E6%9C%AC%E5%9C%9F%E5%A5%B3%E6%AD%8C%E6%89%8B%E7%9C%8B%E4%B8%8D%E4%B8%8B%E5%8E%BB%E7%94%A91%E5%8F%A5%E5%A4%A7%E7%97%9B%E6%93%8A-020328563.html\"},\"color\":\"$undefined\",\"contentType\":\"Story\",\"duration\":\"$undefined\",\"id\":\"3c3fb3f6-fbcd-3edb-9a26-b24d4cfebe33\",\"isHosted\":true,\"label\":\"$undefined\",\"liveVideo\":\"$undefined\",\"mabLogString\":\"$undefined\",\"originalTitle\":\"徐巧芯「猛開戰沈伯洋」遭反殺！本土女歌手看不下去甩1句大痛擊\",\"photoVariants\":\"$undefined\",\"provider\":{\"displayName\":\"民視\",\"id\":\"$undefined\",\"logo\":{\"resolutions\":[]},\"sourceId\":\"$undefined\",\"url\":\"$undefined\"},\"providerContentUrl\":\"$undefined\",\"pubDate\":\"2026-10-19T02:03:28Z\",\"summary\":\"政治中心／綜合報導2026台北市長選戰持續升溫，國民黨立委徐巧芯18日受訪時，將矛頭指向民進黨台北市長參選人沈伯洋，批評他擔任立委期間沒有為台北市爭取建設，甚至直指沈伯洋「沒有政績、只有人設」，沒想到，相關言論曝光後，歌手謝和弦的妻子陳緗妮也在臉書發文，翻出沈伯洋過去擔任不分區立委的責任區其實是花蓮縣，發文反問：「徐巧芯為什麼要問沈伯洋為台北市做了什麼？蛤？？？？」。\",\"tags\":[],\"thumbnail\":{\"crop\":\"$undefined\",\"originalHeight\":\"$undefined\",\"originalUrl\":\"https://media.zenfs.com/ko/ftvn.com.tw/820f6372fc66a6f5ab034ff79586a3ec.jpg\",\"originalWidth\":\"$undefined\",\"resolutions\":[{\"height\":280,\"tag\":\"498x280\",\"transformLabel\":\"498x280\",\"url\":\"https://s.yimg.com/lo/mysterio/api/365554FE4971F1C6FD5D71A2862BE12ED0BB59772133886F580E88282F849302/subgraphmysterio/smartcrop_w498_h280_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fko%2Fftvn.com.tw%2F820f6372fc66a6f5ab034ff79586a3ec.jpg\",\"width\":498},{\"height\":184,\"tag\":\"184x184\",\"transformLabel\":\"184x184\",\"url\":\"https://s.yimg.com/lo/mysterio/api/EC560C92651E17F24190A3E6DE31F234775BE2BA681A3100B7DB9C28637DF8D9/subgraphmysterio/smartcrop_w184_h184_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fko%2Fftvn.com.tw%2F820f6372fc66a6f5ab034ff79586a3ec.jpg\",\"width\":184}]},\"title\":\"徐巧芯「猛開戰沈伯洋」遭反殺！本土女歌手看不下去甩1句大痛擊\"},\"contentType\":\"Story\",\"id\":\"3c3fb3f6-fbcd-3edb-9a26-b24d4cfebe33\"},{\"content\":{\"author\":\"$undefined\",\"canonicalUrl\":{\"url\":\"https://tw.news.yahoo.com/%E6%B7%B1%E8%97%8D%E5%A4%96%E7%9C%81%E7%AC%AC%E4%B8%89%E4%BB%A3-%E6%B1%BA%E5%AE%9A%E6%94%B9%E6%8A%95%E6%B2%88%E4%BC%AF%E6%B4%8B-%E5%A5%B3%E5%AD%90%E6%9B%9D1%E9%97%9C%E9%8D%B5-%E8%94%A3%E8%90%AC%E5%AE%89%E7%AB%9F%E4%B8%8D%E7%9F%A5%E5%9B%9B%E7%8D%B8%E5%B1%B1-022800500.html\"},\"canvass\":{\"count\":195},\"categoryLabel\":\"$undefined\",\"clickThroughUrl\":{\"url\":\"https://tw.news.yahoo.com/%E6%B7%B1%E8%97%8D%E5%A4%96%E7%9C%81%E7%AC%AC%E4%B8%89%E4%BB%A3-%E6%B1%BA%E5%AE%9A%E6%94%B9%E6%8A%95%E6%B2%88%E4%BC%AF%E6%B4%8B-%E5%A5%B3%E5%AD%90%E6%9B%9D1%E9%97%9C%E9%8D%B5-%E8%94%A3%E8%90%AC%E5%AE%89%E7%AB%9F%E4%B8%8D%E7%9F%A5%E5%9B%9B%E7%8D%B8%E5%B1%B1-022800500.html\"},\"color\":\"$undefined\",\"contentType\":\"Story\",\"duration\":\"$undefined\",\"id\":\"a124ad9b-b2df-36bc-b7d9-78d7e5a2009c\",\"isHosted\":true,\"label\":\"$undefined\",\"liveVideo\":\"$undefined\",\"mabLogString\":\"$undefined\",\"originalTitle\":\"深藍外省第三代「決定改投沈伯洋」！女子曝1關鍵：蔣萬安竟不知四獸山\",\"photoVariants\":\"$undefined\",\"provider\":{\"displayName\":\"三立新聞網 setn.com\",\"id\":\"$undefined\",\"logo\":{\"resolutions\":[]},\"sourceId\":\"$undefined\",\"url\":\"$undefined\"},\"providerContentUrl\":\"$undefined\",\"pubDate\":\"2026-10-19T02:28:00Z\",\"summary\":\"2026台北市長選戰白熱化，尋求連任的蔣萬安與民進黨參選人沈伯洋競爭激烈。近日傳出深藍選區的外省第三代民眾「票投轉向」，表態改支持沈伯洋。該名民眾指出，主因在於蔣萬安先前竟答不出信義區著名的「四獸山」包含哪四座山，讓身為在地居民的她感到相當錯愕與失望。此外，談及近期發生的兒虐事件時，她也哽咽表示市民期望看到領導者能真正站出來承擔家長心聲，成為社會的安全後盾。\",\"tags\":[],\"thumbnail\":{\"crop\":\"$undefined\",\"originalHeight\":\"$undefined\",\"originalUrl\":\"https://media.zenfs.com/en/setn.com.tw/6c42e63403c0df12b7c31ad63e7f350e.jpg\",\"originalWidth\":\"$undefined\",\"resolutions\":[{\"height\":280,\"tag\":\"498x280\",\"transformLabel\":\"498x280\",\"url\":\"https://s.yimg.com/lo/mysterio/api/040FA89B9E9B79E3C3ACDC6095C5143E123B3943953CD3D9D5ABA5DCFDFD0C9E/subgraphmysterio/smartcrop_w498_h280_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fen%2Fsetn.com.tw%2F6c42e63403c0df12b7c31ad63e7f350e.jpg\",\"width\":498},{\"height\":184,\"tag\":\"184x184\",\"transformLabel\":\"184x184\",\"url\":\"https://s.yimg.com/lo/mysterio/api/A3BEB2B1C25296445C0E13D81A76B88B342E4A70B6BEF1F2E6399F4D9A0DA090/subgraphmysterio/smartcrop_w184_h184_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fen%2Fsetn.com.tw%2F6c42e63403c0df12b7c31ad63e7f350e.jpg\",\"width\":184}]},\"title\":\"深藍外省第三代「決定改投沈伯洋」！女子曝1關鍵：蔣萬安竟不知四獸山\"},\"contentType\":\"Story\",\"id\":\"a124ad9b-b2df-36bc-b7d9-78d7e5a2009c\"},{\"content\":{\"author\":\"$undefined\",\"canonicalUrl\":{\"url\":\"https://tw.news.yahoo.com/%E6%8C%89%E6%91%A9%E5%8F%88%E6%93%81%E6%8A%B1-%E7%BE%8E%E5%A5%B3%E9%87%8C%E9%95%B7%E6%8E%A7%E9%81%AD%E6%80%A7%E9%A8%B7-%E8%A6%AA%E5%AF%86%E7%95%AB%E9%9D%A2%E6%9B%9D%E5%85%89-%E9%8F%A1%E6%96%B0%E8%81%9E-101504223.html\"},\"canvass\":{\"count\":1},\"categoryLabel\":\"$undefined\",\"clickThroughUrl\":{\"url\":\"https://tw.news.yahoo.com/%E6%8C%89%E6%91%A9%E5%8F%88%E6%93%81%E6%8A%B1-%E7%BE%8E%E5%A5%B3%E9%87%8C%E9%95%B7%E6%8E%A7%E9%81%AD%E6%80%A7%E9%A8%B7-%E8%A6%AA%E5%AF%86%E7%95%AB%E9%9D%A2%E6%9B%9D%E5%85%89-%E9%8F%A1%E6%96%B0%E8%81%9E-101504223.html\"},\"color\":\"$undefined\",\"contentType\":\"Video\",\"duration\":107,\"id\":\"39f86282-2d60-324c-81e5-b4969f03c47f\",\"isHosted\":true,\"label\":\"$undefined\",\"liveVideo\":null,\"mabLogString\":\"$undefined\",\"originalTitle\":\"按摩又擁抱！　美女里長控遭性騷　親密畫面曝光｜#鏡新聞\",\"photoVariants\":\"$undefined\",\"provider\":{\"displayName\":\"鏡新聞\",\"id\":\"$undefined\",\"logo\":{\"resolutions\":[]},\"sourceId\":\"$undefined\",\"url\":\"$undefined\"},\"providerContentUrl\":\"$undefined\",\"pubDate\":\"2026-10-19T10:15:04Z\",\"summary\":\"台北市萬華華江里里長洪佳君，今年二月控告環南市場自治會會長林勝東，對她權勢性騷擾，台北地檢署日前偵結，起訴林勝東，並求刑一年。不過10/19鏡週刊卻爆出，兩人其實在案發前互動十分親密，不僅曾相擁、按摩，洪佳君還曾收受昂貴飾品禮物。對此，洪佳君出面澄清，強調兩人絕無私情，關係好絕不代表就可以性騷擾。\",\"tags\":[],\"thumbnail\":{\"crop\":\"$undefined\",\"originalHeight\":\"$undefined\",\"originalUrl\":\"https://media.zenfs.com/en/mnews_tw_258/fcf130133094aa3a5cee2adc8200d6f2\",\"originalWidth\":\"$undefined\",\"resolutions\":[{\"height\":280,\"tag\":\"498x280\",\"transformLabel\":\"498x280\",\"url\":\"https://s.yimg.com/lo/mysterio/api/0804C7059293F866E66B7B46F08B5EFC79168DBE007A2575E971324B7A409C71/subgraphmysterio/smartcrop_w498_h280_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fen%2Fmnews_tw_258%2Ffcf130133094aa3a5cee2adc8200d6f2\",\"width\":498},{\"height\":184,\"tag\":\"184x184\",\"transformLabel\":\"184x184\",\"url\":\"https://s.yimg.com/lo/mysterio/api/CA47FBE650FD6137C8E6E6910CFA6ACE69312EDB22294986F185D7F08BFD9097/subgraphmysterio/smartcrop_w184_h184_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fen%2Fmnews_tw_258%2Ffcf130133094aa3a5cee2adc8200d6f2\",\"width\":184}]},\"title\":\"按摩又擁抱！　美女里長控遭性騷　親密畫面曝光｜#鏡新聞\"},\"contentType\":\"Video\",\"id\":\"39f86282-2d60-324c-81e5-b4969f03c47f\"},{\"ad\":true},{\"content\":{\"author\":\"$undefined\",\"canonicalUrl\":{\"url\":\"https://tw.news.yahoo.com/%E6%B4%8B%E6%B5%81-%E6%9B%87%E8%8A%B1-%E7%8F%BE-%E5%91%BD%E7%90%86%E5%B8%AB%E9%A0%90%E8%A8%80%E7%B5%90%E5%B1%80-%E5%BE%85%E6%BD%AE%E6%B0%B4%E8%A4%AA%E5%8E%BB%E4%B9%8B%E5%BE%8C-131008526.html\"},\"canvass\":{\"count\":26},\"categoryLabel\":\"$undefined\",\"clickThroughUrl\":{\"url\":\"https://tw.news.yahoo.com/%E6%B4%8B%E6%B5%81-%E6%9B%87%E8%8A%B1-%E7%8F%BE-%E5%91%BD%E7%90%86%E5%B8%AB%E9%A0%90%E8%A8%80%E7%B5%90%E5%B1%80-%E5%BE%85%E6%BD%AE%E6%B0%B4%E8%A4%AA%E5%8E%BB%E4%B9%8B%E5%BE%8C-131008526.html\"},\"color\":\"$undefined\",\"contentType\":\"Story\",\"duration\":\"$undefined\",\"id\":\"692a79ae-cf15-3865-9211-e7afb833664e\",\"isHosted\":true,\"label\":\"$undefined\",\"liveVideo\":\"$undefined\",\"mabLogString\":\"$undefined\",\"originalTitle\":\"「洋流」曇花一現？命理師預言結局：待潮水褪去之後\",\"photoVariants\":\"$undefined\",\"provider\":{\"displayName\":\"中時新聞網\",\"id\":\"$undefined\",\"logo\":{\"resolutions\":[]},\"sourceId\":\"$undefined\",\"url\":\"$undefined\"},\"providerContentUrl\":\"$undefined\",\"pubDate\":\"2026-10-18T13:10:08Z\",\"summary\":\"民進黨台北市長參選人沈伯洋掀起「洋流」，他日前接受媒體專訪，當場拿出隨身攜帶的塔羅牌，親自替選戰最後40多天的發展占卜。針對「洋流」，命理專家、吠陀占星權威李靜唯表示，熱鬧的浪花或許能博得一時的關注，但潮水褪去之後，唯有禁得起泥土檢驗的踏實治理與寬容厚度，才能真正承載一座城市的未來。。\",\"tags\":[],\"thumbnail\":{\"crop\":\"$undefined\",\"originalHeight\":\"$undefined\",\"originalUrl\":\"$undefined\",\"originalWidth\":\"$undefined\",\"resolutions\":[]},\"title\":\"「洋流」曇花一現？命理師預言結局：待潮水褪去之後\"},\"contentType\":\"Story\",\"id\":\"692a79ae-cf15-3865-9211-e7afb833664e\"}],\"recommendedArticlesPaginationCursor\":\"eyJzZXNzaW9uSWQiOiJhMzM1ZDUzMy0wZTBkLTQwMTMtYTcxNS1hNDRkMjUyODQ5MjAiLCJpbmRleCI6MjB9\",\"shouldFetchPreferenceStream\":true,\"stockMarketTime\":[],\"stockUserLevel\":\"\",\"trendingStream\":[{\"content\":{\"author\":\"$undefined\",\"canonicalUrl\":{\"url\":\"https://tw.news.yahoo.com/%E7%82%BA%E5%85%92%E5%AD%90%E5%86%8D%E7%B5%A6%E8%80%81%E5%85%AC-%E6%AC%A1%E6%A9%9F%E6%9C%83-%E5%A5%B3%E6%98%9F%E6%87%B7%E4%BA%8C%E8%83%8E4%E5%B9%B4%E5%BE%8C%E9%82%84%E6%98%AF%E9%9B%A2%E5%A9%9A%E4%BA%86-222854652.html\"},\"canvass\":{\"count\":16},\"categoryLabel\":\"$undefined\",\"clickThroughUrl\":{\"url\":\"https://tw.news.yahoo.com/%E7%82%BA%E5%85%92%E5%AD%90%E5%86%8D%E7%B5%A6%E8%80%81%E5%85%AC-%E6%AC%A1%E6%A9%9F%E6%9C%83-%E5%A5%B3%E6%98%9F%E6%87%B7%E4%BA%8C%E8%83%8E4%E5%B9%B4%E5%BE%8C%E9%82%84%E6%98%AF%E9%9B%A2%E5%A9%9A%E4%BA%86-222854652.html\"},\"color\":\"$undefined\",\"contentType\":\"Story\",\"duration\":\"$undefined\",\"id\":\"f8dcc3ff-96ea-3b1d-bd73-ae404ded7e8c\",\"isHosted\":true,\"label\":\"$undefined\",\"liveVideo\":\"$undefined\",\"mabLogString\":\"$undefined\",\"originalTitle\":\"為兒子再給老公一次機會　女星懷二胎4年後還是離婚了\",\"photoVariants\":\"$undefined\",\"provider\":{\"displayName\":\"鏡週刊Mirror Media\",\"id\":\"$undefined\",\"logo\":{\"resolutions\":[]},\"sourceId\":\"$undefined\",\"url\":\"$undefined\"},\"providerContentUrl\":\"$undefined\",\"pubDate\":\"2026-10-18T22:28:54Z\",\"summary\":\"由永齡基金會主辦、曾馨瑩主理的「永齡銘馨盃」舞蹈大賽邁入第四屆，據悉，16歲的女兒妞妞過去只是插花演出，今年開始加入主導賽事，還傳出正撮合爸爸郭台銘與媽媽曾馨瑩同台，希望促成爸媽世紀破冰。因為孩子而重新思考婚姻、試圖修補家庭關係的例子，在演藝圈也曾發生過。\",\"tags\":[],\"thumbnail\":{\"crop\":\"$undefined\",\"originalHeight\":\"$undefined\",\"originalUrl\":\"https://media.zenfs.com/ko/mirrormedia.mg/2bf5be667f1a1483043d1b52b5796b97.jpg\",\"originalWidth\":\"$undefined\",\"resolutions\":[{\"height\":280,\"tag\":\"498x280\",\"transformLabel\":\"498x280\",\"url\":\"https://s.yimg.com/lo/mysterio/api/BDF6A816577039D64E4BC8C7F6D7FB9A529BACEC2E463B4A892F4608C6B2ADEA/subgraphmysterio/smartcrop_w498_h280_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fko%2Fmirrormedia.mg%2F2bf5be667f1a1483043d1b52b5796b97.jpg\",\"width\":498},{\"height\":184,\"tag\":\"184x184\",\"transformLabel\":\"184x184\",\"url\":\"https://s.yimg.com/lo/mysterio/api/821F34A34EEFBAB730A0A42F3479F983A886416E6CD1F8DF9234AA2D3394C4AD/subgraphmysterio/smartcrop_w184_h184_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fko%2Fmirrormedia.mg%2F2bf5be667f1a1483043d1b52b5796b97.jpg\",\"width\":184}]},\"title\":\"為兒子再給老公一次機會　女星懷二胎4年後還是離婚了\"},\"contentType\":\"Story\",\"id\":\"f8dcc3ff-96ea-3b1d-bd73-ae404ded7e8c\"},{\"content\":{\"author\":\"$undefined\",\"canonicalUrl\":{\"url\":\"https://tw.news.yahoo.com/%E8%94%A1%E5%BA%B7%E6%B0%B8%E9%A9%9A%E5%82%B3-%E4%B8%BB%E5%8B%95%E5%91%8A%E5%88%A5%E5%A4%A7%E9%99%B8%E5%B8%82%E5%A0%B4-%E8%A2%AB%E7%88%86%E5%88%AA%E9%99%A4%E5%B0%8D%E5%B2%B8%E7%B6%93%E7%B4%80%E4%BA%BA%E8%81%AF%E7%B9%AB%E6%96%B9%E5%BC%8F-005659160.html\"},\"canvass\":{\"count\":178},\"categoryLabel\":\"$undefined\",\"clickThroughUrl\":{\"url\":\"https://tw.news.yahoo.com/%E8%94%A1%E5%BA%B7%E6%B0%B8%E9%A9%9A%E5%82%B3-%E4%B8%BB%E5%8B%95%E5%91%8A%E5%88%A5%E5%A4%A7%E9%99%B8%E5%B8%82%E5%A0%B4-%E8%A2%AB%E7%88%86%E5%88%AA%E9%99%A4%E5%B0%8D%E5%B2%B8%E7%B6%93%E7%B4%80%E4%BA%BA%E8%81%AF%E7%B9%AB%E6%96%B9%E5%BC%8F-005659160.html\"},\"color\":\"$undefined\",\"contentType\":\"Story\",\"duration\":\"$undefined\",\"id\":\"dbebdd01-5fa2-3c6d-8482-01fb4eaa1f28\",\"isHosted\":true,\"label\":\"$undefined\",\"liveVideo\":\"$undefined\",\"mabLogString\":\"$undefined\",\"originalTitle\":\"蔡康永驚傳「主動告別大陸市場」！被爆刪除對岸經紀人聯繫方式\",\"photoVariants\":\"$undefined\",\"provider\":{\"displayName\":\"中天新聞網\",\"id\":\"$undefined\",\"logo\":{\"resolutions\":[]},\"sourceId\":\"$undefined\",\"url\":\"$undefined\"},\"providerContentUrl\":\"$undefined\",\"pubDate\":\"2026-10-19T00:56:59Z\",\"summary\":\"主持人蔡康永近日出席沈伯洋的選舉造勢活動引發網路熱議，微博隨後傳出他已刪除大陸經紀人聯絡方式，外界猜測他可能淡出大陸市場。截至目前，蔡康永本人尚未對相關傳聞公開回應，傳聞是否屬實仍有待他進一步說明。\",\"tags\":[],\"thumbnail\":{\"crop\":\"$undefined\",\"originalHeight\":\"$undefined\",\"originalUrl\":\"https://media.zenfs.com/ko/gotv_ctitv_com_tw_678/2d0f85056b9c1e6e3e511f26bacb8274.jpg\",\"originalWidth\":\"$undefined\",\"resolutions\":[{\"height\":280,\"tag\":\"498x280\",\"transformLabel\":\"498x280\",\"url\":\"https://s.yimg.com/lo/mysterio/api/E92781BBD614F09225B60923B629DB94D4A19DD1EEFC535B6E00CCD329199717/subgraphmysterio/smartcrop_w498_h280_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fko%2Fgotv_ctitv_com_tw_678%2F2d0f85056b9c1e6e3e511f26bacb8274.jpg\",\"width\":498},{\"height\":184,\"tag\":\"184x184\",\"transformLabel\":\"184x184\",\"url\":\"https://s.yimg.com/lo/mysterio/api/4FBAC2E7EE5AB0740AF3AE39EA7EC82A43C6DC7D846C1EE894C45157056B0B53/subgraphmysterio/smartcrop_w184_h184_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fko%2Fgotv_ctitv_com_tw_678%2F2d0f85056b9c1e6e3e511f26bacb8274.jpg\",\"width\":184}]},\"title\":\"蔡康永驚傳「主動告別大陸市場」！被爆刪除對岸經紀人聯繫方式\"},\"contentType\":\"Story\",\"id\":\"dbebdd01-5fa2-3c6d-8482-01fb4eaa1f28\"},{\"content\":{\"author\":\"$undefined\",\"canonicalUrl\":{\"url\":\"https://tw.news.yahoo.com/%E8%B7%AA%E6%B2%88%E4%BC%AF%E6%B4%8B%E7%9A%84%E9%98%BF%E5%AC%A4%E6%98%AF%E8%87%A8%E6%BC%94-%E4%BD%9C%E5%AE%B6%E6%9B%9D%E7%9C%9F%E5%AF%A6%E8%BA%AB%E5%88%86-6%E5%B9%B4%E5%89%8D%E5%B0%B1%E4%B8%8A%E8%A1%97%E4%BA%86-232805920.html\"},\"canvass\":{\"count\":438},\"categoryLabel\":\"$undefined\",\"clickThroughUrl\":{\"url\":\"https://tw.news.yahoo.com/%E8%B7%AA%E6%B2%88%E4%BC%AF%E6%B4%8B%E7%9A%84%E9%98%BF%E5%AC%A4%E6%98%AF%E8%87%A8%E6%BC%94-%E4%BD%9C%E5%AE%B6%E6%9B%9D%E7%9C%9F%E5%AF%A6%E8%BA%AB%E5%88%86-6%E5%B9%B4%E5%89%8D%E5%B0%B1%E4%B8%8A%E8%A1%97%E4%BA%86-232805920.html\"},\"color\":\"$undefined\",\"contentType\":\"Story\",\"duration\":\"$undefined\",\"id\":\"0fb2dac5-d08b-39ae-8c23-74088a4ec958\",\"isHosted\":true,\"label\":\"$undefined\",\"liveVideo\":\"$undefined\",\"mabLogString\":\"$undefined\",\"originalTitle\":\"跪沈伯洋的阿嬤是臨演？作家曝真實身分：6年前就上街了\",\"photoVariants\":\"$undefined\",\"provider\":{\"displayName\":\"中時新聞網\",\"id\":\"$undefined\",\"logo\":{\"resolutions\":[]},\"sourceId\":\"$undefined\",\"url\":\"$undefined\"},\"providerContentUrl\":\"$undefined\",\"pubDate\":\"2026-10-18T23:28:05Z\",\"summary\":\"民進黨台北市長候選人沈伯洋17日前往社子島參加活動，一名阿嬤突然下跪陳情，哭求沈伯洋當選後協助當地居民，未料畫面曝光後，卻遭部分網友質疑是事先安排的「臨時演員」，引發議論。對此，作家「漂浪島嶼」18日發文揭露，這名洪姓阿嬤早在6年前、蔣萬安尚未當選台北市長時，就已跟隨反徵收自救會上街抗爭，並非所謂的臨演。他更感嘆，為了保住家園，「別說下跪陳情，趴在地上都是願意」，但也直言，無論蔣萬安或沈伯洋，都未真正回應居民反對徵收的核心訴求。\",\"tags\":[],\"thumbnail\":{\"crop\":\"$undefined\",\"originalHeight\":\"$undefined\",\"originalUrl\":\"https://media.zenfs.com/ko/chinatimes.com.tw/951e7931de4e00f5406a67e4187c20a6.jpg\",\"originalWidth\":\"$undefined\",\"resolutions\":[{\"height\":280,\"tag\":\"498x280\",\"transformLabel\":\"498x280\",\"url\":\"https://s.yimg.com/lo/mysterio/api/B77B358A9F73C175FBC7952EEB7A111AF994DDCD4C7052CFD3F26561293033CE/subgraphmysterio/smartcrop_w498_h280_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fko%2Fchinatimes.com.tw%2F951e7931de4e00f5406a67e4187c20a6.jpg\",\"width\":498},{\"height\":184,\"tag\":\"184x184\",\"transformLabel\":\"184x184\",\"url\":\"https://s.yimg.com/lo/mysterio/api/A1411F833B0274B2A01E4092BD357989D92B679453561E9E5CB434AF4855A746/subgraphmysterio/smartcrop_w184_h184_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fko%2Fchinatimes.com.tw%2F951e7931de4e00f5406a67e4187c20a6.jpg\",\"width\":184}]},\"title\":\"跪沈伯洋的阿嬤是臨演？作家曝真實身分：6年前就上街了\"},\"contentType\":\"Story\",\"id\":\"0fb2dac5-d08b-39ae-8c23-74088a4ec958\"},{\"content\":{\"author\":\"$undefined\",\"canonicalUrl\":{\"url\":\"https://tw.news.yahoo.com/%E9%87%91%E9%90%98%E5%B0%88%E8%A8%AA-%E8%88%92%E8%8F%AF%E9%9A%BB%E8%BA%AB%E8%B5%B4%E9%9F%93%E9%97%96%E8%95%A9-%E6%9B%BE%E5%AF%B6%E5%84%80%E4%BA%BA%E7%94%9F%E8%A7%80%E8%BD%89%E8%AE%8A-%E8%87%AA%E6%9B%9D%E7%8F%BE%E5%9C%A8%E5%8F%AA%E6%B1%82-4%E4%BB%B6%E4%BA%8B-232825757.html\"},\"canvass\":{\"count\":5},\"categoryLabel\":\"$undefined\",\"clickThroughUrl\":{\"url\":\"https://tw.news.yahoo.com/%E9%87%91%E9%90%98%E5%B0%88%E8%A8%AA-%E8%88%92%E8%8F%AF%E9%9A%BB%E8%BA%AB%E8%B5%B4%E9%9F%93%E9%97%96%E8%95%A9-%E6%9B%BE%E5%AF%B6%E5%84%80%E4%BA%BA%E7%94%9F%E8%A7%80%E8%BD%89%E8%AE%8A-%E8%87%AA%E6%9B%9D%E7%8F%BE%E5%9C%A8%E5%8F%AA%E6%B1%82-4%E4%BB%B6%E4%BA%8B-232825757.html\"},\"color\":\"$undefined\",\"contentType\":\"Story\",\"duration\":\"$undefined\",\"id\":\"f69d759d-180b-388f-b33c-2de9f101d955\",\"isHosted\":true,\"label\":\"$undefined\",\"liveVideo\":\"$undefined\",\"mabLogString\":\"$undefined\",\"originalTitle\":\"（金鐘專訪）舒華隻身赴韓闖蕩！曾寶儀人生觀轉變 自曝現在只求「4件事」\",\"photoVariants\":\"$undefined\",\"provider\":{\"displayName\":\"自由時報\",\"id\":\"$undefined\",\"logo\":{\"resolutions\":[]},\"sourceId\":\"$undefined\",\"url\":\"$undefined\"},\"providerContentUrl\":\"$undefined\",\"pubDate\":\"2026-10-18T23:28:25Z\",\"summary\":\"家，一定要得到父母認同才算數嗎？曾寶儀陪著《我們回家吧》的來賓回望成長、走進生活，也逐漸找到自己的答案。今年《我們回家吧3》入圍第61屆金鐘獎「生活風格節目獎」，她也角逐「生活風格節目主持人獎」。談起節目帶來的體會，她以隻身在韓國闖蕩的舒華為例，提醒每個尋找歸屬的人：「家裡最重要的成員是你自己。」\",\"tags\":[],\"thumbnail\":{\"crop\":\"$undefined\",\"originalHeight\":\"$undefined\",\"originalUrl\":\"https://media.zenfs.com/ko/libertytimes_786/9eff0eb69e7fc45a294807003fa28662.jpg\",\"originalWidth\":\"$undefined\",\"resolutions\":[{\"height\":280,\"tag\":\"498x280\",\"transformLabel\":\"498x280\",\"url\":\"https://s.yimg.com/lo/mysterio/api/AA23F1CD80A2ADA60B24B2D4FD0BC82FE8A48B03B90F117D98ABB4AC5758B8D8/subgraphmysterio/smartcrop_w498_h280_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fko%2Flibertytimes_786%2F9eff0eb69e7fc45a294807003fa28662.jpg\",\"width\":498},{\"height\":184,\"tag\":\"184x184\",\"transformLabel\":\"184x184\",\"url\":\"https://s.yimg.com/lo/mysterio/api/B0CF5A36953728AF5CAEC47587EE855A50115727C8F6AA21364F52AA1D7DA78C/subgraphmysterio/smartcrop_w184_h184_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fko%2Flibertytimes_786%2F9eff0eb69e7fc45a294807003fa28662.jpg\",\"width\":184}]},\"title\":\"（金鐘專訪）舒華隻身赴韓闖蕩！曾寶儀人生觀轉變 自曝現在只求「4件事」\"},\"contentType\":\"Story\",\"id\":\"f69d759d-180b-388f-b33c-2de9f101d955\"},{\"content\":{\"author\":\"$undefined\",\"canonicalUrl\":{\"url\":\"https://tw.news.yahoo.com/%E7%9D%BD%E9%81%957%E5%B9%B4%E5%85%AC%E9%96%8B%E9%9C%B2%E9%9D%A2-%E4%B8%81%E5%B0%8F%E8%8A%B9%E5%87%BA%E7%8D%84-%E8%BD%89%E6%88%B0%E9%9B%BB%E5%95%86-%E9%96%8B%E5%95%9F%E4%BA%8B%E6%A5%AD%E7%AC%AC%E4%BA%8C%E6%98%A5-045200910.html\"},\"canvass\":{\"count\":22},\"categoryLabel\":\"$undefined\",\"clickThroughUrl\":{\"url\":\"https://tw.news.yahoo.com/%E7%9D%BD%E9%81%957%E5%B9%B4%E5%85%AC%E9%96%8B%E9%9C%B2%E9%9D%A2-%E4%B8%81%E5%B0%8F%E8%8A%B9%E5%87%BA%E7%8D%84-%E8%BD%89%E6%88%B0%E9%9B%BB%E5%95%86-%E9%96%8B%E5%95%9F%E4%BA%8B%E6%A5%AD%E7%AC%AC%E4%BA%8C%E6%98%A5-045200910.html\"},\"color\":\"$undefined\",\"contentType\":\"Story\",\"duration\":\"$undefined\",\"id\":\"aeb3ae3b-81f0-39e2-b260-6565911bda56\",\"isHosted\":true,\"label\":\"$undefined\",\"liveVideo\":\"$undefined\",\"mabLogString\":\"$undefined\",\"originalTitle\":\"睽違7年公開露面！丁小芹出獄「轉戰電商」開啟事業第二春\",\"photoVariants\":\"$undefined\",\"provider\":{\"displayName\":\"EBC東森娛樂\",\"id\":\"$undefined\",\"logo\":{\"resolutions\":[]},\"sourceId\":\"$undefined\",\"url\":\"$undefined\"},\"providerContentUrl\":\"$undefined\",\"pubDate\":\"2026-10-19T04:52:00Z\",\"summary\":\"睽違7年公開露面！丁小芹出獄「轉戰電商」開啟事業第二春\",\"tags\":[],\"thumbnail\":{\"crop\":\"$undefined\",\"originalHeight\":\"$undefined\",\"originalUrl\":\"https://media.zenfs.com/ko/ebc_star_440/b55590ed6d9d60ac864c61214fc460e3.jpg\",\"originalWidth\":\"$undefined\",\"resolutions\":[{\"height\":280,\"tag\":\"498x280\",\"transformLabel\":\"498x280\",\"url\":\"https://s.yimg.com/lo/mysterio/api/64A28FFFA3470C8E94CD65003FAAB8C3D947586B2F80B0020C9CDCFEE88D7756/subgraphmysterio/smartcrop_w498_h280_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fko%2Febc_star_440%2Fb55590ed6d9d60ac864c61214fc460e3.jpg\",\"width\":498},{\"height\":184,\"tag\":\"184x184\",\"transformLabel\":\"184x184\",\"url\":\"https://s.yimg.com/lo/mysterio/api/DF9D88BFFAA16A7F203BAE7A345C95207E4CA39B23F5D23D9CE8E31B1005C152/subgraphmysterio/smartcrop_w184_h184_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fko%2Febc_star_440%2Fb55590ed6d9d60ac864c61214fc460e3.jpg\",\"width\":184}]},\"title\":\"睽違7年公開露面！丁小芹出獄「轉戰電商」開啟事業第二春\"},\"contentType\":\"Story\",\"id\":\"aeb3ae3b-81f0-39e2-b260-6565911bda56\"}]}],\"\"]}]\n"])</script></body></html>