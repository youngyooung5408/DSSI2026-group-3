e},\"id\":\"sda-moments-iframe\",\"kvs\":{\"loc\":\"mid_center\"},\"path\":\"/22888152279/${intl}/${property}/${rosOrMain}/mw/${intl}_${property}_${rosOrMain}_mw_mid_center\",\"region\":\"index\",\"size\":[[300,250],[2,2],[3,2]]},\"sda-top-center-iframe\":{\"customSizeConfig\":{\"Horizon\":true},\"id\":\"sda-top-center-iframe\",\"kvs\":{\"loc\":\"top_center\"},\"path\":\"/22888152279/${intl}/${property}/${rosOrMain}/mw/${intl}_${property}_${rosOrMain}_mw_top_center\",\"region\":\"index\",\"size\":[[320,50],[320,100],[3,1]]}}},\"taboolaPositionsByDevice\":{\"appAndroid\":{\"pencil-read-more\":{\"mode\":\"pencil-twhk-article-super-app-android-b\",\"placement\":\"taboola-pencil-articleb\",\"region\":\"index\",\"targetType\":\"mix\"},\"stream-preference-stream\":{\"mode\":\"stream-twhk-article-super-app-android-d\",\"placement\":\"taboola-stream-articled\",\"region\":\"index\",\"targetType\":\"mix\"},\"stream-recommended-articles\":{\"mode\":\"stream-twhk-article-super-app-android-c\",\"placement\":\"taboola-stream-articlec\",\"region\":\"index\",\"targetType\":\"mix\"}},\"appIos\":{\"pencil-read-more\":{\"mode\":\"pencil-twhk-article-super-app-ios-b\",\"placement\":\"taboola-pencil-articleb\",\"region\":\"index\",\"targetType\":\"mix\"},\"stream-preference-stream\":{\"mode\":\"stream-twhk-article-super-app-ios-d\",\"placement\":\"taboola-stream-articled\",\"region\":\"index\",\"targetType\":\"mix\"},\"stream-recommended-articles\":{\"mode\":\"stream-twhk-article-super-app-ios-c\",\"placement\":\"taboola-stream-articlec\",\"region\":\"index\",\"targetType\":\"mix\"}},\"appNames\":[\"super\",\"superhk\",\"ytwstock\",\"twnews\",\"hknews\"],\"desktop\":{\"pencil-read-more\":{\"mode\":\"pencil-twhk-article-revamp-a-v2\",\"placement\":\"taboola-pencil-articlea-v2\",\"region\":\"index\",\"targetType\":\"mix\"},\"stream-preference-stream\":{\"mode\":\"stream-twhk-article-revamp-b\",\"placement\":\"taboola-stream-articleb\",\"region\":\"index\",\"targetType\":\"mix\"},\"stream-preference-stream-large\":{\"mode\":\"stream-twhk-article-revamp-e\",\"placement\":\"taboola-stream-articlee\",\"region\":\"index\",\"targetType\":\"mix\"},\"stream-recommended-articles\":{\"mode\":\"stream-twhk-article-revamp-a\",\"placement\":\"taboola-stream-articlea\",\"region\":\"index\",\"targetType\":\"mix\"}},\"smartphone\":{\"pencil-read-more\":{\"mode\":\"pencil-twhk-article-revamp-b\",\"placement\":\"taboola-pencil-articleb\",\"region\":\"index\",\"targetType\":\"mix\"},\"stream-preference-stream\":{\"mode\":\"stream-twhk-article-revamp-d\",\"placement\":\"taboola-stream-articled\",\"region\":\"index\",\"targetType\":\"mix\"},\"stream-recommended-articles\":{\"mode\":\"stream-twhk-article-revamp-c\",\"placement\":\"taboola-stream-articlec\",\"region\":\"index\",\"targetType\":\"mix\"}}}},\"pageName\":\"articlePage\",\"pageState\":{\"article\":{\"data\":{\"bodyBlocks\":[{\"attrs\":\"$undefined\",\"hydratedAsset\":\"$undefined\",\"id\":null,\"items\":null,\"nodeId\":\"1\",\"parentNodeId\":null,\"subtype\":null,\"text\":null,\"type\":\"providerImage\",\"uuid\":\"60bf4ca2-8bfb-3aaf-a1a0-c424d1464152\",\"transformed\":{\"alt\":\"桃園市議員選戰大溪復興區應選2席，現任分別為藍營李柏坊（左一）與綠營陳治文（右三），外界預估兩人爭取連任基本盤穩固。（本報資料照片）\",\"caption\":\"桃園市議員選戰大溪復興區應選2席，現任分別為藍營李柏坊（左一）與綠營陳治文（右三），外界預估兩人爭取連任基本盤穩固。（本報資料照片）\",\"credit\":\"\",\"href\":\"\",\"size\":{\"original\":{\"height\":839,\"url\":\"https://media.zenfs.com/ko/chinatimes.com.tw/dc383f25420eff3eab3f60726e2451c2\",\"width\":1024},\"resized\":{\"height\":787,\"url\":\"https://s.yimg.com/lo/mysterio/api/cc8f4f3a0fc9fd57eb3d1056778616757d78fda261a1d09d6bb1b5780ba7b0ac/lightyear_networkapi/resizefill_w960%3Bquality_80%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fko%2Fchinatimes.com.tw%2Fdc383f25420eff3eab3f60726e2451c2\",\"width\":960}}}},{\"attrs\":{\"textAlign\":\"left\",\"characterCount\":120},\"hydratedAsset\":null,\"id\":null,\"items\":null,\"nodeId\":\"2\",\"parentNodeId\":null,\"subtype\":null,\"text\":null,\"type\":\"paragraph\",\"uuid\":null,\"content\":[{\"attrs\":{},\"hydratedAsset\":null,\"id\":null,\"items\":null,\"nodeId\":\"3\",\"parentNodeId\":\"2\",\"subtype\":null,\"text\":\"桃園市議員選戰大溪復興區應選2席，現任分別為藍營李柏坊與綠營陳治文，外界預估兩人爭取連任基本盤穩固無太大難度。檯面上還有本屆失利的徐慈檉捲土重來，另有無黨籍健行科大助理教授江國輝、曾擔任鄭運鵬競選桃園市長時期大溪後援會長的王文正將投入參選。\",\"type\":\"text\",\"uuid\":null}]},{\"attrs\":{\"textAlign\":\"left\",\"characterCount\":129},\"hydratedAsset\":null,\"id\":null,\"items\":null,\"nodeId\":\"4\",\"parentNodeId\":null,\"subtype\":null,\"text\":null,\"type\":\"paragraph\",\"uuid\":null,\"content\":[{\"attrs\":{},\"hydratedAsset\":null,\"id\":null,\"items\":null,\"nodeId\":\"5\",\"parentNodeId\":\"4\",\"subtype\":null,\"text\":\"國民黨李柏坊已任5屆議員，民進黨陳治文則是4連霸，藍綠老將有現任優勢，兩人長期扎根地方服務，近年來大溪區著重都市更新包括行政園區與埔頂營區開發，另透過交通建設紓解觀光交通壅塞、改善生活機能，提升成為兼具歷史特色與現代發展的區域，兩人都有所著墨，基層實力雄厚。\",\"type\":\"text\",\"uuid\":null}]},{\"attrs\":{\"textAlign\":\"left\",\"characterCount\":120},\"hydratedAsset\":null,\"id\":null,\"items\":null,\"nodeId\":\"6\",\"parentNodeId\":null,\"subtype\":null,\"text\":null,\"type\":\"paragraph\",\"uuid\":null,\"content\":[{\"attrs\":{},\"hydratedAsset\":null,\"id\":null,\"items\":null,\"nodeId\":\"7\",\"parentNodeId\":\"6\",\"subtype\":null,\"text\":\"本屆參選失利的徐慈檉後來退出民眾黨，仍積極參與地方大小事，下屆是否以無黨籍參選，他說自己曾任前立委孫大千祕書，近期親民黨主席宋楚瑜有來找過他，是否改披親民黨戰袍再戰大溪市議員席次，仍按自己的步調傾聽地方上的聲音，黨籍問題之後會再進一步考慮。\",\"type\":\"text\",\"uuid\":null}]},{\"attrs\":{\"textAlign\":\"left\",\"characterCount\":156},\"hydratedAsset\":null,\"id\":null,\"items\":null,\"nodeId\":\"8\",\"parentNodeId\":null,\"subtype\":null,\"text\":null,\"type\":\"paragraph\",\"uuid\":null,\"content\":[{\"attrs\":{},\"hydratedAsset\":null,\"id\":null,\"items\":null,\"nodeId\":\"9\",\"parentNodeId\":\"8\",\"subtype\":null,\"text\":\"他提到，雖然大溪區有藍綠的基本盤，但是地方上也有聲音，認為現任者連任多屆，應該世代交替，自己的學經歷在4年前有所不足，經過這幾年的磨練，在地方上的經驗累積也更加成長，自己在大溪土生土長，認為這20多年來並沒有實質上太大的進步，年輕世代有更多的新思維，期盼能獲得鄉親支持有機會為地方服務，為大溪區擘畫更進步的未來。\",\"type\":\"text\",\"uuid\":null}]},{\"attrs\":{\"textAlign\":\"left\",\"characterCount\":58},\"hydratedAsset\":null,\"id\":null,\"items\":null,\"nodeId\":\"10\",\"parentNodeId\":null,\"subtype\":null,\"text\":null,\"type\":\"paragraph\",\"uuid\":null,\"content\":[{\"attrs\":{},\"hydratedAsset\":null,\"id\":null,\"items\":null,\"nodeId\":\"11\",\"parentNodeId\":\"10\",\"subtype\":null,\"text\":\"至於民眾黨日前已完成第1波中壢、八德、龜山區市議員參選登記，目前大溪區尚未有可能參選者浮出檯面，後續有待進一步觀察。\",\"type\":\"text\",\"uuid\":null}]}],\"contentMeta\":{\"adMeta\":{\"hashtag\":\"\",\"rs\":\"lmsid:a0770000005ABwMAAW;revsp:chinatimes.com.tw;lpstaid:2e21e60d-6d1f-32f6-9999-0ff0808deacc;pct:story\",\"site\":\"news\"},\"alias\":\"ymedia-alias:shadow=大溪復興區-老將穩新人促交棒-201000365\",\"attribution\":{\"authors\":[{\"alias\":\"\",\"id\":\"\",\"logo\":\"$undefined\",\"name\":\"呂筱蟬／桃園報導\",\"title\":\"\"}],\"provider\":{\"darkLogo\":{\"size\":{\"original\":{\"height\":63,\"url\":\"https://s.yimg.com/os/creatr-uploaded-images/2022-03/479258e0-a4d7-11ec-bdec-582d25ebb2f0\",\"width\":300},\"resized\":{\"height\":48,\"url\":\"https://s.yimg.com/lo/mysterio/api/12f997dd472fa5c37eb8e0f0462643e707dee40afd9123786d562838253b381a/lightyear_networkapi/resizefill_h48%3Bquality_80%3Bformat_webp/https%3A%2F%2Fs.yimg.com%2Fos%2Fcreatr-uploaded-images%2F2022-03%2F479258e0-a4d7-11ec-bdec-582d25ebb2f0\",\"width\":229}}},\"logo\":{\"size\":{\"original\":{\"height\":50,\"url\":\"https://s.yimg.com/os/creatr-uploaded-images/2020-08/23410720-d6cf-11ea-be77-dd09959d161f\",\"width\":300},\"resized\":{\"height\":48,\"url\":\"https://s.yimg.com/lo/mysterio/api/bf7ecf262b1e822c2f5d2e1c1227eee374fec1a5de5034b3ea49520e8e1e2831/lightyear_networkapi/resizefill_h48%3Bquality_80%3Bformat_webp/https%3A%2F%2Fs.yimg.com%2Fos%2Fcreatr-uploaded-images%2F2020-08%2F23410720-d6cf-11ea-be77-dd09959d161f\",\"width\":288}}},\"name\":\"中時新聞網\",\"providerId\":\"chinatimes.com.tw\",\"ref\":\"4eaa3f6b-7d6c-33ec-8347-f4ced26b23ef\",\"url\":{\"external\":true,\"link\":\"http://www.chinatimes.com\"}}},\"categoryLabel\":\"news\",\"commentsAllowed\":true,\"commerceArticleType\":false,\"contentCoverBlo