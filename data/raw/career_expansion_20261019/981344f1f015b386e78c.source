+json">{"@context":"https://schema.org","@type":"NewsArticle","author":{"@type":"Person","jobTitle":"","name":"呂筱蟬／桃園報導","url":""},"creator":{"@type":"Person","jobTitle":"","name":"呂筱蟬／桃園報導","url":""},"dateModified":"2026-01-21T20:10:00Z","datePublished":"2026-01-21T20:10:00Z","description":"桃園市議員選戰大溪復興區應選2席，現任分別為藍營李柏坊與綠營陳治文，外界預估兩人爭取連任基本盤穩固無太大難度。檯面上還有本屆失利的徐慈檉捲土重來，另有無黨籍健行科大助理教授江國輝、曾擔任鄭運鵬競選桃園市長時期大溪後援會長的王文正將投入參選。","headline":"大溪復興區 老將穩新人促交棒","image":{"@type":"ImageObject","height":983,"url":"https://s.yimg.com/lo/mysterio/api/af11a8585f12305b32f66d5aa81467784a990e23d323c05017666b595bbc953d/lightyear_networkapi/resizefill_w1200%3Bquality_80%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fko%2Fchinatimes.com.tw%2Fdc383f25420eff3eab3f60726e2451c2","width":1200},"keywords":["大溪","李柏坊"],"mainEntityOfPage":"https://tw.news.yahoo.com/%E5%A4%A7%E6%BA%AA%E5%BE%A9%E8%88%88%E5%8D%80-%E8%80%81%E5%B0%87%E7%A9%A9%E6%96%B0%E4%BA%BA%E4%BF%83%E4%BA%A4%E6%A3%92-201000365.html","provider":{"@type":"Organization","logo":{"@type":"ImageObject","height":63,"url":"https://s.yimg.com/os/creatr-uploaded-images/2022-03/479258e0-a4d7-11ec-bdec-582d25ebb2f0","width":300},"name":"中時新聞網","url":"http://www.chinatimes.com"},"publisher":{"@type":"Organization","alternateName":"Yahoo奇摩新聞","logo":{"@type":"ImageObject","height":65,"url":"https://s.yimg.com/cv/apiv2/twnews/logo2024/PC/Yahoo_News@2x.png","width":310},"name":"Yahoo新聞"},"thumbnailUrl":"https://s.yimg.com/lo/mysterio/api/af11a8585f12305b32f66d5aa81467784a990e23d323c05017666b595bbc953d/lightyear_networkapi/resizefill_w1200%3Bquality_80%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fko%2Fchinatimes.com.tw%2Fdc383f25420eff3eab3f60726e2451c2"}</script><header class="mb-module-gap"><div class="mb-2 flex items-center justify-between lg:justify-start" id="2e21e60d-6d1f-32f6-9999-0ff0808deacc-provider-4eaa3f6b-7d6c-33ec-8347-f4ced26b23ef"><a data-ylk="elm:logo;g:4eaa3f6b-7d6c-33ec-8347-f4ced26b23ef;itc:0;sec:logo-provider;slk:中時新聞網;" aria-label="中時新聞網（