%8Bpk%E9%99%B3%E4%BA%AD%E5%A6%83-%E6%9C%80%E6%96%B0%E5%8F%B0%E5%8D%97%E5%B8%82%E9%95%B7%E9%81%B8%E8%88%89%E7%B6%B2%E8%B7%AF%E6%8A%95%E7%A5%A8%E8%B7%8C%E7%A0%B4%E7%9C%BC%E9%8F%A1-092357389.html\"},\"color\":\"$undefined\",\"contentType\":\"Story\",\"duration\":\"$undefined\",\"id\":\"23f65f19-b466-387f-9ffa-4139192c208d\",\"isHosted\":true,\"label\":\"$undefined\",\"liveVideo\":\"$undefined\",\"mabLogString\":\"$undefined\",\"originalTitle\":\"謝龍介PK陳亭妃！ 最新台南市長選舉網路投票跌破眼鏡\",\"photoVariants\":\"$undefined\",\"provider\":{\"displayName\":\"中時新聞網\",\"id\":\"$undefined\",\"logo\":{\"resolutions\":[]},\"sourceId\":\"$undefined\",\"url\":\"$undefined\"},\"providerContentUrl\":\"$undefined\",\"pubDate\":\"2026-10-19T09:23:57Z\",\"summary\":\"2026年台南市長選舉，國民黨提名立委謝龍介挑戰市長大位，民進黨則派出立委陳亭妃延續綠色執政。而在今（19）日，入口網站《Yahoo奇摩新聞》以台南市長選戰相關話題為題發起網路投票，結果顯示，表態支持謝龍介的參與者雖多於支持陳亭妃的，但有高達3成9的參與者回答「不知道／沒意見」，為所有選項最高。\",\"tags\":[],\"thumbnail\":{\"crop\":\"$undefined\",\"originalHeight\":\"$undefined\",\"originalUrl\":\"$undefined\",\"originalWidth\":\"$undefined\",\"resolutions\":[]},\"title\":\"謝龍介PK陳亭妃！ 最新台南市長選舉網路投票跌破眼鏡\"},\"contentType\":\"Story\",\"id\":\"23f65f19-b466-387f-9ffa-4139192c208d\"},{\"content\":{\"author\":\"$undefined\",\"canonicalUrl\":{\"url\":\"https://tw.news.yahoo.com/%E8%B6%85%E9%81%8E3%E8%90%AC%E4%BA%BA%E6%93%A0%E7%88%86%E9%80%A0%E5%8B%A2%E6%9C%83%E5%A0%B4-%E5%BC%B5%E5%96%84%E6%94%BF%E5%BF%8D%E4%B8%8D%E4%BD%8F%E9%96%8B%E8%BD%9F-%E6%B4%8B%E6%B5%81%E6%9C%89%E6%94%BF%E8%A6%8B%E5%97%8E-%E9%83%BD%E5%9C%A8%E6%90%97%E4%BA%82-135933091.html\"},\"canvass\":{\"count\":86},\"categoryLabel\":\"$undefined\",\"clickThroughUrl\":{\"url\":\"https://tw.news.yahoo.com/%E8%B6%85%E9%81%8E3%E8%90%AC%E4%BA%BA%E6%93%A0%E7%88%86%E9%80%A0%E5%8B%A2%E6%9C%83%E5%A0%B4-%E5%BC%B5%E5%96%84%E6%94%BF%E5%BF%8D%E4%B8%8D%E4%BD%8F%E9%96%8B%E8%BD%9F-%E6%B4%8B%E6%B5%81%E6%9C%89%E6%94%BF%E8%A6%8B%E5%97%8E-%E9%83%BD%E5%9C%A8%E6%90%97%E4%BA%82-135933091.html\"},\"color\":\"$undefined\",\"contentType\":\"Story\",\"duration\":\"$undefined\",\"id\":\"1184c3fa-beca-39a1-959a-7699a6f1fa5b\",\"isHosted\":true,\"label\":\"$undefined\",\"liveVideo\":\"$undefined\",\"mabLogString\":\"$undefined\",\"originalTitle\":\"超過3萬人擠爆造勢會場！ 張善政忍不住開轟「洋流有政見嗎？都在搗亂」！\",\"photoVariants\":\"$undefined\",\"provider\":{\"displayName\":\"中天新聞網\",\"id\":\"$undefined\",\"logo\":{\"resolutions\":[]},\"sourceId\":\"$undefined\",\"url\":\"$undefined\"},\"providerContentUrl\":\"$undefined\",\"pubDate\":\"2026-10-17T13:59:33Z\",\"summary\":\"桃園市長張善政今（17）日晚間舉辦大型造勢活動，藍白大咖齊聚相挺，現場更湧入3萬人。張善政表示，選舉時總會遭到抹黑，自己最近也被唱衰到差一點懷疑人生，「哪有唱衰自己城市市政建設的？桃園不是國民黨的、不是民進黨的，是大家的桃園！」\",\"tags\":[],\"thumbnail\":{\"crop\":\"$undefined\",\"originalHeight\":\"$undefined\",\"originalUrl\":\"https://media.zenfs.com/en/gotv_ctitv_com_tw_678/71bac70e1e42e3d19d03f7f6f5d85475.png\",\"originalWidth\":\"$undefined\",\"resolutions\":[{\"height\":280,\"tag\":\"498x280\",\"transformLabel\":\"498x280\",\"url\":\"https://s.yimg.com/lo/mysterio/api/6A79051EC4199F55495E3E372035824EAE1297EE033B44167A626D2646DFBA62/subgraphmysterio/smartcrop_w498_h280_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fen%2Fgotv_ctitv_com_tw_678%2F71bac70e1e42e3d19d03f7f6f5d85475.png\",\"width\":498},{\"height\":184,\"tag\":\"184x184\",\"transformLabel\":\"184x184\",\"url\":\"https://s.yimg.com/lo/mysterio/api/3E28C1082F0AE061A8F90D0CE875FF4453C137E43237E2D440FA62B6918C5336/subgraphmysterio/smartcrop_w184_h184_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fen%2Fgotv_ctitv_com_tw_678%2F71bac70e1e42e3d19d03f7f6f5d85475.png\",\"width\":184}]},\"title\":\"超過3萬人擠爆造勢會場！ 張善政忍不住開轟「洋流有政見嗎？都在搗亂」！\"},\"contentType\":\"Story\",\"id\":\"1184c3fa-beca-39a1-959a-7699a6f1fa5b\"},{\"content\":{\"author\":\"$undefined\",\"canonicalUrl\":{\"url\":\"https://tw.news.yahoo.com/%E6%B2%88%E4%BC%AF%E6%B4%8B%E4%BA%A4%E9%8B%92%E9%BB%83%E5%85%89%E8%8A%B9-%E5%A4%A7%E8%85%A6%E9%AB%98%E9%80%9F%E9%81%8B%E8%BD%89-%E9%81%AD%E7%8C%9B%E6%94%BB-%E5%99%B41%E5%8F%A5%E7%A5%9E%E5%9B%9E-%E5%A5%B9%E7%A7%92%E8%AE%8A%E8%87%89%E5%A4%A7%E5%80%92%E6%88%88-091240385.html\"},\"canvass\":{\"count\":14},\"categoryLabel\":\"$undefined\",\"clickThroughUrl\":{\"url\":\"https://tw.news.yahoo.com/%E6%B2%88%E4%BC%AF%E6%B4%8B%E4%BA%A4%E9%8B%92%E9%BB%83%E5%85%89%E8%8A%B9-%E5%A4%A7%E8%85%A6%E9%AB%98%E9%80%9F%E9%81%8B%E8%BD%89-%E9%81%AD%E7%8C%9B%E6%94%BB-%E5%99%B41%E5%8F%A5%E7%A5%9E%E5%9B%9E-%E5%A5%B9%E7%A7%92%E8%AE%8A%E8%87%89%E5%A4%A7%E5%80%92%E6%88%88-091240385.html\"},\"color\":\"$undefined\",\"contentType\":\"Story\",\"duration\":\"$undefined\",\"id\":\"b8100959-9a5e-358c-b41a-3266d03047a1\",\"isHosted\":true,\"label\":\"$undefined\",\"liveVideo\":\"$undefined\",\"mabLogString\":\"$undefined\",\"originalTitle\":\"沈伯洋交鋒黃光芹「大腦高速運轉」！遭猛攻「噴1句神回」她秒變臉大倒戈\",\"photoVariants\":\"$undefined\",\"provider\":{\"displayName\":\"民視\",\"id\":\"$undefined\",\"logo\":{\"resolutions\":[]},\"sourceId\":\"$undefined\",\"url\":\"$undefined\"},\"providerContentUrl\":\"$undefined\",\"pubDate\":\"2026-10-19T09:12:40Z\",\"summary\":\"政治中心／綜合報導民進黨台北市長候選人沈伯洋今（19日）一早行程滿檔，先是接受資深媒體人吳淡如專訪，談起已故生母往事，讓不少線上收聽的網友聽到落淚，隨後又馬不停蹄趕場黃光芹主持的節目，沒想到這場專訪氣氛大不同！黃光芹不僅頻頻被沈伯洋逗得笑出聲，還一度開玩笑吃醋，虧他回答另一位主持人陳儀潔的問題比較好，沈伯洋隨後更在回答政策發想初衷時，突然順著脈絡提到選舉最初有不少策略，其中當初為了提高知名度，決定「趕快來光芹姐的節目」，讓黃光芹當場笑到拍手，開心直喊：「你還記得我喔！」這段互動畫面曝光後，也讓網友笑翻：「撲馬根本就是長輩最喜歡的體質啊～」。\",\"tags\":[],\"thumbnail\":{\"crop\":\"$undefined\",\"originalHeight\":\"$undefined\",\"originalUrl\":\"https://media.zenfs.com/zh-tw/ftvn.com.tw/c2381d51e3ead491b7d2fb75dd8d44ee.jpg\",\"originalWidth\":\"$undefined\",\"resolutions\":[{\"height\":280,\"tag\":\"498x280\",\"transformLabel\":\"498x280\",\"url\":\"https://s.yimg.com/lo/mysterio/api/8F1BA69A70DE7DC9580A056B8341331ECD7BF1E05FDCA6997EF22D86AC9CBB58/subgraphmysterio/smartcrop_w498_h280_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fzh-tw%2Fftvn.com.tw%2Fc2381d51e3ead491b7d2fb75dd8d44ee.jpg\",\"width\":498},{\"height\":184,\"tag\":\"184x184\",\"transformLabel\":\"184x184\",\"url\":\"https://s.yimg.com/lo/mysterio/api/9C5109342F5EE62D0F00CB92FCBCDD8FEAD622CA06A8141E9C33E2EEA46E8407/subgraphmysterio/smartcrop_w184_h184_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fzh-tw%2Fftvn.com.tw%2Fc2381d51e3ead491b7d2fb75dd8d44ee.jpg\",\"width\":184}]},\"title\":\"沈伯洋交鋒黃光芹「大腦高速運轉」！遭猛攻「噴1句神回」她秒變臉大倒戈\"},\"contentType\":\"Story\",\"id\":\"b8100959-9a5e-358c-b41a-3266d03047a1\"},{\"ad\":true},{\"content\":{\"author\":\"$undefined\",\"canonicalUrl\":{\"url\":\"https://tw.news.yahoo.com/%E6%B2%88%E4%BC%AF%E6%B4%8B-%E8%94%A3%E8%90%AC%E5%AE%89%E5%8F%B0%E5%8C%97%E6%BF%80%E6%88%B0-%E9%BB%83%E6%9A%90%E7%80%9A%E6%9B%9D-3%E8%80%85%E5%88%B0%E4%BD%8D-%E9%80%99%E4%BA%BA%E6%98%AF1128%E7%95%B6%E9%81%B8%E4%BA%BA-072223893.html\"},\"canvass\":{\"count\":85},\"categoryLabel\":\"$undefined\",\"clickThroughUrl\":{\"url\":\"https://tw.news.yahoo.com/%E6%B2%88%E4%BC%AF%E6%B4%8B-%E8%94%A3%E8%90%AC%E5%AE%89%E5%8F%B0%E5%8C%97%E6%BF%80%E6%88%B0-%E9%BB%83%E6%9A%90%E7%80%9A%E6%9B%9D-3%E8%80%85%E5%88%B0%E4%BD%8D-%E9%80%99%E4%BA%BA%E6%98%AF1128%E7%95%B6%E9%81%B8%E4%BA%BA-072223893.html\"},\"color\":\"$undefined\",\"contentType\":\"Story\",\"duration\":\"$undefined\",\"id\":\"ffb46140-0af6-30ef-a120-e67ee3b4cfdd\",\"isHosted\":true,\"label\":\"$undefined\",\"liveVideo\":\"$undefined\",\"mabLogString\":\"$undefined\",\"originalTitle\":\"沈伯洋、蔣萬安台北激戰！黃暐瀚曝：3者到位「這人是1128當選人」\",\"photoVariants\":\"$undefined\",\"provider\":{\"displayName\":\"民視\",\"id\":\"$undefined\",\"logo\":{\"resolutions\":[]},\"sourceId\":\"$undefined\",\"url\":\"$undefined\"},\"providerContentUrl\":\"$undefined\",\"pubDate\":\"2026-10-19T07:22:23Z\",\"summary\":\"即時中心／潘柏廷報導民進黨台北市長參選人沈伯洋，投入選戰以來，藉由掃街拜票、流利口才點出現今市政問題，再加上接受非同溫層的資深媒體人王偉忠等人專訪，逐漸在首都掀起「洋流」旋風；甚至在最新民調顯示，他與對手、國民黨籍市長蔣萬安僅差8%，引發各界高度關注。對此，資深媒體人黃暐瀚今（19）日在臉書指出，只要3者到位，沈伯洋將是11月28日的台北市長當選人。\",\"tags\":[],\"thumbnail\":{\"crop\":\"$undefined\",\"originalHeight\":\"$undefined\",\"originalUrl\":\"https://media.zenfs.com/ko/ftvn.com.tw/55aab8f145b4e6a4938645bafcddcb1f.jpg\",\"originalWidth\":\"$undefined\",\"resolutions\":[{\"height\":280,\"tag\":\"498x280\",\"transformLabel\":\"498x280\",\"url\":\"https://s.yimg.com/lo/mysterio/api/CF457F55D078D1C2646BC8B8FB2C164A2A5C6AA6B5EC34F499B989C184CE4950/subgraphmysterio/smartcrop_w498_h280_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fko%2Fftvn.com.tw%2F55aab8f145b4e6a4938645bafcddcb1f.jpg\",\"width\":498},{\"height\":184,\"tag\":\"184x184\",\"transformLabel\":\"184x184\",\"url\":\"https://s.yimg.com/lo/mysterio/api/7B83FBE685E1756848E9C5854F7919040E9647DF4DC980AF32CE17D6FF4BEE8C/subgraphmysterio/smartcrop_w184_h184_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fko%2Fftvn.com.tw%2F55aab8f145b4e6a4938645bafcddcb1f.jpg\",\"width\":184}]},\"title\":\"沈伯洋、蔣萬安台北激戰！黃暐瀚曝：3者到位「這人是1128當選人」\"},\"contentType\":\"Story\",\"id\":\"ffb46140-0af6-30ef-a120-e67ee3b4cfdd\"},{\"content\":{\"author\":\"$undefined\",\"canonicalUrl\":{\"url\":\"https://tw.news.yahoo.com/%E6%B2%88%E4%BC%AF%E6%B4%8B%E6%9C%89%E6%9C%9B%E9%80%86%E8%BD%89%E5%8B%9D-%E6%97%A5%E5%AA%92%E6%9B%9D%E8%94%A3%E8%90%AC%E5%AE%89-3%E8%87%B4%E5%91%BD%E5%82%B7-%E8%8B%A6%E6%88%B0%E4%B9%9F%E6%98%AF%E8%BC%B8-093707967.html\"},\"canvass\":{\"count\":1},\"categoryLabel\":\"$undefined\",\"clickThroughUrl\":{\"url\":\"https://tw.news.yahoo.com/%E6%B2%88%E4%BC%AF%E6%B4%8B%E6%9C%89%E6%9C%9B%E9%80%86%E8%BD%89%E5%8B%9D-%E6%97%A5%E5%AA%92%E6%9B%9D%E8%94%A3%E8%90%AC%E5%AE%89-3%E8%87%B4%E5%91%BD%E5%82%B7-%E8%8B%A6%E6%88%B0%E4%B9%9F%E6%98%AF%E8%BC%B8-093707967.html\"},\"color\":\"$undefined\",\"contentType\":\"Story\",\"duration\":\"$undefined\",\"id\":\"5d478b9a-c625-3335-b4a0-0c0a3860b60f\",\"isHosted\":true,\"label\":\"$undefined\",\"liveVideo\":\"$undefined\",\"mabLogString\":\"$undefined\",\"originalTitle\":\"沈伯洋有望逆轉勝！日媒曝蔣萬安「3致命傷」：苦戰也是輸\",\"photoVariants\":\"$undefined\",\"provider\":{\"displayName\":\"民視\",\"id\":\"$undefined\",\"logo\":{\"resolutions\":[]},\"sourceId\":\"$undefined\",\"url\":\"$undefined\"},\"providerContentUrl\":\"$undefined\",\"pubDate\":\"2026-10-19T09:37:07Z\",\"summary\":\"政治中心／綜合報導台北市長選戰不僅國內關注，連日本媒體也高度矚目！日本知名時事資訊節目近日針對北市選情進行深入分析，邀請前《朝日新聞》台北分社社長ｘ野嶋剛剖析戰況。野嶋剛直言，現任市長蔣萬安原本勝券在握，如今卻面臨「這 3 大致命傷」，導致選情遭到民進黨推出的參選人沈伯洋緊逼，陷入意料之外的苦戰。\",\"tags\":[],\"thumbnail\":{\"crop\":\"$undefined\",\"originalHeight\":\"$undefined\",\"originalUrl\":\"https://media.zenfs.com/ko/ftvn.com.tw/c43e82984ee48442a64a911e741a07b6.jpg\",\"originalWidth\":\"$undefined\",\"resolutions\":[{\"height\":280,\"tag\":\"498x280\",\"transformLabel\":\"498x280\",\"url\":\"https://s.yimg.com/lo/mysterio/api/1F2B4A57B42983DE12A6FB493B64D2EBAF0142645F54E94143EF7DA08B2A3D74/subgraphmysterio/smartcrop_w498_h280_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fko%2Fftvn.com.tw%2Fc43e82984ee48442a64a911e741a07b6.jpg\",\"width\":498},{\"height\":184,\"tag\":\"184x184\",\"transformLabel\":\"184x184\",\"url\":\"https://s.yimg.com/lo/mysterio/api/1C48F74C06EE09F0FB8BADA6299B1C7EC2000584B06C4EDF1F047749FD604734/subgraphmysterio/smartcrop_w184_h184_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fko%2Fftvn.com.tw%2Fc43e82984ee48442a64a911e741a07b6.jpg\",\"width\":184}]},\"title\":\"沈伯洋有望逆轉勝！日媒曝蔣萬安「3致命傷」：苦戰也是輸\"},\"contentType\":\"Story\",\"id\":\"5d478b9a-c625-3335-b4a0-0c0a3860b60f\"},{\"content\":{\"author\":\"$undefined\",\"canonicalUrl\":{\"url\":\"https://tw.news.yahoo.com/%E6%B4%8B%E6%B5%81-%E8%81%B2%E5%8B%A2%E6%B5%A9%E5%A4%A7%E9%83%BD%E6%98%AF%E7%A9%BA%E6%B0%A3%E7%A5%A8-%E9%86%AB%E9%A0%90%E8%A8%80-%E7%B6%A0%E7%87%9F%E6%81%90-%E5%B1%8D%E5%A4%9A%E5%91%BD-060630845.html\"},\"canvass\":{\"count\":104},\"categoryLabel\":\"$undefined\",\"clickThroughUrl\":{\"url\":\"https://tw.news.yahoo.com/%E6%B4%8B%E6%B5%81-%E8%81%B2%E5%8B%A2%E6%B5%A9%E5%A4%A7%E9%83%BD%E6%98%AF%E7%A9%BA%E6%B0%A3%E7%A5%A8-%E9%86%AB%E9%A0%90%E8%A8%80-%E7%B6%A0%E7%87%9F%E6%81%90-%E5%B1%8D%E5%A4%9A%E5%91%BD-060630845.html\"},\"color\":\"$undefined\",\"contentType\":\"Story\",\"duration\":\"$undefined\",\"id\":\"08c0c541-dec5-3520-99ca-33ad16f52d0d\",\"isHosted\":true,\"label\":\"$undefined\",\"liveVideo\":\"$undefined\",\"mabLogString\":\"$undefined\",\"originalTitle\":\"「洋流」聲勢浩大都是空氣票？醫預言「綠營恐一屍多命」：最大苦主是她\",\"photoVariants\":\"$undefined\",\"provider\":{\"displayName\":\"風傳媒\",\"id\":\"$undefined\",\"logo\":{\"resolutions\":[]},\"sourceId\":\"$undefined\",\"url\":\"$undefined\"},\"providerContentUrl\":\"$undefined\",\"pubDate\":\"2026-10-19T06:06:30Z\",\"summary\":\"2026九合一選戰進入倒數階段，台北市長選情白熱化，民進黨參選人沈伯洋近來掃街、造勢所到之處人潮洶湧，被認為是「洋流崛起」。不過，胸腔科醫師蘇一峰在臉書發文表示，「洋流全台亂衝」無法轉化成選票，恐導致綠營「一屍多命」，新北市長參選人蘇巧慧成最大苦主。針對近來洋流崛起的討論，蘇一峰直言，洋流亂衝無法轉化為選票，綠營恐面臨一屍多命。洋流熱潮壓縮其他縣市綠營聲量，......\",\"tags\":[],\"thumbnail\":{\"crop\":\"$undefined\",\"originalHeight\":\"$undefined\",\"originalUrl\":\"https://media.zenfs.com/en/stormmediagroup.com/27d3d539f373becba84201e3050354f5\",\"originalWidth\":\"$undefined\",\"resolutions\":[{\"height\":280,\"tag\":\"498x280\",\"transformLabel\":\"498x280\",\"url\":\"https://s.yimg.com/lo/mysterio/api/BC813077BB6D70A662E2204FA875B1007D59E731CB6A6CA873C6C4E5028667B4/subgraphmysterio/smartcrop_w498_h280_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fen%2Fstormmediagroup.com%2F27d3d539f373becba84201e3050354f5\",\"width\":498},{\"height\":184,\"tag\":\"184x184\",\"transformLabel\":\"184x184\",\"url\":\"https://s.yimg.com/lo/mysterio/api/FC9ED3D2B4770EC489E936EE5D4C8A0A6FF79F28733ADD263BE87CC9F8046D8B/subgraphmysterio/smartcrop_w184_h184_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fen%2Fstormmediagroup.com%2F27d3d539f373becba84201e3050354f5\",\"width\":184}]},\"title\":\"「洋流」聲勢浩大都是空氣票？醫預言「綠營恐一屍多命」：最大苦主是她\"},\"contentType\":\"Story\",\"id\":\"08c0c541-dec5-3520-99ca-33ad16f52d0d\"},{\"ad\":true},{\"content\":{\"author\":\"$undefined\",\"canonicalUrl\":{\"url\":\"https://tw.news.yahoo.com/%E6%9C%80%E6%96%B0%E5%8F%B0%E5%8C%97%E5%B8%82%E9%95%B7%E9%81%B8%E6%88%B0%E8%AA%BF%E6%9F%A5%E5%87%BA%E7%88%90-%E9%80%99%E4%BA%BA-%E9%A0%98%E5%85%88%E8%BF%91%E5%85%A9%E6%88%90%E7%A2%BE%E5%A3%93%E5%B0%8D%E6%89%8B-233436340.html\"},\"canvass\":{\"count\":125},\"categoryLabel\":\"$undefined\",\"clickThroughUrl\":{\"url\":\"https://tw.news.yahoo.com/%E6%9C%80%E6%96%B0%E5%8F%B0%E5%8C%97%E5%B8%82%E9%95%B7%E9%81%B8%E6%88%B0%E8%AA%BF%E6%9F%A5%E5%87%BA%E7%88%90-%E9%80%99%E4%BA%BA-%E9%A0%98%E5%85%88%E8%BF%91%E5%85%A9%E6%88%90%E7%A2%BE%E5%A3%93%E5%B0%8D%E6%89%8B-233436340.html\"},\"color\":\"$undefined\",\"contentType\":\"Story\",\"duration\":\"$undefined\",\"id\":\"9199b37c-74f9-3889-bba5-3cd5a77da3ec\",\"isHosted\":true,\"label\":\"$undefined\",\"liveVideo\":\"$undefined\",\"mabLogString\":\"$undefined\",\"originalTitle\":\"最新台北市長選戰調查出爐！ 「這人」領先近兩成碾壓對手...\",\"photoVariants\":\"$undefined\",\"provider\":{\"displayName\":\"Newtalk新聞\",\"id\":\"$undefined\",\"logo\":{\"resolutions\":[]},\"sourceId\":\"$undefined\",\"url\":\"$undefined\"},\"providerContentUrl\":\"$undefined\",\"pubDate\":\"2026-10-18T23:34:36Z\",\"summary\":\"[Newtalk新聞] 距離九合一選舉提票日剩四十日。其中，在台北市市長選戰部分，國民黨由現任市長蔣萬安拼連任；民進黨則由立委沈伯洋應戰。根據一項最新調查，「這人」竟近領先近兩成碾壓對手。 《壹蘋新聞網》近日發起以「倒數6週，你支持誰當台北市長？」為題之網路投票，投票時間為本月11日至16日止，共有5,045人參與。結果顯示，沈伯洋以56.1%居首；蔣萬安以41.5%居次；另有2.4%表示「尚未決定」。沈伯洋與蔣萬安兩人支持度相差14.7個百分點。 不過，網路投票涉及的不確定因素極多，至多只能作為觀察網友態度的參考，較難作為判斷實際選舉輿情的依據。若要關注相關選舉輿情變化，建議仍應參考各家民調機構、媒體民調中心，或委託專業民調機構所進行的民意調查。查看原文更多Newtalk新聞報導沈伯洋很氣「我是犯罪學所長」 蔣萬安：你專業是認知作戰 沈伯洋：我是「認知作戰」專家、但蔣萬安跟我應是同一國人\",\"tags\":[],\"thumbnail\":{\"crop\":\"$undefined\",\"originalHeight\":\"$undefined\",\"originalUrl\":\"https://media.zenfs.com/ko/newtalk.tw/915e0fad10c3a164b621626ee05ef190.png\",\"originalWidth\":\"$undefined\",\"resolutions\":[{\"height\":280,\"tag\":\"498x280\",\"transformLabel\":\"498x280\",\"url\":\"https://s.yimg.com/lo/mysterio/api/D6A31826242793FC70E8965797412272288F98BBF1BEA211D747903ED1F3D39A/subgraphmysterio/smartcrop_w498_h280_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fko%2Fnewtalk.tw%2F915e0fad10c3a164b621626ee05ef190.png\",\"width\":498},{\"height\":184,\"tag\":\"184x184\",\"transformLabel\":\"184x184\",\"url\":\"https://s.yimg.com/lo/mysterio/api/92BE382674850A838109CD1FA065AF4C44846FFC79DC0B2A67A6E2B00F3AB513/subgraphmysterio/smartcrop_w184_h184_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fko%2Fnewtalk.tw%2F915e0fad10c3a164b621626ee05ef190.png\",\"width\":184}]},\"title\":\"最新台北市長選戰調查出爐！ 「這人」領先近兩成碾壓對手...\"},\"contentType\":\"Story\",\"id\":\"9199b37c-74f9-3889-bba5-3cd5a77da3ec\"},{\"content\":{\"author\":\"$undefined\",\"canonicalUrl\":{\"url\":\"https://tw.news.yahoo.com/%E6%98%94%E6%97%A5%E6%94%AF%E6%8C%81%E8%80%85%E8%B7%91%E4%BA%86-%E8%A9%B9%E6%B1%9F%E6%9D%91-%E9%A9%9A%E8%A6%8B1%E5%B9%95-%E5%96%8A-%E9%A6%96%E6%AC%A1%E6%84%9F%E5%8F%97%E5%88%B0%E5%BF%85%E9%A0%88%E8%A2%AB%E6%90%B6%E6%95%91%E7%9A%84%E5%8D%B1%E6%A9%9F-050200407.html\"},\"canvass\":{\"count\":8},\"categoryLabel\":\"$undefined\",\"clickThroughUrl\":{\"url\":\"https://tw.news.yahoo.com/%E6%98%94%E6%97%A5%E6%94%AF%E6%8C%81%E8%80%85%E8%B7%91%E4%BA%86-%E8%A9%B9%E6%B1%9F%E6%9D%91-%E9%A9%9A%E8%A6%8B1%E5%B9%95-%E5%96%8A-%E9%A6%96%E6%AC%A1%E6%84%9F%E5%8F%97%E5%88%B0%E5%BF%85%E9%A0%88%E8%A2%AB%E6%90%B6%E6%95%91%E7%9A%84%E5%8D%B1%E6%A9%9F-050200407.html\"},\"color\":\"$undefined\",\"contentType\":\"Story\",\"duration\":\"$undefined\",\"id\":\"0b6694f6-3962-3193-ab65-137da748b94f\",\"isHosted\":true,\"label\":\"$undefined\",\"liveVideo\":\"$undefined\",\"mabLogString\":\"$undefined\",\"originalTitle\":\"昔日支持者跑了？詹江村「驚見1幕」喊：首次感受到必須被搶救的危機\",\"photoVariants\":\"$undefined\",\"provider\":{\"displayName\":\"三立新聞網 setn.com\",\"id\":\"$undefined\",\"logo\":{\"resolutions\":[]},\"sourceId\":\"$undefined\",\"url\":\"$undefined\"},\"providerContentUrl\":\"$undefined\",\"pubDate\":\"2026-10-19T05:02:00Z\",\"summary\":\"2026桃園市議員選舉戰況激烈，國民黨現任議員詹江村爭取連任桃園區，面對20人搶12席的大混戰，他坦言首次感受到強烈危機感。詹江村透露，多位歷次選舉的重要支持者與軍中長官竟出現在對手造勢台上，加上多位藍綠及民眾黨強敵夾擊，目前民調落入C段班。他呼籲支持者團結搶救，切勿分票，確保議會關鍵戰將能順利連任。\",\"tags\":[],\"thumbnail\":{\"crop\":\"$undefined\",\"originalHeight\":\"$undefined\",\"originalUrl\":\"https://media.zenfs.com/ko/setn.com.tw/fafa00b12d9e1b5d08899e2d419844ed.jpg\",\"originalWidth\":\"$undefined\",\"resolutions\":[{\"height\":280,\"tag\":\"498x280\",\"transformLabel\":\"498x280\",\"url\":\"https://s.yimg.com/lo/mysterio/api/2AF39C546EF9E31ACB6EB4551DA660686B28E95D69750C75A4233B560C9DCEE3/subgraphmysterio/smartcrop_w498_h280_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fko%2Fsetn.com.tw%2Ffafa00b12d9e1b5d08899e2d419844ed.jpg\",\"width\":498},{\"height\":184,\"tag\":\"184x184\",\"transformLabel\":\"184x184\",\"url\":\"https://s.yimg.com/lo/mysterio/api/BAF9B3237DDF3F187FA545B55E4344E8EE01456E5B68EAFA0326DA74215D5587/subgraphmysterio/smartcrop_w184_h184_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fko%2Fsetn.com.tw%2Ffafa00b12d9e1b5d08899e2d419844ed.jpg\",\"width\":184}]},\"title\":\"昔日支持者跑了？詹江村「驚見1幕」喊：首次感受到必須被搶救的危機\"},\"contentType\":\"Story\",\"id\":\"0b6694f6-3962-3193-ab65-137da748b94f\"},{\"content\":{\"author\":\"$undefined\",\"canonicalUrl\":{\"url\":\"https://tw.news.yahoo.com/%E8%B2%A1%E7%A5%9E%E7%9C%B7%E9%A1%A7-%E6%BE%8E%E6%B9%96%E7%94%B7%E9%80%A3%E4%B8%AD2%E6%AC%A1-%E5%8D%83%E8%90%AC%E7%99%BC%E7%A5%A8-%E9%8A%80%E8%A1%8C%E6%8B%92%E5%85%8C%E5%A0%B1%E8%AD%A6%E8%99%95%E7%90%86-083708493.html\"},\"canvass\":{\"count\":18},\"categoryLabel\":\"$undefined\",\"clickThroughUrl\":{\"url\":\"https://tw.news.yahoo.com/%E8%B2%A1%E7%A5%9E%E7%9C%B7%E9%A1%A7-%E6%BE%8E%E6%B9%96%E7%94%B7%E9%80%A3%E4%B8%AD2%E6%AC%A1-%E5%8D%83%E8%90%AC%E7%99%BC%E7%A5%A8-%E9%8A%80%E8%A1%8C%E6%8B%92%E5%85%8C%E5%A0%B1%E8%AD%A6%E8%99%95%E7%90%86-083708493.html\"},\"color\":\"$undefined\",\"contentType\":\"Story\",\"duration\":\"$undefined\",\"id\":\"7f28418c-96b8-3326-a2f3-eee42d815c65\",\"isHosted\":true,\"label\":\"$undefined\",\"liveVideo\":\"$undefined\",\"mabLogString\":\"$undefined\",\"originalTitle\":\"財神眷顧？澎湖男連中2次「千萬發票」 銀行拒兌報警處理\",\"photoVariants\":\"$undefined\",\"provider\":{\"displayName\":\"自由時報\",\"id\":\"$undefined\",\"logo\":{\"resolutions\":[]},\"sourceId\":\"$undefined\",\"url\":\"$undefined\"},\"providerContentUrl\":\"$undefined\",\"pubDate\":\"2026-10-19T08:37:08Z\",\"summary\":\"幸運之神接連2次降臨同1人，是巧合，還是事有蹊蹺？澎湖發生1起同1人連中5-6月、7-8月統一發票千萬特別獎，另還有多張小獎，其中小獎多已在超商兌換，但領超過千元以上金額，必須在銀行或農會兌領，遭銀行拒兌並報警處理，但據了解發票是真的、並非偽造，因此案情仍有待釐清。\",\"tags\":[],\"thumbnail\":{\"crop\":\"$undefined\",\"originalHeight\":\"$undefined\",\"originalUrl\":\"https://media.zenfs.com/ko/libertytimes_786/5bbc22ea09d92255a81a6fbac4f023ee.jpg\",\"originalWidth\":\"$undefined\",\"resolutions\":[{\"height\":280,\"tag\":\"498x280\",\"transformLabel\":\"498x280\",\"url\":\"https://s.yimg.com/lo/mysterio/api/8E89CAA29A37973AA36AE0AC24FE740F74CB2632E007B02CEFDAA67827386DB3/subgraphmysterio/smartcrop_w498_h280_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fko%2Flibertytimes_786%2F5bbc22ea09d92255a81a6fbac4f023ee.jpg\",\"width\":498},{\"height\":184,\"tag\":\"184x184\",\"transformLabel\":\"184x184\",\"url\":\"https://s.yimg.com/lo/mysterio/api/FB90C253B267F6933D203E9CEDD3A946499C447A93387F9D5C79187A0CA17492/subgraphmysterio/smartcrop_w184_h184_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fko%2Flibertytimes_786%2F5bbc22ea09d92255a81a6fbac4f023ee.jpg\",\"width\":184}]},\"title\":\"財神眷顧？澎湖男連中2次「千萬發票」 銀行拒兌報警處理\"},\"contentType\":\"Story\",\"id\":\"7f28418c-96b8-3326-a2f3-eee42d815c65\"},{\"ad\":true},{\"content\":{\"author\":\"$undefined\",\"canonicalUrl\":{\"url\":\"https://tw.news.yahoo.com/%E6%9F%AF%E6%96%87%E5%93%B2%E5%AE%8C%E8%9B%8B%E4%BA%86-%E5%A4%A7%E5%B8%B3%E6%88%BF%E6%9D%8E%E6%96%87%E5%AE%97%E8%AA%8D%E7%BD%AA%E8%88%87%E6%9F%AF%E6%8E%8F%E7%A9%BA%E7%9C%BE%E6%9C%9B%E5%9F%BA%E9%87%91%E6%9C%83-070800907.html\"},\"canvass\":{\"count\":47},\"categoryLabel\":\"$undefined\",\"clickThroughUrl\":{\"url\":\"https://tw.news.yahoo.com/%E6%9F%AF%E6%96%87%E5%93%B2%E5%AE%8C%E8%9B%8B%E4%BA%86-%E5%A4%A7%E5%B8%B3%E6%88%BF%E6%9D%8E%E6%96%87%E5%AE%97%E8%AA%8D%E7%BD%AA%E8%88%87%E6%9F%AF%E6%8E%8F%E7%A9%BA%E7%9C%BE%E6%9C%9B%E5%9F%BA%E9%87%91%E6%9C%83-070800907.html\"},\"color\":\"$undefined\",\"contentType\":\"Story\",\"duration\":\"$undefined\",\"id\":\"1e797b2b-c2ec-3d2c-b029-b74ee603f49b\",\"isHosted\":true,\"label\":\"$undefined\",\"liveVideo\":\"$undefined\",\"mabLogString\":\"$undefined\",\"originalTitle\":\"柯文哲完蛋了　大帳房李文宗認罪與柯掏空眾望基金會\",\"photoVariants\":\"$undefined\",\"provider\":{\"displayName\":\"鏡週刊Mirror Media\",\"id\":\"$undefined\",\"logo\":{\"resolutions\":[]},\"sourceId\":\"$undefined\",\"url\":\"$undefined\"},\"providerContentUrl\":\"$undefined\",\"pubDate\":\"2026-10-19T07:08:00Z\",\"summary\":\"高等法院今（19日）針對民眾黨前主席柯文哲涉及侵佔政治獻及掏空眾望基金會案再度開庭，李文宗確定認罪，坦承與柯文哲挪用眾望基金會公款210萬元給柯文哲的貼身帳房許芷瑜（橘子、潛逃通緝中）、黃心緗等4個未到基金會工作，實際從事柯競選活動人員。此外李文娟也傳出有意認罪。\",\"tags\":[],\"thumbnail\":{\"crop\":\"$undefined\",\"originalHeight\":\"$undefined\",\"originalUrl\":\"https://media.zenfs.com/ko/mirrormedia.mg/119a96796437adcef46480f42243daa7.jpg\",\"originalWidth\":\"$undefined\",\"resolutions\":[{\"height\":280,\"tag\":\"498x280\",\"transformLabel\":\"498x280\",\"url\":\"https://s.yimg.com/lo/mysterio/api/6FC15054AA14421FD3BB1756579CEF08763FDCC9A9B511154F7506EBD6454CAD/subgraphmysterio/smartcrop_w498_h280_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fko%2Fmirrormedia.mg%2F119a96796437adcef46480f42243daa7.jpg\",\"width\":498},{\"height\":184,\"tag\":\"184x184\",\"transformLabel\":\"184x184\",\"url\":\"https://s.yimg.com/lo/mysterio/api/8D51E65174DB4968F233522C23AFCB590F1FEA1A159FE606E07B201911AE0C19/subgraphmysterio/smartcrop_w184_h184_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fko%2Fmirrormedia.mg%2F119a96796437adcef46480f42243daa7.jpg\",\"width\":184}]},\"title\":\"柯文哲完蛋了　大帳房李文宗認罪與柯掏空眾望基金會\"},\"contentType\":\"Story\",\"id\":\"1e797b2b-c2ec-3d2c-b029-b74ee603f49b\"},{\"content\":{\"author\":\"$undefined\",\"canonicalUrl\":{\"url\":\"https://tw.news.yahoo.com/%E9%81%AD%E5%BE%90%E5%B7%A7%E8%8A%AF%E5%97%86-%E6%88%91%E5%80%91%E6%9C%83%E8%B4%8F-%E7%9A%84%E8%94%A3%E8%90%AC%E5%AE%89%E5%AD%B8%E5%BC%9F%E6%A5%8A%E7%9B%9B%E5%AE%89%E7%99%BC%E9%95%B7%E6%96%87%E8%AB%87%E6%B2%88%E4%BC%AF%E6%B4%8B-%E5%90%8C%E5%9C%A8%E6%B0%B8%E5%90%89%E8%B7%AF%E9%95%B7%E5%A4%A7-%E4%BB%96%E5%BE%9E%E4%BE%86%E6%B2%92%E6%9C%89%E9%9B%A2%E9%96%8B%E9%81%8E%E4%BA%94%E5%88%86%E5%9F%94-222920751.html\"},\"canvass\":{\"count\":38},\"categoryLabel\":\"$undefined\",\"clickThroughUrl\":{\"url\":\"https://tw.news.yahoo.com/%E9%81%AD%E5%BE%90%E5%B7%A7%E8%8A%AF%E5%97%86-%E6%88%91%E5%80%91%E6%9C%83%E8%B4%8F-%E7%9A%84%E8%94%A3%E8%90%AC%E5%AE%89%E5%AD%B8%E5%BC%9F%E6%A5%8A%E7%9B%9B%E5%AE%89%E7%99%BC%E9%95%B7%E6%96%87%E8%AB%87%E6%B2%88%E4%BC%AF%E6%B4%8B-%E5%90%8C%E5%9C%A8%E6%B0%B8%E5%90%89%E8%B7%AF%E9%95%B7%E5%A4%A7-%E4%BB%96%E5%BE%9E%E4%BE%86%E6%B2%92%E6%9C%89%E9%9B%A2%E9%96%8B%E9%81%8E%E4%BA%94%E5%88%86%E5%9F%94-222920751.html\"},\"color\":\"$undefined\",\"contentType\":\"Story\",\"duration\":\"$undefined\",\"id\":\"99d3e6a9-804c-3693-8619-a85e8636fb3f\",\"isHosted\":true,\"label\":\"$undefined\",\"liveVideo\":\"$undefined\",\"mabLogString\":\"$undefined\",\"originalTitle\":\"遭徐巧芯嗆「我們會贏」的蔣萬安學弟楊盛安發長文談沈伯洋：同在永吉路長大，「他從來沒有離開過五分埔」！憶復興校園的民主啟蒙與台語歧視\",\"photoVariants\":\"$undefined\",\"provider\":{\"displayName\":\"放言 Fount Media\",\"id\":\"$undefined\",\"logo\":{\"resolutions\":[]},\"sourceId\":\"$undefined\",\"url\":\"$undefined\"},\"providerContentUrl\":\"$undefined\",\"pubDate\":\"2026-10-18T22:29:20Z\",\"summary\":\"「他從來沒有離開過五分埔。」10月18日上午，帶著兩個兒子的楊盛安，當面向台北市長蔣萬安表明自己是學弟，但這次支持沈伯洋，一旁的國民黨立委徐巧芯隨即接話「我們還是會贏」。楊盛安隨後在臉書發表長文，分享支持沈伯洋的原因：兩人同在永吉路一帶長大，看到沈伯洋走訪社區，細數水果攤、麵線與油飯店，熟悉的街坊記憶讓他感受到，即使沈伯洋赴美求學、搬家、當上立委，始終沒有離開成長的地方。\",\"tags\":[],\"thumbnail\":{\"crop\":\"$undefined\",\"originalHeight\":\"$undefined\",\"originalUrl\":\"https://media.zenfs.com/zh-tw/fountmedia_io_269/cec6d4909d412e88779a45540b1c4210\",\"originalWidth\":\"$undefined\",\"resolutions\":[{\"height\":280,\"tag\":\"498x280\",\"transformLabel\":\"498x280\",\"url\":\"https://s.yimg.com/lo/mysterio/api/990EBA1A56113BEDF715ADA8210BFFAA7410B56B92134841FBEA904A10445A08/subgraphmysterio/smartcrop_w498_h280_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fzh-tw%2Ffountmedia_io_269%2Fcec6d4909d412e88779a45540b1c4210\",\"width\":498},{\"height\":184,\"tag\":\"184x184\",\"transformLabel\":\"184x184\",\"url\":\"https://s.yimg.com/lo/mysterio/api/E178B6A220C338C1B4B1A958BA6D204FEDA66A5136103DE644815545112E2BD7/subgraphmysterio/smartcrop_w184_h184_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fzh-tw%2Ffountmedia_io_269%2Fcec6d4909d412e88779a45540b1c4210\",\"width\":184}]},\"title\":\"遭徐巧芯嗆「我們會贏」的蔣萬安學弟楊盛安發長文談沈伯洋：同在永吉路長大，「他從來沒有離開過五分埔」！憶復興校園的民主啟蒙與台語歧視\"},\"contentType\":\"Story\",\"id\":\"99d3e6a9-804c-3693-8619-a85e8636fb3f\"},{\"content\":{\"author\":\"$undefined\",\"canonicalUrl\":{\"url\":\"https://tw.news.yahoo.com/%E6%B4%8B%E6%B5%81%E8%AE%8A%E6%B5%B7%E5%98%AF-%E5%8F%B0%E5%8C%97%E5%B8%82%E9%95%B7%E6%B0%91%E8%AA%BF%E5%B0%87%E6%8F%AD%E6%9B%89-%E6%88%B4%E7%AB%8B%E5%AE%89%E8%84%AB%E5%8F%A31%E5%A4%A7%E5%AF%A6%E8%A9%B1-%E6%80%A5%E5%96%8A%E5%8D%A1-072524424.html\"},\"canvass\":{\"count\":55},\"categoryLabel\":\"$undefined\",\"clickThroughUrl\":{\"url\":\"https://tw.news.yahoo.com/%E6%B4%8B%E6%B5%81%E8%AE%8A%E6%B5%B7%E5%98%AF-%E5%8F%B0%E5%8C%97%E5%B8%82%E9%95%B7%E6%B0%91%E8%AA%BF%E5%B0%87%E6%8F%AD%E6%9B%89-%E6%88%B4%E7%AB%8B%E5%AE%89%E8%84%AB%E5%8F%A31%E5%A4%A7%E5%AF%A6%E8%A9%B1-%E6%80%A5%E5%96%8A%E5%8D%A1-072524424.html\"},\"color\":\"$undefined\",\"contentType\":\"Story\",\"duration\":\"$undefined\",\"id\":\"3d136d68-d235-329a-a344-3d4f3b132008\",\"isHosted\":true,\"label\":\"$undefined\",\"liveVideo\":\"$undefined\",\"mabLogString\":\"$undefined\",\"originalTitle\":\"洋流變海嘯！台北市長民調將揭曉「戴立安脫口1大實話」急喊卡\",\"photoVariants\":\"$undefined\",\"provider\":{\"displayName\":\"民視\",\"id\":\"$undefined\",\"logo\":{\"resolutions\":[]},\"sourceId\":\"$undefined\",\"url\":\"$undefined\"},\"providerContentUrl\":\"$undefined\",\"pubDate\":\"2026-10-19T07:38:13Z\",\"summary\":\"政治中心／綜合報導2026九合一大選進入倒數，台北市長蔣萬安力拚連任，民進黨參選人沈伯洋則持續帶動「洋流」話題，雙方選情受到外界關注，台北市信民兩岸研究協會今（19日）正式預告，將於明（20日）公布最新一波台北市長民調，這也是繼9月雙方支持度僅差1.2個百分點後，再度針對首都市長選戰進行調查，民調專家戴立安更在日前忍不住透露，新數據與9月中旬相比「應該也還會是有一個落差」，並點名這波「洋流效應」其實是蔣萬安與沈伯洋兩人共同創造，如今民調公布時間正式敲定，也讓外界關注台北選情是否出現新的變化。\",\"tags\":[],\"thumbnail\":{\"crop\":\"$undefined\",\"originalHeight\":\"$undefined\",\"originalUrl\":\"https://media.zenfs.com/ko/ftvn.com.tw/c1a9b3d98c3bdcf40d86ccdfd518a560.jpg\",\"originalWidth\":\"$undefined\",\"resolutions\":[{\"height\":280,\"tag\":\"498x280\",\"transformLabel\":\"498x280\",\"url\":\"https://s.yimg.com/lo/mysterio/api/D998463E6D1E1B6337EA58D8B1A87C3E6DD07F8E9DE4B062985D4A6D013135A4/subgraphmysterio/smartcrop_w498_h280_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fko%2Fftvn.com.tw%2Fc1a9b3d98c3bdcf40d86ccdfd518a560.jpg\",\"width\":498},{\"height\":184,\"tag\":\"184x184\",\"transformLabel\":\"184x184\",\"url\":\"https://s.yimg.com/lo/mysterio/api/48CA993D57A3ED78E0B1F4BE37D55E95A9B5595906A3368FD0756CB4EC3776BC/subgraphmysterio/smartcrop_w184_h184_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fko%2Fftvn.com.tw%2Fc1a9b3d98c3bdcf40d86ccdfd518a560.jpg\",\"width\":184}]},\"title\":\"洋流變海嘯！台北市長民調將揭曉「戴立安脫口1大實話」急喊卡\"},\"contentType\":\"Story\",\"id\":\"3d136d68-d235-329a-a344-3d4f3b132008\"},{\"ad\":true},{\"content\":{\"author\":\"$undefined\",\"canonicalUrl\":{\"url\":\"https://tw.news.yahoo.com/%E9%A2%B1%E9%A2%A8%E5%81%87%E6%8E%B0%E4%BA%86-%E8%96%94%E7%90%B5%E6%9C%80%E6%96%B0%E8%B7%AF%E5%BE%91%E9%A0%90%E6%B8%AC%E5%8F%88%E5%8C%97%E4%BF%AE-%E6%9D%B1%E4%BF%AE-%E6%B0%A3%E8%B1%A1%E7%BD%B2%E4%BC%B0-%E4%B8%8D%E4%BE%B5%E8%A5%B2-083600806.html\"},\"canvass\":{\"count\":16},\"categoryLabel\":\"$undefined\",\"clickThroughUrl\":{\"url\":\"https://tw.news.yahoo.com/%E9%A2%B1%E9%A2%A8%E5%81%87%E6%8E%B0%E4%BA%86-%E8%96%94%E7%90%B5%E6%9C%80%E6%96%B0%E8%B7%AF%E5%BE%91%E9%A0%90%E6%B8%AC%E5%8F%88%E5%8C%97%E4%BF%AE-%E6%9D%B1%E4%BF%AE-%E6%B0%A3%E8%B1%A1%E7%BD%B2%E4%BC%B0-%E4%B8%8D%E4%BE%B5%E8%A5%B2-083600806.html\"},\"color\":\"$undefined\",\"contentType\":\"Story\",\"duration\":\"$undefined\",\"id\":\"257142f1-19ea-398b-b543-5fe8c06fee4e\",\"isHosted\":true,\"label\":\"$undefined\",\"liveVideo\":\"$undefined\",\"mabLogString\":\"$undefined\",\"originalTitle\":\"颱風假掰了？薔琵最新路徑預測又北修、東修！氣象署估「不侵襲」\",\"photoVariants\":\"$undefined\",\"provider\":{\"displayName\":\"三立新聞網 setn.com\",\"id\":\"$undefined\",\"logo\":{\"resolutions\":[]},\"sourceId\":\"$undefined\",\"url\":\"$undefined\"},\"providerContentUrl\":\"$undefined\",\"pubDate\":\"2026-10-19T08:36:00Z\",\"summary\":\"薔琵颱風朝西北西移動接近台灣東方海面，氣象署最新預報顯示其路徑北修且「不侵襲」台灣。明各地多雲到晴最熱，週三起東北季風增強使北部轉涼並有雨。週五至下週日受颱風外圍環流影響，北部及東北部將有陣雨並伴隨局部大雨或豪雨，請民眾多加留意天氣變化並預做防範準備。\",\"tags\":[],\"thumbnail\":{\"crop\":\"$undefined\",\"originalHeight\":\"$undefined\",\"originalUrl\":\"https://media.zenfs.com/ko/setn.com.tw/fb430839a7b9c419a8a71ef42cb0fd65.jpg\",\"originalWidth\":\"$undefined\",\"resolutions\":[{\"height\":280,\"tag\":\"498x280\",\"transformLabel\":\"498x280\",\"url\":\"https://s.yimg.com/lo/mysterio/api/A39C57B3D11DC17781A121D1B25A8EF18E5C8D44DD29ADF109C25938A5A9BA9C/subgraphmysterio/smartcrop_w498_h280_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fko%2Fsetn.com.tw%2Ffb430839a7b9c419a8a71ef42cb0fd65.jpg\",\"width\":498},{\"height\":184,\"tag\":\"184x184\",\"transformLabel\":\"184x184\",\"url\":\"https://s.yimg.com/lo/mysterio/api/64F2275466FABA80A6F16A5CDE95E6F51754A9980FA28AE00815263A5FAEA1A6/subgraphmysterio/smartcrop_w184_h184_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fko%2Fsetn.com.tw%2Ffb430839a7b9c419a8a71ef42cb0fd65.jpg\",\"width\":184}]},\"title\":\"颱風假掰了？薔琵最新路徑預測又北修、東修！氣象署估「不侵襲」\"},\"contentType\":\"Story\",\"id\":\"257142f1-19ea-398b-b543-5fe8c06fee4e\"},{\"content\":{\"author\":\"$undefined\",\"canonicalUrl\":{\"url\":\"https://tw.news.yahoo.com/%E8%94%A3%E8%90%AC%E5%AE%89%E6%88%B0%E6%B2%88%E4%BC%AF%E6%B4%8B-%E9%80%99%E5%8D%80%E6%9C%80%E6%96%B0%E8%A1%97%E9%A0%AD%E6%B0%91%E8%AA%BF%E7%B5%90%E6%9E%9C%E8%B7%8C%E7%A0%B4%E7%9C%BC%E9%8F%A1-122436073.html\"},\"canvass\":{\"count\":128},\"categoryLabel\":\"$undefined\",\"clickThroughUrl\":{\"url\":\"https://tw.news.yahoo.com/%E8%94%A3%E8%90%AC%E5%AE%89%E6%88%B0%E6%