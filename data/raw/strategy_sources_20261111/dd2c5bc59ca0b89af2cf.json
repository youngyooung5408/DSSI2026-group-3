    {
      "text": "賢蔚成功爭取 湖山光影節...",
      "url": "https://tcc10720.tcc.gov.tw/News_Content.aspx?n=68716B293568B5EC&sms=4E404571D3B48C3A&s=073E85F8C52254D1"
    },
    {
      "text": "...詳全文",
      "url": "https://tcc10720.tcc.gov.tw/News_Content.aspx?n=68716B293568B5EC&sms=4E404571D3B48C3A&s=073E85F8C52254D1"
    },
    {
      "text": "...詳全文",
      "url": "https://tcc10720.tcc.gov.tw/News_Content.aspx?n=68716B293568B5EC&sms=4E404571D3B48C3A&s=073E85F8C52254D1"
    },
    {
      "text": "賢蔚重大成績一次看 馬上...",
      "url": "https://tcc10720.tcc.gov.tw/News_Content.aspx?n=68716B293568B5EC&sms=4E404571D3B48C3A&s=1D1FD99A1B9EAC50"
    },
    {
      "text": "輝達簽約 士北起飛 6大...",
      "url": "https://tcc10720.tcc.gov.tw/News_Content.aspx?n=68716B293568B5EC&sms=4E404571D3B48C3A&s=07EF509282A43DA8"
    },
    {
      "text": "年貨大街宣傳獨漏士林夜市...",
      "url": "https://tcc10720.tcc.gov.tw/News_Content.aspx?n=68716B293568B5EC&sms=4E404571D3B48C3A&s=059A81DAACE9F0EA"
    },
    {
      "text": "賢蔚成功爭取捷運新北投站...",
      "url": "https://tcc10720.tcc.gov.tw/News_Content.aspx?n=68716B293568B5EC&sms=4E404571D3B48C3A&s=7802ED53CDAB689C"
    },
    {
      "text": "士林區新圓環 用路請小心",
      "url": "https://tcc10720.tcc.gov.tw/News_Content.aspx?n=68716B293568B5EC&sms=4E404571D3B48C3A&s=F850816BA14A2340"
    },
    {
      "text": "北投拚觀光 市長挺不挺",
      "url": "https://tcc10720.tcc.gov.tw/News_Content.aspx?n=68716B293568B5EC&sms=4E404571D3B48C3A&s=FF39417D01A15D6B"
    },
    {
      "text": "宣誓台北市成為「你敢生，...",
      "url": "https://tcc10720.tcc.gov.tw/News_Content.aspx?n=68716B293568B5EC&sms=4E404571D3B48C3A&s=D39B20B76E2FA6F5"
    },
    {
      "text": "搶救北士科交通 市府怎麼...",
      "url": "https://tcc10720.tcc.gov.tw/News_Content.aspx?n=68716B293568B5EC&sms=4E404571D3B48C3A&s=4F0E1AAE1FBA9BBA"
    },
    {
      "text": "優化餵養管理政策 保護流...",
      "url": "https://tcc10720.tcc.gov.tw/News_Content.aspx?n=68716B293568B5EC&sms=4E404571D3B48C3A&s=FCE81C6C46D1A2AE"
    },
    {
      "text": "士林市場內有古蹟！大家知...",
      "url": "https://tcc10720.tcc.gov.tw/News_Content.aspx?n=68716B293568B5EC&sms=4E404571D3B48C3A&s=CDDDDEE3E43FF87C"
