                height:height+ 'px',
                padding:'0px',
                top:($(window).height()-height)/2 + 'px',
                left:($(window).width()-width)/2 + 'px'
                }
            });
        }
    }

    function close_layer_detail() {
        $.unblockUI();
    } 

