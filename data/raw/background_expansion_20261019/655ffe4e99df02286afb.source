<script>
    ;
    (function() {
        const bodyDom = document.querySelector('body');
        const loadingDom = document.querySelector('.loadingArea');
        bodyDom.classList.add('loadingOverflow');

                if (!navigator.cookieEnabled) {
            removeLoading();
            return;
        }

                const loadingSession = sessionStorage.getItem('loading');
        if (loadingSession === 'ok') {
            removeLoading();
            return;
        }

        sessionStorage.setItem('loading', 'ok');
        setTimeout(showLoading, 500);
        setTimeout(hideLoading, 2500);
        setTimeout(removeLoading, 3500);

        
        function showLoading() {
            loadingDom.classList.add('show');

            // loading執行時移除afterLoadingMask，避免跟loading動畫重疊
            const afterLoadingMask = document.querySelector('.afterLoadingMask');
            if (afterLoadingMask) {
                afterLoadingMask.remove();
            }
        }

        
        function hideLoading() {
            loadingDom.classList.add('hide');
            loadingDom.style.pointerEvents = "none";
        }

        
        function removeLoading() {
            loadingDom.remove();
            bodyDom.classList.remove('loadingOverflow');

            // 晚點出現 privacyArea
            setTimeout(function() {
                const privacyArea = document.querySelector('.privacyArea');
                if (privacyArea) {
                    privacyArea.classList.add('show');
                }
            }, 1500);

            setTimeout(function() {
                bodyDom.classList.add('afterLoading');
            }, 10)

        }
    })();
</script>
