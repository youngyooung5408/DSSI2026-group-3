</style>
<script type="text/javascript">
  $(function(){
    $('.annc-comment-div .btn-comment').click(function(){
      $.ajax({
        url: "/xhr/announcements/%E4%BA%9E%E6%B4%B2%E5%A4%A7%E5%AD%B8%E8%B2%A1%E6%B3%95%E7%B3%BB%E8%B3%B4%E8%8B%A1%E4%BB%BB%E9%8C%84%E5%8F%96%E5%8C%97%E5%A4%A7%E6%B3%95%E5%AD%B8%E9%99%A2%E5%8D%9A%E5%A3%AB%E7%8F%AD-17610133-17610133/comment",
        data : {"comment" : $(this).parents('.annc-comment-div').find('.announcement-comment').html()},
        dataType : "json",
        type : "get",
        success : function(data){
          window.location.href = window.location.href
        }
      })
    })
  })
</script>
