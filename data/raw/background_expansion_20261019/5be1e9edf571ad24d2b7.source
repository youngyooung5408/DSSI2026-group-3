<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>新竹市民許願池 ｜ 莊競程</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700;900&display=swap" rel="stylesheet">
<style>
  :root{ 
    --brand:#2e7d32; 
    --brand-dark:#1b5e20; 
    --accent:#f59e0b; 
    --bg:#f4fbf7; 
    --card:#ffffff; 
    --text:#1a2433; 
    --muted:#667085; 
    --line:#e5eadc; 
    --ok:#16a34a; 
    --warn:#dc2626; 
    --chip:#e8f5e9; 
    --chip-active:#2e7d32; 
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;font-family:"Noto Sans TC",system-ui,-apple-system,sans-serif;color:var(--text);background:var(--bg);}
  a{color:var(--brand);text-decoration:none;}

  header.site{
    background:linear-gradient(135deg, #1b5e20 0%, #2e7d32 60%, #43a047 140%);
    color:#fff;padding:18px 24px;display:flex;align-items:center;justify-content:space-between;gap:16px;
    box-shadow:0 2px 10px rgba(27, 94, 32, .2);
  }
  header.site .brand{display:flex;align-items:center;gap:12px;}
  header.site .logo{width:44px;height:44px;border-radius:12px;background:#fff;color:var(--brand);display:flex;align-items:center;justify-content:center;font-weight:900;font-size:20px;}
  header.site h1{margin:0;font-size:20px;font-weight:900;letter-spacing:.5px;}
  header.site .sub{font-size:12px;opacity:.85;margin-top:2px;}
  
  main{max-width:980px;margin:0 auto;padding:24px;}
  .page{animation:fade .2s ease;}
  @keyframes fade{from{opacity:0;transform:translateY(4px);}to{opacity:1;transform:none;}}

  .card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:24px;margin-bottom:20px;box-shadow:0 1px 2px rgba(0,0,0,.02);}
  .card h2{margin:0 0 6px;font-size:22px;font-weight:900;}
  .card .lede{color:var(--muted);margin:0 0 18px;line-height:1.6;}

  .field{margin-bottom:18px;}
  .label{display:block;font-weight:700;margin-bottom:8px;font-size:14px;}
  .label .req{color:var(--warn);margin-left:4px;}
  .label .hint{font-weight:400;color:var(--muted);font-size:12px;margin-left:6px;}
  input[type=text],input[type=tel],input[type=number],input[type=email],textarea,select{
    width:100%;padding:11px 12px;border:1.5px solid var(--line);border-radius:10px;font-family:inherit;font-size:15px;background:#fff;color:var(--text);
  }
  textarea{resize:vertical;min-height:120px;line-height:1.6;}
  input:focus,textarea:focus,select:focus{outline:none;border-color:var(--brand);box-shadow:0 0 0 3px rgba(46, 125, 50, .15);}
  .row{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
  @media (max-width:640px){.row{grid-template-columns:1fr;}}

  .chips{display:flex;flex-wrap:wrap;gap:8px;}
  .chip{
    padding:9px 16px;background:var(--chip);color:#334;border-radius:999px;cursor:pointer;font-size:14px;font-weight:600;user-select:none;
    border:1.5px solid transparent;transition:all .15s;
  }
  .chip:hover{background:#c8e6c9;} 
  .chip.active{background:var(--brand);color:#fff;border-color:var(--brand-dark);}

  .conditional{border-left:3px solid var(--brand);background:#f4fbf7;padding:14px 16px;border-radius:8px;margin-top:10px;display:none;}
  .conditional.show{display:block;}
  .checkbox-row{display:flex;align-items:flex-start;gap:10px;padding:12px;background:#fafdfb;border:1px solid var(--line);border-radius:10px;cursor:pointer;}
  .checkbox-row input{margin-top:3px;accent-color:var(--brand);} 
  .checkbox-row .text{flex:1;}
  .checkbox-row .text strong{display:block;margin-bottom:3px;}
  .checkbox-row .text small{color:var(--muted);}

  .btn{cursor:pointer;border:0;border-radius:10px;padding:10px 14px;font-weight:700;font-family:inherit;font-size:14px;transition:all .15s ease;}
  .btn-primary{background:var(--brand);color:#fff;}
  .btn-primary:hover{background:var(--brand-dark);}

  footer{padding:24px;text-align:center;color:var(--muted);font-size:12px;}
</style>
</head>
<body>

<header class="site">
  <div class="brand">
    <div class="logo">竹</div>
    <div>
      <h1>新竹市民許願池</h1>
      <div class="sub">與莊競程一起，讓新竹更好</div>
    </div>
  </div>
</header>

<main>
  
<style>
:root {
    --primary-green: #78c497;
    --primary-hover: #5db681;
    --accent-orange: #f29876;
    --accent-yellow: #fff100;
    --brand-dark: #333333;
    --text-grey: #9e948a;
    --light-mint: #f4fbf7;
    --border-green: #bfdfb8;
  }

  .card { border-top: 5px solid var(--primary-green) !important; }

  .btn-primary {
    background-color: var(--primary-green) !important;
    border-color: var(--primary-green) !important;
    color: white !important;
    font-weight: bold;
    box-shadow: 0 2px 4px rgba(46, 125, 50, 0.15);
    transition: all 0.2s ease-in-out;
  }
  .btn-primary:hover {
    background-color: var(--primary-hover) !important;
    border-color: var(--primary-hover) !important;
    box-shadow: 0 4px 12px rgba(46, 125, 50, 0.3);
  }

  .chip.active {
    background-color: var(--primary-green) !important;
    color: white !important;
    border-color: var(--primary-hover) !important;
    font-weight: bold;
  }

  input[type="checkbox"] { accent-color: var(--primary-green) !important; }

  .conditional {
    background-color: var(--light-mint) !important;
    border-left: 4px solid var(--primary-green) !important;
    padding: 15px;
    border-radius: 4px;
    margin-top: 10px;
  }

  .marquee-wrapper {
    overflow: hidden;
    width: 100%;
    position: relative;
    padding: 15px 0; 
    transition: max-height 0.3s ease;
  }
  
  .marquee-track {
    display: inline-flex;
    gap: 20px;
    animation: scroll-marquee 2195s linear infinite; 
  }
  
  .marquee-track:hover { animation-play-state: paused; }
  
  .wish-card {
    width: 320px; 
    flex-shrink: 0; 
    white-space: normal; 
    background: var(--card); 
    border: 1px solid var(--line); 
    border-left: 5px solid var(--primary-green); 
    border-radius: 12px; 
    padding: 20px; 
    box-shadow: 0 4px 12px rgba(46, 125, 50, 0.05);
    cursor: pointer;
    position: relative;
    transition: all 0.2s ease;
  }

  .wish-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 16px rgba(46, 125, 50, 0.15);
    border-color: var(--primary-green);
  }

  .wish-card p {
    display: -webkit-box;
    -webkit-line-clamp: 6; 
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .endorse-badge {
    position: absolute;
    top: -12px;
    right: -10px;
    background-color: var(--accent-orange) !important;
    color: white;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 900;
    opacity: 0;
    transform: scale(0.8);
    transition: all 0.2s ease;
    box-shadow: 0 2px 6px rgba(0,0,0,0.2);
    pointer-events: none; 
  }

  .wish-card:hover .endorse-badge {
    opacity: 1;
    transform: scale(1);
  }

  @keyframes scroll-marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); } 
  }

  .btn-toggle-wall {
    background-color: white;
    color: var(--primary-green);
    border: 2px solid var(--primary-green);
    padding: 8px 20px;
    border-radius: 30px;
    font-size: 14px;
    font-weight: bold;
    cursor: pointer;
    transition: all 0.2s;
    display: block;
    margin: 0 auto 15px auto;
  }
  .btn-toggle-wall:hover { background-color: var(--light-mint); }

  .marquee-wrapper.is-expanded {
    max-height: 600px;
    overflow-y: auto;
    padding: 15px 10px; 
    border-radius: 12px;
    background-color: rgba(46, 125, 50, 0.03);
    border: 1px inset rgba(46, 125, 50, 0.1);
  }

  .marquee-wrapper.is-expanded::-webkit-scrollbar {
    width: 8px;
  }
  .marquee-wrapper.is-expanded::-webkit-scrollbar-track {
    background: #f1f1f1; 
    border-radius: 10px;
  }
  .marquee-wrapper.is-expanded::-webkit-scrollbar-thumb {
    background: var(--border-green); 
    border-radius: 10px;
  }
  .marquee-wrapper.is-expanded::-webkit-scrollbar-thumb:hover {
    background: var(--primary-green); 
  }

  .marquee-wrapper.is-expanded .marquee-track {
    animation: none !important;
    flex-wrap: wrap; 
    justify-content: center; 
    align-items: flex-start; 
    gap: 20px;
  }
  .marquee-wrapper.is-expanded .duplicate-card { display: none !important; }

  .modal-overlay {
    position: fixed;
    top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(0,0,0,0.6);
    z-index: 9999;
    display: none;
    justify-content: center;
    align-items: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .modal-overlay.show { display: flex; opacity: 1; }
  
  .modal-box {
    background: white;
    width: 90%;
    max-width: 500px;
    border-radius: 12px;
    padding: 30px;
    position: relative;
    box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    transform: translateY(20px);
    transition: transform 0.3s ease;
    border-top: 5px solid var(--primary-green);
    max-height: 85vh;
    overflow-y: auto;
  }
  .modal-overlay.show .modal-box { transform: translateY(0); }
  
  .modal-close {
    position: absolute;
    top: 15px; right: 20px;
    font-size: 28px;
    cursor: pointer;
    color: #999;
    line-height: 1;
  }
  .modal-close:hover { color: #333; }
</style>


<div class="wish-wall" style="margin-bottom: 40px; animation: fade .2s ease;">
    <h2 style="color: #1b5e20; text-align: center; margin-bottom: 15px; font-weight: 900; font-size: 24px;">🌳 市民心聲許願牆</h2>
    <p style="text-align: center; color: var(--muted); font-size: 14px; margin-bottom: 20px;">點選卡片可閱讀完整內容，還能一鍵附議喔！</p>
    
    <button type="button" id="toggleWallBtn" class="btn-toggle-wall">👁️ 展開全部心聲</button>
    
    <div class="marquee-wrapper" id="marqueeWrapper">
        <div class="marquee-track">
            
            <div class="wish-card" 
                 onclick="openModal(this)" 
                 data-area="" 
                 data-topics="其他" 
                 data-content="希望莊競程可以更主動出擊，打開知名度。不用一直死打高虹安，而是讓更多新竹人看到你的優秀、你的不同、你可以帶給新竹的未來。">
                
