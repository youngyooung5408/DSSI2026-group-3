<audio id="bgm" loop preload="none"
       src="/uploads/campaign-song.m4a"></audio>
<button class="bgm-btn" type="button" id="bgm-btn" aria-pressed="false"
        aria-label="播放或暫停背景音樂：林鈺梅競選歌曲">
  <span class="bgm-ico" aria-hidden="true">♪</span>
  <span class="bgm-txt"></span>
</button>
<script>
(function(){
  var a=document.getElementById('bgm'), b=document.getElementById('bgm-btn');
  if(!a||!b) return;
  var VOL=35/100;
  var KEY='bgm-off', POS='bgm-pos', TXT=b.querySelector('.bgm-txt');
  a.volume=VOL;

  function paint(on){
    b.setAttribute('aria-pressed', on?'true':'false');
    b.classList.toggle('on', on);
    TXT.textContent = on ? '音樂開' : '音樂關';
  }

  /* 接續上一頁的播放進度。
     不要在這裡呼叫 a.load() —— 它會把 currentTime 重設成 0，
     而且 play() 本身就會觸發載入。
     seek 也不能只綁一次：preload="none" 只是提示，Chrome 有時會提前
     載入 metadata，那個事件會白白消耗掉一次性的監聽器。
     所以綁兩個事件、用 seeked 旗標確保只真正生效一次。 */
  var pos=parseFloat(sessionStorage.getItem(POS)||'0'), seeked=false;
  function seek(){
    if(seeked || !(pos>0)) return;
    if(isFinite(a.duration) && pos<a.duration){
      try{ a.currentTime=pos; seeked=true; }catch(e){}
    }
  }
  a.addEventListener('loadedmetadata', seek);
  a.addEventListener('canplay', seek);
  /* 保險：沒有 Range 支援時瀏覽器要整個檔下載完才跳得動，
     所以緩衝進度每次更新都再試一次，成功一次就不再試 */
  a.addEventListener('progress', seek);

  /* 每秒把進度寫下來，換頁才接得上；離開頁面前再寫一次 */
  var last=0;
  a.addEventListener('timeupdate', function(){
    var t=a.currentTime;
    if(t-last>1 || t<last){ last=t; sessionStorage.setItem(POS, t); }
  });
  addEventListener('pagehide', function(){
    if(!a.paused) sessionStorage.setItem(POS, a.currentTime);
  });

  function start(){
    seek();
    return a.play().then(function(){ seek(); paint(true); return true; })
                   .catch(function(){ paint(false); return false; });
  }

  /* 使用者按過靜音就不要再自己播 */
  if(sessionStorage.getItem(KEY)==='1'){ paint(false); }
  else{
    start().then(function(ok){
      if(ok) return;
      /* 被瀏覽器擋下來 —— 等使用者做出「算得上手勢」的動作再播。

         ⚠️ 兩個容易搞錯的地方：
         1) scroll 和 touchstart 在瀏覽器眼裡都「不算」使用者手勢，
            解鎖不了音訊。真正算的是 pointerdown/pointerup/mousedown/
            touchend/keydown/keyup/click。scroll 還是留著，
            萬一該瀏覽器放寬了就順便播，反正失敗也只是繼續等。
         2) 監聽器絕對不能用 once —— 使用者滑一下會觸發、但播不起來，
            如果那時就把監聽器移除，之後真的點下去就永遠不會播了。
            所以只有「播放成功」才移除。 */
      var events=['pointerdown','pointerup','mousedown','touchend',
                  'keydown','keyup','click','scroll'];
      var trying=false;
      var off=function(){
        events.forEach(function(e){ removeEventListener(e, unlock, true); });
      };
      var unlock=function(){
        if(sessionStorage.getItem(KEY)==='1'){ off(); return; }
        if(trying) return;              /* scroll 會連發，同時只試一次 */
        trying=true;
        start().then(function(ok){ trying=false; if(ok) off(); });
      };
      events.forEach(function(e){
        addEventListener(e, unlock, {capture:true, passive:true});
      });
    });
  }

  b.addEventListener('click', function(){
    if(a.paused){ sessionStorage.removeItem(KEY); start(); }
    else{ a.pause(); sessionStorage.setItem(KEY,'1'); paint(false); }
  });
})();
</script>
<script>
/* 回到最上面：捲超過一個畫面高才顯示 */
(() => {
  const btn = document.querySelector('.totop');
  if (!btn) return;
  const toggle = () => btn.classList.toggle('is-on', scrollY > innerHeight * .8);
  addEventListener('scroll', toggle, {passive:true});
  toggle();
  btn.addEventListener('click', () => scrollTo({top:0,
    behavior: matchMedia('(prefers-reduced-motion:reduce)').matches ? 'auto' : 'smooth'}));
})();

(() => {
  const bar = document.getElementById('filters');
  if (!bar) return;
  bar.addEventListener('click', e => {
    const btn = e.target.closest('button'); if (!btn) return;
    document.querySelectorAll('#filters button')
      .forEach(b => b.setAttribute('aria-pressed', String(b === btn)));
    const cat = btn.dataset.cat;
    document.querySelectorAll('.card').forEach(c => {
      c.style.display = (cat === 'all' || c.dataset.cat === cat) ? '' : 'none';
    });
  });
})();

(() => {
  const btn = document.getElementById('share');
  if (!btn) return;
  btn.addEventListener('click', async e => {
    e.preventDefault();
    const data = {title: document.title,
                  text:"潭子・大雅・神岡 台中市議員候選人", url:location.href};
    if (navigator.share) { try { await navigator.share(data); } catch {} }
    else { await navigator.clipboard.writeText(location.href); alert('網址已複製'); }
  });
})();

document.querySelectorAll('[data-carousel]').forEach(box => {
  const track = box.querySelector('.car-track');
  const prev  = box.querySelector('[data-dir="-1"]');
  const next  = box.querySelector('[data-dir="1"]');
  if (!track) return;
  const step = () => {
    const card = track.querySelector('li');
    return card ? card.getBoundingClientRect().width + 16 : track.clientWidth * .85;
  };
  box.querySelectorAll('[data-dir]').forEach(b => b.addEventListener('click', () =>
    track.scrollBy({left: Number(b.dataset.dir) * step(),
      behavior: matchMedia('(prefers-reduced-motion:reduce)').matches ? 'auto' : 'smooth'})));
  const sync = () => {
    const end = track.scrollWidth - track.clientWidth - 4;
    if (prev) prev.disabled = track.scrollLeft <= 4;
    if (next) next.disabled = track.scrollLeft >= end;
  };
  track.addEventListener('scroll', sync, {passive:true});
  addEventListener('resize', sync);
  sync();
});

/* 縮圖：YouTube 沒有那個尺寸時不是回 404 而已，而是回一張 120×90 的灰底圖，
   所以要用載進來的實際尺寸判斷，onerror 抓不到這種情況。
   順便用實際比例校正卡片形狀，後台選錯方向也會自己修好。 */
document.querySelectorAll('.vthumb img[data-alt]').forEach(img => {
  const card = img.closest('.vcard');
  const alt = () => {
    const url = img.dataset.alt;
    if (!url) return false;
    img.removeAttribute('data-alt');
    img.src = url;
    return true;
  };
  const check = () => {
    if (!img.naturalWidth) return;
    if (img.naturalWidth <= 120 && alt()) return;
    const ratio = img.naturalWidth / img.naturalHeight;
    card.classList.toggle('vertical', ratio < .85);
    card.classList.toggle('square', ratio >= .85 && ratio < 1.2);
  };
  img.addEventListener('load', check);
  img.addEventListener('error', alt);
  if (img.complete) check();
});

document.querySelectorAll('.vcard[data-yt]').forEach(card => {
  card.addEventListener('click', e => {
    e.preventDefault();
    if (card.classList.contains('playing')) return;
    const box = card.querySelector('.vthumb');
    const f = document.createElement('iframe');
    f.src = 'https://www.youtube-nocookie.com/embed/' + card.dataset.yt +
            '?autoplay=1&rel=0&playsinline=1';
    /* 最新消息的直式影片卡沒有 .vmeta（整張卡就是影片），標題改放在 data-title */
    f.title = card.querySelector('.vmeta b')?.textContent || card.dataset.title || '';
    f.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; fullscreen';
    f.setAttribute('allowfullscreen', '');
    box.replaceChildren(f);
    card.classList.add('playing');
  });
});

document.querySelectorAll('[data-copy]').forEach(btn => {
  btn.addEventListener('click', async () => {
    const text = btn.dataset.copy;
    const label = btn.textContent;
    let ok = false;
    try { await navigator.clipboard.writeText(text); ok = true; } catch (e) {
      // 舊瀏覽器或非 https 沒有 clipboard API，退回老方法
      const t = document.createElement('textarea');
      t.value = text; t.style.position = 'fixed'; t.style.opacity = '0';
      document.body.appendChild(t); t.select();
      try { ok = document.execCommand('copy'); } catch (e2) {}
      t.remove();
    }
    btn.textContent = ok ? (btn.dataset.done || '已複製') : text;
    btn.classList.toggle('is-done', ok);
    setTimeout(() => { btn.textContent = label; btn.classList.remove('is-done'); }, 2000);
  });
});
</script>
</body>
</html>
