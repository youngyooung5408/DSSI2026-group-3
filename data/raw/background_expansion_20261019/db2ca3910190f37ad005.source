</div></div></div></div> <div class="group default info" data-index="2" data-type="3" data-child="2"><div class="in"><div class="ct"><div class="in"> <div class="simple-text heading" data-index="1" data-type="0" data-child="1"><div class="in"><div class="ct"><div class="in"><h2><span>鎮長簡介</span></h2></div></div></div></div> <div class="group default msg-tool" data-index="2" data-type="3" data-child="1"><div class="in"><div class="ct"><div class="in"> <div class="simple-text accesskey" data-func="{&#39;focusContent&#39;:{}}" data-type="0" data-child="1"><div class="in"><div class="ct"><div class="in"><span><a href="#CCMS_Content" title="跳過此子選單列請按[Enter]，繼續則按[Tab]">_</a></span></div></div></div></div> <div class="list-text user-tool" data-index="1" data-type="0" data-child="1"><div class="in"><div class="hd"><div class="in"><div   data-index="0"  >		<span  ><a   href="javascript :return false;"   title="網頁功能"   target="_self"  >網頁功能</a></span></div></div></div><div class="ct"><div class="in"><ul data-index="1" data-child="1"><li   data-index="1"  class="print"  >		<span  ><a   href="javascript:CCMS_Print(457);"   title="列印內容"   target="_self"  >列印內容</a></span></li></ul>
</div></div></div></div></div></div></div></div></div></div></div></div></div></div></div></div> <div class="group page-content " id="CCMS_Content" data-func="{&#39;linkType&#39;:{&#39;domains&#39;:[&#39;https://webws.miaoli.gov.tw&#39;,&#39;https://webws.miaoli.gov.tw&#39;]}}" data-index="2" data-type="3" data-child="3"><div class="in"><div class="ct"><div class="in">
        
        
     <link href="css/cp.css" rel="stylesheet" type="text/css" />



    <script>
        $(function () {
            var cp_count = 0;

            // 找到所有帶有 tab-cp 的 li，然後對其內部的 a 進行操作
            $('[tab-cp]').each(function (index) {
                var $li = $(this);
                var $anchor = $li.find('a'); // 鎖定內部的 a 標籤
                var targetValue = $li.attr('tab-cp');
                var targetId = 'panel-' + targetValue;

                // 將無障礙標籤加在 a 上，而非 li
                $anchor.attr({
                    'role': 'tab',
                    'aria-selected': 'false',
                    'aria-controls': targetId,
                    'tabindex': '0'
                });

                // 處理對應的面板
                var $panel = $('[tab-cp-target="' + targetValue + '"]');
                $panel.attr({
                    'id': targetId,
                    'role': 'tabpanel',
                    'aria-labelledby': $anchor.attr('id') || ''
                });

                // 點擊事件綁定在 a 上
                $anchor.click(function (event) {
                    event.preventDefault();

                    // 移除所有 a 的狀態，並移除所有 li 的 active class
                    $('[tab-cp] a').attr('aria-selected', 'false');
                    $('[tab-cp]').removeClass('is-active');

                    // 啟動目前的 a 與 li
                    $anchor.attr('aria-selected', 'true');
                    $li.addClass('is-active');

                    // 顯示面板
                    $('[tab-cp-target]').hide();
                    $panel.show();

                    // 只有在非初次載入點擊時才自動 focus 面板內元素
                    if (cp_count > 0) {
                        $panel.find('a[href], button, input').eq(0).focus();
                    }
                    cp_count++;
                });
            });

            // 初始化：觸發第一個 a 的點擊（而非 li）
            $('[tab-cp]').eq(0).find('a').click();

            // 處理 URL 參數 s
            var sParam = getParameterByName('s');
            if (sParam && sParam !== '') {
                $('[tab-cp="' + sParam + '"] a').click();
            }

            $('[tab-show="false"]').hide();
        });
    </script>
 <div class="list-text classify" data-type="0" data-child="1"><div class="in"><div class="ct"><div class="in"><ul data-index="1" data-child="1"><li  tab-cp='907' tab-show='false'  data-index="1"  >		<span  ><a   href="#"   title="鎮長簡介"   >鎮長簡介</a></span></li></ul>
</div></div></div></div> <div tab-cp-target="907" data-type="0" data-child="3"><div class="in"><div class="ct"><div class="in"> <div class="list-text detail" data-type="0"><div class="in"><div class="ct"><div class="in"></div></div></div></div> <div class="area-editor user-edit" data-type="0" data-child="1"><div class="in"><div class="ct"><div class="in"><div class="cp_block"><a href="https://webws.miaoli.gov.tw/001/Upload/457/attachment/9286/907/201901220021315119911310.jpg" target="_blank" title="卓蘭鎮長詹錦章"><img alt="卓蘭鎮公所鎮長照片" src="https://webws.miaoli.gov.tw/001/Upload/457/attachment/9286/907/201901220021315119911310.jpg" /></a>
<div class="main">姓名:詹錦章<br />
學歷:高工補校畢業<br />
經歷:卓蘭鎮農會理事長<br />
卓蘭鎮農會常務監事<br />
新榮里第19、20屆里長<br />
〜個人感言〜<br />
以最感恩努力的心為卓蘭打拼，<br />
以最誠摯勤奮的心負起鎮民的信任，<br />
為卓蘭這座美麗的大果園開墾、播種、耕耘<br />
共享幸福卓蘭，共榮幸福卓蘭。<br />
&nbsp;</div>
</div>
