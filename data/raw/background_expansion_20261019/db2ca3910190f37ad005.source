<script>
  document.addEventListener('DOMContentLoaded', function () {
    // 檢查目前網址是否為指定頁面
    const targetUrl = 'https://www.juolan.gov.tw/Message.aspx?n=3161&sms=11294';
    if (window.location.href === targetUrl) {
      const form = document.querySelector('form'); // 根據實際表單選擇器調整
      const fileInput = document.querySelector('input[type="file"]');

      if (form && fileInput) {
        form.addEventListener('submit', function (e) {
          const file = fileInput.files[0];
          if (!file || file.size < 1024) {
            alert('請上傳大於 1KB 的檔案');
            e.preventDefault();
            fileInput.focus(); 
          }
        });
      }
    }
  });
</script></div></div></div></div></div></div></div></div></div></div></div></div></div></div></div></div></div></div></div></div>
