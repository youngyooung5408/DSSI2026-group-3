	transition: opacity .25s ease, visibility .25s ease, transform .25s ease, background .2s ease;
	text-decoration: none !important;
	font-size: 20px;
	line-height: 1;
}
.back-to-top.is-visible {
	opacity: 1;
	visibility: visible;
	transform: translateY(0);
}
.back-to-top:hover,
.back-to-top:focus {
	background: #e01f45;
	color: #fff !important;
}
