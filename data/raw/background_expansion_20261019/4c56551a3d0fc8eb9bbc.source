<link rel="alternate" hreflang="ja" href="https://chiayi-mayor.duckdns.org/ja.html" />
<link rel="alternate" hreflang="ko" href="https://chiayi-mayor.duckdns.org/ko.html" />
<link rel="alternate" hreflang="fr" href="https://chiayi-mayor.duckdns.org/fr.html" />
<link rel="alternate" hreflang="x-default" href="https://chiayi-mayor.duckdns.org/" />
<link rel="preload" href="assets/fonts/NotoSerifTC-700-subset.woff2" as="font" type="font/woff2" crossorigin />
<style>
  /* 自架襯線字型（Noto Serif 子集化，OFL 授權）— 只含本頁用到的字 */
  @font-face {
    font-family: "Chiayi Serif";
    src: url("assets/fonts/NotoSerifTC-700-subset.woff2") format("woff2");
    font-weight: 700; font-style: normal; font-display: swap;
  }
  :root {
    /* ---- T2 骨架：深色科技（導覽 / Hero / 深色容器 / 最終 CTA / 頁尾）---- */
    --d-bg: #08131C;
    --d-surface: #10222F;
    --d-deep: #0A1A24;
    --d-line: #1D3A4B;
    --d-ink: #E6F2F7;
    --d-ink2: #A8C0CD;
    --teal: #2FDBA6;
    --yt-red: #E01B39;        /* YouTube 品牌紅（白字 4.79:1）*/
    --teal-ink: #04231A;
    --blue: #4FA8FF;

    /* ---- T1 內文：諸羅木都暖紙 ---- */
    --paper: #F3ECE0;
    --paper2: #FFFCF6;
    --sand: #EDE3D2;
    --line: #DCCDB6;
    --ink: #33261C;
    --ink2: #6B5748;
    --ink3: #75624B;

    /* 語意色（沿用既有變數名 → 全站自動換色）*/
    --red: #8C3A22;
    --red-dark: #6E2B18;
    --brand: #8C3A22;
    --gold: #E0B45C;
    --gold-ink: #7A5518;

    /* 字體 */
    --head: "Chiayi Serif","Noto Serif TC","Songti TC","STSong","Source Han Serif TC",serif;
    --mono: "SF Mono","Menlo","Consolas","Noto Sans Mono",monospace;

    /* 圓角級距：工藝感的安靜尺度 */
    --r-xs: 3px; --r-sm: 6px; --r-md: 8px; --r-lg: 10px; --r-xl: 12px; --r-pill: 999px;

    /* 陰影：淺底極收斂、深底黑系 */
    --sh-1: 0 1px 2px rgba(51,38,28,.06);
    --sh-2: 0 8px 20px rgba(51,38,28,.10);
    --sh-3: 0 16px 34px rgba(51,38,28,.14);
    --sh-d1: 0 8px 20px rgba(0,0,0,.35);
    --sh-d2: 0 16px 36px rgba(0,0,0,.45);
    --sh-d3: 0 26px 60px rgba(0,0,0,.58);
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    font-family: "PingFang TC","Noto Sans TC","Microsoft JhengHei",system-ui,sans-serif;
    background: var(--paper);
    color: var(--ink);
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
  }
  /* 螢幕閱讀器專用（視覺隱藏） */
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap; border: 0; }
  .wrap { max-width: 1080px; margin: 0 auto; padding: 0 22px; }

  /* ---- Nav ---- */
  header {
    position: sticky; top: 0; z-index: 50;
    background: rgba(44,33,31,.96); backdrop-filter: blur(6px);
    color: #f6f0e4;
  }
  nav { display: flex; align-items: center; justify-content: space-between; height: 58px; }
  .brand { font-weight: 800; letter-spacing: .5px; font-size: 22px; color: var(--gold); white-space: nowrap; }
  .brand span { color: #fff; }
  .brand:hover, .brand:focus-visible { opacity: .82; }
  nav .links { display: flex; gap: 22px; font-size: 14.5px; flex-wrap: wrap; justify-content: flex-end; }
  nav a { color: #e8ddc9; text-decoration: none; transition: color .2s; white-space: nowrap; }
  nav a:hover { color: var(--gold); }
  /* ---- 語言下拉選單 ---- */
  .lang-dropdown { position: relative; }
  .lang-dropdown > summary {
    list-style: none; cursor: pointer; border: 1px solid rgba(245,179,1,.55);
    padding: 3px 11px; border-radius: var(--r-pill); font-weight: 700; color: #e8ddc9;
    white-space: nowrap; transition: color .2s, border-color .2s;
  }
  .lang-dropdown:not([open]) .lang-list { display: none; }
  .lang-dropdown > summary::-webkit-details-marker { display: none; }
  .lang-dropdown > summary::marker { content: ""; }
  .lang-dropdown > summary:hover, .lang-dropdown[open] > summary { color: var(--gold); border-color: var(--gold); }
  .lang-list {
    position: absolute; right: 0; top: calc(100% + 8px); z-index: 60; min-width: 150px;
    background: #241b19; border: 1px solid rgba(245,179,1,.35); border-radius: var(--r-md);
    overflow: hidden; box-shadow: var(--sh-d2);
  }
  .lang-list a { display: block; padding: 10px 16px; color: #e8ddc9; text-decoration: none; font-size: 14px; white-space: nowrap; }
  .lang-list a:hover { background: rgba(245,179,1,.14); color: var(--gold); }
  .lang-list a.active { color: var(--gold); font-weight: 800; background: rgba(245,179,1,.08); }

  /* ---- Hero ---- */
  .hero { position: relative; background: #2b211f; text-align: center; }
  .hero img { width: 100%; max-width: 1320px; height: auto; display: block; margin: 0 auto; }
  .manifesto { margin: 0 auto; max-width: 1320px; }
  .manifesto img {
    width: 100%; height: auto; display: block; border-radius: var(--r-md);
    box-shadow: var(--sh-2);
  }

  /* ---- 參選登記區 ---- */
  .register {
    background: linear-gradient(150deg,#3a2b24,#5a4033);
    border-radius: var(--r-xl); padding: 40px; color: #f6f0e4; position: relative; overflow: hidden;
    box-shadow: var(--sh-3);
  }
  .register::before {
    content: ""; position: absolute; inset: 0;
    background: radial-gradient(circle at 90% 6%, rgba(245,179,1,.14), transparent 46%);
  }
  .register .r-banner { position: relative; text-align: center; margin-bottom: 30px; }
  .register .r-badge {
    display: inline-block; background: var(--red); color: #fff; font-weight: 800; letter-spacing: 2px;
    font-size: 13px; padding: 7px 22px; border-radius: var(--r-pill); margin-bottom: 16px;
    box-shadow: 0 6px 18px rgba(200,16,46,.4);
  }
  .register .r-title { font-size: clamp(26px,4vw,38px); font-weight: 800; letter-spacing: 2px; line-height: 1.4; }
  .register .r-title em { font-style: normal; color: var(--gold); }
  .register .r-sub { color: #d9c8b0; margin-top: 12px; font-size: 15.5px; }
  .register .r-motto { margin-top: 18px; font-weight: 700; color: #fff; font-size: 16px; letter-spacing: 1px; }
  .register .r-motto span { color: var(--gold); }
  .register .r-motto .blk { display: block; margin-top: 6px; }
  .register .r-inspire { position: relative; max-width: 900px; margin: 0 auto 28px; border-radius: var(--r-lg); overflow: hidden; box-shadow: var(--sh-d1); }
  .register .r-inspire img { width: 100%; height: auto; display: block; }
  .register .grid-r { position: relative; display: grid; grid-template-columns: repeat(3,1fr); gap: 18px; }
  .register .photo {
    position: relative; border-radius: var(--r-md); overflow: hidden; background: #000; cursor: zoom-in;
    box-shadow: var(--sh-d1); transition: transform .25s, box-shadow .25s;
  }
  .register .photo:hover { transform: translateY(-4px); box-shadow: var(--sh-d2); }
  .register .photo img { width: 100%; height: auto; display: block; }
  .register .photo .cap {
    position: absolute; left: 0; right: 0; bottom: 0; padding: 30px 16px 14px;
    background: linear-gradient(transparent, rgba(0,0,0,.88)); font-size: 14.5px; font-weight: 700;
    color: #fff; line-height: 1.5; text-shadow: 0 1px 3px rgba(0,0,0,.6);
  }

  /* ---- 參選登記故事 ---- */
  .r-stories { position: relative; margin-top: 32px; }
  .rs-title { display: flex; align-items: center; gap: 10px; font-size: 19px; font-weight: 800; color: var(--gold); margin-bottom: 18px; letter-spacing: 1px; }
  .rs-title::after { content: ""; flex: 1; height: 1px; background: rgba(245,179,1,.3); }
  .rs-card {
    background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.1);
    border-radius: var(--r-md); padding: 22px 24px; margin-bottom: 16px; position: relative; overflow: hidden;
  }
  .rs-card::before { content: "\201C"; position: absolute; top: -22px; left: 10px; font-size: 120px; color: rgba(245,179,1,.12); line-height: 1; font-weight: 800; }
  a.rs-link { display: block; text-decoration: none; color: inherit; cursor: pointer; transition: transform .25s, border-color .25s, box-shadow .25s; }
  a.rs-link:hover { transform: translateY(-4px); border-color: rgba(245,179,1,.5); box-shadow: var(--sh-d2); }
  a.rs-link .src { color: var(--gold); font-weight: 700; white-space: nowrap; }
  .rs-card .rs-quote { font-size: 15.5px; line-height: 1.85; color: #f0e6d6; position: relative; }
  .rs-card .rs-quote strong { color: var(--gold); }
  .rs-card .rs-quote em { font-style: normal; color: #fff; font-weight: 700; }
  .rs-card .rs-meta { margin-top: 14px; font-size: 12.5px; color: #c9bba3; display: flex; align-items: center; flex-wrap: wrap; gap: 6px 8px; }
  .rs-card .rs-meta .tag { flex-shrink: 0; white-space: nowrap; background: var(--red); color: #fff; font-weight: 800; font-size: 12px; padding: 3px 10px; border-radius: var(--r-pill); letter-spacing: 1px; }
  .rs-news { position: relative; }
  .rs-news .rs-nq { font-size: 14.5px; line-height: 1.85; color: #e8ddc9; }
  .rs-news .rs-nq strong { color: #fff; }

  /* ---- 諸羅之歌區 ---- */
  .song-section {
    background: linear-gradient(160deg,#4a3326,#2f211a);
    border-radius: var(--r-xl); padding: 40px; color: #f6f0e4; position: relative; overflow: hidden;
    box-shadow: var(--sh-3);
  }
  .song-section::before {
    content: ""; position: absolute; inset: 0;
    background: radial-gradient(circle at 88% 8%, rgba(245,179,1,.13), transparent 46%);
  }
  .song-video { position: relative; max-width: 900px; margin: 0 auto; border-radius: var(--r-md); overflow: hidden; box-shadow: var(--sh-d2); background: #000; }
  .song-video video { display: block; width: 100%; height: auto; }
  .song-video .song-badge {
    position: absolute; top: 14px; left: 14px; background: rgba(200,16,46,.92); color: #fff;
    font-size: 12px; font-weight: 800; letter-spacing: 1px; padding: 6px 14px; border-radius: var(--r-pill); z-index: 2;
  }
  .song-credit { position: relative; margin-top: 18px; text-align: center; font-size: 13.5px; color: #d9c8b0; }
  .song-credit strong { color: var(--gold); }
  .song-desc { position: relative; text-align: center; max-width: 780px; margin: 14px auto 0; font-size: 15px; line-height: 1.85; color: #e8ddc9; }
  .song-desc strong { color: #fff; }

  /* ---- 燈箱 ---- */
  .lightbox {
    position: fixed; inset: 0; z-index: 999; background: rgba(0,0,0,.9);
    display: none; align-items: center; justify-content: center; flex-direction: column;
    padding: 24px; text-align: center;
  }
  .lightbox.show { display: flex; }
  .lightbox img { max-width: 92vw; max-height: 82vh; border-radius: var(--r-sm); box-shadow: var(--sh-d3); }
  .lightbox .lb-cap { position: relative; color: #ddd; margin-top: 16px; font-size: 15px; max-width: 800px; line-height: 1.6; }
  .lightbox .lb-close {
    position: absolute; top: 22px; right: 24px; background: rgba(255,255,255,.12); color: #fff;
    border: 1px solid rgba(255,255,255,.3); width: 44px; height: 44px; border-radius: 50%;
    font-size: 20px; cursor: pointer; transition: background .2s;
  }
  .lightbox .lb-close:hover { background: rgba(200,16,46,.9); }
  /* 燈箱觸發元素：滑鼠可點、鍵盤也可（Enter / Space）*/
  .lb-trigger { cursor: zoom-in; }
  .lb-trigger:focus-visible { outline: 2px solid var(--brand); outline-offset: 3px; border-radius: var(--r-sm); }
  .register .lb-trigger:focus-visible { outline-color: var(--gold); }   /* 深底改用金色 */

  /* ---- Section header ---- */
  .sec { padding: 64px 0 40px; }
  .sec-head { text-align: center; margin-bottom: 40px; }
  .sec-head .kicker {
    display: inline-block; color: var(--red); font-weight: 700; letter-spacing: 2px;
    font-size: 13px; text-transform: uppercase; margin-bottom: 8px;
  }
  .sec-head h2 { font-size: clamp(26px, 4vw, 36px); font-weight: 800; letter-spacing: 1px; }
  .sec-head .sub { color: #7f6f5d; margin-top: 8px; font-size: 15px; }

  .divider { height: 2px; max-width: 90px; margin: 18px auto 0; background: var(--gold); border-radius: var(--r-pill); }

  /* ---- Intro ---- */
  .intro {
    background: linear-gradient(135deg,#2b211f,#4a312c);
    color: #f6f0e4; padding: 40px 44px; border-radius: var(--r-lg);
    box-shadow: var(--sh-2); position: relative; overflow: hidden;
  }
  .intro::before {
    content: ""; position: absolute; inset: 0;
    background: radial-gradient(circle at 90% 10%, rgba(245,179,1,.18), transparent 50%);
  }
  .intro p { position: relative; font-size: 17px; line-height: 1.9; }
  .intro strong { color: var(--gold); }

  /* ---- Grid of policies ---- */
  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .card {
    background: var(--sand); border: 1px solid var(--line); border-radius: var(--r-md);
    padding: 26px 24px 20px; position: relative; transition: transform .25s, box-shadow .25s, border-color .25s;
    overflow: hidden;
  }
  .card::after {
    content: attr(data-num); position: absolute; top: -22px; right: 6px;
    font-size: 88px; font-weight: 800; color: rgba(200,16,46,.08); line-height: 1;
    pointer-events: none;
  }
  .card:hover { transform: translateY(-6px); box-shadow: var(--sh-1); border-color: var(--gold); }
  .card .tag {
    display: inline-block; background: var(--red); color: #fff; font-weight: 800;
    font-size: 16px; letter-spacing: 1px; padding: 5px 14px; border-radius: var(--r-pill); margin-bottom: 12px;
  }
  .card h3 { font-size: 21px; font-weight: 800; margin-bottom: 8px; }
  .card p { color: #6a5a4a; font-size: 15px; }

  /* ---- CTA / Contact ---- */
  .contact {
    background: var(--red); color: #fff; text-align: center; padding: 52px 24px; border-radius: var(--r-lg);
    margin-top: 20px; box-shadow: 0 20px 44px rgba(200,16,46,.25);
  }
  .contact h2 { font-size: clamp(24px,3.4vw,30px); font-weight: 800; margin-bottom: 10px; }
  .contact p { opacity: .95; font-size: 16px; }
  .contact .row { display: flex; flex-wrap: wrap; gap: 14px; justify-content: center; margin-top: 26px; }
  .pill {
    display: inline-flex; align-items: center; gap: 8px; background: #fff; color: var(--red-dark);
    padding: 12px 22px; border-radius: var(--r-pill); font-weight: 700; font-size: 15px;
    text-decoration: none; transition: transform .2s;
  }
  .pill:hover { transform: translateY(-3px); }
  .pill.yt { background: var(--ink); color: #fff; }
  .pill.fb { background: #1565d8; color: #fff; }

  /* ---- 總部位置地圖卡片 ---- */
  .hq-card {
    background: #fff; border-radius: var(--r-xl); overflow: hidden; margin-top: 14px;
    box-shadow: var(--sh-d1); text-align: left; display: flex; flex-wrap: wrap;
  }
  .hq-info { flex: 1 1 320px; padding: 30px 30px; }
  .hq-info .hq-kicker { color: var(--red); font-weight: 800; letter-spacing: 2px; font-size: 12px; text-transform: uppercase; margin-bottom: 10px; }
  .hq-info h3 { font-size: 24px; font-weight: 800; color: var(--ink); margin-bottom: 8px; }
  .hq-info p { color: #6a5a4a; font-size: 15px; line-height: 1.75; }
  .hq-info .addr {
    display: inline-flex; align-items: center; gap: 8px; margin-top: 18px;
    background: var(--sand); border: 1px solid var(--line); color: var(--ink);
    padding: 12px 20px; border-radius: var(--r-pill); font-weight: 700; font-size: 15px;
    text-decoration: none; transition: transform .2s, border-color .2s;
  }
  .hq-info .addr:hover { transform: translateY(-3px); border-color: var(--gold); }
  .hq-map { flex: 1.4 1 360px; min-height: 320px; background: #eee; }
  .hq-map iframe { width: 100%; height: 100%; min-height: 320px; border: 0; display: block; }

  /* ---- 加入我們 / 政治獻金 ---- */
  .support-section {
    display: flex; flex-wrap: wrap; gap: 34px; margin-top: 22px;
    background: linear-gradient(160deg,#fdf3e3,#f9ead0); border: 1px solid #ecd9b4;
    border-radius: var(--r-xl); padding: 36px; align-items: center; position: relative; overflow: hidden;
  }
  .support-text { flex: 1 1 360px; color: var(--ink); }
  .support-text .sp-badge {
    display: inline-block; background: var(--red); color: #fff; font-weight: 800; letter-spacing: 1px;
    font-size: 12px; padding: 5px 14px; border-radius: var(--r-pill); margin-bottom: 14px;
  }
  .support-text h3 { font-size: clamp(20px,2.6vw,26px); font-weight: 800; color: var(--ink); margin-bottom: 10px; line-height: 1.5; }
  .support-text .sp-lead { font-size: 15px; line-height: 1.85; color: #6a5a4a; }
  .support-text .sp-lead strong { color: var(--red-dark); }
  .support-text .sp-goals { margin: 16px 0; }
  .support-text .sp-goals .goal {
    display: flex; gap: 10px; align-items: flex-start; margin-bottom: 10px; font-size: 14.5px; line-height: 1.7; color: #6a5a4a;
  }
  .support-text .sp-goals .goal .num {
    flex-shrink: 0; width: 26px; height: 26px; border-radius: 50%; background: var(--red); color: #fff;
    font-size: 13px; font-weight: 800; display: flex; align-items: center; justify-content: center; margin-top: 2px;
  }
  .support-text .sp-cta { font-size: 15px; line-height: 1.8; color: var(--ink); font-weight: 600; }
  .support-text .sp-cta em { font-style: normal; color: var(--red); font-weight: 800; }
  .support-card { flex: 0 1 300px; text-align: center; }
  .support-card img {
    width: 100%; max-width: 300px; border-radius: var(--r-md); box-shadow: var(--sh-2);
    display: block; margin: 0 auto; cursor: zoom-in;
  }
  .support-card .sc-hint { margin-top: 12px; font-size: 13px; color: var(--red-dark); font-weight: 700; }
  .bank-info { margin-top: 22px; border-top: 1px dashed #e3cfa4; padding-top: 20px; flex-basis: 100%; }
  .bank-info h4 { font-size: 15px; font-weight: 800; color: var(--ink); margin-bottom: 10px; display: flex; align-items: center; gap: 8px; }
  .bank-info h4 .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--red); }
  .bank-rows { display: grid; grid-template-columns: minmax(90px,auto) 1fr; gap: 8px 16px; font-size: 15px; }
  .bank-rows .label { color: var(--red-dark); font-weight: 800; white-space: nowrap; }
  .bank-rows .value { color: var(--ink); font-weight: 600; word-break: break-all; }
  .bank-rows .value .acct { font-family: "Menlo","SF Mono",monospace; letter-spacing: .5px; white-space: nowrap; }
  @media (max-width: 720px) {
    .bank-rows { grid-template-columns: 1fr; gap: 3px 0; }
    .bank-rows .value { margin-bottom: 9px; }
  }

  /* ---- YouTube 專屬區 ---- */
  .yt-section {
    background: linear-gradient(160deg,#2b211f,#41332c);
    border-radius: var(--r-xl); padding: 44px 40px 40px; color: #f6f0e4;
    box-shadow: var(--sh-2); position: relative; overflow: hidden;
  }
  .yt-section::before {
    content: ""; position: absolute; inset: 0;
    background: radial-gradient(circle at 92% 8%, rgba(255,0,0,.16), transparent 44%);
  }
  .yt-section .yt-head { position: relative; display: flex; flex-wrap: wrap; align-items: center; gap: 22px; margin-bottom: 30px; }
  .yt-section .yt-chanlogo {
    width: 66px; height: 66px; border-radius: var(--r-lg); flex-shrink: 0;
    background: linear-gradient(145deg,#c8102e,#8f0b20); display: flex; align-items: center; justify-content: center;
    font-size: 34px; box-shadow: 0 8px 22px rgba(200,16,46,.4);
  }
  .yt-section .yt-meta { flex: 1; min-width: 200px; }
  .yt-section .yt-meta h3 { font-size: 22px; font-weight: 800; letter-spacing: 1px; margin-bottom: 4px; }
  .yt-section .yt-meta .yt-sub { color: #cbb89e; font-size: 14px; }
  .yt-section .yt-subscribe {
    background: #c8102e; color: #fff; text-decoration: none; font-weight: 700;
    padding: 11px 24px; border-radius: var(--r-pill); font-size: 15px; white-space: nowrap;
    box-shadow: 0 6px 18px rgba(200,16,46,.4); transition: transform .2s, background .2s;
  }
  .yt-section .yt-subscribe:hover { transform: translateY(-3px); background: #e01b39; }
  .yt-grid { position: relative; display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .yt-card {
    background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.08);
    border-radius: var(--r-md); overflow: hidden; transition: transform .25s, box-shadow .25s, border-color .25s;
    text-decoration: none; color: inherit; display: block;
  }
  .yt-card:hover { transform: translateY(-5px); box-shadow: var(--sh-d2); border-color: rgba(255,255,255,.22); }
  .yt-card .thumb { position: relative; width: 100%; padding-top: 56.25%; background: #1a1211; }
  .yt-card .thumb img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .yt-card .play {
    position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
    background: rgba(0,0,0,.18); opacity: .9; transition: opacity .2s;
  }
  .yt-card:hover .play { opacity: 1; }
  .yt-card .play span {
    width: 54px; height: 54px; border-radius: 50%; background: rgba(200,16,46,.92);
    color: #fff; font-size: 22px; display: flex; align-items: center; justify-content: center;
    box-shadow: 0 8px 22px rgba(0,0,0,.4); padding-left: 5px;
  }
  .yt-card .ep {
    position: absolute; top: 10px; left: 10px; background: rgba(200,16,46,.92); color: #fff;
    font-size: 12px; font-weight: 800; padding: 4px 10px; border-radius: var(--r-pill); letter-spacing: 1px;
  }
  .yt-card .body { padding: 12px 14px 14px; }
  .yt-card .body .t { font-size: 14.5px; font-weight: 700; line-height: 1.45; color: #f6f0e4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 42px; }
  .yt-card .body .m { margin-top: 8px; font-size: 12.5px; color: #c9bba3; }

  /* ---- Facebook 後援會區 ---- */
  .fb-section {
    background: linear-gradient(160deg,#1b2a52,#2563a8);
    border-radius: var(--r-xl); padding: 44px 40px 40px; color: #fff;
    box-shadow: var(--sh-2); position: relative; overflow: hidden;
  }
  .fb-section::before {
    content: ""; position: absolute; inset: 0;
    background: radial-gradient(circle at 92% 8%, rgba(255,255,255,.12), transparent 44%);
  }
  .fb-head { position: relative; display: flex; flex-wrap: wrap; align-items: center; gap: 22px; margin-bottom: 20px; }
  .fb-logo {
    width: 66px; height: 66px; border-radius: var(--r-lg); flex-shrink: 0;
    background: #1877f2; display: flex; align-items: center; justify-content: center;
    font-size: 38px; font-weight: 800; box-shadow: 0 8px 22px rgba(24,119,242,.4);
  }
  .fb-meta { flex: 1; min-width: 200px; }
  .fb-meta h3 { font-size: 22px; font-weight: 800; letter-spacing: .5px; margin-bottom: 4px; }
  .fb-meta .fb-sub { color: #d7e7fd; font-size: 14px; }
  .fb-join {
    background: #fff; color: #1b2a52; text-decoration: none; font-weight: 700;
    padding: 11px 24px; border-radius: var(--r-pill); font-size: 15px; white-space: nowrap;
    box-shadow: 0 6px 18px rgba(0,0,0,.2); transition: transform .2s, background .2s;
  }
  .fb-join:hover { transform: translateY(-3px); background: #edf4ff; }
  .fb-about { position: relative; color: #dbe9fb; font-size: 15px; line-height: 1.85; }
  .fb-about strong { color: #fff; }

  /* ---- 電子看板廣告區 ---- */
  .ad-section {
    background: linear-gradient(160deg,#1a1a1a,#2b2b2b);
    border-radius: var(--r-xl); padding: 40px; color: #fff;
    box-shadow: var(--sh-d1); position: relative; overflow: hidden;
  }
  .ad-section::before {
    content: ""; position: absolute; inset: 0;
    background: radial-gradient(circle at 92% 8%, rgba(255,0,0,.1), transparent 44%);
  }
  .ad-section h3 { position: relative; font-size: 18px; font-weight: 800; margin-bottom: 4px; color: #fff; }
  .ad-section .ad-sub { position: relative; color: #b3b3b3; font-size: 13.5px; margin-bottom: 22px; }
  .ad-banner { position: relative; }
  .video-row { position: relative; }
  .video-item { position: relative; border-radius: var(--r-md); overflow: hidden; background: #000; box-shadow: var(--sh-d2); margin-bottom: 22px; }
  .video-item video { display: block; width: 100%; height: auto; }
  .video-item .vlabel {
    position: absolute; top: 12px; left: 12px; background: rgba(200,16,46,.92); color: #fff;
    font-size: 12px; font-weight: 800; padding: 5px 12px; border-radius: var(--r-pill); letter-spacing: 1px;
    z-index: 2;
  }
  .video-item .vtime {
    position: absolute; bottom: 12px; right: 12px; background: rgba(0,0,0,.62); color: #fff;
    font-size: 12px; font-weight: 700; padding: 3px 9px; border-radius: var(--r-xs); z-index: 2;
  }
  .video-item .vdate {
    position: absolute; top: 12px; right: 12px; background: rgba(47,219,166,.92); color: #04231A;
    font-size: 12px; font-weight: 800; padding: 3px 10px; border-radius: var(--r-pill); letter-spacing: .5px; z-index: 2;
  }
  .video-item .unsound {
    position: absolute; bottom: 12px; left: 12px; background: rgba(0,0,0,.62); color: #ff0;
    font-size: 11.5px; font-weight: 700; padding: 3px 9px; border-radius: var(--r-xs); z-index: 2;
  }
  .video-item .mutebtn {
    position: absolute; bottom: 12px; left: 12px; width: 40px; height: 40px; border-radius: 50%;
    background: rgba(0,0,0,.6); color: #fff; border: 1px solid rgba(255,255,255,.25);
    font-size: 16px; z-index: 3; cursor: pointer; display: flex; align-items: center; justify-content: center;
    transition: background .2s;
  }
  .video-item .mutebtn:hover { background: rgba(200,16,46,.9); }
  .video-item .mutebtn.playing::before { content: "▶"; }
  .video-item .mutebtn.paused::before { content: "❚❚"; }
  .video-item video::-webkit-media-controls { display: none!important; }

  footer { text-align: center; padding: 34px 0 42px; color: #7f6f5d; font-size: 13.5px; }
  footer .brandline { color: #6a5a4a; font-weight: 700; margin-bottom: 6px; }

  @media (max-width: 720px) {
    nav { height: auto; min-height: 56px; flex-wrap: wrap; padding: 8px 0; row-gap: 4px; }
    .brand { font-size: 17px; }
    nav .links { gap: 12px 14px; font-size: 13px; }
    .grid { grid-template-columns: 1fr; }
    .intro { padding: 30px 26px; }
    .yt-section { padding: 30px 22px; }
    .ad-section { padding: 26px 18px; }
    .hq-info { padding: 24px 22px; }
    .hq-map { min-height: 260px; }
    .register { padding: 28px 20px; }
    .song-section { padding: 26px 18px; }
    .support-section { padding: 26px 20px; gap: 24px; }
    .support-card { flex-basis: 100%; }
  }
  /* 兩支 10s 並排 */
  .video-row { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
  @media (max-width: 1000px) {
    .yt-grid { grid-template-columns: repeat(2, 1fr); }
    .video-row { grid-template-columns: 1fr; }
  }
  /* 手機覆蓋：需在 1000px 之後，後宣告者勝 */
  @media (max-width: 720px) {
    .yt-grid { grid-template-columns: 1fr; }
    .register .grid-r { grid-template-columns: 1fr; }
  }
  .song-name, .nowrap { white-space: nowrap; }
  /* ---- 參選登記故事：全文可收合（桌機與手機一致；手機版行數沿用下方 media query 的 6 行）---- */
  .rs-more {
    display: block; width: 100%; margin: -4px 0 18px;
    padding: 11px 16px; border: 1px solid rgba(224,180,92,.45); border-radius: var(--r-pill);
    background: rgba(224,180,92,.08); color: var(--gold);
    font-family: inherit; font-size: 13.5px; font-weight: 800; letter-spacing: 1px;
    cursor: pointer; transition: background .2s, border-color .2s;
  }
  .rs-more:hover, .rs-more:active { background: rgba(224,180,92,.18); border-color: rgba(224,180,92,.7); }
  .rs-card .rs-nq, .rs-card .rs-quote {
    display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden;
  }
  .rs-card.open .rs-nq, .rs-card.open .rs-quote {
    display: block; -webkit-line-clamp: unset; overflow: visible;
  }
  /* 手機版預覽行數較多（寬度換行少）——沿用原本 6 行 */
  @media (max-width: 720px) {
    .rs-card .rs-nq, .rs-card .rs-quote { -webkit-line-clamp: 6; }
  }

  /* ---- 政見詳細內容：浮出卡片（modal） ---- */
  .card.has-detail { cursor: pointer; }
  .card.has-detail:focus-visible { outline: 3px solid var(--gold-ink); outline-offset: 3px; }
  .card .more {
    display: inline-block; margin-top: 14px; padding-bottom: 2px;
    font-size: 13px; font-weight: 800; letter-spacing: .6px; color: var(--red);
    border-bottom: 1px dashed rgba(200,16,46,.55); white-space: nowrap;
    transition: color .2s, border-color .2s;
  }
  .card.has-detail:hover .more { color: var(--red-dark); border-bottom-style: solid; border-color: var(--gold); }

  .pm-overlay {
    position: fixed; inset: 0; z-index: 1000; display: none;
    align-items: center; justify-content: center; padding: 24px;
    background: rgba(26,17,15,.74);
  }
  .pm-overlay.show { display: flex; }
  body.pm-open { overflow: hidden; }
  .pm-card {
    position: relative; display: flex; flex-direction: column;
    width: min(880px,100%); max-height: 86vh; overflow: hidden;
    background: var(--paper); border: 1px solid rgba(245,179,1,.65); border-radius: var(--r-xl);
    box-shadow: var(--sh-d3); animation: pmIn .26s ease-out;
  }
  @keyframes pmIn { from { opacity: 0; transform: translateY(20px) scale(.985); } to { opacity: 1; transform: none; } }
  .pm-close {
    position: absolute; top: 14px; right: 14px; z-index: 3;
    width: 40px; height: 40px; border-radius: 50%; cursor: pointer;
    background: var(--sand); border: 1px solid var(--line); color: var(--ink);
    font-family: inherit; font-size: 16px; line-height: 1; transition: background .2s, color .2s, border-color .2s;
  }
  .pm-close:hover { background: var(--red); border-color: var(--red); color: #fff; }
  .pm-head { padding: 26px 30px 18px; background: linear-gradient(160deg,#fdf3e3,#f7e6c8); border-bottom: 1px solid var(--line); }
  .pm-head .pm-tag {
    display: inline-block; background: var(--red); color: #fff; font-weight: 800;
    font-size: 15px; letter-spacing: 1px; padding: 4px 13px; border-radius: var(--r-pill); margin-bottom: 10px;
  }
  .pm-head .pm-kicker { color: var(--red); font-weight: 800; letter-spacing: 2px; font-size: 12px; text-transform: uppercase; margin-bottom: 6px; }
  .pm-head h3 { font-size: clamp(20px,2.6vw,25px); font-weight: 800; color: var(--ink); padding-right: 46px; }
  .pm-body { padding: 22px 30px 30px; overflow-y: auto; -webkit-overflow-scrolling: touch; }
  .pm-body h4 {
    font-size: 17.5px; font-weight: 800; color: var(--red-dark); line-height: 1.55;
    margin: 24px 0 10px; padding-left: 12px; border-left: 4px solid var(--gold);
  }
  .pm-body h4:first-child { margin-top: 2px; }
  .pm-body p { font-size: 15.5px; line-height: 1.95; color: #4a3f37; margin-bottom: 12px; }
  .pm-body p strong, .pm-body ul li strong { color: var(--ink); }
  .pm-body ul { list-style: none; margin: 0 0 14px; padding: 0; }
  .pm-body ul li { position: relative; padding-left: 20px; margin-bottom: 7px; font-size: 15.5px; line-height: 1.9; color: #4a3f37; }
  .pm-body ul li::before { content: "▸"; position: absolute; left: 2px; top: 0; color: var(--gold-ink); font-weight: 800; }
  .pm-key {
    background: linear-gradient(160deg,#fdf3e3,#f9ead0); border: 1px solid #ecd9b4;
    border-radius: var(--r-md); padding: 16px 18px 6px; margin: 16px 0 18px;
  }
  .pm-key .k-label {
    display: inline-block; background: linear-gradient(135deg,#1565c0,#0d47a1); color: #ffeeb5; font-size: 12px; font-weight: 800;
    letter-spacing: 1.5px; padding: 3px 11px; border-radius: var(--r-pill); margin-bottom: 9px; white-space: nowrap;
  }
  .pm-note { margin-top: 20px; padding-top: 14px; border-top: 1px dashed var(--line); color: #7f6f5d; font-size: 13px; line-height: 1.8; }
  .pm-body ol { list-style: none; counter-reset: pmnum; margin: 0 0 14px; padding: 0; }
  .pm-body ol li {
    position: relative; counter-increment: pmnum; padding-left: 30px; margin-bottom: 12px;
    font-size: 15.5px; line-height: 1.9; color: #4a3f37;
  }
  .pm-body ol li::before {
    content: counter(pmnum); position: absolute; left: 0; top: 5px;
    width: 21px; height: 21px; border-radius: 50%; background: var(--red); color: #fff;
    font-size: 12px; font-weight: 800; display: flex; align-items: center; justify-content: center;
  }
  .pm-quote {
    margin: 16px 0 18px; padding: 14px 20px;
    border-left: 4px solid var(--red); border-radius: 0 var(--r-md) var(--r-md) 0;
    background: rgba(200,16,46,.055);
  }
  .pm-quote p { margin: 0; font-size: 15.5px; line-height: 1.95; color: #4a3f37; }
  .pm-quote .q-by { display: block; margin-top: 8px; text-align: right; font-size: 13.5px; font-weight: 800; color: var(--red); white-space: nowrap; }
  @media (max-width: 720px) {
    .pm-overlay { padding: 10px; align-items: flex-end; }
    .pm-card { max-height: 92vh; border-radius: var(--r-lg); }
    .pm-head { padding: 22px 20px 14px; }
    .pm-head h3 { padding-right: 42px; }
    .pm-body { padding: 16px 20px 26px; }
    .pm-body p, .pm-body ul li, .pm-body ol li { font-size: 15px; line-height: 1.85; }
  }
  /* =======================================================================
     混血版：T2 骨架（深色科技）+ T1 內文（諸羅木都暖紙）
     覆蓋層置於最後，同性質選擇器一律以本層為準。
     深色骨架 = 導覽 / Hero / 深色容器 / 最終 CTA / 頁尾
     暖紙內文 = 政見卡片 / 內文區塊 / 總部 / 支持我們 / 政見浮出卡片
     ======================================================================= */

  /* 數字由 assets/stats.json 覆寫（抓不到就沿用頁面內的預設值）；不要因 <b> 變成粗體 */
  [data-stat] { font-weight: inherit; }
  /* <picture> 包一層時不要變成 inline（避免與 img 的 block 排版衝突）*/
  picture { display: block; }
  /* ---- 標題字體：襯線（T1）／標籤與代碼：等寬（T2）---- */
  .sec-head h2, .card h3, .panel h3, .contact h2, .hq-info h3, .support-text h3,
  .register .r-title, .yt-section .yt-meta h3, .fb-meta h3, .ad-section h3,
  .pm-head h3, .pm-body h4, .pm-key h4, .lightbox .lb-cap strong, .bio-col .b-head h3,
  .cl-card > summary h3, .cl-sign-name {
    font-family: var(--head); font-weight: 700; letter-spacing: .02em;
  }

  /* ======================= T2 骨架：導覽列 ======================= */
  header { background: rgba(8,19,28,.94); backdrop-filter: blur(10px); border-bottom: 1px solid var(--d-line); }
  nav { min-height: 60px; }
  .brand { font-family: var(--mono); font-size: 17px; font-weight: 700; letter-spacing: .06em; color: var(--teal); }
  .brand span { color: var(--d-ink); }
  /* 頁首品牌整體往左移 4 個字（1 字 = 1em 字寬 + .06em letter-spacing = 1.06em）；
     視窗不夠寬時位移自動遞減，確保左緣至少留 16px、不貼邊也不被裁切 */
  .brand { margin-left: calc(-1 * min(4.24em, max(0px, calc((100vw - 1080px) / 2 + 6px)))); }
  nav a { font-family: var(--mono); font-size: 12.5px; letter-spacing: .03em; color: var(--d-ink2); }
  nav a:hover { color: var(--teal); }
  .lang-dropdown > summary {
    font-family: var(--mono); font-size: 12px; border-radius: var(--r-xs);
    border-color: rgba(47,219,166,.55); color: var(--d-ink2);
  }
  .lang-dropdown > summary:hover, .lang-dropdown[open] > summary { color: var(--teal); border-color: var(--teal); }
  .lang-list { background: #0C1B26; border-color: var(--d-line); border-radius: var(--r-sm); box-shadow: var(--sh-d2); }
  .lang-list a { font-family: var(--mono); font-size: 12.5px; color: var(--d-ink2); }
  .lang-list a:hover { background: rgba(47,219,166,.12); color: var(--teal); }
  .lang-list a.active { background: rgba(47,219,166,.09); color: var(--teal); font-weight: 700; }

  /* ======================= T2 骨架：Hero ======================= */
  .hero { background: var(--d-bg); text-align: left; }
  .hero-frame { position: relative; max-width: 1320px; margin: 0 auto; border-left: 1px solid var(--d-line); border-right: 1px solid var(--d-line); }
  .hero img { display: block; width: 100%; height: auto; filter: saturate(.9) brightness(.95) contrast(1.05); }
  .hero-strip {
    display: flex; flex-wrap: wrap; gap: 14px 22px; align-items: center; justify-content: space-between;
    padding: 16px 22px; background: var(--d-bg); border-top: 1px solid var(--d-line);
  }
  .hero-tag { font-family: var(--mono); font-size: 11.5px; letter-spacing: .16em; color: var(--teal); text-transform: uppercase; }
  .hero-tag::before { content: "◆ "; color: var(--teal); }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 10px; }
  .btn {
    display: inline-flex; align-items: center; gap: 8px; font-family: var(--mono); font-size: 13px; font-weight: 700;
    letter-spacing: .04em; text-decoration: none; padding: 10px 20px; border-radius: var(--r-xs); transition: .2s;
  }
  .btn-teal { background: var(--teal); color: var(--teal-ink); }
  .btn-teal:hover { background: #26C795; transform: translateY(-2px); }
  .btn-ghost { border: 1px solid rgba(168,192,205,.5); color: var(--d-ink); }
  .btn-ghost:hover { border-color: var(--teal); color: var(--teal); transform: translateY(-2px); }

  /* ======================= T1 內文：淺色內容 ======================= */
  .sec-head .kicker { font-family: var(--mono); font-size: 12px; letter-spacing: .16em; color: var(--brand); }
  .sec-head .sub { color: var(--ink3); }
  .divider { background: var(--brand); height: 3px; }

  .card { background: var(--paper2); border: 1px solid var(--line); border-radius: var(--r-md); }
  .card:hover { transform: translateY(-3px); box-shadow: var(--sh-2); border-color: var(--brand); }
  .card::after { color: rgba(140,58,34,.07); font-family: var(--head); font-weight: 700; }
  .card p { color: var(--ink2); }
  .card .tag { background: var(--brand); color: #FFFCF6; font-family: var(--mono); font-size: 12px; letter-spacing: .08em; padding: 4px 12px; }
  .card .more { font-family: var(--mono); font-size: 12px; letter-spacing: .06em; color: var(--brand); border-bottom-color: var(--brand); }
  .card.has-detail:hover .more { color: var(--red-dark); border-bottom-color: var(--brand); }

  .hq-card { background: var(--paper2); }
  .hq-info .hq-kicker { font-family: var(--mono); color: var(--brand); letter-spacing: .16em; font-size: 11.5px; }
  .hq-info p { color: var(--ink2); }
  .hq-info .addr { border-radius: var(--r-xs); }
  .hq-info .addr:hover { border-color: var(--brand); }
  .hq-map { background: var(--sand); }

  .support-section { background: var(--paper2); border: 1px solid var(--line); border-radius: var(--r-md); }
  .support-text .sp-badge { background: var(--brand); color: #FFFCF6; font-family: var(--mono); letter-spacing: .1em; }
  .support-text .sp-lead { color: var(--ink2); }
  .bank-info { border-top-color: var(--line); }
  .bank-rows .label { font-family: var(--mono); color: var(--brand); }
  .support-card img { border-radius: var(--r-md); box-shadow: var(--sh-2); }

  .manifesto img { border-radius: var(--r-md); box-shadow: var(--sh-2); }

  /* ======================= 深色容器：統一為 T2 家族 ======================= */
  .register, .song-section, .yt-section, .fb-section, .ad-section {
    background: linear-gradient(160deg, var(--d-surface), var(--d-deep));
    box-shadow: var(--sh-d2);
  }
  .register::before, .song-section::before, .yt-section::before, .fb-section::before, .ad-section::before {
    background: radial-gradient(circle at 92% 6%, rgba(47,219,166,.13), transparent 46%);
  }
  /* T1 暖白文字留在藍黑底上（14.3:1 以上），深底用金色 */
  .register { color: #F6F0E4; }
  .song-section { color: #F6F0E4; }
  .yt-section { color: #F6F0E4; }
  .ad-section { color: var(--d-ink); }
  .fb-section { color: var(--d-ink); }
  .fb-about { color: #C9DBE8; }
  .fb-about strong { color: var(--d-ink); }
  .fb-meta .fb-sub { color: var(--d-ink2); }

  .register .r-badge { background: var(--brand); color: #FFFCF6; box-shadow: none; font-family: var(--mono); letter-spacing: .1em; }
  .register .r-title em, .register .r-motto span, .rs-title { color: var(--gold); }
  a.rs-link .src { color: var(--gold); font-family: var(--mono); font-size: 12.5px; }
  .rs-card .rs-quote strong { color: var(--gold); }
  .rs-card .rs-meta .tag { background: var(--brand); color: #FFFCF6; }
  .rs-more { border-color: rgba(224,180,92,.45); background: rgba(224,180,92,.08); }
  .rs-more:hover, .rs-more:active { background: rgba(224,180,92,.18); border-color: rgba(224,180,92,.7); }
  .song-credit strong { color: var(--gold); }

  /* YouTube 區 → 青綠（T2） */
  .yt-section .yt-chanlogo {
    background: var(--yt-red); border: 1px solid rgba(255,255,255,.2); color: #fff; box-shadow: none;
  }
  .yt-section .yt-subscribe { background: var(--yt-red); color: #fff; box-shadow: none; font-family: var(--mono); font-size: 13px; }
  .yt-section .yt-subscribe:hover { background: #C8102E; }
  .yt-section .yt-sub { color: #C9BBB0; }
  .yt-card { background: rgba(255,255,255,.04); border-color: rgba(168,192,205,.45); border-radius: var(--r-md); }
  .yt-card .body .t { font-family: var(--head); font-weight: 700; }

  /* Facebook 區 → 同一深色家族，僅保留品牌色標記 */
  .fb-join { background: #1565D8; color: #fff; font-weight: 700; box-shadow: none; font-family: var(--mono); font-size: 13px; }
  .fb-join:hover { background: #0F55BE; }
  .fb-logo { border-radius: var(--r-md); }

  /* 電子看板區：純黑 → 同家族 */
  .video-item .vlabel, .song-video .song-badge { background: rgba(140,58,34,.92); }
  .yt-card .ep, .yt-card .play span { background: rgba(224,27,57,.92); }
  .video-item .mutebtn:hover { background: rgba(140,58,34,.9); }

  /* ======================= 最終 CTA：回到 T2 深色骨架 ======================= */
  .contact {
    background: linear-gradient(160deg, var(--d-surface), var(--d-deep)); color: var(--d-ink);
    box-shadow: var(--sh-d2); border: 1px solid var(--d-line);
  }
  .contact p { opacity: 1; color: var(--d-ink2); }
  .pill { border-radius: var(--r-xs); font-family: var(--mono); font-size: 12.5px; letter-spacing: .04em; }
  .pill.yt { background: var(--yt-red); color: #fff; font-weight: 700; border: 1px solid transparent; }
  .pill.yt:hover { background: #C8102E; border-color: transparent; color: #fff; }
  .pill.fb { background: #1565D8; color: #fff; font-weight: 700; border: 1px solid transparent; }
  .pill:hover { transform: translateY(-2px); }
  .pill.fb:hover { background: #0F55BE; border-color: transparent; color: #fff; }
  /* 標題避免孤字（orphan）：近代瀏覽器支援，舊版自動忽略 */
  .sec-head h2, .card h3, .contact h2, .support-text h3, .register .r-title, .hq-info h3, .pm-head h3, .yt-section .yt-meta h3, .fb-meta h3 { text-wrap: balance; }
  .card p, .pm-body p { text-wrap: pretty; }

  /* ======================= 頁尾：T2 骨架 ======================= */
  footer {
    background: var(--d-bg); border-top: 1px solid var(--d-line); color: var(--d-ink2);
    font-family: var(--mono); font-size: 12.5px; letter-spacing: .04em; padding: 34px 22px 42px;
  }
  footer .brandline { font-family: var(--mono); color: var(--d-ink); font-weight: 700; }
  /* 頁尾技術團隊名稱連到諸羅科技站 */
  footer .brandline a { color: var(--teal); text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; padding: 6px 4px; }
  footer .brandline a:hover, footer .brandline a:focus-visible { color: #7CF0C8; }

  /* ======================= 政見浮出卡片：T1 內文 + T2 標籤 ======================= */
  .pm-card { background: var(--paper2); border-color: var(--line); }
  .pm-head { background: linear-gradient(160deg, #F7EFE2, #EFE3D0); border-bottom-color: var(--line); }
  .pm-head .pm-tag { background: var(--brand); color: #FFFCF6; font-family: var(--mono); font-size: 13px; letter-spacing: .08em; }
  .pm-head .pm-kicker { font-family: var(--mono); color: var(--brand); letter-spacing: .16em; }
  .pm-body h4 { color: var(--brand); border-left-color: var(--gold); }
  .pm-body p, .pm-body ul li, .pm-body ol li, .pm-quote p { color: #4A3F37; }
  .pm-body ul li::before { color: var(--gold-ink); }
  .pm-key { background: var(--sand); border-color: var(--line); border-radius: var(--r-sm); }
  .pm-key .k-label { background: var(--d-surface); color: var(--teal); font-family: var(--mono); letter-spacing: .12em; }
  .pm-quote { border-left-color: var(--brand); background: rgba(140,58,34,.06); }
  .pm-quote .q-by { color: var(--brand); font-family: var(--mono); font-size: 12.5px; }
  .pm-note { color: var(--ink3); }
  .pm-body ol li::before { background: var(--brand); }


  /* ---- 導覽列高度改為可成長：語言頁第 6 個連結會在窄視寬換行，固定 height 會裁切 ---- */
  nav { height: auto; }

  /* ======================= 學歷與經歷（bio） ======================= */
  .bio-grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 20px; align-items: start; }
  .bio-col {
    background: var(--paper2); border: 1px solid var(--line); border-radius: var(--r-md);
    padding: 26px 26px 20px; box-shadow: var(--sh-1);
    transition: transform .25s, box-shadow .25s, border-color .25s;
  }
  .bio-col:hover { transform: translateY(-3px); box-shadow: var(--sh-2); border-color: var(--brand); }
  .bio-col .b-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; border-bottom: 1px solid var(--line); padding-bottom: 12px; }
  .bio-col .b-head .b-kicker { font-family: var(--mono); font-size: 11px; letter-spacing: .16em; color: var(--brand); text-transform: uppercase; }
  .bio-col .b-head h3 { font-family: var(--head); font-weight: 700; font-size: 20px; letter-spacing: .04em; color: var(--ink); }
  .bio-col .b-head .b-cnt { font-family: var(--mono); font-size: 11px; color: var(--ink3); margin-left: auto; }
  .bio-list { list-style: none; }
  .bio-item {
    display: grid; grid-template-columns: 88px 1fr; gap: 12px;
    padding: 11px 8px 11px 8px; margin: 0 -8px; border-bottom: 1px dashed var(--line);
    border-radius: var(--r-xs); transition: background .2s;
  }
  .bio-item:last-child { border-bottom: none; }
  .bio-item:hover { background: rgba(140,58,34,.05); }
  .bio-item .yr { font-family: var(--mono); font-size: 12px; font-weight: 700; letter-spacing: .01em; color: var(--gold-ink); white-space: nowrap; padding-top: 2px; }
  .bio-item .tx { color: var(--ink2); font-size: 14.5px; line-height: 1.62; text-wrap: pretty; }
  .bio-item .tx strong { color: var(--ink); font-weight: 700; }

  /* ======================= 白皮書下載（whitepaper） ======================= */
  .wp-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .wp-card {
    display: flex; flex-direction: column;
    background: var(--paper2); border: 1px solid var(--line); border-radius: var(--r-md);
    padding: 26px 26px 22px; box-shadow: var(--sh-1);
    transition: transform .25s, box-shadow .25s, border-color .25s;
  }
  .wp-card:hover { transform: translateY(-3px); box-shadow: var(--sh-2); border-color: var(--brand); }
  .wp-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; border-bottom: 1px solid var(--line); padding-bottom: 12px; }
  .wp-no { font-family: var(--mono); font-size: 11.5px; letter-spacing: .16em; color: var(--brand); }
  .wp-meta { font-family: var(--mono); font-size: 11.5px; color: var(--ink3); margin-left: auto; white-space: nowrap; }
  .wp-card h3 { font-family: var(--head); font-weight: 700; font-size: 20px; line-height: 1.5; color: var(--ink); margin: 16px 0 12px; text-wrap: balance; }
  .wp-quote {
    margin: 0 0 14px; padding: 12px 16px;
    background: rgba(140,58,34,.06); border-left: 3px solid var(--brand);
    border-radius: 0 var(--r-sm) var(--r-sm) 0;
    font-size: 15px; line-height: 1.8; color: var(--ink2); text-wrap: pretty;
  }
  .wp-desc { font-size: 14.5px; line-height: 1.8; color: var(--ink2); text-wrap: pretty; }
  .wp-tags { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; margin: 16px 0 20px; padding: 0; }
  .wp-tags li {
    font-family: var(--mono); font-size: 11.5px; letter-spacing: .04em; color: var(--gold-ink);
    background: var(--sand); border: 1px solid var(--line); border-radius: var(--r-pill);
    padding: 4px 12px; white-space: nowrap;
  }
  .wp-act { display: flex; flex-wrap: wrap; gap: 10px; margin-top: auto; }
  .wp-act .btn { padding: 10px 18px; font-size: 12.5px; }
  .wp-dl { background: var(--brand); color: #FFFCF6; }
  .wp-dl:hover { background: var(--red-dark); transform: translateY(-2px); }
  .wp-read { border: 1px solid rgba(140,58,34,.5); color: var(--brand); }
  .wp-read:hover { border-color: var(--brand); background: rgba(140,58,34,.06); transform: translateY(-2px); }
  /* WP–02 卡片縮圖：白皮書封面（浮動右上，文字環繞）*/
  .wp-thumb { float: left; width: 118px; margin: 2px 18px 12px 0; }
  .wp-thumb img {
    display: block; width: 100%; height: auto;
    border: 1px solid var(--line); border-radius: var(--r-sm); box-shadow: var(--sh-1);
    cursor: zoom-in; transition: transform .25s, box-shadow .25s;   /* 可點擊看全圖 */
  }
  .wp-thumb img:hover { transform: translateY(-3px); box-shadow: var(--sh-2); }
  @media (max-width: 720px) {
    .wp-grid { grid-template-columns: 1fr; gap: 16px; }
    .wp-card { padding: 22px 18px 18px; }
    .wp-card h3 { font-size: 18px; }
    .wp-meta { margin-left: 0; }
    .wp-thumb { width: 92px; margin: 2px 14px 10px 0; }
    .wp-act .btn { flex: 1 1 auto; justify-content: center; }
  }

  /* ---- 學歷／經歷：可收合（.is-extra 為預設收起項） ---- */
  .bio-item.is-extra, .bio-sub.is-extra { display: none; }
  .bio-col.expanded .bio-item.is-extra { display: grid; }
  .bio-col.expanded .bio-sub.is-extra { display: block; }
  .bio-col:not(.expanded) .bio-list { position: relative; }
  .bio-col:not(.expanded) .bio-list::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 54px;
    background: linear-gradient(rgba(255,252,246,0), var(--paper2)); pointer-events: none;
  }
  .bio-sub {
    display: block; margin: 14px 0 2px; padding: 16px 8px 2px; border-top: 1px solid var(--line);
    font-family: var(--mono); font-size: 11.5px; letter-spacing: .12em; color: var(--brand);
  }
  .bio-toggle {
    display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%;
    margin-top: 14px; padding: 11px 14px; cursor: pointer;
    font-family: var(--mono); font-size: 12.5px; font-weight: 700; letter-spacing: .04em;
    color: var(--brand); background: var(--sand); border: 1px solid var(--line);
    border-radius: var(--r-sm); transition: background .2s, border-color .2s;
  }
  .bio-toggle:hover { background: #E3D4BC; border-color: var(--brand); }
  .bio-toggle:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
  .bio-toggle .chev { display: inline-block; transition: transform .25s; }
  .bio-col.expanded .bio-toggle .chev { transform: rotate(180deg); }

  /* ---- 導覽下拉選單（學經歷／十大政見）---- */
  .nav-dropdown { position: relative; }
  .nav-dropdown > summary {
    list-style: none; cursor: pointer; white-space: nowrap; padding: 3px 0;
    font-family: var(--mono); font-size: 12.5px; letter-spacing: .03em;
    color: var(--d-ink2); transition: color .2s;
  }
  .nav-dropdown > summary::-webkit-details-marker { display: none; }
  .nav-dropdown > summary::marker { content: ""; }
  .nav-dropdown > summary::after { content: " ▾"; font-size: 9px; opacity: .75; }
  .nav-dropdown > summary:hover, .nav-dropdown[open] > summary { color: var(--teal); }
  .nav-dropdown:not([open]) .nav-list { display: none; }
  .nav-list {
    position: absolute; left: 0; top: calc(100% + 8px); z-index: 60;
    min-width: 232px; width: max-content; max-width: calc(100vw - 44px);
    background: #0C1B26; border: 1px solid var(--d-line); border-radius: var(--r-sm);
    box-shadow: var(--sh-d2); overflow: hidden; padding: 6px 0;
  }
  .nav-list a {
    display: flex; align-items: baseline; gap: 10px; padding: 9px 16px;
    font-family: var(--mono); font-size: 12.5px; letter-spacing: .02em;
    color: var(--d-ink2); text-decoration: none; white-space: nowrap;
  }
  .nav-list a:hover, .nav-list a:focus-visible { background: rgba(47,219,166,.12); color: var(--teal); }
  .nav-list a .nn { color: var(--teal); opacity: .8; font-size: 11px; min-width: 1.2em; white-space: nowrap; }


  /* ======================= 手機 ======================= */
  @media (max-width: 720px) {
    nav { height: auto; min-height: 56px; padding: 8px 0; }
    .hero-strip { padding: 14px 18px; gap: 12px; justify-content: flex-start; }
    .hero-tag { font-size: 10.5px; letter-spacing: .1em; }
    .btn { padding: 9px 16px; font-size: 12.5px; }
    .brand { font-size: 15px; }
    nav .links { gap: 10px 12px; font-size: 11.5px; }
    .lang-dropdown > summary { font-size: 11px; }
    .sec-head h2 { font-size: clamp(22px, 5.6vw, 28px); }
    .nav-dropdown > summary { font-size: 11.5px; }
    .nav-list { min-width: 140px; padding: 4px 0; }
    .nav-list a { padding: 9px 14px; font-size: 12px; white-space: normal; line-height: 1.5; }
    .bio-grid { grid-template-columns: 1fr; gap: 16px; }
    .bio-col { padding: 22px 18px 16px; }
    .bio-col .b-head h3 { font-size: 18px; }
    .bio-item { grid-template-columns: 76px 1fr; gap: 10px; }
    .bio-item .yr { font-size: 11px; }
    .contact { padding: 40px 20px; }
    footer { font-size: 11.5px; }
  }

  /* ---- 政見卡片圓形配圖（有圖的卡片：圓圖左欄 + 內文右欄，內文一律靠左對齊）---- */
  .card.has-photo { display: flex; align-items: flex-start; gap: 16px; }
  .card.has-photo > .card-photo { flex: 0 0 132px; width: 132px; height: 132px; margin: 2px 0 0; }
  .card.has-photo > .card-body { flex: 1 1 auto; min-width: 0; }
  .card .card-photo img {
    display: block; width: 100%; height: 100%; object-fit: cover; border-radius: 50%;
    border: 3px solid var(--paper2); box-shadow: var(--sh-1);
  }
  @media (max-width:720px) {
    .card.has-photo { gap: 12px; }
    .card.has-photo > .card-photo { flex-basis: 104px; width: 104px; height: 104px; }
  }
  }

  /* ======================= 澄清專區（clarify） ======================= */
  .cl-list { display: grid; gap: 14px; }
  .cl-card {
    background: var(--paper2); border: 1px solid var(--line); border-radius: var(--r-md);
    box-shadow: var(--sh-1); overflow: hidden;
    transition: box-shadow .25s, border-color .25s;
  }
  .cl-card:hover { border-color: rgba(140,58,34,.45); box-shadow: var(--sh-2); }
  .cl-card[open] { border-color: rgba(140,58,34,.5); box-shadow: var(--sh-2); }
  .cl-card > summary {
    list-style: none; cursor: pointer;
    display: flex; align-items: center; gap: 14px;
    padding: 20px 22px; background: rgba(140,58,34,.045);
  }
  .cl-card > summary::-webkit-details-marker { display: none; }
  .cl-card > summary::marker { content: ""; }
  .cl-card > summary:focus-visible { outline: 2px solid var(--brand); outline-offset: -3px; }
  .cl-card > summary h3 { flex: 1 1 auto; min-width: 0; font-size: 19px; line-height: 1.5; color: var(--ink); text-wrap: balance; }
  .cl-chev { flex: 0 0 auto; color: var(--brand); font-size: 13px; line-height: 1; transition: transform .25s; }
  .cl-card[open] .cl-chev { transform: rotate(180deg); }
  /* 護欄：<details> 的原生「關閉即隱藏」在子元素被指定 display 時會失效，明寫才穩 */
  .cl-card:not([open]) .cl-body { display: none; }
  .cl-body {
    border-top: 1px solid var(--line);
    padding: 24px 22px 26px;
    font-size: 15px; line-height: 1.95; color: var(--ink2);
  }
  .cl-body p { margin: 0 0 15px; text-wrap: pretty; }
  .cl-body p:last-child { margin-bottom: 0; }
  .cl-lead { color: var(--ink); font-weight: 700; letter-spacing: .02em; }
  .cl-call { margin-top: 22px; color: var(--ink); font-weight: 700; letter-spacing: .06em; }
  .cl-sign {
    margin-top: 12px; padding-top: 16px; border-top: 1px dashed var(--line);
    text-align: right; color: var(--ink);
  }
  .cl-sign-role { font-size: 13.5px; color: var(--ink2); }
  .cl-sign-name { font-size: 20px; letter-spacing: .08em; }
  .cl-sign-date { font-family: var(--mono); font-size: 12px; letter-spacing: .1em; color: var(--ink3); margin-top: 5px; }
  /* 澄清專區內的影片卡（暖紙底；外連 YouTube，縮圖沿用站上慣例的 i.ytimg.com）*/
  .cl-video {
    display: flex; gap: 16px; align-items: flex-start; margin: 2px 0 14px;
    background: var(--paper); border: 1px solid var(--line); border-radius: var(--r-md);
    padding: 12px; text-decoration: none; color: inherit;
    transition: transform .25s, box-shadow .25s, border-color .25s;
  }
  .cl-video:hover, .cl-video:focus-visible { transform: translateY(-3px); box-shadow: var(--sh-2); border-color: var(--brand); }
  .cl-video .thumb { position: relative; flex: 0 0 224px; width: 224px; aspect-ratio: 16 / 9; border-radius: var(--r-sm); overflow: hidden; background: #1a1211; }
  .cl-video .thumb img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .cl-video .play { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: rgba(0,0,0,.16); transition: background .25s; }
  .cl-video .play span { display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; padding-left: 3px; border-radius: 50%; background: rgba(224,27,57,.92); color: #fff; font-size: 15px; box-shadow: var(--sh-d1); }
  .cl-video:hover .play { background: rgba(0,0,0,.02); }
  .cl-video .body { flex: 1 1 auto; min-width: 0; }
  .cl-video .t { font-family: var(--head); font-weight: 700; font-size: 16px; line-height: 1.6; color: var(--ink); text-wrap: pretty; }
  .cl-video .m { margin-top: 8px; font-family: var(--mono); font-size: 12px; letter-spacing: .02em; color: var(--ink3); }
  .cl-note { font-family: var(--mono); font-size: 12.5px; letter-spacing: .02em; color: var(--ink3); }
  @media (max-width: 720px) {
    .cl-card > summary { padding: 16px; gap: 10px; }
    .cl-card > summary h3 { font-size: 17px; }
    .cl-body { padding: 18px 16px 20px; font-size: 14.5px; line-height: 1.9; }
    .cl-sign-name { font-size: 18px; }
    .cl-video { flex-direction: column; gap: 12px; padding: 10px; }
    .cl-video .thumb { flex: 0 0 auto; width: 100%; }
    .cl-video .t { font-size: 15px; }
  }
  /* 導覽列多一項（澄清）後，721–900px 會把語言選單擠到第二排（實測 768px 缺口 32px）；
