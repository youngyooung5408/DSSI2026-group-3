<meta name="twitter:title" content="數位孿生救嘉義 - 市長候選人 陳愷璜 校長" />
<meta name="twitter:description" content="沒有政黨奧援，就自己來。以數位孿生與人文美學，翻轉嘉義市。" />
<meta name="twitter:image" content="https://chiayi-mayor.duckdns.org/assets/og-image.jpg" />
<link rel="icon" href="assets/favicon.ico" sizes="any" />
