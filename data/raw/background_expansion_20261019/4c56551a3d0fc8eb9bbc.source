<script>
(function(){
  document.querySelectorAll('.rs-more').forEach(function(btn){
    var card = btn.previousElementSibling;
    if (!card || !card.classList.contains('rs-card')) return;
    btn.setAttribute('aria-expanded', 'false');
    btn.addEventListener('click', function(){
      var open = card.classList.toggle('open');
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      btn.textContent = open ? '收合 ▲' : '展開全文 ▾';
      if (!open) card.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    });
  });
})();

/* ---- 政見詳細內容：點卡片浮出另一張卡片 ---- */
(function(){
  var overlay = document.getElementById('pm-overlay');
  if (!overlay) return;
  var body     = document.getElementById('pm-body');
  var tagEl    = document.getElementById('pm-tag');
  var kickerEl = document.getElementById('pm-kicker');
  var titleEl  = document.getElementById('pm-title');
  var closeBtn = overlay.querySelector('.pm-close');
  var lastFocus = null;

  function open(card){
    var tpl = document.getElementById(card.getAttribute('data-detail') || '');
    if (!tpl) return;
    var tag = card.querySelector('.tag');
    var h3  = card.querySelector('h3');
    tagEl.textContent    = tag ? tag.textContent : '';
    titleEl.textContent  = h3 ? h3.textContent : '';
    kickerEl.textContent = card.getAttribute('data-detail-sub') || '十大經濟政見 · 詳細內容';
    // 安全：內容來源為同頁靜態 <template>，無任何使用者輸入字串
    body.innerHTML = tpl.innerHTML;
    body.scrollTop = 0;
    lastFocus = card;
    overlay.classList.add('show');
    document.body.classList.add('pm-open');
    if (closeBtn) closeBtn.focus();
  }

  function close(){
    overlay.classList.remove('show');
    document.body.classList.remove('pm-open');
    if (lastFocus && lastFocus.focus) lastFocus.focus();
  }

  document.querySelectorAll('.card[data-detail]').forEach(function(card){
    card.setAttribute('role', 'button');
    card.setAttribute('tabindex', '0');
    card.setAttribute('aria-haspopup', 'dialog');
    card.addEventListener('click', function(){ open(card); });
    card.addEventListener('keydown', function(e){
      if (e.key === 'Enter' || e.key === ' ' || e.key === 'Spacebar') { e.preventDefault(); open(card); }
    });
  });

  overlay.addEventListener('click', function(e){
    if (e.target === overlay || e.target.closest('[data-close]')) close();
  });
  document.addEventListener('keydown', function(e){
    if (e.key === 'Escape' && overlay.classList.contains('show')) close();
  });
})();
</script>
<script>
/* ---- 導覽下拉選單：項目導引（捲到目標、必要的話展開內文或開啟浮出卡片）---- */
(function () {
  var drops = document.querySelectorAll(".nav-dropdown");
  if (!drops.length) return;

  function closeAll() {
    drops.forEach(function (d) { d.open = false; });
  }
  function fitMenu(dd) {
    var list = dd.querySelector(".nav-list");
    if (!list) return;
    list.style.left = ""; list.style.right = "";
    var pad = 10;
    var vw = document.documentElement.clientWidth;
    var r = list.getBoundingClientRect();
    // 單次位移量：先靠右收進來、再確保不超出左緣（來回改 left/right 會在兩邊都放不下時互相打架）
    var shift = 0;
    if (r.right > vw - pad) shift = (vw - pad) - r.right;
    if (r.left + shift < pad) shift = pad - r.left;
    if (shift) list.style.left = shift + "px";
  }
  function scrollToEl(el) {
    var html = document.documentElement;
    var prev = html.style.scrollBehavior;
    html.style.scrollBehavior = "auto";
    window.scrollTo(0, el.getBoundingClientRect().top + window.scrollY - 86);
    html.style.scrollBehavior = prev;
  }
  function expandBio(id) {
    var card = document.getElementById(id);
    if (!card || card.classList.contains("expanded")) return;
    card.classList.add("expanded");
    var btn = document.querySelector('[data-bio-toggle="' + id + '"]');
    if (btn) {
      btn.setAttribute("aria-expanded", "true");
      var lbl = btn.querySelector(".t-label");
      if (lbl) lbl.textContent = btn.dataset.labelLess;
    }
  }

  drops.forEach(function (dd) {
    dd.addEventListener("toggle", function () {
      if (!dd.open) return;
      drops.forEach(function (o) { if (o !== dd) o.open = false; });
      fitMenu(dd);
    });
  });

  document.addEventListener("click", function (e) {
    if (!e.target.closest(".nav-dropdown")) closeAll();
  });
  document.addEventListener("keydown", function (e) {
    if (e.key === "Escape") closeAll();
  });

  document.querySelectorAll(".nav-list a[data-goto]").forEach(function (a) {
    a.addEventListener("click", function (e) {
      var id = a.getAttribute("data-goto");
      var target = document.getElementById(id);
      var detail = a.getAttribute("data-open-detail");
      closeAll();
      if (!target) return;
      e.preventDefault();
      scrollToEl(target);
      if (a.hasAttribute("data-bio-open")) expandBio(id);
      if (detail) setTimeout(function () { target.click(); }, 130);
      history.replaceState(null, "", "#" + id);
    });
  });

  /* 點擊頁首品牌文字：回到最上面 */
  var brand = document.querySelector(".brand");
  if (brand) {
    brand.addEventListener("click", function (e) {
      e.preventDefault();
      closeAll();
      window.scrollTo({ top: 0, behavior: "smooth" });
      if (location.hash) history.replaceState(null, "", location.pathname + location.search);
    });
  }
})();
</script>
</body>
</html>
