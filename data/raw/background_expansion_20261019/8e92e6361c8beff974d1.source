<script>
    var bannerOff = getCountDown('2020/01/11 16:00:00');
    var bannerOn = getCountDown('2020/01/13 00:00:00');

    // 選舉當天過12點就將banner收掉
    if (bannerOff < 0) {
        changeBannerHeight(60);
    }
    // 選舉過後，將banner展開
    if (bannerOn < 0) {
        changeBannerHeight(300);
    }

    function changeBannerHeight(height) {
        $('.visual').height(height);
    }
</script>
