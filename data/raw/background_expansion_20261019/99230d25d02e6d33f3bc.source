9},\"covers\",[288,289],\"desktopCovers\",[282,283],\"theme\",{\"_13\":14,\"_270\":271,\"_272\":273,\"_274\":275},\"socialMedia\",{\"_13\":14,\"_253\":254},\"profile\",{\"_167\":168,\"_66\":169,\"_170\":171,\"_172\":173,\"_174\":175,\"_176\":177,\"_178\":179,\"_180\":181,\"_78\":182,\"_183\":184,\"_185\":186,\"_187\":188},\"creditPage\",{\"_166\":29},\"openGraphSettings\",{\"_37\":12,\"_40\":163,\"_164\":165},\"edmSubscription\",{\"_141\":29},\"donationAmounts\",{\"_147\":148,\"_149\":150,\"_151\":152,\"_153\":154,\"_155\":156},\"donationSubscriptionPeriods\",{\"_143\":34,\"_144\":29,\"_145\":146},\"pointsConfig\",{\"_141\":34,\"_142\":59},\"paymentConfig\",{\"_117\":34,\"_118\":34,\"_119\":34,\"_53\":29,\"_120\":34,\"_121\":122,\"_123\":124,\"_125\":126},\"publicFeatureAvailability\",{\"_98\":34,\"_99\":34,\"_100\":34,\"_101\":34,\"_102\":34,\"_103\":34,\"_104\":34,\"_105\":34,\"_106\":34,\"_107\":34,\"_108\":34,\"_109\":34,\"_110\":34,\"_111\":34,\"_112\":34,\"_113\":34,\"_114\":34,\"_115\":34,\"_116\":29},\"CHARGE_DASHBOARD\",\"DONATION_PROJECT\",\"DONATION_ANNUAL_DONATION\",\"DONATION_SETTING\",\"GOODS_PROMOS\",\"GOODS_SETTING\",\"DONATION_DASHBOARD\",\"DONATION_PROJECT_ADD\",\"EVENT_PROMO_CODE\",\"MEMBERSHIP_FEE_SETTING\",\"MEMBER_MEMBERSHIP_FEE_CREATE\",\"SITE_CROWDFUNDING\",\"POLITICAL_DASHBOARD\",\"POLITICAL_DECLARATION\",\"POLITICAL_RECORDS\",\"POLITICAL_ANONYMOUS\",\"POLITICAL_RECEIPTS\",\"DONATION\",\"ONLY_FREE\",\"non3DCardAvailable\",\"paymentUrlCardAvailable\",\"savedCardAvailable\",\"enabledUnifiedCheckout\",\"cvsPaymentProvider\",\"FAMILY_MART\",\"methods\",{\"_133\":34,\"_134\":34,\"_135\":29,\"_136\":29,\"_137\":34,\"_138\":34,\"_139\":29,\"_140\":29},\"cardTypes\",{\"_127\":34,\"_128\":34,\"_129\":34,\"_52\":29,\"_130\":29,\"_131\":29,\"_132\":29},\"visa\",\"masterCard\",\"JCB\",\"americanExpress\",\"discover\",\"dinersClub\",\"card\",\"cvs\",\"atm\",\"linePay\",\"applePay\",\"clickToPay\",\"ipassTwqr\",\"googlePayByUnifiedCheckout\",\"enabled\",\"exchangeRate\",\"unlimit\",\"allowCustomPeriods\",\"periods\",[],\"donationPanelMode\",\"default\",\"donationOption\",\"both\",\"minAmount\",100,\"fastPanelOption\",\"onetime\",\"amounts\",[157,158,159,160,161,162],200,500,3000,5000,10000,20000,\"一起讓台北更好\",\"image\",\"https://static-assets.oen.tw/images/img-3EgF2qStSxId46nHJjWeZVMFClD.jpg\",\"showPage\",\"goal\",{\"_189\":252,\"_191\":29},{\"_189\":59,\"_191\":34},\"info\",{\"_189\":202,\"_191\":34,\"_13\":14,\"_196\":203},\"goods\",{\"_189\":201,\"_191\":29},\"events\",{\"_189\":200,\"_191\":29},\"articles\",{\"_189\":199,\"_191\":29},\"memberships\",{\"_189\":198,\"_191\":34},\"contacts\",{\"_189\":195,\"_191\":34,\"_13\":14,\"_196\":197},{\"_189\":194,\"_191\":34},\"questionnaire\",{\"_189\":193,\"_191\":34},\"project\",{\"_189\":192,\"_191\":29},\"edm\",{\"_189\":190,\"_191\":29},\"order\",11,\"display\",10,9,8,7,\"data\",[],6,5,4,3,2,[204,205,206,207,208,209,210],{\"_211\":247,\"_37\":248,\"_214\":249,\"_216\":250},{\"_211\":242,\"_37\":243,\"_214\":244,\"_216\":245},{\"_211\":237,\"_37\":238,\"_214\":239,\"_216\":240},{\"_211\":232,\"_37\":233,\"_214\":234,\"_216\":235},{\"_211\":227,\"_37\":228,\"_214\":229,\"_216\":230},{\"_211\":222,\"_37\":223,\"_214\":224,\"_216\":225},{\"_211\":212,\"_37\":213,\"_214\":215,\"_216\":217},\"id\",\"2gmxdYotQgBEL2uMAraEN\",\"應佳妤上過的節目📺：政治一點明\",\"content\",\"\u003cp\u003e\u003cspan style=\\\"background-color: transparent; color: rgb(15, 15, 15);\\\"\u003e「最美新人」沒包袱超做自己!應佳妤怒撕政治黑暗面:看不慣母親遭迫害！話鋒一轉竟笑喊黑熊沈伯洋「這點」超可愛？\u003c/span\u003e\u003c/p\u003e\",\"media\",{\"_218\":219,\"_220\":221},\"type\",\"youtubeVideo\",\"link\",\"https://www.youtube.com/watch?v=g5fLA9Ao6-A\u0026t=688s\",\"1_5VzTq9Bj-FGVwhx3CFA\",\"應佳妤上過的節目📺：國民開小會\",\"\u003cp\u003e\u003cspan style=\\\"color: rgb(15, 15, 15); background-color: rgb(255, 255, 255);\\\"\u003e應佳妤代母出征! 媽媽是應曉薇有特權?! 京華城案重判真相! 送泡麵貼照片挨轟! 萬華都更卡關怎解？\u003c/span\u003e\u003c/p\u003e\",{\"_218\":219,\"_220\":226},\"https://www.youtube.com/watch?v=Z1dng7H8yP8\u0026t=27s\",\"hcHTVsMKQ6brxiPx8ZErk\",\"應佳妤上過的節目📺：菁英PK秀\",\"\u003cp\u003e【菁英PK SHOW】集數：第6１集\u003c/p\u003e\u003cp\u003e由尹乃菁火線主持的【玉山新聞雲 Bang TV】直播節目《菁英PK SHOW》第61集重磅登場！本集邀請台北市議員應曉薇議員助理應佳妤、民眾黨前秘書行政部副主任蔡君蔡君婷-GettyTsai交鋒，直球對決近期政壇最燙手的三大政治爭議，拆穿權力話術、戳破修法假面，為觀眾揭開檯面下的政治算計。\u003c/p\u003e\",{\"_218\":219,\"_220\":231},\"https://www.youtube.com/watch?v=gBNkT7KgjDU\u0026list=PLuVlgqgWYB_t6XbzZxA125TBoUFqJfl-8\u0026index=7\",\"EUe-XpxuQ__jMhWV4ctGR\",\"應佳妤的政見\",\"\u003cp\u003e\u003cstrong\u003eS.A.F.E. 社會韌性模型\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e中正萬華的四大承諾\u003c/p\u003e\u003cp\u003e面對中正萬華這樣一個結構複雜、歷史深厚、人口組成多元的老城區，我認為，治理不能只是「頭痛醫頭、腳痛醫腳」。\u003c/p\u003e\u003cp\u003e中正萬華需要的，不只是單點式的補救，而是一套能夠真正撐起城市安全、世代發展、文化根基與政策執行的整體治理模型。\u003c/p\u003e\u003cp\u003e因此，我提出 「S.A.F.E. 社會韌性模型」。\u003c/p\u003e\u003cp\u003e這四個英文字母，代表我對中正萬華未來的四大承諾，也是一個讓老城區重新穩固、安心、向前的正向循環。\u003c/p\u003e\u003cp\u003e\u003cbr\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eS｜Security 安全網底線\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e守護最弱勢的聲音\u003c/p\u003e\u003cp\u003e第一個 S，是 \u003cstrong\u003eSecurity\u003c/strong\u003e，也就是安全網底線。\u003c/p\u003e\u003cp\u003e中正萬華有許多老舊巷弄，也有複雜的社區結構。越是這樣的地方，越需要建立一張「無死角的社會安全網」。\u003c/p\u003e\u003cp\u003e我要推動兒少安全、公共安全與動物保護政策，對虐兒、暴力與公共安全風險零容忍。透過 AI 輔助風險預警與通報整合，讓兒少保護、詐騙防治、公共安全與動物保護不再只是事後補救，而能更早發現、更快介入。孩子的安全不能等到悲劇發生才被重視；弱勢的聲音，也不能等到受傷之後才被聽見。\u003c/p\u003e\u003cp\u003e同時，我也關心不會說話的毛小孩。動物保護不只是愛心議題，更是文明城市的基本底線。未來我會推動動保政策與寵物友善空間，關注動物健保、用藥、飼料與照護制度，讓人與動物都能在城市裡被善待。\u003c/p\u003e\u003cp\u003e安全，是城市最基本的承諾。守住最弱勢，就是守住中正萬華的底線。\u003c/p\u003e\u003cp\u003e\u003cbr\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eA｜Advancement 世代發展\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e直面老屋與高齡化\u003c/p\u003e\u003cp\u003e第二個 A，是 Advancement，也就是世代發展。\u003c/p\u003e\u003cp\u003e中正萬華正在面對老屋、高齡化、都市更新與青年留居的挑戰。這些問題不是單一政策可以解決，而是整個城區的「板塊重組」。\u003c/p\u003e\u003cp\u003e在中正區，有許多軍公教、專業人士與高知識選民，他們需要的是更完整的長照資源、醫療照護與高品質的在地安養環境。\u003c/p\u003e\u003cp\u003e在萬華區，許多鄉親期待的是商圈復甦、老屋更新、公共空間改善，以及更有活力的地方發展。\u003c/p\u003e\u003cp\u003e我要用現代化政策解決老城區問題，讓長輩能夠在地安養，讓商圈重新活絡，也讓年輕人看得見留在台北、留在中正萬華的未來。\u003c/p\u003e\u003cp\u003e世代發展不是只照顧某一個年齡層，而是讓長輩安心、青年有路、家庭有依靠，讓整個城區一起往前走。\u003c/p\u003e\u003cp\u003e\u003cbr\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eF｜Foundation 文化根基\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e老城區的靈魂\u003c/p\u003e\u003cp\u003e第三個 F，是 Foundation，也就是文化根基。\u003c/p\u003e\u003cp\u003e中正萬華是台北最有故事的地方。這裡有歷史、有信仰、有市場、有老街、有學校，也有一代又一代人生活過的痕跡。\u003c/p\u003e\u003cp\u003e我認為，老城區的價值不應該只是被保存，而應該被重新轉化、重新看見。\u003c/p\u003e\u003cp\u003e我要推動地方創生、文化教育與在地品牌，讓中正萬華深厚的文化底蘊成為孩子的教育養分，也成為城市發展的力量。\u003c/p\u003e\u003cp\u003e讓這裡的孩子在老故事裡長大，卻同時具備面向未來的國際視野。讓文化不只是懷舊，而是能夠帶動觀光、教育、商圈與地方認同的真正根基。\u003c/p\u003e\u003cp\u003e中正萬華不是老舊，而是有靈魂。我要讓這份靈魂，被更多人看見。\u003c/p\u003e\u003cp\u003e\u003cbr\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eE｜Execution 執行支撐\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e政策落地的核心引擎\u003c/p\u003e\u003cp\u003e第四個 E，是 \u003cstrong\u003eExecution\u003c/strong\u003e，也就是執行支撐。\u003c/p\u003e\u003cp\u003e所有政見，如果沒有第一線人員執行，都只是空談。\u003c/p\u003e\u003cp\u003e警消、醫護、社工、基層公務員，是城市政策真正能不能落地的關鍵。他們每天面對市民最直接的需求，也承擔最多壓力。\u003c/p\u003e\u003cp\u003e所以，我要全力支持第一線人員，推動更合理的工作環境、更完善的福利保障、更清楚的跨局處協作，以及更有效率的政策執行機制。\u003c/p\u003e\u003cp\u003e更有效率的政策執行機制，顧名思義，我要推動 AI 輔助治理，讓科技真正進入第一線服務。未來可以運用 AI 協助案件分流、風險預警、社福通報、長照需求盤點、商圈數據分析與民眾服務回應，讓警消、社工、醫護與基層公務員不用被重複行政工作耗盡，而能把更多時間留給真正需要被照顧的人。\u003c/p\u003e\u003cp\u003e只有行政引擎運轉順暢，政策才進得了家門；只有第一線人員被支持，市民才會真正被照顧。\u003c/p\u003e\u003cp\u003e執行力，是讓承諾成真的關鍵。\u003c/p\u003e\u003cp\u003e\u003cbr\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eS.A.F.E. 的正向循環\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eS.A.F.E. 不是四個分開的口號，而是一個正向循環。\u003c/p\u003e\u003cp\u003e當我們透過 \u003cstrong\u003eExecution 執行支撐\u003c/strong\u003e，挺住警消、醫護、社工與基層公務員，他們就有力量去落實 \u003cstrong\u003eSecurity 安全網底線\u003c/strong\u003e，保護孩子、弱勢與動物。\u003c/p\u003e\u003cp\u003e當最弱勢被保護了，長輩有保障了，家庭有依靠了，年輕人就能無後顧之憂地投入 \u003cstrong\u003eAdvancement 世代發展\u003c/strong\u003e，拚事業、拚都更、拚商圈復甦，也拚一個能留下來的未來。\u003c/p\u003e\u003cp\u003e而整個社會，再透過 \u003cstrong\u003eFoundation 文化根基\u003c/strong\u003e，把中正萬華的歷史、教育與地方精神傳給下一代，讓這裡不只是被治理，而是被理解、被珍惜、被延續。\u003c/p\u003e\",{\"_218\":164,\"_220\":236},\"https://static-assets.oen.tw/images/img-3Ef3JnaJQBV0PQhfdJLMBlMyR5t.png\",\"C0b_EesEgfmhm3nO26lCG\",\"應佳妤的書📓\",\"\u003cp\u003e很多人認識我，是因為我是應曉薇的女兒。\u003c/p\u003e\u003cp\u003e但過去幾年，我的人生不只是留學、求學與成長，更被迫經歷了一場與司法緊密交織的旅程。\u003c/p\u003e\u003cp\u003e《妳教我的一切，都在風裡》誕生於那段日子。\u003c/p\u003e\u003cp\u003e\u003cbr\u003e\u003c/p\u003e\u003cp\u003e當家人捲入司法案件，當熟悉的生活被輿論、新聞與法庭取代，我第一次如此近距離地看見制度如何運作，也第一次感受到，一個人被貼上標籤之後，真實的故事往往容易被忽略。\u003c/p\u003e\u003cp\u003e這本書不是在談論案情，也不是為任何人辯護。\u003c/p\u003e\u003cp\u003e它記錄的是一個女兒陪伴母親走過風暴的過程，是一次對親情、信任、信念與公平的思考。\u003c/p\u003e\u003cp\u003e從台北到多倫多，再到倫敦；從議員服務處到法庭旁聽席；從新聞上的標題，到深夜裡無數次的自我懷疑與重新站起來。我開始理解，制度或許有它冰冷的一面，但每一個案件背後，都是真實的人生。\u003c/p\u003e\u003cp\u003e\u003cbr\u003e\u003c/p\u003e\u003cp\u003e很多人認識的是新聞裡的名字。\u003c/p\u003e\u003cp\u003e而我希望透過這本書，讓大家看見名字背後的人。\u003c/p\u003e\u003cp\u003e看見一個從小在地方服務中長大的女孩，如何在司法風暴中學會堅強；看見一個曾經對政治與制度感到失望的人，如何重新選擇相信改變的可能；也看見一位年輕世代，為什麼決定站出來投入公共事務。\u003c/p\u003e\u003cp\u003e\u003cbr\u003e\u003c/p\u003e\u003cp\u003e如果說這本書有什麼核心，那大概是：\u003c/p\u003e\u003cp\u003e當風暴來臨時，我們無法決定會遭遇什麼，但可以決定自己成為什麼樣的人。\u003c/p\u003e\u003cp\u003e而今天的我，選擇把那些傷痛、思考與成長，化為服務社會的力量。\u003c/p\u003e\u003cp\u003e謝謝每一位願意支持我的朋友。你的每一份政治獻金，不只是支持一位年輕候選人，更是在支持一個相信理解、相信陪伴、也相信公平與希望的人，繼續走下去。\u003c/p\u003e\",{\"_218\":164,\"_220\":241},\"https://static-assets.oen.tw/images/img-3Ef1KM3CNsCQILiGtoggMoZT9Uu.jpg\",\"qrV82x3pa2A7LvOCEEzNU\",\"應佳妤的履歷꙳◛⁺⑅♡\",\"\u003cp\u003e\u003cstrong\u003e▍應佳妤 Queena Ying\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cbr\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e【學歷】\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e加拿大多倫多大學（University of Toronto）\u003c/p\u003e\u003cp\u003e社會學（Sociology）、國際發展學（International and Development Studies） 雙主修學士\u003c/p\u003e\u003cp\u003e英國倫敦大學亞非學院（SOAS University of London）\u003c/p\u003e\u003cp\u003e公共政策與管理碩士（MSc Public Policy and Management）\u003c/p\u003e\u003cp\u003e\u003cbr\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e【經歷】\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e臺北市議會圖書館實習生\u003c/p\u003e\u003cp\u003e臺北市議員辦公室實習生\u003c/p\u003e\u003cp\u003e臺北市議員服務團隊成員\u003c/p\u003e\u003cp\u003e2010、2014、2018、2022年議員選戰團隊成員\u003c/p\u003e\u003cp\u003e公共政策研究者\u003c/p\u003e\u003cp\u003e《妳教我的一切，都在風裡》作者\u003c/p\u003e\u003cp\u003e\u003cbr\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e【關注議題】\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e青年發展\u003c/p\u003e\u003cp\u003e兒少保護\u003c/p\u003e\u003cp\u003e動物保護\u003c/p\u003e\u003cp\u003e社會安全網\u003c/p\u003e\u003cp\u003e高齡照護\u003c/p\u003e\u003cp\u003e地方治理與公共參與\u003c/p\u003e\",{\"_218\":219,\"_220\":246},\"https://youtu.be/u35sKyIkbrc?si=o9SrmGtU690tCYwP\",\"unIFZP2jcRLfwBjjiBZ7b\",\"認識應佳妤♥\",\"\u003cp\u003e如果把人生拍成一部電影，我大概很早就走進了片場。\u003c/p\u003e\u003cp\u003e8歲那年，別的小朋友放學後去安親班、補習班，而我常去的地方，是服務處。\u003c/p\u003e\u003cp\u003e那裡有堆得比我還高的文宣、有永遠響不停的電話，也有來來往往的鄰長、里長和居民。我在那裡寫作業、吃晚餐，也在那裡第一次看見，原來一通電話的背後，可能是一個家庭的焦慮；一件小小的陳情，可能是一個人困擾了好幾年的問題。\u003c/p\u003e\u003cp\u003e那時候的我還不懂政治。\u003c/p\u003e\u003cp\u003e但我記得那些被幫助後露出笑容的人。\u003c/p\u003e\u003cp\u003e但也記得，大人們總是在處理完自己的事情之後，繼續處理別人的事情。\u003c/p\u003e\u003cp\u003e\u003cbr\u003e\u003c/p\u003e\u003cp\u003e從2010年、2014年、2018年到2022年，我參與了四次議員選戰。\u003c/p\u003e\u003cp\u003e有人說，這是我的成長背景。\u003c/p\u003e\u003cp\u003e但對我來說，那更像是一種陪伴。\u003c/p\u003e\u003cp\u003e陪伴著一個社區的變化，陪伴著地方工作的日常，也陪伴著我慢慢長大。\u003c/p\u003e\u003cp\u003e後來，我開始想知道，除了自己熟悉的世界之外，還有沒有其他答案。\u003c/p\u003e\u003cp\u003e於是我前往加拿大多倫多大學，雙主修社會學與國際發展研究。\u003c/p\u003e\u003cp\u003e在課堂上，我研究城市、社會、貧窮、不平等與公共政策；在不同文化與國家的交流裡，我開始學著用更大的視角理解一座城市。\u003c/p\u003e\u003cp\u003e\u003cbr\u003e\u003c/p\u003e\u003cp\u003e但其實，在出國之前，我早已走進議會。\u003c/p\u003e\u003cp\u003e我曾在臺北市議會圖書館實習。\u003c/p\u003e\u003cp\u003e每天整理館藏、建檔資料、協助查找新聞紀錄與政策資料。那是我第一次發現，原來一場質詢、一項法案、一份預算的背後，都有許多看不見的研究與準備。\u003c/p\u003e\u003cp\u003e\u003cbr\u003e\u003c/p\u003e\u003cp\u003e後來，我也在議員辦公室實習與工作。\u003c/p\u003e\u003cp\u003e從整理公文、準備質詢資料、協助簡報製作，到參與地方會勘、選民服務與社區活動。\u003c/p\u003e\u003cp\u003e我開始理解，政治其實離生活很近。\u003c/p\u003e\u003cp\u003e一盞路燈亮不亮、一條人行道平不平、一位長者能不能獲得照顧、一個孩子能不能安全長大，看起來都不是什麼驚天動地的大事，但對當事人來說，那就是生活。\u003c/p\u003e\u003cp\u003e\u003cbr\u003e\u003c/p\u003e\u003cp\u003e大學畢業後，我前往英國倫敦大學亞非學院（SOAS）攻讀公共政策與管理碩士。\u003c/p\u003e\u003cp\u003e在倫敦，我研究公共治理、政府透明、數位治理與公共財政，也完成了關於跨國詐騙與人口販運防制政策的研究。\u003c/p\u003e\u003cp\u003e離開台灣之後，我看過不同城市的治理方式，也看過不同國家如何面對社會問題。\u003c/p\u003e\u003cp\u003e但走得越遠，我反而越確定一件事。\u003c/p\u003e\u003cp\u003e我最在乎的故事，始終發生在中正萬華。\u003c/p\u003e\u003cp\u003e是市場裡熟悉的招呼聲。\u003c/p\u003e\u003cp\u003e是巷口開了幾十年的老店。\u003c/p\u003e\u003cp\u003e是每天穿梭在街道上的居民。\u003c/p\u003e\u003cp\u003e也是那些需要被聽見、被看見的人。\u003c/p\u003e\u003cp\u003e\u003cbr\u003e\u003c/p\u003e\u003cp\u003e很多人問我，為什麼回來？\u003c/p\u003e\u003cp\u003e因為我一直相信，真正的改變，不是站在遠方評論一座城市，而是願意回到這座城市，和大家一起面對問題。\u003c/p\u003e\u003cp\u003e\u003cbr\u003e\u003c/p\u003e\u003cp\u003e我是應佳妤。\u003c/p\u003e\u003cp\u003e2002年出生於台北。\u003c/p\u003e\u003cp\u003e8歲第一次參與選戰。\u003c/p\u003e\u003cp\u003e24歲，決定親自站上起跑線。\u003c/p\u003e\u003cp\u003e有人說我是新人。\u003c/p\u003e\u003cp\u003e但如果從第一次走進服務處開始算，我已經認識地方十六年。\u003c/p\u003e\u003cp\u003e如果從第一次走進議會開始算，我知道公共服務從來不只是口號，而是每天累積的責任。\u003c/p\u003e\u003cp\u003e帶著在議會學到的實務經驗、在加拿大與英國求學的國際視野，以及對中正萬華最深的感情。\u003c/p\u003e\u003cp\u003e這一次，我想親自為這座陪我長大的城市努力。\u003c/p\u003e\",{\"_218\":219,\"_220\":251},\"https://youtu.be/G5LNVsAQiEw?si=Xft_ZZfKT3apZJKb\",0,\"platforms\",[255,256,257,258],{\"_259\":268,\"_261\":269,\"_263\":-5},{\"_259\":266,\"_261\":267,\"_263\":-5},{\"_259\":264,\"_261\":265,\"_263\":-5},{\"_259\":260,\"_261\":262,\"_263\":-5},\"platform\",\"youtube\",\"url\",\"https://youtube.com/channel/UCmrSZE0oJO1Td_B2hmfu8vw?si=ZT44QUfIWe9aOA4s\",\"img\",\"line\",\"https://lin.ee/nenDwFQ\",\"ig\",\"https://www.instagram.com/queenamoon.official?igsh=NDB5bDBwNXB5NmFs\u0026utm_source=qr\",\"fb\",\"https://www.facebook.com/share/1RSQoQEwuD/?mibextid=wwXIfr\",\"layout\",\"b\",\"currentTheme\",\"custom\",\"customTheme\",{\"_276\":277,\"_278\":279,\"_280\":281},\"dark\",\"#4400cc\",\"bright\",\"#ff77ff\",\"color\",\"#FFFFFF\",{\"_211\":286,\"_261\":287},{\"_211\":284,\"_261\":285},\"nn_p5ZuFri6aotpIq8WnJ\",\"https://static-assets.oen.tw/images/img-3EdHNYM2FGNtVU2yLghnToe6ar2.png\",\"o3uXZiCudLNxrtVtcZWfc\",\"https://static-assets.oen.tw/images/img-3EgCPBwJ5cLgnMhJE2CznHpx9to.jpg\",{\"_211\":292,\"_261\":293},{\"_211\":290,\"_261\":291},\"lOama9y_ZADSwAV0z4FaT\",\"https://static-assets.oen.tw/images/img-3Ef00kgh8XMPcI5Vhg3BZFJz8hi.png\",\"uOIJeNWC20M00-rDAIsa3\",\"https://static-assets.oen.tw/images/img-3EfOvXdD3mpSziAj6aUUWMGwxP1.jpg\",\"active\",\"tax\",\"taxable\",\"isMembershipActive\",\"status\",\"尚未開放\",[157,158,159,160,161,162],\"area\",\"name\",\"date\",\"pollNumber\"]\n");</script><!--$--><script>window.__reactRouterContext.streamController.close();</script><!--/$--><!--/$-->