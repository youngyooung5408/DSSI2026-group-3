	<main>
		<h1 class="hide">南方崛起 邁向國際 ｜賴瑞隆</h1>
		<section class="kv">
			<div class="kv_slash_div">
				<img src="https://www.zenolai.tw/asset/types/zenolai/img/kv/slash.png" class="kv_slash" style="top: 400px; left: -850px; animation-delay: 0.15s;">
				<img src="https://www.zenolai.tw/asset/types/zenolai/img/kv/slash.png" class="kv_slash" style="top: 0; left: -700px; animation-delay: 0.6s;">
				<img src="https://www.zenolai.tw/asset/types/zenolai/img/kv/slash.png" class="kv_slash" style="top: 450px; left: -400px; animation-delay: 0.3s;">
				<img src="https://www.zenolai.tw/asset/types/zenolai/img/kv/slash.png" class="kv_slash" style="top: 30px; left: 300px;">
				<img src="https://www.zenolai.tw/asset/types/zenolai/img/kv/slash.png" class="kv_slash" style="top: 430px; left: 450px; animation-delay: 0.45s;">
				<img src="https://www.zenolai.tw/asset/types/zenolai/img/kv/slash.png" class="kv_slash" style="top: 150px; left: 750px; animation-delay: 0.75s;">
			</div>
			<div class="kv_div">
				<img src="https://www.zenolai.tw/asset/types/zenolai/img/kv/people.png" class="kv_people">
				<img src="https://www.zenolai.tw/asset/types/zenolai/img/kv/slogan_1.png" class="kv_text_1">
				<img src="https://www.zenolai.tw/asset/types/zenolai/img/kv/slogan_2.png" class="kv_text_2">
				<img src="https://www.zenolai.tw/asset/types/zenolai/img/kv/slogan_3.png" class="kv_text_3">
				<img src="https://www.zenolai.tw/asset/types/zenolai/img/kv/slogan_4.png" class="kv_text_4">
				<img src="https://www.zenolai.tw/asset/types/zenolai/img/kv/slogan_en_1.png" class="kv_text_en_1">
				<img src="https://www.zenolai.tw/asset/types/zenolai/img/kv/slogan_en_2.png" class="kv_text_en_2">
			</div>
