<script>
document.addEventListener('DOMContentLoaded', function () {
document.querySelectorAll('.gs_logo_container a[href]').forEach(function (a) {
try {
var url = new URL(a.href);
if (url.hostname && url.hostname !== location.hostname) {
a.setAttribute('target', '_blank');
a.setAttribute('rel', 'noopener noreferrer');
}
} catch (e) {}
});
});
</script>
<style class="wpcode-css-snippet">/* 只有桌面版首頁隱藏 Header，平板與手機保留 */
@media (min-width: 1025px) { /* 桌面版起點，一般 Kadence 1025px 以上是桌面 */
.home .site-header {
display: none;
}
}
</style><style class="wpcode-css-snippet">/* ＝＝＝＝＝ 手機：僅彙整頁 95% + 單欄，不影響內文「閱讀更多」區 ＝＝＝＝＝ */
@media (max-width: 768px) {
/* A. 文章彙整頁：容器 95%（僅限 blog/archive） */
body.blog .content-container.site-container,
body.archive .content-container.site-container,
body.post-type-archive .content-container.site-container,
body.blog #main,
body.archive #main,
body.post-type-archive #main,
body.blog #archive-container,
body.archive #archive-container,
body.post-type-archive #archive-container {
width: 95% !important;
max-width: 100% !important;
margin-left: auto !important;
margin-right: auto !important;
padding-left: 0 !important;
padding-right: 0 !important;
box-sizing: border-box !important;
}
/* B. 彙整頁文章列表：強制單欄（只鎖 #archive-container） */
body.blog  #archive-container.kadence-posts-list,
body.archive  #archive-container.kadence-posts-list,
body.post-type-archive #archive-container.kadence-posts-list {
display: grid !important;
grid-template-columns: 1fr !important;
grid-auto-flow: row !important;
}
/* 列表每一項撐滿寬 */
#archive-container .entry-list-item,
#archive-container article.entry,
#archive-container .entry-content-wrap {
width: 100% !important;
}
/* 圖片撐滿卡片 */
#archive-container .post-thumbnail,
#archive-container .post-thumbnail-inner,
#archive-container .kadence-archive-image {
width: 100% !important;
height: auto !important;
}
/* ＝＝＝＝＝ 單篇文章頁：內文 95%，但封面圖 100vw 滿版 ＝＝＝＝＝ */
/* 1) 單篇內文容器 95% */
body.single-post .content-container.site-container,
body.single-post .site-main,
body.single-post .entry-content {
width: 95% !important;
max-width: 100% !important;
margin-left: auto !important;
margin-right: auto !important;
padding-left: 0 !important;
padding-right: 0 !important;
box-sizing: border-box !important;
}
/* 2) 單篇封面圖 Full-Bleed（不吃左右白框，滿版到螢幕邊） */
/* 覆蓋 Kadence 可能出現的幾種封面容器寫法 */
body.single-post .entry-hero,
body.single-post .wp-block-post-featured-image,
body.single-post .featured-image,
body.single-post .post-thumbnail,
body.single-post .entry-hero .kadence-hero-align,
body.single-post .entry-hero .kadence-cover {
width: 100vw !important;
max-width: 100vw !important;
margin-left: 50% !important;
transform: translateX(-50%) !important; /* 從 95% 容器中「跳出」置中對齊 */
border-radius: 0 !important;
}
/* 圖片本身鋪滿容器、移除間隙 */
body.single-post .entry-hero img,
body.single-post .wp-block-post-featured-image img,
body.single-post .featured-image img,
body.single-post .post-thumbnail img {
width: 100% !important;
height: auto !important;
display: block !important;
}
/* ＝＝＝＝＝ C. 單篇頁底部「閱讀更多」：卡片封面圖回歸卡片寬，不受滿版規則影響 ＝＝＝＝＝ */
/* 只在 .entry-related 區塊底下還原，避免影響單篇頂部封面與彙整頁 */
/* 封面容器回到卡片寬 */
body.single-post .entry-related .post-thumbnail,
body.single-post .entry-related .post-thumbnail-inner,
body.single-post .entry-related .kadence-thumbnail-ratio-5-4,
body.single-post .entry-related .kb-posts-image,
body.single-post .entry-related .wp-block-kadence-posts .kb-posts-image {
width: 100% !important;
max-width: 100% !important;
margin-left: 0 !important;
transform: none !important;
border-radius: inherit !important;
overflow: hidden !important; /* 避免圖片外溢 */
}
/* 圖片本身填滿卡片（維持裁切一致） */
body.single-post .entry-related .post-thumbnail img,
body.single-post .entry-related .kb-posts-image img,
body.single-post .entry-related .wp-post-image,
body.single-post .entry-related .post-thumbnail-inner img {
width: 100% !important;
max-width: 100% !important;
height: auto !important;
display: block !important;
object-fit: cover !important;
}
}
</style><script>document.addEventListener("DOMContentLoaded", function () {
const archiveHeader = document.querySelector("header.entry-header.post-archive-title");
if (archiveHeader) {
const h1 = archiveHeader.querySelector("h1");
if (!h1) return;
// 清空原本 H1 文字
h1.textContent = "";
// 建立 img 元素
const img = document.createElement("img");
img.src = "https://t-ziwei.com/wp-content/uploads/2025/10/newbanner.webp";
   img.style.height = "60px";      // 高度固定 60px
img.style.width = "auto";       // 寬度自動保持比例
img.style.display = "block";
img.style.margin = "0 auto";    // 水平置中
// 加入到 H1 裡面
h1.appendChild(img);
}
});
</script>
