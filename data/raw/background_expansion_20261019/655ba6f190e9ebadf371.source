/* ========== 單篇頁：閱讀更多/相關文章 容器固定 4:5 ========== */
.single-post .kadence-related-posts .post-thumbnail-inner,
.single-post .related-posts .post-thumbnail-inner,
.single-post .entry-related .post-thumbnail-inner,
.single-post .kadence-posts .post-thumbnail-inner,
.single-post .wp-block-kadence-posts .post-thumbnail-inner {
width: 100%;
aspect-ratio: 4 / 5;
overflow: hidden;
background: #fff;
display: flex;
align-items: center;
justify-content: center;
}
/* ========== 若是 <img>：強制 contain，避免四邊裁切 ========== */
.single-post .kadence-related-posts .post-thumbnail-inner img,
.single-post .related-posts .post-thumbnail-inner img,
.single-post .entry-related .post-thumbnail-inner img,
.single-post .kadence-posts .post-thumbnail-inner img,
.single-post .wp-block-kadence-posts .post-thumbnail-inner img {
width: 100% !important;
height: 100% !important;
object-fit: contain !important;
object-position: center center !important;
transform: none !important;
filter: none !important;
max-width: 100% !important;
}
/* ========== 若主題/區塊用背景圖：把 cover 改成 contain（這是你現在「四邊被裁」的主要來源之一） ========== */
.single-post .kadence-related-posts [style*="background-image"],
.single-post .related-posts [style*="background-image"],
.single-post .entry-related [style*="background-image"],
.single-post .kadence-posts [style*="background-image"],
.single-post .wp-block-kadence-posts [style*="background-image"] {
background-size: contain !important;
background-position: center center !important;
background-repeat: no-repeat !important;
}
</style>
