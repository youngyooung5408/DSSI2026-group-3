<style>
/* ========================================
整體
======================================== */
.tk-shop-showcase {
width: 100%;
max-width: 700px;
margin: 0 auto;
}
/* ========================================
商品圖片區
======================================== */
.tk-shop-images {
display: grid;
grid-template-columns: repeat(2, minmax(0, 1fr));
gap: 22px;
width: 100%;
}
/* ========================================
單一商品
======================================== */
.tk-shop-card {
position: relative;
display: block;
width: 100%;
aspect-ratio: 1 / 1;
overflow: hidden;
text-decoration: none !important;
transition:
transform 0.35s cubic-bezier(.22,.61,.36,1),
box-shadow 0.35s ease;
}
/* ========================================
商品圖片
======================================== */
.tk-shop-card img {
display: block;
width: 100%;
height: 100%;
object-fit: cover;
transition:
transform 0.45s cubic-bezier(.22,.61,.36,1);
}
/* ========================================
桌機 Hover
======================================== */
@media (min-width: 1025px) {
.tk-shop-card:hover {
transform: translateY(-5px);
box-shadow:
0 12px 28px rgba(0, 0, 0, 0.10);
}
.tk-shop-card:hover img {
transform: scale(1.025);
}
}
/* ========================================
前往商城
======================================== */
.tk-shop-button {
display: flex;
align-items: center;
justify-content: center;
width: 100%;
height: 58px;
margin: 28px auto 0;
padding: 0 24px;
box-sizing: border-box;
background: transparent;
color: #3ba6a8 !important;
border: 2px solid #83c7c8;
border-radius: 10px;
font-size: 20px;
font-weight: 700;
line-height: 1;
letter-spacing: 0.02em;
text-decoration: none !important;
transition:
background-color 0.25s ease,
border-color 0.25s ease,
color 0.25s ease;
}
/* 按鈕 Hover */
.tk-shop-button:hover {
background: rgba(59, 166, 168, 0.07);
border-color: #3ba6a8;
color: #258f92 !important;
}
/* ========================================
平板
======================================== */
@media (max-width: 1024px) {
.tk-shop-card,
.tk-shop-card:hover {
transform: none;
box-shadow: none;
}
.tk-shop-card img,
.tk-shop-card:hover img {
transform: none;
}
}
/* ========================================
手機
======================================== */
@media (max-width: 767px) {
.tk-shop-images {
grid-template-columns: 1fr;
gap: 18px;
}
.tk-shop-button {
height: 54px;
margin-top: 22px;
font-size: 18px;
border-radius: 9px;
}
}
</style>				</div>
