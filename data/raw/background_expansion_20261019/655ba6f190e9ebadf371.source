<style>
/* ===== 區塊基礎設定 ===== */
.local-section{
background-color:#F2F2F2;
padding:70px 0 80px;
font-family:"Roboto",system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
}
/* 上方標題 */
.local-section-header{ text-align:center; margin-bottom:28px; }
.local-section-title{
margin:0; font-size:36px; color:#444; font-weight:600; letter-spacing:.05em;
}
.local-section-subtitle{
margin:2px 0 0; font-size:16px; color:#444; font-weight:400;
}
/* 內容兩欄 */
.local-inner{
max-width:1200px; margin:0 auto;
display:flex; gap:50px;
align-items:center; justify-content:center;
padding:0 20px;
}
.local-map{ flex:0 0 52%; }
.local-word{ flex:0 0 48%; }
/* ===== 地圖 ===== */
.local-map-svg{
width:100%; height:auto;
background:transparent; padding:0;
border-radius:0; box-shadow:none; filter:none;
}
.local-region{ cursor:pointer; }
.local-region-shape{
fill:#ffffff;
stroke:#D0D0D0;
stroke-width:2;
transition:fill .2s ease, stroke .2s ease;
}
/* 區名文字：JS 會自動塞 x/y；這裡負責置中與樣式 */
.local-region-label{
font-size:16px;
text-anchor:middle;
dominant-baseline:middle;
fill:#A0A0A0;
font-weight:600;
pointer-events:none;
transition:fill .2s ease, paint-order .2s ease, stroke .2s ease, stroke-width .2s ease;
}
.local-region:hover .local-region-shape,
.local-region.is-active .local-region-shape{
fill:#F5B1BC;
stroke:#EB6878;
}
.local-region:hover .local-region-label,
.local-region.is-active .local-region-label{
fill:#EB6878;
stroke:#ffffff;
stroke-width:2px;
paint-order:stroke;
}
/* ===== 右側 slider ===== */
.local-slider{
display:flex;
align-items:flex-start;
gap:12px;
margin-bottom:24px;
}
.local-slider-arrow{
border:none; background:transparent;
font-size:28px; line-height:1;
cursor:pointer;
width:28px; height:28px;
display:flex; align-items:center; justify-content:center;
color:#C0C0C0;
transition:color .2s ease, transform .1s ease;
outline:none;
-webkit-tap-highlight-color:transparent;
margin-top:4px;
}
.local-slider-arrow:hover,
.local-slider-arrow:focus,
.local-slider-arrow:active{
color:#EB6878;
background:transparent;
border:none;
outline:none;
box-shadow:none;
transform:translateY(-1px);
}
.local-slides-wrapper{ overflow:hidden; flex:1; }
.local-slides{ display:flex; transition:transform .3s ease; }
.local-slide{ min-width:100%; box-sizing:border-box; padding:4px 0; }
.local-slide-header{
display:flex; align-items:center; gap:10px;
margin-bottom:8px;
}
.local-pin-icon{
display:inline-block;
width:32px; height:32px;
background:transparent url('https://t-ziwei.com/wp-content/uploads/2025/12/red_icon.svg') no-repeat center center;
background-size:contain;
}
.local-slide-title{
margin:0;
font-size:28px;
color:#EB6878;
font-weight:800;
letter-spacing:.15em;
}
/* 一次看全區按鈕 */
.local-all-btn{
padding:8px 22px;
background:#fff;
border-radius:3px;
border:1px solid #ddd;
font-size:13px;
color:#777;
text-decoration:none;
transition:all .2s ease;
box-shadow:0 5px 12px rgba(0,0,0,.04);
margin:14px auto 0;
display:block;
width:fit-content;
}
.local-all-btn:hover{
background:#EB6878;
border-color:#EB6878;
color:#fff;
}
/* ===== RWD ===== */
@media (max-width:991px){
.local-inner{ flex-direction:column; gap:32px; }
.local-map, .local-word{
flex:0 0 auto;
width:95%;
max-width:640px;
margin:0 auto;
}
.local-section-title{ font-size:30px; }
.local-slide-title{ font-size:24px; }
}
/* ===== 標題與小標：對齊 Elementor（h2 + text-editor strong） ===== */
.local-section .local-section-header{
text-align: center;
margin-bottom: 28px;
}
.local-section .local-section-title{
margin: 0;
font-family: inherit;
font-size: 36px;
font-weight: 600;
line-height: 1.2;
color: inherit;
letter-spacing: 0;
}
.local-section .local-section-subtitle{
margin: 6px 0 0;
font-family: inherit;
font-size: 16px;
line-height: 1.6;
color: inherit;
font-weight: 700;
}
.local-section .local-section-subtitle strong{
font-weight: 700;
}
/* ===== 桌機：icon+h3 與圖片同中線置中 + 圖片等比例 80% ===== */
.local-slide-header{
justify-content:center;
width:80%;
margin:0 auto 10px;
}
.local-slide-image{
width:80%;
height:auto;
display:block;
margin:0 auto;
}
/* ===== 手機：隱藏箭頭 + 改成滑動 + 圖片滿版 100% ===== */
@media (max-width:768px){
.local-slider-arrow{ display:none; }      /* 隱藏左右箭頭 */
.local-slide-header{ width:100%; }        /* 標題滿版 */
.local-slide-image{ width:100%; }         /* 圖片滿版（100%） */
/* 滑動手感與避免水平滑動被瀏覽器誤判 */
.local-slides-wrapper{
touch-action: pan-y; /* 允許垂直滾動，水平交給我們的 swipe */
}
.local-slides{ transition:transform .25s ease; }
}
</style>
<script>
/* ===== JS：同步地圖與 slider + 自動置中地圖區名 + 手機滑動 ===== */
(function () {
const districts = ["zz", "zs", "al", "ra", "xy", "qd", "nn"];
const mapRegions = document.querySelectorAll(".local-region");
const slidesContainer = document.querySelector(".local-slides");
const slidesWrapper = document.querySelector(".local-slides-wrapper");
const prevBtn = document.querySelector(".local-slider-prev");
const nextBtn = document.querySelector(".local-slider-next");
let currentIndex = 0;
function setActiveDistrict(districtId) {
const index = districts.indexOf(districtId);
if (index === -1) return;
currentIndex = index;
mapRegions.forEach(r => {
r.classList.toggle("is-active", r.dataset.district === districtId);
});
const offset = -100 * index;
if (slidesContainer) slidesContainer.style.transform = "translateX(" + offset + "%)";
}
/* 地圖點擊切換 slide */
mapRegions.forEach(region => {
region.addEventListener("click", function () {
setActiveDistrict(region.dataset.district);
});
});
function gotoPrev() {
const newIndex = (currentIndex - 1 + districts.length) % districts.length;
setActiveDistrict(districts[newIndex]);
}
function gotoNext() {
const newIndex = (currentIndex + 1) % districts.length;
setActiveDistrict(districts[newIndex]);
}
if (prevBtn) prevBtn.addEventListener("click", gotoPrev);
if (nextBtn) nextBtn.addEventListener("click", gotoNext);
/* ===== 解法B：自動把每個區名放到該區塊(所有 shape)的幾何中心 ===== */
function positionMapLabels() {
mapRegions.forEach(region => {
const label = region.querySelector(".local-region-label");
if (!label) return;
const shapes = region.querySelectorAll(".local-region-shape");
if (!shapes.length) return;
let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
shapes.forEach(el => {
const b = el.getBBox();
minX = Math.min(minX, b.x);
minY = Math.min(minY, b.y);
maxX = Math.max(maxX, b.x + b.width);
maxY = Math.max(maxY, b.y + b.height);
});
const cx = (minX + maxX) / 2;
const cy = (minY + maxY) / 2;
label.setAttribute("x", cx);
label.setAttribute("y", cy);
});
}
positionMapLabels();
window.addEventListener("resize", positionMapLabels);
/* ===== 手機：左右滑動切換（swipe） ===== */
let startX = 0;
let startY = 0;
let isTracking = false;
function isMobile() {
return window.matchMedia && window.matchMedia("(max-width: 768px)").matches;
}
if (slidesWrapper) {
slidesWrapper.addEventListener("touchstart", function (e) {
if (!isMobile()) return;
const t = e.touches[0];
startX = t.clientX;
startY = t.clientY;
isTracking = true;
}, { passive: true });
slidesWrapper.addEventListener("touchend", function (e) {
if (!isMobile() || !isTracking) return;
isTracking = false;
const t = e.changedTouches[0];
const dx = t.clientX - startX;
const dy = t.clientY - startY;
/* 避免上下滑動頁面時誤觸發 */
if (Math.abs(dx) < 50) return;
if (Math.abs(dx) < Math.abs(dy)) return;
if (dx > 0) gotoPrev();
else gotoNext();
}, { passive: true });
}
/* 初始狀態：中正區 */
setActiveDistrict("zz");
})();
</script>
</div>
</div>
</div>
</div>
