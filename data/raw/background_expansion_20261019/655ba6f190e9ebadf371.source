<button
type="button"
class="tk-donation-notice-link"
id="tkDonationNoticeOpen"
>
捐贈者應注意事項
</button>
</div>
<!-- ========================================
注意事項彈跳視窗
======================================== -->
<div
class="tk-donation-modal"
id="tkDonationModal"
aria-hidden="true"
>
<div
class="tk-donation-dialog"
role="dialog"
aria-modal="true"
aria-labelledby="tkDonationModalTitle"
>
<div class="tk-donation-modal-head">
<h3 id="tkDonationModalTitle">
捐贈者應注意事項
</h3>
</div>
<div
class="tk-donation-modal-content"
id="tkDonationModalContent"
>
<p class="tk-notice-main-title">
政黨捐款說明：
</p>
<p>
一、捐款人必須為本國國民且具有選舉權。
</p>
<p>
二、以個人名義捐款，請註明捐款人姓名、身分證字號、地址(含戶籍地址與收件人地址以便寄發收據)、電話。
</p>
<p>
三、任何人不得以本人以外之名義捐贈或匿名捐贈不得超過新臺幣1萬元。
</p>
<p>
四、超過新臺幣10萬元之現金捐贈，應以支票或經由金融機構匯款為之。(政治獻金法第14條)
</p>
<p>
五、個人對同一擬參選人每年捐贈總額，不得超過新臺幣10萬；對同一政黨每年捐款總額，不得超過新臺幣30萬元，抵稅額上限為新臺幣20萬元。
</p>
<p>
六、在下列機關團體，擔任本國團體或法人之董事長職務，或占本國團體或法人之董事、監察人、執行業務或代表公司之股東等各項職務總名額超過三分之一以上者，或占股份有限公司之股權百分之三十以上或無限公司、兩合公司、有限公司之股東及一般法人、團體之社員人數超過三分之一以上者。不得捐贈。
</p>
<p class="tk-notice-sub">
1. 外國人民、法人、團體或其他機構，或主要成員為外國人民、法人、團體或其他機構之法人、團體或其他機構。
</p>
<p class="tk-notice-sub">
2. 大陸地區人民、法人、團體或其他機構，或主要成員為大陸地區人民、法人、團體或其他機構之法人、團體或其他機構。
</p>
<p class="tk-notice-sub">
3. 香港、澳門居民、法人、團體或其他機構，或主要成員為香港、澳門居民、法人、團體或其他機構之法人、團體或其他機構。
</p>
<p>
其他規定請參閱政治獻金法或監察院網站。
</p>
<p>
如有任何疑問，請洽競選辦公室。
</p>
<p class="tk-notice-contact-title">
服務地址：
</p>
<p class="tk-notice-contact-text">
基隆市仁愛區孝一路23巷3弄3號
</p>
<p class="tk-notice-contact-title">
服務電話：
</p>
<p class="tk-notice-contact-text">
聯絡電話：(02)2428-6767
</p>
<p class="tk-notice-contact-text">
傳真號碼：(02)2428-6767
</p>
</div>
<div class="tk-donation-modal-footer">
<div
class="tk-donation-scroll-tip"
id="tkDonationScrollTip"
>
請閱讀完整注意事項並滑至最下方
</div>
<button
type="button"
class="tk-donation-agree"
id="tkDonationAgree"
disabled
>
我同意注意事項
</button>
</div>
</div>
</div>
<script>
(function () {
const openButton =
document.getElementById('tkDonationNoticeOpen');
const modal =
document.getElementById('tkDonationModal');
const content =
document.getElementById('tkDonationModalContent');
const agreeButton =
document.getElementById('tkDonationAgree');
const scrollTip =
document.getElementById('tkDonationScrollTip');
if (
!openButton ||
!modal ||
!content ||
!agreeButton ||
!scrollTip
) {
return;
}
/* ========================================
開啟視窗
======================================== */
function openModal() {
modal.classList.add('is-open');
modal.setAttribute(
'aria-hidden',
'false'
);
document.body.style.overflow = 'hidden';
content.scrollTop = 0;
agreeButton.disabled = true;
scrollTip.textContent =
'請閱讀完整注意事項並滑至最下方';
setTimeout(function () {
checkScrollPosition();
}, 50);
}
/* ========================================
關閉視窗
======================================== */
function closeModal() {
modal.classList.remove('is-open');
modal.setAttribute(
'aria-hidden',
'true'
);
document.body.style.overflow = '';
}
/* ========================================
判斷是否滑到底部
======================================== */
function checkScrollPosition() {
const distanceToBottom =
content.scrollHeight
- content.scrollTop
- content.clientHeight;
if (distanceToBottom <= 8) {
agreeButton.disabled = false;
scrollTip.textContent =
'已閱讀至最下方，請點選我同意注意事項';
}
}
/* ========================================
開啟
======================================== */
openButton.addEventListener(
'click',
function () {
openModal();
}
);
/* ========================================
滾動判斷
======================================== */
content.addEventListener(
'scroll',
function () {
checkScrollPosition();
}
);
/* ========================================
按下同意後關閉
======================================== */
agreeButton.addEventListener(
'click',
function () {
if (agreeButton.disabled) {
return;
}
closeModal();
}
);
/* ========================================
禁止點背景關閉
======================================== */
modal.addEventListener(
'click',
function (event) {
if (event.target === modal) {
event.preventDefault();
event.stopPropagation();
}
}
);
/* ========================================
禁止 ESC 關閉
======================================== */
document.addEventListener(
'keydown',
function (event) {
if (
event.key === 'Escape' &&
modal.classList.contains('is-open')
) {
event.preventDefault();
event.stopPropagation();
}
}
);
})();
</script>				</div>
</div>
</div>
</div>
