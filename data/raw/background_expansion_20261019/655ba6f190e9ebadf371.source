</style>
<script>
(function () {
const wrap =
document.getElementById(
"tk-donation-855858"            );
if (!wrap) {
return;
}
const form =
wrap.querySelector(
'.tk-newebpay-form'
);
const amountButtons =
wrap.querySelectorAll(
'.tk-donation-amount'
);
const customInput =
wrap.querySelector(
'.tk-donation-custom-input'
);
const customSubmit =
wrap.querySelector(
'.tk-donation-submit'
);
function resetDonationBlock() {
window.setTimeout(
function () {
customInput.value = '';
form.reset();
setLoading(
false
);
},
500
);
}
function setLoading(
loading
) {
amountButtons.forEach(
function (button) {
button.disabled =
loading;
}
);
customSubmit.disabled =
loading;
}
async function submitDonation(
amount
) {
amount =
parseInt(
amount,
10
);
if (
!Number.isInteger(
amount
) ||
amount < 1 ||
amount > 999999
) {
alert(
'請輸入正確的捐款金額'
);
return;
}
setLoading(
true
);
try {
const body =
new URLSearchParams();
body.append(
'action',
'tk_create_newebpay_donation'
);
body.append(
'amount',
amount
);
const response =
await fetch(
"https:\/\/t-ziwei.com\/wp-admin\/admin-ajax.php",
{
method:
'POST',
headers: {
'Content-Type':
'application/x-www-form-urlencoded; charset=UTF-8'
},
credentials:
'same-origin',
body:
body.toString()
}
);
const result =
await response.json();
if (
!result.success ||
!result.data
) {
throw new Error(
result.data &&
result.data.message
? result.data.message
: '無法建立捐款交易'
);
}
const data =
result.data;
/*
* 將 PHP 真正產生的資料
* 全部填入藍新 Form
*/
const fields = [
'MerchantID',
'RespondType',
'CheckValue',
'TimeStamp',
'Version',
'MerchantOrderNo',
'ItemDesc',
'Amt',
'NotifyURL',
'Templates',
'CREDIT',
'WEBATM',
'VACC',
'CVS',
'BARCODE',
'LangType'
];
fields.forEach(
function (name) {
if (
form.elements[
name
] &&
data[
name
] !== undefined
) {
form.elements[
name
].value =
data[
name
];
}
}
);
/*
* 真正 POST 到藍新
*
* Debug 已經在 PHP 儲存完成，
* 不需要再攔截 submit。
*/
form.submit();
/*
* 藍新付款頁已在新分頁送出後，
* 只重設原網站的捐款區塊。
*/
resetDonationBlock();
}
catch (error) {
console.error(
'[TK NewebPay]',
error
);
alert(
error.message ||
'目前無法前往捐款頁面，請稍後再試。'
);
setLoading(
false
);
}
}
amountButtons.forEach(
function (button) {
button.addEventListener(
'click',
function () {
submitDonation(
this.dataset.amount
);
}
);
}
);
customSubmit.addEventListener(
'click',
function () {
submitDonation(
customInput.value
);
}
);
customInput.addEventListener(
'keydown',
function (event) {
if (
event.key ===
'Enter'
) {
event.preventDefault();
submitDonation(
customInput.value
);
}
}
);
})();
</script>
</div>
</div>
</div>
