<div class="elementor-element elementor-element-a73baec e-flex e-con-boxed e-con e-parent" data-id="a73baec" data-element_type="container" data-e-type="container" data-settings="{&quot;background_background&quot;:&quot;gradient&quot;}">
<div class="e-con-inner">
<div class="elementor-element elementor-element-528e7b1 elementor-widget elementor-widget-heading" data-id="528e7b1" data-element_type="widget" data-e-type="widget" data-widget_type="heading.default">
<div class="elementor-widget-container">
<h2 class="elementor-heading-title elementor-size-default">領域政見</h2>				</div>
</div>
<div class="elementor-element elementor-element-77cfb45 elementor-widget elementor-widget-text-editor" data-id="77cfb45" data-element_type="widget" data-e-type="widget" data-widget_type="text-editor.default">
<div class="elementor-widget-container">
<p><strong>Issue-based platform</strong></p>								</div>
</div>
<div class="elementor-element elementor-element-2368c24 elementor-widget__width-initial elementor-widget elementor-widget-shortcode" data-id="2368c24" data-element_type="widget" data-e-type="widget" data-widget_type="shortcode.default">
<div class="elementor-widget-container">
<div class="elementor-shortcode">
<style>
.tk-policy-section{
width:100%;
padding:60px 20px 50px;
background:transparent;
}
.tk-policy-grid{
max-width:1400px;
margin:0 auto;
display:grid;
grid-template-columns:repeat(3,1fr);
gap:36px;
align-items:stretch;
}
.tk-policy-card{
display:flex;
flex-direction:column;
overflow:hidden;
border-radius:18px;
background:#fff;
text-decoration:none;
color:#111;
transition:transform .3s ease, box-shadow .3s ease;
height:100%;
}
.tk-policy-card:hover{
transform:translateY(-6px);
box-shadow:0 14px 30px rgba(0,0,0,.15);
}
.tk-policy-image{
width:100%;
height:230px;
overflow:hidden;
background:#eee;
}
.tk-policy-image img{
width:100%;
height:100%;
object-fit:cover;
object-position:center;
display:block;
}
.tk-policy-content{
padding:26px 28px 22px;
display:flex;
flex-direction:column;
flex:1;
}
.tk-policy-title{
margin:0 0 22px;
font-size:22px;
line-height:1.4;
font-weight:700;
color:#111;
}
.tk-policy-desc{
margin:0;
font-size:17px;
line-height:1.85;
color:#555;
letter-spacing:.03em;
}
.tk-policy-more{
margin-top:auto;
padding-top:36px;
text-align:center;
font-size:14px;
letter-spacing:.08em;
color:#666;
}
@media (max-width:1024px){
.tk-policy-grid{
grid-template-columns:repeat(2,1fr);
}
}
