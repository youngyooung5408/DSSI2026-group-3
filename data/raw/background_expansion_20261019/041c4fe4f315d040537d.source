<style data-type="vc_custom-css">/* 1. 同時載入思源黑體與思源宋體 (皆載入 400, 500, 700 字重) */
@import url('https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@300;400;500;700&family=Noto+Serif+TC:wght@400;500;700&display=swap');

/* 2. 內文：優先使用思源黑體 (Noto Sans TC)，接著才是蘋果系統字型 */
body {
  font-family: "Noto Sans TC", -apple-system, BlinkMacSystemFont, "PingFang TC", "Helvetica Neue", sans-serif;
    font-weight: 300;
}

/* 3. 標題：強制 H1 與 H2 使用思源宋體 */
h1, h2, h3, h4 {
  font-family: 'Noto Serif TC', serif;
  font-weight: 700;
}

.nectar-flickity[data-control-style=material_pagination] .flickity-page-dots  {
    bottom: -5px;
}

@media only screen and (max-width: 1000px){
.nectar-flickity.nectar-carousel:not(.masonry).tb-spacing-0 .flickity-page-dots {
    bottom: -5px;
}
}

