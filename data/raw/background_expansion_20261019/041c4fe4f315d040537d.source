			<div class="img-with-aniamtion-wrap center margin_bottom_tablet_5pct margin_bottom_phone_5pct margin_left_tablet_0px margin_left_phone_0px custom-width-85pct custom-width-tablet-100pct custom-width-phone-100pct " data-max-width="custom" data-max-width-mobile="default" data-shadow="none" data-animation="none"  style="margin-left: -10%;">
      <div class="inner">
        <div class="hover-wrap"> 
          <div class="hover-wrap-inner">
            <img decoding="async" class="img-with-animation skip-lazy" data-delay="0" height="600" width="600" data-animation="none" src="https://www.shesinging.tw/wp-content/uploads/2023/04/運動健將600.jpg" alt="徐欣瑩｜新竹縣第一選區立法委參選人｜從小就是運動健將" srcset="https://www.shesinging.tw/wp-content/uploads/2023/04/運動健將600.jpg 600w, https://www.shesinging.tw/wp-content/uploads/2023/04/運動健將600-300x300.jpg 300w, https://www.shesinging.tw/wp-content/uploads/2023/04/運動健將600-150x150.jpg 150w, https://www.shesinging.tw/wp-content/uploads/2023/04/運動健將600-100x100.jpg 100w, https://www.shesinging.tw/wp-content/uploads/2023/04/運動健將600-140x140.jpg 140w, https://www.shesinging.tw/wp-content/uploads/2023/04/運動健將600-500x500.jpg 500w, https://www.shesinging.tw/wp-content/uploads/2023/04/運動健將600-350x350.jpg 350w" sizes="(max-width: 600px) 100vw, 600px" />
