<!-- 回頂端按鈕 -->
<a href="#" class="scroll-up"><i class="fa-solid fa-arrow-up"></i></a><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<!-- 載入 jQuery (Bootstrap 5 不含 jQuery，要自己加) -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script>
$(function () {
    $(window).scroll(function () {
        if ($(this).scrollTop() > 100) {
            $('.scroll-up').fadeIn();
        } else {
            $('.scroll-up').fadeOut();
        }
    });

    $('.scroll-up').click(function (e) {
        e.preventDefault();
        $("html, body").animate({ scrollTop: 0 }, 600);
    });
});
	
/*手動初始化 carousel，確保左右箭頭有效
document.addEventListener('DOMContentLoaded', function() {
    var myCarousel = document.querySelector('#bannerCarousel');
    var carousel = new bootstrap.Carousel(myCarousel, {
        interval: 5000,
        ride: 'carousel'
    });
});	*/
</script>
