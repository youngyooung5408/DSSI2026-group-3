s="ma-item"><b>'+it.t+"</b><p>"+it.d+"</p></div>"}).join("")+(a.cards.length?'<div class="ma-cards"><span class="mp-mono ma-cn">已公開政見 · '+a.cards.length+" 則</span>"+a.cards.map(function(ci){var c=PCARDS[ci];if(!c)return"";return'<button class="ma-card" type="button" data-i="'+ci+'">'+'<span class="ma-card-tag">'+c.tag+"</span>"+'<span class="ma-card-t">'+c.title+"</span>"+"<i>→</i></button>"}).join("")+"</div>":"")+"</div>";return'<div class="ma'+(open?" open":"")+'" style="--tc:'+a.tc+'">'+'<button class="ma-head" type="button" data-i="'+i+'">'+'<span class="ma-line"></span>'+'<span class="ma-t"><b><i class="ma-no">'+a.no+"</i>"+a.nm+"</b><span>"+a.sl+"</span></span>"+'<span class="ma-ind">'+(open?"－":"＋")+"</span>"+"</button>"+inner+"</div>"}).join("")}var sheetEl=document.getElementById("mp-sheet");var sheetBody=document.getElementById("mp-sheet-body");var sheetKick=document.getElementById("mp-sheet-kick");function bookSheet(i){var b=FPB_BOOKS[i];sheetKick.textContent="未來存摺 · 第 "+b.n+" 本 / 12";sheetBody.innerHTML='<span class="ms-stage">人生階段・'+b.stage+"</span>"+'<h3 class="ms-nm">'+b.nm+"</h3>"+'<p class="ms-sl">'+b.sl+"</p>"+'<div class="ms-box"><span class="ms-box-t">解決什麼問題</span><p>'+b.why+"</p></div>"+'<div class="ms-box hl"><span class="ms-box-t">你會得到什麼</span><p>'+b.get+"</p></div>"+'<div class="ms-lg"><span class="mp-mono">存入明細 DEPOSIT</span><span class="mp-mono">金額</span></div>'+b.rows.map(function(r){var amt=r.est?'<span class="ms-amt-txt">'+r.amt+"</span>":'<b class="ms-amt">'+r.amt+"</b>"+(r.unit?'<span class="ms-unit">'+r.unit+"</span>":"");return'<div class="ms-row"><span class="ms-it"><b>'+r.it+"</b><span>"+r.sub+"</span></span>"+'<span class="ms-val">'+amt+"</span></div>"}).join("")+'<div class="ms-obj"><span class="mp-mono">戶名</span>'+b.obj+"</div>"+'<div class="ms-navs"><button type="button" class="ms-nav" data-d="-1">‹ 上一本</button><button type="button" class="ms-nav" data-d="1">下一本 ›</button></div>'+'<p class="mp-mono ms-foot">HUALIEN COUNTY · A LIFETIME OF SUPPORT　'+b.n+" / 12</p>"}function policySheet(i){var c=PCARDS[i];sheetKick.textContent="完整施政藍圖";var src=document.getElementById("pd-d-"+c.id);sheetBody.innerHTML='<span class="ms-stage">'+c.tag+"</span>"+'<h3 class="ms-nm sm">'+c.title+"</h3>"+'<p class="ms-sl">'+c.lead+"</p>"+'<div class="ms-rich">'+(src?src.innerHTML:"")+"</div>";["pd-d-cat","pd-tag","pd-d-title","pd-d-lead"].forEach(function(k){var n=sheetBody.querySelector(".ms-rich ."+k);while(n){n.remove();n=sheetBody.querySelector(".ms-rich ."+k)}})}function openSheet(kind,i){sheet={kind:kind,i:i};if(kind==="book")bookSheet(i);else policySheet(i);sheetEl.hidden=false;document.body.style.overflow="hidden";sheetEl.querySelector(".mp-sheet-box").scrollTop=0}function closeSheet(){sheet=null;sheetEl.hidden=true;document.body.style.overflow=""}sheetEl.addEventListener("click",function(e){if(e.target.closest("[data-close]")){closeSheet();return}var nav=e.target.closest(".ms-nav");if(nav&&sheet&&sheet.kind==="book"){var t=(sheet.i+ +nav.getAttribute("data-d")+FPB_BOOKS.length)%FPB_BOOKS.length;sheet.i=t;bookSheet(t);sheetEl.querySelector(".mp-sheet-box").scrollTop=0;rail.scrollTo({left:t*step(),behavior:"auto"});syncRail()}});document.addEventListener("keydown",function(e){if(e.key==="Escape"&&sheet)closeSheet()});renderTabs();renderPanel();renderAcc();syncRail()})();var rail=document.querySelector("#policy .pd-grid");var prevBtn=document.querySelector("#policy .pd-arrow.prev");var nextBtn=document.querySelector("#policy .pd-arrow.next");function railStep(){var card=rail.querySelector(".pd-card:not(.pd-hide)");var gap=parseFloat(getComputedStyle(rail).gap)||20;return card?card.offsetWidth+gap:360}function syncArrows(){if(!prevBtn||!nextBtn)return;var max=rail.scrollWidth-rail.clientWidth-2;prevBtn.toggleAttribute("disabled",rail.scrollLeft<=2);nextBtn.toggleAttribute("disabled",rail.scrollLeft>=max)}if(rail&&prevBtn&&nextBtn){prevBtn.addEventListener("click",function(){rail.scrollBy({left:-railStep()*2,behavior:"smooth"})});nextBtn.addEventListener("click",function(){rail.scrollBy({left:railStep()*2,behavior:"smooth"})});rail.addEventListener("scroll",syncArrows,{passive:true});addEventListener("resize",syncArrows);syncArrows()}if(rail&&matchMedia("(hover: hover) and (pointer: fine)").matches){var down=false,sx=0,sl=0,moved=0;rail.addEventListener("pointerdown",function(e){down=true;moved=0;sx=e.clientX;sl=rail.scrollLeft;rail.classList.add("dragging")});rail.addEventListener("pointermove",function(e){if(!down)return;moved=Math.max(moved,Math.abs(e.clientX-sx));if(moved>6&&!rail.hasPointerCapture(e.pointerId)){rail.setPointerCapture(e.pointerId)}rail.scrollLeft=sl-(e.clientX-sx)});["pointerup","pointercancel"].forEach(function(ev){rail.addEventListener(ev,function(){down=false;rail.classList.remove("dragging")})});rail.addEventListener("click",function(e){if(moved>6){e.stopPropagation();e.preventDefault()}},true)}var newsToggle=document.querySelector(".news-toggle");if(newsToggle){newsToggle.addEventListener("click",function(){var sec=document.getElementById("news");if(sec)sec.classList.add("news-open");newsToggle.remove()})}})()</script>
    
    <script>(function(){var rail=document.querySelector("#record .rr-rail");var prevBtn=document.querySelector("#record .pd-arrow.prev");var nextBtn=document.querySelector("#record .pd-arrow.next");if(!rail||!prevBtn||!nextBtn)return;function railStep(){var card=rail.querySelector(".rr-item");var gap=parseFloat(getComputedStyle(rail).gap)||20;return card?card.offsetWidth+gap:420}function syncArrows(){var max=rail.scrollWidth-rail.clientWidth-2;prevBtn.toggleAttribute("disabled",rail.scrollLeft<=2);nextBtn.toggleAttribute("disabled",rail.scrollLeft>=max)}prevBtn.addEventListener("click",function(){rail.scrollBy({left:-railStep()*2,behavior:"smooth"})});nextBtn.addEventListener("click",function(){rail.scrollBy({left:railStep()*2,behavior:"smooth"})});rail.addEventListener("scroll",syncArrows,{passive:true});addEventListener("resize",syncArrows);syncArrows();if(matchMedia("(hover: hover) and (pointer: fine)").matches){var down=false,sx=0,sl=0,moved=0;rail.addEventListener("pointerdown",function(e){down=true;moved=0;sx=e.clientX;sl=rail.scrollLeft;rail.classList.add("dragging")});rail.addEventListener("pointermove",function(e){if(!down)return;moved=Math.max(moved,Math.abs(e.clientX-sx));if(moved>6&&!rail.hasPointerCapture(e.pointerId)){rail.setPointerCapture(e.pointerId)}rail.scrollLeft=sl-(e.clientX-sx)});["pointerup","pointercancel"].forEach(function(ev){rail.addEventListener(ev,function(){down=false;rail.classList.remove("dragging")})});rail.addEventListener("click",function(e){if(moved>6){e.stopPropagation();e.preventDefault()}},true)}})()</script>
    
    <script>(function(){var rail=document.getElementById("rr-rail");var sheet=document.getElementById("rr-sheet");if(!rail||!sheet)return;var items=[].slice.call(rail.querySelectorAll(".rr-item"));var wrap=rail.closest(".rr-wrap");var bar=document.getElementById("rr-bar");var reduce=matchMedia("(prefers-reduced-motion: reduce)").matches;function prog(){var max=rail.scrollWidth-rail.clientWidth;var w=Math.max(10,rail.clientWidth/rail.scrollWidth*100);bar.style.width=w+"%";bar.style.marginLeft=(max>0?rail.scrollLeft/max:0)*(100-w)+"%"}var nudged=false;function usedIt(){if(nudged)return;nudged=true;wrap.classList.add("rr-used")}rail.addEventListener("scroll",function(){prog();if(rail.scrollLeft>12)usedIt()},{passive:true});addEventListener("resize",prog);prog();if(!reduce&&"IntersectionObserver"in window){var io=new IntersectionObserver(function(es){es.forEach(function(e){if(!e.isIntersecting||nudged)return;io.disconnect();setTimeout(function(){if(nudged||rail.scrollLeft>4)return;rail.scrollTo({left:56,behavior:"smooth"});setTimeout(function(){if(nudged)return;rail.scrollTo({left:0,behavior:"smooth"})},620)},900)})},{threshold:.35});io.observe(wrap)}var img=document.getElementById("rr-img"),badge=document.getElementById("rr-badge"),title=document.getElementById("rr-title"),text=document.getElementById("rr-text"),count=document.getElementById("rr-count");var cur=0,lastFocus=null;function pad(n){return("0"+n).slice(-2)}function open(i){cur=(i+items.length)%items.length;var el=items[cur];var im=el.querySelector("img");img.src=im.getAttribute("src");img.alt=im.getAttribute("alt")||"";title.textContent=el.querySelector(".rr-cap b").textContent;badge.textContent=el.querySelector(".rr-cap i").textContent;text.textContent=el.querySelector(".rr-tx").textContent;count.textContent=pad(cur+1)+" / "+pad(items.length);if(sheet.hidden){lastFocus=document.activeElement;sheet.hidden=false;document.body.classList.add("rr-lock");sheet.querySelector(".rr-close").focus()}usedIt()}function close(){sheet.hidden=true;document.body.classList.remove("rr-lock");if(lastFocus&&lastFocus.focus)lastFocus.focus()}items.forEach(function(el,i){el.addEventListener("click",function(){open(i)})});sheet.addEventListener("click",function(e){if(e.target===sheet)return close();if(e.target.closest(".rr-close"))return close();if(e.target.closest(".rr-nav.prev"))return open(cur-1);if(e.target.closest(".rr-nav.next"))return open(cur+1)});document.addEventListener("keydown",function(e){if(sheet.hidden)return;if(e.key==="Escape")close();else if(e.key==="ArrowLeft")open(cur-1);else if(e.key==="ArrowRight")open(cur+1)})})()</script>
  </body>
</html>
