    <script>(function(){var p=window.__liteParams||{};var b=document.body;if(p.theme)b.setAttribute("data-theme",p.theme);if(["bright","warm","sky"].indexOf(b.getAttribute("data-theme"))>=0)b.setAttribute("data-light","1");else b.removeAttribute("data-light");if(p.accent)b.setAttribute("data-accent",p.accent);if(p.font)b.setAttribute("data-font",p.font);if(p.embed)b.classList.add("embed");(function(){var re=/\d [\u4e00-\u9fff\u2192]|[\u4e00-\u9fff\u2192] \d/;var walker=document.createTreeWalker(document.body,NodeFilter.SHOW_TEXT,{acceptNode:function(n){var tag=n.parentNode&&n.parentNode.nodeName;if(tag==="SCRIPT"||tag==="STYLE")return NodeFilter.FILTER_REJECT;return re.test(n.nodeValue)?NodeFilter.FILTER_ACCEPT:NodeFilter.FILTER_SKIP}});var nodes=[];while(walker.nextNode())nodes.push(walker.currentNode);nodes.forEach(function(n){n.nodeValue=n.nodeValue.replace(/([\u4e00-\u9fff\u2192]) (\d)/g,"$1 $2").replace(/(\d[\d,.:%]*) ([\u4e00-\u9fff\u2192])/g,"$1 $2")})})();if(!p.embed&&!matchMedia("(prefers-reduced-motion: reduce)").matches){document.documentElement.classList.add("js-on");var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add("in");io.unobserve(e.target)}})},{rootMargin:"0px 0px -8% 0px"});document.querySelectorAll("[data-rv]").forEach(function(el){io.observe(el)})}else{document.querySelectorAll("[data-rv]").forEach(function(el){el.classList.add("in")})}function makeRail(rail,speed){if(!rail)return;var down=false,sx=0,sl=0,hover=false,moved=0;rail.addEventListener("pointerdown",function(e){down=true;moved=0;sx=e.clientX;sl=rail.scrollLeft;rail.classList.add("dragging");rail.setPointerCapture(e.pointerId)});rail.addEventListener("pointermove",function(e){if(!down)return;moved=Math.max(moved,Math.abs(e.clientX-sx));rail.scrollLeft=sl-(e.clientX-sx)});["pointerup","pointercancel"].forEach(function(ev){rail.addEventListener(ev,function(){down=false;rail.classList.remove("dragging")})});rail.addEventListener("click",function(e){if(moved>6){e.stopPropagation();e.preventDefault()}},true);rail.addEventListener("pointerenter",function(){hover=true});rail.addEventListener("pointerleave",function(){hover=false});if(!p.embed&&!matchMedia("(prefers-reduced-motion: reduce)").matches){rail.classList.add("auto");Array.prototype.slice.call(rail.children).forEach(function(card){var c=card.cloneNode(true);c.setAttribute("aria-hidden","true");c.setAttribute("tabindex","-1");rail.appendChild(c)});var gap=parseFloat(getComputedStyle(rail).gap)||22;function loopW(){return(rail.scrollWidth+gap)/2}(function tick(){if(!down&&!hover&&!document.hidden){rail.scrollLeft+=speed;if(rail.scrollLeft>=loopW())rail.scrollLeft-=loopW()}requestAnimationFrame(tick)})()}}makeRail(document.querySelector(".poster-rail"),.6);makeRail(document.querySelector(".video-rail"),.45);var currentVid="OaKKO8R1yKU";var stage=document.getElementById("vstage");var stageCap=document.getElementById("vstage-cap");var stageImg=document.getElementById("vstage-img");var stageLink=document.getElementById("vstage-link");var player=null,ytPromise=null;function loadYT(){if(ytPromise)return ytPromise;ytPromise=new Promise(function(res){if(window.YT&&window.YT.Player)return res(window.YT);var prev=window.onYouTubeIframeAPIReady;window.onYouTubeIframeAPIReady=function(){if(prev)prev();res(window.YT)};var s=document.createElement("script");s.src="https://www.youtube.com/iframe_api";document.head.appendChild(s)});return ytPromise}function embedBlocked(){if(player){try{player.destroy()}catch(err){}player=null}var h=document.getElementById("yt-holder");if(h)h.remove();stage.classList.remove("playing");stage.classList.add("embed-blocked");if(stageCap)stageCap.textContent="這支影片不開放站內播放——點右上角「在 YouTube 開啟」觀看"}function playStage(){if(!stage)return;stage.classList.remove("embed-blocked");loadYT().then(function(YT){if(player){stage.classList.add("playing");player.loadVideoById(currentVid);return}var holder=document.createElement("div");holder.id="yt-holder";stage.appendChild(holder);stage.classList.add("playing");player=new YT.Player("yt-holder",{videoId:currentVid,playerVars:{autoplay:1,rel:0,playsinline:1},events:{onError:embedBlocked}})})}if(stage){stage.addEventListener("click",function(e){if(e.target.closest(".video-ext"))return;if(stage.classList.contains("embed-blocked")){window.open(stageLink.href,"_blank","noopener");return}if(!stage.classList.contains("playing"))playStage()});stage.addEventListener("keydown",function(e){if(e.key==="Enter"||e.key===" "){e.preventDefault();playStage()}})}var vrail=document.querySelector(".video-rail");if(vrail){vrail.addEventListener("click",function(e){var t=e.target.closest(".video-thumb");if(!t)return;var vid=t.getAttribute("data-vid");if(!vid)return;currentVid=vid;stage.classList.remove("embed-blocked");if(stageCap)stageCap.textContent=t.getAttribute("data-cap")||"";if(stageLink)stageLink.href="https://youtu.be/"+vid;if(player){stage.classList.add("playing");player.loadVideoById(vid)}else if(stageImg){stageImg.src="https://i.ytimg.com/vi/"+vid+"/hqdefault.jpg";stageImg.alt=t.getAttribute("data-cap")||""}vrail.querySelectorAll(".video-thumb").forEach(function(x){x.classList.toggle("on",x.getAttribute("data-vid")===vid)})})}var reduceMotion=matchMedia("(prefers-reduced-motion: reduce)").matches;var prog=document.getElementById("scroll-progress");var head=document.querySelector(".site-head");addEventListener("scroll",function(){var h=document.documentElement;var max=h.scrollHeight-h.clientHeight;if(prog)prog.style.width=(max?h.scrollTop/max*100:0)+"%";if(head)head.classList.toggle("slim",h.scrollTop>60)},{passive:true});var navLinks=Array.prototype.slice.call(document.querySelectorAll(".nav a"));var secIO=new IntersectionObserver(function(es){es.forEach(function(e){if(!e.isIntersecting)return;var id="#"+e.target.id;navLinks.forEach(function(a){a.classList.toggle("active",a.getAttribute("href")===id)})})},{rootMargin:"-30% 0px -55% 0px"});["record","news","policy","videos","factcheck","donate"].forEach(function(id){var el=document.getElementById(id);if(el)secIO.observe(el)});if(!reduceMotion){var cntIO=new IntersectionObserver(function(es){es.forEach(function(e){if(!e.isIntersecting)return;cntIO.unobserve(e.target);var el=e.target,target=parseFloat(el.getAttribute("data-count")),pre=el.getAttribute("data-prefix")||"",suf=el.getAttribute("data-suffix")||"",t0=performance.now(),dur=1400;(function step(t){var k=Math.min((t-t0)/dur,1);k=1-Math.pow(1-k,3);el.textContent=pre+Math.round(target*k).toLocaleString()+suf;if(k<1)requestAnimationFrame(step)})(t0)})},{threshold:.6});document.querySelectorAll("[data-count]").forEach(function(el){cntIO.observe(el)})}(function(){var postersSec=document.getElementById("posters");if(!postersSec)return;var srcs=[],caps=[];postersSec.querySelectorAll(".poster.p-img img").forEach(function(im){var s=im.getAttribute("src");if(srcs.indexOf(s)<0){srcs.push(s);caps.push(im.alt||"")}});if(!srcs.length)return;var lb=document.createElement("div");lb.className="lightbox";lb.innerHTML='<button class="lb-close" aria-label="關閉"><i class="fi fi-sr-cross"></i></button>'+'<button class="lb-prev" aria-label="上一張"><i class="fi fi-sr-angle-left"></i></button>'+'<figure><img alt=""/><figcaption></figcaption></figure>'+'<button class="lb-next" aria-label="下一張"><i class="fi fi-sr-angle-right"></i></button>';document.body.appendChild(lb);var idx=0,lbImg=lb.querySelector("img"),lbCap=lb.querySelector("figcaption");function showLB(i){idx=(i+srcs.length)%srcs.length;lbImg.src=srcs[idx];lbImg.alt=caps[idx];lbCap.textContent=caps[idx];lb.classList.add("open");document.body.style.overflow="hidden"}function closeLB(){lb.classList.remove("open");document.body.style.overflow=""}postersSec.addEventListener("click",function(e){var card=e.target.closest(".poster.p-img");if(!card)return;var im=card.querySelector("img");if(im)showLB(srcs.indexOf(im.getAttribute("src")))});lb.querySelector(".lb-close").addEventListener("click",closeLB);lb.querySelector(".lb-prev").addEventListener("click",function(){showLB(idx-1)});lb.querySelector(".lb-next").addEventListener("click",function(){showLB(idx+1)});lb.addEventListener("click",function(e){if(e.target===lb)closeLB()});addEventListener("keydown",function(e){if(!lb.classList.contains("open"))return;if(e.key==="Escape")closeLB();if(e.key==="ArrowLeft")showLB(idx-1);if(e.key==="ArrowRight")showLB(idx+1)})})()})()</script>

    
    <script>(function(){var section=document.getElementById("policy");if(!section)return;var modal=document.getElementById("pd-modal");var body=document.getElementById("pd-sheet-body");var sheet=modal&&modal.querySelector(".pd-sheet");if(!modal||!body)return;var lastFocus=null;function openPolicy(id){var src=document.getElementById("pd-d-"+id);if(!src)return;body.innerHTML=src.innerHTML;body.scrollTop=0;lastFocus=document.activeElement;modal.hidden=false;requestAnimationFrame(function(){modal.classList.add("pd-open")});document.body.style.overflow="hidden";var x=modal.querySelector(".pd-x");if(x)x.focus()}function closePolicy(){modal.classList.remove("pd-open");document.body.style.overflow="";var done=function(){modal.hidden=true;body.innerHTML="";sheet&&sheet.removeEventListener("transitionend",done)};if(sheet&&!matchMedia("(prefers-reduced-motion: reduce)").matches){sheet.addEventListener("transitionend",done);setTimeout(done,400)}else{done()}if(lastFocus&&lastFocus.focus)lastFocus.focus()}section.addEventListener("click",function(e){var card=e.target.closest(".pd-card");if(card&&section.contains(card)){openPolicy(card.getAttribute("data-pd"))}});modal.addEventListener("click",function(e){if(e.target.closest("[data-pd-close]"))closePolicy()});addEventListener("keydown",function(e){if(e.key==="Escape"&&!modal.hidden)closePolicy()});var filters=section.querySelectorAll(".pd-filter");var cards=section.querySelectorAll(".pd-card");filters.forEach(function(btn){btn.addEventListener("click",function(){var cat=btn.getAttribute("data-cat");filters.forEach(function(b){b.classList.toggle("on",b===btn)});cards.forEach(function(c){var show=cat==="all"||c.getAttribute("data-cat")===cat;c.classList.toggle("pd-hide",!show)})})})})()</script>
    
    <script>(function(){var target=new Date("2026-11-28T00:00:00+08:00").getTime();var els={d:document.getElementById("vc-d"),h:document.getElementById("vc-h"),m:document.getElementById("vc-m"),s:document.getElementById("vc-s")};var box=document.getElementById("vote-count");function pad(n){return String(n).padStart(2,"0")}function tick(){var diff=target-Date.now();if(diff<=0){if(box)box.innerHTML='<span style="font-weight:900">今天就是投票日，記得去投票！</span>';return}var s=Math.floor(diff/1e3);if(els.d)els.d.textContent=Math.floor(s/86400);if(els.h)els.h.textContent=pad(Math.floor(s%86400/3600));if(els.m)els.m.textContent=pad(Math.floor(s%3600/60));if(els.s)els.s.textContent=pad(s%60);setTimeout(tick,1e3)}tick();var track=document.getElementById("annc-track");if(track){var items=track.querySelectorAll(".annc-item");if(items.length>1){var idx=0,hover=false;track.addEventListener("pointerenter",function(){hover=true});track.addEventListener("pointerleave",function(){hover=false});setInterval(function(){if(hover||document.hidden)return;idx=(idx+1)%items.length;items.forEach(function(it,i){it.classList.toggle("on",i===idx)})},5e3)}}var cards=document.querySelectorAll(".pd-card");var descbar=document.getElementById("bp-descbar");function hideDesc(){if(descbar)descbar.hidden=true}function applyFilter(key){cards.forEach(function(c){c.classList.toggle("pd-hide",!!key&&c.getAttribute("data-c12")!==key)});if(rail){rail.scrollTo({left:0,behavior:"smooth"});syncArrows()}}var govStrip=document.querySelector(".gov-strip[data-c12]");if(govStrip)govStrip.addEventListener("click",function(){var wasOn=govStrip.classList.contains("on");govStrip.classList.toggle("on",!wasOn);applyFilter(wasOn?null:"gov");if(descbar&&!wasOn){descbar.innerHTML="";var b=document.createElement("b");b.textContent="完整施政藍圖";descbar.appendChild(b);descbar.appendChild(document.createTextNode("「四大治理方向 × 十二項施政領域，管全部的事」"));descbar.setAttribute("data-c12","gov");descbar.hidden=false}else hideDesc()});var FLAGS=[{key:"life",ic:"user",no:"01",fw:"人生向前",nm:"未來存摺",sub:"花蓮人生投資計畫",tc:"var(--tc-life)",sl:"從出生、求學、就業、成家到老，我們陪你走過人生的每一步"},{key:"guard",ic:"shield-check",no:"02",fw:"安全向前",nm:"防災治理改革",sub:"",tc:"var(--tc-guard)",sl:"把防災變成花蓮的基本治理能力",cards:true,items:[{t:"成立防災專責單位",d:"重建、收容所、治水，一個單位負責到底"},{t:"無人機送物資進偏鄉",d:"即時補給，從試飛變常態"},{t:"爭取後送直升機駐花蓮",d:"緊急救援，半夜來得及"}]},{key:"move",ic:"bus-alt",no:"03",fw:"交通向前",nm:"多路徑韌性交通",sub:"",tc:"var(--tc-move)",sl:"出得了門，但也回得了家",cards:true,items:[{t:"海空運輸動起來",d:"鐵、公路中斷時有備援"},{t:"推動花東快速公路",d:"北段先銜接、南區不等待"},{t:"偏鄉計程車補助",d:"沒公車也叫得到車"}]},{key:"tour",ic:"camera",no:"04",fw:"觀光向前",nm:"花蓮新主場",sub:"城市品牌升級計畫",tc:"var(--tc-tour)",sl:"讓花蓮重新成為讓人期待的地方",cards:true,items:[{t:"爭取國際表演、賽事",d:"山海就是天然的舞台"},{t:"從花蓮直飛出國",d:"國際航線，客人進得來"},{t:"山海花蓮，十三種風景",d:"不只來得多，還要留得久"}]},{key:"smart",ic:"brain",no:"05",fw:"智慧向前",nm:"AI 導入花蓮",sub:"",tc:"var(--tc-smart)",sl:"用科技與 AI，把花蓮的距離變短",cards:true,items:[{t:"守護獨居看得見",d:"沒接通，一定有人去敲門"},{t:"遠距門診開進更多部落",d:"就醫無需跋山涉水"},{t:"科技輔助農業發展",d:"穩定收成，協助行銷"}]},{key:"group",ic:"users",no:"06",fw:"族群向前",nm:"共榮共好",sub:"",tc:"var(--tc-group)",sl:"無論先來後到，都能決定花蓮的未來",items:[{t:"讓花蓮成為南島文化中心",d:"歲時祭儀，部落是主角"},{t:"母語認證，考過有獎金",d:"初級中級也領得到"},{t:"祭典回家，車資縣府出",d:"在外打拚的孩子也常常回家"}]}];var FPB_BOOKS=[{n:"01",stage:"出生",nm:"安心生養金",sl:"在花蓮生，在花蓮養",ic:"baby",amtS:'<i class="nb">每胎 <b>5</b> 萬</i>・<i class="nb">月子 3 萬</i>',subS:"新生兒家庭",why:"六都的生育津貼四年內全部加碼過；花蓮現行每胎 2 萬，但從來沒被寫清楚。",get:"在花蓮生小孩，縣府的支持不是只有第一筆。",obj:"新生兒家庭",rows:[{it:"生育補助（加碼後）",sub:"含既有每胎 2 萬",amt:"50,000",unit:"／胎",hero:true},{it:"月子加菜金",sub:"新增・坐月子期間使用",amt:"30,000",unit:"／胎"}]},{n:"02",stage:"學齡",nm:"營養成長金",sl:"孩子的營養，超商就領得到",ic:"salad",amtS:'<i class="nb">每月 <b>10</b> 瓶</i><i class="nb">營養飲品</i>',subS:"學齡孩子",why:"學校團膳送不進南區，但超商十三鄉鎮都有；而且不是每個孩子都能喝牛奶。",get:"孩子每個月有十瓶營養飲品，喝不了牛奶的也有得選。",obj:"學齡兒童",rows:[{it:"營養飲品",sub:"超商兌換・十三鄉鎮都領得到",amt:"10",unit:"瓶／月",hero:true},{it:"品項不綁單一乳品",sub:"可換豆漿、優酪乳等等值品",amt:"等值兌換",est:true}]},{n:"03",stage:"求學",nm:"未來教育金",sl:"下課有地方去，爸媽不用趕著接",ic:"graduation-cap",amtS:'<i class="nb">每月 <b>1,000</b> 元</i>',subS:"6–18 歲孩子",why:"才藝與體育課程幾乎都集中在花蓮市與吉安；下課了但還沒下班，是雙薪家庭最痛的一段。",get:"孩子想學的東西，不必因為負擔不起、或住得太遠就放棄。",obj:"6–18 歲",rows:[{it:"課後學習額度",sub:"才藝、運動、學習探索・6–18 歲",amt:"1,000",unit:"／月",hero:true},{it:"孩子有地方去",sub:"父母的照顧空窗一起補上",amt:"雙受益",est:true}]},{n:"04",stage:"圓夢",nm:"青年圓夢金",sl:"不用先有錢，才能開始做想做的事",ic:"rocket-lunch",amtS:'<i class="nb">每案最高 <b>10</b> 萬</i>',subS:"15–25 歲・不限主題",why:"現有青年資源多半綁在創業；辦活動、拍紀錄片、做田調都不算創業，卻都是年輕人留下來的理由。",get:"有想法的年輕人不必等到有錢才開始；想出去看世界，縣府出一段。",obj:"青年",rows:[{it:"一般型提案",sub:"提案制・不限主題",amt:"10,000",unit:"／案"},{it:"旗艦型提案",sub:"規模較大的計畫・可以出國",amt:"100,000",unit:"／案",hero:true}]},{n:"05",stage:"就業",nm:"專業留才金",sl:"花蓮不缺工作，缺的是留得住的薪水",ic:"briefcase",amtS:'<i class="nb">每月加 <b>5,000</b> 元</i>',subS:"留花青年",why:"花蓮失業率跟全國一樣，真正的差距是所得只有全國的 77.6%、倒數第 5。",get:"留在花蓮工作的第一年，薪水袋裡多一截；讀醫護的孩子實習能留在家鄉。",obj:"留花青年與雇主",rows:[{it:"首年加薪",sub:"留花第一年按月加給",amt:"5,000",unit:"／月",hero:true},{it:"企業段・訓練金",sub:"雇主聘在地人才",amt:"1,500",unit:"／月"}]},{n:"06",stage:"成家",nm:"結婚成家金",sl:"不只留住花蓮人，也接住想搬來的人",ic:"home-heart",amtS:'<i class="nb">每戶 <b>3</b> 萬元</i>',subS:"結婚定居",why:"留人最難的一關是「要不要在花蓮成家」——這一關流失，前面所有青年政策都白做。",get:"決定在花蓮成家的人，第一步有人扶一把，而且這筆錢花在花蓮的店裡。",obj:"結婚或移居定居",rows:[{it:"成家券",sub:"結婚或移居定居都適用",amt:"30,000",unit:"",hero:true},{it:"使用範圍",sub:"限花蓮縣內店家・錢留在花蓮",amt:"縣內限定",est:true}]},{n:"07",stage:"照顧",nm:"家庭喘息金",sl:"照顧的人不缺責任，缺的是喘口氣",ic:"hand-holding-heart",amtS:'<i class="nb">每年 <b>12,000</b></i>',subS:"照顧者",why:"現行照顧者津貼都是「領錢就不能用服務」，逼照顧的人二選一。",get:"照顧家人的人，一年也該有幾天是自己的。",obj:"家庭照顧者",rows:[{it:"喘息預算",sub:"給照顧者「顧自己」用",amt:"12,000",unit:"／年",hero:true},{it:"與長照服務",sub:"唯一可以併領的一筆",amt:"可併領",est:true}]},{n:"08",stage:"健康",nm:"身心健檢金",sl:"不必等到不舒服，才去檢查",ic:"stethoscope",amtS:'<i class="nb">健檢 <b>6,000</b></i>＋<i class="nb">心理諮商</i>',subS:"25 歲以上",why:"現行健檢加碼只給 65 歲以上，40–64 歲的 12 萬人一項都沒有——而且全部是抽血、零影像。",get:"過了二十五歲，該檢查的不必等有症狀才做；想找人談，不必排到天荒地老。",obj:"25 歲以上",rows:[{it:"加值健檢",sub:"25 歲以上・補上影像檢查",amt:"6,000",unit:"／年",hero:true},{it:"心理諮商",sub:"人次制擴充量能",amt:"擴充量能",est:true}]},{n:"09",stage:"老後",nm:"銀髮樂活金",sl:"長輩不缺時間，缺的是出得了門的身體",ic:"glasses",amtS:'<i class="nb">出遊 <b>6,000</b></i>＋<i class="nb">輔具</i>',subS:"65 歲以上長者",why:"花蓮有 143 個村里沒有任何長照據點；長輩常常不是身體不行，是沒伴、沒車、沒理由出門。",get:"聽得到、看得見、咬得動，然後才出得去——想出去走走，縣府補一段。",obj:"65 歲以上",rows:[{it:"輔具補助",sub:"助聽器・老花眼鏡・假牙，不排富",amt:"另有提供",est:true},{it:"結伴出遊補助",sub:"核銷制・可結合村里活動",amt:"6,000",unit:"",hero:true}]},{n:"10",stage:"全齡",nm:"交通行動金",sl:"出門的車票機票，縣府折一段",ic:"bus-alt",amtS:'<i class="nb">每年 <b>3,600</b></i>',subS:"全齡縣民",why:"花蓮南北狹長，出門就是一筆車錢；機票貴、班次少，班次少又因為載客率撐不起來。",get:"出門的車錢縣府每年幫你出一部分；在外讀書的孩子回家，車票也補。",obj:"全齡縣民",rows:[{it:"交通額度",sub:"車票、機票都能折抵",amt:"3,600",unit:"／年",hero:true},{it:"敬老卡照發",sub:"一毛不減・偏鄉再加碼",amt:"不折抵",est:true}]},{n:"11",stage:"全齡",nm:"縣內旅遊金",sl:"在花蓮玩，錢留在花蓮",ic:"umbrella-beach",amtS:'<i class="nb">每年 <b>3,600</b></i>',subS:"全齡縣民",why:"一般觀光政策都在花錢請別人來——但要別人來花蓮玩之前，先讓花蓮人自己玩得起。",get:"在花蓮玩有補助，而且你花的每一塊都留在花蓮的店裡。",obj:"全齡縣民",rows:[{it:"縣內旅遊額度",sub:"限旅宿與遊程使用",amt:"3,600",unit:"／年",hero:true},{it:"搭配玩法",sub:"一年一鄉一個新亮點",amt:"13 鄉鎮",est:true}]},{n:"12",stage:"全齡",nm:"寵物守護金",sl:"貓狗看病沒有健保，這筆縣府補",ic:"paw",amtS:'<i class="nb">每隻 <b>3,600</b> 元</i>',subS:"登記飼主",why:"全縣 29 家動物醫院有 22 家擠在花蓮市與吉安；寵物醫療沒有健保，一次手術動輒數萬元。",get:"貓狗看病沒有健保，這筆縣府補；住在沒有動物醫院的鄉鎮，也有獸醫可以看。",obj:"飼主",rows:[{it:"寵物照護額度",sub:"保險＋疫苗・真的出事保險理賠",amt:"3,600",unit:"／年·隻",hero:true},{it:"沒有動物醫院的鄉鎮",sub:"巡迴動物醫療站接住",amt:"巡迴接住",est:true}]}];(function(){var tabsEl=document.getElementById("six-tabs");var panelEl=document.getElementById("flag-panel");var modal=document.getElementById("fpb-modal");var bookEl=document.getElementById("fpb-book");if(!tabsEl||!panelEl||!modal||!bookEl)return;var fpbIdx=0;var curFlag="life";tabsEl.innerHTML=FLAGS.map(function(f){return'<button class="stab'+(f.key==="life"?" on":"")+'" type="button" data-flag="'+f.key+'" style="--tc:'+f.tc+'">'+'<b class="s-no">'+f.no+"</b>"+'<i class="s-ic fi fi-sr-'+f.ic+'" aria-hidden="true"></i>'+'<span class="s-fw">'+f.fw+"</span>"+'<span class="s-nm">'+f.nm+"</span>"+"</button>"}).join("");function lifePanel(){var cells=FPB_BOOKS.map(function(b,i){return'<button class="bkc" type="button" data-i="'+i+'">'+'<span class="bkc-ic"><i class="fi fi-sr-'+b.ic+'"></i></span>'+'<span class="bkc-t"><b><i class="bkc-n">'+b.n+"</i>"+b.nm+"</b>"+'<span class="bkc-amt">'+b.amtS+"</span>"+'<span class="bkc-sub">'+b.subS+"</span></span>"+"</button>"}).join("");return'<div class="fp-cols">'+'<div class="fp-intro">'+'<div class="fs-head">'+'<span class="fs-no" aria-hidden="true">01</span>'+'<div class="fs-headtxt">'+'<span class="fs-kicker">旗艦一・人生向前</span>'+'<h3 class="fs-name">未來存摺</h3>'+'<p class="fs-core">不是一次給你多少，而是<em>人生每一步都有支持</em>——<i class="nb">十二本存摺，</i><i class="nb">接住人生每個階段。</i></p>'+"</div></div>"+'<button class="fp-cta" type="button" id="fpb-cta">查看 12 本存摺 <i class="fi fi-sr-arrow-small-right"></i></button>'+"</div>"+'<div class="fp-books">'+'<div class="bk-railwrap">'+'<button class="bk-arrow prev" type="button" aria-label="往前看">‹</button>'+'<button class="bk-arrow next" type="button" aria-label="往後看">›</button>'+'<div class="bkgrid">'+cells+'</div><span class="bk-hint" aria-hidden="true"><i class="fi fi-sr-angle-double-right"></i></span></div>'+"</div></div>"+'<p class="fs-honest ctr"><i class="fi fi-sr-arrows-h"></i>可左右瀏覽完整 12 本存摺，點卡片查看細節。</p>'}function otherPanel(f){var items=(f.items||[]).map(function(o){return"<li><b>"+o.t+"</b><span>"+o.d+"</span></li>"}).join("");var sub=f.sub?"<small>"+f.sub+"</small>":"";return'<div class="fs-head">'+'<span class="fs-no" aria-hidden="true" style="color:'+f.tc+'">'+f.no+"</span>"+'<div class="fs-headtxt">'+'<span class="fs-kicker" style="color:'+f.tc+'">旗艦'+["","一","二","三","四","五","六"][+f.no.slice(1)]+"・"+f.fw+"</span>"+'<h3 class="fs-name">'+f.nm+sub+"</h3>"+'<p class="fs-core">「'+f.sl+"」</p>"+"</div></div>"+'<ul class="fs-list" style="--tc:'+f.tc+'">'+items+"</ul>"+(f.cards?'<p class="fp-soon"><i class="fi fi-sr-arrow-small-down"></i>更多相關政見，同步顯示在下方政見卡。</p>':"")}function selectFlag(key){curFlag=key;var f=FLAGS.find(function(x){return x.key===key});tabsEl.querySelectorAll(".stab").forEach(function(t){var on=t.getAttribute("data-flag")===key;t.classList.toggle("on",on)});panelEl.innerHTML=key==="life"?lifePanel():otherPanel(f);if(govStrip)govStrip.classList.remove("on");hideDesc();applyFilter(f&&f.cards?key:null)}tabsEl.addEventListener("click",function(e){var t=e.target.closest(".stab");if(t)selectFlag(t.getAttribute("data-flag"))});panelEl.addEventListener("click",function(e){if(e.target.closest("#fpb-cta")){openModal(0);return}var ar=e.target.closest(".bk-arrow");if(ar){var g=panelEl.querySelector(".bkgrid");if(g)g.scrollBy({left:(ar.classList.contains("prev")?-1:1)*640,behavior:"smooth"});return}var c=e.target.closest(".bkc");if(c)openModal(+c.getAttribute("data-i"))});function fpbRow(r){var amtCls="amt"+(r.est?" est":"");var unit=r.unit?"<small>"+r.unit+"</small>":"";return'<div class="fpb-row'+(r.hero?" hi":"")+'">'+'<span class="tp">▸</span>'+'<span class="it">'+r.it+"<small>"+r.sub+"</small></span>"+'<span class="'+amtCls+'">'+r.amt+unit+"</span>"+"</div>"}function fpbRender(){var b=FPB_BOOKS[fpbIdx];bookEl.innerHTML='<span class="fpb-corner tl"></span><span class="fpb-corner tr"></span><span class="fpb-corner bl"></span><span class="fpb-corner br"></span>'+'<div class="fpb-pg left">'+'<div class="fpb-chips"><span class="fpb-chip hl">未來存摺</span><span class="fpb-chip">第 '+b.n+' 本</span><span class="fpb-chip dim">人生階段・'+b.stage+"</span></div>"+'<div class="fpb-nm">'+b.nm+"</div>"+'<div class="fpb-sl">'+b.sl+"</div>"+'<div class="fpb-block"><h5>解決什麼問題</h5><p>'+b.why+"</p></div>"+'<div class="fpb-block get"><h5>你會得到什麼</h5><p>'+b.get+"</p></div>"+'<div class="fpb-obj"><b>戶名</b>'+b.obj+"</div>"+"</div>"+'<div class="fpb-pg right">'+'<div class="fpb-lghead"><span>存入明細 DEPOSIT</span><span>金額</span></div>'+b.rows.map(fpbRow).join("")+'<div class="fpb-foot"><span class="fpb-mark">HUALIEN COUNTY · A LIFETIME OF SUPPORT</span><span class="fpb-page">'+b.n+" / 12</span></div>"+"</div>";bookEl.classList.remove("flip");void bookEl.offsetWidth;bookEl.classList.add("flip")}function openModal(i){fpbIdx=i;fpbRender();modal.hidden=false;document.body.style.overflow="hidden"}function closeModal(){modal.hidden=true;document.body.style.overflow=""}modal.addEventListener("click",function(e){if(e.target.closest("[data-close]")){closeModal();return}var a=e.target.closest(".fpb-arrow");if(a){fpbIdx=(fpbIdx+ +a.getAttribute("data-d")+FPB_BOOKS.length)%FPB_BOOKS.length;fpbRender()}});document.addEventListener("keydown",function(e){if(e.key==="Escape"&&!modal.hidden)closeModal()});var fpbNudged=false;var fpbNudging=false;function fpbTouch(e){var t=e.target;if(!t||!t.closest)return;if(t.closest(".bkgrid")||t.closest(".bk-arrow")){var w=panelEl.querySelector(".bk-railwrap");if(w)w.classList.add("touched")}}panelEl.addEventListener("pointerdown",fpbTouch,true);panelEl.addEventListener("wheel",fpbTouch,true);panelEl.addEventListener("scroll",function(e){if(fpbNudging)return;if(e.target&&e.target.classList&&e.target.classList.contains("bkgrid")){fpbTouch(e)}},true);function fpbNudge(){if(fpbNudged)return;if(matchMedia("(prefers-reduced-motion: reduce)").matches)return;var g=panelEl.querySelector(".bkgrid");if(!g||g.scrollLeft>0)return;fpbNudged=true;fpbNudging=true;g.scrollBy({left:64,behavior:"smooth"});setTimeout(function(){g.scrollBy({left:-64,behavior:"smooth"})},550);setTimeout(function(){fpbNudging=false},1800)}selectFlag("life");if("IntersectionObserver"in window){var fpbIo=new IntersectionObserver(function(ents){ents.forEach(function(en){if(en.isIntersecting){fpbNudge();fpbIo.disconnect()}})},{threshold:.35});fpbIo.observe(panelEl)}else{setTimeout(fpbNudge,1200)}})();(function(){var hero=document.querySelector('body[data-hero="photo"] .hero');if(!hero||hero.querySelector(".mh-photo"))return;var bg=hero.querySelector(".hero-bg");if(!bg)return;var parts=[bg,hero.querySelector(".hero-scrim"),hero.querySelector(".mh-vert"),hero.querySelector(".mh-name")].filter(Boolean);var box=document.createElement("div");box.className="mh-photo";bg.parentNode.insertBefore(box,bg);parts.forEach(function(el){box.appendChild(el)})})();(function(){var host=document.getElementById("m-policy");if(!host||!matchMedia("(max-width: 700px)").matches)return;var RM=matchMedia("(prefers-reduced-motion: reduce)").matches;function splitAmt(b){var tmp=document.createElement("div");tmp.innerHTML=b.amtS;var big=tmp.querySelector("b");var num=big?big.textContent.trim():"";var full=tmp.textContent.trim();var pre="",suf="";if(num){var at=full.indexOf(num);pre=full.slice(0,at).trim();suf=full.slice(at+num.length).trim()}else{pre=full}return{pre:pre,num:num,suf:suf}}var AXES=[{no:"一",tc:"var(--tc-life)",nm:"治理革新",sl:"落實透明、高效、有方向的縣政治理。",cards:[8],items:[{t:"前瞻佈局",d:"統整重大建設、交通、產業與公共資源，擬定縣政長遠藍圖，讓政策與預算方向一致、資源有效運用。"},{t:"廉能治理",d:"落實公開透明、財政紀律與績效管理，強化跨局處協調及重大建設公開機制，打造高效率、值得信任的縣政。"},{t:"安全守護",d:"整合交通安全、消防救護、防詐、防毒與社區治安，降低事故與犯罪風險，守護每位鄉親的生活安全。"}]},{no:"二",tc:"var(--tc-tour)",nm:"宜居家鄉",sl:"打造每個世代都安心生活的花蓮。",cards:[4,6,2,3],items:[{t:"交通優化",d:"整合鐵路、公車、幸福巴士、偏鄉接駁及共享運具，完善道路與行人環境，提升十三鄉鎮交通便利性。"},{t:"培育未來",d:"優化學習環境，縮小教育落差，推動數位、科技、雙語、體育與文化教育，培養孩子面向未來的能力。"},{t:"醫療照護",d:"完善偏鄉醫療、急重症照護、居家服務與長照據點，建構完整健康照護網絡，讓鄉親放心生活、安心養老。"}]},{no:"三",tc:"var(--tc-move)",nm:"共榮共好",sl:"凝聚地方力量，共創花蓮新動能。",cards:[5],items:[{t:"多元產業",d:"發展觀光、農業、文化、科技、照護與地方創生，扶植在地品牌與企業，創造更多優質就業機會。"},{t:"青年人才",d:"建立友善就業與創業環境，支持青年返鄉發展，提供更多優質工作機會，讓花蓮成為安心築夢、實現理想的地方。"},{t:"區域發展",d:"因應十三鄉鎮特色規劃發展策略，完善交通、教育、醫療與數位建設，縮小城鄉落差，實現均衡發展。"}]},{no:"四",tc:"var(--tc-guard)",nm:"世代永續",sl:"守護山海環境，傳承下一代的希望。",cards:[0,1,7],items:[{t:"韌性防災",d:"建立完善防災體系，強化即時預警、避難規劃與社區自主防災，提升整體防災韌性與應變能力。"},{t:"風土創生",d:"串聯農業、部落文化、地方歷史與山海景觀，發展地方品牌、特色觀光與文化產業，延續花蓮珍貴的風土價值。"},{t:"永續環境",d:"推動垃圾減量、水資源管理、河川治理、低碳交通與永續旅遊，兼顧發展與保育，守護珍貴的山海環境。"}]}];var PCARDS=[].slice.call(document.querySelectorAll(".d-policy .pd-card")).map(function(c){return{id:c.getAttribute("data-pd"),tag:(c.querySelector(".pd-tag")||{}).textContent||"",title:(c.querySelector(".pd-card-title")||{}).textContent||"",lead:(c.querySelector(".pd-card-lead")||{}).textContent||""}});var idx=0,flag=0,axis=0,done={},sheet=null;host.innerHTML='<div class="mp-sec mp-book">'+'<div class="mp-head">'+'<div class="mp-kickrow">'+'<span class="mp-mono">FLAGSHIP 01 · 人生向前</span>'+'<span class="mp-pill"><i></i>本階段主打亮點政見</span>'+"</div>"+'<h2 class="mp-h2">未來存摺</h2>'+'<p class="mp-sub">花蓮人生投資計畫</p>'+'<p class="mp-lead">不是一次給你多少，而是<b>人生每一步都有支持</b>——<i class="nb">十二本存摺，</i><i class="nb">接住人生每個階段。</i></p>'+'<div class="mp-prog">'+'<span class="mp-prog-n" id="mp-n">01</span>'+'<span class="mp-prog-t">/ 12</span>'+'<span class="mp-prog-bar"><b id="mp-bar"></b></span>'+'<span class="mp-prog-stage" id="mp-stage">出生</span>'+"</div></div>"+'<div class="mp-rail" id="mp-rail"></div>'+'<div class="mp-railfoot">'+'<span class="mp-hint"><i class="mp-sw">↔</i>左右滑動看完 12 本，點卡片看細節</span>'+'<span class="mp-navs"><button type="button" class="mp-nav" data-d="-1" aria-label="上一本">‹</button><button type="button" class="mp-nav" data-d="1" aria-label="下一本">›</button></span>'+"</div></div>"+'<div class="mp-sec mp-flag">'+'<div class="mp-head">'+'<span class="mp-mono">A BETTER HUALIEN</span>'+'<h2 class="mp-h2">六大城市旗艦任務</h2>'+'<p class="mp-sub2">點旗艦看政見，讓花蓮的每一步都更有力。</p>'+"</div>"+'<div class="mp-tabs" id="mp-tabs"></div>'+'<div class="mp-panel" id="mp-panel"></div>'+"</div>"+'<div class="mp-sec mp-axes">'+'<div class="mp-head">'+'<span class="mp-mono">EVERYDAY GOVERNANCE</span>'+'<h2 class="mp-h2">完整施政藍圖</h2>'+'<p class="mp-sub2">六大旗艦之外，所有縣政每天都要做好的事</p>'+'<span class="mp-mono mp-axnote">4 大施政主軸 × 12 項行動方案</span>'+"</div>"+'<div class="mp-acc" id="mp-acc"></div>'+"</div>"+'<div class="mp-sheet" id="mp-sheet" hidden><div class="mp-sheet-back" data-close></div><div class="mp-sheet-box"><div class="mp-sheet-head"><span class="mp-mono" id="mp-sheet-kick"></span><button type="button" class="mp-sheet-x" data-close aria-label="關閉">×</button></div><div class="mp-sheet-body" id="mp-sheet-body"></div></div></div>';var rail=document.getElementById("mp-rail");var bar=document.getElem