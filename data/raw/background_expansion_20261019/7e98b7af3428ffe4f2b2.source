const CAT_LABELS = {
  social:   { name:'社福家庭', en:'SOCIAL WELFARE' },
  labor:    { name:'勞工',     en:'LABOR' },
  traffic:  { name:'交通建設', en:'TRANSPORT' },
  youth:    { name:'兒少婦幼', en:'YOUTH & FAMILY' },
  education:{ name:'教育',     en:'EDUCATION' },
  agri:     { name:'農漁業',   en:'AGRI & FISHERY' },
  sports:   { name:'體育',     en:'SPORTS' },
  industry: { name:'產業科技', en:'INDUSTRY & TECH' },
};

const POLICIES_PER_PAGE = 6;
let currentPolicyCat = 'all';
let currentPolicyPage = 1;

function getPolicyItems(){
  return currentPolicyCat === 'all' ? POLICIES : POLICIES.filter(p => p.cat === currentPolicyCat);
}

function renderPolicies(){
  const grid = document.getElementById('policyGrid');
  grid.innerHTML = '';
  const items = getPolicyItems();
  const start = (currentPolicyPage - 1) * POLICIES_PER_PAGE;
  const pageItems = items.slice(start, start + POLICIES_PER_PAGE);
  pageItems.forEach(p => {
    const info = CAT_LABELS[p.cat];
    const card = document.createElement('a');
    card.className = 'policy-card';
    card.href = p.link; card.target = '_blank'; card.rel = 'noopener';
    card.innerHTML = `
      <div class="top">
        <span class="cat">${info.en} · ${info.name}</span>
        <span class="date">${p.date}</span>
      </div>
      <div class="body">
        <h3>${p.title}</h3>
        <p>${p.desc}</p>
        <span class="more-link">查看完整貼文 ↗</span>
      </div>`;
    grid.appendChild(card);
  });
  renderPolicyPagination(items.length);
}

function renderPolicyPagination(total){
  const pag = document.getElementById('policyPagination');
  const totalPages = Math.ceil(total / POLICIES_PER_PAGE);
  if (totalPages <= 1){ pag.innerHTML = ''; return; }
  let h = '';
  h += `<button ${currentPolicyPage===1?'disabled':''} data-go="${currentPolicyPage-1}">‹ 上一頁</button>`;
  for (let i = 1; i <= totalPages; i++){
    h += `<button class="${i===currentPolicyPage?'on':''}" data-go="${i}">${i}</button>`;
  }
  h += `<button ${currentPolicyPage===totalPages?'disabled':''} data-go="${currentPolicyPage+1}">下一頁 ›</button>`;
  h += `<span class="info">共 ${total} 則政見</span>`;
  pag.innerHTML = h;
  pag.querySelectorAll('button[data-go]').forEach(b => {
    b.onclick = () => {
      const p = parseInt(b.dataset.go);
      const totalP = Math.ceil(getPolicyItems().length / POLICIES_PER_PAGE);
      if (p >= 1 && p <= totalP){
        currentPolicyPage = p;
        renderPolicies();
        const top = document.getElementById('policy').offsetTop - 60;
        window.scrollTo({top, behavior:'smooth'});
      }
    };
  });
}

// counts
const cats = ['all','social','labor','traffic','youth','education','agri','sports','industry'];
cats.forEach(c => {
  const el = document.getElementById('cnt-' + c);
  if (!el) return;
  el.textContent = c === 'all' ? POLICIES.length : POLICIES.filter(p => p.cat === c).length;
});

document.querySelectorAll('#polTabs button').forEach(btn => {
  btn.onclick = () => {
    document.querySelectorAll('#polTabs button').forEach(b => b.classList.remove('on'));
    btn.classList.add('on');
    currentPolicyCat = btn.dataset.cat;
    currentPolicyPage = 1;
    renderPolicies();
  };
});
renderPolicies();

