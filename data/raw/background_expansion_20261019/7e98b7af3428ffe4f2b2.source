    truth:'吳宗憲觀察到宜蘭在雙北工作的通勤族，常常都要手拿兩張卡，一張是宜蘭 TPASS 2300+、一張是北北基桃 TPASS，只要忘了帶其中一張，當日的通勤成本就要增加，而且購票日期若記錯，相關的補助經費也會領不到。故在拜會台北市長蔣萬安時，提出希望把宜蘭 TPASS 整合北北基桃 TPASS 中，讓宜蘭通勤族享有相同福利及便利。',
    sources:[]
  },
  {
    date:'2026/04/23',
    q:'民進黨議員稱吳宗憲「膨風水雞刣無肉」，宜蘭實際可用財源僅 16 億？',
    false_claim:'民進黨議員說吳宗憲「膨風水雞刣無肉」，宣稱縣府將增加 128 億元財源，並要提撥 1/4（32 億元）推動福利，但根據縣府財稅局長先前答詢，宜蘭實際可用財源恐僅有 16 億元，社福支票卻要花 32 億元。',
    truth:'民進黨團的說法明顯混淆時序，仍拿「當初主計處的舊版核定表」說嘴。財劃法第 1 次修正後，中央雖然讓宜蘭統籌分配稅款增加約 128 億元，卻同時拿回全國一般性補助款 636 億元，導致宜蘭「統籌增加但補助大減」。在野黨推動後續三讀通過「二修」財劃法，明文化制訂中央對地方的一般性補助款不得低於前一年、計畫型補助不得低於過去 10 年平均，避免中央再玩「統籌加、補助減」的數字遊戲。依目前的新法計算，宜蘭可以穩定增加的統籌分配稅款約為 128 億元。',
    sources:[]
  },
  {
    date:'2026/04/23',
    q:'吳宗憲延長國小課後輔導至 7 點，讓老師變相加班？',
    false_claim:'吳宗憲推出國小課後輔導班最晚延後至 7 點，民進黨議員說是變相讓學校老師加班，會影響行政教學品質。',
    truth:'吳宗憲提的是國小課後照顧班全面免費，並視需求延長至晚間 7 點，寒暑假也開班，而課後安親班跟現行一樣委由合法私人機構委辦，來減輕第一線教師們的壓力，並期望擔任課後輔導人員來創造多元就業機會，並非再由學校老師或其他行政人員來擔任。',
    sources:[]
  }
];

const RUMORS_PER_PAGE = 6;
let currentRumorPage = 1;

function renderRumorPage(page){
  currentRumorPage = page;
  const rlist = document.getElementById('rumorList');
  rlist.innerHTML = '';
  const start = (page - 1) * RUMORS_PER_PAGE;
  const pageItems = RUMORS.slice(start, start + RUMORS_PER_PAGE);
  pageItems.forEach((r, idx) => {
    const globalIdx = start + idx;
    const item = document.createElement('div');
    item.className = 'rumor-item';
    const sourcesHtml = (r.sources && r.sources.length) ? `
      <div class="sources">
        <strong>參考資料與來源</strong>
        ${r.sources.map(s=>{
          // 物件型態：{ url, date, title }
          if (typeof s === 'object' && s.url){
            const isFb = /facebook\.com/i.test(s.url);
            const icon = isFb ? '<span class="src-ico fb">f</span>' : '<span class="src-ico">🔗</span>';
            const platform = isFb ? '吳宗憲 Facebook' : '外部連結';
            const meta = [s.date, platform].filter(Boolean).join(' · ');
            return `<div class="src-link">${icon}<a href="${s.url}" target="_blank" rel="noopener noreferrer"><span class="src-title">${s.title || s.url}</span><span class="src-meta">${meta} ↗</span></a></div>`;
          }
          // 字串：URL 自動偵測
          if (typeof s === 'string' && /^https?:\/\//.test(s)){
            const isFb = /facebook\.com/i.test(s);
            const label = isFb ? '吳宗憲臉書原文' : s;
            const icon  = isFb ? '<span class="src-ico fb">f</span>' : '<span class="src-ico">🔗</span>';
            return `<div class="src-link">${icon}<a href="${s}" target="_blank" rel="noopener noreferrer">${label} ↗</a></div>`;
          }
          // 純文字
          return `<div>· ${s}</div>`;
        }).join('')}
      </div>` : '';
    item.innerHTML = `
      <div class="head">
        <span class="badge">NO.${String(globalIdx+1).padStart(2,'0')}</span>
        <span class="date">${r.date}</span>
        <span class="q">${r.q}</span>
        <span class="chev">▾</span>
      </div>
      <div class="body">
        <span class="label false">不實訊息</span>
        <p>${r.false_claim}</p>
        <span class="label truth">事實澄清</span>
        <p>${r.truth}</p>
        ${sourcesHtml}
      </div>`;
    item.querySelector('.head').onclick = () => {
      const open = item.hasAttribute('open');
      if (open) item.removeAttribute('open'); else item.setAttribute('open','');
    };
    rlist.appendChild(item);
  });
  renderRumorPagination();
}

function renderRumorPagination(){
  const pag = document.getElementById('rumorPagination');
  const totalPages = Math.ceil(RUMORS.length / RUMORS_PER_PAGE);
  if (totalPages <= 1){ pag.innerHTML = ''; return; }
  let h = '';
  h += `<button ${currentRumorPage===1?'disabled':''} data-go="${currentRumorPage-1}">‹ 上一頁</button>`;
  for (let i = 1; i <= totalPages; i++){
    h += `<button class="${i===currentRumorPage?'on':''}" data-go="${i}">${i}</button>`;
  }
  h += `<button ${currentRumorPage===totalPages?'disabled':''} data-go="${currentRumorPage+1}">下一頁 ›</button>`;
  h += `<span class="info">共 ${RUMORS.length} 則闢謠</span>`;
  pag.innerHTML = h;
  pag.querySelectorAll('button[data-go]').forEach(b => {
    b.onclick = () => {
      const p = parseInt(b.dataset.go);
      const totalP = Math.ceil(RUMORS.length / RUMORS_PER_PAGE);
      if (p >= 1 && p <= totalP){
        renderRumorPage(p);
        const top = document.getElementById('rumor').offsetTop - 60;
        window.scrollTo({top, behavior:'smooth'});
      }
    };
  });
}

renderRumorPage(1);

/* ============ TWEAKS ============ */
const state = { ...TWEAK_DEFAULTS, ...JSON.parse(localStorage.getItem('yilan2026-v3') || '{}') };
function saveLocal(){ localStorage.setItem('yilan2026-v3', JSON.stringify(state)); }

function applyAll(){
  document.documentElement.setAttribute('data-blue', state.blueShade);
  document.documentElement.setAttribute('data-density', state.density);
  document.querySelectorAll('[data-bind="name"]').forEach(el => el.textContent = state.candidateName);
  document.querySelectorAll('#tk-blue button').forEach(b => b.classList.toggle('on', b.dataset.v === state.blueShade));
  document.querySelectorAll('#tk-density button').forEach(b => b.classList.toggle('on', b.dataset.v === state.density));
  document.getElementById('tk-name').value = state.candidateName;
  document.getElementById('tk-slogan').value = state.slogan;
}
function setKey(k, v){
  state[k] = v; saveLocal(); applyAll();
  try { window.parent.postMessage({type:'__edit_mode_set_keys', edits:{[k]: v}}, '*'); } catch(e){}
}
document.querySelectorAll('#tk-blue button').forEach(b => b.onclick = () => setKey('blueShade', b.dataset.v));
document.querySelectorAll('#tk-density button').forEach(b => b.onclick = () => setKey('density', b.dataset.v));
document.getElementById('tk-name').oninput = e => setKey('candidateName', e.target.value);
document.getElementById('tk-slogan').oninput = e => setKey('slogan', e.target.value);
document.getElementById('tweaksClose').onclick = () => document.getElementById('tweaks').classList.remove('show');

window.addEventListener('message', (e) => {
  const d = e.data || {};
  if (d.type === '__activate_edit_mode') document.getElementById('tweaks').classList.add('show');
  if (d.type === '__deactivate_edit_mode') document.getElementById('tweaks').classList.remove('show');
});
try { window.parent.postMessage({type:'__edit_mode_available'}, '*'); } catch(e){}

/* reveal */
const io = new IntersectionObserver(es => es.forEach(e => e.isIntersecting && e.target.classList.add('in')), { threshold: .1 });
setTimeout(() => {
  document.querySelectorAll('.policy-card, .video-card, .rumor-item, .section-head, .policy-feature').forEach(el => { el.classList.add('reveal'); io.observe(el); });
}, 50);

/* active nav */
const navLinks = document.querySelectorAll('nav.main a');
const ids = ['policy','video','rumor','donate'];
const navIO = new IntersectionObserver(entries => {
  entries.forEach(en => {
    if (en.isIntersecting){
      navLinks.forEach(a => a.classList.toggle('active', a.getAttribute('href') === '#' + en.target.id));
    }
  });
}, { rootMargin: '-40% 0px -55% 0px' });
ids.forEach(id => navIO.observe(document.getElementById(id)));

applyAll();
</script>
</body>
