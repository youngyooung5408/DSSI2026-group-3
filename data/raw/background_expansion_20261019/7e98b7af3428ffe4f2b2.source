      <div class="frame"></div>
      <img src="assets/candidate-2026.jpg?v=6" alt="吳宗憲" />
      <span class="name-stamp">吳宗憲</span>
    </div>
  </div>
</section>

<!-- ========== 1 · 政見 ========== -->
<section class="block" id="policy">
  <div class="container">
    <div class="section-head">
      <div class="lead">
        <div class="num" aria-label="政見">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><polyline points="9 14 11 16 15 12"/></svg>
        </div>
        <h2>政見主張
          <small>POLICY · 三明治減壓 · 挺立！三明治世代 · 宜蘭線+1</small>
        </h2>
      </div>
      <div class="more"><a href="https://www.facebook.com/jameswu88" target="_blank" rel="noopener">前往臉書查看完整政見 ↗</a></div>
    </div>

    <!-- FEATURED: 挺立！三明治世代 三明治世代要減壓四大政見 -->
    <div class="policy-feature">
      <div class="big-label">
        <div class="t">挺立<br>三明治世代</div>
        <div class="sub">FLAGSHIP POLICY</div>
      </div>
      <div>
        <h3>「三明治世代要減壓」四大政見</h3>
        <p class="lede">走訪基層，最常聽到的是家庭的現實壓力：房貸要繳、孩子要養、長輩要顧。挺立就是「挺你」，要跟三明治世代一起減壓，把家庭撐住。從「家庭最辛苦的是什麼」開始規劃，用最實際的減壓方案，讓宜蘭走新路。</p>
        <div class="four">
          <div class="it">
            <div class="k">01 · 小寶貝，我來挺</div>
            <div class="v">0–3 歲 每月 1,000 元<br>嬰幼兒用品消費券</div>
          </div>
          <div class="it">
            <div class="k">02 · 托育擴能</div>
            <div class="v">一鄉鎮一公托<br>擴大公托量能</div>
          </div>
          <div class="it">
            <div class="k">03 · 老大人，我來顧</div>
            <div class="v">免健保費門檻<br>下調至 65 歲</div>
          </div>
          <div class="it">
            <div class="k">04 · 敬老金</div>
            <div class="v">65 歲以上擴大發放<br>重陽敬老金</div>
          </div>
        </div>
      </div>
    </div>

    <!-- CATEGORY TABS -->
    <div class="pol-tabs" id="polTabs">
      <button class="on" data-cat="all">全部 <span class="c" id="cnt-all"></span></button>
      <button data-cat="social">社福家庭 <span class="c" id="cnt-social"></span></button>
      <button data-cat="labor">勞工 <span class="c" id="cnt-labor"></span></button>
      <button data-cat="traffic">交通建設 <span class="c" id="cnt-traffic"></span></button>
      <button data-cat="youth">兒少婦幼 <span class="c" id="cnt-youth"></span></button>
      <button data-cat="education">教育 <span class="c" id="cnt-education"></span></button>
      <button data-cat="agri">農漁業 <span class="c" id="cnt-agri"></span></button>
      <button data-cat="sports">體育 <span class="c" id="cnt-sports"></span></button>
      <button data-cat="industry">產業科技 <span class="c" id="cnt-industry"></span></button>
    </div>

    <div class="policy-grid" id="policyGrid"></div>
    <div class="pagination" id="policyPagination"></div>
  </div>
</section>

<!-- ========== 2 · 新聞影音 ========== -->
