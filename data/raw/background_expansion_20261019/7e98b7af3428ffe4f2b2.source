const PER_PAGE = 6;
let currentPage = 1;

function renderVideoPage(page){
  const prev = currentPage;
  currentPage = page;
  const list = document.getElementById('videoList');
  list.innerHTML = '';
  const start = (page - 1) * PER_PAGE;
  const items = VIDEOS.slice(start, start + PER_PAGE);
  items.forEach(v => {
    const a = document.createElement('a');
    a.className = 'video-card';
    a.href = v.link; a.target = '_blank'; a.rel = 'noopener noreferrer';
    // 每個類別一組配色（漸層 + 前景氛圍）
    const palette = {
      '治水':        ['#0a2a5e','#2563b8','#5bc0eb'],
      '災後重建':    ['#5b1a1a','#a73939','#ffb347'],
      '交通建設':    ['#0e2a4a','#1a4fa0','#ffc736'],
      '縣政預算':    ['#1c3d2e','#2d6a4f','#95d5b2'],
      '產業發展':    ['#2d1f4d','#5a3e9b','#c8a2ff'],
      '立委問政':    ['#0a1a36','#1a3d7a','#e63946'],
      '縣政願景':    ['#0a2342','#2a5184','#f4a261'],
      '勞工政策':    ['#1a3d3a','#2d8c83','#a8e6cf'],
      '婦幼政策':    ['#5b1a3d','#a73974','#ffb3d9'],
      '媒體專訪':    ['#2b1a4e','#5d3a9b','#c4a8f0'],
      '社福政策':    ['#4a2c1a','#9b5f2e','#ffd8a8'],
      '競選活動':    ['#5e1a0a','#b8502a','#ffd166'],
      'default':     ['#0a2a5e','#1a4fa0','#ffc736']
    };
    const p = palette[v.cat] || palette.default;
    // 去掉前綴「立委問政．為宜蘭發聲｜」讓 thumb 標題更乾淨
    const dispTitle = v.title.replace(/^立委問政．為宜蘭發聲[｜|]/, '');

    let thumb;
    if (v.source === 'yt'){
      thumb = `<img src="https://img.youtube.com/vi/${v.id}/mqdefault.jpg" alt="${v.title}" loading="lazy"/>`;
    } else if (v.source === 'yts'){
      // YT Shorts: 9:16 原圖, 用 hqdefault 再用 cover 填滿
      thumb = `<img class="shorts" src="https://img.youtube.com/vi/${v.id}/hqdefault.jpg" alt="${v.title}" loading="lazy"/>`;
    } else {
      // Facebook Reel: 沒有公開 thumb, 自產豐富縮圖
      thumb = `
        <div class="fb-thumb" style="--c1:${p[0]};--c2:${p[1]};--c3:${p[2]}">
          <div class="fb-pattern"></div>
          <div class="fb-content">
            <div class="fb-cat">${v.cat}</div>
            <div class="fb-title">${dispTitle}</div>
            <div class="fb-brand">
              <span class="fb-dot">f</span>
              <span class="fb-lbl">REEL · 問政實錄</span>
            </div>
          </div>
        </div>`;
    }
    const srcMap = {yt:'YOUTUBE', yts:'SHORTS', fb:'FACEBOOK'};
    const srcLabel = srcMap[v.source] || '影片';
    v.srcCls = v.source === 'yts' ? 'yt' : v.source;
    a.innerHTML = `
      <div class="thumb">
        ${thumb}
        <span class="cat">${v.cat}</span>
        <span class="src ${v.srcCls}">${srcLabel}</span>
      </div>
      <div class="info">
        <div class="t">${v.title}</div>
        <div class="m"><span>${v.date}</span><span class="ext">另開視窗 ↗</span></div>
      </div>`;
    list.appendChild(a);
  });
  renderPagination();
  if (prev !== page){
    const top = document.getElementById('video').offsetTop - 60;
    window.scrollTo({top, behavior:'smooth'});
  }
}

function renderPagination(){
  const pag = document.getElementById('videoPagination');
  const totalPages = Math.ceil(VIDEOS.length / PER_PAGE);
  if (totalPages <= 1){ pag.innerHTML = ''; return; }
  let h = '';
  h += `<button ${currentPage===1?'disabled':''} data-go="${currentPage-1}">‹ 上一頁</button>`;
  for (let i = 1; i <= totalPages; i++){
    h += `<button class="${i===currentPage?'on':''}" data-go="${i}">${i}</button>`;
  }
  h += `<button ${currentPage===totalPages?'disabled':''} data-go="${currentPage+1}">下一頁 ›</button>`;
  h += `<span class="info">共 ${VIDEOS.length} 則影音</span>`;
  pag.innerHTML = h;
  pag.querySelectorAll('button[data-go]').forEach(b => {
    b.onclick = () => {
      const p = parseInt(b.dataset.go);
      const totalP = Math.ceil(VIDEOS.length / PER_PAGE);
      if (p >= 1 && p <= totalP) renderVideoPage(p);
    };
  });
}

renderVideoPage(1);

