<script>
/* ============ POLICIES (from 吳宗憲宜蘭政見彙整 2024/04/13) ============ */
const POLICIES = [
  { cat:'traffic', date:'2026/10/02', title:'冬山交流道到底卡在哪？讓我們把路走出來！',
    desc:'國 5 增設冬山交流道已於 113 年 4 月有條件通過可行性評估，真正卡點在成興路聯絡道須達雙向四車道。主張：1、提早啟動地方溝通與查估作業，工程規劃與用地取得一次到位。2、跨部會整合爭取中央專案補助，督促高公局盡速開啟實質工程，把路走出來。',
    link:'https://www.facebook.com/jameswu88/posts/pfbid02B8jyyBocavTPeZJdxJSZkpz3gXqUkySAVA7qkCV7sJoaKUdCWxN9dY1NwmLD4c2el' },
  { cat:'education', date:'2026/09/12', title:'教育四磚，宜蘭向上｜把安心還給校園，家長勁安心',
    desc:'1、教育專案經費：教職員與私幼中低收入生營養午餐全免、專款補助非教學人力與設備、引進正版 AI 軟體協助備課。2、教育推動平台：縣長親自主持定期會議、調降師生比、行政減量。3、教育安定環境：專職校安人員配 AI 電子圍籬、公職律師與心理諮商師駐校、每校每年 8 萬元法律顧問費。4、教育相乘發展：小校大區跨校大聯盟、小校品牌化開放全縣就讀、跨縣市人才共享。',
    link:'https://www.facebook.com/share/p/1EJJVptBHH/' },
  { cat:'sports', date:'2026/09/09', title:'宜蘭運動處今天成立，體育新路正式上場',
    desc:'運動處正式成立，整合場館、選手培訓、全民運動與校園運動資源。後續爭取中央資源推動體育館升級、全齡運動、室內場館與安農溪水域運動基地，改善校園跑道，並爭取全國性、國際性賽事進駐，延伸「宜蘭線＋1」精神區域合作。',
    link:'https://www.facebook.com/share/p/1DSRA7Kieh/' },
  { cat:'youth', date:'2026/09/01', title:'讓爸媽放心托育，也讓照顧者安心工作',
    desc:'1、嬰幼兒用品消費券每月 1,000 元、一鄉鎮一公托。2、推動「安心托育站」：增設臨托、延托、夜托、假日托。3、托育人員留任加給：任職滿 1 年月增 2,000 元，依年資最高月增 1 萬元。4、安全標準：預約制、照顧比最高 1:3，2 歲以下（含夜托）最多 1:2。',
    link:'https://www.facebook.com/share/p/1BxHBuPFSS/' },
  { cat:'labor', date:'2026/08/27', title:'讓敢做事的人，知道縣府挺你',
    desc:'1、設置專任公職律師，協助各局處提早釐清法律風險。2、每所公立學校每年 8 萬元法律顧問費，老師、校長遇爭議有專業可諮詢。3、公教人員因執行職務涉訟提供專案法律支持，依法做事的人不必獨自面對訴訟。',
    link:'https://www.facebook.com/share/p/19K1cFuavs/' },
  { cat:'social', date:'2026/08/10', title:'宜蘭原住民族新路，讓希望留在部落',
    desc:'1、55 歲起，長輩照顧「五力全開」：免健保費／敬老金／皮蛇疫苗／敬老卡／假牙補助。2、原鄉醫療交通整合。3、原鄉托育。4、原民社會住宅。',
    link:'https://www.facebook.com/jameswu88/posts/pfbid02gVCMKak983UiGbgjJQiCaBkc7GRZXWMNdVmkoLnASCsof3XRjQsVboRG87vQ891Jl?locale=zh_TW' },
  { cat:'youth', date:'2026/07/31', title:'宜蘭幼托安全政見—真正接住咱宜蘭的每一個囝仔',
    desc:'1、AI 預警防護網—監管雲導入 AI 預警傷害。2、幼托安全紅綠燈—打破家長資訊不對等。3、教保員喘息救援線—專家協助讓老師喘息。4、第三方吹哨網—做勇敢者的靠山。',
    link:'https://www.facebook.com/jameswu88/posts/pfbid0DZ9hk3vPYJis6hfgx8dF1Up7nncmv8sN6wdCvdxBhGxisVWdezvVVsMqbT7WZTo4l?locale=zh_TW' },
  { cat:'social', date:'2026/07/29', title:'老大人，我來顧—65 歲以上長者每年補助超過 1 萬 7',
    desc:'1、65 歲以上免健保費。2、敬老卡升級，每月 600 點擴大使用範圍。3、縣府加碼重陽敬老金。4、擴大補助長青食堂及社區。',
    link:'https://www.facebook.com/jameswu88/posts/pfbid021yHhpnFcwN5a9uQTe5hB2zbxTqD4Xq8Ps6dwdsgM5THRwMjAHMnbmReqFJaU71jtl?locale=zh_TW' },
  { cat:'traffic', date:'2026/06/25', title:'宜蘭走新路｜打通任督二脈，迎接黃金關鍵十年',
    desc:'打通高鐵、台 62 兩大對外交通動脈，完善台 2 庚及冬山交流道縣內路網，打造宜科生活圈與智慧交通治理中心，讓人流更順、產業進得來、人才留得住，開啟宜蘭下一個黃金十年。',
    link:'https://www.facebook.com/jameswu88/posts/pfbid05UQBrutrgBsED22yyNcRAKqz6W8JX4JMgD9yJLgKbjYfdCDuWHPuSB7cCLVoP3bTl?locale=zh_TW' },
  { cat:'traffic', date:'2026/06/14', title:'救護綠燈｜爭取每一秒，搶救每一命',
    desc:'參考桃園市成功經驗，在宜蘭具急診能力的醫院周邊設置電子圍籬，救護車進入範圍時自動串聯沿線交通號誌、提前調控綠燈疏散車流，讓救護車更快速、更安全抵達醫院。',
    link:'https://www.facebook.com/share/p/1BNTHScDrG/' },
  { cat:'education', date:'2026/06/10', title:'校安四核心 家長勁安心',
    desc:'從四大核心打造校園安全網：1、專業義交進駐校園重點路口。2、主動盤點上下學熱區，改善交通動線。3、增置專責校安人力。4、AI 科技防護網。',
    link:'https://www.facebook.com/jameswu88/posts/pfbid02CdPbDbUTwGyjycdxGub4bjGW4TbJiCA1pt6dUj7a2oquWLiMzwojxp5N8qjqRd3Cl?locale=zh_TW' },
  { cat:'industry', date:'2026/06/01', title:'AI 浪潮來了，宜蘭不能缺席',
    desc:'以宜科既有基礎為出發，推動科技轉骨四大目標：打造宜科、人才返鄉、產業扎根與成立專案小組，走出宜蘭新路，為宜蘭下一個關鍵 10 年提前布局。',
