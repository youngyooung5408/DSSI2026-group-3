<!doctype html>
<html lang="zh-Hant-TW">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<!-- 防止瀏覽器快取 HTML，每次載入都重新檢查是否有新版 -->
<meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
<meta http-equiv="Pragma" content="no-cache" />
<meta http-equiv="Expires" content="0" />
<title>吳宗憲 · 宜蘭 2026 縣長候選人</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@500;700;900&family=Noto+Sans+TC:wght@300;400;500;700;900&display=swap">

<script>
const TWEAK_DEFAULTS = /*EDITMODE-BEGIN*/{
  "blueShade": "navy",
  "density": "comfort",
  "candidateName": "吳宗憲",
  "slogan": "宜蘭，走新路。"
}/*EDITMODE-END*/;
</script>

<style>
  :root {
    --blue-900:#0a2a5e; --blue-800:#103a7a; --blue-700:#1a4fa0; --blue-600:#2563b8; --blue-500:#3b82cf;
    --blue-100:#e8f0fb; --blue-50:#f4f8fd;
    --gold:#ffc736;
    --ink:#0e1726; --ink-2:#2b3a55; --muted:#6b7890;
    --line:#d6ddeb; --line-2:#eef2f8;
    --bg:#fff; --bg-2:#f4f7fc;
    --warn:#c84a1e;
    --sans:"Noto Sans TC",-apple-system,"PingFang TC","Microsoft JhengHei",sans-serif;
    --serif:"Noto Serif TC","Songti TC",serif;
    --edge:clamp(16px,4vw,40px);
    --r:6px;
    --shadow:0 1px 2px rgba(15,30,60,.05),0 8px 24px -12px rgba(15,30,60,.15);
  }
  :root[data-blue="navy"]{--blue-900:#0a2a5e;--blue-800:#103a7a;--blue-700:#1a4fa0;--blue-600:#2563b8;--blue-100:#e8f0fb;}
  :root[data-blue="royal"]{--blue-900:#0e1d6b;--blue-800:#172b8c;--blue-700:#243bb0;--blue-600:#3350cf;--blue-100:#e7eafc;}
  :root[data-blue="sky"]{--blue-900:#123a6e;--blue-800:#195494;--blue-700:#2472bd;--blue-600:#2e8fd1;--blue-100:#e4f2fb;}
  :root[data-density="tight"]{--edge:clamp(14px,3vw,28px);}
  :root[data-density="comfort"]{--edge:clamp(16px,4vw,40px);}
  :root[data-density="spacious"]{--edge:clamp(20px,5vw,64px);}

  *{box-sizing:border-box}
  html,body{margin:0;padding:0;background:var(--bg);color:var(--ink);font-family:var(--sans);-webkit-font-smoothing:antialiased}
  a{color:var(--blue-700);text-decoration:none}a:hover{text-decoration:underline}
  img{max-width:100%;display:block}button{font-family:inherit;cursor:pointer}

  .util{background:var(--blue-900);color:#fff;font-size:12px;padding:6px var(--edge);display:flex;justify-content:space-between;align-items:center}
  .util a{color:#fff;opacity:.85}.util .right{display:flex;gap:14px}

  header.site{background:#fff;border-bottom:3px solid var(--blue-700);position:sticky;top:0;z-index:40}
  header.site .bar{display:grid;grid-template-columns:auto 1fr auto;align-items:center;padding:16px var(--edge);gap:24px}
  .logo{display:flex;align-items:center;gap:14px}
  .logo .mark{width:46px;height:46px;background:#fff;border-radius:50%;display:grid;place-items:center;overflow:hidden;position:relative;flex:none}
  .logo .mark img{width:100%;height:100%;object-fit:contain;display:block}
  .logo .mark-old{display:none;background:var(--blue-700);color:#fff;font-family:var(--serif);font-weight:900;font-size:22px;letter-spacing:-.02em;position:relative}
  .logo .mark::after{content:"";position:absolute;inset:-4px;border:1px solid var(--blue-700);border-radius:50%;opacity:.3}
  .logo .t{line-height:1.1}
  .logo .t .big{font-family:var(--serif);font-weight:900;font-size:22px;color:var(--blue-900)}
  .logo .t .sub{font-size:12px;color:var(--muted);margin-top:3px;letter-spacing:.05em}
  nav.main{display:flex;justify-content:center;gap:4px}
  nav.main a{color:var(--ink);padding:10px 20px;font-size:15px;font-weight:500;border-radius:var(--r)}
  nav.main a:hover{background:var(--blue-100);text-decoration:none;color:var(--blue-800)}
  nav.main a.active{color:var(--blue-800);background:var(--blue-100)}
  .top-cta{display:flex;gap:8px}
  .btn{display:inline-flex;align-items:center;gap:6px;padding:10px 18px;border-radius:var(--r);font-size:14px;font-weight:500;border:1px solid var(--blue-700);background:#fff;color:var(--blue-800);text-decoration:none!important;transition:all .15s}
  .btn:hover{background:var(--blue-100)}
  .btn.primary{background:var(--blue-700);color:#fff}.btn.primary:hover{background:var(--blue-800)}
  .btn.gold{background:var(--gold);border-color:var(--gold);color:var(--blue-900);font-weight:700}
  .btn.gold:hover{background:#ffb300}
  .btn.ghost{border-color:var(--line);color:var(--ink-2)}

  .hero{background:linear-gradient(100deg,var(--blue-900) 0%,var(--blue-800) 55%,var(--blue-700) 100%);color:#fff;padding:52px var(--edge) 64px;position:relative;overflow:hidden}
  .hero::before{content:"";position:absolute;inset:0;background-image:repeating-linear-gradient(135deg,transparent 0 30px,rgba(255,255,255,.03) 30px 31px),radial-gradient(ellipse at 90% 20%,rgba(255,255,255,.12),transparent 50%);pointer-events:none}
  .hero .inner{position:relative;display:grid;grid-template-columns:1.3fr 1fr;gap:40px;align-items:center;max-width:1280px;margin:0 auto}
  .hero .crumb{font-size:13px;opacity:.85;margin-bottom:14px;letter-spacing:.05em;display:flex;align-items:center;gap:10px}
  .hero .crumb::before{content:"";width:28px;height:1px;background:var(--gold);display:inline-block}
  .hero .eyebrow{display:none}
  .hero h1{font-family:var(--sans);font-size:clamp(72px,13vw,168px);line-height:.96;margin:0 0 28px;font-weight:900;letter-spacing:-.02em;text-wrap:balance;color:#fff}
  .hero h1 .l1{display:block;margin-bottom:8px}
  .hero h1 .l2{display:block;display:flex;align-items:center;gap:.06em;flex-wrap:wrap}
  .hero h1 .acc{color:var(--blue-900);background:#fff;padding:.02em .18em .08em;border-radius:.22em;display:inline-block;box-shadow:0 6px 24px rgba(0,0,0,.18)}
  .hero .eyebrow-slogan{font-family:var(--serif);font-size:clamp(14px,1.4vw,18px);color:var(--gold);letter-spacing:.3em;margin-bottom:20px;font-weight:500;display:inline-block;padding:5px 14px;border:1px solid rgba(255,199,54,.55)}
  .hero .sub-slogan{font-size:clamp(17px,1.6vw,20px);margin:0 0 28px;opacity:.95;line-height:1.7;max-width:520px}
  .hero .sub-slogan strong{color:var(--gold);font-weight:700}
  .hero .hero-meta{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:24px}
  .hero .chip{display:inline-flex;align-items:center;gap:6px;padding:6px 12px;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.25);border-radius:999px;font-size:13px}
  .hero .portrait{position:relative;width:100%;max-width:440px;min-width:280px;margin-left:auto;aspect-ratio:4/5}
  .hero .portrait .frame{position:absolute;inset:0;border:1px solid rgba(255,199,54,.35);border-radius:4px;transform:translate(14px,14px)}
  .hero .portrait .bg-stripe{position:absolute;inset:0;background:linear-gradient(180deg,rgba(255,199,54,.12),rgba(10,42,94,.0) 60%),repeating-linear-gradient(135deg,transparent 0 14px,rgba(255,255,255,.05) 14px 15px);border-radius:4px;overflow:hidden}
  .hero .portrait img{position:absolute;left:0;right:0;bottom:0;top:0;width:100%;height:100%;object-fit:cover;object-position:center top;filter:drop-shadow(0 20px 30px rgba(0,0,0,.25));border-radius:4px}
  .hero .portrait .name-stamp{position:absolute;right:-8px;top:28px;background:var(--gold);color:var(--blue-900);padding:10px 18px;font-family:var(--serif);font-weight:900;font-size:18px;letter-spacing:.15em;transform:rotate(2deg);box-shadow:0 4px 12px rgba(0,0,0,.25);z-index:3}
  .hero .portrait .num-stamp{position:absolute;left:-12px;bottom:40px;background:#fff;color:var(--blue-900);padding:8px 14px;font-family:var(--serif);font-weight:900;font-size:28px;letter-spacing:.08em;box-shadow:0 4px 14px rgba(0,0,0,.25);z-index:3;line-height:1}
  .hero .portrait .num-stamp small{display:block;font-size:10px;letter-spacing:.2em;color:var(--blue-700);margin-top:2px;font-weight:600}
  @media (max-width:820px){.hero .inner{grid-template-columns:1fr}.hero .portrait{max-width:240px;margin:0}}

  /* === Hero — 新版視覺（2026/05 看板） === */
  .hero .hero-text{position:relative;z-index:2}
  /* 重要：覆寫掉舊版 .hero h1 的 font-size:clamp(72px,13vw,168px) 與 line-height */
  .hero h1.hero-slogan{display:block;width:100%;max-width:640px;margin:6px 0 26px;padding:0;font-size:0;line-height:0;letter-spacing:0}
  .hero h1.hero-slogan img{width:100%;height:auto;display:block;filter:drop-shadow(0 6px 14px rgba(0,0,0,.35))}
  /* 覆寫舊版 portrait 設定：person_only.png 縮為 1000×1339 */
  .hero .portrait{aspect-ratio:1000/1339;max-width:440px}
  .hero .portrait img{object-fit:cover;object-position:center center}
  @media (max-width:820px){.hero h1.hero-slogan{max-width:min(460px, calc(100vw - 32px));margin:6px auto 20px}.hero .portrait{max-width:280px;margin:0 auto}}

  section.block{padding:60px var(--edge);scroll-margin-top:90px}
  section.block.alt{background:var(--bg-2)}
  section.block .container{max-width:1280px;margin:0 auto}
  .section-head{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;flex-wrap:wrap;padding-bottom:16px;margin-bottom:32px;border-bottom:2px solid var(--blue-700);position:relative}
  .section-head::after{content:"";position:absolute;left:0;bottom:-2px;width:80px;height:4px;background:var(--gold)}
  .section-head .lead{display:flex;align-items:center;gap:14px}
  .section-head .num{background:var(--blue-700);color:#fff;width:48px;height:48px;display:grid;place-items:center;border-radius:var(--r);font-family:var(--serif);font-weight:900;font-size:18px}
  .section-head h2{margin:0;font-family:var(--serif);font-weight:900;font-size:clamp(26px,3vw,36px);color:var(--blue-900);letter-spacing:-.01em}
  .section-head h2 small{display:block;font-family:var(--sans);font-size:13px;color:var(--muted);margin-top:4px;font-weight:400;letter-spacing:.05em}
  .section-head .more a{font-size:14px;color:var(--blue-700);display:inline-flex;align-items:center;gap:6px;font-weight:500}

  /* Policy — category tabs + grid */
  .pol-tabs{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:20px;padding-bottom:4px}
  .pol-tabs button{padding:8px 16px;border:1px solid var(--line);background:#fff;border-radius:999px;font-size:13px;color:var(--ink-2);transition:all .15s}
  .pol-tabs button:hover{border-color:var(--blue-700);color:var(--blue-800)}
  .pol-tabs button.on{background:var(--blue-700);color:#fff;border-color:var(--blue-700)}
  .pol-tabs button .c{display:inline-block;margin-left:6px;background:rgba(255,255,255,.22);color:inherit;padding:1px 7px;border-radius:10px;font-size:11px;font-weight:600}
  .pol-tabs button:not(.on) .c{background:var(--blue-100);color:var(--blue-800)}

  .policy-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
  .policy-card{background:#fff;border:1px solid var(--line);border-radius:var(--r);overflow:hidden;display:flex;flex-direction:column;transition:all .2s;cursor:pointer;text-align:left;padding:0}
  .policy-card:hover{border-color:var(--blue-700);transform:translateY(-2px);box-shadow:var(--shadow)}
  .policy-card .top{padding:16px 20px;background:linear-gradient(135deg,var(--blue-800),var(--blue-600));color:#fff;display:flex;justify-content:space-between;align-items:flex-start;position:relative;overflow:hidden;min-height:72px}
  .policy-card .top::before{content:"";position:absolute;inset:0;background-image:repeating-linear-gradient(135deg,transparent 0 18px,rgba(255,255,255,.06) 18px 19px)}
  .policy-card .top .cat{font-size:11px;letter-spacing:.15em;opacity:.85;position:relative;z-index:1}
  .policy-card .top .date{font-family:monospace;font-size:11px;opacity:.7;position:relative;z-index:1}
  .policy-card .body{padding:18px 20px 20px;flex:1;display:flex;flex-direction:column}
  .policy-card h3{font-family:var(--serif);margin:0 0 10px;font-size:19px;font-weight:700;color:var(--ink);line-height:1.35}
  .policy-card p{margin:0 0 14px;font-size:13.5px;line-height:1.7;color:var(--ink-2)}
  .policy-card ul{margin:0 0 14px;padding-left:18px;font-size:13px;color:var(--ink-2);line-height:1.7}
  .policy-card ul li{margin-bottom:4px}
  .policy-card .more-link{margin-top:auto;font-size:12px;color:var(--blue-700);display:inline-flex;align-items:center;gap:4px;font-weight:500}
  @media (max-width:960px){.policy-grid{grid-template-columns:repeat(2,1fr)}}
  @media (max-width:600px){.policy-grid{grid-template-columns:1fr}}

  /* Featured policy */
  .policy-feature{background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:28px 32px;margin-bottom:24px;position:relative;border-left:6px solid var(--gold);display:grid;grid-template-columns:auto 1fr;gap:28px;align-items:start}
  .policy-feature .big-label{background:var(--blue-900);color:var(--gold);padding:16px 20px;border-radius:var(--r);text-align:center;min-width:160px}
  .policy-feature .big-label .t{font-family:var(--serif);font-size:22px;font-weight:900;letter-spacing:.04em;line-height:1.2}
  .policy-feature .big-label .sub{font-size:11px;opacity:.8;margin-top:4px;letter-spacing:.12em}
  .policy-feature h3{font-family:var(--serif);margin:0 0 12px;font-size:26px;color:var(--blue-900);font-weight:900}
  .policy-feature .lede{font-size:15px;color:var(--ink-2);line-height:1.75;margin:0 0 16px}
  .policy-feature .four{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
  .policy-feature .four .it{background:var(--blue-50);padding:14px;border-radius:var(--r);border-top:3px solid var(--blue-700)}
  .policy-feature .four .it .k{font-size:11px;color:var(--blue-700);font-weight:700;letter-spacing:.1em;margin-bottom:4px}
  .policy-feature .four .it .v{font-family:var(--serif);font-size:16px;font-weight:700;color:var(--ink);line-height:1.35}
  @media (max-width:820px){.policy-feature{grid-template-columns:1fr}.policy-feature .four{grid-template-columns:repeat(2,1fr)}}

  /* Video section */
  .video-list{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
  .video-card{background:#fff;border:1px solid var(--line);border-radius:var(--r);overflow:hidden;transition:all .2s;text-align:left;display:flex;flex-direction:column;text-decoration:none!important;color:inherit}
  .video-card:hover{border-color:var(--blue-700);box-shadow:var(--shadow);transform:translateY(-2px)}
  .video-card .thumb{aspect-ratio:16/9;background:#0a1a36;position:relative;overflow:hidden}
  .video-card .thumb img{width:100%;height:100%;object-fit:cover;transition:transform .3s}
  .video-card:hover .thumb img{transform:scale(1.04)}
  .video-card .thumb::after{content:"▶";color:#fff;position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:54px;height:54px;background:rgba(10,42,94,.88);border-radius:50%;display:grid;place-items:center;font-size:18px;padding-left:3px;transition:all .2s}
  .video-card:hover .thumb::after{background:var(--blue-700);transform:translate(-50%,-50%) scale(1.08)}
  .video-card .thumb .src{position:absolute;right:8px;bottom:8px;background:rgba(0,0,0,.78);color:#fff;font-size:10px;padding:3px 7px;border-radius:3px;font-weight:600;letter-spacing:.04em}
  .video-card .thumb .src.yt{background:#c00}
  .video-card .thumb .src.fb{background:#1877f2}
  .video-card .thumb .cat{position:absolute;left:8px;top:8px;background:var(--blue-700);color:#fff;font-size:10px;padding:3px 8px;border-radius:3px;font-weight:600;letter-spacing:.05em}
  .video-card .thumb .fb-fallback{position:absolute;inset:0;display:grid;place-items:center;background:linear-gradient(135deg,#1877f2,#0a47a1);color:#fff;text-align:center;padding:20px}
  .video-card .thumb .fb-fallback .ico{font-family:var(--serif);font-size:48px;font-weight:900;line-height:1;margin-bottom:8px}
  .video-card .thumb .fb-fallback .t{font-size:11px;letter-spacing:.2em;opacity:.85}
  /* YT Shorts: 9:16 source, crop to fill 16:9 */
  .video-card .thumb img.shorts{object-fit:cover;object-position:center 30%}
  /* 豐富化的 FB Reel 縮圖 */
  .video-card .thumb .fb-thumb{position:absolute;inset:0;background:linear-gradient(135deg,var(--c1) 0%,var(--c2) 60%,var(--c2) 100%);color:#fff;overflow:hidden}
  .video-card .thumb .fb-pattern{position:absolute;inset:0;
    background-image:
      radial-gradient(circle at 92% 12%,var(--c3) 0,transparent 35%),
      radial-gradient(circle at 8% 95%,rgba(255,255,255,.18) 0,transparent 40%),
      repeating-linear-gradient(135deg,transparent 0 24px,rgba(255,255,255,.06) 24px 25px);
    opacity:.9;mix-blend-mode:screen}
  .video-card .thumb .fb-thumb::after{content:"";position:absolute;right:-30px;top:-30px;width:130px;height:130px;border:2px solid rgba(255,255,255,.15);border-radius:50%}
  .video-card .thumb .fb-content{position:relative;padding:16px 18px;display:flex;flex-direction:column;justify-content:space-between;height:100%;z-index:2}
  .video-card .thumb .fb-cat{display:inline-flex;align-self:flex-start;background:rgba(255,255,255,.95);color:var(--c1);font-size:11px;padding:4px 10px;font-weight:700;letter-spacing:.08em;border-radius:2px}
  .video-card .thumb .fb-title{font-family:var(--serif);font-size:17px;font-weight:700;line-height:1.35;margin:10px 0;max-width:86%;text-shadow:0 2px 8px rgba(0,0,0,.25);
    display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
  .video-card .thumb .fb-brand{display:flex;align-items:center;gap:8px;font-size:10.5px;letter-spacing:.15em;opacity:.9}
  .video-card .thumb .fb-brand .fb-dot{display:inline-grid;place-items:center;width:20px;height:20px;background:#fff;color:var(--c1);font-family:var(--serif);font-weight:900;font-size:14px;border-radius:3px}
  .video-card .thumb .fb-brand .fb-lbl{font-weight:600}
  .video-card .info{padding:14px 16px 16px;flex:1;display:flex;flex-direction:column}
  .video-card .info .t{font-size:14.5px;font-weight:600;color:var(--ink);line-height:1.5;margin-bottom:10px}
  .video-card .info .m{font-size:11px;color:var(--muted);display:flex;justify-content:space-between;margin-top:auto;padding-top:8px;border-top:1px solid var(--line-2)}
  .video-card .info .m .ext{color:var(--blue-700);font-weight:500}
  @media (max-width:900px){.video-list{grid-template-columns:repeat(2,1fr)}}
  @media (max-width:520px){.video-list{grid-template-columns:1fr}}

  /* Pagination */
  .pagination{display:flex;justify-content:center;align-items:center;gap:4px;margin-top:32px;flex-wrap:wrap}
  .pagination button{min-width:38px;height:38px;padding:0 10px;border:1px solid var(--line);background:#fff;color:var(--ink-2);border-radius:var(--r);font-size:14px;font-weight:500;transition:all .15s}
  .pagination button:hover:not(:disabled){border-color:var(--blue-700);color:var(--blue-800)}
  .pagination button.on{background:var(--blue-700);color:#fff;border-color:var(--blue-700)}
  .pagination button:disabled{opacity:.4;cursor:not-allowed}
  .pagination .info{font-size:12px;color:var(--muted);margin:0 12px}

  /* Rumor section */
  .rumor-intro{background:linear-gradient(135deg,#fff3e8,#ffe4c8);border-left:5px solid var(--warn);padding:20px 24px;border-radius:var(--r);margin-bottom:28px;display:flex;gap:16px;align-items:flex-start}
  .rumor-intro .icon{width:40px;height:40px;flex-shrink:0;background:var(--warn);color:#fff;border-radius:50%;display:grid;place-items:center;font-family:var(--serif);font-weight:900;font-size:22px}
  .rumor-intro .txt h3{margin:0 0 6px;font-family:var(--serif);font-size:18px;color:var(--blue-900)}
  .rumor-intro .txt p{margin:0;font-size:14px;color:var(--ink-2);line-height:1.6}
  .rumor-list{display:grid;gap:12px}
  .rumor-item{background:#fff;border:1px solid var(--line);border-radius:var(--r);overflow:hidden}
  .rumor-item .head{display:grid;grid-template-columns:56px 90px 1fr auto;gap:16px;align-items:center;padding:16px 20px;cursor:pointer;border-left:4px solid var(--warn);background:#fff;transition:background .15s}
  .rumor-item .head:hover{background:var(--blue-50)}
  .rumor-item .badge{background:var(--warn);color:#fff;font-size:11px;font-weight:700;padding:4px 6px;border-radius:3px;text-align:center;letter-spacing:.1em}
  .rumor-item .date{font-family:monospace;font-size:12px;color:var(--muted)}
  .rumor-item .q{font-family:var(--serif);font-size:16px;font-weight:700;color:var(--ink);line-height:1.5}
  .rumor-item .chev{color:var(--blue-700);font-size:18px;transition:transform .2s}
  .rumor-item[open] .chev{transform:rotate(180deg)}
  .rumor-item[open] .head{background:var(--blue-50);border-left-color:var(--blue-700)}
  .rumor-item[open] .badge{background:var(--blue-700)}
  .rumor-item .body{padding:16px 20px 20px 118px;display:none;border-top:1px solid var(--line-2)}
  .rumor-item[open] .body{display:block}
  .rumor-item .body .label{display:inline-block;font-size:11px;letter-spacing:.1em;font-weight:700;padding:3px 8px;border-radius:3px;margin-bottom:8px}
  .rumor-item .body .label.false{background:#fde2d6;color:var(--warn)}
  .rumor-item .body .label.truth{background:#dff0d8;color:#2a7a3f}
  .rumor-item .body p{margin:0 0 14px;font-size:14px;line-height:1.8;color:var(--ink-2)}
  .rumor-item .body .sources{background:var(--bg-2);border-left:3px solid var(--blue-700);padding:10px 14px;font-size:12px;color:var(--muted);margin-top:10px}
  .rumor-item .body .sources strong{color:var(--ink-2);display:block;margin-bottom:6px}
  .rumor-item .body .sources .src-link{display:flex;align-items:flex-start;gap:10px;padding:8px 0;border-bottom:1px dashed var(--line-2)}
  .rumor-item .body .sources .src-link:last-child{border-bottom:0}
  .rumor-item .body .sources .src-link a{color:var(--blue-700);font-weight:500;font-size:13px;word-break:break-word;display:block;flex:1;text-decoration:none}
  .rumor-item .body .sources .src-link a:hover .src-title{color:var(--blue-900);text-decoration:underline}
  .rumor-item .body .sources .src-title{display:block;color:var(--ink);font-weight:600;font-size:13.5px;line-height:1.55}
  .rumor-item .body .sources .src-meta{display:block;color:var(--muted);font-size:11.5px;letter-spacing:.04em;margin-top:3px;font-weight:400}
  .rumor-item .body .sources .src-ico{flex:none;width:20px;height:20px;display:inline-grid;place-items:center;background:#1877f2;color:#fff;border-radius:3px;font-family:var(--serif);font-weight:900;font-size:13px}
  .rumor-item .body .sources .src-ico.fb{background:#1877f2}
  @media (max-width:720px){.rumor-item .head{grid-template-columns:auto 1fr auto;gap:10px}.rumor-item .date{display:none}.rumor-item .body{padding-left:20px}}

  /* Donate section */
  .donate-grid{display:grid;grid-template-columns:1.15fr 1fr;gap:28px;align-items:stretch}
  .donate-info{background:#fff;border:1px solid var(--line);border-left:6px solid var(--gold);border-radius:var(--r);padding:28px 30px;display:flex;flex-direction:column}
  .donate-row{display:grid;grid-template-columns:72px 1fr;gap:16px;padding:14px 0;border-bottom:1px dashed var(--line-2);align-items:center}
  .donate-row:first-child{padding-top:4px}
  .donate-row.last{border-bottom:0}
  .donate-row .k{background:var(--blue-700);color:#fff;text-align:center;padding:8px 0;font-size:13px;font-weight:600;letter-spacing:.15em;border-radius:var(--r);font-family:var(--serif)}
  .donate-row .v{font-family:var(--serif);font-size:16px;color:var(--ink);font-weight:500;line-height:1.5}
  .donate-row .v.acct{font-family:"SF Mono","Menlo",monospace;font-size:22px;letter-spacing:.08em;font-weight:700;color:var(--blue-900)}
  .donate-cta{margin:22px 0 6px;display:flex;gap:10px;flex-wrap:wrap;align-items:center}
  .donate-cta .btn.gold{padding:14px 28px;font-size:15px;letter-spacing:.05em}
  .donate-cta .hint{font-size:12px;color:var(--muted);letter-spacing:.04em}
  .donate-notes{margin-top:auto;background:var(--bg-2);border-radius:var(--r);padding:16px 20px;font-size:13px;color:var(--ink-2);line-height:1.75}
  .donate-notes strong{display:block;color:var(--blue-800);font-family:var(--serif);font-size:14px;margin-bottom:6px;letter-spacing:.04em}
  .donate-notes ol{margin:0;padding-left:20px}
  .donate-notes ol li{margin-bottom:2px}
  .donate-qr-card{background:linear-gradient(160deg,var(--blue-900) 0%,var(--blue-800) 60%,var(--blue-700) 100%);color:#fff;border-radius:var(--r);overflow:hidden;box-shadow:var(--shadow);position:relative;padding:28px 24px;display:flex;flex-direction:column;align-items:center;text-align:center}
  .donate-qr-card::before{content:"";position:absolute;inset:0;background-image:repeating-linear-gradient(135deg,transparent 0 22px,rgba(255,255,255,.05) 22px 23px);pointer-events:none}
  .donate-qr-card .qr-eyebrow{position:relative;font-family:var(--serif);font-size:11px;letter-spacing:.3em;color:var(--gold);padding:4px 10px;border:1px solid rgba(255,199,54,.55);display:inline-block;margin-bottom:14px}
  .donate-qr-card h3{position:relative;margin:0 0 8px;font-family:var(--serif);font-weight:900;font-size:24px;color:#fff;letter-spacing:.04em}
  .donate-qr-card p.qr-hint{position:relative;margin:0 0 20px;font-size:13px;color:rgba(255,255,255,.85);line-height:1.6}
  .donate-qr-card .qr-frame{position:relative;background:#fff;padding:14px;border-radius:var(--r);box-shadow:0 8px 24px rgba(0,0,0,.25);max-width:260px;width:100%}
  .donate-qr-card .qr-frame img{width:100%;height:auto;display:block}
  .donate-qr-card .qr-foot{position:relative;margin-top:18px;font-family:var(--serif);font-size:13px;letter-spacing:.2em;color:var(--gold);font-weight:700}
  @media (max-width:820px){.donate-grid{grid-template-columns:1fr;gap:20px}.donate-info{padding:22px 20px}.donate-row .v.acct{font-size:18px}.donate-qr-card{padding:24px 20px}}

  /* Mobile-friendly sticky donate button */
  .mobile-donate-fab{display:none;position:fixed;right:16px;bottom:16px;z-index:35;background:var(--gold);color:var(--blue-900);font-weight:700;padding:14px 22px;border-radius:999px;box-shadow:0 8px 24px rgba(15,30,60,.25);text-decoration:none!important;font-size:15px;letter-spacing:.05em;border:2px solid var(--blue-900)}
  .mobile-donate-fab:hover{background:#ffb300;transform:translateY(-1px)}
  @media (max-width:720px){.mobile-donate-fab{display:inline-flex;align-items:center;gap:6px}}

  .contact-strip{background:var(--blue-900);color:#fff;padding:44px var(--edge);text-align:center}
  .contact-strip h3{font-family:var(--serif);margin:0 0 10px;font-size:24px}
  .contact-strip p{margin:0 0 16px;opacity:.85}
  .contact-strip .lines{display:inline-flex;gap:24px;flex-wrap:wrap;justify-content:center;font-size:14px}
  .contact-strip .lines span::before{content:"· ";opacity:.5;margin-right:4px}

  /* Social follow grid (在聯絡區內) */
  .social-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;max-width:760px;margin:28px auto 0}
  .social-card{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.14);border-radius:var(--r,8px);padding:18px 14px 16px;display:flex;flex-direction:column;align-items:center;gap:12px;text-decoration:none!important;color:#fff;transition:all .18s}
  .social-card:hover{background:rgba(255,255,255,.12);border-color:rgba(255,255,255,.32);transform:translateY(-2px)}
  .social-card .ico{width:46px;height:46px;border-radius:12px;display:grid;place-items:center;flex:none}
  .social-card .ico svg{width:26px;height:26px;display:block}
  .social-card .ico.fb{background:#1877f2}
  .social-card .ico.ig{background:linear-gradient(45deg,#f09433,#e6683c 25%,#dc2743 50%,#cc2366 75%,#bc1888)}
  .social-card .ico.yt{background:#ff0000}
  .social-card .ico.x{background:#000}
  .social-card .pname{font-size:14px;font-weight:600;letter-spacing:.02em}
  .social-card .phandle{font-size:11px;opacity:.65;margin-top:-6px;word-break:break-all}
  .social-card .qr{width:108px;height:108px;background:#fff;border-radius:8px;padding:7px;margin-top:2px}
  .social-card .qr img{width:100%;height:100%;display:block}
  .social-card .qr-hint{font-size:10px;opacity:.55;letter-spacing:.08em;margin-top:-4px}
  .social-card .tap-hint{display:none;font-size:11px;opacity:.7;letter-spacing:.05em}
  @media (max-width:720px){
    .social-grid{grid-template-columns:repeat(2,1fr);gap:12px;max-width:420px}
    .social-card .qr,.social-card .qr-hint{display:none}
    .social-card .tap-hint{display:block}
    .social-card .phandle{margin-top:-4px}
  }
  @media (max-width:380px){.social-grid{grid-template-columns:1fr}}

  footer.site{background:#0b1a36;color:#a9b5cc;padding:32px var(--edge) 20px;font-size:13px}
  footer.site .row{max-width:1280px;margin:0 auto;display:flex;justify-content:space-between;flex-wrap:wrap;gap:16px}
  footer.site a{color:#d6dfef}
  footer.site .links{display:flex;gap:20px;flex-wrap:wrap}
  footer.site .foot{max-width:1280px;margin:16px auto 0;padding-top:16px;border-top:1px solid rgba(255,255,255,.08);font-size:12px;opacity:.65}

  #tweaks{position:fixed;right:20px;bottom:20px;z-index:200;width:300px;background:#fff;border:1px solid var(--line);border-radius:var(--r);box-shadow:0 20px 60px -20px rgba(0,0,0,.25);display:none;font-size:13px}
  #tweaks.show{display:block}
  #tweaks header{display:flex;justify-content:space-between;align-items:center;padding:12px 16px;border-bottom:1px solid var(--line-2);font-family:var(--serif);font-weight:700}
  #tweaks header button{border:0;background:transparent;font-size:18px;cursor:pointer;color:var(--muted)}
  #tweaks .body{padding:14px 16px;display:grid;gap:14px}
  #tweaks label{font-size:11px;text-transform:uppercase;letter-spacing:.12em;color:var(--muted);display:block;margin-bottom:6px;font-weight:600}
  #tweaks .chips{display:flex;flex-wrap:wrap;gap:6px}
  #tweaks .chips button{border:1px solid var(--line);background:#fff;padding:6px 12px;border-radius:999px;font-size:12px;color:var(--ink-2)}
  #tweaks .chips button.on{background:var(--blue-700);color:#fff;border-color:var(--blue-700)}
  #tweaks input[type="text"]{width:100%;padding:8px 10px;border:1px solid var(--line);background:#fff;font:inherit;font-size:13px;border-radius:var(--r)}

  .reveal{opacity:0;transform:translateY(14px);transition:opacity .7s ease,transform .7s ease}
  .reveal.in{opacity:1;transform:none}

  @media print{#tweaks{display:none!important}}
</style>
</head>
<body>

<div class="util">
  <span>吳宗憲 2026 宜蘭縣長競選辦公室 · 官方網站</span>
