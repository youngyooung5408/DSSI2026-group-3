<!-- ========== TIMELINE 參選之路 ========== -->
<section id="timeline" class="section cream">
  <div class="container" style="max-width:940px">
    <div class="section-head single">
      <div>
        <div class="section-label fade-in">JOURNEY</div>
        <h2 class="section-title sf fade-in">參選之路</h2>
        <p class="section-desc fade-in">從學者走入地方，何志勇一步步為新竹市民構築城市願景。</p>
      </div>
    </div>
    <div class="timeline-shell">
      <div class="timeline-line"></div>
