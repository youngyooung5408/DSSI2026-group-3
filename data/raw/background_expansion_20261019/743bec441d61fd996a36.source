n_dashboard":7,"on_website":7,"color":20,"video_uri":20,"video_source":20,"video_type":20},"lwXQdwe7rJ","財經",14,[123,127],{"id":124,"name":125,"sort":64,"action_type":33,"uri":20,"root":18,"sub_types":126,"bg_color":20,"text_color":20,"on_dashboard":18,"on_website":7,"color":20,"video_uri":20,"video_source":20,"video_type":20},"nKX9EMx9yd","房產新勢力",[],{"id":128,"name":129,"sort":69,"action_type":33,"uri":20,"root":18,"sub_types":130,"bg_color":20,"text_color":20,"on_dashboard":18,"on_website":7,"color":20,"video_uri":20,"video_source":20,"video_type":20},"EVN9Yb7edx","保險小幫手",[],{"article_type":132,"id":133,"code":134,"class":135,"created_at":136,"created_dt":137,"publish_at":138,"publish_dt":139,"post_date":140,"post_time":141,"post_dt":142,"wancoin":143,"content":144,"images":145,"video_uri":20,"og_title":151,"og_description":152,"og_image":147,"og_image_width":149,"og_image_height":150,"title":153,"description":152,"image":147,"main_type":154,"sub_types":158,"tags":170,"status":95,"watch_cnt":143,"editer_name":204,"is_adults":18,"is_disclaimer":18,"article_source":205,"links":206,"is_keep":18,"is_love":18,"can_get_wancoin":18,"preview_status":18,"video":207,"theme":12,"editer":208,"review_by":20,"plain_excerpt":209,"word_count":210,"list":211,"related":944,"extending":1256,"posted_at":1595},"article","14a1B9r9xk","N2001581692","text","2026-01-18 11:04:04","2026-01-18T11:04:04+08:00","2026-01-18 11:04:11","2026-01-18T11:04:11+08:00","2026-01-19","10:04:38","2026-01-19T10:04:38+08:00",0,"\u003Cp>\u003Cstrong>要聞中心／綜合報導\u003C/strong>\u003C/p>\u003Cdiv class=\"show-in-md\">\n          \u003Cdiv id=\"div-gpt-ad-1667796770316-0\" class=\"ad-container ad-items\" style=\"min-height: 250px; margin: 15px;\" data-id=\"div-gpt-ad-1667796770316-0\" data-minsize=\"300,250\" data-size0=\"fluid\" data-size1=\"300,250\" data-size2=\"320,100\" data-path=\"/32672392/22_CtiNews_Mobile/22C_Mobile_CP_TopBanner\">\u003C/div>\n        \u003C/div>\u003Cp>2026年地方大選煙硝味已起，台南市議會正迎來縣市合併升格以來最震撼的「世代交替」！隨著年底選戰逼近，台南政壇驚爆史上最大規模的「二代接班」浪潮，多位叱吒風雲的藍綠、無黨籍資深議員紛紛宣布退居幕後。這不只是家族香火的延續，更是一場高學歷「碩士軍團」的政治肉搏戰，預告著台南市議會版圖將面臨全面洗牌。\u003C/p>\u003Cdiv data-ad-part=\"true\">\u003C/div>\u003Cfigure class=\"image\">\u003Cimg loading=\"lazy\" style=\"aspect-ratio:1547/1031;\" src=\"https://storage.ctinews.com/compression/files/default/cut-1768705279-Tkf9kpq.jpg\" width=\"1547\" height=\"1031\" alt=\"台南市議會。（圖／臉書）\">\u003Cfigcaption>台南市議會。（圖／臉書）\u003C/figcaption>\u003C/figure>\u003Cp>\u003Cstrong>震撼彈一：藍綠老將大換血，6大政治家族推「強棒」\u003C/strong>\u003C/p>\n            \u003Cul class=\"article-promote-items promote-items\" style=\"list-style: none; padding-left: 0px;\">\n                \u003Cli>\n                    \u003Ca href=\"https://ctinews.com/news/items/m0x7B0qlav\" target=\"_blank\" class=\"flex items-center\">\n                        \u003Cspan class=\"material-icons-round text-5xl mr-2 flex-shrink-0\"> play_circle_outline \u003C/span>\n                        \u003Cspan>記憶體生死鬥！散戶是不是要殺進去人氣指標華邦電？\u003C/span>\n                    \u003C/a>\n                \u003C/li>\n            \u003C/ul>\u003Cdiv class=\"show-in-md\">\n          \u003Cdiv id=\"div-gpt-ad-1667796806666-0\" class=\"ad-container ad-items\" style=\"min-height: 250px; margin: 15px;\" data-id=\"div-gpt-ad-1667796806666-0\" data-minsize=\"300,250\" data-size0=\"1,1\" data-size1=\"300,250\" data-size2=\"320,480\" data-path=\"/32672392/22_CtiNews_Mobile/22C_Mobile_CP_MiddleBanner\">\u003C/div>\n        \u003C/div>\u003Cp>這波交棒潮橫跨各黨派，共有6席確定換血，且接班人選來頭都不小，被形容為「贏在起跑點」的超級新人：\u003C/p>\u003Cdiv data-ad-part=\"true\">\u003C/div>\u003Cp>•史上罕見「兄弟檔」換手： 最具話題性的莫過於第8選區（中西、北區）的民進黨現任議員沈震東。因兵役考量，他宣布將戰袍交給弟弟、成大化學研究所高材生沈震南，上演罕見的「兄傳弟」戲碼。\u003C/p>\u003Cdiv data-ad-part=\"true\">\u003C/div>\u003Cp>•藍營「女力」交棒： 第3選區國民黨老將尤榮智，早已定調由留美碩士女兒尤淨寬接手；第9選區「安平女兒」林美燕，則派出兒子葉翰勳出征；第10選區資深議員曾培雅，也由擁有台科大碩士學歷的兒子歐政豪接棒。\u003C/p>\n            \u003Cul class=\"article-promote-items promote-items\" style=\"list-style: none; padding-left: 0px;\">\n                \u003Cli>\n                    \u003Ca href=\"https://ctinews.com/news/items/gGaMoBmGnK\" target=\"_blank\" class=\"flex items-center\">\n                        \u003Cspan class=\"material-icons-round text-5xl mr-2 flex-shrink-0\"> play_circle_outline \u003C/span>\n                        \u003Cspan>解放軍突闖東沙　專家曝「三大警訊」！\u003C/span>\n                    \u003C/a>\n                \u003C/li>\n            \u003C/ul>\u003Cdiv data-ad-part=\"true\">\u003C/div>\u003Cp>•綠營「連霸王」退休： 在安南區連任6屆的民進黨老將郭清華，感嘆「該退休了」，宣布由英國名校布里斯托大學碩士畢業的女兒郭品辰接棒，喊出「接棒希望、傳辰未來」。\u003C/p>\u003Cdiv data-ad-part=\"true\">\u003C/div>\u003Cp>&nbsp;無黨轉藍營震撼彈： 永康區無黨籍議員李鎮國拋出震撼彈，宣布不再連任，回歸社區工作。其子李鎮國辦公室執行長李秉倫將接棒，並預計投入「國民黨初選」，為該區選情投下巨大變數。\u003C/p>\u003Cdiv data-ad-part=\"true\">\u003C/div>\u003Cp>\u003Cstrong>震撼彈二：學歷天花板！這屆「政二代」全是學霸\u003C/strong>\u003C/p>\n            \u003Cul class=\"article-promote-items promote-items\" style=\"list-style: none; padding-left: 0px;\">\n                \u003Cli>\n                    \u003Ca href=\"https://ctinews.com/news/items/8knJo049Wo\" target=\"_blank\" class=\"flex items-center\">\n                        \u003Cspan class=\"material-icons-round text-5xl mr-2 flex-shrink-0\"> play_circle_outline \u003C/span>\n                        \u003Cspan>廖雨詩/隨機重大侵害事件頻傳　如何知道「快逃啊」？\u003C/span>\n                    \u003C/a>\n                \u003C/li>\n            \u003C/ul>\u003Cdiv data-ad-part=\"true\">\u003C/div>\u003Cp>別以為這些「二代」只有家族光環，攤開學歷嚇死人！這場選戰儼然成為「學歷軍備競賽」。從郭品辰的英國名校碩士、尤淨寬的美國南加大（USC）碩士，到李秉倫的台南大學公行碩士、歐政豪的台科大碩士，以及成大研究生的沈震南，這批接班人個個擁有高學歷與專業背景，試圖用實力擺脫「靠爸靠媽」的世襲標籤。\u003C/p>\u003Cdiv data-ad-part=\"true\">\u003C/div>\u003Cp>\u003Cstrong>震撼彈三：綠營新人「沒特權」？初選恐陷肉搏戰\u003C/strong>\u003C/p>\u003Cdiv data-ad-part=\"true\">\u003C/div>\u003Cp>儘管擁有家族資源，但想接班可沒那麼容易！民進黨為回應社會觀感，祭出嚴格的「政二代條款」。凡是現任公職三親等內的親屬，在初選民調中「完全不予加權」。這意味著像沈震南、郭品辰這樣的綠營新人，必須在初選中「實打實」地與其他強敵肉搏，沒有任何捷徑可走。\u003C/p>\u003Cdiv data-ad-part=\"true\">\u003C/div>\u003Cp>面對這場「空戰」與「陸戰」交織的現代化選戰，這批背負著家族期待的「最強二代們」，能否順利通過選民的檢驗，將是2026台南選戰最精彩的看點。\u003C/p>\u003Cdiv data-ad-part=\"true\">\u003C/div>",[146],{"url":147,"caption":148,"width":149,"height":150},"https://storage.ctinews.com/compression/files/default/cut-1768705279-Tkf9kpq.jpg","台南市議會。（圖／臉書）",1547,1031,"快訊/「賴清德本命區」大地震！","2026年地方大選煙硝味已起，台南市議會正迎來縣市合併升格以來最震撼的「世代交替」！隨著年底選戰逼近，台南政壇驚爆史上最大規模的「二代接班」浪潮，多位叱吒風雲的藍綠、無黨籍資深議員紛紛宣布退居幕後。這不只是家族香火的延續，更是一場高學歷「碩士軍團」的政治肉搏戰，預告著台南市議會版圖將面臨全面洗牌。","台南政壇大地震！史上最強「接班潮」來襲　6大政治家族交棒",{"id":155,"name":156,"father":157},"0pGeNBBeOx","總覽",{"id":36,"name":37},[159,162,166],{"id":160,"name":37,"father":161},"MPoePGq9m8",{"id":30,"name":31},{"id":163,"name":164,"father":165},"ol3ejjXeXO","政治",{"id":36,"name":37},{"id":167,"name":168,"father":169},"rP7QLGjeyz","選戰",{"id":36,"name":37},[171,174,177,180,183,186,189,192,195,198,201],{"id":172,"name":173},"ql4mE1Nm4Y","2026選戰",{"id":175,"name":176},"kw5dGpaxn9","台南市議會",{"id":178,"name":179},"y85RV8w5G0","政二代",{"id":181,"name":182},"kn2JDyyxaA","初選",{"id":184,"name":185},"y85RvABL5G","台南市議員選舉",{"id":187,"name":188},"9L2VVDR21r","賴清德",{"id":190,"name":191},"r15veVPax6","台南",{"id":193,"name":194},"vl40YyG1x3","2026大選",{"id":196,"name":197},"MP2rwvO64k","賴清德本命區",{"id":199,"name":200},"Kn46W6lkxb","總統本命區",{"id":202,"name":203},"bK2Dl6GR2E","政治家族","王鼎鈞","0",[],null,[],"要聞中心／綜合報導2026年地方大選煙硝味已起，台南市議會正迎來縣市合併升格以來最震撼的「世代交替」！隨著年底選戰逼近，台南政壇驚爆史上最大規模的「二代接班」浪潮，多位叱吒風雲的藍綠、無黨籍資深議員紛紛宣布退居幕後。這不只是家族香火的延續，更是一場高學歷「碩士軍團」的政治肉搏戰，預告著台南市議會版圖",972,[212,738,843],{"id":213,"template":18,"title":214,"more":18,"news":215},"HotNews","熱門",[216,271,313,357,417,442,476,508,540,570,589,621,647,687,733],{"id":217,"title":218,"created_at":219,"created_dt":220,"publish_at":221,"publish_dt":222,"release_at":223,"release_dt":224,"sort":207,"image":225,"news_id":217,"news_type":226,"news_class":135,"tags":229,"use_ad":18,"ad_code":20,"use_link":18,"link":20,"target_type":269,"target_id":217,"url":20,"is_love":18,"is_keep":18,"need_notic":18,"is_adults":18,"video":20,"theme":12,"extending_click":143,"extending_percentage":143,"related_click":143,"related_percentage":143,"post_d