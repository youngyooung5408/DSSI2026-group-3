<style>
#tk-floating-buttons {
    position: fixed !important;
    right: 28px !important;
    bottom: 28px !important;
    width: 48px !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    gap: 10px !important;
    margin: 0 !important;
    padding: 0 !important;
    z-index: 999999 !important;
    pointer-events: none !important;
    transition: bottom .25s ease !important;
    transform: translateX(-1px) !important;
}

#tk-floating-buttons.tk-scrolled {
    bottom: 86px !important;
}

#tk-floating-buttons .tk-floating-button {
    width: 48px !important;
    height: 48px !important;
    min-width: 48px !important;
    min-height: 48px !important;
    max-width: 48px !important;
    max-height: 48px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    margin: 0 !important;
    padding: 0 !important;
    border: 0 !important;
    border-radius: 50% !important;
    box-sizing: border-box !important;
    text-decoration: none !important;
    cursor: pointer !important;
    pointer-events: auto !important;
    overflow: hidden !important;
    box-shadow: 0 3px 9px rgba(0,0,0,.12) !important;
    transition: transform .22s ease, box-shadow .22s ease !important;
}

#tk-floating-buttons .tk-floating-button:hover {
    transform: translateY(-2px) scale(1.05) !important;
    box-shadow: 0 6px 14px rgba(0,0,0,.16) !important;
}

#tk-floating-buttons .tk-floating-button:active {
    transform: scale(.95) !important;
}

#tk-donate-button,
#tk-donate-button:hover,
#tk-donate-button:focus,
#tk-donate-button:visited {
    background: #ef9291 !important;
    color: #fff !important;
    text-decoration: none !important;
}

#tk-donate-button .tk-dollar-icon {
    display: block !important;
    font-family: Georgia, "Times New Roman", serif !important;
    font-size: 24px !important;
    font-weight: 400 !important;
    line-height: 1 !important;
    color: #fff !important;
    animation: tk-dollar-bounce 3.2s ease-in-out infinite !important;
}

@keyframes tk-dollar-bounce {
    0%,72%,100% { transform: translateY(0); }
    78% { transform: translateY(-4px); }
    84% { transform: translateY(0); }
    89% { transform: translateY(-2px); }
    94% { transform: translateY(0); }
}

#tk-line-button,
#tk-line-button:hover,
#tk-line-button:focus,
#tk-line-button:visited {
    background: #06C755 !important;
    color: #fff !important;
    text-decoration: none !important;
}

#tk-line-button .tk-line-text {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    font-family: Arial, Helvetica, sans-serif !important;
    font-size: 9px !important;
    font-weight: 700 !important;
    line-height: 1 !important;
    color: #fff !important;
}

#tk-mobile-bottom-bar {
    display: none !important;
}

@media (max-width: 767px) {

    #tk-floating-buttons {
        display: none !important;
    }

    #tk-mobile-bottom-bar {
        position: fixed !important;
        left: 0 !important;
        right: 0 !important;
        bottom: 0 !important;
        width: 100% !important;
        height: 40px !important;

        display: flex !important;
        align-items: center !important;

        margin: 0 !important;
        padding: 0 !important;

        box-sizing: border-box !important;

        background: rgba(245,245,245,.97) !important;
        border-top: 1px solid rgba(0,0,0,.07) !important;
        box-shadow: 0 -1px 4px rgba(0,0,0,.05) !important;

        z-index: 9999999 !important;
    }

    #tk-mobile-bottom-bar .tk-mobile-bottom-button {
        position: relative !important;

        flex: 1 1 50% !important;
        width: 50% !important;
        height: 40px !important;

        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        gap: 6px !important;

        margin: 0 !important;
        padding: 0 8px !important;

        box-sizing: border-box !important;

        border: 0 !important;
        background: transparent !important;
        text-decoration: none !important;

        font-family: Arial, "Noto Sans TC", sans-serif !important;
        font-size: 12px !important;
        font-weight: 600 !important;
        line-height: 1 !important;
        letter-spacing: .2px !important;

        -webkit-tap-highlight-color: transparent !important;

        animation: none !important;
        transition: none !important;
        transform: none !important;
    }

    #tk-mobile-donate::after {
        content: "";
        position: absolute !important;
        right: 0 !important;
        top: 9px !important;
        width: 1px !important;
        height: 22px !important;
        background: rgba(0,0,0,.10) !important;
    }

    #tk-mobile-donate,
    #tk-mobile-donate:hover,
    #tk-mobile-donate:focus,
    #tk-mobile-donate:visited,
    #tk-mobile-donate:active {
        color: #ef9291 !important;
        background: transparent !important;
        text-decoration: none !important;
    }

    #tk-mobile-donate .tk-mobile-donate-icon {
        width: 20px !important;
        height: 20px !important;
        flex: 0 0 20px !important;

        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;

        border: 1.5px solid #ef9291 !important;
        border-radius: 50% !important;

        box-sizing: border-box !important;

        color: #ef9291 !important;

        font-family: Georgia, "Times New Roman", serif !important;
        font-size: 13px !important;
        font-weight: 500 !important;
        line-height: 1 !important;

        animation: none !important;
        transform: none !important;
    }

    #tk-mobile-line,
    #tk-mobile-line:hover,
    #tk-mobile-line:focus,
    #tk-mobile-line:visited,
    #tk-mobile-line:active {
        color: #06C755 !important;
        background: transparent !important;
        text-decoration: none !important;
    }

    #tk-mobile-line .tk-mobile-line-icon {
        width: 21px !important;
        height: 21px !important;
        flex: 0 0 21px !important;

        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;

        color: #06C755 !important;

        animation: none !important;
        transform: none !important;
    }

    #tk-mobile-line .tk-mobile-line-icon svg {
        display: block !important;
        width: 21px !important;
        height: 21px !important;
    }

    #scrollUp,
    #back-to-top,
    #backtotop,
    #scroll-to-top,
    #scroll-top,
    .back-to-top,
    .backtotop,
    .scroll-to-top,
    .scroll-top,
    .scrollup,
    .to-top,
    .go-top,
    .return-to-top,
    .back-to-top-button,
    .generate-back-to-top,
    .ast-scroll-top-icon,
    .ct-back-to-top,
    .scroll-top-button {
        bottom: 52px !important;
    }

    body {
        padding-bottom: 0 !important;
    }
}
</style>

<script>
(function () {
    if (!window.matchMedia('(min-width:768px)').matches) return;

    var el = document.getElementById('tk-floating-buttons');
    if (!el) return;

    var ticking = false;

    function update() {
        el.classList.toggle('tk-scrolled', window.scrollY > 250);
        ticking = false;
    }

    function onScroll() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
    }

    update();
    window.addEventListener('scroll', onScroll, { passive: true });
})();
</script>

	</body>
</html>
