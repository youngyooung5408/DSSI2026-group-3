		<div class="elementor-element elementor-element-32b6e54 elementor-hidden-desktop elementor-hidden-tablet elementor-hidden-mobile e-flex e-con-boxed e-con e-parent" data-id="32b6e54" data-element_type="container" data-e-type="container" data-settings="{&quot;background_background&quot;:&quot;classic&quot;}">
					<div class="e-con-inner">
				<div class="elementor-element elementor-element-bd9ad47 elementor-widget elementor-widget-menu-anchor" data-id="bd9ad47" data-element_type="widget" data-e-type="widget" data-widget_type="menu-anchor.default">
							<div class="elementor-menu-anchor" id="poll"></div>
						</div>
				<div class="elementor-element elementor-element-d5c4af2 elementor-widget elementor-widget-heading" data-id="d5c4af2" data-element_type="widget" data-e-type="widget" data-widget_type="heading.default">
					<h2 class="elementor-heading-title elementor-size-default">投票專區｜Poll</h2>				</div>
				<div class="elementor-element elementor-element-9544bdf elementor-widget elementor-widget-shortcode" data-id="9544bdf" data-element_type="widget" data-e-type="widget" data-widget_type="shortcode.default">
					
        <style>
            .tk-poll,
            .tk-poll * {
                box-sizing: border-box;
            }

            .tk-poll {
                --tk-poll-primary: #ab8bc8;
                --tk-poll-primary-dark: #74548b;
                --tk-poll-primary-deep: #5f466f;
                --tk-poll-light: #f7f2f8;
                --tk-poll-fill: #eadff1;
                --tk-poll-border: #dfd4e5;
                --tk-poll-text: #413844;
                --tk-poll-muted: #7b707e;

                width: 100%;
                max-width: 860px;
                margin: 30px auto;
                padding: 42px 44px;
                border-radius: 28px;
                background: #ffffff;
                box-shadow: 0 12px 35px rgba(95, 70, 111, 0.08);
                color: var(--tk-poll-text);
            }

            .tk-poll__header {
                display: flex;
                align-items: center;
                flex-wrap: wrap;
                gap: 14px 18px;
                margin-bottom: 30px;
            }

            .tk-poll__title {
                margin: 0;
                color: var(--tk-poll-text);
                font-size: clamp(25px, 4vw, 38px);
                font-weight: 700;
                line-height: 1.35;
            }

            .tk-poll__badge {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                min-height: 42px;
                padding: 7px 22px;
                border-radius: 999px;
                background: var(--tk-poll-fill);
                color: var(--tk-poll-primary-dark);
                font-size: 18px;
                line-height: 1;
                white-space: nowrap;
            }

            .tk-poll__options,
            .tk-poll__results {
                display: grid;
                gap: 16px;
            }

            .tk-poll__option,
            .tk-poll__result {
                position: relative;
                display: flex;
                align-items: center;
                width: 100%;
                min-height: 82px;
                overflow: hidden;
                border: 2px solid var(--tk-poll-border);
                border-radius: 14px;
                background: #ffffff;
            }

            .tk-poll__option {
                padding: 18px 24px 18px 28px;
                cursor: pointer;
                transition: border-color .18s ease, background-color .18s ease, transform .18s ease;
            }

            .tk-poll__option:hover {
                border-color: var(--tk-poll-primary);
                background: var(--tk-poll-light);
                transform: translateY(-1px);
            }

            .tk-poll__option input {
                position: absolute;
                width: 1px;
                height: 1px;
                opacity: 0;
                pointer-events: none;
            }

            .tk-poll__option-text,
            .tk-poll__result-name {
                position: relative;
                z-index: 2;
                flex: 1;
                padding-right: 18px;
                color: var(--tk-poll-text);
                font-size: clamp(18px, 2.5vw, 25px);
                font-weight: 500;
                line-height: 1.45;
            }

            .tk-poll__radio,
            .tk-poll__result-radio {
                position: relative;
                z-index: 2;
                flex: 0 0 34px;
                width: 34px;
                height: 34px;
                border: 3px solid #cfc7d4;
                border-radius: 50%;
                background: #ffffff;
            }

            .tk-poll__option input:checked ~ .tk-poll__radio {
                border-color: var(--tk-poll-primary-dark);
                background: var(--tk-poll-primary-dark);
                box-shadow: inset 0 0 0 8px #ffffff;
            }

            .tk-poll__submit {
                display: block;
                width: 100%;
                min-height: 52px;
                margin-top: 22px;
                padding: 12px 22px;
                border: 0;
                border-radius: 10px;
                background: var(--tk-poll-primary);
                color: #ffffff;
                font-size: 16px;
                font-weight: 700;
                cursor: pointer;
            }

            .tk-poll__submit:hover {
                background: var(--tk-poll-primary-dark);
            }

            .tk-poll__submit:disabled {
                opacity: .65;
                cursor: wait;
            }

            .tk-poll__message {
                display: none;
                margin-bottom: 18px;
                padding: 11px 14px;
                border-radius: 8px;
                font-size: 14px;
                line-height: 1.6;
                text-align: center;
            }

            .tk-poll__message.is-error {
                display: block;
                border: 1px solid #e8c8c8;
                background: #fff5f5;
                color: #974b4b;
            }

            .tk-poll__message.is-success {
                display: block;
                border: 1px solid var(--tk-poll-border);
                background: var(--tk-poll-light);
                color: var(--tk-poll-primary-dark);
            }

            .tk-poll__result {
                padding: 18px 24px 18px 28px;
            }

            .tk-poll__result-fill {
                position: absolute;
                inset: 0 auto 0 0;
                z-index: 1;
                background: var(--tk-poll-fill);
                transition: width .55s ease;
            }

            .tk-poll__result-percentage {
                position: relative;
                z-index: 2;
                flex: 0 0 auto;
                min-width: 72px;
                margin-right: 18px;
                color: var(--tk-poll-muted);
                font-size: clamp(19px, 2.4vw, 25px);
                font-weight: 500;
                text-align: right;
            }

            .tk-poll__result.is-selected {
                border-color: var(--tk-poll-primary);
            }

            .tk-poll__result.is-selected .tk-poll__result-radio {
                border-color: var(--tk-poll-primary-dark);
                background: #ffffff;
            }

            .tk-poll__result.is-selected .tk-poll__result-radio::after {
                content: "";
                position: absolute;
                top: 50%;
                left: 50%;
                width: 14px;
                height: 14px;
                border-radius: 50%;
                background: var(--tk-poll-primary-dark);
                transform: translate(-50%, -50%);
            }

            .tk-poll__result.is-selected .tk-poll__result-percentage {
                color: var(--tk-poll-primary-dark);
                font-weight: 700;
            }

            .tk-poll--empty {
                display: flex;
                align-items: center;
                justify-content: center;
                min-height: 220px;
            }

            .tk-poll__empty {
                width: 100%;
                color: var(--tk-poll-muted);
                font-size: clamp(22px, 3vw, 28px);
                font-weight: 700;
                line-height: 1.5;
                text-align: center;
            }

            @media (max-width: 767px) {
                .tk-poll {
                    width: 92%;
                    margin: 20px auto;
                    padding: 28px 18px;
                    border-radius: 20px;
                }

                .tk-poll--empty {
                    min-height: 160px;
                }

                .tk-poll__header {
                    gap: 10px 12px;
                    margin-bottom: 22px;
                }

                .tk-poll__badge {
                    min-height: 34px;
                    padding: 6px 15px;
                    font-size: 15px;
                }

                .tk-poll__option,
                .tk-poll__result {
                    min-height: 68px;
                    padding: 14px 15px 14px 18px;
                    border-radius: 11px;
                }

                .tk-poll__radio,
                .tk-poll__result-radio {
                    flex-basis: 28px;
                    width: 28px;
                    height: 28px;
                    border-width: 2px;
                }

                .tk-poll__option input:checked ~ .tk-poll__radio {
                    box-shadow: inset 0 0 0 6px #ffffff;
                }

                .tk-poll__result.is-selected .tk-poll__result-radio::after {
                    width: 12px;
                    height: 12px;
                }

                .tk-poll__result-percentage {
                    min-width: 58px;
                    margin-right: 10px;
                }
            }
        </style>

        <script>
        document.addEventListener('submit', function(event) {

            const form = event.target.closest('.tk-poll__form');

            if (!form) {
                return;
            }

            event.preventDefault();

            const pollBox = form.closest('.tk-poll');
            const messageBox = pollBox.querySelector('.tk-poll__message');
            const contentBox = pollBox.querySelector('.tk-poll__content');
            const submitButton = form.querySelector('.tk-poll__submit');
            const selectedOption = form.querySelector(
                'input[name="tk_poll_option"]:checked'
            );

            messageBox.className = 'tk-poll__message';
            messageBox.textContent = '';

            if (!selectedOption) {
                messageBox.classList.add('is-error');
                messageBox.textContent = '請先選擇一個投票選項。';
                return;
            }

            submitButton.disabled = true;
            submitButton.textContent = '投票處理中…';

            const formData = new FormData();

            formData.append('action', 'tk_poll_submit_vote');
            formData.append('nonce', pollBox.dataset.nonce);
            formData.append('poll_id', pollBox.dataset.pollId);
            formData.append('option_index', selectedOption.value);

            fetch('https://a-chun.tw/wp-admin/admin-ajax.php', {
                method: 'POST',
                credentials: 'same-origin',
                body: formData
            })
            .then(function(response) {
                return response.json();
            })
            .then(function(response) {

                if (
                    !response
                    || !response.data
                ) {
                    throw new Error('投票資料回傳錯誤。');
                }

                const data = response.data;

                if (!response.success) {

                    if (
                        data.results
                        && Array.isArray(data.results.results)
                    ) {
                        if (
                            data.selected_index !== null
                            && data.selected_index !== undefined
                        ) {
                            tkPollSaveSelectedOption(
                                pollBox.dataset.pollId,
                                data.selected_index
                            );

                            pollBox.dataset.selectedIndex =
                                String(data.selected_index);
                        }

                        contentBox.innerHTML = tkPollBuildResults(
                            data.results.results,
                            data.selected_index
                        );
                    }

                    if (data.ended) {
                        messageBox.className = 'tk-poll__message';
                        messageBox.textContent = '';
                        return;
                    }

                    messageBox.classList.add('is-error');
                    messageBox.textContent =
                        data.message || '投票未完成，請重新操作。';

                    submitButton.disabled = false;
                    submitButton.textContent = '送出投票';

                    return;
                }

                messageBox.classList.add('is-success');
                messageBox.textContent =
                    data.message || '投票成功。';

                const submittedIndex = Number(
                    selectedOption.value
                );

                tkPollSaveSelectedOption(
                    pollBox.dataset.pollId,
                    submittedIndex
                );

                pollBox.dataset.selectedIndex =
                    String(submittedIndex);

                contentBox.innerHTML = tkPollBuildResults(
                    data.results.results,
                    submittedIndex
                );
            })
            .catch(function(error) {

                messageBox.classList.add('is-error');
                messageBox.textContent =
                    error.message || '系統暫時無法完成投票。';

                submitButton.disabled = false;
                submitButton.textContent = '送出投票';
            });

        });


        function tkPollStorageKey(pollId) {
            return 'tk_poll_selected_' + String(pollId);
        }


        function tkPollSaveSelectedOption(pollId, selectedIndex) {

            const selectedNumber = Number(selectedIndex);

            if (!Number.isInteger(selectedNumber)) {
                return;
            }

            try {
                localStorage.setItem(
                    tkPollStorageKey(pollId),
                    String(selectedNumber)
                );
            } catch (error) {
                // localStorage 無法使用時，不影響投票功能。
            }
        }


        function tkPollReadSelectedOption(pollId) {

            try {
                const storedValue = localStorage.getItem(
                    tkPollStorageKey(pollId)
                );

                if (storedValue === null) {
                    return null;
                }

                const selectedNumber = Number(storedValue);

                return Number.isInteger(selectedNumber)
                    ? selectedNumber
                    : null;

            } catch (error) {
                return null;
            }
        }


        function tkPollInferSingleVoteSelection(pollBox) {

            if (!pollBox) {
                return null;
            }

            const rows = Array.from(
                pollBox.querySelectorAll('.tk-poll__result')
            );

            if (!rows.length) {
                return null;
            }

            const percentages = rows.map(function(row) {

                const text = row.querySelector(
                    '.tk-poll__result-percentage'
                );

                if (!text) {
                    return 0;
                }

                return Number(
                    text.textContent.replace('%', '').trim()
                ) || 0;
            });

            const fullIndex = percentages.findIndex(function(value) {
                return value === 100;
            });

            const nonZeroCount = percentages.filter(function(value) {
                return value > 0;
            }).length;

            /*
             * 僅在一個選項為 100%、其他全部為 0% 時推定。
             * 這只用於舊測試票沒有保存選項資料的過渡情況。
             */
            return (
                fullIndex >= 0
                && nonZeroCount === 1
            )
                ? fullIndex
                : null;
        }


        function tkPollApplySelectedMarker(pollBox) {

            if (!pollBox) {
                return;
            }

            let selectedIndex = pollBox.dataset.selectedIndex;

            if (
                selectedIndex === ''
                || selectedIndex === undefined
                || selectedIndex === null
            ) {
                selectedIndex = tkPollReadSelectedOption(
                    pollBox.dataset.pollId
                );
            }

            /*
             * 沒有任何已選資料時直接停止。
             * 避免 Number(null) 或 Number('') 被轉成 0，
             * 造成第一個選項被誤判為已選取。
             */
            if (
                selectedIndex === ''
                || selectedIndex === undefined
                || selectedIndex === null
            ) {
                selectedIndex = tkPollInferSingleVoteSelection(
                    pollBox
                );

                if (selectedIndex !== null) {
                    tkPollSaveSelectedOption(
                        pollBox.dataset.pollId,
                        selectedIndex
                    );

                    pollBox.dataset.selectedIndex =
                        String(selectedIndex);
                }
            }

            if (
                selectedIndex === ''
                || selectedIndex === undefined
                || selectedIndex === null
            ) {
                return;
            }

            const selectedNumber = Number(selectedIndex);

            if (!Number.isInteger(selectedNumber)) {
                return;
            }

            const resultRows = pollBox.querySelectorAll(
                '.tk-poll__result'
            );

            resultRows.forEach(function(row, index) {
                row.classList.toggle(
                    'is-selected',
                    index === selectedNumber
                );
            });
        }


        document.addEventListener('DOMContentLoaded', function() {

            document.querySelectorAll('.tk-poll').forEach(
                tkPollApplySelectedMarker
            );

        });


        function tkPollEscapeHtml(value) {

            const element = document.createElement('div');

            element.textContent = String(value ?? '');

            return element.innerHTML;
        }


        function tkPollFormatPercentage(value) {

            const number = Number(value);

            if (!Number.isFinite(number)) {
                return '0%';
            }

            return number.toFixed(1)
                .replace(/\.0$/, '') + '%';
        }


        function tkPollBuildResults(results, selectedIndex) {

            if (!Array.isArray(results)) {
                return '';
            }

            const selectedNumber = Number(selectedIndex);
            const normalizedSelected = Number.isInteger(selectedNumber)
                ? selectedNumber
                : null;

            let html = '<div class="tk-poll__results">';

            results.forEach(function(result) {

                const index = Number(result.index);
                const percentage = Number(result.percentage) || 0;
                const safePercentage = Math.max(
                    0,
                    Math.min(100, percentage)
                );

                const selectedClass =
                    normalizedSelected !== null
                    && normalizedSelected === index
                        ? ' is-selected'
                        : '';

                html +=
                    '<div class="tk-poll__result' +
                        selectedClass +
                    '">' +
                        '<div class="tk-poll__result-fill" style="width:' +
                            safePercentage +
                        '%;"></div>' +
                        '<span class="tk-poll__result-name">' +
                            tkPollEscapeHtml(result.option) +
                        '</span>' +
                        '<span class="tk-poll__result-percentage">' +
                            tkPollFormatPercentage(percentage) +
                        '</span>' +
                        '<span class="tk-poll__result-radio"></span>' +
                    '</div>';
            });

            html += '</div>';

            return html;
        }
        </script>

        		<div class="elementor-shortcode">
        <div class="tk-poll tk-poll--empty">
            <div class="tk-poll__empty">
                暫無討論議題
            </div>
        </div></div>
						</div>
					</div>
				</div>
