    <style>
        .tk-marquee-card-area {
            width: 100%;
        }

        .tk-marquee-card-wrap {
            width: 100%;
            overflow: hidden;
            position: relative;
        }

        .tk-marquee-card-track {
            display: flex;
            width: max-content;
            gap: 24px;
            animation-name: tkMarqueeCardMove;
            animation-timing-function: linear;
            animation-iteration-count: infinite;
            animation-duration: 60s;
            will-change: transform;
        }

        .tk-marquee-card-wrap:hover .tk-marquee-card-track {
            animation-play-state: paused;
        }

        .tk-marquee-card-item {
            flex: 0 0 auto;
            width: 280px;
        }

        .tk-marquee-card-btn {
            display: block;
            width: 100%;
            padding: 0;
            border: 0;
            background: transparent;
            cursor: pointer;
        }

        .tk-marquee-card-btn img {
            display: block;
            width: 100%;
            height: auto;
        }

        @keyframes tkMarqueeCardMove {
            from { transform: translateX(0); }
            to { transform: translateX(-50%); }
        }

        .tk-card-lightbox {
            position: fixed;
            inset: 0;
            z-index: 999999;
            display: none;
            align-items: center;
            justify-content: center;
            background: rgba(0, 0, 0, 0.82);
            padding: 24px;
        }

        .tk-card-lightbox.is-active {
            display: flex;
        }

        .tk-card-lightbox-inner {
            position: relative;
            max-width: 92vw;
            max-height: 88vh;
        }

        .tk-card-lightbox-close-x {
            position: absolute;
            top: -12px;
            right: -12px;
            z-index: 3;
            width: 32px;
            height: 32px;
            padding: 0;
            border: none;
            border-radius: 50%;
            background: rgba(255,255,255,.95);
            color: #666;
            font-size: 24px;
            line-height: 30px;
            cursor: pointer;
            box-shadow: 0 1px 6px rgba(0,0,0,.28);
            opacity: 0;
            pointer-events: none;
            transition: opacity .25s ease, color .2s ease, background-color .2s ease;
        }

        .tk-card-lightbox.is-loaded .tk-card-lightbox-close-x {
            opacity: 1;
            pointer-events: auto;
        }

        .tk-card-lightbox-close-x:hover {
            background: #fff;
            color: #d63638;
        }

        .tk-card-lightbox-loading {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 120px;
            height: 120px;
            margin: 0 auto;
        }

        .tk-card-lightbox-spinner {
            width: 46px;
            height: 46px;
            border: 4px solid rgba(255,255,255,.35);
            border-top-color: #ffffff;
            border-radius: 50%;
            animation: tkCardSpinner 0.8s linear infinite;
        }

        @keyframes tkCardSpinner {
            to { transform: rotate(360deg); }
        }

        .tk-card-lightbox-img {
            display: none;
            max-width: 92vw;
            max-height: 80vh;
            width: auto;
            height: auto;
            opacity: 0;
            transition: opacity .25s ease;
        }

        .tk-card-lightbox.is-loaded .tk-card-lightbox-loading {
            display: none;
        }

        .tk-card-lightbox.is-loaded .tk-card-lightbox-img {
            display: block;
            opacity: 1;
        }

        .tk-card-lightbox-actions {
            display: none;
            justify-content: center;
            gap: 12px;
            margin-top: 16px;
            opacity: 0;
            transition: opacity .25s ease;
        }

        .tk-card-lightbox.is-loaded .tk-card-lightbox-actions {
            display: flex;
            opacity: 1;
        }

        .tk-card-lightbox-download {
            border: 0;
            padding: 10px 18px;
            cursor: pointer;
            background: #ffffff;
            color: #111111;
            font-size: 14px;
            line-height: 1.4;
            text-decoration: none;
            border-radius: 5px;
            transition: background-color .2s ease, color .2s ease;
        }

        .tk-card-lightbox-download:hover {
            background: #ab8bc8ff;
            color: #ffffff;
        }

        @media (max-width: 767px) {
            .tk-marquee-card-track {
                gap: 16px;
            }

            .tk-marquee-card-item {
                width: 72vw;
            }
        }
    </style>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const TK_MARQUEE_SPEED = {
                desktop: 55,
                tablet: 50,
                mobile: 45
            };

            let tkMarqueeResizeTimer = null;

            function tkGetMarqueeSpeed() {
                if (window.innerWidth <= 767) {
                    return TK_MARQUEE_SPEED.mobile;
                }

                if (window.innerWidth <= 1024) {
                    return TK_MARQUEE_SPEED.tablet;
                }

                return TK_MARQUEE_SPEED.desktop;
            }

            function tkUpdateMarqueeSpeed() {
                const speed = tkGetMarqueeSpeed();

                document.querySelectorAll('[data-tk-marquee]').forEach(function (wrap) {
                    const track = wrap.querySelector('.tk-marquee-card-track');
                    if (!track) return;

                    const distance = track.scrollWidth / 2;
                    if (!distance) return;

                    const duration = distance / speed;
                    track.style.animationDuration = duration + 's';
                });
            }

            const wraps = document.querySelectorAll('[data-tk-marquee]');

            wraps.forEach(function (wrap) {
                const track = wrap.querySelector('.tk-marquee-card-track');
                if (!track || track.dataset.cloned === '1') return;

                track.innerHTML += track.innerHTML;
                track.dataset.cloned = '1';
            });

            tkUpdateMarqueeSpeed();

            window.addEventListener('resize', function () {
                clearTimeout(tkMarqueeResizeTimer);

                tkMarqueeResizeTimer = setTimeout(function () {
                    tkUpdateMarqueeSpeed();
                }, 150);
            });

            const lightbox = document.createElement('div');
            lightbox.className = 'tk-card-lightbox';
            lightbox.innerHTML = `
                <div class="tk-card-lightbox-inner">
                    <button class="tk-card-lightbox-close-x" type="button" aria-label="關閉">×</button>

                    <div class="tk-card-lightbox-loading" aria-hidden="true">
                        <div class="tk-card-lightbox-spinner"></div>
                    </div>

                    <img class="tk-card-lightbox-img" src="" alt="">

                    <div class="tk-card-lightbox-actions">
                        <a class="tk-card-lightbox-download" href="#" download>點我下載圖卡</a>
                    </div>
                </div>
            `;

            document.body.appendChild(lightbox);

            const lightboxImg = lightbox.querySelector('.tk-card-lightbox-img');
            const downloadBtn = lightbox.querySelector('.tk-card-lightbox-download');
            const closeBtn = lightbox.querySelector('.tk-card-lightbox-close-x');

            let loadTimer = null;
            let currentLoadToken = 0;
            const minLoadingTime = 300;

            function closeLightbox() {
                currentLoadToken++;
                clearTimeout(loadTimer);
                lightbox.classList.remove('is-active', 'is-loaded');
                lightboxImg.src = '';
                downloadBtn.href = '#';
            }

            function openLightbox(fullUrl) {
                currentLoadToken++;
                const token = currentLoadToken;
                const startTime = Date.now();

                clearTimeout(loadTimer);

                lightbox.classList.add('is-active');
                lightbox.classList.remove('is-loaded');

                lightboxImg.removeAttribute('src');
                lightboxImg.src = '';
                downloadBtn.href = '#';

                const tempImg = new Image();

                tempImg.onload = function () {
                    if (token !== currentLoadToken) return;

                    const elapsed = Date.now() - startTime;
                    const waitTime = Math.max(0, minLoadingTime - elapsed);

                    loadTimer = setTimeout(function () {
                        if (token !== currentLoadToken) return;

                        lightboxImg.src = fullUrl;
                        downloadBtn.href = fullUrl;
                        lightbox.classList.add('is-loaded');
                    }, waitTime);
                };

                tempImg.onerror = function () {
                    if (token !== currentLoadToken) return;
                    clearTimeout(loadTimer);
                    lightbox.classList.remove('is-loaded');
                };

                tempImg.src = fullUrl;
            }

            document.addEventListener('click', function (e) {
                const btn = e.target.closest('.tk-marquee-card-btn');

                if (btn) {
                    const full = btn.getAttribute('data-full');
                    if (!full) return;

                    openLightbox(full);
                    return;
                }

                if (e.target === lightbox || e.target === closeBtn) {
                    closeLightbox();
                }
            });

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && lightbox.classList.contains('is-active')) {
                    closeLightbox();
                }
            });
        });
    </script>

    
