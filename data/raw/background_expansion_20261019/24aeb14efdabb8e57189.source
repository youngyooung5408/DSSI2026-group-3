<link rel="https://api.w.org/" href="https://a-chun.tw/wp-json/" /><link rel="alternate" title="JSON" type="application/json" href="https://a-chun.tw/wp-json/wp/v2/pages/2" /><link rel="EditURI" type="application/rsd+xml" title="RSD" href="https://a-chun.tw/xmlrpc.php?rsd" />
<meta name="generator" content="WordPress 7.1.3" />
<link rel='shortlink' href='https://a-chun.tw/' />
<meta name="generator" content="Site Kit by Google 1.188.0" />    <style>
        .tk-activity-slider {
            position: relative;
            width: 100%;
        }

        .tk-activity-viewport {
            width: 100%;
            overflow: hidden;
            position: relative;
            isolation: isolate;
        }

        .tk-activity-track {
            transform: translate3d(0,0,0);
            backface-visibility: hidden;
            -webkit-backface-visibility: hidden;
            display: flex;
            width: 100%;
            transition: transform .35s ease;
            will-change: transform;
        }

        .tk-activity-slide {
            flex: 0 0 100%;
            width: 100%;
            min-width: 100%;
            overflow: hidden;
        }

        .tk-activity-list {
            display: flex;
            flex-direction: column;
            gap: 20px;
            width: 100%;
        }

        .tk-activity-empty {
            width: 100%;
            min-height: 420px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding-top: 80px;
            box-sizing: border-box;
            color: #ab8bc8;
            font-size: 32px;
            font-weight: 800;
            line-height: 1.4;
            text-align: center;
        }

        .tk-activity-item {
            position: relative;
            display: flex;
            align-items: stretch;
            justify-content: space-between;
            gap: 0;
            width: 100%;
            min-height: 98px;
            padding: 10px 0;
            border-radius: 28px;
            overflow: hidden;
            background: linear-gradient(135deg,#a184be 0%, #b291cf 100%);
            color: #fff;
        }

        .tk-activity-left {
            flex: 0 0 60%;
            display: flex;
            align-items: center;
            padding: 18px 22px 18px 28px;
        }

        .tk-activity-right {
            flex: 0 0 40%;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 24px 22px 24px 18px;
            position: relative;
        }

        .tk-activity-right:before {
            content: "";
            position: absolute;
            left: 0;
            top: 16px;
            bottom: 16px;
            width: 1px;
            background: rgba(255,255,255,.5);
        }

        .tk-activity-title {
            color: #fff;
            font-size: 32px;
            font-weight: 800;
            line-height: 1.3;
            letter-spacing: 0;
            word-break: break-word;
        }

        .tk-activity-meta {
            position: relative;
            color: #fff;
            font-size: 16px;
            font-weight: 700;
            line-height: 1.55;
            word-break: break-word;
        }

        .tk-activity-meta + .tk-activity-meta {
            margin-top: 4px;
        }

        .tk-activity-date,
        .tk-activity-place,
        .tk-activity-time {
            padding-left: 24px;
        }

        .tk-activity-date:before,
        .tk-activity-place:before {
            content: "";
            position: absolute;
            left: 0;
            top: 50%;
            transform: translateY(-50%);
            width: 15px;
            height: 15px;
            background-repeat: no-repeat;
            background-size: 15px 15px;
            background-position: center;
            opacity: 1;
        }

        .tk-activity-date:before {
            background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='white' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect x='3' y='4' width='18' height='17' rx='2' ry='2'/><line x1='16' y1='2' x2='16' y2='6'/><line x1='8' y1='2' x2='8' y2='6'/><line x1='3' y1='10' x2='21' y2='10'/></svg>");
        }

        .tk-activity-place:before {
            background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='white'><path d='M12 21.35c-.31 0-.6-.13-.8-.35C10.64 20.39 5 14.16 5 9.5 5 5.36 8.13 2 12 2s7 3.36 7 7.5c0 4.66-5.64 10.89-6.2 11.5-.2.22-.49.35-.8.35Zm0-17.35c-2.76 0-5 2.47-5 5.5 0 2.94 3.18 7.23 5 9.33 1.82-2.1 5-6.39 5-9.33 0-3.03-2.24-5.5-5.5Zm0 8a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5Z'/></svg>");
        }

        .tk-activity-item.is-clickable {
            cursor: pointer;
            transition:
                transform .18s ease,
                box-shadow .18s ease,
                opacity .18s ease;
        }

        .tk-activity-item.is-clickable:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 24px rgba(135,92,170,.18);
        }

        .tk-activity-arrows {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 14px;
            margin-top: 18px;
        }

        .tk-activity-arrow {
            width: auto;
            height: auto;
            border: none;
            border-radius: 0;
            background: none !important;
            box-shadow: none !important;
            color: #ab8bc8ff;
            font-size: 52px;
            font-weight: 400;
            line-height: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0;
            cursor: pointer;
            transition:
                opacity .18s ease,
                transform .18s ease,
                color .18s ease;
        }

        .tk-activity-arrow:hover {
            background: none !important;
            box-shadow: none !important;
            color: #ef9291ff;
            transform: translateY(-1px);
        }

        .tk-activity-arrow.is-disabled {
            opacity: .35;
            cursor: default;
            pointer-events: none;
        }

        @media (max-width: 767px) {

            .tk-activity-list {
                gap: 16px;
            }

            .tk-activity-empty {
                min-height: 220px;
                padding-top: 40px;
                font-size: 18px;
            }

            .tk-activity-item {
                flex-direction: column;
                min-height: auto;
                padding: 10px 0;
                border-radius: 18px;
            }

            .tk-activity-left {
                flex: 0 0 auto;
                display: block;
                padding: 18px 18px 14px;
            }

            .tk-activity-right {
                flex: 0 0 auto;
                display: flex;
                flex-direction: column;
                justify-content: flex-start;
                padding: 14px 18px 18px;
            }

            .tk-activity-right:before {
                left: 18px;
                right: 18px;
                top: 0;
                bottom: auto;
                width: auto;
                height: 1px;
                background: rgba(255,255,255,.5);
            }

            .tk-activity-title {
                font-size: 18px;
            }

            .tk-activity-meta {
                font-size: 12px;
            }

            .tk-activity-date,
            .tk-activity-place,
            .tk-activity-time {
                padding-left: 18px;
            }

            .tk-activity-date:before,
            .tk-activity-place:before {
                width: 12px;
                height: 12px;
                background-size: 12px 12px;
            }

            .tk-activity-date {
                margin-top: 2px;
            }

            .tk-activity-arrows {
                margin-top: 14px;
            }

            .tk-activity-arrow {
                width: auto;
                height: auto;
                font-size: 42px;
                line-height: 1;
            }
        }
    </style>

    <script>
        document.addEventListener('DOMContentLoaded', function(){

            document.querySelectorAll(
                '.tk-activity-item.is-clickable'
            ).forEach(function(item){

                item.addEventListener('click', function(){

                    var link = item.getAttribute('data-link');

                    if (!link) return;

                    window.open(link, '_blank', 'noopener');
                });
            });

            document.querySelectorAll(
                '.tk-activity-slider'
            ).forEach(function(slider){

                var track = slider.querySelector(
                    '.tk-activity-track'
                );

                var prev = slider.querySelector(
                    '.tk-activity-arrow-prev'
                );

                var next = slider.querySelector(
                    '.tk-activity-arrow-next'
                );

                var total = parseInt(
                    slider.getAttribute('data-total'),
                    10
                ) || 1;

                var current = 0;

                function updateSlider(){

                    if (track) {

                        var extraOffset = current > 0
                            ? current * 2
                            : 0;

                        track.style.transform =
                            'translate3d(calc('
                            + (-current * 100)
                            + '% - '
                            + extraOffset
                            + 'px),0,0)';
                    }

                    if (prev) {
                        prev.classList.toggle(
                            'is-disabled',
                            current <= 0
                        );
                    }

                    if (next) {
                        next.classList.toggle(
                            'is-disabled',
                            current >= total - 1
                        );
                    }
                }

                if (prev) {

                    prev.addEventListener(
                        'click',
                        function(){

                            if (current <= 0) return;

                            current--;

                            updateSlider();
                        }
                    );
                }

                if (next) {

                    next.addEventListener(
                        'click',
                        function(){

                            if (current >= total - 1) return;

                            current++;

                            updateSlider();
                        }
                    );
                }

                updateSlider();
            });
        });
    </script>
