    <style>
        .tkpss-wrap{
            position:relative;
            width:85%;
            margin:0 auto;
            padding:0;
            box-sizing:border-box;
        }

        .tkpss-viewport{
            overflow:hidden;
            width:100%;
        }

        .tkpss-track{
            display:flex;
            gap:32px;
            transition:transform .45s ease;
            will-change:transform;
        }

        .tkpss-slide{
            min-width:calc((100% - 64px) / 3);
            flex:0 0 calc((100% - 64px) / 3);
            box-sizing:border-box;
        }

        .tkpss-card{
            position:relative;
            display:block;
            width:100%;
            aspect-ratio:88 / 100;
            border-radius:34px;
            overflow:hidden;
            text-decoration:none;
            background:#d8d8d8;
            isolation:isolate;
        }

        .tkpss-card-bg{
            position:absolute;
            inset:0;
            background-size:cover;
            background-position:center center;
            transform:scale(1);
            transition:transform .45s ease;
        }

        .tkpss-card-overlay{
            position:absolute;
            inset:0;
            background:linear-gradient(
                to top,
                rgba(0,0,0,.88) 0%,
                rgba(0,0,0,.50) 26%,
                rgba(0,0,0,.15) 55%,
                rgba(0,0,0,.03) 100%
            );
            z-index:1;
        }

        .tkpss-card-content{
            position:absolute;
            left:0;
            right:0;
            bottom:0;
            z-index:2;
            padding:26px 28px 26px;
        }

        .tkpss-card-tag{
            display:inline-flex;
            align-items:center;
            justify-content:center;
            min-height:34px;
            padding:6px 14px;
            margin-bottom:16px;
            border-radius:12px;
            background:#ea9696;
            color:#fff;
            font-size:15px;
            font-weight:600;
            line-height:1;
        }

        .tkpss-card-title{
            margin:0 0 16px;
            color:#fff;
            font-size:20px;
            font-weight:700;
            line-height:1.4;
            display:-webkit-box;
            -webkit-line-clamp:3;
            -webkit-box-orient:vertical;
            overflow:hidden;
        }

        .tkpss-card-date{
            color:#fff;
            font-size:15px;
            font-weight:500;
            line-height:1.2;
        }

        .tkpss-card:hover .tkpss-card-bg{
            transform:scale(1.04);
        }

        .tkpss-arrow{
            position:absolute;
            top:50%;
            transform:translateY(-50%);
            width:64px;
            height:64px;
            border:none !important;
            outline:none !important;
            background:transparent !important;
            box-shadow:none !important;
            appearance:none;
            -webkit-appearance:none;
            cursor:pointer;
            z-index:5;
            padding:0;
            color:#FFCCCC;
            transition:color .22s ease, transform .22s ease;
        }

        .tkpss-arrow:hover,
        .tkpss-arrow:focus,
        .tkpss-arrow:focus-visible,
        .tkpss-arrow:active{
            color:#A688BD;
            border:none !important;
            outline:none !important;
            background:transparent !important;
            box-shadow:none !important;
        }

        .tkpss-arrow:focus-visible{
            outline:none !important;
        }

        .tkpss-arrow-prev{
            left:-92px;
        }

        .tkpss-arrow-next{
            right:-92px;
        }

        .tkpss-arrow span{
            position:absolute;
            top:50%;
            left:50%;
            display:block;
            width:30px;
            height:30px;
            border-top:7px solid currentColor;
            border-right:7px solid currentColor;
            border-radius:6px;
        }

        .tkpss-arrow-prev span{
            transform:translate(-34%, -50%) rotate(-135deg);
        }

        .tkpss-arrow-next span{
            transform:translate(-66%, -50%) rotate(45deg);
        }

        .tkpss-arrow.is-disabled{
            opacity:.32;
            pointer-events:none;
        }

        .tkpss-empty{
            width:100%;
            padding:30px 20px;
            text-align:center;
            color:#666;
            font-size:16px;
        }

        @media (max-width: 1024px){
            .tkpss-wrap{
                width:100%;
                padding:0 44px;
            }

            .tkpss-track{
                gap:24px;
            }

            .tkpss-slide{
                min-width:calc((100% - 24px) / 2);
                flex:0 0 calc((100% - 24px) / 2);
            }

            .tkpss-card{
                border-radius:28px;
            }

            .tkpss-card-content{
                padding:22px 22px 24px;
            }

            .tkpss-card-title{
                font-size:18px;
            }

            .tkpss-arrow{
                width:54px;
                height:54px;
            }

            .tkpss-arrow-prev{
                left:-2px;
            }

            .tkpss-arrow-next{
                right:-2px;
            }

            .tkpss-arrow span{
                width:24px;
                height:24px;
                border-top-width:6px;
                border-right-width:6px;
            }
        }

        @media (max-width: 767px){
            .tkpss-wrap{
                width:100%;
                padding:0 34px;
            }

            .tkpss-track{
                gap:16px;
            }

            .tkpss-slide{
                min-width:100%;
                flex:0 0 100%;
            }

            .tkpss-card{
                border-radius:24px;
                aspect-ratio:88 / 100;
            }

            .tkpss-card-content{
                padding:20px 18px 20px;
            }

            .tkpss-card-tag{
                font-size:14px;
                min-height:32px;
                padding:6px 12px;
                border-radius:10px;
                margin-bottom:14px;
            }

            .tkpss-card-title{
                font-size:17px;
                margin-bottom:14px;
            }

            .tkpss-card-date{
                font-size:14px;
            }

            /* 手機版：放大可點擊區，並往外補回位置，避免壓到卡片 */
            .tkpss-arrow{
                width:88px;
                height:88px;
            }

            .tkpss-arrow-prev{
                left:-25px;
            }

            .tkpss-arrow-next{
                right:-25px;
            }

            .tkpss-arrow span{
                width:18px;
                height:18px;
                border-top-width:5px;
                border-right-width:5px;
                border-radius:5px;
            }
        }
    </style>

    <script>
    (function(){
        var root = document.getElementById('tkpss_FgcgaNrp');
        if (!root) return;

        var viewport = root.querySelector('.tkpss-viewport');
        var track = root.querySelector('.tkpss-track');
        var prevBtn = root.querySelector('.tkpss-arrow-prev');
        var nextBtn = root.querySelector('.tkpss-arrow-next');

        if (!track || !prevBtn || !nextBtn) return;

        var originalSlides = Array.prototype.slice.call(track.querySelectorAll('.tkpss-slide'));
        var originalCount = originalSlides.length;
        var currentIndex = 0;
        var cloneCount = 0;
        var isAnimating = false;
        var resizeTimer = null;

        if (!originalCount) return;

        function getPerViewBase(){
            if (window.innerWidth <= 767) return 1;
            if (window.innerWidth <= 1024) return 2;
            return 3;
        }

        function getPerView(){
            return Math.min(getPerViewBase(), Math.max(originalCount, 1));
        }

        function getGap(){
            var style = window.getComputedStyle(track);
            var gap = parseFloat(style.columnGap || style.gap || 0);
            return isNaN(gap) ? 0 : gap;
        }

        function clearClones(){
            var clones = track.querySelectorAll('.tkpss-slide.is-clone');
            clones.forEach(function(clone){
                clone.parentNode.removeChild(clone);
            });
        }

        function setArrowState(){
            if (originalCount <= 1) {
                prevBtn.classList.add('is-disabled');
                nextBtn.classList.add('is-disabled');
            } else {
                prevBtn.classList.remove('is-disabled');
                nextBtn.classList.remove('is-disabled');
            }
        }

        function buildLoop(){
            clearClones();

            if (originalCount <= 1) {
                currentIndex = 0;
                updateSlider(true);
                setArrowState();
                return;
            }

            cloneCount = Math.min(getPerView(), originalCount);

            var prependSlides = originalSlides.slice(-cloneCount);
            var appendSlides  = originalSlides.slice(0, cloneCount);

            prependSlides.forEach(function(slide){
                var clone = slide.cloneNode(true);
                clone.classList.add('is-clone');
                track.insertBefore(clone, track.firstChild);
            });

            appendSlides.forEach(function(slide){
                var clone = slide.cloneNode(true);
                clone.classList.add('is-clone');
                track.appendChild(clone);
            });

            currentIndex = cloneCount;
            updateSlider(true);
            setArrowState();
        }

        function getAllSlides(){
            return track.querySelectorAll('.tkpss-slide');
        }

        function updateSlider(immediate){
            var allSlides = getAllSlides();
            if (!allSlides.length) return;

            var perView = getPerView();
            var gap = getGap();
            var viewportWidth = viewport.clientWidth;
            var slideWidth = (viewportWidth - gap * (perView - 1)) / perView;
            var offset = currentIndex * (slideWidth + gap);

            if (immediate) {
                track.style.transition = 'none';
            } else {
                track.style.transition = 'transform .45s ease';
            }

            track.style.transform = 'translate3d(' + (-offset) + 'px,0,0)';

            if (immediate) {
                track.offsetHeight;
                track.style.transition = 'transform .45s ease';
            }
        }

        function goNext(){
            if (originalCount <= 1 || isAnimating) return;
            isAnimating = true;
            currentIndex += 1;
            updateSlider(false);
        }

        function goPrev(){
            if (originalCount <= 1 || isAnimating) return;
            isAnimating = true;
            currentIndex -= 1;
            updateSlider(false);
        }

        prevBtn.addEventListener('click', goPrev);
        nextBtn.addEventListener('click', goNext);

        track.addEventListener('transitionend', function(e){
            if (e.propertyName !== 'transform') return;

            if (originalCount > 1) {
                if (currentIndex >= originalCount + cloneCount) {
                    currentIndex = cloneCount;
                    updateSlider(true);
                } else if (currentIndex < cloneCount) {
                    currentIndex = originalCount + currentIndex;
                    updateSlider(true);
                }
            }

            isAnimating = false;
        });

        window.addEventListener('resize', function(){
            clearTimeout(resizeTimer);
            resizeTimer = setTimeout(function(){
                isAnimating = false;
                buildLoop();
            }, 120);
        });

        buildLoop();
    })();
    </script>
    </div>
