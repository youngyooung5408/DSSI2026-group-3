    <script>
    (function(){
        var root = document.getElementById('tk-video-zone-220491');
        if(!root) return;

        var iframe = root.querySelector('.tk-video-featured-iframe');
        var featureBlock = root.querySelector('.tk-video-featured-block');

        if(!iframe || !featureBlock) return;

        function playFeaturedVideo(){
            var autoplaySrc = iframe.getAttribute('data-autoplay-src') || '';
            if(!autoplaySrc) return;

            if(iframe.getAttribute('src') !== autoplaySrc){
                iframe.setAttribute('src', autoplaySrc);
            }else{
                try{
                    iframe.contentWindow && iframe.contentWindow.postMessage('{"event":"command","func":"playVideo","args":""}', '*');
                }catch(e){}
            }
        }

        function pauseFeaturedVideo(){
            try{
                iframe.contentWindow && iframe.contentWindow.postMessage('{"event":"command","func":"pauseVideo","args":""}', '*');
            }catch(e){}
        }

        if('IntersectionObserver' in window){
            var hasPlayedOnce = false;

            var observer = new IntersectionObserver(function(entries){
                entries.forEach(function(entry){
                    if(entry.isIntersecting && entry.intersectionRatio >= 0.45){
                        hasPlayedOnce = true;
                        playFeaturedVideo();
                    }else if(hasPlayedOnce){
                        pauseFeaturedVideo();
                    }
                });
            }, {
                threshold: [0.45, 0.6, 0.8]
            });

            observer.observe(featureBlock);
        }
    })();
    </script>
