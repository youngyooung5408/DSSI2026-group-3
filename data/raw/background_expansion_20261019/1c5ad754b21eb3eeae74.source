  .lm-portrait-frame { background: #fff; border-radius: 999px; overflow: hidden; box-shadow: 0 18px 36px rgba(0,0,0,.20); }
  .lm-portrait-frame img { width: 100%; height: auto !important; max-height: none !important; aspect-ratio: auto !important; object-fit: contain !important; object-position: center center !important; display: block; border-radius: 0; }
  .lm-wide-image img { width: 100%; height: auto; aspect-ratio: auto; object-fit: contain; object-position: center center; background: #111; }
