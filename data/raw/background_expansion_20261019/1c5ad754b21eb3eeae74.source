  .lm-social-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-top: 58px; }
  .lm-social-btn { display: flex; align-items: center; justify-content: center; gap: 10px; min-height: 74px; border-radius: 999px; text-decoration: none !important; background: linear-gradient(180deg, #fff8a8 0%, #ffe55a 100%); color: #0d4a43 !important; font-size: 17px; font-weight: 900; box-shadow: 0 12px 26px rgba(0,0,0,.24); border: 1px solid rgba(255,255,255,.36); transition: all .25s ease; }
  .lm-social-btn:hover { transform: translateY(-4px); box-shadow: 0 18px 36px rgba(0,0,0,.32); color: #111111 !important; }
  .lm-social-icon { display: inline-flex; align-items: center; justify-content: center; width: 38px; height: 38px; border-radius: 12px; background: rgba(255,255,255,.96); flex: 0 0 auto; box-shadow: inset 0 1px 0 rgba(255,255,255,.8), 0 4px 10px rgba(0,0,0,.12); }
  .lm-social-icon svg { width: 24px; height: 24px; display: block; }
  .lm-social-name { display: inline-block; color: #0d4a43 !important; white-space: nowrap; }

  @keyframes lmGridMove { from { transform: translate(0,0); } to { transform: translate(44px,44px); } }
  @keyframes lmDiagonalSweep { 0%,55%{left:-90%;opacity:0} 65%{opacity:1} 100%{left:135%;opacity:0} }

