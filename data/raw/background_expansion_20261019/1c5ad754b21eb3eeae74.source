<section class="lm-countdown-section">
  <style>
    .lm-countdown-section,
    .lm-countdown-section * {
      box-sizing: border-box;
    }

    .lm-countdown-section {
      font-family: "Noto Sans TC", "Microsoft JhengHei", sans-serif;
      position: relative;
      overflow: hidden;
      margin: 0 auto 18px;
      padding: 34px 24px;
      border-radius: 34px;
      color: #ffffff;
      background:
        radial-gradient(circle at 82% 18%, rgba(255,244,214,.18), transparent 30%),
        radial-gradient(circle at 12% 88%, rgba(63,165,149,.16), transparent 34%),
        linear-gradient(135deg, #0d4a43 0%, #145b52 48%, #1b6b63 100%);
      box-shadow: 0 24px 56px rgba(0,0,0,.18);
    }

    .lm-countdown-section::before {
      content: "";
      position: absolute;
      inset: -80px;
      background-image:
        linear-gradient(rgba(255,255,255,.045) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,.045) 1px, transparent 1px);
      background-size: 44px 44px;
      opacity: .5;
      animation: lmCountdownGridMove 22s linear infinite;
      pointer-events: none;
    }

    .lm-countdown-section::after {
      content: "";
      position: absolute;
      top: -35%;
      left: -95%;
      width: 48%;
      height: 170%;
      background: linear-gradient(
        115deg,
        transparent 0%,
        rgba(255,255,255,.04) 42%,
        rgba(255,255,255,.16) 50%,
        rgba(255,255,255,.04) 58%,
        transparent 100%
      );
      transform: skewX(-18deg);
      animation: lmCountdownLightSweep 7s ease-in-out infinite;
      pointer-events: none;
      z-index: 1;
    }

    .lm-countdown-card {
      position: relative;
      z-index: 2;
      max-width: 1080px;
      margin: 0 auto;
      padding: 34px 56px;
      border-radius: 36px;
      background:
        linear-gradient(145deg, rgba(255,255,255,.16), rgba(255,255,255,.07));
      border: 1px solid rgba(255,255,255,.24);
      backdrop-filter: blur(12px);
      box-shadow:
        0 24px 52px rgba(0,0,0,.24),
        inset 0 1px 0 rgba(255,255,255,.18);
      overflow: hidden;
    }

    .lm-countdown-card::before {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: 36px;
      background:
        linear-gradient(135deg, rgba(255,255,255,.12), transparent 38%);
      pointer-events: none;
      opacity: .42;
    }

    .lm-countdown-title,
    .lm-countdown-date,
    .lm-countdown-grid {
      position: relative;
      z-index: 2;
    }

    .lm-countdown-title {
      margin: 0 0 20px;
      color: #fff26a;
      font-size: clamp(32px, 5vw, 64px);
      font-weight: 900;
      line-height: 1.18;
      letter-spacing: -0.02em;
      white-space: nowrap;
      text-shadow:
        0 0 10px rgba(255,242,106,.18),
        0 0 24px rgba(255,242,106,.10);
    }

    .lm-countdown-date {
      margin: 0 0 28px;
      color: rgba(255,255,255,.84);
      font-size: clamp(22px, 3vw, 40px);
      font-weight: 400;
      line-height: 1.5;
      letter-spacing: .04em;
    }

    .lm-countdown-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
    }

    .lm-countdown-item {
      padding: 22px 12px 20px;
      border-radius: 28px;
      text-align: center;
      background:
        linear-gradient(145deg, rgba(255,255,255,.13), rgba(255,255,255,.055));
      border: 1px solid rgba(255,255,255,.18);
      box-shadow:
        0 14px 28px rgba(0,0,0,.18),
        inset 0 1px 0 rgba(255,255,255,.16);
      transition: transform .28s ease, box-shadow .28s ease;
    }

    .lm-countdown-item:hover {
      transform: translateY(-4px);
      box-shadow:
        0 22px 38px rgba(0,0,0,.24),
        inset 0 1px 0 rgba(255,255,255,.18);
    }

    .lm-countdown-number {
      display: block;
      color: #fff26a;
      font-size: clamp(42px, 6vw, 76px);
      font-weight: 900;
      line-height: 1;
      letter-spacing: -0.02em;
      text-shadow: 0 0 16px rgba(255,242,106,.12);
    }

    .lm-countdown-label {
      display: block;
      margin-top: 16px;
      color: rgba(255,255,255,.78);
      font-size: clamp(12px, 1.6vw, 20px);
      font-weight: 500;
      letter-spacing: .16em;
    }

    @keyframes lmCountdownGridMove {
      from {
        transform: translate(0, 0);
      }

      to {
        transform: translate(44px, 44px);
      }
    }

    @keyframes lmCountdownLightSweep {
      0%, 55% {
        left: -95%;
        opacity: 0;
      }

      65% {
        opacity: 1;
      }

      100% {
        left: 135%;
        opacity: 0;
      }
    }

    @media (max-width: 760px) {
      .lm-countdown-section {
        padding: 24px 16px;
        border-radius: 24px;
        margin-bottom: 16px;
      }

      .lm-countdown-card {
        padding: 24px 18px;
        border-radius: 28px;
      }

      .lm-countdown-card::before {
        border-radius: 28px;
      }

      .lm-countdown-title {
        font-size: clamp(25px, 7vw, 35px);
        white-space: nowrap;
        letter-spacing: -0.045em;
        margin-bottom: 16px;
      }

      .lm-countdown-date {
        font-size: clamp(18px, 5vw, 24px);
        margin-bottom: 20px;
      }

      .lm-countdown-grid {
        grid-template-columns: repeat(4, 1fr);
        gap: 7px;
      }

      .lm-countdown-item {
        padding: 13px 6px 12px;
        border-radius: 18px;
      }

      .lm-countdown-number {
        font-size: clamp(26px, 8vw, 38px);
      }

      .lm-countdown-label {
        margin-top: 6px;
        font-size: 9px;
        letter-spacing: .06em;
      }
    }
  </style>

  <div class="lm-countdown-card">
    <h2 class="lm-countdown-title">2026 市議員投票倒數</h2>

    <p class="lm-countdown-date">投票日：2026 年 11 月 28 日</p>

    <div class="lm-countdown-grid">
      <div class="lm-countdown-item">
        <span class="lm-countdown-number" id="lmCdDays">–</span>
        <span class="lm-countdown-label">DAYS</span>
      </div>

      <div class="lm-countdown-item">
        <span class="lm-countdown-number" id="lmCdHours">–</span>
        <span class="lm-countdown-label">HOURS</span>
      </div>

      <div class="lm-countdown-item">
        <span class="lm-countdown-number" id="lmCdMinutes">–</span>
        <span class="lm-countdown-label">MINUTES</span>
      </div>

      <div class="lm-countdown-item">
        <span class="lm-countdown-number" id="lmCdSeconds">–</span>
        <span class="lm-countdown-label">SECONDS</span>
      </div>
    </div>
  </div>

  <script>
    (function () {
      const targetTime = new Date("2026-11-28T00:00:00+08:00").getTime();

      function pad(num) {
        return String(num).padStart(2, "0");
      }

      function updateCountdown() {
        const now = new Date().getTime();
        const diff = Math.max(0, targetTime - now);

        const days = Math.floor(diff / (1000 * 60 * 60 * 24));
        const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
        const minutes = Math.floor((diff / (1000 * 60)) % 60);
        const seconds = Math.floor((diff / 1000) % 60);

        const d = document.getElementById("lmCdDays");
        const h = document.getElementById("lmCdHours");
        const m = document.getElementById("lmCdMinutes");
        const s = document.getElementById("lmCdSeconds");

        if (d) d.textContent = days;
        if (h) h.textContent = pad(hours);
        if (m) m.textContent = pad(minutes);
        if (s) s.textContent = pad(seconds);
      }

      updateCountdown();
      setInterval(updateCountdown, 1000);
    })();
  </script>
</section>



<section class="lm-home">
<style>
  .lm-home, .lm-home * { box-sizing: border-box; }
  .lm-home {
    font-family: "Noto Sans TC", "Microsoft JhengHei", sans-serif;
    color: #fff !important;
    background:
      radial-gradient(circle at 85% 8%, rgba(255,229,90,.20), transparent 28%),
      radial-gradient(circle at 12% 88%, rgba(63,165,149,.16), transparent 34%),
      linear-gradient(135deg, #0d4a43 0%, #145b52 48%, #1b6b63 100%);
    border-radius: 36px;
    padding: 92px 24px 64px;
    overflow: hidden;
    position: relative;
    margin-top: 10px;
  }
  .lm-home::before {
