  <script>
    (function(){
      const target = new Date("2026-11-28T00:00:00+08:00").getTime();
      function pad(n){ return String(n).padStart(2,"0"); }
      function updateCountdown(){
        const now = new Date().getTime();
        const diff = Math.max(0, target - now);
        const days=Math.floor(diff/(1000*60*60*24));
        const hours=Math.floor((diff/(1000*60*60))%24);
        const minutes=Math.floor((diff/(1000*60))%60);
        const seconds=Math.floor((diff/1000)%60);
        if(document.getElementById("lmDays")) document.getElementById("lmDays").textContent=days;
        if(document.getElementById("lmHours")) document.getElementById("lmHours").textContent=pad(hours);
        if(document.getElementById("lmMinutes")) document.getElementById("lmMinutes").textContent=pad(minutes);
        if(document.getElementById("lmSeconds")) document.getElementById("lmSeconds").textContent=pad(seconds);
      }
      updateCountdown();
      setInterval(updateCountdown,1000);
    })();
  </script>
