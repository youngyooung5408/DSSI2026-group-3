<style id="wp-custom-css">
/* ==================================================
   SureForms｜西區意見牆表單外觀修正
   修正電話欄位雙層感、國碼位置、下拉選單 focus 框
   ================================================== */

/* 表單整體輸入框統一高度與外觀 */
body .srfm-form-container input,
body .srfm-form-container textarea,
body .srfm-form-container select,
body .srfm-form-container .choices__inner,
body .srfm-form-container .iti {
  border: 1px solid #cfd6dc !important;
  border-radius: 14px !important;
  background: #ffffff !important;
  box-shadow: none !important;
  outline: none !important;
}

/* 一般 input 高度統一 */
body .srfm-form-container input:not([type="checkbox"]):not([type="radio"]),
body .srfm-form-container select,
body .srfm-form-container .choices__inner {
  min-height: 52px !important;
  height: 52px !important;
  line-height: 52px !important;
  padding-top: 0 !important;
  padding-bottom: 0 !important;
}

/* ==================================================
   Phone Number 欄位修正
   ================================================== */

/* 電話欄位外層：只保留一個框 */
body .srfm-form-container .iti {
  width: 100% !important;
  min-height: 52px !important;
  height: 52px !important;
  display: flex !important;
  align-items: center !important;
  overflow: hidden !important;
  background: #ffffff !important;
}

/* 國旗國碼區塊固定在左邊，不要掉到第二行 */
body .srfm-form-container .iti__flag-container,
body .srfm-form-container .iti__country-container {
  position: absolute !important;
  left: 0 !important;
  top: 0 !important;
  bottom: 0 !important;
  width: 92px !important;
  height: 52px !important;
  display: flex !important;
  align-items: center !important;
  border: 0 !important;
  background: transparent !important;
  box-shadow: none !important;
  z-index: 3 !important;
}

/* 國旗選擇器本身 */
body .srfm-form-container .iti__selected-flag,
body .srfm-form-container .iti__selected-country {
  height: 52px !important;
  min-height: 52px !important;
  padding: 0 10px !important;
  display: flex !important;
  align-items: center !important;
  border: 0 !important;
  background: transparent !important;
  box-shadow: none !important;
}

/* 電話真正輸入框：往右縮，避免跟國碼重疊 */
body .srfm-form-container .iti input,
body .srfm-form-container input[type="tel"] {
  width: 100% !important;
  height: 52px !important;
  min-height: 52px !important;
  line-height: 52px !important;
  padding-top: 0 !important;
  padding-bottom: 0 !important;
  padding-left: 96px !important;
  padding-right: 16px !important;
  border: 0 !important;
  border-radius: 14px !important;
  background: transparent !important;
  box-shadow: none !important;
  outline: none !important;
}

/* 移除電話欄位內部可能出現的第二層陰影 */
body .srfm-form-container .iti *,
body .srfm-form-container .iti *::before,
body .srfm-form-container .iti *::after {
  box-shadow: none !important;
}

/* 電話欄位 focus 時只留下外框，不出現內框 */
body .srfm-form-container .iti:focus-within {
  border-color: #0f7c8a !important;
  box-shadow: 0 0 0 4px rgba(15, 124, 138, 0.12) !important;
}

/* ==================================================
   Dropdown / Select 欄位修正
   ================================================== */

/* Choices 下拉選單外框統一 */
body .srfm-form-container .choices,
body .srfm-form-container .choices__inner {
  width: 100% !important;
  border-radius: 14px !important;
}

/* 選完之後不要留下很亮的綠色內框 */
body .srfm-form-container .choices.is-focused .choices__inner,
body .srfm-form-container .choices.is-open .choices__inner,
body .srfm-form-container .choices__inner:focus,
body .srfm-form-container .choices__input:focus {
  border-color: #0f7c8a !important;
  box-shadow: 0 0 0 4px rgba(15, 124, 138, 0.10) !important;
  outline: none !important;
}

/* 下拉搜尋輸入框不要另外出現綠色大框 */
body .srfm-form-container .choices__input {
  border: 0 !important;
  box-shadow: none !important;
  outline: none !important;
  background: transparent !important;
}

/* 選項清除按鈕不要太突兀 */
body .srfm-form-container .choices__button {
  border: 0 !important;
  box-shadow: none !important;
  opacity: 0.55 !important;
}

/* 下拉選單列表 */
body .srfm-form-container .choices__list--dropdown {
  border: 1px solid #d7dee4 !important;
  border-radius: 14px !important;
  box-shadow: 0 14px 30px rgba(15, 124, 138, 0.12) !important;
  overflow: hidden !important;
}

/* 下拉選項 hover */
body .srfm-form-container .choices__list--dropdown .choices__item--selectable.is-highlighted {
  background: #e6fbfd !important;
  color: #075260 !important;
}

/* 手機版避免電話欄位變形 */
@media (max-width: 640px) {
  body .srfm-form-container .iti,
  body .srfm-form-container .iti input,
  body .srfm-form-container input[type="tel"] {
    height: 50px !important;
    min-height: 50px !important;
    line-height: 50px !important;
  }

  body .srfm-form-container .iti__flag-container,
  body .srfm-form-container .iti__country-container,
  body .srfm-form-container .iti__selected-flag,
  body .srfm-form-container .iti__selected-country {
    height: 50px !important;
    min-height: 50px !important;
  }

  body .srfm-form-container .iti input,
  body .srfm-form-container input[type="tel"] {
    padding-left: 92px !important;
  }
}
/* ==================================================
   SureForms｜下拉選單選完後移除亮框感
   適用：地區欄位 Choices.js
   ================================================== */

/* 下拉選單外層不要出現深色大框 */
body .srfm-form-container .choices,
body .srfm-form-container .choices.is-focused,
body .srfm-form-container .choices.is-open {
  outline: none !important;
  box-shadow: none !important;
}

/* 下拉選單主框：選完後維持一般框線 */
body .srfm-form-container .choices__inner,
body .srfm-form-container .choices.is-focused .choices__inner,
body .srfm-form-container .choices.is-open .choices__inner {
  border: 1px solid #cfd6dc !important;
  border-radius: 14px !important;
  background: #ffffff !important;
  box-shadow: none !important;
  outline: none !important;
}

/* 下拉選單內部搜尋框：不要留下綠色亮框 */
body .srfm-form-container .choices__input,
body .srfm-form-container .choices__input:focus,
body .srfm-form-container .choices__input:active {
  border: 0 !important;
  outline: none !important;
  box-shadow: none !important;
  background: transparent !important;
}

/* 選完後的項目不要有內層綠框 */
body .srfm-form-container .choices__list--single,
body .srfm-form-container .choices__list--single .choices__item,
body .srfm-form-container .choices__list--multiple,
body .srfm-form-container .choices__list--multiple .choices__item {
  outline: none !important;
  box-shadow: none !important;
  border: 0 !important;
}

/* 如果欄位仍在 focus 狀態，只給淡淡外框，不要亮綠框 */
body .srfm-form-container .choices:focus-within .choices__inner {
  border-color: #cfd6dc !important;
  box-shadow: none !important;
}

/* 移除瀏覽器或外掛產生的 focus ring */
body .srfm-form-container .choices *:focus,
body .srfm-form-container .choices *:focus-visible,
body .srfm-form-container .choices *:active {
  outline: none !important;
  box-shadow: none !important;
}

/* 清除 X 按鈕不要有焦點框 */
body .srfm-form-container .choices__button,
body .srfm-form-container .choices__button:focus,
body .srfm-form-container .choices__button:active {
  outline: none !important;
  box-shadow: none !important;
  border: 0 !important;
}
/* ==================================================
   SureForms｜地區欄位殘留搜尋框修正
   目的：選完西區/東區/嘉義縣/其他後，不再顯示綠色搜尋框
   ================================================== */

/* 把 Choices.js 內部搜尋 input 隱藏 */
body .srfm-form-container .choices__input,
body .srfm-form-container .choices__input:focus,
body .srfm-form-container .choices__input:active,
body .srfm-form-container .choices__input:focus-visible {
  width: 0 !important;
  min-width: 0 !important;
  max-width: 0 !important;
  height: 0 !important;
  min-height: 0 !important;
  max-height: 0 !important;
  padding: 0 !important;
  margin: 0 !important;
  border: 0 !important;
  outline: 0 !important;
  box-shadow: none !important;
  opacity: 0 !important;
  visibility: hidden !important;
  background: transparent !important;
}

/* 移除下拉選單外層 focus 框 */
body .srfm-form-container .choices,
body .srfm-form-container .choices:focus,
body .srfm-form-container .choices:focus-within,
body .srfm-form-container .choices.is-focused,
body .srfm-form-container .choices.is-open {
  border: 0 !important;
  outline: 0 !important;
  box-shadow: none !important;
}

/* 真正可見的選單框：維持單一灰色外框 */
body .srfm-form-container .choices__inner,
body .srfm-form-container .choices.is-focused .choices__inner,
body .srfm-form-container .choices.is-open .choices__inner,
body .srfm-form-container .choices:focus-within .choices__inner {
  min-height: 52px !important;
  border: 1px solid #cfd6dc !important;
  border-radius: 14px !important;
  background: #ffffff !important;
  outline: 0 !important;
  box-shadow: none !important;
}

/* 選中的文字不要變成一顆膠囊或多一層框 */
body .srfm-form-container .choices__list--single,
body .srfm-form-container .choices__list--single .choices__item,
body .srfm-form-container .choices__list--multiple,
body .srfm-form-container .choices__list--multiple .choices__item {
  border: 0 !important;
  outline: 0 !important;
  box-shadow: none !important;
  background: transparent !important;
}

/* 清除按鈕 X 不要顯示 focus 框 */
body .srfm-form-container .choices__button,
body .srfm-form-container .choices__button:focus,
body .srfm-form-container .choices__button:active,
body .srfm-form-container .choices__button:focus-visible {
  border: 0 !important;
  outline: 0 !important;
  box-shadow: none !important;
}

/* 移除 Choices 裡所有子元素的瀏覽器 focus ring */
body .srfm-form-container .choices *:focus,
body .srfm-form-container .choices *:active,
body .srfm-form-container .choices *:focus-visible {
  outline: 0 !important;
  box-shadow: none !important;
}


/* ==================================================
   強制修正 SureForms / Choices 地區下拉選單殘留亮框
   目標：隱藏選完後殘留的搜尋輸入框
   ================================================== */

/* 直接隱藏 Choices.js 內部搜尋輸入框 */
body .choices input[type="search"],
body .choices input[type="text"],
body .choices .choices__input,
body .choices .choices__input--cloned {
  display: none !important;
  width: 0 !important;
  min-width: 0 !important;
  max-width: 0 !important;
  height: 0 !important;
  min-height: 0 !important;
  max-height: 0 !important;
  padding: 0 !important;
  margin: 0 !important;
  border: 0 !important;
  outline: 0 !important;
  box-shadow: none !important;
  opacity: 0 !important;
  visibility: hidden !important;
  pointer-events: none !important;
}

/* 移除 Choices 外層焦點框 */
body .choices,
body .choices:focus,
body .choices:focus-within,
body .choices.is-focused,
body .choices.is-open {
  outline: none !important;
  box-shadow: none !important;
}

/* 下拉選單真正可見的外框 */
body .choices__inner,
body .choices.is-focused .choices__inner,
body .choices.is-open .choices__inner,
body .choices:focus-within .choices__inner {
  border: 1px solid #cfd6dc !important;
  border-radius: 14px !important;
  background: #ffffff !important;
  box-shadow: none !important;
  outline: none !important;
  min-height: 52px !important;
}

/* 已選項目不要出現綠框、黑框或膠囊框 */
body .choices__list--single,
body .choices__list--single .choices__item,
body .choices__list--multiple,
body .choices__list--multiple .choices__item {
  border: 0 !important;
  outline: none !important;
  box-shadow: none !important;
  background: transparent !important;
}

/* 移除 X 按鈕的焦點框 */
body .choices__button,
body .choices__button:focus,
body .choices__button:active,
body .choices__button:focus-visible {
  border: 0 !important;
  outline: none !important;
  box-shadow: none !important;
}

/* 移除 Choices 內所有子元素的 focus ring */
body .choices *,
body .choices *:focus,
body .choices *:active,
body .choices *:focus-visible {
  outline: none !important;
  box-shadow: none !important;
}

/* ==================================================
   SureForms｜Tom Select 地區欄位亮框修正
   目標：移除地區選完後殘留的綠色搜尋輸入框
   ================================================== */

/* Tom Select 外層不要出現黑色或綠色 focus 框 */
body .srfm-form-container .ts-wrapper,
body .srfm-form-container .ts-wrapper.focus,
body .srfm-form-container .ts-wrapper.input-active,
body .srfm-form-container .ts-wrapper.dropdown-active {
  outline: none !important;
  box-shadow: none !important;
}

/* Tom Select 真正可見的欄位框 */
body .srfm-form-container .ts-control {
  min-height: 52px !important;
  border: 1px solid #cfd6dc !important;
  border-radius: 14px !important;
  background: #ffffff !important;
  box-shadow: none !important;
  outline: none !important;
  padding: 0 42px 0 14px !important;
  display: flex !important;
  align-items: center !important;
}

/* focus / active 時也不要出現綠色亮框 */
body .srfm-form-container .ts-wrapper.focus .ts-control,
body .srfm-form-container .ts-wrapper.input-active .ts-control,
body .srfm-form-container .ts-wrapper.dropdown-active .ts-control {
  border: 1px solid #cfd6dc !important;
  box-shadow: none !important;
  outline: none !important;
}

/* 隱藏 Tom Select 內部搜尋 input，也就是你截圖中的 tomselect-1-ts-control */
body .srfm-form-container .ts-control > input,
body .srfm-form-container .ts-control input[id^="tomselect-"],
body .srfm-form-container input[id^="tomselect-"] {
  width: 0 !important;
  min-width: 0 !important;
  max-width: 0 !important;
  height: 0 !important;
  min-height: 0 !important;
  max-height: 0 !important;
  padding: 0 !important;
  margin: 0 !important;
  border: 0 !important;
  outline: 0 !important;
  box-shadow: none !important;
  opacity: 0 !important;
  visibility: hidden !important;
  pointer-events: none !important;
}

/* 已選取的文字正常顯示，不要被壓掉 */
body .srfm-form-container .ts-control .item {
  color: #111827 !important;
  background: transparent !important;
  border: 0 !important;
  padding: 0 !important;
  margin: 0 !important;
  box-shadow: none !important;
  outline: none !important;
  line-height: 52px !important;
}

/* 清除 X 按鈕不要有焦點框 */
body .srfm-form-container .ts-control .remove,
body .srfm-form-container .ts-control .remove:focus,
body .srfm-form-container .ts-control .remove:active {
  outline: none !important;
  box-shadow: none !important;
  border: 0 !important;
}

/* 下拉選單本體 */
body .srfm-form-container .ts-dropdown {
  border: 1px solid #d7dee4 !important;
  border-radius: 14px !important;
  box-shadow: 0 14px 30px rgba(15, 124, 138, 0.12) !important;
  overflow: hidden !important;
}

/* 下拉選項 hover / active */
body .srfm-form-container .ts-dropdown .option.active,
body .srfm-form-container .ts-dropdown .option:hover {
  background: #e6fbfd !important;
  color: #075260 !important;
}



.lm-topic-detail {
  --lm-green: #0f6b4f;
  --lm-deep: #064236;
  --lm-mint: #e3f8ea;
  --lm-light: #f5fbf7;
  --lm-yellow: #ffe66d;
  --lm-blue: #e4f4ff;
  --lm-white: #ffffff;
  --lm-text: #17372f;
  --lm-muted: #5d756e;
  --lm-border: rgba(15, 107, 79, 0.14);
  --lm-shadow: 0 18px 45px rgba(6, 66, 54, 0.13);
  max-width: 1080px;
  margin: 0 auto;
  padding: 36px 20px 64px;
  font-family: "Noto Sans TC", "Microsoft JhengHei", system-ui, sans-serif;
  color: var(--lm-text);
}

.lm-topic-hero {
  position: relative;
  overflow: hidden;
  border-radius: 30px;
  padding: 52px 34px;
  background:
    radial-gradient(circle at 15% 18%, rgba(255, 230, 109, 0.55), transparent 28%),
    radial-gradient(circle at 90% 20%, rgba(228, 244, 255, 0.8), transparent 30%),
    linear-gradient(135deg, #064236 0%, #0f6b4f 52%, #72d69b 100%);
  box-shadow: var(--lm-shadow);
}

.lm-topic-hero h1 {
  margin: 12px 0 0;
  color: var(--lm-yellow);
  font-size: clamp(34px, 5vw, 58px);
  line-height: 1.16;
  font-weight: 950;
  letter-spacing: 0.02em;
}

.lm-topic-kicker {
  display: inline-flex;
  padding: 8px 16px;
  border-radius: 999px;
  background: rgba(255,255,255,.18);
  color: #fff;
  font-size: 14px;
  font-weight: 900;
  letter-spacing: .08em;
}

.lm-topic-hero p {
  max-width: 820px;
  margin: 20px 0 0;
  color: rgba(255,255,255,.94);
  font-size: 18px;
  line-height: 1.85;
  font-weight: 700;
}

.lm-topic-section {
  margin-top: 42px;
}

.lm-topic-section h2 {
  margin: 0 0 14px;
  color: var(--lm-deep);
  font-size: clamp(26px, 3.5vw, 38px);
  line-height: 1.22;
  font-weight: 950;
}

.lm-topic-section p {
  color: var(--lm-muted);
  font-size: 17px;
  line-height: 1.9;
}

.lm-topic-card-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
  margin-top: 22px;
}

.lm-topic-info-card {
  padding: 24px 22px;
  border-radius: 24px;
  background: #fff;
  border: 1px solid var(--lm-border);
  box-shadow: 0 12px 30px rgba(6,66,54,.1);
}

.lm-topic-info-card h3 {
  margin: 0 0 10px;
  color: var(--lm-deep);
  font-size: 21px;
  line-height: 1.35;
  font-weight: 950;
}

.lm-topic-info-card p {
  margin: 0;
  font-size: 15.5px;
  line-height: 1.85;
}

.lm-topic-list {
  margin: 16px 0 0;
  padding-left: 1.3em;
  color: var(--lm-muted);
  font-size: 17px;
  line-height: 1.9;
}

.lm-topic-post-note {
  margin-top: 28px;
  padding: 24px;
  border-radius: 24px;
  background: linear-gradient(135deg, rgba(255,230,109,.24), rgba(255,255,255,.96));
  border: 1px solid var(--lm-border);
  box-shadow: var(--lm-shadow);
}

.lm-topic-post-note h2 {
  margin-bottom: 8px;
}

@media (max-width: 900px) {
  .lm-topic-card-grid {
    grid-template-columns: 1fr;
  }
  .lm-topic-hero {
    padding: 42px 24px;
  }
}
</style>
