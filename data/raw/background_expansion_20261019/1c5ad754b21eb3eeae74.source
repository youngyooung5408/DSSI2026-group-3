  .lm-count-title { white-space: nowrap; }
  .lm-section-sub { margin: 0 0 26px; font-size: 18px; line-height: 1.8; color: rgba(255,255,255,.84) !important; }
  .lm-countdown { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
  .lm-count-item { border-radius: 24px; padding: 20px 14px; background: linear-gradient(145deg, rgba(255,255,255,.14), rgba(255,255,255,.06)); border: 1px solid rgba(255,255,255,.18); text-align: center; box-shadow: 0 14px 28px rgba(0,0,0,.18), inset 0 1px 0 rgba(255,255,255,.16); }
  .lm-count-number { display: block; font-size: clamp(30px, 5vw, 52px); font-weight: 900; color: #fff36d !important; line-height: 1; }
  .lm-count-label { display: block; margin-top: 8px; font-size: 13px; color: rgba(255,255,255,.75) !important; letter-spacing: .12em; }
  .lm-mini-card h3 { margin: 0 0 14px; font-size: 26px; font-weight: 900; }
  .lm-mini-card p, .lm-entry span { margin: 0; font-size: 20px; line-height: 1.85; color: rgba(255,255,255,.84) !important; }
  .lm-entry { text-decoration: none !important; color: #fff !important; min-height: 170px; transition: all .28s ease; position: relative; }
  .lm-entry b { display: block; font-size: 22px; margin-bottom: 10px; }
  .lm-entry .lm-click { display: inline-flex; align-items: center; justify-content: center; gap: 8px; margin-top: 20px; padding: 10px 18px; border-radius: 999px; background: linear-gradient(180deg, #fff8a8 0%, #ffe55a 100%); color: #111111 !important; font-weight: 900; font-size: 15px; box-shadow: 0 10px 22px rgba(0,0,0,.25); border: 1px solid rgba(255,255,255,.35); }
  .lm-entry .lm-click span, .lm-entry .lm-click .lm-arrow { color: #111111 !important; }
