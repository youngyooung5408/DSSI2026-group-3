    margin: 0; padding: 0; list-style: none;
    display: grid; grid-template-columns: repeat(2, minmax(0,1fr));
    gap: 12px 26px; font-size: 16px; line-height: 1.7; font-weight: 700; color: #fff !important;
  }
  .lm-credentials li { position: relative; padding-left: 22px; }
  .lm-credentials li::before {
    content: ""; width: 7px; height: 7px; border-radius: 999px; background: #ffe55a;
    position: absolute; left: 0; top: 13px;
  }
  .lm-photo-card, .lm-panel, .lm-mini-card, .lm-entry, .lm-search-panel {
    border-radius: 30px; padding: 22px; transition: all .28s ease;
  }
  .lm-photo-card:hover, .lm-panel:hover, .lm-mini-card:hover, .lm-entry:hover, .lm-search-panel:hover {
    transform: translateY(-4px);
    box-shadow: 0 30px 60px rgba(0,0,0,.32), inset 0 1px 0 rgba(255,255,255,.2);
  }
  .lm-photo-card img { width: 100%; display: block; border-radius: 22px; }
  .lm-main-photo img { aspect-ratio: 16/9; object-fit: cover; }
