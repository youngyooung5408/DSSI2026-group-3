  .lm-donate-row span { opacity: .78; white-space: nowrap; }
  .lm-donate-row strong { text-align: right; font-weight: 900; color: #fff !important; }
  .lm-donate-note { margin-top: 10px; font-size: 13px; line-height: 1.8; color: rgba(255,255,255,.78) !important; }
