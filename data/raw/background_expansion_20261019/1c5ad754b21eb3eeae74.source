    position: absolute;
    top: -30%; left: -90%;
    width: 48%; height: 160%;
    background: linear-gradient(115deg, transparent 0%, rgba(255,255,255,.04) 42%, rgba(255,255,255,.14) 50%, rgba(255,255,255,.04) 58%, transparent 100%);
    transform: skewX(-18deg);
    animation: lmDiagonalSweep 7s ease-in-out infinite;
    pointer-events: none;
  }
  .lm-wrap { max-width: 1220px; margin: 0 auto; position: relative; z-index: 2; }

  .lm-hero-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 22px;
    overflow: hidden;
    align-items: stretch;
  }
  .lm-hero-full { grid-column: 1 / -1; }

  .lm-two-grid  { display: grid; grid-template-columns: repeat(2, 1fr); gap: 22px; }
  .lm-card-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  .lm-link-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 22px; }

  .lm-badge,
  .lm-panel,
  .lm-photo-card,
  .lm-mini-card,
  .lm-entry,
  .lm-search-panel {
    background: linear-gradient(145deg, rgba(255,255,255,.16), rgba(255,255,255,.07));
    border: 1px solid rgba(255,255,255,.22);
    backdrop-filter: blur(12px);
    box-shadow: 0 22px 44px rgba(0,0,0,.24), inset 0 1px 0 rgba(255,255,255,.18);
  }
  .lm-badge {
    display: block !important;
    width: min(100%, 1080px) !important;
    max-width: 1080px !important;
    margin: 0 auto 34px !important;
    padding: 28px 36px !important;
    text-align: center !important;
    border-radius: 36px !important;
    background: linear-gradient(145deg, rgba(255,255,255,.16), rgba(255,255,255,.07)) !important;
    border: 1px solid rgba(255,255,255,.24) !important;
    backdrop-filter: blur(12px) !important;
    box-shadow: 0 24px 52px rgba(0,0,0,.24), inset 0 1px 0 rgba(255,255,255,.18) !important;
  }
  .lm-badge-name {
    display: block !important; color: #fff26a !important;
    font-size: clamp(40px, 5vw, 64px) !important; font-weight: 900 !important;
    line-height: 1.12 !important; margin-bottom: 14px !important; letter-spacing: .04em !important;
  }
  .lm-badge-title {
    display: block !important; color: rgba(255,255,255,.95) !important;
    font-size: clamp(18px, 2.4vw, 30px) !important; font-weight: 800 !important;
    line-height: 1.35 !important; white-space: nowrap !important; letter-spacing: .02em !important;
  }
  .lm-home h1, .lm-home h1 span, .lm-line { color: #fff !important; }
  .lm-home h1 { font-size: clamp(42px, 4.8vw, 72px); line-height: 1.12; margin: 0 0 30px; font-weight: 900; }
  .lm-line { display: block; }
  .lm-home h1 .lm-line { white-space: nowrap; }
  .lm-highlight { color: #ffe55a !important; text-shadow: 0 0 12px rgba(255,229,90,.28), 0 0 26px rgba(255,229,90,.18); }
  .lm-slogan { font-size: clamp(24px, 3vw, 40px); line-height: 1.45; font-weight: 800; margin-bottom: 30px; color: #fff !important; }
  .lm-sub { font-size: 18px; line-height: 2.02; color: rgba(255,255,255,.88) !important; margin-bottom: 0; }
