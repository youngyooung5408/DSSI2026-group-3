5.7-12 12-.6-6.3-5.7-11.4-12-12C6.3 11.4 11.4 6.3 12 0Z"></path></svg></span><span class="flex items-center" style="color:#fff"><span class="font-display whitespace-nowrap px-6 text-lg font-semibold uppercase tracking-wide sm:text-2xl">為萬華帶來改變</span><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="h-3.5 w-3.5 shrink-0" style="color:var(--accent)"><path d="M12 0c.6 6.3 5.7 11.4 12 12-6.3.6-11.4 5.7-12 12-.6-6.3-5.7-11.4-12-12C6.3 11.4 11.4 6.3 12 0Z"></path></svg></span></div></div><section id="message" class="section-y bg-cream"><div class="container-x"><div class="grid gap-12 lg:grid-cols-[1fr_0.85fr] lg:gap-16 items-center"><div class="relative"><span aria-hidden="true" class="font-display pointer-events-none absolute -left-2 -top-10 select-none text-[7rem] leading-none text-brand/[0.08] sm:-top-14 sm:text-[9rem]">「</span><div class="relative"><div class=""><div class="reveal "><div class="flex items-center gap-3 "><span class="h-2 w-2 rotate-45" style="background:var(--brand)"></span><span class="text-sm font-bold tracking-[0.06em]" style="color:var(--brand)">理念</span></div></div><span aria-hidden="true" data-drift="true" data-split="true" class="font-display mt-2 block text-[clamp(2.6rem,6vw,4.6rem)] font-semibold uppercase leading-[0.95] tracking-tight" style="color:var(--brand)">Message</span><h2 data-split="true" class="font-serif-tc mt-6 max-w-2xl text-[clamp(1.5rem,3vw,2.4rem)] font-black leading-[1.35]" style="color:var(--ink)">老城被放生太久了——萬華需要一股乾淨的新力量。</h2></div></div><div class="mt-9 max-w-[40rem] space-y-6"><div class="reveal "><p class="font-serif-tc text-base font-semibold leading-[2.05] text-ink/80 sm:text-lg">我是陳力新，土生土長的萬華囝仔，也是2026台北第五選區中正・萬華市議員候選人。我曾在海外創業、在美國與日本求學工作，看過不同城市怎麼長大、怎麼變好。</p></div></div><a class="mt-7 inline-flex font-bold text-brand underline underline-offset-4" href="/message">閱讀理念全文 →</a><div class="reveal "><div class="mt-9 flex items-center gap-3"><span class="inline-block h-px w-10 bg-brand"></span><svg viewBox=