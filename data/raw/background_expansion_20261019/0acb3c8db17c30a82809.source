efined\",\"requestTagPrefix\":\"$undefined\",\"token\":\"$undefined\"},\"includeDrafts\":\"$undefined\",\"requestTag\":\"next-loader.live\",\"waitFor\":\"$undefined\",\"action\":\"$h1f\",\"onError\":\"$undefined\",\"onWelcome\":\"$undefined\",\"onReconnect\":\"$undefined\",\"onRestart\":\"$undefined\",\"onGoAway\":\"$undefined\"}]\n"])</script><script>self.__next_f.push([1,"20:I[91563,[\"/_next/static/chunks/13heqwm8juqob.js?dpl=dpl_9fbQPzn7GKaBVSVGqov8zN1SAyL2\",\"/_next/static/chunks/0~xnnypc0pno6.js?dpl=dpl_9fbQPzn7GKaBVSVGqov8zN1SAyL2\",\"/_next/static/chunks/0exgx_oz1ix0~.js?dpl=dpl_9fbQPzn7GKaBVSVGqov8zN1SAyL2\",\"/_next/static/chunks/0.cup4f61yqc2.js?dpl=dpl_9fbQPzn7GKaBVSVGqov8zN1SAyL2\",\"/_next/static/chunks/0qec63f13j_fn.js?dpl=dpl_9fbQPzn7GKaBVSVGqov8zN1SAyL2\"],\"default\"]\n21:I[2971,[\"/_next/static/chunks/13heqwm8juqob.js?dpl=dpl_9fbQPzn7GKaBVSVGqov8zN1SAyL2\",\"/_next/static/chunks/0~xnnypc0pno6.js?dpl=dpl_9fbQPzn7GKaBVSVGqov8zN1SAyL2\",\"/_next/static/chunks/0exgx_oz1ix0~.js?dpl=dpl_9fbQPzn7GKaBVSVGqov8zN1SAyL2\",\"/_next/static/chunks/0.cup4f61yqc2.js?dpl=dpl_9fbQPzn7GKaBVSVGqov8zN1SAyL2\",\"/_next/static/chunks/0qec63f13j_fn.js?dpl=dpl_9fbQPzn7GKaBVSVGqov8zN1SAyL2\"],\"default\"]\n"])</script><script>self.__next_f.push([1,"5:[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"WebPage\\\",\\\"@id\\\":\\\"https://www.lishin.taipei/#webpage\\\",\\\"url\\\":\\\"https://www.lishin.taipei/\\\",\\\"name\\\":\\\"陳力新\\\",\\\"about\\\":{\\\"@id\\\":\\\"https://www.lishin.taipei/#person\\\"},\\\"isPartOf\\\":{\\\"@id\\\":\\\"https://www.lishin.taipei/#website\\\"},\\\"inLanguage\\\":\\\"zh-Hant-TW\\\",\\\"dateModified\\\":\\\"2026-10-09T03:22:19.675Z\\\"}\"}}],[\"$\",\"$L20\",null,{}],[\"$\",\"$L21\",null,{\"locale\":\"zh-TW\",\"content\":{\"candidate\":{\"name\":\"陳力新\",\"nameEn\":\"Chen Li-Shin\",\"role\":\"台北市議員參選人\",\"district\":\"中正・萬華\",\"districtFull\":\"台北市第五選舉區（中正區・萬華區）\",\"party\":\"無黨籍\",\"year\":\"2026\",\"election\":\"2026 九合一選舉\",\"slogan\":\"城市需要新力量\",\"sloganAccent\":\"新力量\",\"sloganFull\":\"城市需要新力量！\",\"url\":\"lishin.taipei\"},\"nav\":[{\"_key\":\"content-nav-1\",\"_type\":\"navItem\",\"en\":\"Message\",\"href\":\"/#message\",\"label\":\"理念\"},{\"_key\":\"content-nav-2\",\"_type\":\"navItem\",\"en\":\"About\",\"href\":\"/about\",\"label\":\"認識力新\"},{\"_key\":\"content-nav-3\",\"_type\":\"navItem\",\"en\":\"Policy\",\"href\":\"/policy\",\"label\":\"政見\"},{\"_key\":\"content-nav-4\",\"_type\":\"navItem\",\"en\":\"Vote\",\"href\":\"/#vote\",\"label\":\"投票\"},{\"_key\":\"content-nav-5\",\"_type\":\"navItem\",\"en\":\"News\",\"href\":\"/news\",\"label\":\"動態\"},{\"_key\":\"content-nav-6\",\"_type\":\"navItem\",\"en\":\"FAQ\",\"href\":\"/#faq\",\"label\":\"常見問題\"},{\"_key\":\"content-nav-7\",\"_type\":\"navItem\",\"en\":\"Join\",\"href\":\"/#join\",\"label\":\"加入\"}],\"social\":[{\"_key\":\"content-social-1\",\"_type\":\"socialLink\",\"handle\":\"官方帳號\",\"href\":\"https://linktr.ee/LishinChen\",\"label\":\"LINE\"},{\"_key\":\"content-social-2\",\"_type\":\"socialLink\",\"handle\":\"@chen._.lishin\",\"href\":\"https://www.threads.com/@chen._.lishin\",\"label\":\"Threads\"},{\"_key\":\"content-social-3\",\"_type\":\"socialLink\",\"handle\":\"@chen._.lishin\",\"href\":\"https://www.instagram.com/chen._.lishin/\",\"label\":\"Instagram\"},{\"_key\":\"content-social-4\",\"_type\":\"socialLink\",\"handle\":\"@LISHINCHEN\",\"href\":\"https://www.youtube.com/@LISHINCHEN-h4q\",\"label\":\"YouTube\"},{\"_key\":\"content-social-5\",\"_type\":\"socialLink\",\"handle\":\"LishinChen\",\"href\":\"https://linktr.ee/LishinChen\",\"label\":\"Linktree\"}],\"hero\":{\"badge\":\"2026 台北第五選區｜中正・萬華 市議員候選人\",\"name\":\"陳力新\",\"srHeading\":\"陳力新 — 2026 台北第五選區中正・萬華市議員候選人\",\"lead\":\"城市需要\",\"accent\":\"新力量\",\"tail\":\"！\",\"sub\":\"陳力新，土生土長的萬華囝仔，2026投入台北第五選區中正・萬華市議員選舉。帶著國際經驗回家，無黨無派，只為這座城市做事。\",\"trust\":\"無黨無派 · 不收政治獻金 · 萬華土生土長\",\"ctaPrimary\":{\"label\":\"加入志工\",\"href\":\"/#join\"},\"ctaSecondary\":{\"label\":\"認識我\",\"href\":\"/about\"}},\"marqueeItems\":[\"城市需要新力量\",\"中正・萬華\",\"無黨籍 陳力新\",\"2026 一起改變\",\"不收政治獻金\",\"為萬華帶來改變\"],\"message\":{\"en\":\"Message\",\"zh\":\"理念\",\"heading\":\"老城被放生太久了——萬華需要一股乾淨的新力量。\",\"body\":[\"我是陳力新，土生土長的萬華囝仔，也是2026台北第五選區中正・萬華市議員候選人。我曾在海外創業、在美國與日本求學工作，看過不同城市怎麼長大、怎麼變好。\",\"這一次，我決定回到生我養我的中正、萬華，第一次踏入政壇。我無黨、無派，也公開承諾——不收政治獻金。我要的，是一個能被檢驗、敢於負責的問政方式。\",\"老城區不該只剩回憶。它可以有新的工作、新的店家、新的人潮，也可以更宜居、更安全。城市需要新力量，而我願意做那股力量。\"],\"signOff\":\"市議員參選人 陳力新\"},\"about\":{\"en\":\"About\",\"zh\":\"認識力新\",\"heading\":\"在地的根，國際的眼界\",\"intro\":\"從萬華出發，走向世界，再帶著經驗回家。陳力新投入2026台北第五選區市議員選舉，希望把在地經驗與國際視野帶進中正萬華。\",\"tags\":[\"萬華在地囝仔\",\"留美・留日\",\"國際企業負責人\",\"無黨無派・乾淨參政\"],\"timeline\":[{\"_key\":\"content-about-timeline-1\",\"_type\":\"timelineItem\",\"desc\":\"萬華國中畢業，在艋舺的街巷裡長大，最懂這片土地的脈動與需要。\",\"title\":\"萬華囝仔\",\"year\":\"在地\"},{\"_key\":\"content-about-timeline-2\",\"_type\":\"timelineItem\",\"desc\":\"赴美國與日本求學、歷練，培養國際視野與跨文化的解題能力。\",\"title\":\"留美・留日\",\"year\":\"國際\"},{\"_key\":\"content-about-timeline-3\",\"_type\":\"timelineItem\",\"desc\":\"投身海外青年創業，擔任國際企業負責人，把世界的經驗帶回台北。\",\"title\":\"國際企業負責人\",\"year\":\"創業\"},{\"_key\":\"content-about-timeline-4\",\"_type\":\"timelineItem\",\"desc\":\"國立政治大學 EMBA 碩士；台大 E 勢泮後 EMBA 結業，持續精進治理與管理。\",\"title\":\"政大 EMBA 碩士\",\"year\":\"進修\"}]},\"policy\":{\"en\":\"Policy\",\"zh\":\"政見方向\",\"heading\":\"陳力新六大政見｜給中正萬華一座更好的城\",\"note\":\"政見方向以萬華中正的真實需求為本，將隨地方意見持續滾動修正。\",\"pillars\":[{\"_key\":\"content-policy-pillars-1\",\"_type\":\"policyPillar\",\"desc\":\"用 AI 與數位工具盤點老城區的閒置空間與人流，把科技導入地方治理，讓市民服務更即時、申辦更便民，也讓艋舺的店家與人潮一起回流，老萬華長出新活力。\",\"no\":\"01\",\"slug\":\"tech\",\"tag\":\"Tech\",\"title\":\"科技活化・地方創生\"},{\"_key\":\"content-policy-pillars-2\",\"_type\":\"policyPillar\",\"desc\":\"以海外創業者的第一手經驗，搭建青年就業與微型創業的支持網，盤點在地共創空間、媒合資源與輔導，讓年輕人願意留在萬華，在家鄉把想法做成事業。\",\"no\":\"02\",\"slug\":\"youth\",\"tag\":\"Youth\",\"title\":\"青年就業・新創扶植\"},{\"_key\":\"content-policy-pillars-3\",\"_type\":\"policyPillar\",\"desc\":\"把留美、留日與經營國際企業的歷練帶回家鄉，推動跨城市交流與國際資源連結，讓中正、萬華逐步接軌世界，提升老城區面對未來的長期競爭力。\",\"no\":\"03\",\"slug\":\"global\",\"tag\":\"Global\",\"title\":\"國際視野・城市競爭力\"},{\"_key\":\"content-policy-pillars-4\",\"_type\":\"policyPillar\",\"desc\":\"無黨無派、不收政治獻金，也提醒鄉親：以我名義對外募款一律是詐騙。推動行程與問政資料公開、可查詢，讓每一筆預算都攤在陽光下，接受市民監督。\",\"no\":\"04\",\"slug\":\"clean\",\"tag\":\"Clean\",\"title\":\"廉能政治・透明問政\"},{\"_key\":\"content-policy-pillars-5\",\"_type\":\"policyPillar\",\"desc\":\"盤點老舊街區的人行道、路燈照明與無障礙環境，推動友善長照與托育的可近性，打造對長輩、孩子與行人都安心好走、住得安心的宜居社區。\",\"no\":\"05\",\"slug\":\"livable\",\"tag\":\"Livable\",\"title\":\"宜居社區・安全友善\"},{\"_key\":\"content-policy-pillars-6\",\"_type\":\"policyPillar\",\"desc\":\"以艋舺的歷史、信仰與街區故事為底蘊，串連在地店家與觀光動線，推動文化結合科技的導覽體驗，帶動在地經濟，把萬華的故事好好說給世界聽。\",\"no\":\"06\",\"slug\":\"culture\",\"tag\":\"Culture\",\"title\":\"觀光文化・在地經濟\"}]},\"vision\":{\"en\":\"Vision\",\"zh\":\"願景\",\"heading\":\"把萬華的老底蘊，接上面向世界的新力量\",\"lead\":\"我在萬華長大，也曾在美國、日本求學與工作。這次投入台北第五選區中正萬華市議員選舉，我希望把國際的眼界帶回家鄉，用科技與新的治理方式改善老城區生活，讓中正萬華不只是被懷念的過去，更成為被期待的未來。\",\"pillars\":[{\"_key\":\"content-vision-pillars-1\",\"_type\":\"simpleCopy\",\"desc\":\"把 AI 與數位工具帶進地方治理，從停車、長照到觀光導覽逐項盤點在地需求，讓萬華老街區保有濃濃人情味，也能更聰明、更便利地運作。\",\"title\":\"用科技，讓老城區重新呼吸\"},{\"_key\":\"content-vision-pillars-2\",\"_type\":\"simpleCopy\",\"desc\":\"宜居不是口號，而是每天的生活細節。推動更友善的步行環境、社區照顧與公共空間，讓長輩在熟悉的巷弄裡安心生活，也讓年輕世代願意把根留在萬華、留在中正。\",\"title\":\"讓長輩安心、年輕人願意留下\"},{\"_key\":\"content-vision-pillars-3\",\"_type\":\"simpleCopy\",\"desc\":\"我曾在海外創業、經營國際企業，深知連結的價值。推動在地與國際接軌，讓萬華的文化、店家與青年被更多人看見，也讓世界的好經驗在這片土地上慢慢落地。\",\"title\":\"把世界帶進來，把萬華帶出去\"}],\"closing\":\"城市需要新力量，而這股新力量，就從萬華這片我們共同的土地開始。\"},\"ideas\":{\"en\":\"Ideas\",\"zh\":\"想法\",\"heading\":\"關於萬華，我是這樣想的\",\"sub\":\"這些不是漂亮的口號，是我平常真正在想、也想當面跟你說的話。\",\"notes\":[{\"_key\":\"content-ideas-notes-1\",\"_type\":\"ideaNote\",\"text\":\"我在國外看過不少城市，用科技把老問題一個個解開。萬華不是舊，它只是還沒被好好升級。我想試著把 AI 和數位工具帶進地方治理，讓老城區也能更聰明、更方便，這是我最想做的方向。\",\"topic\":\"科技萬華\"},{\"_key\":\"content-ideas-notes-2\",\"_type\":\"ideaNote\",\"text\":\"我選擇不收政治獻金，因為我想欠的是鄉親的信任，不是任何人的人情。也提醒大家：如果有人用我的名義對外募款，一律是詐騙，請務必小心，別讓壞人有機可乘。\",\"topic\":\"拒收獻金\"},{\"_key\":\"content-ideas-notes-4\",\"_type\":\"ideaNote\",\"text\":\"我在美國、在日本念過書、做過事，但我始終記得自己是萬華長大的孩子。把在國外學到、看到的好東西帶回家鄉，讓熟悉的老地方也能接上新世界，是我一直放在心上的事。\",\"topic\":\"國際視野\"},{\"_key\":\"content-ideas-notes-5\",\"_type\":\"ideaNote\",\"text\":\"力新，其實就是「新力量」。我沒有派系、也沒有包袱，第一次參政，反而更敢想、更願意聽、也更願意從頭學起。城市需要新力量，我想當那個願意陪萬華一起往前走的人。\",\"topic\":\"新力量\"}]},\"field\":{\"en\":\"Field\",\"zh\":\"選情現況\",\"heading\":\"2026台北第五選區｜無黨籍新人陳力新的參選特色\",\"body\":\"2026九合一選舉中，台北第五選區涵蓋中正區與萬華區，市議員候選人競爭激烈。選民比較候選人時，可從政見、在地連結、專業背景、政黨立場與公共承諾等面向判斷。陳力新以無黨籍新人身分投入，特色包括萬華在地背景、國際企業經驗、科技治理理念，以及不收政治獻金的公開主張。\",\"stats\":[{\"_key\":\"content-field-stats-1\",\"_type\":\"stat\",\"label\":\"中正區・萬華區\",\"unit\":\"選舉區\",\"value\":\"台北第五\"},{\"_key\":\"content-field-stats-2\",\"_type\":\"stat\",\"label\":\"台北市議員選舉\",\"unit\":\"九合一\",\"value\":\"2026\"},{\"_key\":\"content-field-stats-3\",\"_type\":\"stat\",\"label\":\"公開承諾不收受\",\"unit\":\"政治獻金\",\"value\":\"0\"},{\"_key\":\"content-field-stats-4\",\"_type\":\"stat\",\"label\":\"萬華土生土長\",\"unit\":\"在地\",\"value\":\"100%\"}]},\"news\":{\"en\":\"News\",\"zh\":\"最新動態\",\"heading\":\"頻道最新影音與社群動態\",\"sub\":\"直接同步陳力新的 YouTube 與 Instagram，第一手掌握最新消息。\",\"fallback\":[{\"_key\":\"content-news-fallback-1\",\"_type\":\"socialCard\",\"desc\":\"政見影音、活動紀錄與第一手談話，都在力新的官方頻道。\",\"href\":\"https://www.youtube.com/@LISHINCHEN-h4q\",\"source\":\"youtube\",\"title\":\"訂閱 YouTube 頻道\"},{\"_key\":\"content-news-fallback-2\",\"_type\":\"socialCard\",\"desc\":\"走進基層的日常、活動花絮與限時動態，在 IG 看見最真實的力新。\",\"href\":\"https://www.instagram.com/chen._.lishin/\",\"source\":\"instagram\",\"title\":\"追蹤 Instagram\"},{\"_key\":\"content-news-fallback-3\",\"_type\":\"socialCard\",\"desc\":\"想法、回應與即時討論，歡迎在 Threads 一起聊聊中正萬華的未來。\",\"href\":\"https://www.threads.com/@chen._.lishin\",\"source\":\"threads\",\"title\":\"在 Threads 上對話\"}]},\"cleanNote\":\"力新不收政治獻金；任何以陳力新名義對外募款，都是詐騙，請小心查證。\",\"join\":{\"en\":\"Join\",\"zh\":\"加入我們\",\"heading\":\"把你的力量，借給這座城市\",\"body\":\"改變不會從天而降，它來自每一個願意站出來的人。從追蹤、分享，到加入志工——選一個你做得到的方式，一起為中正萬華注入新力量。\",\"clean\":\"力新不收政治獻金；任何以陳力新名義對外募款，都是詐騙，請小心查證。\",\"ways\":[{\"_key\":\"content-join-ways-1\",\"_type\":\"joinWay\",\"action\":\"share\",\"cta\":\"一鍵分享\",\"desc\":\"在 Threads、IG、YouTube 追蹤力新，把理念分享給住在中正、萬華的朋友。\",\"step\":\"01\",\"title\":\"追蹤 + 分享\"},{\"_key\":\"content-join-ways-2\",\"_type\":\"joinWay\",\"action\":\"volunteer\",\"cta\":\"我要加入\",\"desc\":\"留下聯絡方式，投票日前我們會邀你一起掃街、顧攤、線上小編，做你做得到的。\",\"step\":\"02\",\"title\":\"加入志工\"},{\"_key\":\"content-join-ways-3\",\"_type\":\"joinWay\",\"action\":\"vote\",\"cta\":\"看投票資訊\",\"desc\":\"設籍中正、萬華的鄉親，記得 11/28 返鄉投票，也提醒家人朋友一起。\",\"step\":\"03\",\"title\":\"把消息帶回家\"}],\"cta\":{\"label\":\"加入志工\",\"href\":\"#volunteer\"},\"follow\":{\"label\":\"所有社群連結\",\"href\":\"https://linktr.ee/LishinChen\"}},\"share\":{\"heading\":\"幫力新一個忙\",\"body\":\"找 3 個住中正、萬華的朋友，一起認識力新。分享，是素人最珍貴的力量。\",\"text\":\"城市需要新力量｜陳力新 中正・萬華 市議員參選人，無黨無派、不收政治獻金。\",\"url\":\"https://www.lishin.taipei\"},\"volunteer\":{\"en\":\"Join Us\",\"zh\":\"加入志工\",\"heading\":\"留個聯絡方式，投票日見\",\"body\":\"30 秒、不需任何費用，力新絕不對外募款。留下聯絡方式，我們會在重要時刻邀你一起出力。\",\"fields\":{\"name\":\"你的稱呼\",\"contact\":\"LINE ID 或 Email\",\"district\":\"你住在哪一區？\",\"help\":\"想怎麼幫忙？（可複選）\"},\"districts\":[\"中正區\",\"萬華區\",\"其他（仍可幫忙分享）\"],\"helpOptions\":[\"分享理念\",\"掃街/拜票\",\"看板/貼紙\",\"線上小編\",\"活動志工\"],\"submit\":\"送出，加入力新\",\"success\":\"收到了，謝謝你！力新團隊會盡快和你聯絡。記得 11/28 投票 💪\",\"fallbackEmail\":\"team@lishin.taipei\"},\"faq\":{\"en\":\"FAQ\",\"zh\":\"常見問題\",\"heading\":\"你可能想問的事，力新直接回答\",\"items\":[{\"_key\":\"6d55d760c7a4\",\"_type\":\"faqItem\",\"a\":\"陳力新是2026台北第五選區中正・萬華市議員候選人，以無黨籍身分參選。他在萬華成長，曾赴美國與日本求學、工作，並具有海外創業及國際企業經營經驗。\",\"q\":\"陳力新是誰？\"},{\"_key\":\"caed716e4763\",\"_type\":\"faqItem\",\"a\":\"「城市需要新力量」代表陳力新希望把新的治理思維帶進中正萬華，包括科技治理、國際視野、青年發展、地方創生、宜居社區及透明政治，同時保留老城區的文化與人情味。\",\"q\":\"陳力新的「城市需要新力量」主張是什麼？\"},{\"_key\":\"011ef310ad47\",\"_type\":\"faqItem\",\"a\":\"陳力新目前提出六大方向，包括科技活化與地方創生、青年就業與新創扶植、國際視野與城市競爭力、廉能政治與透明問政、宜居社區與安全友善，以及觀光文化與在地經濟。\",\"q\":\"陳力新的主要政見有哪些？\"},{\"_key\":\"1d8676db07b1\",\"_type\":\"faqItem\",\"a\":\"台北第五選區涵蓋中正區與萬華區。比較市議員候選人時，可以查看政見、地方連結、專業經驗、政黨或無黨籍背景，以及候選人的公共承諾與實際行動，再依自己最重視的議題做決定。\",\"q\":\"2026台北第五選區候選人比較時可以看哪些條件？\"},{\"_key\":\"c8d44fce4006\",\"_type\":\"faqItem\",\"a\":\"陳力新的主要特色包括萬華在地成長背景、無黨籍身分、海外與國際企業經驗、科技治理取向，以及公開主張不收政治獻金。\",\"q\":\"萬華市議員候選人陳力新有什麼特色？\"},{\"_key\":\"content-faq-items-1\",\"_type\":\"faqItem\",\"a\":\"我把『新』當成優勢：沒有派系、沒有包袱，才能就事論事。我有國際企業經營與政大 EMBA 的治理歷練，政見具體、承諾透明可被檢驗。改變，需要有人先站出來。\",\"q\":\"投給沒選過的素人，會不會浪費票？\"},{\"_key\":\"content-faq-items-2\",\"_type\":\"faqItem\",\"a\":\"正因為無黨無派，我才能跨陣營合作、對選民負責而不是對派系。議會裡需要願意就事論事、把萬華中正放第一的人。\",\"q\":\"無黨籍進議會，孤掌難鳴嗎？\"},{\"_key\":\"content-faq-items-3\",\"_type\":\"faqItem\",\"a\":\"我公開承諾不收政治獻金，用最精簡的方式選舉。也提醒大家：任何以我名義對外募款，都是詐騙，請小心。\",\"q\":\"不收政治獻金，那競選經費哪裡來？\"},{\"_key\":\"content-faq-items-4\",\"_type\":\"faqItem\",\"a\":\"台北市第五選舉區包括中正區與萬華區。投票資格不只看設籍地：須具中華民國國籍、年滿 20 歲，並符合居住期間與選舉人名冊等規定。一般須繼續居住 4 個月以上；行政區內劃分選區時，以該行政區域計算，選舉公告後遷入選區另有限制。年齡及居住期間原則計算至投票日前一日。請依戶籍資料向戶政機關或選委會確認。\",\"q\":\"第五選舉區包含哪些地方？\"},{\"_key\":\"content-faq-items-5\",\"_type\":\"faqItem\",\"a\":\"最簡單：在社群追蹤、把理念分享給中正萬華的朋友。再進一步：加入志工留下聯絡方式，投票日前一起出力。\",\"q\":\"我要怎麼幫忙？\"},{\"_key\":\"content-faq-items-6\",\"_type\":\"faqItem\",\"a\":\"把數位工具帶進地方治理與服務——從停車、長照到觀光導覽，讓老城區保有人情味，也能更聰明、更便利。這是我最想推動的方向。\",\"q\":\"『用 AI／科技活化萬華』是什麼意思？\"}]},\"footprint\":{\"en\":\"Footprint\",\"zh\":\"基層足跡\",\"heading\":\"一里一里走，把整個選區放進行程\",\"body\":\"中正 31 里、萬華 36 里，一共 67 個里。力新承諾：在投票日前，走進每一個里，聽每一個里的事。每完成一個里，這裡就點亮一格——進度公開，接受檢驗。\",\"invite\":\"想邀力新到你的里走走？加入志工時留個話，或到社群私訊我們。\",\"legend\":{\"visited\":\"已走過\",\"pending\":\"還沒到，快了\"}},\"voices\":{\"en\":\"Voices\",\"zh\":\"城市的心聲\",\"heading\":\"你想改變中正萬華的一件事，是什麼？\",\"body\":\"問政的題目不該從辦公室裡想出來，而是從街上聽回來。留下你最在意的一件事——它會直接進入力新的問政筆記。\",\"themesLabel\":\"走基層時，大家最常提到的事\",\"themes\":[\"人行道好走一點\",\"巷口的路燈亮一點\",\"停車不要再繞圈\",\"老店有人接手\",\"孩子上學的路更安全\",\"長輩就近有照顧\",\"垃圾與環境清潔\",\"捷運周邊的發展\"],\"form\":{\"message\":\"你最想改變的一件事\",\"placeholder\":\"例：○○街的騎樓高低差，長輩很容易跌倒……\",\"district\":\"你住在哪一區？\",\"contact\":\"聯絡方式（選填，方便我們回覆）\",\"submit\":\"送出，讓力新聽見\"},\"districts\":[\"中正區\",\"萬華區\",\"其他\"],\"success\":\"收到了，謝謝你。每一則心聲，力新團隊都會讀。\",\"fallbackEmail\":\"team@lishin.taipei\"},\"vote\":{\"en\":\"Vote\",\"zh\":\"投票資訊\",\"heading\":\"把好感，化成那一票\",\"electionDate\":\"2026-11-28\",\"electionLabel\":\"2026/11/28（六）投票\",\"ballotNo\":\"\",\"items\":[{\"_key\":\"content-vote-items-1\",\"_type\":\"voteItem\",\"label\":\"投票日\",\"note\":\"2026 年（週六）\",\"value\":\"11 / 28\"},{\"_key\":\"content-vote-items-2\",\"_type\":\"voteItem\",\"label\":\"選區\",\"note\":\"中正區・萬華區\",\"value\":\"第五選舉區\"},{\"_key\":\"content-vote-items-3\",\"_type\":\"voteItem\",\"label\":\"票號\",\"note\":\"確定後第一時間更新\",\"value\":\"待公告\"}],\"reminder\":\"台北市第五選舉區包括中正區與萬華區。投票資格不只看設籍地：須具中華民國國籍、年滿 20 歲，並符合居住期間與選舉人名冊等規定。一般須繼續居住 4 個月以上；行政區內劃分選區時，以該行政區域計算，選舉公告後遷入選區另有限制。年齡及居住期間原則計算至投票日前一日。請依戶籍資料向戶政機關或選委會確認。\",\"calendarCta\":\"加入行事曆提醒\"}},\"media\":{\"headerLogoLight\":{\"src\":\"https://cdn.sanity.io/images/h51j8cya/production/fa99cdc6748aa544492b291f50f3483546969cdf-3009x1398.png\",\"alt\":\"陳力新\",\"position\":\"$undefined\",\"en\":\"$undefined\",\"zh\":\"$undefined\"},\"headerLogoDark\":{\"src\":\"https://cdn.sanity.io/images/h51j8cya/production/27f34a97f5a501fd80aa29d9b7f28cd4b132ec68-3009x1398.png\",\"alt\":\"陳力新\",\"position\":\"$undefined\",\"en\":\"$undefined\",\"zh\":\"$undefined\"},\"footerLogo\":{\"src\":\"https://cdn.sanity.io/images/h51j8cya/production/fa99cdc6748aa544492b291f50f3483546969cdf-3009x1398.png\",\"alt\":\"陳力新\",\"position\":\"$undefined\",\"en\":\"$undefined\",\"zh\":\"$undefined\"},\"heroPortrait\":{\"src\":\"https://cdn.sanity.io/images/h51j8cya/production/2c6979a93482834735a22373b955e939255e2e94-889x1500.webp\",\"alt\":\"陳力新\",\"position\":\"$undefined\",\"en\":\"$undefined\",\"zh\":\"$undefined\"},\"aboutPortrait\":{\"src\":\"https://cdn.sanity.io/images/h51j8cya/production/512f3b2bfc34d8400d2937773d000160a5332b68-1000x1500.webp\",\"alt\":\"陳力新穿深色西裝的肖像\",\"position\":\"$undefined\",\"en\":\"$undefined\",\"zh\":\"$undefined\"},\"messagePhoto\":{\"src\":\"https://cdn.sanity.io/images/h51j8cya/production/657068f8aed876255a3488f0b7e435193433bf74-1000x1500.webp\",\"alt\":\"陳力新肖像\",\"position\":\"$undefined\",\"en\":\"$undefined\",\"zh\":\"$undefined\"},\"joinPhoto\":{\"src\":\"https://cdn.sanity.io/images/h51j8cya/production/02ba5bebb9514defc14637976eaf859923889840-1000x1500.webp\",\"alt\":\"陳力新穿淺灰色西裝的肖像\",\"position\":\"$undefined\",\"en\":\"$undefined\",\"zh\":\"$undefined\"},\"newsHero\":{\"src\":\"https://cdn.sanity.io/images/h51j8cya/production/036d84aea8b723ba10f5f5e62e0968bce97bfbeb-2048x1152.webp\",\"alt\":\"萬華青草巷的清晨\",\"position\":\"$undefined\",\"en\":\"$undefined\",\"zh\":\"$undefined\"},\"voteReminder\":{\"src\":\"https://cdn.sanity.io/images/h51j8cya/production/de757cc831ebb162ce105aac80d6905367f6898a-1080x1080.png\",\"alt\":\"2026 投票提醒\",\"position\":\"$undefined\",\"en\":\"$undefined\",\"zh\":\"$undefined\"},\"scenes\":[{\"src\":\"https://cdn.sanity.io/images/h51j8cya/production/f70725f621022d70ea257076a195490cd1ee99ff-2048x1152.webp\",\"alt\":\"剝皮寮歷史街區的清晨\",\"position\":\"72% 50%\",\"en\":\"Bangka, where Taipei began\",\"zh\":\"艋舺・剝皮寮・清晨\"},{\"src\":\"https://cdn.sanity.io/images/h51j8cya/production/70e223a6e62489475bbf8787a22fd1774f8a0493-2048x1152.webp\",\"alt\":\"龍山寺的香火與光影\",\"position\":\"$undefined\",\"en\":\"Faith of the old town\",\"zh\":\"龍山寺・香火不息\"},{\"src\":\"https://cdn.sanity.io/images/h51j8cya/production/5623ade4d91d321d779f897cf6b43b5bc8252202-2048x1152.webp\",\"alt\":\"萬華華江河岸的黃昏\",\"position\":\"$undefined\",\"en\":\"Walk the whole district\",\"zh\":\"河岸・日常的傍晚\"},{\"src\":\"https://cdn.sanity.io/images/h51j8cya/production/8bed77cb843aea3719aef0992b50cf51a49f55c0-2048x1152.webp\",\"alt\":\"萬華夜市華燈初上\",\"position\":\"$undefined\",\"en\":\"The night is still young\",\"zh\":\"華燈初上・萬華夜色\"}]}}],\"$L22\",\"$L23\",\"$L24\"]\n"])</script><script>self.__next_f.push([1,"25