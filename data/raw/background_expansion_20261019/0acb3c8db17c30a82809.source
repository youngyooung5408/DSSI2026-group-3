-6.3-5.7-11.4-12-12C6.3 11.4 11.4 6.3 12 0Z"></path></svg></span><span class="flex items-center" style="color:var(--ink)"><span class="font-display whitespace-nowrap px-6 text-lg font-semibold uppercase tracking-wide sm:text-2xl">城市需要新力量</span><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="h-3.5 w-3.5 shrink-0" style="color:var(--brand)"><path d="M12 0c.6 6.3 5.7 11.4 12 12-6.3.6-11.4 5.7-12 12-.6-6.3-5.7-11.4-12-12C6.3 11.4 11.4 6.3 12 0Z"></path></svg></span><span class="flex items-center" style="color:var(--ink)"><span class="font-display whitespace-nowrap px-6 text-lg font-semibold uppercase tracking-wide sm:text-2xl">中正・萬華</span><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="h-3.5 w-3.5 shrink-0" style="color:var(--brand)"><path d="M12 0c.6 6.3 5.7 11.4 12 12-6.3.6-11.4 5.7-12 12-.6-6.3-5.7-11.4-12-12C6.3 11.4 11.4 6.3 12 0Z"></path></svg></span><span class="flex items-center" style="color:var(--ink)"><span class="font-display whitespace-nowrap px-6 text-lg font-semibold uppercase tracking-wide sm:text-2xl">無黨籍 陳力新</span><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="h-3.5 w-3.5 shrink-0" style="color:var(--brand)"><path d="M12 0c.6 6.3 5.7 11.4 12 12-6.3.6-11.4 5.7-12 12-.6-6.3-5.7-11.4-12-12C6.3 11.4 11.4 6.3 12 0Z"></path></svg></span><span class="flex items-center" style="color:var(--ink)"><span class="font-display whitespace-nowrap px-6 text-lg font-semibold uppercase tracking-wide sm:text-2xl">2026 一起改變</span><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="h-3.5 w-3.5 shrink-0" style="color:var(--brand)"><path d="M12 0c.6 6.3 5.7 11.4 12 12-6.3.6-11.4 5.7-12 12-.6-6.3-5.7-11.4-12-12C6.3 11.4 11.4 6.3 12 0Z"></path></svg></span><span class="flex items-center" style="color:var(--ink)"><span class="font-display whitespace-nowrap px-6 text-lg font-semibold uppercase tracking-wide sm:text-2xl">不收政治獻金</span><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="h-3.5 w-3.5 shrink-0" style="color:var(--brand)"><path d="M12 0c.6 6.3 5.7 11.4 12 12-6.3.6-11.4 5.7-12 12-.6-6.3-5.7-11.4-12-12C6.3 11.4 11.4 6.3 12 0Z"></path></svg></span><span class="flex items-center" style="color:var(--ink)"><span class="font-display whitespace-nowrap px-6 text-lg font-semibold uppercase tracking-wide sm:text-2xl">為萬華帶來改變</span><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="h-3.5 w-3.5 shrink-0" style="color:var(--brand)"><path d="M12 0c.6 6.3 5.7 11.4 12 12-6.3.6-11.4 5.7-12 12-.6-6.3-5.7-11.4-12-12C6.3 11.4 11.4 6.3 12 0Z"></path></svg></span></div></div><section id="field" class="section-y relative overflow-hidden bg-brand text-white"><span aria-hidden="true" data-parallax="1.5" class="font-display pointer-events-none absolute -right-4 top-6 select-none text-[28vw] font-semibold uppercase leading-none tracking-tighter text-white/[0.06] sm:top-4">2026</span><div aria-hidden="true" class="pointer-events-none absolute -left-40 bottom-0 h-[34rem] w-[34rem] rounded-full bg-brand-deep opacity-60 blur-3xl"></div><div class="container-x relative z-10"><div class=""><div class="reveal "><div class="flex items-center gap-3 "><span class="h-2 w-2 rotate-45" style="background:var(--accent)"></span><span class="text-sm font-bold tracking-[0.06em]" style="color:#fff">選情現況</span></div></div><span aria-hidden="true" data-drift="true" data-split="true" class="font-display mt-2 block text-[clamp(2.6rem,6vw,4.6rem)] font-semibold uppercase leading-[0.95] tracking-tight" style="color:rgba(255,255,255,0.96)">Field</span><h2 data-split="true" class="mt-5 max-w-2xl text-xl font-bold leading-snug sm:text-2xl" style="color:#fff">2026台北第五選區｜無黨籍新人陳力新的參選特色</h2></div><div class="reveal "><p class="mt-7 max-w-2xl text-base leading-[1.9] text-white/85 sm:text-lg">2026九合一選舉中，台北第五選區涵蓋中正區與萬華區，市議員候選人競爭激烈。選民比較候選人時，可從政見、在地連結、專業背景、政黨立場與公共承諾等面向判斷。陳力新以無黨籍新人身分投入，特色包括萬華在地背景、國際企業經驗、科技治理理念，以及不收政治獻金的公開主張。</p></div><div class="mt-14 grid grid-cols-2 border-t border-white/15 lg:grid-cols-4"><div class="reveal border-b border-white/15 py-8 sm:py-10 pr-6 sm:pr-8 lg:border-b-0 lg:border-l lg:pl-8 lg:border-l-0 lg:pl-0"><div class="flex items-center gap-2 text-accent"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="h-3 w-3"><path d="M12 0c.6 6.3 5.7 11.4 12 12-6.3.6-11.4 5.7-12 12-.6-6.3-5.7-11.4-12-12C6.3 11.4 11.4 6.3 12 0Z"></path></svg><span class="text-sm font-bold text-white/70">選舉區</span></div><div class="font-display mt-3 text-5xl font-semibold leading-none sm:text-6xl text-white">台北第五</div><div class="mt-4 text-sm text-white/60">中正區・萬華區</div></div><div class="reveal border-b border-white/15 py-8 sm:py-10 border-l pl-6 sm:pl-8 lg:border-b-0 lg:border-l lg:pl-8 "><div class="flex items-center gap-2 text-accent"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="h-3 w-3"><path d="M12 0c.6 6.3 5.7 11.4 12 12-6.3.6-11.4 5.7-12 12-.6-6.3-5.7-11.4-12-12C6.3 11.4 11.4 6.3 12 0Z"></path></svg><span class="text-sm font-bold text-white/70">九合一</span></div><div data-count="2026" data-suffix="" class="font-display mt-3 text-5xl font-semibold leading-none sm:text-6xl text-white">2026</div><div class="mt-4 text-sm text-white/60">台北市議員選舉</div></div><div class="reveal border-b border-white/15 py-8 sm:py-10 pr-6 sm:pr-8 lg:border-b-0 lg:border-l lg:pl-8 "><div class="flex items-center gap-2 text-accent"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="h-3 w-3"><path d="M12 0c.6 6.3 5.7 11.4 12 12-6.3.6-11.4 5.7-12 12-.6-6.3-5.7-11.4-12-12C6.3 11.4 11.4 6.3 12 0Z"></path></svg><span class="text-sm font-bold text-white/70">政治獻金</span></div><div class="font-display mt-3 text-5xl font-semibold leading-none sm:text-6xl text-accent">0</div><div class="mt-4 text-sm text-white/60">公開承諾不收受</div></div><div class="reveal border-b border-white/15 py-8 sm:py-10 border-l pl-6 sm:pl-8 lg:border-b-0 lg:border-l lg:pl-8 "><div class="flex items-center gap-2 text-accent"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="h-3 w-3"><path d="M12 0c.6 6.3 5.7 11.4 12 12-6.3.6-11.4 5.7-12 12-.6-6.3-5.7-11.4-12-12C6.3 11.4 11.4 6.3 12 0Z"></path></svg><span class="text-sm font-bold text-white/70">在地</span></div><div data-count="100" data-suffix="%" class="font-display mt-3 text-5xl font-semibold leading-none sm:text-6xl text-accent">100%</div><div class="mt-4 text-sm text-white/60">萬華土生土長</div></div></div></div></section><section aria-label="龍山寺的香火與光影" class="relative overflow-hidden bg-ink"><div aria-hidden="true" data-parallax="0.5" class="absolute -inset-y-[8%] inset-x-0"><img alt="" loading="lazy" decoding="async" data-nimg="fill" class="duotone object-cover" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;object-position:50% 50%;color:transparent" sizes="100vw" srcSet="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fh51j8cya%2Fproduction%2F70e223a6e62489475bbf8787a22fd1774f8a0493-2048x1152.webp&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fh51j8cya%2Fproduction%2F70e223a6e62489475bbf8787a22fd1774f8a0493-2048x1152.webp&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fh51j8cya%2Fproduction%2F70e223a6e62489475bbf8787a22fd1774f8a0493-2048x1152.webp&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fh51j8cya%2Fproduction%2F70e223a6e62489475bbf8787a22fd1774f8a0493-2048x1152.webp&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fh51j8cya%2Fproduction%2F70e223a6e62489475bbf8787a22fd1774f8a0493-2048x1152.webp&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fh51j8cya%2Fproduction%2F70e223a6e62489475bbf8787a22fd1774f8a0493-2048x1152.webp&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fh51j8cya%2Fproduction%2F70e223a6e62489475bbf8787a22fd1774f8a0493-2048x1152.webp&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fh51j8cya%2Fproduction%2F70e223a6e62489475bbf8787a22fd1774f8a0493-2048x1152.webp&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fh51j8cya%2Fproduction%2F70e223a6e62489475bbf8787a22fd1774f8a0493-2048x1152.webp&amp;w=3840&amp;q=75"/></div><div aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-ink/60 via-transparent to-ink/10"></div><div class="container-x relative flex h-[46vh] min-h-[340px] items-end justify-between pb-8 sm:h-[56vh] sm:pb-10"><span data-drift="true" class="font-display block max-w-[80%] text-[clamp(2.2rem,7vw,5rem)] font-semibold uppercase leading-none tracking-tight text-white/90">Faith of the old town</span><span aria-hidden="true" class="v-text hidden max-h-[60%] select-none self-start pt-2 text-xs font-bold text-white/85 sm:block">龍山寺・香火不息</span></div></section><section id="vote" class="section-y bg-cream"><div class="container-x"><div class=""><div class="reveal "><div class="flex items-center gap-3 "><span class="h-2 w-2 rotate-45" style="background:var(--brand)"></span><span class="text-sm font-bold tracking-[0.06em]" style="color:var(--brand)">投票資訊</span></div></div><span aria-hidden="true" data-drift="true" data-split="true" class="font-display mt-2 block text-[clamp(2.6rem,6vw,4.6rem)] font-semibold uppercase leading-[0.95] tracking-tight" style="color:var(--brand)">Vote</span><h2 data-split="true" class="mt-5 max-w-2xl text-xl font-bold leading-snug sm:text-2xl" style="color:var(--ink)">把好感，化成那一票</h2></div><div class="reveal "><div class="mt-12 rounded-[24px] border border-line bg-white p-8 text-center sm:p-12"><span class="font-display text-[clamp(4rem,12vw,8rem)] font-semibold leading-none text-brand">–</span><p class="mt-4 text-base font-bold text-ink-soft sm:text-lg">11/28（六）投票</p></div></div><div class="mt-8 grid gap-5 sm:grid-cols-3"><div class="reveal "><div class="h-full rounded-[20px] border border-line bg-white p-6"><p class="text-sm font-bold tracking-[0.06em] text-ink-soft">投票日</p><p class="font-display mt-3 font-bold text-ink text-3xl">11 / 28</p><p class="mt-2 text-sm text-ink-soft">2026 年（週六）</p></div></div><div class="reveal "><div class="h-full rounded-[20px] border border-line bg-white p-6"><p class="text-sm font-bold tracking-[0.06em] text-ink-soft">選區</p><p class="font-display mt-3 font-bold text-ink text-2xl">第五選舉區</p><p class="mt-2 text-sm text-ink-soft">中正區・萬華區</p></div></div><div class="reveal "><div class="h-full rounded-[20px] border border-line bg-white p-6"><p class="text-sm font-bold tracking-[0.06em] text-ink-soft">票號</p><p class="font-display mt-3 font-bold text-ink text-3xl">待公告</p><p class="mt-2 text-sm text-ink-soft">確定後第一時間更新</p></div></div></div><div class="reveal "><div class="mt-8 rounded-[20px] border-l-4 border-brand bg-brand-soft p-5 text-sm leading-relaxed text-ink">台北市第五選舉區包括中正區與萬華區。投票資格不只看設籍地：須具中華民國國籍、年滿 20 歲，並符合居住期間與選舉人名冊等規定。一般須繼續居住 4 個月以上；行政區內劃分選區時，以該行政區域計算，選舉公告後遷入選區另有限制。年齡及居住期間原則計算至投票日前一日。請依戶籍資料向戶政機關或選委會確認。</div></div><p class="mt-5 text-sm leading-relaxed text-ink-soft"><a href="https://law.cec.gov.tw/LawContent.aspx?id=GL000292" class="text-brand underline underline-offset-4" target="_blank" rel="noopener noreferrer">官方法源：公職人員選舉罷免法第 4、14–20 條</a><br/>查核日期<!-- -->：<time dateTime="2026-09-09">2026-09-09</time></p><div class="reveal "><div class="mt-8 flex flex-wrap items-center gap-5"><a href="https://www.google.com/calendar/render?action=TEMPLATE&amp;text=2026%2F11%2F28%EF%BC%88%E5%85%AD%EF%BC%89%E6%8A%95%E7%A5%A8%20%C2%B7%20%E4%B8%AD%E6%AD%A3%E3%83%BB%E8%90%AC%E8%8F%AF&amp;dates=20261128/20261129&amp;details=%E5%9F%8E%E5%B8%82%E9%9C%80%E8%A6%81%E6%96%B0%E5%8A%9B%E9%87%8F%EF%BC%81%20%E2%80%94%20%E9%99%B3%E5%8A%9B%E6%96%B0" target="_blank" rel="noopener noreferrer" data-ga-event="add_to_calendar" class="inline-flex items-center rounded-[10px] bg-brand px-6 py-3 font-bold text-white transition-colors hover:bg-brand-deep">加入行事曆提醒</a><a href="https://www.cec.gov.tw/" target="_blank" rel="noopener noreferrer" data-ga-event="cta_clicked" data-ga-location="vote" data-ga-label="cec_lookup" class="link-sweep text-sm font-bold text-brand">投票所資訊：中選會官網查詢 ↗</a><a href="https://cdn.sanity.io/images/h51j8cya/production/de757cc831ebb162ce105aac80d6905367f6898a-1080x1080.png" download="1128-返鄉投票-陳力新.png" data-ga-event="cta_clicked" data-ga-location="vote" data-ga-label="reminder_card" class="link-sweep text-sm font-bold text-brand">下載提醒圖卡，轉傳給家人 ↓</a></div></div></div></section><section id="news" class="section-y bg-white"><div class="container-x"><div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between"><div><div class=""><div class="reveal "><div class="flex items-center gap-3 "><span class="h-2 w-2 rotate-45" style="background:var(--brand)"></span><span class="text-sm font-bold tracking-[0.06em]" style="color:var(--brand)">最新動態</span></div></div><span aria-hidden="true" data-drift="true" data-split="true" class="font-display mt-2 block text-[clamp(2.6rem,6vw,4.6rem)] font-semibold uppercase leading-[0.95] tracking-tight" style="color:var(--brand)">News</span><h2 data-split="true" class="mt-5 max-w-2xl text-xl font-bold leading-snug sm:text-2xl" style="color:var(--ink)">頻道最新影音與社群動態</h2></div><div class="reveal "><p class="mt-4 max-w-xl text-sm leading-relaxed text-ink-soft sm:text-base">直接同步陳力新的 YouTube 與 Instagram，第一手掌握最新消息。</p></div></div><div class="reveal "><div class="flex shrink-0 flex-col items-start gap-3 sm:items-end"><a data-ga-event="cta_clicked" data-ga-location="news" data-ga-label="news_index" class="link-sweep inline-flex items-center gap-2 text-sm font-bold text-brand" href="/news">看所有動態<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="h-4 w-4"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a><a href="https://linktr.ee/LishinChen" target="_blank" rel="noopener noreferrer" class="link-sweep inline-flex items-center gap-2 text-sm font-medium text-ink-soft">所有社群連結<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="h-4 w-4"><path d="M7 17 17 7M8 7h9v9"></path></svg></a></div></div></div><div class="reveal "><p class="mt-4 text-xs text-ink-soft">✦ <!-- -->力新不收政治獻金；任何以陳力新名義對外募款，都是詐騙，請小心查證。</p></div><div class="mt-12 grid gap-7 md:grid-cols-3"><div class="reveal "><a class="group flex h-full flex-col rounded-[20px] border border-line bg-cream p-7 transition-all duration-300 hover:-translate-y-1.5 hover:border-brand/30 hover:shadow-xl" href="/news/volunteer-kickoff"><div class="flex items-center justify-between gap-3 text-xs font-bold tracking-wide text-brand"><span>基層行程</span><time dateTime="2026-07-03">2026.07.03</time></div><h3 class="mt-5 text-xl font-black leading-snug text-ink transition-colors group-hover:text-brand">志工隊起跑：素人選戰，從「分享」開始</h3><p class="mt-4 flex-1 text-sm leading-relaxed text-ink-soft">不收政治獻金的選戰要怎麼打？靠願意站出來的人。力新志工隊正式起跑，從線上分享、掃街到活動支援，做你做得到的就好。</p><span class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-brand">觀看<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="h-4 w-4 transition-transform group-hover:translate-x-1 group-hover:-translate-y-1"><path d="M7 17 17 7M8 7h9v9"></path></svg></span></a></div><div class="reveal "><a class="group flex h-full flex-col rounded-[20px] border border-line bg-cream p-7 transition-all duration-300 hover:-translate-y-1.5 hover:border-brand/30 hover:shadow-xl" href="/news/announcement"><div class="flex items-center justify-between gap-3 text-xs font-bold tracking-wide text-brand"><span>聲明</span><time dateTime="2026-06-01">2026.06.01</time></div><h3 class="mt-5 text-xl font-black leading-snug text-ink transition-colors group-hover:text-brand">「城市需要新力量」：陳力新宣布投入中正萬華市議員選舉</h3><p class="mt-4 flex-1 text-sm leading-relaxed text-ink-soft">萬華囝仔、海外創業家陳力新宣布以無黨籍身分投入 2026 台北市第五選舉區（中正・萬華）市議員選舉，公開承諾不收政治獻金。</p><span class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-brand">觀看<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="h-4 w-4 transition-transform group-hover:translate-x-1 group-hover:-translate-y-1"><path d="M7 17 17 7M8 7h9v9"></path></svg></span></a></div></div></div></section><section id="faq" class="section-y bg-cream"><div class="container-x"><div class=""><div class="reveal "><div class="flex items-center gap-3 "><span class="h-2 w-2 rotate-45" style="background:var(--brand)"></span><span class="text-sm font-bold tracking-[0.06em]" style="color:var(--brand)">常見問題</span></div></div><span aria-hidden="true" data-drift="true" data-split="true" class="font-display mt-2 block text-[clamp(2.6rem,6vw,4.6rem)] font-semibold uppercase leading-[0.95] tracking-tight" style="color:var(--brand)">FAQ</span><h2 data-split="true" class="mt-5 max-w-2xl text-xl font-bold leading-snug sm:text-2xl" style="color:var(--ink)">你可能想問的事，力新直接回答</h2></div><div class="mx-auto mt-12 max-w-3xl"><div class="reveal "><div class="border-b border-line"><button type="button" aria-expanded="false" aria-controls="_R_kt2njivb_" class="flex w-full items-center justify-between gap-4 py-5 text-left text-lg font-bold text-ink [overflow-wrap:anywhere]">陳力新是誰？<span aria-hidden="true" class="shrink-0 text-2xl leading-none text-brand transition-transform duration-300 ">+</span></button><div id="_R_kt2njivb_" role="region" inert="" class="grid" style="grid-template-rows:0fr;transition:grid-template-rows 0.45s cubic-bezier(0.16, 1, 0.3, 1)"><div class="overflow-hidden"><p class="whitespace-pre-line pb-5 text-[15px] leading-relaxed text-ink-soft [overflow-wrap:anywhere]" style="opacity:0;transition:opacity 0.35s ease 0s">陳力新是2026台北第五選區中正・萬華市議員候選人，以無黨籍身分參選。他在萬華成長，曾赴美國與日本求學、工作，並具有海外創業及國際企業經營經驗。</p></div></div></div></div><div class="reveal "><div class="border-b border-line"><button type="button" aria-expanded="false" aria-controls="_R_14t2njivb_" class="flex w-full items-center justify-between gap-4 py-5 text-left text-lg font-bold text-ink [overflow-wrap:anywhere]">陳力新的「城市需要新力量」主張是什麼？<span aria-hidden="true" class="shrink-0 text-2xl leading-none text-brand transition-transform duration-300 ">+</span></button><div id="_R_14t2njivb_" role="region" inert="" class="grid" style="grid-template-rows:0fr;transition:grid-template-rows 0.45s cubic-bezier(0.16, 1, 0.3, 1)"><div class="overflow-hidden"><p class="whitespace-pre-line pb-5 text-[15px] leading-relaxed text-ink-soft [overflow-wrap:anywhere]" style="opacity:0;transition:opacity 0.35s ease 0s">「城市需要新力量」代表陳力新希望把新的治理思維帶進中正萬華，包括科技治理、國際視野、青年發展、地方創生、宜居社區及透明政治，同時保留老城區的文化與人情味。</p></div></div></div></div><div class="reveal "><div class="border-b border-line"><button type="button" aria-expanded="false" aria-controls="_R_1kt2njivb_" class="flex w-full items-center justify-between gap-4 py-5 text-left text-lg font-bold text-ink [overflow-wrap:anywhere]">陳力新的主要政見有哪些？<span aria-hidden="true" class="shrink-0 text-2xl leading-none text-brand transition-transform duration-300 ">+</span></button><div id="_R_1kt2njivb_" role="region" inert="" class="grid" style="grid-template-rows:0fr;transition:grid-template-rows 0.45s cubic-bezier(0.16, 1, 0.3, 1)"><div class="overflow-hidden"><p class="whitespace-pre-line pb-5 text-[15px] leading-relaxed text-ink-soft [overflow-wrap:anywhere]" style="opacity:0;transition:opacity 0.35s ease 0s">陳力新目前提出六大方向，包括科技活化與地方創生、青年就業與新創扶植、國際視野與城市競爭力、廉能政治與透明問政、宜居社區與安全友善，以及觀光文化與在地經濟。</p></div></div></div></div><div class="reveal "><div class="border-b border-line"><button type="button" aria-expanded="false" aria-controls="_R_24t2njivb_" class="flex w-full items-center justify-between gap-4 py-5 text-left text-lg font-bold text-ink [overflow-wrap:anywhere]">2026台北第五選區候選人比較時可以看哪些條件？<span aria-hidden="true" class="shrink-0 text-2xl leading-none text-brand transition-transform duration-300 ">+</span></button><div id="_R_24t2njivb_" role="region" inert="" class="grid" style="grid-template-rows:0fr;transition:grid-template-rows 0.45s cubic-bezier(0.16, 1, 0.3, 1)"><div class="overflow-hidden"><p class="whitespace-pre-line pb-5 text-[15px] leading-relaxed text-ink-soft [overflow-wrap:anywhere]" style="opacity:0;transition:opacity 0.35s ease 0s">台北第五選區涵蓋中正區與萬華區。比較市議員候選人時，可以查看政見、地方連結、專業經驗、政黨或無黨籍背景，以及候選人的公共承諾與實際行動，再依自己最重視的議題做決定。</p></div></div></div></div><div class="reveal "><div class="border-b border-line"><button type="button" aria-expanded="false" aria-controls="_R_2kt2njivb_" class="flex w-full items-center justify-between gap-4 py-5 text-left text-lg font-bold text-ink [overflow-wrap:anywhere]">萬華市議員候選人陳力新有什麼特色？<span aria-hidden="true" class="shrink-0 text-2xl leading-none text-brand transition-transform duration-300 ">+</span></button><div id="_R_2kt2njivb_" role="region" inert="" class="grid" style="grid-template-rows:0fr;transition:grid-template-rows 0.45s cubic-bezier(0.16, 1, 0.3, 1)"><div class="overflow-hidden"><p class="whitespace-pre-line pb-5 text-[15px] leading-relaxed text-ink-soft [overflow-wrap:anywhere]" style="opacity:0;transition:opacity 0.35s ease 0s">陳力新的主要特色包括萬華在地成長背景、無黨籍身分、海外與國際企業經驗、科技治理取向，以及公開主張不收政治獻金。</p></div></div></div></div><div class="reveal "><div class="border-b border-line"><button type="button" aria-expanded="false" aria-controls="_R_34t2njivb_" class="flex w-full items-center justify-between gap-4 py-5 text-left text-lg font-bold text-ink [overflow-wrap:anywhere]">投給沒選過的素人，會不會浪費票？<span aria-hidden="true" class="shrink-0 text-2xl leading-none text-brand transition-transform duration-300 ">+</span></button><div id="_R_34t2njivb_" role="region" inert="" class="grid" style="grid-template-rows:0fr;transition:grid-template-rows 0.45s cubic-bezier(0.16, 1, 0.3, 1)"><div class="overflow-hidden"><p class="whitespace-pre-line pb-5 text-[15px] leading-relaxed text-ink-soft [overflow-wrap:anywhere]" style="opacity:0;transition:opacity 0.35s ease 0s">我把『新』當成優勢：沒有派系、沒有包袱，才能就事論事。我有國際企業經營與政大 EMBA 的治理歷練，政見具體、承諾透明可被檢驗。改變，需要有人先站出來。</p></div></div></div></div><div class="reveal "><div class="border-b border-line"><button type="button" aria-expanded="false" aria-controls="_R_3kt2njivb_" class="flex w-full items-center justify-between gap-4 py-5 text-left text-lg font-bold text-ink [overflow-wrap:anywhere]">無黨籍進議會，孤掌難鳴嗎？<span aria-hidden="true" class="shrink-0 text-2xl leading-none text-brand transition-transform duration-300 ">+</span></button><div id="_R_3kt2njivb_" role="region" inert="" class="grid" style="grid-template-rows:0fr;transition:grid-template-rows 0.45s cubic-bezier(0.16, 1, 0.3, 1)"><div class="overflow-hidden"><p class="whitespace-pre-line pb-5 text-[15px] leading-relaxed text-ink-soft [overflow-wrap:anywhere]" style="opacity:0;transition:opacity 0.35s ease 0s">正因為無黨無派，我才能跨陣營合作、對選民負責而不是對派系。議會裡需要願意就事論事、把萬華中正放第一的人。</p></div></div></div></div><div class="reveal "><div class="border-b border-line"><button type="button" aria-expanded="false" aria-controls="_R_44t2njivb_" class="flex w-full items-center justify-between gap-4 py-5 text-left text-lg font-bold text-ink [overflow-wrap:anywhere]">不收政治獻金，那競選經費哪裡來？<span aria-hidden="true" class="shrink-0 text-2xl leading-none text-brand transition-transform duration-300 ">+</span></button><div id="_R_44t2njivb_" role="region" inert="" class="grid" style="grid-template-rows:0fr;transition:grid-template-rows 0.45s cubic-bezier(0.16, 1, 0.3, 1)"><div class="overflow-hidden"><p class="whitespace-pre-line pb-5 text-[15px] leading-relaxed text-ink-soft [overflow-wrap:anywhere]" style="opacity:0;transition:opacity 0.35s ease 0s">我公開承諾不收政治獻金，用最精簡的方式選舉。也提醒大家：任何以我名義對外募款，都是詐騙，請小心。</p></div></div></div></div><div class="reveal "><div class="border-b border-line"><button type="button" aria-expanded="false" aria-controls="_R_4kt2njivb_" class="flex w-full items-center justify-between gap-4 py-5 text-left text-lg font-bold text-ink [overflow-wrap:anywhere]">第五選舉區包含哪些地方？<span aria-hidden="true" class="shrink-0 text-2xl leading-none text-brand transition-transform duration-300 ">+</span></button><div id="_R_4kt2njivb_" role="region" inert="" class="grid" style="grid-template-rows:0fr;transition:grid-template-rows 0.45s cubic-bezier(0.16, 1, 0.3, 1)"><div class="overflow-hidden"><p class="whitespace-pre-line pb-5 text-[15px] leading-relaxed text-ink-soft [overflow-wrap:anywhere]" style="opacity:0;transition:opacity 0.35s ease 0s">台北市第五選舉區包括中正區與萬華區。投票資格不只看設籍地：須具中華民國國籍、年滿 20 歲，並符合居住期間與選舉人名冊等規定。一般須繼續居住 4 個月以上；行政區內劃分選區時，以該行政區域計算，選舉公告後遷入選區另有限制。年齡及居住期間原則計算至投票日前一日。請依戶籍資料向戶政機關或選委會確認。</p></div></div></div></div><div class="reveal "><div class="border-b border-line"><button type="button" aria-expanded="false" aria-controls="_R_54t2njivb_" class="flex w-full items-center justify-between gap-4 py-5 text-left text-lg font-bold text-ink [overflow-wrap:anywhere]">我要怎麼幫忙？<span aria-hidden="true" class="shrink-0 text-2xl leading-none text-brand transition-transform duration-300 ">+</span></button><div id="_R_54t2njivb_" role="region" inert="" class="grid" style="grid-template-rows:0fr;transition:grid-template-rows 0.45s cubic-bezier(0.16, 1, 0.3, 1)"><div class="overflow-hidden"><p class="whitespace-pre-line pb-5 text-[15px] leading-relaxed text-ink-soft [overflow-wrap:anywhere]" style="opacity:0;transition:opacity 0.35s ease 0s">最簡單：在社群追蹤、把理念分享給中正萬華的朋友。再進一步：加入志工留下聯絡方式，投票日前一起出力。</p></div></div></div></div><div class="reveal "><div class="border-b border-line"><button type="button" aria-expanded="false" aria-controls="_R_5kt2njivb_" class="flex w-full items-center justify-between gap-4 py-5 text-left text-lg font-bold text-ink [overflow-wrap:anywhere]">『用 AI／科技活化萬華』是什麼意思？<span aria-hidden="true" class="shrink-0 text-2xl leading-none text-brand transition-transform duration-300 ">+</span></button><div id="_R_5kt2njivb_" role="region" inert="" class="grid" style="grid-template-rows:0fr;transition:grid-template-rows 0.45s cubic-bezier(0.16, 1, 0.3, 1)"><div class="overflow-hidden"><p class="whitespace-pre-line pb-5 text-[15px] leading-relaxed text-ink-soft [overflow-wrap:anywhere]" style="opacity:0;transition:opacity 0.35s ease 0s">把數位工具帶進地方治理與服務——從停車、長照到觀光導覽，讓老城區保有人情味，也能更聰明、更便利。這是我最想推動的方向。</p></div></div></div></div></div><div class="mx-auto max-w-3xl"><p class="mt-5 text-sm leading-relaxed text-ink-soft"><a href="https://law.cec.gov.tw/LawContent.aspx?id=GL000292" class="text-brand underline underline-offset-4" target="_blank" rel="noopener noreferrer">官方法源：公職人員選舉罷免法第 4、14–20 條</a><br/>查核日期<!-- -->：<time dateTime="2026-09-09">2026-09-09</time></p></div><script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"陳力新是誰？","acceptedAnswer":{"@type":"Answer","text":"陳力新是2026台北第五選區中正・萬華市議員候選人，以無黨籍身分參選。他在萬華成長，曾赴美國與日本求學、工作，並具有海外創業及國際企業經營經驗。"}},{"@type":"Question","name":"陳力新的「城市需要新力量」主張是什麼？","acceptedAnswer":{"@type":"Answer","text":"「城市需要新力量」代表陳力新希望把新的治理思維帶進中正萬華，包括科技治理、國際視野、青年發展、地方創生、宜居社區及透明政治，同時保留老城區的文化與人情味。"}},{"@type":"Question","name":"陳力新的主要政見有哪些？","acceptedAnswer":{"@type":"Answer","text":"陳力新目前提出六大方向，包括科技活化與地方創生、青年就業與新創扶植、國際視野與城市競爭力、廉能政治與透明問政、宜居社區與安全友善，以及觀光文化與在地經濟。"}},{"@type":"Question","name":"2026台北第五選區候選人比較時可以看哪些條件？","acceptedAnswer":{"@type":"Answer","text":"台北第五選區涵蓋中正區與萬華區。比較市議員候選人時，可以查看政見、地方連結、專業經驗、政黨或無黨籍背景，以及候選人的公共承諾與實際行動，再依自己最重視的議題做決定。"}},{"@type":"Question","name":"萬華市議員候選人陳力新有什麼特色？","acceptedAnswer":{"@type":"Answer","text":"陳力新的主要特色包括萬華在地成長背景、無黨籍身分、海外與國際企業經驗、科技治理取向，以及公開主張不收政治獻金。"}},{"@type":"Question","name":"投給沒選過的素人，會不會浪費票？","acceptedAnswer":{"@type":"Answer","text":"我把『新』當成優勢：沒有派系、沒有包袱，才能就事論事。我有國際企業經營與政大 EMBA 的治理歷練，政見具體、承諾透明可被檢驗。改變，需要有人先站出來。"}},{"@type":"Question","name":"無黨籍進議會，孤掌難鳴嗎？","acceptedAnswer":{"@type":"Answer","text":"正因為無黨無派，我才能跨陣營合作、對選民負責而不是對派系。議會裡需要願意就事論事、把萬華中正放第一的人。"}},{"@type":"Question","name":"不收政治獻金，那競選經費哪裡來？","acceptedAnswer":{"@type":"Answer","text":"我公開承諾不收政治獻金，用最精簡的方式選舉。也提醒大家：任何以我名義對外募款，都是詐騙，請小心。"}},{"@type":"Question","name":"第五選舉區包含哪些地方？","acceptedAnswer":{"@type":"Answer","text":"台北市第五選舉區包括中正區與萬華區。投票資格不只看設籍地：須具中華民國國籍、年滿 20 歲，並符合居住期間與選舉人名冊等規定。一般須繼續居住 4 個月以上；行政區內劃分選區時，以該行政區域計算，選舉公告後遷入選區另有限制。年齡及居住期間原則計算至投票日前一日。請依戶籍資料向戶政機關或選委會確認。"}},{"@type":"Question","name":"我要怎麼幫忙？","acceptedAnswer":{"@type":"Answer","text":"最簡單：在社群追蹤、把理念分享給中正萬華的朋友。再進一步：加入志工留下聯絡方式，投票日前一起出力。"}},{"@type":"Question","name":"『用 AI／科技活化萬華』是什麼意思？","acceptedAnswer":{"@type":"Answer","text":"把數位工具帶進地方治理與服務——從停車、長照到觀光導覽，讓老城區保有人情味，也能更聰明、更便利。這是我最想推動的方向。"}}]}</script></div></section><section aria-label="萬華華江河岸的黃昏" class="relative overflow-hidden bg-ink"><div aria-hidden="true" data-parallax="0.5" class="absolute -inset-y-[8%] inset-x-0"><img alt="" loading="lazy" decoding="async" data-nimg="fill" class="duotone object-cover" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;object-position:50% 50%;color:transparent" sizes="100vw" srcSet="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fh51j8cya%2Fproduction%2F5623ade4d91d321d779f897cf6b43b5bc8252202-2048x1152.webp&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fh51j8cya%2Fproduction%2F5623ade4d91d321d779f897cf6b43b5bc8252202-2048x1152.webp&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fh51j8cya%2Fproduction%2F5623ade4d91d321d779f897cf6b43b5bc8252202-2048x1152.webp&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fh51j8cya%2Fproduction%2F5623ade4d91d321d779f897cf6b43b5bc8252202-2048x1152.webp&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fh51j8cya%2Fproduction%2F5623ade4d91d321d779f897cf6b43b5bc8252202-2048x1152.webp&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fh51j8cya%2Fproduction%2F5623ade4d91d321d779f897cf6b43b5bc8252202-2048x1152.webp&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fh51j8cya%2Fproduction%2F5623ade4d91d321d779f897cf6b43b5bc8252202-2048x1152.webp&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fh51j8cya%2Fproduction%2F5623ade4d91d321d779f897cf6b43b5bc8252202-2048x1152.webp&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fh51j8cya%2Fproduction%2F5623ade4d91d321d779f897cf6b43b5bc8252202-2048x1152.webp&amp;w=3840&amp;q=75"/></div><div aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-ink/60 via-transparent to-ink/10"></div><div class="container-x relative flex h-[46vh] min-h-[340px] items-end justify-between pb-8 sm:h-[56vh] sm:pb-10"><span data-drift="true" class="font-display block max-w-[80%] text-[clamp(2.2rem,7vw,5rem)] font-semibold uppercase leading-none tracking-tight text-white/90">Walk the whole district</span><span aria-hidden="true" class="v-text hidden max-h-[60%] select-none self-start pt-2 text-xs font-bold text-white/85 sm:block">河岸・日常的傍晚</span></div></section><section id="footprint" class="section-y bg-white"><div class="container-x"><div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-end"><div class=""><div class="reveal "><div class="flex items-center gap-3 "><span class="h-2 w-2 rotate-45" style="background:var(--brand)"></span><span class="text-sm font-bold tracking-[0.06em]" style="color:var(--brand)">基層足跡</span></div></div><span aria-hidden="true" data-drift="true" data-split="true" class="font-display mt-2 block text-[clamp(2.6rem,6vw,4.6rem)] font-semibold uppercase leading-[0.95] tracking-tight" style="color:var(--brand)">Footprint</span><h2 data-split="true" class="mt-5 max-w-2xl text-xl font-bold leading-snug sm:text-2xl" style="color:var(--ink)">一里一里走，把整個選區放進行程</h2></div><div class="reveal "><p class="text-base leading-[1.9] text-ink-soft sm:text-lg">中正 31 里、萬華 36 里，一共 67 個里。力新承諾：在投票日前，走進每一個里，聽每一個里的事。每完成一個里，這裡就點亮一格——進度公開，接受檢驗。</p></div></div><div class="reveal "><div class="mt-14 rounded-[20px] border border-line bg-cream p-7 sm:p-9"><div class="mb-6 border-b border-line pb-5"><p class="text-sm font-bold text-brand">示範進度</p><p class="mt-1 text-sm leading-relaxed text-ink-soft">此區為示範資料，不代表實際走訪紀錄。</p></div><div class="flex flex-wrap items-end justify-between gap-4"><p class="font-display text-5xl font-semibold leading-none text-brand sm:text-6xl"><span data-count="47">47</span><span class="text-2xl text-ink-soft"> / <!-- -->67<!-- --> <!-- -->里</span><span class="ml-4 align-middle text-lg font-semibold">70.1<!-- -->%</span></p><div class="flex items-center gap-5 text-sm"><span class="inline-flex items-center gap-2 font-bold text-ink"><span class="h-3 w-3 rounded-full bg-brand"></span>示範完成</span><span class="inline-flex items-center gap-2 text-ink-soft"><span class="h-3 w-3 rounded-full border border-line bg-white"></span>示範待完成</span></div></div><progress value="47" max="67" aria-label="基層足跡進度 · 示範進度" aria-valuetext="47 / 67 (70.1%)" class="mt-6 block h-2.5 w-full appearance-none overflow-hidden rounded-full border-0 bg-white [&amp;::-moz-progress-bar]:rounded-full [&amp;::-moz-progress-bar]:bg-brand [&amp;::-webkit-progress-bar]:rounded-full [&amp;::-webkit-progress-bar]:bg-white [&amp;::-webkit-progress-value]:rounded-full [&amp;::-webkit-progress-value]:bg-brand">70.1<!-- -->%</progress></div></div><div class="mt-12 grid gap-10 lg:grid-cols-2 lg:gap-14"><div class="reveal "><div><p class="flex items-baseline gap-3"><span class="text-base font-bold text-ink">中正區</span><span class="font-display text-sm font-semibold tracking-[0.08em] text-ink-soft">22<!-- --> / <!-- -->31</span></p><ul class="mt-4 flex flex-wrap gap-2"><li class="rounded-full border px-3 py-1.5 text-[13px] font-medium transition-colors border-line bg-white text-ink-soft">黎明里</li><li class="rounded-full border px-3 py-1.5 text-[13px] font-medium transition-colors border-brand bg-brand text-white">光復里</li><li class="rounded-full border px-3 py-1.5 text-[13px] font-medium transition-colors border-brand bg-brand text-white">建國里</li><li class="rounded-full border px-3 py-1.5 text-[13px] font-medium transition-colors border-brand bg-brand text-white">東門里</li><li class="rounded-full border px-3 py-1.5 text-[13px] font-medium transition-colors border-brand bg-brand text-white">三愛里</li><li class="rounded-full border px-3 py-1.5 text-[13px] font-medium transition-colors border-brand bg-brand text-white">梅花里</li><li class="rounded-full border px-3 py-1.5 text-[13px] font-medium transition-colors border-brand bg-brand text-white">幸市里</li><li class="rounded-full border px-3 py-1.5 text-[13px] font-medium transition-colors border-line bg-white text-ink-soft">文北里</li><li class="rounded-full border px-3 py-1.5 text-[13px] font-medium transition-colors border-brand bg-brand text-white">文祥里</li><li class="rounded-full border px-3 py-1.5 text-[13px] font-medium transition-colors border-brand bg-brand text-white">幸福里</li><li class="rounded-full border px-3 py-1.5 text-[13px] font-medium transition-colors border-line bg-white text-ink-soft">南門里</li><li class="rounded-full border px-3 py-1.5 text-[13px] font-medium transition-colors border-brand bg-brand text-white">新營里</li><li class="rounded-full border px-3 py-1.5 text-[13px] font-medium transition-colors border-brand bg-brand text-white">龍福里</li><li class="rounded-full border px-3 py-1.5 text-[13px] font-medium transition-colors border-brand bg-brand text-white">南福里</li><li class="rounded-full border px-3 py-1.5 text-[13px] font-medium transition-colors border-line bg-white text-ink-soft">愛國里</li><li class="rounded-full border px-3 py-1.5 text-[13px] font-medium transition-colors border-brand bg-brand text-white">廈安里</li><li class="rounded-full border px-3 py-1.5 text-[13px] font-medium transition-colors border-brand bg-brand text-white">忠勤里</li><li class="rounded-full border px-3 py-1.5 text-[13px] font-medium transition-colors border-brand bg-brand text-white">永功里</li><li class="rounded-full 