/* 確保 WordPress 文章的精選圖片顯示為 2267x1275px 並保持響應式設計 */
.rt-img-responsive {
    width: 100%; /* 讓容器佔滿可用寬度 */
    max-width: 2267px; /* 限制最大寬度為 2267px */
    aspect-ratio: 2267 / 1275; /* 設定長寬比為 2267:1275 */
    overflow: hidden; /* 避免溢出變形 */
    display: flex;
    justify-content: center;
    align-items: center;
}

.rt-img-responsive img {
    width: 100%; /* 讓圖片填滿容器寬度 */
    height: 100%; /* 讓圖片填滿容器高度 */
    object-fit: cover; /* 確保圖片填滿區域，不變形但可能裁切 */
    object-position: center; /* 讓圖片內容保持置中 */
}

.wp-post-image {
    width: 100%; /* 讓容器佔滿可用寬度 */
    max-width: 2267px; /* 限制最大寬度為 2267px */
    aspect-ratio: 2267 / 1275; /* 設定長寬比為 2267:1275 */
    overflow: hidden; /* 避免溢出變形 */
    display: flex;
    justify-content: center;
    align-items: center;
}

.wp-post-image img {
    width: 100%; /* 讓圖片填滿容器寬度 */
    height: 100%; /* 讓圖片填滿容器高度 */
    object-fit: cover; /* 確保圖片填滿區域，不變形但可能裁切 */
    object-position: center; /* 讓圖片內容保持置中 */
}


/* 讓所有標題的錨點在滾動時，自動預留 150px 空間 */
[id] {
    scroll-margin-top: 150px; /* 讓標題停留時往下偏移 150px */
}

