rg\",\"@type\":\"NewsArticle\",\"author\":{\"@type\":\"Person\",\"jobTitle\":\"\",\"name\":\"編輯中心\",\"url\":\"\"},\"creator\":{\"@type\":\"Person\",\"jobTitle\":\"\",\"name\":\"編輯中心\",\"url\":\"\"},\"dateModified\":\"2026-02-11T17:13:24Z\",\"datePublished\":\"2026-02-11T17:13:24Z\",\"description\":\"圖：國民黨新北永和區議員參選爆炸，初選形成4搶1的空前激烈局面。(圖/蘇昭龍辦公室提供) 【記者張嘉誠／綜合報 […]\",\"headline\":\"永和藍營世代交替開打   蘇昭龍參選盼成「技術型問政力量」\",\"image\":{\"@type\":\"ImageObject\",\"height\":707,\"url\":\"https://s.yimg.com/lo/mysterio/api/9dbdacdb47bed69e1e8f11a74d083be34d4d8c8c1160a6a8539033d49e1edde6/lightyear_networkapi/resizefill_w1200%3Bquality_80%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fmypeople.tw%2F97d9291184d6bfbe3956e4bf57fb6186\",\"width\":1200},\"keywords\":[\"蘇昭龍\",\"新北市\",\"國民黨\"],\"mainEntityOfPage\":\"https://tw.news.yahoo.com/%E6%B0%B8%E5%92%8C%E8%97%8D%E7%87%9F%E4%B8%96%E4%BB%A3%E4%BA%A4%E6%9B%BF%E9%96%8B%E6%89%93-%E8%98%87%E6%98%AD%E9%BE%8D%E5%8F%83%E9%81%B8%E7%9B%BC%E6%88%90-%E6%8A%80%E8%A1%93%E5%9E%8B%E5%95%8F%E6%94%BF%E5%8A%9B%E9%87%8F-171324538.html\",\"provider\":{\"@type\":\"Organization\",\"logo\":{\"@type\":\"ImageObject\",\"height\":76,\"url\":\"https://s.yimg.com/os/creatr-uploaded-images/2021-11/95919ad0-453a-11ec-af35-9c5ae551d1ff\",\"width\":200},\"name\":\"民眾日報\",\"url\":\"https://www.mypeoplevol.com/\"},\"publisher\":{\"@type\":\"Organization\",\"alternateName\":\"Yahoo奇摩新聞\",\"logo\":{\"@type\":\"ImageObject\",\"height\":65,\"url\":\"https://s.yimg.com/cv/apiv2/twnews/logo2024/PC/Yahoo_News@2x.png\",\"width\":310},\"name\":\"Yahoo新聞\"},\"thumbnailUrl\":\"https://s.yimg.com/lo/mysterio/api/9dbdacdb47bed69e1e8f11a74d083be34d4d8c8c1160a6a8539033d49e1edde6/lightyear_networkapi/resizefill_w1200%3Bquality_80%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fmypeople.tw%2F97d9291184d6bfbe3956e4bf57fb6186\"}}},\"fetchedArticleIds\":[[\"41245778-1b29-368e-b721-0ea52518308d\"],[\"40595937-72c5-3eab-a66a-5f9a6d89efa8\",\"394644a0-fe20-38ff-9030-ac1500878617\",\"a49939d