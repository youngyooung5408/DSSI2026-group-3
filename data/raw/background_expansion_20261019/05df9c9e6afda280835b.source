:\"/22888152279/${intl}/${property}/${rosOrMain}/dt/${intl}_${property}_${rosOrMain}_dt_mid_right\",\"region\":\"index\",\"size\":[[300,600],[300,250]]},\"sda-top-right-iframe\":{\"id\":\"sda-top-right-iframe\",\"kvs\":{\"loc\":\"top_right\"},\"path\":\"/22888152279/${intl}/${property}/${rosOrMain}/dt/${intl}_${property}_${rosOrMain}_dt_top_right\",\"region\":\"index\",\"size\":[[300,600],[300,250]]}},\"smartphone\":{\"sda-moments-iframe\":{\"customSizeConfig\":{\"Lighthouse\":true,\"Spotlight\":true},\"id\":\"sda-moments-iframe\",\"kvs\":{\"loc\":\"mid_center\"},\"path\":\"/22888152279/${intl}/${property}/${rosOrMain}/mw/${intl}_${property}_${rosOrMain}_mw_mid_center\",\"region\":\"index\",\"size\":[[300,250],[2,2],[3,2]]},\"sda-top-center-iframe\":{\"customSizeConfig\":{\"Horizon\":true},\"id\":\"sda-top-center-iframe\",\"kvs\":{\"loc\":\"top_center\"},\"path\":\"/22888152279/${intl}/${property}/${rosOrMain}/mw/${intl}_${property}_${rosOrMain}_mw_top_center\",\"region\":\"index\",\"size\":[[320,50],[320,100],[3,1]]}}},\"taboolaPositionsByDevice\":{\"appAndroid\":{\"pencil-read-more\":{\"mode\":\"pencil-twhk-article-super-app-android-b\",\"placement\":\"taboola-pencil-articleb\",\"region\":\"index\",\"targetType\":\"mix\"},\"stream-preference-stream\":{\"mode\":\"stream-twhk-article-super-app-android-d\",\"placement\":\"taboola-stream-articled\",\"region\":\"index\",\"targetType\":\"mix\"},\"stream-recommended-articles\":{\"mode\":\"stream-twhk-article-super-app-android-c\",\"placement\":\"taboola-stream-articlec\",\"region\":\"index\",\"targetType\":\"mix\"}},\"appIos\":{\"pencil-read-more\":{\"mode\":\"pencil-twhk-article-super-app-ios-b\",\"placement\":\"taboola-pencil-articleb\",\"region\":\"index\",\"targetType\":\"mix\"},\"stream-preference-stream\":{\"mode\":\"stream-twhk-article-super-app-ios-d\",\"placement\":\"taboola-stream-articled\",\"region\":\"index\",\"targetType\":\"mix\"},\"stream-recommended-articles\":{\"mode\":\"stream-twhk-article-super-app-ios-c\",\"placement\":\"taboola-stream-articlec\",\"region\":\"index\",\"targetType\":\"mix\"}},\"appNames\":[\"super\",\"superhk\",\"ytwstock\",\"twnews\",\"hknews\"],\"desktop\":{\"pencil-read-more\":{\"mode\":\"pencil-twhk-article-revamp-a-v2\",\"placement\":\"taboola-pencil-articlea-v2\",\"region\":\"index\",\"targetType\":\"mix\"},\"stream-preference-stream\":{\"mode\":\"stream-twhk-article-revamp-b\",\"placement\":\"taboola-stream-articleb\",\"region\":\"index\",\"targetType\":\"mix\"},\"stream-preference-stream-large\":{\"mode\":\"stream-twhk-article-revamp-e\",\"placement\":\"taboola-stream-articlee\",\"region\":\"index\",\"targetType\":\"mix\"},\"stream-recommended-articles\":{\"mode\":\"stream-twhk-article-revamp-a\",\"placement\":\"taboola-stream-articlea\",\"region\":\"index\",\"targetType\":\"mix\"}},\"smartphone\":{\"pencil-read-more\":{\"mode\":\"pencil-twhk-article-revamp-b\",\"placement\":\"taboola-pencil-articleb\",\"region\":\"index\",\"targetType\":\"mix\"},\"stream-preference-stream\":{\"mode\":\"stream-twhk-article-revamp-d\",\"placement\":\"taboola-stream-articled\",\"region\":\"index\",\"targetType\":\"mix\"},\"stream-recommended-articles\":{\"mode\":\"stream-twhk-article-revamp-c\",\"placement\":\"taboola-stream-articlec\",\"region\":\"index\",\"targetType\":\"mix\"}}}},\"pageName\":\"articlePage\",\"pageState\":{\"article\":{\"data\":{\"bodyBlocks\":[{\"attrs\":\"$undefined\",\"hydratedAsset\":\"$undefined\",\"id\":null,\"items\":null,\"nodeId\":\"1\",\"parentNodeId\":null,\"subtype\":null,\"text\":null,\"type\":\"providerImage\",\"uuid\":\"7d85c259-0aba-38f3-aa82-cad94f5c7b8c\",\"transformed\":{\"alt\":\"01%E8%98%87%E6%98%AD%E9%BE%8D%E5%8F%83%E9%81%B8%E7%9B%BC%E6%88%90%E3%80%8C%E6%8A%80%E8%A1%93%E5%9E%8B%E5%95%8F%E6%94%BF%E5%8A%9B%E9%87%8F%E3%80%8D 1\",\"caption\":\"圖：國民黨新北永和區議員參選爆炸，初選形成4搶1的空前激烈局面。(圖/蘇昭龍辦公室提供)\",\"credit\":\"\",\"href\":\"\",\"size\":{\"original\":{\"height\":589,\"url\":\"https://media.zenfs.com/en/mypeople.tw/97d9291184d6bfbe3956e4bf57fb6186\",\"width\":1000},\"resized\":{\"height\":565,\"url\":\"https://s.yimg.com/lo/mysterio/api/1383a10b0c287ff461888b1deec29f5c00dea1d59860c296e0d99e710fb2e6e8/lightyear_networkapi/resizefill_w960%3Bquality_80%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fmypeople.tw%2F97d9291184d6bfbe3956e4bf57fb6186\",\"width\":960}}}},{\"attrs\":{\"textAlign\":\"left\",\"characterCount\":12},\"hydratedAsset\":null,\"id\":null,\"items\":null,\"nodeId\":\"2\",\"parentNodeId\":null,\"subtype\":null,\"text\":null,\"type\":\"paragraph\",\"uuid\":null,\"content\":[{\"attrs\":{},\"hydratedAsset\":null,\"id\":null,\"items\":null,\"nodeId\":\"3\",\"parentNodeId\":\"2\",\"subtype\":null,\"text\":\"【記者張嘉誠／綜合報導】\",\"type\":\"text\",\"uuid\":null}]},{\"attrs\":{\"textAlign\":\"left\",\"characterCount\":96},\"hydratedAsset\":null,\"id\":null,\"items\":null,\"nodeId\":\"4\",\"parentNodeId\":null,\"subtype\":null,\"text\":null,\"type\":\"paragraph\",\"uuid\":null,\"content\":[{\"attrs\":{},\"hydratedAsset\":null,\"id\":null,\"items\":null,\"nodeId\":\"5\",\"parentNodeId\":\"4\",\"subtype\":null,\"text\":\"2026年九合一大選提前開打，被視為國民黨「鐵票倉」的新北市永和區，因五連霸資深議員連斐璠宣布不再連任，且未指定接棒人選，正式宣告世代交替啟動。藍營優勢選區出現空缺，也讓黨內各路人馬積極卡位。\",\"type\":\"text\",\"uuid\":null}]},{\"attrs\":{\"textAlign\":\"left\",\"characterCount\":121},\"hydratedAsset\":null,\"id\":null,\"items\":null,\"nodeId\":\"6\",\"parentNodeId\":null,\"subtype\":null,\"text\":null,\"type\":\"paragraph\",\"uuid\":null,\"content\":[{\"attrs\":{},\"hydratedAsset\":null,\"id\":null,\"items\":null,\"nodeId\":\"7\",\"parentNodeId\":\"6\",\"subtype\":null,\"text\":\"據了解，目前已表態投入國民黨永和區議員初選者，包括民治里里長陳以樂、國民黨前主席洪秀柱的秘書李珮媜；而建築師\",\"type\":\"text\",\"uuid\":null},{\"marks\":[{\"attrs\":{\"dataYlk\":{\"elm\":\"context_link\",\"itc\":0,\"sec\":\"content-canvas\",\"subsec\":\"anchor_text\"},\"href\":\"https://tw.news.yahoo.com/tag/蘇昭龍\",\"rel\":\" \"},\"type\":\"link\"}],\"text\":\"蘇昭龍\",\"type\":\"text\"},{\"attrs\":\"$5:props:pageData:pageState:article:data:bodyBlocks:3:content:0:attrs\",\"hydratedAsset\":null,\"id\":null,\"items\":null,\"nodeId\":\"7\",\"parentNodeId\":\"6\",\"subtype\":null,\"text\":\"近日也陸續掛出競選看板與公車廣告。地方更盛傳，具「侯友宜子弟兵」之稱的陳柏翰，可能自淡水跨區出征，形成罕見的「4搶1」激烈局面。\",\"type\":\"text\",\"uuid\":null}]},{\"attrs\":{\"textAlign\":\"left\",\"characterCount\":131},\"hydratedAsset\":null,\"id\":null,\"items\":null,\"nodeId\":\"8\",\"parentNodeId\":null,\"subtype\":null,\"text\":null,\"type\":\"paragraph\",\"uuid\":null,\"content\":[{\"attrs\":{},\"hydratedAsset\":null,\"id\":null,\"items\":null,\"nodeId\":\"9\",\"parentNodeId\":\"8\",\"subtype\":null,\"text\":\"永和區議員自2018年席次由4席調整為3席後，長期維持「2 藍 1 綠」的穩定結構。國民黨方面，向來由地方實力雄厚的連斐璠與新北市副議長陳鴻源連任；民進黨則由羅文崇與許昭興輪流競逐。然而，隨著連斐璠退出政壇，藍營原有版圖出現鬆動，也讓新人參選出現「爆炸式成長」。\",\"type\":\"text\",\"uuid\":null}]},{\"attrs\":{\"textAlign\":\"left\",\"characterCount\":73},\"hydratedAsset\":null,\"id\":null,\"items\":null,\"nodeId\":\"10\",\"parentNodeId\":null,\"subtype\":null,\"text\":null,\"type\":\"paragraph\",\"uuid\":null,\"content\":[{\"attrs\":{},\"hydratedAsset\":null,\"id\":null,\"items\":null,\"nodeId\":\"11\",\"parentNodeId\":\"10\",\"subtype\":null,\"text\":\"目前浮上檯面的4名青壯派參選人中，除建築師蘇昭龍為政治素人外，其餘3 人皆具政治人物幕僚或基層民代背景，對照之下，蘇昭龍的專業與出身顯得格外不同。\",\"type\":\"text\",\"uuid\":null}]},{\"attrs\":\"$undefined\",\"hydratedAsset\":\"$undefined\",\"id\":null,\"items\":null,\"nodeId\":\"12\",\"parentNodeId\":null,\"subtype\":null,\"text\":null,\"type\":\"providerImage\",\"uuid\":\"f27bd87d-d430-334e-ac43-c40c83648816\",\"transformed\":{\"alt\":\"02%E8%98%87%E6%98%AD%E9%BE%8D%E5%8F%83%E9%81%B8%E7%9B%BC%E6%88%90%E3%80%8C%E6%8A%80%E8%A1%93%E5%9E%8B%E5%95%8F%E6%94%BF%E5%8A%9B%E9%87%8F%E3%80%8D\",\"caption\":\"圖：蘇昭龍獲新北市建築師公會支持，公會理事長汪俊男表示，未來將聯合六師公會聯合推薦。(圖/蘇昭龍辦公室提供)\",\"credit\":\"\",\"href\":\"\",\"size\":{\"original\":{\"height\":666,\"url\":\"https://media.zenfs.com/en/mypeople.tw/78c28b79b8a822061e4e30c395075c93\",\"width\":1000},\"resized\":{\"height\":639,\"url\":\"https://s.yimg.com/lo/mysterio/api/ead428996930058bfd0133384895db066ce7b37d4b73707b0e2489edce219392/lightyear_networkapi/resizefill_w960%3Bquality_80%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fmypeople.tw%2F78c28b79b8a822061e4e30c395075c93\",\"width\":960}}}},{\"attrs\":{\"textAlign\":\"left\",\"characterCount\":25},\"hydratedAsset\":null,\"id\":null,\"items\":null,\"nodeId\":\"13\",\"parentNodeId\":null,\"subtype\":null,\"text\":null,\"type\":\"paragraph\",\"uuid\":null,\"content\":[{\"attrs\":{\"marks\":[{\"type\":\"bold\"}]},\"hydratedAsset\":null,\"id\":null,\"items\":null,\"nodeId\":\"14\",\"parentNodeId\":\"13\",\"subtype\":null,\"text\":\"北漂永和25年  建築師參選盼成「技術型問政力量」\",\"type\":\"text\",\"uuid\":null}]},{\"attrs\":{\"textAlign\":\"left\",\"characterCount\":133},\"hydratedAsset\":null,\"id\":null,\"items\":null,\"nodeId\":\"15\",\"parentNodeId\":null,\"subtype\":null,\"text\":null,\"type\":\"paragraph\",\"uuid\":null,\"content\":[{\"attrs\":{},\"hydratedAsset\":null,\"id\":null,\"items\":null,\"nodeId\":\"16\",\"parentNodeId\":\"15\",\"subtype\":null,\"text\":\"來自高雄興達港漁村、北漂永和超過 25 年的蘇昭龍，畢業於北科大建築系，並取得工業設計研究所碩士，目前為台大土木營建管理組博士候選人。曾先後任職於台北市建管處與新北市政府工務局，離開公職後轉戰連鎖品牌工程開發部門，累積超過 20 年實務經驗，現為建築師事務所負責人。\",\"type\":\"text\",\"uuid\":null}]},{\"attrs\":{\"textAlign\":\"left\",\"characterCount\":96},\"hydratedAsset\":null,\"id\":null,\"items\":null,\"nodeId\":\"17\",\"parentNodeId\":null,\"subtype\":null,\"text\":null,\"type\":\"paragraph\",\"uuid\":null,\"content\":[{\"attrs\":{},\"hydratedAsset\":null,\"id\":null,\"items\":null,\"nodeId\":\"18\",\"parentNodeId\":\"17\",\"subtype\":null,\"text\":\"熟悉品牌營運節奏、理解公部門流程，也能與第一線施工人員溝通的蘇昭龍幽默表示：「選上就是踏入政壇，沒選上就退出政壇。」他強調，自己並非政治投機，而是希望以專業背景，為永和補上「技術型問政力量」。\",\"type\":\"text\",\"uuid\":null}]},{\"attrs\":{\"textAlign\":\"left\",\"characterCount\":142},\"hydratedAsset\":null,\"id\":null,\"items\":null,\"nodeId\":\"19\",\"parentNodeId\":null,\"subtype\":null,\"text\":null,\"type\":\"paragraph\",\"uuid\":null,\"content\":[{\"attrs\":{},\"hydratedAsset\":null,\"id\":null,\"items\":null,\"nodeId\":\"20\",\"parentNodeId\":\"19\",\"subtype\":null,\"text\":\"談及投入選戰的動機，蘇昭龍坦言，這個念頭早在 25 歲時便已埋下。當年父親病危，卻因醫院以「呼吸器不足」為由被迫出院，對年輕的他造成巨大衝擊，也讓他深刻體會「沒有權力與資源，就可能被犧牲」。自此立下心願：「只要未來有能力，就要走公義的路，為弱勢發聲。」他認為，如今正是水到渠成的時刻。\",\"type\":\"text\",\"uuid\":null}]},{\"attrs\":\"$undefined\",\"hydratedAsset\":\"$undefined\",\"id\":null,\"items\":null,\"nodeId\":\"21\",\"parentNodeId\":null,\"subtype\":null,\"text\":null,\"type\":\"providerImage\",\"uuid\":\"0f02589d-b491-39ca-949f-739fa2215a2f\",\"transformed\":{\"alt\":\"03%E8%98%87%E6%98%AD%E9%BE%8D%E5%8F%83%E9%81%B8%E7%9B%BC%E6%88%90%E3%80%8C%E6%8A%80%E8%A1%93%E5%9E%8B%E5%95%8F%E6%94%BF%E5%8A%9B%E9%87%8F%E3%80%8D\",\"caption\":\"圖：蘇昭龍認為不能只靠口號或經驗政治，永和需要懂技術、懂制度、也懂民眾生活的民意代表。(圖/蘇昭龍辦公室提供)\",\"credit\":\"\",\"href\":\"\",\"size\":{\"original\":{\"height\":1115,\"url\":\"https://media.zenfs.com/en/mypeople.tw/a870455653c9a53ee0d07cdd54ed286f\",\"width\":1000},\"resized\":{\"height\":1070,\"url\":\"https://s.yimg.com/lo/mysterio/api/f12ccc4aa091a80208b45bdd6e354bbfe6bf0c40f4f37b60bffb29beeeea8ecc/lightyear_networkapi/resizefill_w960%3Bquality_80%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fmypeople.tw%2Fa870455653c9a53ee0d07cdd54ed286f\",\"width\":960}}}},{\"attrs\":{\"textAlign\":\"left\",\"characterCount\":24},\"hydratedAsset\":null,\"id\":null,\"items\":null,\"nodeId\":\"22\",\"parentNodeId\":null,\"subtype\":null,\"text\":null,\"type\":\"paragraph\",\"uuid\":null,\"content\":[{\"attrs\":{\"marks\":[{\"type\":\"bold\"}]},\"hydratedAsset\":null,\"id\":null,\"items\":null,\"nodeId\":\"23\",\"parentNodeId\":\"22\",\"subtype\":null,\"text\":\"永和危老都更牛步  建築師蘇昭龍參選:讓專業的來\",\"type\":\"text\",\"uuid\":null}]},{\"attrs\":{\"textAlign\":\"left\",\"characterCount\":144},\"hydratedAsset\":null,\"id\":null,\"items\":null,\"nodeId\":\"24\",\"parentNodeId\":null,\"subtype\":null,\"text\":null,\"type\":\"paragraph\",\"uuid\":null,\"content\":[{\"attrs\":{},\"hydratedAsset\":null,\"id\":null,\"items\":null,\"nodeId\":\"25\",\"parentNodeId\":\"24\",\"subtype\":null,\"text\":\"面對永和現況，全區老舊建築已超過 15 萬棟，其中約 14 萬棟屋齡超過 40 年，近年台灣大型地震頻傳，危老改建與都市更新迫在眉睫。蘇昭龍說自己在永和從租房子到落地生根，25年來看到都更的需要但牛步（尤其當年住在大陳新村附近看到混亂和破舊），直言關鍵問題在於「民眾與建商之間缺乏信任」。\",\"type\":\"text\",\"uuid\":null}]},{\"attrs\":{\"textAlign\":\"left\",\"characterCount\":84},\"hydratedAsset\":null,\"id\":null,\"items\":null,\"nodeId\":\"26\",\"parentNodeId\":null,\"subtype\":null,\"text\":null,\"type\":\"paragraph\",\"uuid\":null,\"content\":[{\"attrs\":{},\"hydratedAsset\":null,\"id\":null,\"items\":null,\"nodeId\":\"27\",\"parentNodeId\":\"26\",\"subtype\":null,\"text\":\"蘇昭龍表示，近年新北市推展大陳新村都更為永和注入新生命，未來進入議會，要用本身專業集結技術公會的資源跟市府合作，加強力道，讓永和推動防災、危老、TOD都更加速煥然一新。\",\"type\":\"text\",\"uuid\":null}]},{\"attrs\":{\"textAlign\":\"left\",\"characterCount\":170},\"hydratedAsset\":null,\"id\":null,\"items\":null,\"nodeId\":\"28\",\"parentNodeId\":null,\"subtype\":null,\"text\":null,\"type\":\"paragraph\",\"uuid\":null,\"content\":[{\"attrs\":{},\"hydratedAsset\":null,\"id\":null,\"items\":null,\"nodeId\":\"29\",\"parentNodeId\":\"28\",\"subtype\":null,\"text\":\"據了解，蘇昭龍目前已獲得新北市建築師公會支持，理事長汪俊男也表示，未來將促成六師公會聯合推薦。對此，蘇昭龍強調：「我在永和生活了25年，這裡不是過渡站，而是我選擇深耕的家。」他認為，永和不能只靠口號或經驗政治，更需要懂技術、懂制度，也懂民眾生活的民意代表，期盼透過國民黨的平台，以專業、理性與行動，為永和打造更安全、更宜居、更有未來的城市。\",\"type\":\"text\",\"uuid\":null}]}],\"contentMeta\":{\"adMeta\":{\"hashtag\":\"\",\"rs\":\"lmsid:a0V0W00000HOpPlUAL;revsp:mypeople.tw;lpstaid:41245778-1b29-368e-b721-0ea52518308d;pct:story\",\"site\":\"news\"},\"alias\":\"ymedia-alias:shadow=永和藍營世代交替開打-蘇昭龍參選盼成-技術型問政力量-171324538\",\"attribution\":{\"authors\":[{\"alias\":\"\",\"id\":\"\",\"logo\":\"$undefined\",\"name\":\"編輯中心\",\"title\":\"\"}],\"provider\":{\"darkLogo\":\"$undefined\",\"logo\":{\"size\":{\"original\":{\"height\":76,\"url\":\"https://s.yimg.com/os/creatr-uploaded-images/2021-11/95919ad0-453a-11ec-af35-9c5ae551d1ff\",\"width\":200},\"resized\":{\"height\":48,\"url\":\"https://s.yimg.com/lo/mysterio/api/387938bb071bf4c0f2f63613791c4c766865d0eb85cc506203aa79a89ac14328/lightyear_networkapi/resizefill_h