/tw.news.yahoo.com/%E4%B8%81%E5%B0%8F%E8%8A%B9%E5%81%87%E9%87%8B4%E5%B9%B4%E7%BD%95%E8%A6%8B%E9%9C%B2%E9%9D%A2-%E7%9C%9F%E5%AF%A6%E6%AD%A3%E8%87%89%E6%A8%A1%E6%A8%A3-%E6%B4%A947%E6%AD%B2%E7%8F%BE%E6%B3%81-051956565.html\"},\"color\":\"$undefined\",\"contentType\":\"Story\",\"duration\":\"$undefined\",\"id\":\"e58dd54e-4698-36db-8bc1-e9c7af9f3265\",\"isHosted\":true,\"label\":\"$undefined\",\"liveVideo\":\"$undefined\",\"mabLogString\":\"$undefined\",\"originalTitle\":\"丁小芹假釋4年罕見露面 「真實正臉模樣」洩47歲現況\",\"photoVariants\":\"$undefined\",\"provider\":{\"displayName\":\"中時新聞網\",\"id\":\"$undefined\",\"logo\":{\"resolutions\":[]},\"sourceId\":\"$undefined\",\"url\":\"$undefined\"},\"providerContentUrl\":\"$undefined\",\"pubDate\":\"2026-10-19T05:19:56Z\",\"summary\":\"女星丁小芹早期以歌手身分出道，後演出《白色戀曲》、《愛情白皮書》、《蒲公英》等影視作品，不過，10多年前逐漸將事業重心轉往網購，卻爆出仿冒品爭議，最終遭判刑2年6個月，並於民國111年（西元2022年）假釋出獄。她今年上半年被發現疑似重操舊業，沒想到近日罕見曬出正面照，曝光現年47歲的真實狀態。\",\"tags\":[],\"thumbnail\":{\"crop\":\"$undefined\",\"originalHeight\":\"$undefined\",\"originalUrl\":\"https://media.zenfs.com/zh-tw/chinatimes.com.tw/81e03e26bd74ca6a04be4c6697e33fa2.jpg\",\"originalWidth\":\"$undefined\",\"resolutions\":[{\"height\":280,\"tag\":\"498x280\",\"transformLabel\":\"498x280\",\"url\":\"https://s.yimg.com/lo/mysterio/api/8C3E5F95FB5FFDE4B251EF299DE3B9FD792C0BD482A762F8B74DCDDB77FC3B11/subgraphmysterio/smartcrop_w498_h280_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fzh-tw%2Fchinatimes.com.tw%2F81e03e26bd74ca6a04be4c6697e33fa2.jpg\",\"width\":498},{\"height\":184,\"tag\":\"184x184\",\"transformLabel\":\"184x184\",\"url\":\"https://s.yimg.com/lo/mysterio/api/0F5B5F7D7E66289BDEDDCAD6463CE9BB1ABBAE07BC4BA9F33C7DF4C691310558/subgraphmysterio/smartcrop_w184_h184_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fzh-tw%2Fchinatimes.com.tw%2F81e03e26bd74ca6a04be4c6697e33fa2.jpg\",\"width\":184}]},\"title\":\"丁小芹假釋4年罕見露面 「真實正臉模樣」洩47歲現況\"},\"contentType\":\"Story\",\"id\":\"e58dd54e-4698-36db-8bc1-e9c7af9f3265\"},{\"content\