<script type="text/javascript">
    
    $(document).ready(function (){
        GetNews004();
        GetNews114();
    });
    
    function GetNews004() {
        // JSON 資料的來源 URL
        var dataUrl = `${CCMS_SiteAPI}News/4?handler=News&Content=戴光宗&CreateDepartmentS_N=-1&PageSize=8&PageNumber=1`;

        // 發送 AJAX 請求以獲取 JSON 資料
        $.ajax({
            url: dataUrl,
            type: "GET",
            dataType: "json",
            success: function (response) {
                // 確保資料存在並正確
                if (response && response.Data) {
                    var htmlContent = "";
                    // 遍歷 JSON 資料並生成 HTML
                    htmlContent +=`<ul class="list">`;
                    response.Data.forEach(function (item) {
                        htmlContent += `<li><a class="div" href="${item["Path"]}" target="${item["A_TargetAttr"].target}"><i class="y-m">${item["上版日期"]}</i> ${item["主題"]}</a></li>`;
                    });
                    htmlContent +=`</ul>`;

                    // 將生成的 HTML 插入到 id="New_004" 的元素中
                    $("#New_004").html(htmlContent);
                } else {
                    console.error("無法獲取有效的資料！");
                }
            },
            error: function (xhr, status, error) {
                console.error("請求失敗:", status, error);
            }
        });
    }
    function GetNews114() {
        // JSON 資料的來源 URL
        var dataUrl = `${CCMS_SiteAPI}News/114?handler=News_for114&NewWWWDynamiSettingService_Category=%5B%22-1%22%5D&Q_Keyword=戴光宗&PageSize=8&PageNumber=1`;

        // 發送 AJAX 請求以獲取 JSON 資料
        $.ajax({
            url: dataUrl,
            type: "GET",
            dataType: "json",
            success: function (response) {
                // 確保資料存在並正確
                if (response && response.Data) {
                    var htmlContent = "";
                    // 遍歷 JSON 資料並生成 HTML
                    htmlContent +=`<ul class="list">`;
                    response.Data.forEach(function (item) {
                        var date = new Date(item["日期"]);
                        var formattedDate = date.getFullYear() + "-" + String(date.getMonth() + 1).padStart(2, '0') + "-" + String(date.getDate()).padStart(2, '0');
                        htmlContent += `<li><a class="div" href="${item["Path"]}" target="${item["A_TargetAttr"].target}"><i class="y-m">${formattedDate}</i> ${item["案由"]}</a></li>`;
                    });
                    htmlContent +=`</ul>`;

                    // 將生成的 HTML 插入到 id="New_004" 的元素中
                    $("#New_114").html(htmlContent);
                } else {
                    console.error("無法獲取有效的資料！");
                }
            },
            error: function (xhr, status, error) {
                console.error("請求失敗:", status, error);
            }
        });
    }
    function ShowBox(obj) {
        $("#box1").hide();
        $("#box2").hide();
        $("#buttonlist *").removeClass();
        $(obj).addClass("is-active");
        $($(obj).data("target")).show();
    }

</script>


                                </div>
