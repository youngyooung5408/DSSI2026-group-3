    <script>
        function getCookie(name) {
          const value = `; ${document.cookie}`;
          const parts = value.split(`; ${name}=`);
          if (parts.length === 2) {
            return parts.pop().split(';').shift();
          }
          return null; // 如果 cookie 不存在，返回 null
        }
        function FirstSetFontSize(){
            const prefix = 'font-size-';
            let fontSizeValue = getCookie(prefix);
            if(!fontSizeValue) fontSizeValue = 'medium';
            var bodyClassList = document.body.className.split(/\s+/);
            for (var i = 0; i < bodyClassList.length; i++) {
                if (bodyClassList[i].startsWith(prefix)) {
                    $('body').removeClass(bodyClassList[i]);
                }
            }
            $('body').addClass(prefix+fontSizeValue);
        }
        FirstSetFontSize();
    </script>
