%9C%E5%90%8D%E9%A1%8D%E3%80%8D%E7%B5%82%E6%96%BC%E6%94%B9%E7%82%BA%E3%80%8C%E4%B8%89%E5%88%86%E4%B9%8B%E4%B8%80%E6%80%A7%E5%88%A5%E6%AF%94%E4%BE%8B%E3%80%8D%EF%BC%81&amp;rft.date=2025-11-22&amp;rft.genre=unknown&amp;rft.jtitle=%E5%A9%A6%E5%A5%B3%E6%96%B0%E7%9F%A5%E5%9F%BA%E9%87%91%E6%9C%83&amp;rft_id=https%3A%2F%2Fwww.awakening.org.tw%2Fnews%2F6194&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal" class="Z3988" about="#mwt3" id="mwV6g"><span style="display:none;" id="mwV6k"><span typeof="mw:Entity" id="mwV6o"> </span></span></span></span></li>
<li about="#cite_note-2" id="cite_note-2" data-mw-footnote-number="2"><span class="mw-cite-backlink" id="mwV6s"><a href="./2026年中華民國直轄市議員及縣市議員選舉選舉區投票結果列表#cite_ref-2" rel="mw:referencedBy" id="mwV6w"><span class="mw-linkback-text" id="mwV60">↑</span></a></span> <span id="mw-reference-text-cite_note-2" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r95173179" about="#mwt6" typeof="mw:Extension/templatestyles mw:Transclusion" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"Cite web ","href":"./Template:Cite_web"},"params":{"title":{"wt":"公職人員選舉婦女當選名額如何計算分配 ？"},"url":{"wt":"https://web.cec.gov.tw/central/article/20163"},"website":{"wt":"中選會"},"language":{"wt":"zh-TW"},"access-date":{"wt":"2026-04-26"}},"i":0}}]}' id="mwV64"/><cite class="citation web" about="#mwt6" id="mwV68"><a rel="mw:ExtLink nofollow" href="https://web.cec.gov.tw/central/article/20163" class="external text" id="mwV7A"><span typeof="mw:LanguageVariant" data-mw-variant='{"disabled":{"t":"公職人員選舉婦女當選名額如何計算分配 ？"}}' id="mwV7E"></span></a>. 中選會.  <span class="reference-accessdate" id="mwV7I"> <span typeof="mw:Entity" id="mwV7M">[</span><span class="nowrap" id="mwV7Q">2026-04-26</span><span typeof="mw:Entity" id="mwV7U">]</span></span> <span style="font-family: sans-serif; cursor: default; color:var(--color-subtle, #54595d); font-size: 0.8em; bottom: 0.1em; font-weight: bold;" title="连接到中文（臺灣）网页" id="mwV7Y">（中文（臺灣））</span>.</cite><span title="ctx_ver=Z39.88-2004&amp;rfr_id=info%3Asid%2Fzh.wikipedia.org%3A2026%E5%B9%B4%E4%B8%AD%E8%8F%AF%E6%B0%91%E5%9C%8B%E7%9B%B4%E8%BD%84%E5%B8%82%E8%AD%B0%E5%93%A1%E5%8F%8A%E7%B8%A3%E5%B8%82%E8%AD%B0%E5%93%A1%E9%81%B8%E8%88%89%E9%81%B8%E8%88%89%E5%8D%80%E6%8A%95%E7%A5%A8%E7%B5%90%E6%9E%9C%E5%88%97%E8%A1%A8&amp;rft.atitle=%E5%85%AC%E8%81%B7%E4%BA%BA%E5%93%A1%E9%81%B8%E8%88%89%E5%A9%A6%E5%A5%B3%E7%95%B6%E9%81%B8%E5%90%8D%E9%A1%8D%E5%A6%82%E4%BD%95%E8%A8%88%E7%AE%97%E5%88%86%E9%85%8D+%EF%BC%9F&amp;rft.genre=unknown&amp;rft.jtitle=%E4%B8%AD%E9%81%B8%E6%9C%83&amp;rft_id=https%3A%2F%2Fweb.cec.gov.tw%2Fcentral%2Farticle%2F20163&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal" class="Z3988" about="#mwt6" id="mwV7c"><span style="display:none;" id="mwV7g"><span typeof="mw:Entity" id="mwV7k"> </span></span></span></span></li>
<li about="#cite_note-3" id="cite_note-3" data-mw-footnote-number="3"><span class="mw-cite-backlink" id="mwV7o"><a href="./2026年中華民國直轄市議員及縣市議員選舉選舉區投票結果列表#cite_ref-3" rel="mw:referencedBy" id="mwV7s"><span class="mw-linkback-text" id="mwV7w">↑</span></a></span> <span id="mw-reference-text-cite_note-3" class="mw-reference-text reference-text">《地方制度法》第33條：
<ul id="mwV70"><li id="mwV74">各選舉區選出之直轄市議員、縣（市）議員、鄉（鎮、市）民代表名額在三人以上者，應有任一性別當選名額一人；超過三人者，每增加三人增一人。</li>
<li id="mwV78">直轄市、縣（市）選出之山地原住民、平地原住民名額在三人以上者，應有任一性別當選名額一人；超過三人者，每增加三人增一人。鄉（鎮、市）選出之平地原住民名額在三人以上者，應有任一性別當選名額一人；超過三人者，每增加三人增一人。</li>
<li id="mwV8A">中華民國一百十四年十一月二十一日修正之第五項及第六項條文，自中華民國一百十九年十二月二十五日就職之直轄市議員、縣（市）議員、鄉（鎮、市）民代表適用之。</li></ul></span></li>
</ol>

